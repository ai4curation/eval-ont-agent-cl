 oboInOwl:hasRelatedSynonym obo:CL_9900001 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasRelatedSynonym obo:CL_9900001 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900001 \"UCFP\")\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_9900001 \"unclassified fallopian tube progenitor\")\n+AnnotationAssertion(rdfs:label obo:CL_9900001 \"dual-feature fallopian tube progenitor cell\")\n+EquivalentClasses(obo:CL_9900001 ObjectIntersectionOf(obo:CL_0011026 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007589) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4030006) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4030007)))\n+\n # Class: obo:CL_4052020 (lung resident granzyme K-associated CD8 T cell)\n \n AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") obo:IAO_0000115 obo:CL_4052020 \"A granzyme K-associated CD8 T cell that resides in the lung, characterized by the expression of granzyme K (GZMK), and tissue residency markers CD103 and CD49a. This cell exhibits cytotoxic potential through its expression of multiple granzymes (GZMA, GZMB, GZMH, GZMM) in addition to GZMK.\")\n@@ -34688,4 +34702,4 @@ SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000\n SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000945)) obo:CL_0000164)\n SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001264)) obo:CL_0000164)\n SubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeVa