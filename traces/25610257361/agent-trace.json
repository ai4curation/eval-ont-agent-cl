n7939:AnnotationAssertion(rdfs:label obo:CL_0000499 \"stromal cell\")\n7973:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013799\") Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") obo:IAO_0000115 obo:CL_0000503 \"A specialized stromal cell that forms the theca layer outside the basal lamina lining the ovarian follicle, appearing during the secondary follicle stage.\")\n8055:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000513 \"cardiac muscle progenitor cell\")\n8056:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000513 \"cardiomyocyte progenitor cell\")\n8355:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:1638021\") obo:IAO_0000115 obo:CL_0000547 \"An immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.\")\n8422:# Class: obo:CL_0000553 (megakaryocyte progenitor cell)\n8434:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000553 \"megacaryocyte progenitor cell\")\n8436:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12482498\") oboInOwl:hasExactSynonym obo:CL_0000553 \"megakaryocytic progenitor cell\")\n8440:AnnotationAssertion(rdfs:label obo:CL_0000553 \"megakaryocyte progenitor cell\")\n8473:# Class: obo:CL_0000557 (granulocyte monocyte progenitor cell)\n8475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D055014\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:16647566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/CFU-GM\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000557 \"A hematopoietic progenitor cell that is committed to the granulocyte and monocyte lineages. These cells are CD123-positive, and do not express Gata1 or Gata2 but do express C/EBPa, and Pu.1.\")\n8483:AnnotationAssertion(rdfs:comment obo:CL_0000557 \"Originally described in the dendritic cell ontology (DC_CL:0000042)(PMID:19243617). GMPs are reportedly CD16-positive, CD32-positive, CD34-positive, CD38-positive, CD45RA-positive, CD110-negative, CD117-positive, CD123-positive, and SCA1-negative.\")\n8484:AnnotationAssertion(rdfs:label obo:CL_0000557 \"granulocyte monocyte progenitor cell\")\n8580:AnnotationAssertion(rdfs:comment obo:CL_0000566 \"These cells are reportedly CD31-positive, CD34-positive, CD144-positive, CD309-positive, and TAL1-positive.\")\n8986:# Class: obo:CL_0000611 (eosinophil progenitor cell)\n8992:AnnotationAssertion(rdfs:comment obo:CL_0000611 \"These cells are CD34-positive, CD45RA-negative, CD71-negative, and lineage-negative (CD2, CD3 epsilon, CD4, CD5, CD8a, CD14, CD19, CD20, integrin alpha-M, NCAM-1, SCA-1, Ly6G, Ly76).\")\n8993:AnnotationAssertion(rdfs:label obo:CL_0000611 \"eosinophil progenitor cell\")\n9008:# Class: obo:CL_0000613 (basophil progenitor cell)\n9010:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000613 \"A progenitor cell committed to the basophil lineage. This cell lacks hematopoietic lineage markers (lin-negative) and is CD34-positive, T1/ST2-low, CD117-negative, and FceRIa-high. This cell also expresses Gata-1, Gata-2 and C/EBPa.\")\n9016:AnnotationAssertion(rdfs:label obo:CL_0000613 \"basophil progenitor cell\")\n9545:AnnotationAssertion(rdfs:comment obo:CL_0000669 \"Pericytes are CD10-positive, CD13-positive, CD31-negative, CD45-negative, CD106-positive, CD117-negative, CD140-positive, CD144-negative, CD146-positive, CD271-positive, CD325-positive, NG2-positive, RGS5-positive, SMA-positive, and desmin-positive. A subpopulation is CD248-positive. They are also capable of producing angiopoietin 1, CXCL12, TGF-beta, and VEGF-A.\")\n10364:AnnotationAssertion(rdfs:comment obo:CL_0000767 \"Matures in the bone marrow and account for <1% of leukocytes in the peripheral blood, spleen, and bone marrow. Basophils are described as being CD11a-positive, CD11b-positive, CD13-positive, CD15-positive, CD18-positive, CD21-positive, CD25-positive, CD29-positive, CD35-positive, CD40-positive, CD40L-positive, CD44-positive, CD45R-negative, CD46-positive, CD49a-positive, CD49b-positive, CD49d-positive, CD55-positive, CD59-positive, CD62L-positive, CD63-positive, CD69-positive, CD90-negative, CD116-positive, CD117-negative, CD124-positive, CD125-positive, CD131-positive, CD161-positive, CD184-positive, CD191-positive, CD192-positive, CD197-positive, CD200R3-positive, CD218-positive, CD282-positive, CD284-positive, CD289-positive, CD290-positive, CD294-positive, natural killer cell receptor 2B4-positive, smad1-positive, CD3-negative, CD4-negative, CD7-negative, CD8-negative, CD14-negative, CD15-negative, CD16-negative, CD19-negative, CD20-negative, CD34-negative, CD36-negative, CD45R-negative, CD56-negative, CD57-negative, CD235a-negative, and GR1-negative. Transcription factors- GATA1-positive, PU.1-positive.\")\n10569:AnnotationAssertion(rdfs:comment obo:CL_0000785 \"Mature B cells are also reportedly CD10-negative, CD19-positive, CD22-positive, CD34-negative, CD48-positive, CD79a-positive, CD84-positive, CD127-negative, CD352-positive, RAG-negative, TdT-negative, Vpre-B-negative, and pre-BCR-negative. Transcription factors expressed: Pax5-positive.\")\n10590:AnnotationAssertion(rdfs:comment obo:CL_0000786 \"Plasma cells develop in the spleen and migrate to the bone marrow. Plasma cells are also reportedly CD5-negative, CD10-negative, CD19-positive, CD20-negative, CD21-negative, CD22-negative, CD23-negative, CD24-negative, CD25-negative, CD27-positive, CD34-negative, CD38-positive, CD40-positive, CD43-positive, CD45-positive, CD48-positive, CD53-low, CD80-negative, CD81-positive, CD86-positive, CD95-positive, CD196-negative, CD229-positive, CD270-positive, CD352-positive, CD361-positive, and IgD-negative. Transcription factors: BLIMP1-positive, IRF4-positive, PAX5-negative, SpiB-negative, Ets1-negative, and XBP1-positive.\")\n10602:AnnotationAssertion(rdfs:comment obo:CL_0000787 \"Memory B-cells are also reportedly CD5-negative, CD10-negative, CD21-positive, CD22-positive, CD23-negative, CD24-positive, CD25-positive, CD27-positive, CD34-negative, CD38-negative, CD40-positive, CD43-negative, CD44-positive, CD45-positive, CD53-positive, CD80-negative, CD81-negative, CD86-positive, and CD196/CCR6-positive.\")\n10613:AnnotationAssertion(rdfs:comment obo:CL_0000788 \"This cell type is compatible with the HIPC Lyoplate markers for 'naive B cell'. Per DSD: Naive B cells are also reportedly CD10-negative, CD19-positive, CD20-positive, CD21-positive, CD22-positive, CD25-negative, CD27-negative, CD34-negative, CD40-positive, CD43-negative, CD45-positive, CD48-positive, CD53-positive, CD80-negative, CD81-positive, CD84-positive, CD86-negative, CD95-negative, CD138-negative, CD150-positive, CD184/CXCR4-positive, CD185/CXCR5-positive, CD196/CCR6-positive, CD200-positive, CD229-positive, CD243-positive, CD289-positive, CD290-positive, CD352-positive, MHCII/HLA-DR-positive, cadherin 9-positive, and sIgH-positive, Transcription factors: Pax5-positive, ETS1-positive, FOXO1A-positive, KLF4-positive, KLF9-positive, MiTF-positive, OBF1-positive, PLZF-positive, and SpiB-positive.\")\n10986:AnnotationAssertion(rdfs:comment obo:CL_0000816 \"Immature B cells are also reportedly CD5-positive, CD10-positive, CD19-positive, CD20-positive, CD21-positive, CD22-positive, CD24-positive, CD25-negative, CD27-negative, CD34-negative, CD38-positive, CD40-positive, CD43-negative, CD45-positive, CD48-positive, CD53-positive, CD79a-positive, CD80-negative, CD81-positive, CD86-negative, CD95-negative, CD127-negative, CD138-negative, CD185-positive, CD196-positive, MHCII/HLA-DR-positive, RAG-positive, TdT-negative, Vpre-B-negative, and preBCR-negative. Transcription factors expressed: Pax5-positive.\")\n11031:AnnotationAssertion(rdfs:comment obo:CL_0000819 \"There are small numbers of B-1 cells found in the lymph nodes and spleen, while larger numbers can be found in the peritoneal and pleural cavities. B-1 B cells are reportedly CD11b-positive, CD20-positive, CD21-positive, CD27-positive, CD44-positive, CD45RB-positive, CD48-positive, CD70-negative, CD150-positive, CD244-negative, CD352-positive, sIgM-positive, and sIgD-low.\")\n11110:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:11532393\") Annotation(oboInOwl:hasDbXref \"PMID:12457618\") Annotation(oboInOwl:hasDbXref \"PMID:15032583\") Annotation(oboInOwl:hasDbXref \"PMID:15766674\") obo:IAO_0000115 obo:CL_0000825 \"A lymphoid progenitor cell that is committed to the natural killer cell lineage, expressing CD122 (IL-15) receptor, but lacking many of the phenotypic characteristics of later stages of natural killer cell development such as expression of NK activating and inhibitory molecules. In human this cell has the phenotype CD34-positive, CD45RA-positive, CD10-positive, CD117-negative, and CD161 negative.\")\n11124:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:12633665\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") obo:IAO_0000115 obo:CL_0000826 \"A progenitor cell of the B cell lineage, with some lineage specific activity such as early stages of recombination of B cell receptor genes, but not yet fully committed to the B cell lineage until the expression of PAX5 occurs.\")\n11135:AnnotationAssertion(rdfs:comment obo:CL_0000826 \"Human pro-B cells are reportedly CD10-positive, CD22-positive, CD34-positive, CD38-positive, CD45-low, CD48-positive, CD79a-positive, CD127-positive, CD184-positive, RAG-positive, TdT-positive, Vpre-B-positive, pre-BCR-negative, IgD-negative, and IgM-negative. Transcription factors expressed: Pax5-positive, EBF-positive, E2A-negative, Ikaros-negative, and PU.1-negative.\")\n11143:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000827 \"A lymphoid progenitor cell of the T cell lineage, with some lineage specific marker expression, but not yet fully committed to the T cell lineage.\")\n11156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:7758949\") obo:IAO_0000115 obo:CL_0000828 \"A progenitor cell of the thrombocyte, a nucleated blood cell involved in coagulation typically seen in birds and other non-mammalian vertebrates.\")\n11182:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1183570\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"PMID:8629001\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000831 \"A progenitor cell of the mast cell lineage. Markers for this cell are FceRIa-low, CD117-positive, CD9-positive, T1/ST2-positive, SCA1-negative, and lineage-negative.\")\n11187:AnnotationAssertion(rdfs:comment obo:CL_0000831 \"MCP are CD16-positive, CD32-positive, CD34-positive, CD45-positive, integrin beta-7-positive, and lin-negative (CD2, CD3e, CD4, CD5, CD8a, CD14, CD19, CD20, CD27, integrin alpha-M, ly6c, ly6g, NCAM-1, and ter119). These cells also express the transcription factors GATA-1, GATA-2, and MITF, but not C/EBPa.\")\n11210:# Class: obo:CL_0000834 (neutrophil progenitor cell)\n11212:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000834 \"A progenitor cell of the neutrophil lineage.\")\n11214:AnnotationAssertion(rdfs:label obo:CL_0000834 \"neutrophil progenitor cell\")\n11239:# Class: obo:CL_0000837 (hematopoietic multipotent progenitor cell)\n11241:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0000837 \"A hematopoietic multipotent progenitor cell is multipotent, but not capable of long-term self-renewal. These cells are characterized as lacking lineage cell surface markers and being CD34-positive in both mice and humans.\")\n11245:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000837 \"hemopoietic progenitor cell\")\n11247:AnnotationAssertion(rdfs:label obo:CL_0000837 \"hematopoietic multipotent progenitor cell\")\n11254:# Class: obo:CL_0000838 (lymphoid lineage restricted progenitor cell)\n11256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000838 \"A progenitor cell restricted to the lymphoid lineage.\")\n11257:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000838 \"lymphoid progenitor cell\")\n11262:AnnotationAssertion(rdfs:label obo:CL_0000838 \"lymphoid lineage restricted progenitor cell\")\n11267:# Class: obo:CL_0000839 (myeloid lineage restricted progenitor cell)\n11269:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0000839 \"A progenitor cell restricted to the myeloid lineage.\")\n11270:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000839 \"myeloid progenitor cell\")\n11275:AnnotationAssertion(rdfs:label obo:CL_0000839 \"myeloid lineage restricted progenitor cell\")\n11334:AnnotationAssertion(rdfs:comment obo:CL_0000844 \"Germinal center B cells are also reportedly CD10-positive, CD19-positive, CD20-positive, CD38-positive, CD44-low, CD45-positive, CD48-positive, CD95-positive, CD352-positive, and HLA-DR-positive. Transcription factors: BCL6-positive, Ets1-positive, IRF8-positive, MTA3-positive, OBF1-positive, PAX5-positive, SpiB-positive, and STAT3-positive.\")\n11714:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:ana\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16168663\") Annotation(oboInOwl:hasDbXref \"PMID:17016554\") Annotation(oboInOwl:hasDbXref \"PMID:17016559\") obo:IAO_0000115 obo:CL_0000889 \"An immature myeloid leukocyte of heterogeneous phenotype found particularly in cancer and sepsis patients that is capable of suppressing activity of T cells in ex vivo assays. This cell type is CD45-positive, CD11b-positive.\")\n11715:AnnotationAssertion(rdfs:comment obo:CL_0000889 \"Markers: Mouse: CD11b+GR1+CD31+; Human: CD34+ CD33+CD15-CD13+. (According to some reports in humans these cells are iNOS+ARG1+IL13+IFNg+); location: In cancerous tissue; in the blood and lymphoid organs in sepsis.\")\n11817:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19100699\") obo:IAO_0000115 obo:CL_0000898 \"Mature T cell not yet exposed to antigen with the phenotype CCR7-positive, CD45RA-positive, and CD127-positive. This cell type is also described as being CD25-negative, CD62L-high and CD44-low.\")\n11847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0000900 \"A CD8-positive, alpha-beta T cell that has not experienced activation via antigen contact and has the phenotype CD45RA-positive, CCR7-positive and CD127-positive. This cell type is also described as being CD25-negative, CD62L-high and CD44-low.\")\n11903:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0000904 \"CD4-positive, alpha-beta memory T cell with the phenotype CCR7-positive, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative.\")\n11919:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0000905 \"CD4-positive, alpha-beta memory T cell with the phenotype CCR7-negative, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative.\")\n11946:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:20146720\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0000907 \"CD8-positive, alpha-beta memory T cell with the phenotype CCR7-positive, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative.\")\n12020:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:20146720\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0000913 \"CD8-positive, alpha-beta memory T cell with the phenotype CCR7-negative, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative.\")\n12059:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:11976459\") obo:IAO_0000115 obo:CL_0000916 \"A mature gamma-delta T cell located in the epidermis that regulates wound healing.\")\n12330:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0000936 \"A lymphoid progenitor cell that is found in bone marrow, gives rise to B cells, T cells, natural killer cells and dendritic cells, and has the phenotype Lin-negative, Kit-positive, Sca-1-positive, FLT3-positive, CD34-positive, CD150 negative, and GlyA-negative.\")\n12343:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:17100874\") obo:IAO_0000115 obo:CL_0000937 \"Cell committed to natural killer cell lineage that has the phenotype CD122-positive, CD34-positive, and CD117-positive. This cell type lacks expression of natural killer receptor proteins.\")\n12345:AnnotationAssertion(rdfs:comment obo:CL_0000937 \"These cells are also reportedly CD7-low, CD10-negative, CD45RA-positive, alpha-4-beta-7 integrin-high.\")\n12387:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19273629\") obo:IAO_0000115 obo:CL_0000941 \"A dendritic cell arising in thymus that has the phenotype CD11c-positive, CD11b-negative, and CD45RA-negative.\")\n12396:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19941119\") obo:IAO_0000115 obo:CL_0000942 \"A plasmacytoid dendritic cell developing in the thymus with phenotype CD11c-negative or low, CD45RA-positive, CD11b-negative, and CD123-positive.\")\n12497:AnnotationAssertion(rdfs:comment obo:CL_0000954 \"Small pre-B-II cells are also reportedly CD10-positive, CD19-positive, CD34-negative, CD79a-positive, CD127-negative, TdT-negative, Vpre-B-negative, sIgM-negative, and sIgD-negative. Transcription factors: PU.1-positive, Ikaros-positive, E2A-positive, and PAX5-positive.\")\n12504:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:9785673\") obo:IAO_0000115 obo:CL_0000955 \"A pre-B-II cell is a precursor B cell that expresses immunoglobulin mu heavy chain (IgHmu+), and lack expression of CD34, TdT, immunoglobulin kappa light chain and immunoglobulin lambda light chain.\")\n12509:AnnotationAssertion(rdfs:comment obo:CL_0000955 \"pre-B-II cell are also reportedly CD19-positive, CD22-positive, CD38-positive, CD45-positive, and CD48-positive.\")\n12518:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"PMID:20839338\") Annotation(oboInOwl:hasDbXref \"PMID:9785673\") obo:IAO_0000115 obo:CL_0000956 \"A pre-B-I cell is a precursor B cell that expresses CD34 and surrogate immunoglobulin light chain (VpreB , Lambda 5 (mouse)/14.1 (human)) on the cell surface, and TdT, Rag1,and Rag2 intracellularly. Cell type carries a D-JH DNA rearrangement, and lacks expression of immunglobulin heavy chain protein.\")\n12521:AnnotationAssertion(rdfs:comment obo:CL_0000956 \"Human pre-B-I cells are reportedly CD10-positive, CD19-positive, CD22-positive, CD38-positive, CD45-low, CD79a-positive, CD127-negative, pre-BCR-negative, IgM-negative, IgD-negative, and Tdt-positive. Transcription factors expressed: Pax5-positive.\")\n12532:AnnotationAssertion(rdfs:comment obo:CL_0000957 \"Large pre-B-II cells are also reportedly CD10-positive, CD19-positive, CD34-negative, CD79a-positive, CD127-negative, TdT-negative, Vpre-B-positive, pre-BCR-positive, sIgM-negative, and sIgD-negative. Transcription factors: PU.1-positive, Ikaros-positive, E2A-positive, and PAX5-positive.\")\n12878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:15771572\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") obo:IAO_0000115 obo:CL_0000989 \"CD11c-low plasmacytoid dendritic cell is a leukocyte that is CD11c-low, CD45R-positive, GR1-positive and CD11b-negative.\")\n12901:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:15771572\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") obo:IAO_0000115 obo:CL_0000991 \"CD11c-negative plasmacytoid dendritic cell is a leukocyte is CD11c-negative, CD45RA-positive, CD85g-positive(ILT7), CD123-positive, CD303-positive.\")\n12935:# Class: obo:CL_0000995 (CD34-positive, CD38-positive common myeloid progenitor OR CD34-positive, CD38-positive common lymphoid progenitor)\n12939:AnnotationAssertion(rdfs:label obo:CL_0000995 \"CD34-positive, CD38-positive common myeloid progenitor OR CD34-positive, CD38-positive common lymphoid progenitor\")\n13056:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17952047\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001008 \"A hematopoietic stem cell that has plasma membrane part Kit-positive, SCA-1-positive, CD150-positive and CD34-negative.\")\n13167:# Class: obo:CL_0001021 (CD34-positive, CD38-positive common lymphoid progenitor)\n13169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2346585\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001021 \"A common lymphoid progenitor that is CD10-positive, CD45RA-positive, CD34-positive and CD38-positive.\")\n13174:AnnotationAssertion(rdfs:label obo:CL_0001021 \"CD34-positive, CD38-positive common lymphoid progenitor\")\n13189:# Class: obo:CL_0001023 (Kit-positive, CD34-positive common myeloid progenitor)\n13191:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:1261582\") Annotation(oboInOwl:hasDbXref \"PMID:17952047\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0001023 \"A common myeloid progenitor that is Kit-positive and CD34-positive, Il7ra-negative, and is SCA1-low and Fcgr2-low and Fcgr3-low.\")\n13194:AnnotationAssertion(rdfs:label obo:CL_0001023 \"Kit-positive, CD34-positive common myeloid progenitor\")\n13200:# Class: obo:CL_0001024 (CD34-positive, CD38-negative hematopoietic stem cell)\n13202:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:10430905\") Annotation(oboInOwl:hasDbXref \"PMID:11750107\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") Annotation(oboInOwl:hasDbXref \"PMID:9389721\") obo:IAO_0000115 obo:CL_0001024 \"CD133-positive hematopoietic stem cell is a hematopoietic stem cell that is CD34-positive, CD90-positive, and CD133-positive.\")\n13206:AnnotationAssertion(rdfs:label obo:CL_0001024 \"CD34-positive, CD38-negative hematopoietic stem cell\")\n13222:# Class: obo:CL_0001026 (CD34-positive, CD38-positive common myeloid progenitor)\n13224:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") obo:IAO_0000115 obo:CL_0001026 \"A common myeloid progenitor that is CD34-positive, CD38-positive, IL3ra-low, CD10-negative, CD7-negative, CD45RA-negative, and IL-5Ralpha-negative.\")\n13227:AnnotationAssertion(rdfs:label obo:CL_0001026 \"CD34-positive, CD38-positive common myeloid progenitor\")\n13232:# Class: obo:CL_0001027 (CD7-negative lymphoid progenitor cell)\n13234:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") obo:IAO_0000115 obo:CL_0001027 \"CD7-negative lymphoid progenitor cell is a lymphoid progenitor cell that is CD34-positive, CD7-negative and CD45RA-negative.\")\n13237:AnnotationAssertion(rdfs:label obo:CL_0001027 \"CD7-negative lymphoid progenitor cell\")\n13242:# Class: obo:CL_0001028 (CD7-positive lymphoid progenitor cell)\n13244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:19491395\") obo:IAO_0000115 obo:CL_0001028 \"CD7-positive lymphoid progenitor cell is a lymphoid progenitor cell that is CD34-positive, CD7-positive and is CD45RA-negative.\")\n13247:AnnotationAssertion(rdfs:label obo:CL_0001028 \"CD7-positive lymphoid progenitor cell\")\n13254:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:17922016\") Annotation(oboInOwl:hasDbXref \"PMID:19286519\") obo:IAO_0000115 obo:CL_0001029 \"Common dendritic precursor is a hematopoietic progenitor cell that is CD117-low, CD135-positive, CD115-positive and lacks plasma membrane parts for hematopoietic lineage markers.\")\n13343:AnnotationAssertion(rdfs:comment obo:CL_0001041 \"These cells may be the human equivalent of murine CD8-positive, CD122-positive alpha-beta regulatory T cell. They are also found in the CD45RA-negative and CD62L-positive fraction.\")\n13371:AnnotationAssertion(rdfs:comment obo:CL_0001043 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD4+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD4+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001044 \"A CD4-positive, alpha-beta T cell with the phenotype CCR7-negative, CD45RA-positive.\")\n13390:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001045 \"A naive regulatory T cell with the phenotype CD4-positive, CD25-positive, CD127lo, CCR4-positive, and CD45RO-negative.\")\n13402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001046 \"A memory regulatory T cell with phenotype CD4-positive, CD25-positive, CD127lo, CCR4-positive, and CD45RO-positive.\")\n13431:AnnotationAssertion(rdfs:comment obo:CL_0001048 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CCR4+ Treg'.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13443:AnnotationAssertion(rdfs:comment obo:CL_0001049 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD8+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD8+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD8+ T cells, as activated mouse T cells do not express MHC class II.\")\n13450:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001050 \"A CD8-positive, alpha-beta T cell with the phenotype CCR7-negative, CD45RA-positive.\")\n13538:# Class: obo:CL_0001059 (common myeloid progenitor, CD34-positive)\n13540:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0878932437\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2212039\") Annotation(oboInOwl:hasDbXref \"PMID:10724173\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:16647566\") obo:IAO_0000115 obo:CL_0001059 \"A progenitor cell committed to myeloid lineage, including the megakaryocyte and erythroid lineages. These cells are CD34-positive, and express Gata1, Gata2, C/EBPa, and Pu.1.\")\n13541:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001059 \"common myeloid precursor, CD34-positive\")\n13549:AnnotationAssertion(rdfs:comment obo:CL_0001059 \"CMP are reportedly CD16-positive, CD32-positive, CD38-positive, CD45RA-negative, CD110-negative, CD117-positive, CD123-positive, and SCA1-negative.\")\n13550:AnnotationAssertion(rdfs:label obo:CL_0001059 \"common myeloid progenitor, CD34-positive\")\n13554:# Class: obo:CL_0001060 (hematopoietic oligopotent progenitor cell, lineage-negative)\n13556:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001060 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities. Cell lacks hematopoeitic lineage markers.\")\n13559:AnnotationAssertion(rdfs:label obo:CL_0001060 \"hematopoietic oligopotent progenitor cell, lineage-negative\")\n13578:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dos\") Annotation(oboInOwl:hasDbXref \"PMID:15032595\") Annotation(oboInOwl:hasDbXref \"PMID:16237082\") Annotation(oboInOwl:hasDbXref \"PMID:26883338\") obo:IAO_0000115 obo:CL_0001062 \"A CD8-positive, alpha beta memory T cell with the phenotype CD45RA-positive, CD45RO-negative, and CCR7-negative.\")\n13622:# Class: obo:CL_0001066 (erythroid progenitor cell, mammalian)\n13624:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0001066 \"A progenitor cell committed to the erythroid lineage. This cell is ter119-positive but lacks expression of other hematopoietic lineage markers (lin-negative).\")\n13632:AnnotationAssertion(rdfs:label obo:CL_0001066 \"erythroid progenitor cell, mammalian\")\n13686:# Class: obo:CL_0001072 (CD34-negative, CD117-positive innate lymphoid cell, human)\n13688:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:30193847\") Annotation(oboInOwl:hasDbXref \"PMID:31201208\") obo:IAO_0000115 obo:CL_0001072 \"An innate lymphoid cell in the human with the phenotype CD34-negative, CD117-positive, and a precusor to NK cells, ILC2 cells, and ILC3 cells.\")\n13689:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001072 \"CD34-negative, CD117-positive ILC\")\n13690:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001072 \"CD34-negative, CD117-positive ILCP\")\n13691:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001072 \"CD34-negative, CD117-positive innate lymphoid cell precusor\")\n13692:AnnotationAssertion(rdfs:label obo:CL_0001072 \"CD34-negative, CD117-positive innate lymphoid cell, human\")\n13696:# Class: obo:CL_0001073 (CD34-negative, CD56-positive, CD117-positive innate lymphoid cell, human)\n13698:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:30193847\") Annotation(oboInOwl:hasDbXref \"PMID:31201208\") obo:IAO_0000115 obo:CL_0001073 \"An innate lymphoid cell in the human with the phenotype CD34-negative, CD56-positive, CD117-positive.Thie cell type may include precusors to NK cells and ILC3 cells.\")\n13699:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001073 \"CD34-negative, CD56-positive, CD117-positive ILC\")\n13700:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001073 \"CD34-negative, CD56-positive, CD117-positive ILCP\")\n13701:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001073 \"CD34-negative, CD56-positive, CD117-positive innate lymphoid cell precursor\")\n13702:AnnotationAssertion(rdfs:label obo:CL_0001073 \"CD34-negative, CD56-positive, CD117-positive innate lymphoid cell, human\")\n13705:# Class: obo:CL_0001074 (CD34-positive, CD56-positive, CD117-positive common innate lymphoid precursor, human)\n13707:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:30193847\") obo:IAO_0000115 obo:CL_0001074 \"An innate lymphoid cell precursor in the human with the phenotype CD34-positive, CD56-positive, CD117-positive.Thie cell type may include precusors to NK cells and ILC3 cells.\")\n13708:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001074 \"CD34-positive, CD56-positive, CD117-positive CILP\")\n13709:AnnotationAssertion(rdfs:label obo:CL_0001074 \"CD34-positive, CD56-positive, CD117-positive common innate lymphoid precursor, human\")\n13768:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:17465678\") Annotation(oboInOwl:hasDbXref \"PMID:26883338\") Annotation(oboInOwl:hasDbXref \"PMID:27997758\") Annotation(oboInOwl:hasDbXref \"PMID:29133794\") obo:IAO_0000115 obo:CL_0001087 \"A CD4-positive, alpha beta memory T cell with the phenotype CD45RA-positive, CD45RO-negative, and CCR7-negative.\")\n13813:# Class: obo:CL_0001203 (CD8-positive, alpha-beta memory T cell, CD45RO-positive)\n13815:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:20146720\") obo:IAO_0000115 obo:CL_0001203 \"A CD8-positive, alpha-beta T cell with memory phenotype indicated by being CD45RO and CD127-positive. This cell type is also described as being CD25-negative, CD44-high, and CD122-high.\")\n13816:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001203 \"CD8-positive, alpha-beta memory T lymphocyte, CD45RO-positive\")\n13817:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001203 \"CD8-positive, alpha-beta memory T-cell, CD45RO-positive\")\n13818:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001203 \"CD8-positive, alpha-beta memory T-lymphocyte, CD45RO-positive\")\n13819:AnnotationAssertion(rdfs:label obo:CL_0001203 \"CD8-positive, alpha-beta memory T cell, CD45RO-positive\")\n13824:# Class: obo:CL_0001204 (CD4-positive, alpha-beta memory T cell, CD45RO-positive)\n13826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0001204 \"CD4-positive, alpha-beta long-lived T cell with the phenotype CD45RO-positive and CD127-positive. This cell type is also described as being CD25-negative, CD44-high, and CD122-high.\")\n13827:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001204 \"CD4-positive, alpha-beta memory T lymphocyte, CD45RO-positive\")\n13828:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001204 \"CD4-positive, alpha-beta memory T-cell, CD45RO-positive\")\n13829:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001204 \"CD4-positive, alpha-beta memory T-lymphocyte, CD45RO-positive\")\n13830:AnnotationAssertion(rdfs:label obo:CL_0001204 \"CD4-positive, alpha-beta memory T cell, CD45RO-positive\")\n13841:# Class: obo:CL_0002000 (Kit-positive erythroid progenitor cell)\n13843:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19805084\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002000 \"An erythroid progenitor cell is Kit-positive, Ly6A-negative, CD41-negative, CD127-negative, and CD123-negative. This cell type is also described as being lin-negative, Kit-positive, CD150-negative, CD41-negative, CD105-positive, and FcgR-negative.\")\n13846:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002000 \"c- Kit-positive erythroid progenitor cell\")\n13848:AnnotationAssertion(rdfs:label obo:CL_0002000 \"Kit-positive erythroid progenitor cell\")\n13853:# Class: obo:CL_0002001 (CD34-positive, CD38-positive granulocyte monocyte progenitor)\n13855:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002001 \"A granulocyte monocyte progenitor is CD34-positive, CD38-positive, IL-3receptor-alpha-positive and is CD45RA-negative.\")\n13858:AnnotationAssertion(rdfs:comment obo:CL_0002001 \"Markers are for human cells. According to different research groups, CD45RA is present or absent on this cell population.\")\n13859:AnnotationAssertion(rdfs:label obo:CL_0002001 \"CD34-positive, CD38-positive granulocyte monocyte progenitor\")\n13866:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:16322423\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"PMID:19273628\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002002 \"A granulocyte monocyte progenitor that is Kit-positive, CD34-positive, Fc-gamma receptor II/II-positive, and is Sca-1-negative, Il7ra-negative, Cxc3r1-negative, and CD90-negative.\")\n13875:# Class: obo:CL_0002003 (CD34-positive, GlyA-negative erythroid progenitor cell)\n13877:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19621348\") obo:IAO_0000115 obo:CL_0002003 \"An erythroid progenitor cell that is CD34-positive and is GlyA-negative.\")\n13882:AnnotationAssertion(rdfs:label obo:CL_0002003 \"CD34-positive, GlyA-negative erythroid progenitor cell\")\n13887:# Class: obo:CL_0002004 (CD34-negative, GlyA-negative proerythroblast)\n13889:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19621348\") obo:IAO_0000115 obo:CL_0002004 \"A proerythoblast that is CD34-negative and GlyA-negative.\")\n13893:AnnotationAssertion(rdfs:label obo:CL_0002004 \"CD34-negative, GlyA-negative proerythroblast\")\n13898:# Class: obo:CL_0002005 (CD34-positive, CD38-positive megakaryocyte erythroid progenitor cell)\n13900:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:190227700\") obo:IAO_0000115 obo:CL_0002005 \"A megakaryocyte erythroid progenitor cell is CD34-positive, CD38-positive and is IL3-receptor alpha-negative and CD45RA-negative.\")\n13904:AnnotationAssertion(rdfs:label obo:CL_0002005 \"CD34-positive, CD38-positive megakaryocyte erythroid progenitor cell\")\n13908:# Class: obo:CL_0002006 (Kit-positive, CD34-negative megakaryocyte erythroid progenitor cell)\n13910:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002006 \"A megakaryocyte erythroid progenitor cell that is Kit-positive and is Sca1-negative, CD34-negative, CD90-negative, IL7r-alpha-negative and Fcgr II/III-low.\")\n13914:AnnotationAssertion(rdfs:label obo:CL_0002006 \"Kit-positive, CD34-negative megakaryocyte erythroid progenitor cell\")\n13918:# Class: obo:CL_0002007 (Kit-low, CD34-positive eosinophil progenitor cell)\n13920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582345\") obo:IAO_0000115 obo:CL_0002007 \"A lineage marker-negative, CD34-positive, IL5r-alpha-positive, and Sca1-negative eosinophil progenitor cell.\")\n13924:AnnotationAssertion(rdfs:label obo:CL_0002007 \"Kit-low, CD34-positive eosinophil progenitor cell\")\n13929:# Class: obo:CL_0002008 (CD34-positive, CD38-positive eosinophil progenitor cell)\n13931:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") obo:IAO_0000115 obo:CL_0002008 \"A lineage marker-negative, CD34-positive, CD38-positive, IL3r-alpha-positive, IL5r-alpha-positive, and CD45RA-negative eosinophil progenitor cell.\")\n13935:AnnotationAssertion(rdfs:label obo:CL_0002008 \"CD34-positive, CD38-positive eosinophil progenitor cell\")\n13942:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19273628\") obo:IAO_0000115 obo:CL_0002009 \"A progenitor cell that can give rise to plasmacytoid and myeloid dendritic cells, and to monocytes and macrophages.\")\n13962:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19273628\") obo:IAO_0000115 obo:CL_0002011 \"A progenitor cell that can give rise to plasmacytoid and myeloid dendritic cells, and to monocytes and macrophages. Marker for this cell is Kit-high, CD115-positive, CD135-positive, Cx3cr1-positive, and is Il7ra-negative.\")\n14093:# Class: obo:CL_0002023 (CD34-positive, CD41-positive, CD42-positive megakaryocyte progenitor cell)\n14095:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002023 \"A megakaroycotye progenitor cell that is CD34-positive, CD41-positive and CD42-positive on the cell surface.\")\n14099:AnnotationAssertion(rdfs:label obo:CL_0002023 \"CD34-positive, CD41-positive, CD42-positive megakaryocyte progenitor cell\")\n14104:# Class: obo:CL_0002024 (Kit-positive megakaryocyte progenitor cell)\n14106:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:16951553\") obo:IAO_0000115 obo:CL_0002024 \"A megakaryocyte progenitor cell that is Kit-positive, CD41-positive, CD9-positive, Sca-1-negative, IL7ralpha-negative, CD150-negative, and Fcgamma receptor II/III-low.\")\n14110:AnnotationAssertion(rdfs:label obo:CL_0002024 \"Kit-positive megakaryocyte progenitor cell\")\n14115:# Class: obo:CL_0002025 (CD34-positive, CD41-positive, CD42-negative megakaryocyte progenitor cell)\n14117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002025 \"A megakaryocyte progenitor cell that is CD34-positive, CD41-positive, and CD42-negative.\")\n14121:AnnotationAssertion(rdfs:label obo:CL_0002025 \"CD34-positive, CD41-positive, CD42-negative megakaryocyte progenitor cell\")\n14126:# Class: obo:CL_0002026 (CD34-negative, CD41-positive, CD42-positive megakaryocyte cell)\n14128:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002026 \"A megakaryocyte progenitor cell that is CD34-negative, CD41-positive and CD42-positive.\")\n14132:AnnotationAssertion(rdfs:label obo:CL_0002026 \"CD34-negative, CD41-positive, CD42-positive megakaryocyte cell\")\n14148:# Class: obo:CL_0002028 (basophil mast progenitor cell)\n14150:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") obo:IAO_0000115 obo:CL_0002028 \"A cell type that can give rise to basophil and mast cells. This cell is CD34-positive, CD117-positive, CD125-positive, FceRIa-negative, and T1/ST2-negative, and expresses Gata-1, Gata-2, C/EBPa\")\n14155:AnnotationAssertion(rdfs:label obo:CL_0002028 \"basophil mast progenitor cell\")\n14162:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") obo:IAO_0000115 obo:CL_0002029 \"A lineage-negative, Kit-positive, CD45-positive mast cell progenitor that is Fc-epsilon RIalpha-low.\")\n14170:# Class: obo:CL_0002030 (Fc-epsilon RIalpha-high basophil progenitor cell)\n14172:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") obo:IAO_0000115 obo:CL_0002030 \"A lineage negative, Sca1-negative basophil progenitor cell that is Fc epsilon RIalpha-high.\")\n14176:AnnotationAssertion(rdfs:label obo:CL_0002030 \"Fc-epsilon RIalpha-high basophil progenitor cell\")\n14181:# Class: obo:CL_0002031 (hematopoietic lineage restricted progenitor cell)\n14183:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002031 \"A hematopoietic progenitor cell that is capable of developing into only one lineage of hematopoietic cells.\")\n14186:AnnotationAssertion(rdfs:label obo:CL_0002031 \"hematopoietic lineage restricted progenitor cell\")\n14193:# Class: obo:CL_0002032 (hematopoietic oligopotent progenitor cell)\n14195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0002032 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities.\")\n14198:AnnotationAssertion(rdfs:comment obo:CL_0002032 \"This cell type is intended to be compatible with any vertebrate hematopoietic oligopotent progenitor cell.  For mammalian hematopoietic oligopotent progenitor cells known to be lineage-negative, please use the term 'hematopoietic oligopotent progenitor cell' (CL_0001060).\")\n14199:AnnotationAssertion(rdfs:label obo:CL_0002032 \"hematopoietic oligopotent progenitor cell\")\n14207:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15572596\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002033 \"A hematopoietic stem cell capable of rapid replenishment of myeloerythroid progenitors and limited self renewal capability. This cell is Kit-positive, Sca1-positive, CD34-positive, CD150-positive, and is Flt3-negative.\")\n14220:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15572596\") Annotation(oboInOwl:hasDbXref \"PMID:17582345\") obo:IAO_0000115 obo:CL_0002034 \"A hematopoietic stem cell with long term self renewal capability. This cell is Kit-positive, Sca1-positive, CD150-positive, CD90-low, CD34-negative and Flt3-negative.\")\n14230:# Class: obo:CL_0002035 (Slamf1-negative multipotent progenitor cell)\n14236:AnnotationAssertion(rdfs:label obo:CL_0002035 \"Slamf1-negative multipotent progenitor cell\")\n14241:# Class: obo:CL_0002036 (Slamf1-positive multipotent progenitor cell)\n14243:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002036 \"A hematopoietic progenitor that has some limited self-renewal capability. Cells are lin-negative, Kit-positive, CD34-positive, and Slamf1-positive.\")\n14248:AnnotationAssertion(rdfs:label obo:CL_0002036 \"Slamf1-positive multipotent progenitor cell\")\n14326:# Class: obo:CL_0002043 (CD34-positive, CD38-negative multipotent progenitor cell)\n14328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18371405\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002043 \"A hematopoietic multipotent progenitor cell that is CD34-positive, CD38-negative, CD45RA-negative, and CD90-negative.\")\n14331:AnnotationAssertion(rdfs:comment obo:CL_0002043 \"Cell markers are associated with human hematopoietic multipotent progenitor cells.\")\n14332:AnnotationAssertion(rdfs:label obo:CL_0002043 \"CD34-positive, CD38-negative multipotent progenitor cell\")\n14337:# Class: obo:CL_0002044 (Kit-positive, integrin beta7-high basophil mast progenitor cell)\n14339:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002044 \"A basophil mast progenitor cell that is Beta-7 integrin-high, Kit-positive FcRgammaII/III-positive and Sca1-negative.\")\n14343:AnnotationAssertion(rdfs:label obo:CL_0002044 \"Kit-positive, integrin beta7-high basophil mast progenitor cell\")\n14349:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12633665\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002045 \"A pro-B cell that is CD45R/B220-positive, CD43-positive, HSA-low, BP-1-negative and Ly6c-negative. This cell type is also described as being lin-negative, AA4-positive, Kit-positive, IL7Ra-positive and CD45R-positive.\")\n14361:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") obo:IAO_0000115 obo:CL_0002046 \"A pro-B cell that is CD22-positive, CD34-positive, CD38-positive and TdT-positive (has TdT activity). Pre-BCR is expressed on the cell surface. Cell is CD19-negative, CD20-negative, complement receptor type 2-negative and CD10-low. D-to-J recombination of the heavy chain occurs at this stage.\")\n14371:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") obo:IAO_0000115 obo:CL_0002047 \"A precursor B cell that is CD45RA-positive, CD43-positive, CD24-positive and BP-1-negative.\")\n14384:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") obo:IAO_0000115 obo:CL_0002048 \"A pre-B cell precursor is CD19-low, CD22-positive , CD34-positive, CD38-positive.\")\n14395:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") obo:IAO_0000115 obo:CL_0002049 \"A precursor B cell that is CD45R-positive, CD43-positive, CD24-positive, and BP-positive. Intracellularly expression of surrogate light chain, Rag1 and Rag2, TdT, occurs while there is no expression of mu heavy chain.\")\n14406:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") obo:IAO_0000115 obo:CL_0002050 \"A pre-BCR-positive precursor B cell that is CD24-high, CD25-positive, CD43-positive, CD45R-positive and BP-positive.\")\n14430:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002052 \"A pre-B cell that is pre-BCR-negative, and the kappa- and lambda- light immunoglobulin light chain-negative, CD43-low, and is BP-1-positive, CD45R-positive and CD25-positive. This cell type is also described as being AA4-positive, IgM-negative, CD19-positive, CD43-low/negative, and HSA-positive.\")\n14455:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") obo:IAO_0000115 obo:CL_0002054 \"An immature B cell that is IgM-positive, CD45R-positive, CD43-low, CD25-negative, and CD127-negative. This cell type has also been described as being AA4-positive, IgM-positive, CD19-positive, CD43-low/negative, and HSA-positive.\")\n14477:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582343\") obo:IAO_0000115 obo:CL_0002056 \"A mature B cell subset originally defined as having being CD45R-positive, IgM-positive, IgD-positive and CD43-negative. Subsequent research demonstrated being CD21-positive and CD23-negative and CD93 negative.\")\n15301:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19201830\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0002128 \"A CD8-positive, alpha-beta T cell that has the phenotype CXCR3-negative, CCR6-positive, CCR5-high, CD45RA-negative, and capable of producing IL-17 and some IFNg.\")\n15350:# Class: obo:CL_0002132 (stromal cell of ovary)\n15356:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cjm\") oboInOwl:hasExactSynonym obo:CL_0002132 \"ovarian stromal cell\")\n15357:AnnotationAssertion(rdfs:label obo:CL_0002132 \"stromal cell of ovary\")\n15360:# Class: obo:CL_0002133 (stromal cell of ovarian cortex)\n15362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002133 \"A stromal cell of the ovarian cortex.\")\n15366:AnnotationAssertion(rdfs:label obo:CL_0002133 \"stromal cell of ovarian cortex\")\n15369:# Class: obo:CL_0002134 (stromal cell of ovarian medulla)\n15371:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002134 \"A stromal cell of the ovarian medulla.\")\n15375:AnnotationAssertion(rdfs:label obo:CL_0002134 \"stromal cell of ovarian medulla\")\n15434:AnnotationAssertion(rdfs:comment obo:CL_0002139 \"These cells are reportedly CD31-positive, CD34-positive, CD144-positive, TAL1-positive.\")\n16025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) Annotation(oboInOwl:hasDbXref <https://doi.org/10.3389/fcell.2021.644088>) obo:RO_0004050 obo:CL_0002196 \"Liver progenitor cells have been variously named in rodent and human studies as oval cells, hepatic progenitor cells, liver stem cells, ductular reactions, or atypical ductular cells. They were first described as oval cells in rats due to their large nuclear-to-cytoplasm ratio and oval-shaped nuclei. On the difference between 'hepatic liver stem cells' (HLSC) and 'oval cells':  \\\"... unlike a well-known hepatic progenitor cell population, known as oval cells in rodents, HLSCs do not express CK-7, CK-19, c-kit, CD133 and alpha-smooth muscle actin (α-SMA) (Gaudio et al., 2009)\\\".\")\n16031:AnnotationAssertion(Annotation(terms:contributor <http://orcid.org/0000-0003-1940-6740>) Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) oboInOwl:hasExactSynonym obo:CL_0002196 \"hepatic progenitor cell\")\n16032:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) oboInOwl:hasExactSynonym obo:CL_0002196 \"liver progenitor cell\")\n16661:# Class: obo:CL_0002255 (stromal cell of endometrium)\n16663:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\n16666:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0002255 \"stromal cell of uterus\")\n16669:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal cell\")\n16671:AnnotationAssertion(rdfs:label obo:CL_0002255 \"stromal cell of endometrium\")\n17184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:34433485\") Annotation(oboInOwl:hasDbXref \"PMID:34772990\") obo:IAO_0000115 obo:CL_0002301 \"A resident stromal cell located in the synovial membrane and responsible for the production of immune-related cytokines and chemokines. This cell type secretes glycoproteins and hyaluronic acid, has abundant granular endoplasmic reticulum, but contains fewer vacuoles and vesicles.\")\n17613:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:12457618\") obo:IAO_0000115 obo:CL_0002338 \"A natural killer cell that is developmentally immature, has the phenotype CD34-negative, CD56-positive, CD117-positive, CD122-positive,and CD161-positive.\")\n17651:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19652886\") obo:IAO_0000115 obo:CL_0002342 \"A circulating endothelial cell of the phenotype CD146-positive, CD105-positive, CD45-negative. This cell type is indicative of recent vascular damage.\")\n17671:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:12457618\") obo:IAO_0000115 obo:CL_0002344 \"A natural killer cell that is developmentally immature, has the phenotype CD34-negative, CD56-negative, CD117-positive, CD122-positive,and CD161-positive.\")\n17737:# Class: obo:CL_0002351 (progenitor cell of endocrine pancreas)\n17739:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20025937\") Annotation(oboInOwl:hasDbXref \"PMID:20217494\") Annotation(oboInOwl:hasDbXref \"PMID:22728667\") obo:IAO_0000115 obo:CL_0002351 \"A progenitor cell that is able to differentiate into the pancreas alpha, beta and delta endocrine cells. This cell type expresses neurogenin-3 and Isl-1.\")\n17743:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002351 \"pancreatic islet progenitor cell\")\n17744:AnnotationAssertion(rdfs:label obo:CL_0002351 \"progenitor cell of endocrine pancreas\")\n17756:# Class: obo:CL_0002353 (fetal liver hematopoietic progenitor cell)\n17758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:978-1-60327-346-6\") Annotation(oboInOwl:hasDbXref \"PMID:16569764\") obo:IAO_0000115 obo:CL_0002353 \"A hematopoietic stem cell that resides in the fetal liver. In mice, this cell type is first observed at E10.5. This cell type is MHC-positive, HSA-positive, AA4.1-positive, CD45-positive, Sca-1 positive, CD150-positive, CD48-negative and CD244-negative.\")\n17761:AnnotationAssertion(rdfs:label obo:CL_0002353 \"fetal liver hematopoietic progenitor cell\")\n17768:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"doi:10.1097/MOH.0b013e3282f97ae1\") obo:IAO_0000115 obo:CL_0002354 \"A hematopoietic stem found in the yolk sac. In mice, this cell type is Sca-1-negative, CD45-negative, MHC-negative, HSA-positive, AA4.1-positive, CD44-positive.\")\n17839:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0813817986\") Annotation(oboInOwl:hasDbXref \"PMID:20711979\") obo:IAO_0000115 obo:CL_0002361 \"A progenitor cell that is capable of forming colonies of primitive erythrocytes in the blood island of the yolk sac. First arrive at E7.5 in mouse and expresses CD41.\")\n17993:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15580626\") Annotation(oboInOwl:hasDbXref \"PMID:30971890\") Annotation(oboInOwl:hasDbXref \"PMID:35815410\") obo:IAO_0000115 obo:CL_0002375 \"A multipotent progenitor cell that develops from a migratory neural crest cell. The schwann cell precursor is embedded among axons, with minimal extracellular space separating them from nerve cell membranes. This cell lacks a basal lamina, which distinguishes it from more mature Schwann cells. In rodents, cadherin-19 (Cdh19) serves as a specific marker for this developmental stage.\")\n18484:AnnotationAssertion(rdfs:comment obo:CL_0002425 \"ETPs are reportedly CD1a-negative, CD4-negative, CD7-positive, CD8a-negative, CD8b-negative, CD33-low, CD34-high, CD38-low, CD45RA-positive, and CD45RO-negative.\")\n18764:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:16367798\") Annotation(oboInOwl:hasDbXref \"PMID:20142420\") Annotation(oboInOwl:hasDbXref \"PMID:31583586\") Annotation(oboInOwl:hasDbXref \"PMID:31726662\") Annotation(oboInOwl:hasDbXref \"PMID:37653126\") obo:IAO_0000115 obo:CL_0002453 \"A proliferative and migratory glial progenitor cell that derives from a neural stem cell and resides within the central nervous system. It possesses the capacity to differentiate into a committed oligodendrocyte progenitor (COP) through a well-defined series of maturation steps, ultimately giving rise to a myelinating oligodendrocyte (MOL). In mice and humans, it is characterized by the expression of specific molecular markers, including Pdgfra, Cspg4 (also known as NG2) and Olig2.\")\n18766:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:9780702028991\") Annotation(oboInOwl:hasDbXref \"PMID:10704434\") Annotation(oboInOwl:hasDbXref \"PMID:2182078\") terms:description obo:CL_0002453 \"This cell type can be purified from optic nerves and other regions of the embryonic, postnatal and adult rat CNS and can be differentiated in vitro to oligodendrocytes and type-2 astrocytes. Some references use the terms 'oligodendrocyte precursor cell' and 'oligodendrocyte type-2 astrocyte (O-2A) progenitor' to refer to the same entity (e.g., PMID:10704434), while others describe an oligodendrocyte type-2 astrocyte (O-2A) progenitor cell as the precurosr to oligodendrocyte- and type-2 astrocyte- progenitor cells (e.g, ISBN:9780702028991).\")\n18815:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002457 \"A Langerhans cell that is in the epidermis and is CD45-positive, MHCII-positive, and CD11b-positive.\")\n18901:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002466 \"A CD11b-positive dendritic cell located in the serosal portion of the small intestine epithelium. This cell type is CD45-positive, MHC-II-positive, CD11c-low, CD103-negative.\")\n19015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002477 \"A macrophage located in adipose tissue that is CD45-positive, CD11c-positive, and SIRPa-positive.\")\n19163:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0004365\") obo:IAO_0000115 obo:CL_0002493 \"A polarized cell that is juxtaposed to fibrocytes in the underlying spiral ligament. This cell type secretes potassium ions derived from fibrocytes through gap junctions.\")\n19288:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002505 \"A CD11b-positive dendritic cell that is CD11b-high, CD45-positive, MHC-II-positive and CD103-negative.\")\n19298:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002506 \"A CD11b-positive dendritic cell that is CD11b-low, CD45-positive, MHC-II-high and CD103-positive that is located in the liver.\")\n19669:# Class: obo:CL_0002546 (embryonic blood vessel endothelial progenitor cell)\n19671:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002546 \"An endothelial progenitor cell that participates in angiogenesis during development.\")\n19675:AnnotationAssertion(rdfs:label obo:CL_0002546 \"embryonic blood vessel endothelial progenitor cell\")\n19929:# Class: obo:CL_0002574 (stromal cell of pancreas)\n19931:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002574 \"A stromal cell of the pancreas.\")\n19934:AnnotationAssertion(rdfs:label obo:CL_0002574 \"stromal cell of pancreas\")\n20346:# Class: obo:CL_0002619 (adult endothelial progenitor cell)\n20348:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20807818\") Annotation(oboInOwl:hasDbXref \"PMID:9020076\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016\") obo:IAO_0000115 obo:CL_0002619 \"An adult angioblastic cell released from the bone marrow, or from the kidney in some teleost species, capable of blood circulation and participation in angiogenesis by differentiating into blood vessel endothelial cells.\")\n20352:AnnotationAssertion(rdfs:comment obo:CL_0002619 \"The existence of adult endothelial progenitor cells has been controversial in the past.\")\n20353:AnnotationAssertion(rdfs:label obo:CL_0002619 \"adult endothelial progenitor cell\")\n20376:# Class: obo:CL_0002622 (prostate stromal cell)\n20378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002622 \"A stromal cell of the prostate.\")\n20382:AnnotationAssertion(rdfs:label obo:CL_0002622 \"prostate stromal cell\")\n20442:AnnotationAssertion(rdfs:comment obo:CL_0002628 \"Immature microglia are reportedly CD34-positive, CD163-negative, MHCI-negative, MHCII-negative.\")\n20452:AnnotationAssertion(rdfs:comment obo:CL_0002629 \"Mature microglia are reportedly CCR2-positive, CD4-positive, CD9-positive, CD11a-positive, CD11b-positive, CD11c-positive, CD13-positive, CD16-positive, CDw17-positive, CD18-positive, CD21-positive, CD26-negative, CD32-positive, CD35-positive, CD36-positive, CD40-positive, CD44-positive, CD45-positive, CD53-positive, CD54-positive, CD56-negative, CD58-positive, CD63-positive, CD64-positive, CD66-positive, CD80-positive, CD86-positive, CD87-positive, CD92-positive, CD106-positive, CD107a-positive, CD147-positive, CD155-positive, CD162-positive, CD163-positive, CD171-negative, CD200R-positive, CXCR3-positive, CX3CR1-positive, fibronectin-positive, GD3-positive, GLUT1-positive, GLUT3-negative, GLUT5-positive, MHCI-positive, MHCII-positive, P2X4-positive, RFD7-negative, RGS5-negative, alpha-SMA-negative, vimentin-positive, and vwf-negative. Mature microglia are capable of producing BDNF, CCL3, CCL5, CCL7, CCL8, CCL9, CCL19, CCL20,CD40L, CSF, CXCL1, CXCL2, CXCL4, CXCL5, CXCL8, CXCL9, CXCL10, glutamate, IL-1beta, IL-1ra, IL-3, IL-6, IL-10, IL-12, LT, MMP-2, MMP-9, NGF, nitric oxide, ROS, TGF-beta, TNF-alpha.\")\n20669:AnnotationAssertion(rdfs:comment obo:CL_0002652 \"Markers expressed on HEV include: MAdCAM-1,PNAd (sulfated and glycosylated molecules, i.e. GlyCAM-1, CD34, endomucin, nepmucin), ICAM-1, ICAM-2,Fuc-TVII, beta 3GlcNAcT-3, GlcNAc6ST2,CCL21, CCL19, CXCL13, CXCL12, Autotaxin, DARC, angiomodulin, LRHG.\")\n20785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17519333\") Annotation(oboInOwl:hasDbXref \"PMID:19745164\") oboInOwl:hasExactSynonym obo:CL_0002664 \"cardiovascular progenitor cell\")\n20791:# Class: obo:CL_0002665 (otic fibrocyte)\n20796:AnnotationAssertion(rdfs:label obo:CL_0002665 \"otic fibrocyte\")\n20800:# Class: obo:CL_0002666 (type 2 otic fibrocyte)\n20802:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002666 \"An otic fibrocyte that underlies the spiral prominence and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20805:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002666 \"type II otic fibrocyte\")\n20806:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004488\") oboInOwl:hasExactSynonym obo:CL_0002666 \"type II spiral ligament fibrocyte\")\n20807:AnnotationAssertion(rdfs:label obo:CL_0002666 \"type 2 otic fibrocyte\")\n20810:# Class: obo:CL_0002667 (type 5 otic fibrocyte)\n20812:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002667 \"An otic fibrocyte that resides above the stria vasularis and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20815:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002667 \"type V otic fibrocyte\")\n20816:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002667 \"type V spiral ligament fibrocyte\")\n20817:AnnotationAssertion(rdfs:label obo:CL_0002667 \"type 5 otic fibrocyte\")\n20820:# Class: obo:CL_0002668 (type 4 otic fibrocyte)\n20822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002668 \"An otic fibrocyte that is lateral to the basilar membrane and anchoris it to the lateral wall.\")\n20825:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV otic fibrocyte\")\n20826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004490\") oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV spiral ligament fibrocyte\")\n20827:AnnotationAssertion(rdfs:label obo:CL_0002668 \"type 4 otic fibrocyte\")\n20830:# Class: obo:CL_0002669 (type 3 otic fibrocyte)\n20832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002669 \"An otic fibrocyte that lines the otic capsule.\")\n20835:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002669 \"type III otic fibrocyte\")\n20836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004489\") oboInOwl:hasExactSynonym obo:CL_0002669 \"type III spiral ligament fibrocyte\")\n20837:AnnotationAssertion(rdfs:label obo:CL_0002669 \"type 3 otic fibrocyte\")\n20840:# Class: obo:CL_0002670 (type 1 otic fibrocyte)\n20842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002670 \"An otic fibrocyte that underlies the stria vascularis and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20845:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002670 \"type I otic fibrocyte\")\n20846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004487\") oboInOwl:hasExactSynonym obo:CL_0002670 \"type I spiral ligament fibrocyte\")\n20847:AnnotationAssertion(rdfs:label obo:CL_0002670 \"type 1 otic fibrocyte\")\n20858:# Class: obo:CL_0002672 (retinal progenitor cell)\n20863:AnnotationAssertion(rdfs:label obo:CL_0002672 \"retinal progenitor cell\")\n20911:AnnotationAssertion(rdfs:comment obo:CL_0002677 \"This cell type has been described as CD45RA-negative, but this doesn't fit with our current definition of naive T cell.\")\n20921:AnnotationAssertion(rdfs:comment obo:CL_0002678 \"Cell has been described as being CD45RA-positive in human, but this doesn't fit with our current definition memory T cell.\")\n22399:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005020 \"Lymphatic progenitor cells.\")\n22409:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15624319\") Annotation(oboInOwl:hasDbXref \"PMID:18430230\") obo:IAO_0000115 obo:CL_0005021 \"Mesenchymal derived lymphatic progenitor cells that give rise to the superficial lymphatics.\")\n22418:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005022 \"Lymphatic progenitor cells, derived from the veins, that give rise to lymphatic endothelial cells.\")\n22562:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0007010 \"osteoprogenitor cell\")\n23234:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30827895\") oboInOwl:hasExactSynonym obo:CL_0009010 \"transit amplifying progenitor cell\")\n23275:# Class: obo:CL_0009013 (fetal hepatobiliary progenitor cell)\n23277:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31350390\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-3163-0115\") obo:IAO_0000115 obo:CL_0009013 \"A progenitor cell with hepatic and biliary lineage potential, identified in mouse and human, and anatomically restricted to the ductal plate of fetal liver.\")\n23280:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009013 \"fetal hepatobiliary hybrid progenitor cell\")\n23282:AnnotationAssertion(rdfs:label obo:CL_0009013 \"fetal hepatobiliary progenitor cell\")\n23360:# Class: obo:CL_0009021 (stromal cell of lamina propria of large intestine)\n23362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009021 \"A stromal cell found in the lamina propria of the large intestine.\")\n23365:AnnotationAssertion(rdfs:label obo:CL_0009021 \"stromal cell of lamina propria of large intestine\")\n23368:# Class: obo:CL_0009022 (stromal cell of lamina propria of small intestine)\n23370:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009022 \"A stromal cell found in the lamina propria of the small intestine.\")\n23373:AnnotationAssertion(rdfs:label obo:CL_0009022 \"stromal cell of lamina propria of small intestine\")\n23511:# Class: obo:CL_0009035 (stromal cell of lamina propria of vermiform appendix)\n23513:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009035 \"A stromal cell found in the lamina propria of the vermiform appendix.\")\n23515:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009035 \"stromal cell of appendix lamina propria\")\n23516:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009035 \"stromal cell of lamina propria of appendix vermiformis\")\n23518:AnnotationAssertion(rdfs:label obo:CL_0009035 \"stromal cell of lamina propria of vermiform appendix\")\n23563:# Class: obo:CL_0009040 (stromal cell of lamina propria of colon)\n23565:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009040 \"A stromal cell found in the lamina propria of the colon.\")\n23567:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009040 \"stromal cell of colon lamina propria\")\n23569:AnnotationAssertion(rdfs:label obo:CL_0009040 \"stromal cell of lamina propria of colon\")\n23694:# Class: obo:CL_0009053 (stromal cell of anorectum lamina propria)\n23696:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009053 \"A stromal cell found in the lamina propria of the anorectum.\")\n23699:AnnotationAssertion(rdfs:label obo:CL_0009053 \"stromal cell of anorectum lamina propria\")\n24018:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Colony_forming_unit_–_Hill\") obo:IAO_0000115 obo:CL_0009085 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. They may form discrete colonies.\")\n24048:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Circulating_angiogenic_cell\") obo:IAO_0000115 obo:CL_0009088 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. These cells do not form colonies.\")\n24068:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33419165\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_colony_forming_cell&oldid=1068242094\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_0009090 \"An adult endothelial progenitor cell that is resident of adult vasculature and capable of differentiating to regenerate endothelial cell populations. Endothelial colony forming cells are characterised in vivo by clonal proliferative status, de novo vessel formation, homing to ischemic sites and paracrine support of angiogenesis. These cells are phenotypically similar to endothelial cells.\")\n24163:# Class: obo:CL_0009099 (fibro/adipogenic progenitor cell)\n24165:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n24169:AnnotationAssertion(rdfs:label obo:CL_0009099 \"fibro/adipogenic progenitor cell\")\n24355:# Class: obo:CL_0009116 (progenitor cell of mammary luminal epithelium)\n24357:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19063729\") Annotation(oboInOwl:hasDbXref \"PMID:20346151\") Annotation(oboInOwl:hasDbXref \"PMID:21930782\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4412-7970\") obo:IAO_0000115 obo:CL_0009116 \"A progenitor cell with the potential to differentiate into luminal epithelial cells of mammary glands. In mouse, CD61 and c-kit were found to be coexpressed by the majority of, but not all, committed luminal progenitor cells.\")\n24359:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009116 \"luminal progenitor cell\")\n24360:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009116 \"progenitor cell of luminal mammary epithelium\")\n24361:AnnotationAssertion(rdfs:label obo:CL_0009116 \"progenitor cell of mammary luminal epithelium\")\n24372:# Class: obo:CL_0010001 (stromal cell of bone marrow)\n24374:AnnotationAssertion(obo:IAO_0000115 obo:CL_0010001 \"A stromal cell that is part_of a bone marrow.\")\n24376:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0010001 \"bone marrow stromal cell\")\n24377:AnnotationAssertion(rdfs:label obo:CL_0010001 \"stromal cell of bone marrow\")\n24677:# Class: obo:CL_0011020 (neural progenitor cell)\n24681:AnnotationAssertion(rdfs:label obo:CL_0011020 \"neural progenitor cell\")\n24730:# Class: obo:CL_0011026 (progenitor cell)\n24734:AnnotationAssertion(rdfs:label obo:CL_0011026 \"progenitor cell\")\n25720:# Class: obo:CL_1000308 (fibrocyte of adventitia of ureter)\n25722:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000308 \"A fibrocyte that is part of the adventitia of ureter.\")\n25724:AnnotationAssertion(rdfs:label obo:CL_1000308 \"fibrocyte of adventitia of ureter\")\n27382:# Class: obo:CL_1000693 (kidney interstitial fibrocyte)\n27385:AnnotationAssertion(rdfs:label obo:CL_1000693 \"kidney interstitial fibrocyte\")\n28583:# Class: obo:CL_1001610 (bone marrow hematopoietic cell)\n28587:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-2109\") oboInOwl:hasRelatedSynonym obo:CL_1001610 \"bone marrow hematopoietic cells\")\n28589:AnnotationAssertion(rdfs:label obo:CL_1001610 \"bone marrow hematopoietic cell\")\n28631:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"BTO:0002770\") Annotation(oboInOwl:hasDbXref \"NCIT:C32429\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"Wiki:Decidual_cells&oldid=937509751\") Annotation(oboInOwl:hasDbXref \"Wiki:Decidualization&oldid=908981933\") obo:IAO_0000115 obo:CL_2000002 \"A specialized, enlarged, connective tissue cell of the decidua with enlarged nucleus, dense membrane‐bound secretory granules and cytoplasmic accumulation of glycogen and lipid droplets. These cells develop by the transformation of endometrial stromal cells during decidualization.\")\n28637:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"BTO:0005756\") Annotation(oboInOwl:hasDbXref \"PMID:11719592\") oboInOwl:hasExactSynonym obo:CL_2000002 \"decidual stromal cell\")\n28638:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31907034\") oboInOwl:hasExactSynonym obo:CL_2000002 \"decidualized endometrial stromal cell\")\n29191:# Class: obo:CL_2000061 (placental amniotic mesenchymal stromal cell)\n29198:AnnotationAssertion(rdfs:label obo:CL_2000061 \"placental amniotic mesenchymal stromal cell\")\n29555:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:30498493\") Annotation(oboInOwl:hasDbXref \"PMID:34745147\") Annotation(oboInOwl:hasDbXref \"PMID:35438172\") obo:IAO_0000115 obo:CL_3000001 \"A tissue-resident macrophage that is part of the placenta. A Hofbauer cell expresses high levels of growth factors and metalloproteinases that support vasculogenesis, angiogenesis, branching morphogenesis and tissue remodeling. A Hofbauer cell has a fetal origin, is found in the villous stroma, chorion, and amnion, and is present throughout pregnancy.\")\n31090:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028003 \"CD34hi endothelial cells\")\n31128:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"type-2 associated stromal cell\")\n31177:# Class: obo:CL_4030001 (stromal cell of thymus)\n31179:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030001 \"A stromal cell that is part of the thymus.\")\n31181:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030001 \"thymic stromal cell\")\n31182:AnnotationAssertion(rdfs:label obo:CL_4030001 \"stromal cell of thymus\")\n31185:# Class: obo:CL_4030002 (effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated)\n31187:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2825-0621\") obo:IAO_0000115 obo:CL_4030002 \"An alpha-beta memory T cell with the phenotype CD45RA-positive.\")\n31192:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory CD45RA+ T cells\")\n31193:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/T_cell#Memory_T_cells\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory cells re-expressing CD45RA\")\n31194:AnnotationAssertion(rdfs:label obo:CL_4030002 \"effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated\")\n31528:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") rdfs:comment obo:CL_4030038 \"After acute tubular injury, this cell type becomes more numerous. In healthy rat kidneys, this cell is not detectable, whereas after unilateral ureteral obstruction (renal injury), it may appear de novo, arguing against the notion that this cell type represents a pre-existing progenitor cell population. In at least one study, data indicate that this cell type represents transiently dedifferentiated tubular cells involved in regeneration.\")\n32338:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\n32344:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\n32442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor cell\")\n32891:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29426702\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") rdfs:comment obo:CL_4042003 \"In humans, a border associate macrophage expresses CD45 and CD11B. This cell is also known to have the following molecular signature: CD206, CD38, LYVE1, CD163, CD169.\")\n33100:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10467245\") obo:IAO_0000115 obo:CL_4042021 \"A progenitor cell of the central nervous system that differentiates exclusively onto neurons. This progenitor cell is found in a hippocampus subventricular zone, developing cortex and spinal cord of the central nervous system.\")\n33112:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15531362\") Annotation(oboInOwl:hasDbXref \"PMID:33052610\") obo:IAO_0000115 obo:CL_4042022 \"A progenitor cell of the central nervous system that differentiates exclusively onto astrocytes. This progenitor cell expresses CD44 and S100 calcium-binding protein B.\")\n33117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") rdfs:comment obo:CL_4042022 \"In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.\")\n33373:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24853910\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047012 \"A specialized pericyte that actively participates in the formation of new blood vessels during angiogenesis by undergoing phenotypic changes, increasing proliferation, and interacting closely with endothelial cells.\")\n33443:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2019.00282\") obo:IAO_0000115 obo:CL_4047032 \"A specialized pericyte located within the basement membrane of a blood capillary. This cell is characterized by its ability to produce and release a variety of bioactive molecules, collectively known as the pericyte secretome, including cytokines and regulators of angiogenesis.\")\n33593:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28845904\") Annotation(oboInOwl:hasDbXref \"PMID:33681216\") Annotation(oboInOwl:hasDbXref \"PMID:34302064\") obo:IAO_0000115 obo:CL_4047054 \"A dendritic cell capable of capturing antigens in peripheral tissues and migrating through blood or lymphatic vessels to secondary lymphoid organs, where it presents processed antigens to T cells. It expresses MHC class II molecules and lacks lineage markers associated with other leukocyte populations, distinguishing it as a member of the dendritic cell lineage. This cell plays a pivotal role in initiating and regulating adaptive immune responses by linking peripheral antigen capture with T cell activation in lymphoid tissues.\")\n33713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\n33745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_4052010 \"A stromal cell that serves as a precursor to the theca cell layers in the ovary growing follicles. This cell is present in the early stages of follicular growth, particularly in smaller follicles. Unlike mature theca cell, a pre-theca cell is initially non-steroidogenic and lacks luteinizing hormone receptors.\")\n34102:# Class: obo:CL_4052045 (steroidogenic stromal cell of ovary)\n34104:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\n34107:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic interstitial stromal cell\")\n34108:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic stromal cell\")\n34110:AnnotationAssertion(rdfs:label obo:CL_4052045 \"steroidogenic stromal cell of ovary\")\n34239:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\n34315:# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n34317:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n34323:AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n34437:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n","exit_code":0,"status":"completed"}}
