799\")\n\n  Line 3937: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013087\") obo:IAO_0000115 obo:CL_0000018 \"A male germ cell that develops from the haploid secondary spermatocytes. Without further division, spermatids undergo structural changes and give rise to spermatozoa.\")\n\n  Line 3938: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000018 \"BTO:0001274\")\n\n  Line 3939: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000018 \"CALOHA:TS-0950\")\n\n  Line 3940: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000018 \"EMAPA:31486\")\n\n  Line 3941: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000018 \"FMA:72294\")\n\n  Line 3942: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000018 \"WBbt:0006800\")\n\n  Line 3943: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000018 \"nematoblast\")\n\n  Line 3950: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D013094\") obo:IAO_0000115 obo:CL_0000019 \"A mature male germ cell that develops from a spermatid.\")\n\n  Line 3951: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000019 \"BTO:0001277\")\n\n  Line 3952: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000019 \"BTO:0002046\")\n\n  Line 3953: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000019 \"CALOHA:TS-0949\")\n\n  Line 3954: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000019 \"FMA:67338\")\n\n  Line 3955: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000019 \"WBbt:0006798\")\n\n  Line 3956: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000019 \"sperm cell\")\n\n  Line 3957: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000019 \"spermatozoid\")\n\n  Line 3958: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000019 \"spermatozoon\")\n\n  Line 3965: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013093\") obo:IAO_0000115 obo:CL_0000020 \"An euploid male germ cell of an early stage of spermatogenesis.\")\n\n  Line 3966: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000020 \"BTO:0000958\")\n\n  Line 3967: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000020 \"CALOHA:TS-2193\")\n\n  Line 3968: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000020 \"EMAPA:31482\")\n\n  Line 3969: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000020 \"FMA:72291\")\n\n  Line 3970: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000020 \"spermatogonial cell\")\n\n  Line 3976: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11023867\") Annotation(oboInOwl:hasDbXref \"PMID:20454446\") obo:IAO_0000115 obo:CL_0000021 \"Female germ cell is a germ cell that supports female gamete production.\")\n\n  Line 3977: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000021 \"MA:0000388\")\n\n  Line 3978: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000021 \"VHOG:0001530\")\n\n  Line 3979: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000021 \"ncithesaurus:Egg\")\n\n  Line 3986: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.stem.2012.05.016\") obo:IAO_0000115 obo:CL_0000022 \"A stem cell that is the precursor of female gametes.\")\n\n  Line 3994: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000023 \"A female germ cell that has entered meiosis.\")\n\n  Line 3995: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000023 \"BTO:0000964\")\n\n  Line 3996: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000023 \"CALOHA:TS-0711\")\n\n  Line 3997: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000023 \"FMA:18644\")\n\n  Line 3998: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000023 \"MESH:D009865\")\n\n  Line 3999: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000023 \"WBbt:0006797\")\n\n\n(Results truncated: showing 100 of 8146 matches (8046 hidden). Consider using a more specific path or pattern.)","metadata":{"matches":8146,"truncated":true},"title":"hasDbXref|oboInOwl:has","time":{"start":177