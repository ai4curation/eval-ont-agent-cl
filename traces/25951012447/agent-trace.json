38:SubClassOf(obo:CL_0000233 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001405))\n6039:SubClassOf(obo:CL_0000233 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001874))\n6040:SubClassOf(obo:CL_0000233 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000556))\n6041:SubClassOf(obo:CL_0000233 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001820))\n6042:SubClassOf(obo:CL_0000233 ObjectSomeValuesFrom(obo:RO_0002216 obo:GO_0007596))\n6138:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000243 <https://github.com/obophenotype/cell-ontology/issues/715>)\n6282:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000264 \"Obsolete. Use PO:0000400 from Plant Ontology instead. A cambial cell on the phloem side of the cambial zone that is the source of one or more cells arising by periclinal divisions and differentiating into phloem elements with or without additional divisions in various planes.\")\n6334:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000272 \"OBSOLETE, use term from Plant Ontology. A cell localized in the vascular cambium or phellogen. Its periclinal division can contribute cells either to the outside or to the inside of the axis; in vascular cambium, classified into fusiform initials (source of axial cells of xylem and phloem) and ray initials (source of the ray cells).\")\n6473:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000293 <https://github.com/obophenotype/cell-ontology/issues/3010>)\n6678:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000321 <https://github.com/obophenotype/cell-ontology/issues/1149>)\n7127:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000381 <https://github.com/obophenotype/cell-ontology/issues/1784>)\n7161:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000386 <https://github.com/obophenotype/cell-ontology/issues/3016>)\n7196:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000391 <https://github.com/obophenotype/cell-ontology/issues/1949>)\n7243:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000398 <https://github.com/obophenotype/cell-ontology/issues/1949>)\n7264:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000401 <https://github.com/obophenotype/cell-ontology/issues/1949>)\n7273:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000402 <https://github.com/obophenotype/cell-ontology/issues/2869>)\n7293:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000405 <https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1621>)\n7441:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000426 <https://github.com/obophenotype/cell-ontology/issues/708>)\n7560:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/issues/1943\") obo:CL_0000441 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7656:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000452 <https://github.com/obophenotype/cell-ontology/issues/3161>)\n7817:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000473 <https://github.com/obophenotype/cell-ontology/pull/3056>)\n7857:SubClassOf(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:CL_0000477 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n8272:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/pull/1950\") obo:CL_0000530 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n8309:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/pull/1950\") obo:CL_0000535 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n8447:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000548 <https://github.com/obophenotype/cell-ontology/issues/2124>)\n8683:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0000569 \"A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.\")\n9226:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000627 <https://github.com/obophenotype/cell-ontology/issues/2990>)\n9233:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000628 \"A cell that can perform photosynthesis, in which carbohydrates are synthesized from carbon dioxide and water, using light as the energy source.\")\n9574:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000663 <https://github.com/obophenotype/cell-ontology/issues/726>)\n9581:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000664 <https://github.com/obophenotype/cell-ontology/issues/726>)\n9588:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000665 <https://github.com/obophenotype/cell-ontology/issues/726>)\n10014:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000717 <https://github.com/obophenotype/cell-ontology/issues/1364>)\n10081:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000727 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10088:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000728 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10095:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000729 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10213:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35179487\") rdfs:comment obo:CL_0000743 \"Despite historical descriptions as 'terminally differentiated,' hypertrophic chondrocytes survive and transdifferentiate into osteoblasts. Genetic lineage tracing shows that hypertrophic chondrocytes do not simply undergo apoptosis but cross the cartilage–bone boundary, dedifferentiate into skeletal stem/progenitor cells, and then redifferentiate into osteoblasts and osteocytes. Single-cell RNA-seq further indicates that these chondrocyte-derived SSPCs are a major source of trabecular osteoblasts and marrow adipocytes.\")\n10392:AnnotationAssertion(rdfs:comment obo:CL_0000762 \"Note that this is a non-mammalian cell type. Use platelet ; CL:0000233 for thrombocytes (platelets) in mammals.\")\n11106:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:11861604\") Annotation(oboInOwl:hasDbXref \"PMID:20933013\") Annotation(oboInOwl:hasDbXref \"PMID:21220451\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/B-1_cell\") obo:IAO_0000115 obo:CL_0000819 \"A B cell of distinct lineage and surface marker expression. B-1 B cells are thought to be the primary source of natural IgM immunoglobulin, that is, IgM produced in large quantities without prior antigenic stimulation and generally reactive against various microorganisms, as well as the source of T-independent IgA immunoglobulin in the mucosal areas. These cells are CD43-positive.\")\n15695:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002154 \"FMA:83533\")\n15891:AnnotationAssertion(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:RO_0002161 obo:CL_0002174 obo:NCBITaxon_50557)\n16024:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:16824012\") Annotation(oboInOwl:hasDbXref \"PMID:32187560\") Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Basal_cell\") Annotation(oboInOwl:hasDbXref \"doi:/10.1073/pnas.1734203100\") obo:IAO_0000115 obo:CL_0002187 \"A mitotically active, columnar-shaped keratinocyte located in the stratum basale of the epidermis and attached to the basement membrane. This cell exhibits heterogeneity, encompassing stem and progenitor subpopulations with distinct molecular and proliferative characteristics (Haensel et al., 2020), and serves as the primary source of new keratinocytes for epidermal renewal, homeostasis, and regeneration.\")\n17132:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15738192\") obo:IAO_0000115 obo:CL_0002287 \"A rounded, mitotically active stem cell which is the source of new cells of the taste bud; located basally.\")\n18055:AnnotationAssertion(obo:IAO_0000233 obo:CL_0002371 <https://github.com/obophenotype/cell-ontology/issues/1150>)\n18859:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:hjd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15987436\") Annotation(oboInOwl:hasDbXref \"PMID:16397499\") Annotation(oboInOwl:hasDbXref \"PMID:17851544\") obo:IAO_0000115 obo:CL_0002451 \"A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.\")\n23046:AnnotationAssertion(obo:IAO_0000233 obo:CL_0008029 <https://github.com/obophenotype/cell-ontology/issues/1540>)\n23055:AnnotationAssertion(obo:IAO_0000233 obo:CL_0008030 <https://github.com/obophenotype/cell-ontology/issues/1540>)\n24549:AnnotationAssertion(obo:IAO_0000233 obo:CL_0010003 <https://github.com/obophenotype/cell-ontology/issues/2429>)\n25113:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30069044\") Annotation(oboInOwl:hasDbXref \"PMID:30069046\") obo:IAO_0000115 obo:CL_0017000 \"An ionocyte that is part of the lung epithelium. The cells from this type are major sources of the CFTR protein in human and mice.\")\n25220:AnnotationAssertion(obo:IAO_0000233 obo:CL_0017501 <https://github.com/obophenotype/cell-ontology/issues/734>)\n25257:AnnotationAssertion(obo:IAO_0000233 obo:CL_0017505 <https://github.com/obophenotype/cell-ontology/issues/2251>)\n25532:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:21925242\") Annotation(oboInOwl:hasDbXref \"PMID:2329464\") Annotation(oboInOwl:hasDbXref \"PMID:25374536\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") obo:IAO_0000115 obo:CL_0020008 \"A large aspiny interneuron of the striatum that serves as the principal intrinsic source of acetylcholine while simultaneously releasing GABA. It is defined by coexpression of cholinergic markers (ChAT and VAChT/Slc18a3) and GABAergic markers (GAD65/Gad2 and VGAT/Slc32a1) (Lozovaya et al., 2018). This MGE-derived neuron maintains Lhx6 expression associated with dual-transmitter identity (Fragkouli et al., 2009; Marin et al., 2000). Morphologically, it possesses a large soma (20–50 μm diameter), 2–4 thick aspiny dendrites extending radially ~1 mm, and locally ramified axons with hundreds of thousands of varicosities (Wilson et al., 1990; Lim et al., 2014).\")\n25744:AnnotationAssertion(obo:IAO_0000233 obo:CL_0020026 \"https://github.com/obophenotype/cell-ontology/issues/3493\")\n25796:AnnotationAssertion(obo:IAO_0000233 obo:CL_0020030 <https://github.com/obophenotype/cell-ontology/issues/3453>)\n25812:AnnotationAssertion(obo:IAO_0000233 obo:CL_0020031 <https://github.com/obophenotype/cell-ontology/issues/3453>)\n25874:AnnotationAssertion(obo:IAO_0000233 obo:CL_0020035 \"https://github.com/obophenotype/cell-ontology/issues/3455\")\n28365:AnnotationAssertion(rdfs:comment obo:CL_1001064 \"Note that the source of this term is KUPO:0001096 (artery smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28373:AnnotationAssertion(rdfs:comment obo:CL_1001066 \"Note that the source of this term is KUPO:0001098 (arteriole smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28381:AnnotationAssertion(rdfs:comment obo:CL_1001068 \"Note that the source of this term is KUPO:0001068 (venous system smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28840:AnnotationAssertion(obo:IAO_0000233 obo:CL_1001566 <https://github.com/obophenotype/cell-ontology/issues/1443>)\n30013:AnnotationAssertion(obo:IAO_0000233 obo:CL_2000082 <https://github.com/obophenotype/cell-ontology/issues/1562>)\n30635:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023034 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n30990:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023067 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31019:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023070 <https://github.com/obophenotype/cell-ontology/pull/2374>)\n31055:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023073 <https://github.com/obophenotype/cell-ontology/issues/2043>)\n31106:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023078 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31860:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\n34696:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n35608:AnnotationAssertion(obo:IAO_0000233 obo:CL_7770002 \"https://github.com/obophenotype/cell-ontology/issues/3275\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"I found no existing zonal articular chondrocyte terms. There are related chondrocyte terms, but they are molecular/state classes rather than depth-zone anatomical subclasses, so I’ll add four direct zonal subclasses of `articular chondrocyte` with synonyms and issue tracker annotations."}}
