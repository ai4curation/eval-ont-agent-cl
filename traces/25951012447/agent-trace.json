Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072035 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sncg.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072035 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072035 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072035 \"2025-09-05T10:49:37Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072035 \"ILX:0770150\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072035 \"The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072035 \"sncg GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072035 obo:CL_4023015)\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_O76070))\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000081))\n\n# Class: obo:CL_4072036 (PAX6 GABAergic interneuron (Homo sapiens))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072036 \"Pax6 interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072036 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses the transcript PAX6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters PAX\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072036 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072036 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072036 \"2025-09-10T08:47:34Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072036 \"The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072036 \"PAX6 GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072036 obo:CL_4042032)\nSubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000079))\n\n# Class: obo:CL_4072037 (L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072037 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L2/3 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072037 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072037 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072037 \"2025-09-10T09:15:51Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072037 \"ILX:0770156\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072037 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072037 \"The marker set ONECUT2, COL5A2 can identify the Human cell type L2/3 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.670149932 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072037 \"L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072037 obo:CL_4030059)\nSubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000065))\n\n# Class: obo:CL_4072038 (L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072038 \"L5 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072038 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L5 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072038 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072038 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072038 \"2025-09-10T09:47:23Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072038 \"ILX:0770157\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072038 \"L5 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072038 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072038 \"L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072038 obo:CL_4030064)\nSubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000068))\n\n# Class: obo:CL