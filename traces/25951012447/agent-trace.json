{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '25580,25895p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(rdfs:label obo:CL_0020012 \"hair follicle isthmus-associated fibroblast\")\nEquivalentClasses(obo:CL_0020012 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006005)))\n\n# Class: obo:CL_0020013 (dermal sheath fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31857493\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_0020013 \"A fibroblast forming the connective tissue sheath that encloses the hair follicle epithelium from the level of the bulge downward to the hair bulb. This cell expresses characteristic markers, including DPEP1 in humans and COL11A1 and ACTA2 (alpha-smooth muscle actin) in mice and humans. Dermal sheath fibroblast possesses contractile properties mediated by calcium-calmodulin-myosin light chain kinase signalling, generating centripetal force during hair follicle catagen that relocates the dermal papilla to the stem cell niche.\")\nAnnotationAssertion(terms:contributor obo:CL_0020013 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34297930\") oboInOwl:hasRelatedSynonym obo:CL_0020013 \"DS fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0020013 \"dermal sheath fibroblast\")\nSubClassOf(obo:CL_0020013 obo:CL_0000057)\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006936))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003675))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005694))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P16444))\n\n# Class: obo:CL_0020014 (intrinsically photosensitive retinal ganglion cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11834834\") Annotation(oboInOwl:hasDbXref \"PMID:20959623\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Intrinsically_photosensitive_retinal_ganglion_cell\") obo:IAO_0000115 obo:CL_0020014 \"A retinal ganglion cell that is intrinsically photosensitive, functioning as a non-image-forming photoreceptor, distinguished from rod and cone photoreceptors by the expression of the photopigment melanopsin in mice and humans (Hattar et al., 2002; Tri Hoang Do & Yau, 2015). Located primarily in the ganglion cell layer with some displaced somata in the inner nuclear layer, this neuron depolarises directly in response to environmental irradiance (Tri Hoang Do & Yau, 2015). It projects via the retinohypothalamic tract to central targets, including the suprachiasmatic nucleus (SCN) for circadian photoentrainment and the olivary pretectal nucleus (OPN) for the pupillary light reflex.\")\nAnnotationAssertion(dc:creator obo:CL_0020014 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020014 <https://orcid.org/0000-0003-2473-2313>)\nAnnotationAssertion(terms:contributor obo:CL_0020014 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://www.wikidata.org/entity/Q934475\") oboInOwl:hasBroadSynonym obo:CL_0020014 \"photosensitive ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20959623\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020014 \"ipRGC\")\nAnnotationAssertion(rdfs:label obo:CL_0020014 \"intrinsically photosensitive retinal ganglion cell\")\nSubClassOf(obo:CL_0020014 obo:CL_0000210)\nSubClassOf(obo:CL_0020014 obo:CL_0000740)\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n\n# Class: obo:CL_0020015 (transitional principal-intercalated cell of kidney collecting duct)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33893305\") Annotation(oboInOwl:hasDbXref \"PMID:37468583\") obo:IAO_0000115 obo:CL_0020015 \"A transitional cell located in the renal collecting duct that co-expresses markers of both principal cell (PC) and intercalated cell (IC). This hybrid cell is enriched in Chronic Kidney Disease (CKD).\")\nAnnotationAssertion(dc:creator obo:CL_0020015 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0000-0002-2999-0103>)\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") oboInOwl:hasBroadSynonym obo:CL_0020015 \"hybrid principal-intercalated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020015 \"tPC-IC cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020015 \"transitional principal-intercalated cell of kidney collecting duct\")\nSubClassOf(obo:CL_0020015 obo:CL_1000454)\nSubClassOf(obo:CL_0020015 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232))\n\n# Class: obo:CL_0020016 (osteochondral skeletal stem cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")\nAnnotationAssertion(terms:contributor obo:CL_0020016 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020016 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020016 \"2025-11-27T00:00:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020016 \"ocSSC\")\nAnnotationAssertion(rdfs:label obo:CL_0020016 \"osteochondral skeletal stem cell\")\nSubClassOf(obo:CL_0020016 obo:CL_0000034)\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001434))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001649))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051216))\n\n# Class: obo:CL_0020017 (M0 macrophage)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") Annotation(oboInOwl:hasDbXref \"PMID:30861466\") obo:IAO_0000115 obo:CL_0020017 \"A macrophage that has not yet undergone polarization into a specific macrophage subtype. These cells are non-activated and have the potential to differentiate into inflammatory (M1) or alternatively activated (M2) macrophage subtypes in response to appropriate stimuli.\")\nAnnotationAssertion(dc:creator obo:CL_0020017 \"GitHub Copilot\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"naive macrophage\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"non-activated macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") oboInOwl:hasExactSynonym obo:CL_0020017 \"resting-state macrophages\")\nAnnotationAssertion(rdfs:label obo:CL_0020017 \"M0 macrophage\")\nSubClassOf(obo:CL_0020017 obo:CL_0000235)\n\n# Class: obo:CL_0020018 (proliferative fibrochondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:39759119\") obo:IAO_0000115 obo:CL_0020018 \"A fibrochondrocyte located in fibrocartilage that exhibits active proliferation capacity and is in S phase of the cell cycle. It functions as a progenitor cell positioned at the root of developmental trajectories alongside fibrochondrocyte progenitors (FCP), with the capacity to diverge toward one of two developmental fates: (1) fibrochondrocytes and prehypertrophic chondrocytes, or (2) regulatory chondrocytes and prehypertrophic chondrocytes. It is characterised by co-expression of COL1A1, the growth factors FGF7 and CTGF, and the cell-cycle genes STMN1, KIAA0101, and MCM3 in humans. During early progenitor differentiation, FGF7 and COL1A1 expression increases and then declines as the cell commits to terminal fates.\")\nAnnotationAssertion(terms:contributor obo:CL_0020018 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020018 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020018 \"2025-11-27T12:48:39Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020018 \"ProFC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020018 \"Lineage relationships are inferred from single-cell RNA-seq trajectories and validated through experimental approaches, including FACS isolation, functional differentiation assays, and in vivo developmental gene expression analysis.\")\nAnnotationAssertion(rdfs:label obo:CL_0020018 \"proliferative fibrochondrocyte\")\nSubClassOf(obo:CL_0020018 obo:CL_4072104)\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0022402))\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007498))\n\n# Class: obo:CL_0020019 (regulatory chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020019 \"A chondrocyte located mainly in the superficial zone of articular cartilage. In healthy human cartilage, regulatory chondrocytes are characterized by expression of EIF5A, PGK1, ANXA1, and TUBA1A. During osteoarthritis, a distinct subpopulation expands, marked by high expression of CHI3L1, CHI3L2, CRTAC1, and AEBP1, with enrichment for signaling pathway regulation (including Toll-like receptor, mTOR, and TGF-beta signaling) and antigen-processing gene expression, with a small proportion expressing MHC class II genes, suggesting potential immune cell-like regulatory functions during osteoarthritis progression.\")\nAnnotationAssertion(dc:creator obo:CL_0020019 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020019 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") oboInOwl:hasRelatedSynonym obo:CL_0020019 \"RegC\")\nAnnotationAssertion(rdfs:label obo:CL_0020019 \"regulatory chondrocyte\")\nSubClassOf(obo:CL_0020019 obo:CL_0000138)\n\n# Class: obo:CL_0020020 (homeostatic chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020020 \"A chondrocyte identified in both healthy and osteoarthritic human articular cartilage, and in intervertebral disc tissue. In healthy articular cartilage, a homeostatic chondrocyte is characterised by the expression of TXNIP, IFITM3, GDF15, and TIMP1 (Wang et al., 2021), among other extracellular matrix and regulatory molecules. This cell maintains cartilage integrity by producing key ECM components and supporting baseline tissue homeostasis. In OA cartilage, this cell is enriched for genes related to cellular homeostasis modulation, including regulation of the cell cycle, development, and RNA metabolism (Ji et al., 2018).\")\nAnnotationAssertion(dc:creator obo:CL_0020020 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020020 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020020 \"HomC\")\nAnnotationAssertion(rdfs:label obo:CL_0020020 \"homeostatic chondrocyte\")\nSubClassOf(obo:CL_0020020 obo:CL_0000138)\nSubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\nSubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990079))\n\n# Class: obo:CL_0020021 (fibrochondrocyte progenitor cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:36338137\") obo:IAO_0000115 obo:CL_0020021 \"A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.\")\nAnnotationAssertion(terms:contributor obo:CL_0020021 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020021 \"GitHub Copilot\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020021 \"FCP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020021 \"A fibrochondrocyte progenitor cell demonstrates colony-forming capacity and multi-lineage differentiation potential toward osteogenic and adipogenic lineages.\")\nAnnotationAssertion(rdfs:label obo:CL_0020021 \"fibrochondrocyte progenitor cell\")\nSubClassOf(obo:CL_0020021 obo:CL_0008019)\nSubClassOf(obo:CL_0020021 obo:CL_0011026)\nSubClassOf(obo:CL_0020021 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995))\n\n# Class: obo:CL_0020022 (prehypertrophic chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29985449\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34137454\") obo:IAO_0000115 obo:CL_0020022 \"A post-proliferative chondrocyte in the prehypertrophic zone of the cartilage tissue, located between the proliferative and hypertrophic zones. This cell is characterised by increased cell volume and expression of Indian Hedgehog (Ihh), PTH1R, and Runx2/3 in both humans and mice (Hallett et al., 2021). It coordinates the PTHrP-Ihh feedback loop that regulates chondrocyte differentiation and functions as a signalling hub for communication between proliferative chondrocytes, hypertrophic chondrocytes, and periosteal osteoblasts (Hallett et al., 2021).\")\nAnnotationAssertion(terms:contributor obo:CL_0020022 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020022 \"preHTC\")\nAnnotationAssertion(rdfs:label obo:CL_0020022 \"prehypertrophic chondrocyte\")\nSubClassOf(obo:CL_0020022 obo:CL_0000138)\nSubClassOf(obo:CL_0020022 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_0000743))\n\n# Class: obo:CL_0020023 (effector chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21652695\") Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:38868774\") Annotation(oboInOwl:hasDbXref \"PMID:40753276\") obo:IAO_0000115 obo:CL_0020023 \"A metabolically highly active chondrocyte that is identified in the cartilaginous tissues, including articular cartilage and intervertebral disc cartilage. In the human articular cartilage, this cell is marked by genes such as CYTL1, FRZB, CLEC3A, and S100B (Ji et al., 2018; Raut et al.,2025). This cell demonstrates strong metabolic activity and is implicated in extracellular matrix regulation and adaptive responses (Ji et al., 2018; Gan et al., 2021; Raut et al.,2025).\")\nAnnotationAssertion(terms:contributor obo:CL_0020023 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020023 \"GitHub Copilot\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0020023 \"2025-12-01T11:46:23Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38868774\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020023 \"EC\")\nAnnotationAssertion(rdfs:label obo:CL_0020023 \"effector chondrocyte\")\nSubClassOf(obo:CL_0020023 obo:CL_0000138)\n\n# Class: obo:CL_0020024 (alpha retinal ganglion cell OFF-sustained (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020024 \"A mouse retinal ganglion cell type defined by a large soma and a wide, monostratified dendritic arbor that stratifies just distal to the outer ChAT band of the inner plexiform layer (Krieger et al., 2017). It corresponds to the G5 physiological type (Baden et al., 2016; Goetz et al., 2022) and the C42 transcriptomic cluster (Tran et al., 2019), and is considered the evolutionary ortholog of the primate OFF midget RGC (Hahn et al., 2023). The cell projects a thick, fast-conducting axon to the dorsal lateral geniculate nucleus and superior colliculus. It shows a sustained increase in firing to light decrements with a slow decay time constant of roughly 250 ms and a large receptive field center with weak surround antagonism (Krieger et al., 2017). Its molecular profile includes expression of Spp1 and Neurofilament (Smi32) together with Brn3a (Pou4f1) and Brn3b (Pou4f2), absence of Brn3c (Pou4f3) and Calbindin (Calb1), and strong enrichment of Fes (Krieger et al., 2017; Tran et al., 2019).\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_0020024 obo:NCBITaxon_10090)\nAnnotationAssertion(terms:contributor obo:CL_0020024 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:creator obo:CL_0020024 \"GitHub Copilot\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020024 \"C42\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") oboInOwl:hasExactSynonym obo:CL_0020024 \"G5\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020024 \"alpha retinal ganglion cell OFF-s\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020024 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\nAnnotationAssertion(rdfs:label obo:CL_0020024 \"alpha retinal ganglion cell OFF-sustained (Mmus)\")\nSubClassOf(obo:CL_0020024 obo:CL_0004117)\nSubClassOf(obo:CL_0020024 obo:CL_4023033)\nSubClassOf(obo:CL_0020024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n\n# Class: obo:CL_0020025 (alpha retinal ganglion cell ON-sustained (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:38092908\") obo:IAO_0000115 obo:CL_0020025 \"A retinal ganglion cell type that has a large soma and a wide, monostratified dendritic arbor that stratifies in the inner sublamina of the inner plexiform layer, with dendrites located just proximal to the inner ChAT band (Krieger et al., 2017). It shows a sustained increase in firing rate to ON stimuli (Krieger et al., 2017). It corresponds to the G24 functional type (Baden et al., 2016; Goetz et al., 2022), the C43 transcriptomic cluster (Tran et al., 2019), and is considered the mouse ortholog of the primate ON midget retinal ganglion cell (Hahn et al., 2023). It is molecularly defined by expression of Spp1, Smi32, Brn3b, Calbindin, and Tbr2 (Krieger et al., 2017; Tran et al., 2019).\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_0020025 obo:NCBITaxon_10090)\nAnnotationAssertion(terms:contributor obo:CL_0020025 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:creator obo:CL_0020025 \"GitHub Copilot\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020025 \"C43\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") oboInOwl:hasExactSynonym obo:CL_0020025 \"G24\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020025 \"alpha retinal ganglion cell ON-s\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020025 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\nAnnotationAssertion(rdfs:label obo:CL_0020025 \"alpha retinal ganglion cell ON-sustained (Mmus)\")\nSubClassOf(obo:CL_0020025 obo:CL_0004117)\nSubClassOf(obo:CL_0020025 obo:CL_4023032)\nSubClassOf(obo:CL_0020025 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n\n# Class: obo:CL_0020026 (alpha retinal ganglion cell OFF-transient (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020026 \"An alpha retinal ganglion cell subtype found in the mouse retina that responds selectively and transiently to decreases in light intensity. It is characterized by a large soma, a broad dendritic arbor that stratifies within sublamina a of the inner plexiform layer, and rapid OFF-transient firing kinetics that decay even during sustained stimulation (Krieger et al., 2017). Functionally, it corresponds to G8 in the Baden functional classification (Baden et al., 2016; Goetz et al., 2022) and C45 in the Tran transcriptomic atlas (Tran et al., 2019), and it is considered the evolutionary ortholog of the primate OFF Parasol RGC (Hahn et al., 2023). This cell type acts as a detector of rapidly approaching dark objects and contributes to innate defensive responses by encoding looming stimuli (Münch et al., 2009). It exhibits a distinctive molecular signature by its expression of Brn3c (Krieger et al., 2017).\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020026 \"https://github.com/obophenotype/cell-ontology/issues/3493\")\nAnnotationAssertion(terms:contributor obo:CL_0020026 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:creator obo:CL_0020026 \"GitHub Copilot\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0020026 \"2025-12-05T11:29:19Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020026 \"alpha retinal ganglion cell OFF-t\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020026 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\nAnnotationAssertion(rdfs:label obo:CL_0020026 \"alpha retinal ganglion cell OFF-transient (Mmus)\")\nSubClassOf(obo:CL_0020026 obo:CL_0004117)\nSubClassOf(obo:CL_0020026 obo:CL_4023033)\nSubClassOf(obo:CL_0020026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n\n# Class: obo:CL_0020027 (alpha retinal ganglion cell ON-transient (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020027 \"An alpha retinal ganglion cell subtype in the mouse retina that responds selectively and transiently to increases in light intensity. It possesses the large soma and expansive dendritic field characteristic of alpha RGCs (Krieger et al., 2017). This cell exhibits a brief, fast-decaying burst of firing at the onset of light increments and contributes to motion detection for luminance increases, forming the ON-branch of the transient magnocellular-like pathway (Krieger et al., 2017; Hahn et al., 2023). Functionally, it corresponds to cluster G19 and aligns transcriptomically with cluster C41 (Krieger et al., 2017; Tran et al., 2019). It is orthologous to the primate ON Parasol RGC (Hahn et al., 2023). Molecularly, it expresses Spp1, Smi32, and Brn3b, but lacks Brn3a, Brn3c, and Calbindin (Krieger et al., 2017).\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_0020027 obo:NCBITaxon_10090)\nAnnotationAssertion(terms:contributor obo:CL_0020027 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:creator obo:CL_0020027 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020027 \"2025-12-05T00:00:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020027 \"C41\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") oboInOwl:hasExactSynonym obo:CL_0020027 \"G19\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") oboInOwl:hasRelatedSynonym obo:CL_0020027 \"alpha retinal ganglion cell ON-t\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020027 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\nAnnotationAssertion(rdfs:label obo:CL_0020027 \"alpha retinal ganglion cell ON-transient (Mmus)\")\nSubClassOf(obo:CL_0020027 obo:CL_0004117)\nSubClassOf(obo:CL_0020027 obo:CL_4023032)\nSubClassOf(obo:CL_0020027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n\n# Class: obo:CL_0020028 (hybrid osteochondral skeletal cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30983567\") obo:IAO_0000115 obo:CL_0020028 \"A skeletal cell at the periosteal surface of the murine rib that displays hybrid osteochondral properties, emerging within the large callus that bridges segmental rib defects. It derives from a Sox9-expressing periosteal skeletal stem/progenitor subpopulation that constitutes only a small fraction of uninjured rib periosteum. After injury, these cells populate the callus and co-express cartilage and bone regulators Sox9 and Runx2, as well as matrix genes Col2a1 and Col1a1, while exhibiting dual chondrocyte/osteoblast properties.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_0020028 obo:NCBITaxon_10090)\nAnnotationAssertion(terms:contributor obo:CL_0020028 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020028 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020028 \"2025-12-16T14:37:04Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020028 \"hybrid osteochondral skeletal cell\")\nSubClassOf(obo:CL_0020028 obo:CL_0007001)\nSubClassOf(obo:CL_0020028 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002515))\nSubClassOf(obo:CL_0020028 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n\n# Class: obo:CL_0020029 (cuboidal epithelial cell)\n\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0020029 \"An epithelial cell that has a cuboidal morphology.\")\nAnnotationAssertion(terms:contributor obo:CL_0020029 <https://orcid.org/0009-0006-9765-6788>)\nAnnotationAssertion(terms:creator obo:CL_0020029 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020029 \"2025-12-16T15:56:39Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020029 \"cuboidal epithelial cell\")\nEquivalentClasses(obo:CL_0020029 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001872)))\nSubClassOf(obo:CL_0020029 obo:CL_0000075)\n\n# Class: obo:CL_0020030 (CD4-positive exhausted alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31207603\") Annotation(oboInOwl:hasDbXref \"PMID:31390978\") Annotation(oboInOwl:hasDbXref \"PMID:36907685\") Annotation(oboInOwl:hasDbXref \"PMID:38166256\") obo:IAO_0000115 obo:CL_0020030 \"A CD4-positive alpha-beta T cell that displays impaired function and altered differentiation as a result of chronic antigenic stimulation (e.g., chronic infection, tumors, or persistent inflammation). This state is characterised by sustained expression of PD-1 as a shared feature. Additional exhaustion-associated molecules, including the transcription factor TOX, and context- or stage-dependent changes in markers such as LAG-3, TIM-3, CD39, and T-bet, may also be observed; however, the expression levels of these molecules vary depending on exhaustion stage and tissue environment.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020030 <https://github.com/obophenotype/cell-ontology/issues/3453>)\nAnnotationAssertion(terms:contributor obo:CL_0020030 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020030 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020030 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020030 \"2026-01-13T15:30:05Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"CD4+ exhausted T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"exhausted CD4 T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"exhausted CD4-positive T cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020030 \"CD4-positive exhausted alpha-beta T cell\")\nEquivalentClasses(obo:CL_0020030 ObjectIntersectionOf(obo:CL_0000624 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001919)))\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0020030 obo:CL_0000624)\nSubClassOf(obo:CL_0020030 obo:CL_0011025)\n\n# Class: obo:CL_0020031 (CD8-positive exhausted alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31207603\") Annotation(oboInOwl:hasDbXref \"PMID:36907685\") Annotation(oboInOwl:hasDbXref \"PMID:38166256\") obo:IAO_0000115 obo:CL_0020031 \"A CD8-positive alpha-beta T cell that displays impaired function and altered differentiation as a result of chronic antigenic stimulation (e.g., chronic infection, tumours, or persistent inflammation). This state is characterised by sustained expression of PD-1 as a shared feature. Additional exhaustion-associated molecules, including expression of the transcription factor TOX and reduced T-bet, and context- or stage-dependent changes in markers such as LAG-3, TIM-3, CD39, and EOMES, may also be observed; however, the expression levels of these molecules vary depending on exhaustion stage and disease context.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020031 <https://github.com/obophenotype/cell-ontology/issues/3453>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020031 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020031 \"2026-01-13T15:30:05Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"CD8+ exhausted T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"exhausted CD8 T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"exhausted CD8-positive T cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020031 \"CD8-positive exhausted alpha-beta T cell\")\nEquivalentClasses(obo:CL_0020031 ObjectIntersectionOf(obo:CL_0000625 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001919)))\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0020031 obo:CL_0000625)\nSubClassOf(obo:CL_0020031 obo:CL_0011025)\n\n# Class: obo:CL_0020032 (oRGC2)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020032 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together ON parasol RGCs from primate foveal and peripheral retina with their molecularly homologous mouse α RGC subtype (ON-transient α RGC, C41) (Hahn et al., 2023; Tran et al., 2019).\")\nAnnotationAssertion(terms:contributor obo:CL_0020032 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(oboInOwl:id obo:CL_0020032 \"CL:9900000\")\nAnnotationAssertion(rdfs:label obo:CL_0020032 \"oRGC2\")\nSubClassOf(obo:CL_0020032 obo:CL_0000740)\n\n# Class: obo:CL_0020033 (stem cell memory CD4-positive, alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19525962\") Annotation(oboInOwl:hasDbXref \"PMID:21926977\") Annotation(oboInOwl:hasDbXref \"PMID:28060797\") obo:IAO_0000115 obo:CL_0020033 \"A CD4-positive memory alpha-beta T cell with stem-like properties that is long-lived, retains a naïve-like phenotype, and exhibits self-renewal and multipotent differentiation capacity. This cell acts as a stem-like reservoir capable of regenerating central and effector memory T cell subsets.\")\nAnnotationAssertion(terms:contributor obo:CL_0020033 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020033 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020033 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020033 \"2026-01-12T12:14:30Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21926977\") oboInOwl:hasExactSynonym obo: