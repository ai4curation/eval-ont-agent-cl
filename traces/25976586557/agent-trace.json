n AnnotationAssertion(rdfs:label obo:CL_4052108 \"IgD-negative class switched memory B cell\")\n EquivalentClasses(obo:CL_4052108 ObjectIntersectionOf(obo:CL_0000972 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738)))\n \n+# Class: obo:CL_9900001 (serous demilune cell of salivary gland)\n+\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23209333\") Annotation(oboInOwl:hasDbXref \"PMID:41686279\") obo:IAO_0000115 obo:CL_9900001 \"A serous secreting cell that is part of a saliva-secreting gland and is located at the distal end of a mucous acinus in a mixed salivary gland. This cell is associated with secretion of watery, enzyme-rich saliva through intercellular canaliculi between mucous cells; the crescent-shaped demilune morphology is a classic histological appearance that may be influenced by fixation artifact.\")\n+AnnotationAssertion(obo:IAO_0000233 obo:CL_9900001 <https://github.com/obophenotype/cell-ontology/issues/3597>)\n+AnnotationAssertion(terms:contributor obo:CL_9900001 <https://orcid.org/0000-0002-5507-2103>)\n+AnnotationAssertion(terms:creator obo:CL_9900001 \"GitHub Copilot\")\n+AnnotationAssertion(terms:date obo:CL_9900001 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23209333\") oboInOwl:hasExactSynonym obo:CL_9900001 \"serous demilune cell\")\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23209333\") oboInOwl:hasRelatedSynonym obo:CL_9900001 \"demilune cell of salivary gland\")\n+AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_9900001 \"Crescents of Giannuzzi\")\n+AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_9900001 \"serous crescent cell\")\n+AnnotationAssertion(rdfs:label obo:CL_9900001 \"serous demilune cell of salivary gland\")\n+EquivalentClasses(obo:CL_9900001 ObjectIntersectionOf(obo:CL_0000313 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001044)))\n+SubClassOf(obo:CL_9900001 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0046541))\n+\n+# Class: obo:CL_9900002 (basal duct cell of salivary gland)\n+\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37446355\") Annotation(oboInOwl:hasDbXref \"PMID:39346911\") obo:IAO_0000115 obo:CL_9900002 \"A basal cell that is part of a duct of a salivary gland. This cell is positioned around ductal epithelium, has an undifferentiated phenotype, expresses KRT5, and is associated with salivary gland stem or progenitor activity.\")\n+AnnotationAssertion(obo:IAO_0000233 obo:CL_9900002 <https://github.com/obophenotype/cell-ontology/issues/3597>)\n+AnnotationAssertion(terms:contributor obo:CL_9900002 <https://orcid.org/0000-0002-5507-2103>)\n+AnnotationAssertion(terms:creator obo:CL_9900002 \"GitHub Copilot\")\n+AnnotationAssertion(terms:date obo:CL_9900002 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37446355\") oboInOwl:hasExactSynonym obo:CL_9900002 \"basal ductal cell of salivary gland\")\n+AnnotationAssertion(rdfs:label obo:CL_9900002 \"basal duct cell of salivary gland\")\n+EquivalentClasses(obo:CL_9900002 ObjectIntersectionOf(obo:CL_0000646 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001837)))\n+\n+# Class: obo:CL_9900003 (periductal fibroblast of salivary gland)\n+\n+AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31213547\") Annotation(oboInOwl:hasDbXref \"PMID:39346911\") Annotation(oboInOwl:hasDbXref \"PMID:41411773\") obo:IAO_0000115 obo:CL_9900003 \"A fibroblast that is part of the stroma of a saliva-secreting gland and is positioned in periductal connective tissue surrounding the ductal system. This cell contributes to the extracellular matrix framework around salivary gland ducts and can participate in immunomodulatory signaling.\")\n+AnnotationAssertion(obo:IAO_0000233 obo:CL_9900003 <https://github.com/obophenotype/cell-ontology/issues/3597>)\n+AnnotationAssertion(terms:contributor obo:CL_9900003 <https://orcid.org/0000-0002-5507-2103>)\n+AnnotationAssertion(terms:creator obo:CL_9900003 \"Git