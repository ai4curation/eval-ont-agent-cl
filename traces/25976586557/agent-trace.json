(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070017 \"A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.\")\n35351: AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6712)\n35352: AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6752)\n35353: AnnotationAssertion(terms:contributor obo:CL_4070017 <https://orcid.org/0000-0002-1909-7004>)\n35354: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\n35355: AnnotationAssertion(rdfs:label obo:CL_4070017 \"lateral pyloric motor neuron\")\n35356: SubClassOf(obo:CL_4070017 obo:CL_0000100)\n35357: SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35358: SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35359: \n35360: # Class: obo:CL_4072001 (newly formed oligodendrocyte)\n35361: \n35362: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\n35363: AnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\n35364: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\n35365: AnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\n35366: SubClassOf(obo:CL_4072001 obo:CL_0000123)\n35367: SubClassOf(obo:CL_4072001 obo:CL_0000128)\n35368: SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n35369: SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\n35370: \n35371: # Class: obo:CL_4072002 (myelin-forming oligodendrocyte)\n35372: \n35373: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n35374: AnnotationAssertion(terms:contributor obo:CL_4072002 <https://orcid.org/0000-0002-5507-2103>)\n35375: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\n35376: AnnotationAssertion(rdfs:label obo:CL_4072002 \"myelin-forming oligodendrocyte\"@en)\n35377: SubClassOf(obo:CL_4072002 obo:CL_0000128)\n35378: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n35379: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n35380: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n35381: \n35382: # Class: obo:CL_4072003 (mature myelinating oligodendrocyte)\n35383: \n35384: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\n35385: AnnotationAssertion(terms:contributor obo:CL_4072003 <https://orcid.org/0000-0002-5507-2103>)\n35386: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\n35387: AnnotationAssertion(rdfs:label obo:CL_4072003 \"mature myelinating oligodendrocyte\")\n35388: SubClassOf(obo:CL_4072003 obo:CL_0000128)\n35389: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n35390: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072002))\n35391: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n35392: \n35393: # Class: obo:CL_4072005 (A8 dopaminergic neuron)\n35394: \n35395: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\n35396: AnnotationAssertion(terms:date obo:CL_4072005 \"2025-05-02T08:37:36Z\"^^xsd:dateTime)\n35397: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\n35398: AnnotationAssertion(rdfs:label obo:CL_4072005 \"A8 dopaminergic neuron\")\n35399: SubClassOf(obo:CL_4072005 obo:CL_2000097)\n35400: SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n35401: SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n35402: \n35403: # Class: obo:CL_4072006 (A9 dopaminergic neuron)\n35404: \n35405: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\n35406: AnnotationAssertion(terms:date obo:CL_4072006 \"2025-05-02T09:59:34Z\"^^xsd:dateTime)\n35407: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\n35408: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\n35409: AnnotationAssertion(rdfs:label obo:CL_4072006 \"A9 dopaminergic neuron\")\n35410: SubClassOf(obo:CL_4072006 obo:CL_4042025)\n35411: SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))\n35412: SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n35413: SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35414: SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535))\n35415: \n35416: # Class: obo:CL_407200