{"type":"tool_use","timestamp":1778976831020,"sessionID":"ses_1ccb88036ffeTs2Cu18GOUFw8e","part":{"type":"tool","tool":"read","callID":"call_UDgK45u98ODR4wCQL0OvUCYi","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":35000,"limit":260},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n35000: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\n35001: AnnotationAssertion(terms:contributor obo:CL_4052041 <https://orcid.org/0009-0000-8480-9277>)\n35002: AnnotationAssertion(terms:date obo:CL_4052041 \"2025-02-12T12:00:10Z\"^^xsd:dateTime)\n35003: AnnotationAssertion(rdfs:label obo:CL_4052041 \"tuft cell of auditory tube\")\n35004: EquivalentClasses(obo:CL_4052041 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010062)))\n35005: SubClassOf(obo:CL_4052041 obo:CL_0002491)\n35006: \n35007: # Class: obo:CL_4052042 (tuft cell of urethra)\n35008: \n35009: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\n35010: AnnotationAssertion(terms:contributor obo:CL_4052042 <https://orcid.org/0009-0000-8480-9277>)\n35011: AnnotationAssertion(terms:date obo:CL_4052042 \"2025-02-12T14:39:03Z\"^^xsd:dateTime)\n35012: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral brush cell\")\n35013: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral cholinergic chemosensory cell\")\n35014: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\n35015: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\n35016: AnnotationAssertion(rdfs:label obo:CL_4052042 \"tuft cell of urethra\")\n35017: EquivalentClasses(obo:CL_4052042 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002325)))\n35018: SubClassOf(obo:CL_4052042 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0060083))\n35019: \n35020: # Class: obo:CL_4052045 (steroidogenic stromal cell of ovary)\n35021: \n35022: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\n35023: AnnotationAssertion(terms:contributor obo:CL_4052045 <https://orcid.org/0009-0000-8480-9277>)\n35024: AnnotationAssertion(terms:date obo:CL_4052045 \"2025-03-05T13:37:44Z\"^^xsd:dateTime)\n35025: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic interstitial stromal cell\")\n35026: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic stromal cell\")\n35027: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasRelatedSynonym obo:CL_4052045 \"Enpp2− interstitial cell\")\n35028: AnnotationAssertion(rdfs:label obo:CL_4052045 \"steroidogenic stromal cell of ovary\")\n35029: EquivalentClasses(obo:CL_4052045 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006960) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0120178)))\n35030: \n35031: # Class: obo:CL_4052046 (early luteal cell)\n35032: \n35033: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052046 \"A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.\")\n35034: AnnotationAssertion(terms:contributor obo:CL_4052046 <https://orcid.org/0009-0000-8480-9277>)\n35035: AnnotationAssertion(terms:date obo:CL_4052046 \"2025-03-05T16:40:18Z\"^^xsd:dateTime)\n35036: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052046 \"active corpus luteum cell\")\n35037: AnnotationAssertion(rdfs:label obo:CL_4052046 \"early luteal cell\")\n35038: SubClassOf(obo:CL_4052046 obo:CL_0000175)\n35039: SubClassOf(obo:CL_4052046 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006701))\n35040: \n35041: # Class: obo:CL_4052047 (late luteal cell)\n35042: \n35043: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31803139\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052047 \"A luteal cell that is part of the older, regressing corpus luteum. This cell exhibits increased expression of genes involved in progesterone metabolism - Akr1c18 in mice (Lan et al., 2024), cell cycle arrest, and apoptosis. A late luteal cell contributes to corpus luteum regression and eventual clearance from the ovary through luteolysis.\")\n35044: AnnotationAssertion(terms:contributor obo:CL_4052047 <https://orcid.org/0009-0000-8480-9277>)\n35045: AnnotationAssertion(terms:date obo:CL_4052047 \"2025-03-05T16:47:20Z\"^^xsd:dateTime)\n35046: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052047 \"regressing corpus luteum cell\")\n35047: AnnotationAssertion(rdfs:label obo:CL_4052047 \"late luteal cell\")\n35048: SubClassOf(obo:CL_4052047 obo:CL_0000175)\n35049: SubClassOf(obo:CL_4052047 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006709))\n35050: \n35051: # Class: obo:CL_4052048 (intercalated cell of salivary gland)\n35052: \n35053: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n35054: AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0000-0003-4389-9821>)\n35055: AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0009-0000-8480-9277>)\n35056: AnnotationAssertion(terms:date obo:CL_4052048 \"2024-09-11T09:55:55Z\"^^xsd:dateTime)\n35057: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasBroadSynonym obo:CL_4052048 \"intercalated duct cell\")\n35058: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\n35059: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35799078\") oboInOwl:hasRelatedSynonym obo:CL_4052048 \"Id cell\")\n35060: AnnotationAssertion(rdfs:label obo:CL_4052048 \"intercalated cell of salivary gland\")\n35061: SubClassOf(obo:CL_4052048 obo:CL_1001596)\n35062: SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014727))\n35063: SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n35064: \n35065: # Class: obo:CL_4052049 (striated cell of salivary gland)\n35066: \n35067: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n35068: AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0000-0003-4389-9821>)\n35069: AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0009-0000-8480-9277>)\n35070: AnnotationAssertion(terms:date obo:CL_4052049 \"2024-09-11T10:00:25Z\"^^xsd:dateTime)\n35071: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"SD cells\")\n35072: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\n35073: AnnotationAssertion(rdfs:label obo:CL_4052049 \"striated cell of salivary gland\")\n35074: EquivalentClasses(obo:CL_4052049 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014729)))\n35075: SubClassOf(obo:CL_4052049 obo:CL_1001596)\n35076: SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n35077: SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0036376))\n35078: SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990573))\n35079: \n35080: # Class: obo:CL_4052050 (luminal epithelial cell of endometrium)\n35081: \n35082: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36273006\") obo:IAO_0000115 obo:CL_4052050 \"An epithelial cell that is part of an endometrium luminal epithelium.\")\n35083: AnnotationAssertion(terms:contributor obo:CL_4052050 <https://orcid.org/0009-0000-8480-9277>)\n35084: AnnotationAssertion(terms:date obo:CL_4052050 \"2025-03-13T13:46:13Z\"^^xsd:dateTime)\n35085: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31317179\") oboInOwl:hasExactSynonym obo:CL_4052050 \"endometrial luminal epithelial cell\")\n35086: AnnotationAssertion(rdfs:label obo:CL_4052050 \"luminal epithelial cell of endometrium\")\n35087: EquivalentClasses(obo:CL_4052050 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949)))\n35088: \n35089: # Class: obo:CL_4052051 (uterine natural killer cell 1, human)\n35090: \n35091: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34512661\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052051 \"​​A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018). It expresses the uterine resident marker CD49a and is distinguished from uNK2 and uNK3 by CD39 expression and the absence of CD103 (Whettlock et al., 2022) and CD160 (Marečková et al., 2024). It also expresses higher levels of killer-cell immunoglobulin-like receptors (KIRs) and leukocyte immunoglobulin-like receptor B1 (LILRB1), which facilitate interaction with human leukocyte antigens (HLAs) on extravillous trophoblast cells, promoting immune tolerance and implantation. Enriched in the endometrium post-ovulation (Marečková et al., 2024) and prominent in early pregnancy (Whettlock et al., 2022), uNK1 regulates trophoblast invasion and spiral artery remodeling (Zhang & Wei, 2021).\")\n35092: AnnotationAssertion(terms:contributor obo:CL_4052051 <https://orcid.org/0009-0000-8480-9277>)\n35093: AnnotationAssertion(terms:date obo:CL_4052051 \"2025-03-14T10:48:38Z\"^^xsd:dateTime)\n35094: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052051 \"decidual natural killer cell 1\")\n35095: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052051 \"uNK1\")\n35096: AnnotationAssertion(rdfs:label obo:CL_4052051 \"uterine natural killer cell 1, human\")\n35097: EquivalentClasses(obo:CL_4052051 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35098: \n35099: # Class: obo:CL_4052052 (uterine natural killer cell 2, human)\n35100: \n35101: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\n35102: AnnotationAssertion(terms:contributor obo:CL_4052052 <https://orcid.org/0009-0000-8480-9277>)\n35103: AnnotationAssertion(terms:date obo:CL_4052052 \"2025-03-14T14:31:03Z\"^^xsd:dateTime)\n35104: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\n35105: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\n35106: AnnotationAssertion(rdfs:label obo:CL_4052052 \"uterine natural killer cell 2, human\")\n35107: EquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35108: \n35109: # Class: obo:CL_4052053 (uterine natural killer cell 3, human)\n35110: \n35111: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\n35112: AnnotationAssertion(terms:contributor obo:CL_4052053 <https://orcid.org/0009-0000-8480-9277>)\n35113: AnnotationAssertion(terms:date obo:CL_4052053 \"2025-03-14T16:15:39Z\"^^xsd:dateTime)\n35114: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\n35115: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\n35116: AnnotationAssertion(rdfs:label obo:CL_4052053 \"uterine natural killer cell 3, human\")\n35117: EquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35118: \n35119: # Class: obo:CL_4052055 (mature NK T cell, human)\n35120: \n35121: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\n35122: AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0000-0001-5742-4697>)\n35123: AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0009-0000-8480-9277>)\n35124: AnnotationAssertion(terms:date obo:CL_4052055 \"2025-03-26T11:56:38Z\"^^xsd:dateTime)\n35125: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\n35126: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\n35127: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\n35128: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NKT cell, human\")\n35129: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T cell, human\")\n35130: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T lymphocyte, human\")\n35131: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T-lymphocyte, human\")\n35132: AnnotationAssertion(rdfs:label obo:CL_4052055 \"mature NK T cell, human\")\n35133: EquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35134: \n35135: # Class: obo:CL_4052058 (Merkel cell of epidermis)\n35136: \n35137: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_4052058 \"A Merkel cell found mainly in the basal layer of the epidermis and the outer root sheath of hair follicles, particularly concentrated in areas with high tactile acuity, such as touch domes, hair follicles, and fingertips.\")\n35138: AnnotationAssertion(terms:contributor obo:CL_4052058 <https://orcid.org/0009-0000-8480-9277>)\n35139: AnnotationAssertion(terms:date obo:CL_4052058 \"2025-06-11T10:01:40Z\"^^xsd:dateTime)\n35140: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6207057\") oboInOwl:hasExactSynonym obo:CL_4052058 \"epdiermal Merkel cell\")\n35141: AnnotationAssertion(rdfs:label obo:CL_4052058 \"Merkel cell of epidermis\")\n35142: EquivalentClasses(obo:CL_4052058 ObjectIntersectionOf(obo:CL_0000242 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n35143: \n35144: # Class: obo:CL_4052060 (spinous cell)\n35145: \n35146: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34283481\") Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") obo:IAO_0000115 obo:CL_4052060 \"A differentiating keratinocyte found in the epidermis and oral epithelium, located in the stratum spinosum, characterized by a spiny appearance due to abundant intercellular desmosomal junctions.\")\n35147: AnnotationAssertion(terms:contributor obo:CL_4052060 <https://orcid.org/0009-0000-8480-9277>)\n35148: AnnotationAssertion(terms:date obo:CL_4052060 \"2025-07-02T12:21:06Z\"^^xsd:dateTime)\n35149: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_4052060 \"prickle cell\")\n35150: AnnotationAssertion(rdfs:label obo:CL_4052060 \"spinous cell\")\n35151: SubClassOf(obo:CL_4052060 obo:CL_0000312)\n35152: SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030057))\n35153: SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001365))\n35154: \n35155: # Class: obo:CL_4052061 (epidermal keratinocyte)\n35156: \n35157: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\n35158: AnnotationAssertion(terms:contributor obo:CL_4052061 <https://orcid.org/0009-0000-8480-9277>)\n35159: AnnotationAssertion(terms:date obo:CL_4052061 \"2025-07-02T12:32:13Z\"^^xsd:dateTime)\n35160: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052061 \"keratincyte of epidermis\")\n35161: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39185948\") oboInOwl:hasExactSynonym obo:CL_4052061 \"skin keratinocyte\")\n35162: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") rdfs:comment obo:CL_4052061 \"Keratinocytes are reportedly CDw210a(IL-10RA)-negative , CDw210b(IL-10RB)-positive, IL22Ra1-positive, Human keratinocytes are reportedly capable of secreting BD-2, BD-3, hCAP-18, CXCL1, CXCL5, CXCL8, elafin, MMP-3, NGAL, PDGF-A, S100A7, S100A8, and S100A9. Transcription factors: STAT3-positive.\")\n35163: AnnotationAssertion(rdfs:label obo:CL_4052061 \"epidermal keratinocyte\")\n35164: EquivalentClasses(obo:CL_4052061 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n35165: SubClassOf(obo:CL_4052061 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0090023))\n35166: \n35167: # Class: obo:CL_4052062 (onychofibroblast)\n35168: \n35169: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\n35170: AnnotationAssertion(terms:contributor obo:CL_4052062 <https://orcid.org/0009-0000-8480-9277>)\n35171: AnnotationAssertion(terms:date obo:CL_4052062 \"2025-07-22T14:35:00Z\"^^xsd:dateTime)\n35172: AnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n35173: SubClassOf(obo:CL_4052062 obo:CL_0000057)\n35174: SubClassOf(obo:CL_4052062 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001705))\n35175: \n35176: # Class: obo:CL_4052063 (nail bed keratinocyte)\n35177: \n35178: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10651700\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:33799809\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052063 \"A keratinocyte that resides in the nail bed, responsible for tightly attaching the nail plate to the underlying dermis. Unlike typical epidermal keratinocytes, it exhibits limited proliferation, undergoes modified differentiation that skips the granular layer and conventional cornification, and primarily ensures adhesion and maintenance of the nail plate. In humans, this cell expresses characteristic markers, including the protease inhibitor SPINK6 and the differentiation-associated protein KRT16.\")\n35179: AnnotationAssertion(terms:contributor obo:CL_4052063 <https://orcid.org/0009-0000-8480-9277>)\n35180: AnnotationAssertion(terms:date obo:CL_4052063 \"2024-07-22T15:30:00Z\"^^xsd:dateTime)\n35181: AnnotationAssertion(rdfs:label obo:CL_4052063 \"nail bed keratinocyte\")\n35182: SubClassOf(obo:CL_4052063 obo:CL_0000312)\n35183: SubClassOf(obo:CL_4052063 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005273))\n35184: \n35185: # Class: obo:CL_4052064 (nail matrix keratinocyte)\n35186: \n35187: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\n35188: AnnotationAssertion(terms:contributor obo:CL_4052064 <https://orcid.org/0009-0000-8480-9277>)\n35189: AnnotationAssertion(terms:date obo:CL_4052064 \"2025-07-22T15:30:00Z\"^^xsd:dateTime)\n35190: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39044464\") oboInOwl:hasExactSynonym obo:CL_4052064 \"nail matrix epithelial keratinocyte\")\n35191: AnnotationAssertion(rdfs:label obo:CL_4052064 \"nail matrix keratinocyte\")\n35192: EquivalentClasses(obo:CL_4052064 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002283)))\n35193: \n35194: # Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n35195: \n35196: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n35197: AnnotationAssertion(terms:contributor obo:CL_4052065 <https://orcid.org/0009-0000-8480-9277>)\n35198: AnnotationAssertion(terms:date obo:CL_4052065 \"2025-08-05T15:24:46Z\"^^xsd:dateTime)\n35199: AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n35200: EquivalentClasses(obo:CL_4052065 ObjectIntersectionOf(obo:CL_0000313 obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013232)))\n35201: SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0042588))\n35202: SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0005983))\n35203: \n35204: # Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n35205: \n35206: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n35207: AnnotationAssertion(terms:contributor obo:CL_4052066 <https://orcid.org/0009-0000-8480-9277>)\n35208: AnnotationAssertion(terms:date obo:CL_4052066 \"2025-08-05T15:33:46Z\"^^xsd:dateTime)\n35209: AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n35210: EquivalentClasses(obo:CL_4052066 ObjectIntersectionOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014717)))\n35211: SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0098594))\n35212: SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070254))\n35213: \n35214: # Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n35215: \n35216: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n35217: AnnotationAssertion(terms:contributor obo:CL_4052067 <https://orcid.org/0009-0000-8480-9277>)\n35218: AnnotationAssertion(terms:date obo:CL_4052067 \"2025-08-06T11:26:37Z\"^^xsd:dateTime)\n35219: AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n35220: SubClassOf(obo:CL_4052067 obo:CL_0000159)\n35221: SubClassOf(obo:CL_4052067 obo:CL_0002623)\n35222: \n35223: # Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n35224: \n35225: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n35226: AnnotationAssertion(terms:contributor obo:CL_4052069 <https://orcid.org/0009-0000-8480-9277>)\n35227: AnnotationAssertion(terms:date obo:CL_4052069 \"2025-08-08T11:20:00Z\"^^xsd:dateTime)\n35228: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n35229: AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n35230: SubClassOf(obo:CL_4052069 obo:CL_1001596)\n35231: SubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n35232: \n35233: # Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n35234: \n35235: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n35236: AnnotationAssertion(terms:contributor obo:CL_4052070 <https://orcid.org/0009-0000-8480-9277>)\n35237: AnnotationAssertion(terms:date obo:CL_4052070 \"2025-08-12T16:05:47Z\"^^xsd:dateTime)\n35238: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_4052070 \"unclassified fallopian tube progenitor\")\n35239: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\n35240: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\n35241: AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n35242: SubClassOf(obo:CL_4052070 obo:CL_0011026)\n35243: SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600124))\n35244: SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35245: \n35246: # Class: obo:CL_4052071 (quiescent fibroblast)\n35247: \n35248: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\n35249: AnnotationAssertion(terms:contributor obo:CL_4052071 <https://orcid.org/0009-0000-8480-9277>)\n35250: AnnotationAssertion(terms:date obo:CL_4052071 \"2025-08-13T15:42:37Z\"^^xsd:dateTime)\n35251: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\n35252: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\n35253: AnnotationAssertion(rdfs:label obo:CL_4052071 \"quiescent fibroblast\")\n35254: SubClassOf(obo:CL_4052071 obo:CL_0000057)\n35255: \n35256: # Class: obo:CL_4052108 (IgD-negative class switched memory B cell)\n35257: \n35258: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20839340\") Annotation(oboInOwl:hasDbXref \"PMID:32741082\") Annotation(oboInOwl:hasDbXref \"PMID:36617261\") Annotation(oboInOwl:hasDbXref \"PMID:37254600\") obo:IAO_0000115 obo:CL_4052108 \"A class switched memory B cell that lacks IgD on the cell surface.\")\n35259: AnnotationAssertion(terms:contributor obo:CL_4052108 <https://orcid.org/0009-0000-8480-9277>)\n\n(Showing lines 35000-35259 of 36011. Use offset=35260 to continue.)\n</content>","metadata":{"preview":"AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\nAnnotationAssertion(terms:contributor obo:CL_4052041 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052041 \"2025-02-12T12:00:10Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4052041 \"tuft cell of auditory tube\")\nEquivalentClasses(obo:CL_4052041 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010062)))\nSubClassOf(obo:CL_4052041 obo:CL_0002491)\n\n# Class: obo:CL_4052042 (tuft cell of urethra)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\nAnnotationAssertion(terms:contributor obo:CL_4052042 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052042 \"2025-02-12T14:39:03Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral brush cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral cholinergic chemosensory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\nAnnotationAssertion(rdfs:label obo:CL_4052042 \"tuft cell of urethra\")\nEquivalentClasses(obo:CL_4052042 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002325)))\nSubClassOf(obo:CL_4052042 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0060083))\n","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778976830883,"end":1778976831017}},"id":"prt_e3348359f001SP08sj2lbzqyuS","sessionID":"ses_1ccb88036ffeTs2Cu18GOUFw8e","messageID":"msg_e33481bc0001rBvsjDXDjYprU1"}}
