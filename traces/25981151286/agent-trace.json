{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '32790,32875p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(terms:contributor obo:CL_4033064 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033064 \"2024-01-08T16:05:09Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") oboInOwl:hasBroadSynonym obo:CL_4033064 \"uterine macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") rdfs:comment obo:CL_4033064 \"Uterine macrophages are reported to be evenly distributed throughout the endometrial stroma but with aggregations observed close to the lumen of superficial secretory glands.\")\nAnnotationAssertion(rdfs:label obo:CL_4033064 \"uterine resident macrophage\")\nEquivalentClasses(obo:CL_4033064 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n\n# Class: obo:CL_4033065 (preplasmablast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasDbXref \"PMID:30755708\") Annotation(oboInOwl:hasDbXref \"PMID:33150420\") obo:IAO_0000115 obo:CL_4033065 \"A mature B cell that serves as an intermediate stage in the differentiation of naive B cells into a plasmablast. A preplasmablast expresses CD30 and IL-6R and lacks expression of CD20, CD23, CD38 and CD138.\")\nAnnotationAssertion(terms:contributor obo:CL_4033065 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033065 <https://orcid.org/0000-0001-7655-4833>)\nAnnotationAssertion(terms:date obo:CL_4033065 \"2024-04-25T09:14:58Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23613519\") oboInOwl:hasExactSynonym obo:CL_4033065 \"pre-plasmablast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33661294\") oboInOwl:hasExactSynonym obo:CL_4033065 \"preplasmablastic cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033065 \"prePB\")\nAnnotationAssertion(rdfs:label obo:CL_4033065 \"preplasmablast\")\nSubClassOf(obo:CL_4033065 obo:CL_0000785)\nSubClassOf(obo:CL_4033065 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000788))\nSubClassOf(obo:CL_4033065 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000980))\n\n# Class: obo:CL_4033066 (pre-granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:38178246\") obo:IAO_0000115 obo:CL_4033066 \"A supporting cell that is part of the ovary and differentiates into a granulosa cell. A pre-granulosa cell develops from an early supporting gonadal cell by repressing testis determination, which can then proliferate to form primordial follicles.\")\nAnnotationAssertion(terms:contributor obo:CL_4033066 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033066 <https://orcid.org/0000-0001-7655-4833>)\nAnnotationAssertion(terms:date obo:CL_4033066 \"2024-06-07T12:04:57Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"ovarian pregranulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"pregranulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033066 \"PG cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033066 \"pre-granulosa cell\")\nSubClassOf(obo:CL_4033066 obo:CL_0000630)\nSubClassOf(obo:CL_4033066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\nSubClassOf(obo:CL_4033066 ObjectSomeValuesFrom(obo:RO_0002210 obo:CL_4033083))\n\n# Class: obo:CL_4033067 (mural granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27815559\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:34198768\") obo:IAO_0000115 obo:CL_4033067 \"A follicular cell of ovary that differentiates from a cuboidal granulosa cell during the secondary follicle stage. Mural granulosa cells line the inner surface of the follicle wall, surrounding the fluid-filled antral cavity. These cells produce oestrogen during the follicular phase in response to follicle-stimulating hormone (FSH), and progesterone after ovulation in response to luteinizing hormone (LH).\")\nAnnotationAssertion(terms:contributor obo:CL_4033067 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033067 <https://orcid.org/0000-0001-7655-4833>)\nAnnotationAssertion(terms:date obo:CL_4033067 \"2024-06-07T12:15:13Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4033067 \"EFO:0005289\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1530/REP-16-0500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"MGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34198768\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"mural GC\")\nAnnotationAssertion(rdfs:label obo:CL_4033067 \"mural granulosa cell\")\nSubClassOf(obo:CL_4033067 obo:CL_0000501)\nSubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\nSubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4033084))\n\n# Class: obo:CL_4033083 (squamous granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033083 \"A granulosa cell that has a squamous morphology and form a single layer around the oocyte in primordial follicles. This cell develops directly into a cuboidal granulosa cell during the primordial-to-primary follicle transition.\")\nAnnotationAssertion(terms:contributor obo:CL_4033083 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033083 \"2024-09-24T13:13:24Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22402964\") oboInOwl:hasExactSynonym obo:CL_4033083 \"flattened granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") oboInOwl:hasRelatedSynonym obo:CL_4033083 \"pre-granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033083 \"squamous GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") rdfs:comment obo:CL_4033083 \"Often in literature squamous granulosa cell and pre-granulosa cell are used as synonyms. However, this term only makes reference to the quiescent granulosa cells that surround the primordial ovarian follicle, while a pre-granulosa cell proliferates to form the primordial follicle (and thus cells become the squamous granulosa cells).\")\nAnnotationAssertion(rdfs:label obo:CL_4033083 \"squamous granulosa cell\")\nSubClassOf(obo:CL_4033083 obo:CL_0000501)\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003981))\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033066))\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002210 obo:CL_4033084))\n\n# Class: obo:CL_4033084 (cuboidal granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033084 \"A granulosa cell that has a cuboidal morphology and develops from squamous granulosa cell during the transition between primordial follicle to primary follicle. Cuboidal granulosa cells proliferate to form a second layer within secondary follicles.\")\nAnnotationAssertion(terms:contributor obo:CL_4033084 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033084 \"2024-09-24T13:14:57Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") oboInOwl:hasExactSynonym obo:CL_4033084 \"columnar granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31849844\") oboInOwl:hasExactSynonym obo:CL_4033084 \"cuboidal epithelial granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"columnar GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"cuboidal GC\")\nAnnotationAssertion(rdfs:label obo:CL_4033084 \"cuboidal granulosa cell\")\nSubClassOf(obo:CL_4033084 obo:CL_0000501)\nSubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001305))\nSubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033083))\n\n# Class: obo:CL_4033085 (diffuse bipolar 5 cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033085 \"An ON diffuse bipolar cell that stratifies in the stratum 3 of the inner plexiform layer to make synapses with ON parasol ganglion cells. A diffuse bipolar 5 cell has high expression of MYO16 compared with other bipolar cells.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4033085 obo:NCBITaxon_9443)\nAnnotationAssertion(terms:contributor obo:CL_4033085 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033085 \"2024-10-16T12:46:53Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033085 \"DB5 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") rdfs:comment obo:CL_4033085 \"A diffuse bipolar 5 cell typically contacts 7–8 cone photoreceptors. The number and thickness of its dendritic processes are intermediate between those of a diffuse bipolar 6 cell (less dense and thinner) and a diffuse bipolar 4 cell (denser and thicker).\")\n","exit_code":0,"status":"completed"}}
