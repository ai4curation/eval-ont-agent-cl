ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012399)))\nSubClassOf(obo:CL_4033012 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001278))\n\n# Class: obo:CL_4033013 (suprabasal keratinocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22375063\") Annotation(oboInOwl:hasDbXref \"PMID:35883599\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/squamous+epithelial+cells#suprabasalkeratinocytes\") obo:IAO_0000115 obo:CL_4033013 \"A keratinocyte that resides in the epidermal suprabasal layer and expresses differentiation markers, including keratin 1 and keratin 10, in both humans and mice. In human interfollicular epidermis, this cell retains proliferative capacity and possesses retrodifferentiation potential, acquiring basal-like properties during wound healing or basement membrane contact.\")\nAnnotationAssertion(terms:contributor obo:CL_4033013 <http://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4033013 \"2023-02-02T11:17:04Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4033013 \"suprabasal keratinocyte\")\nEquivalentClasses(obo:CL_4033013 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010402)))\nSubClassOf(obo:CL_4033013 obo:CL_7770004)\n\n# Class: obo:CL_4033014 (peg cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2210508\") Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasDbXref \"PMID:30023181\") obo:IAO_0000115 obo:CL_4033014 \"A small, narrow, peg-shaped epithelial cell with little cytoplasm that is part of oviduct epithelium. This cell is rarer than the ciliated and secretory epithelial cells of the fallopian tube epithelium and is often found intercalated between them. Peg cells are generally distributed basally along the epithelium and have been found in high concentrations at the fimbriated, distal end of the fallopian tube in humans. It may have a regenerative/stem-cell function. In humans, markers include EPCAM, CD44, and ITGA6.\")\nAnnotationAssertion(terms:contributor obo:CL_4033014 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033014 \"2023-02-02T15:07:12Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"FTE stem-like cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4033014 \"FTESC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"fallopian tube epithelial stem-like cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"intercalary cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") rdfs:comment obo:CL_4033014 \"In vitro evidence supports a stem-cell/regenerative function for these cells\")\nAnnotationAssertion(rdfs:label obo:CL_4033014 \"peg cell\")\nSubClassOf(obo:CL_4033014 obo:CL_4052019)\nSubClassOf(obo:CL_4033014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004804))\n\n# Class: obo:CL_4033015 (retinal astrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25236977\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") obo:IAO_0000115 obo:CL_4033015 \"A star-shaped glial cell that is part of some retina. This cell links neurons to blood vessels and may provide structural and physiological support to optic nerve head axons.\")\nAnnotationAssertion(terms:contributor obo:CL_4033015 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033015 \"2023-03-02T14:38:32Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33796062\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033015 \"retinal astroglia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32555229\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") rdfs:comment obo:CL_4033015 \"In response to elevated intraocular pressure, a retinal astrocyte may modulate extracellular matrix remodeling. In the human retina, a retinal astrocyte is GFAP-positive, SOD3-positive and GYPC-positive.\")\nAnnotationAssertion(rdfs:label obo:CL_4033015 \"retinal astrocyte\")\nEquivalentClasses(obo:CL_4033015 ObjectIntersectionOf(obo:CL_0000127 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000966)))\n\n# Class: obo:CL_4033016 (secondary crest myofibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\nAnnotationAssertion(terms:contributor obo:CL_4033016 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033016 <https://orcid.org/0000-0002-9185-3994>)\nAnnotationAssertion(terms:date obo:CL_4033016 \"2023-03-16T09:17:47Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasExactSynonym obo:CL_4033016 \"secondary-crest myofibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033016 \"SCMF\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25448080\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033016 \"SCMFs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasRelatedSynonym obo:CL_4033016 \"alveolar myofibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4033016 \"secondary crest myofibroblast\")\nSubClassOf(obo:CL_4033016 obo:CL_0000186)\nSubClassOf(obo:CL_4033016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000114))\nSubClassOf(obo:CL_4033016 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0048286))\n\n# Class: obo:CL_4033017 (bronchiolar smooth muscle cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:9781260462982\") Annotation(oboInOwl:hasDbXref \"PMID:15347627\") obo:IAO_0000115 obo:CL_4033017 \"A smooth muscle cell that is part of a bronchiole.\")\nAnnotationAssertion(terms:contributor obo:CL_4033017 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033017 <https://orcid.org/0000-0002-9185-3994>)\nAnnotationAssertion(terms:date obo:CL_4033017 \"2023-03-16T09:38:17Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4033017 \"bronchiolar smooth muscle cell\")\nEquivalentClasses(obo:CL_4033017 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002186)))\nSubClassOf(obo:CL_4033017 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004515))\n\n# Class: obo:CL_4033018 (lung megakaryocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33351116\") obo:IAO_0000115 obo:CL_4033018 \"A megakaryocyte that is resident in the lung connective tissue.\")\nAnnotationAssertion(terms:contributor obo:CL_4033018 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:contributor obo:CL_4033018 <https://orcid.org/0000-0002-9185-3994>)\nAnnotationAssertion(terms:date obo:CL_4033018 \"2023-03-16T11:31:23Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36524131\") oboInOwl:hasExactSynonym 