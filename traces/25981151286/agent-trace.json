ganglion cell)\n21386:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16626866\") obo:IAO_0000115 obo:CL_0003032 \"A monostratified retinal ganglion cell that has post synaptic terminals in sublaminar layer S2 and is depolarized by decreased illumination of their receptive field center\")\n21391:AnnotationAssertion(rdfs:label obo:CL_0003032 \"M3-OFF retinal ganglion cell\")\n21396:# Class: obo:CL_0003033 (M4 retinal ganglion cell)\n21398:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16626866\") obo:IAO_0000115 obo:CL_0003033 \"A monostratified retinal ganglion cell that has a large soma, a medium dendritic field with post synaptic terminals in sublaminar layer S3.\")\n21403:AnnotationAssertion(rdfs:label obo:CL_0003033 \"M4 retinal ganglion cell\")\n21409:# Class: obo:CL_0003034 (M5 retinal ganglion cell)\n21411:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16626866\") obo:IAO_0000115 obo:CL_0003034 \"A monostratified retinal ganglion cell that has a small soma, an assymetric dendritic field with post synaptic terminals in sublaminar layer S3.\")\n21416:AnnotationAssertion(rdfs:label obo:CL_0003034 \"M5 retinal ganglion cell\")\n21422:# Class: obo:CL_0003035 (M6 retinal ganglion cell)\n21424:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16626866\") obo:IAO_0000115 obo:CL_0003035 \"A monostratified retinal ganglion cell that contains opsin.\")\n21429:AnnotationAssertion(rdfs:label obo:CL_0003035 \"M6 retinal ganglion cell\")\n21435:# Class: obo:CL_0003036 (M7 retinal ganglion cell)\n21437:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16626866\") obo:IAO_0000115 obo:CL_0003036 \"A monostratified retinal ganglion cell with large soma and large dendritic field, with medium dendritic arbor, and has dendrites in layers 2 and 5.\")\n21442:AnnotationAssertion(rdfs:label obo:CL_0003036 \"M7 retinal ganglion cell\")\n21447:# Class: obo:CL_0003037 (M7-ON retinal ganglion cell)\n21449:AnnotationAssertion(Annotation(oboInOwl:h