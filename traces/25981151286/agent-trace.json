{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '31280,32670p' src/ontology/cl-edit.owl\"","aggregated_output":"# Class: obo:CL_4023187 (koniocellular cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Lateral_geniculate_nucleus&oldid=1098375993\") obo:IAO_0000115 obo:CL_4023187 \"A neuron with a small cell body that is located in a koniocellular layer of the lateral geniculate nucleus (LGN).\")\nAnnotationAssertion(terms:contributor obo:CL_4023187 <http://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023187 \"NIFEXT:44\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") oboInOwl:hasExactSynonym obo:CL_4023187 \"K cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") rdfs:comment obo:CL_4023187 \"In adult monkeys, koniocellular cells can be distinguished from parvocellular and magnocellular of the LGN by their expression of calbindin, the alpha subunit of type II calmodulin-dependent protein kinase, and the gamma subunit of protein kinase C.\")\nAnnotationAssertion(rdfs:label obo:CL_4023187 \"koniocellular cell\")\nEquivalentClasses(obo:CL_4023187 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0013615)))\n\n# Class: obo:CL_4023188 (midget ganglion cell of retina)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\nAnnotationAssertion(terms:contributor obo:CL_4023188 \"https://orcid.org/0000-0001-7258-9596\")\nAnnotationAssertion(terms:contributor obo:CL_4023188 \"https://orcid.org/0000-0001-7655-4833\")\nAnnotationAssertion(rdfs:comment obo:CL_4023188 \"There are midget bipolar cells of retina and midget ganglion cells of retina and they are not the same:\nMidget bipolar cells (imb, fmb) have larger axon terminals at greater distances from the fovea (retinal eccentricity of 4.5mm as compared to 12 mm). Midget ganglion cells (MGC) have larger dendritic fields (here seen at 8 mm) as they increase in eccentricity.\")\nAnnotationAssertion(rdfs:label obo:CL_4023188 \"midget ganglion cell of retina\")\nSubClassOf(obo:CL_4023188 obo:CL_0000740)\nSubClassOf(obo:CL_4023188 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0013607))\n\n# Class: obo:CL_4023189 (parasol ganglion cell of retina)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\nAnnotationAssertion(terms:contributor obo:CL_4023189 \"https://orcid.org/0000-0001-7258-9596\")\nAnnotationAssertion(terms:contributor obo:CL_4023189 \"https://orcid.org/0000-0001-7655-4833\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M ganglion cell\")\nAnnotationAssertion(rdfs:comment obo:CL_4023189 \"These cells should not be confused with M1-M14 retinal ganglion cells described in PMID:16626866 which refer to a different classification of retinal ganglion cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4023189 \"parasol ganglion cell of retina\")\nSubClassOf(obo:CL_4023189 obo:CL_0000740)\nSubClassOf(obo:CL_4023189 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0013606))\n\n# Class: obo:CL_4028001 (pulmonary capillary endothelial cell)\n\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4028001 \"Any capillary endothelial cell that is part of a lung.\")\nAnnotationAssertion(terms:contributor obo:CL_4028001 <https://orcid.org/0000-0002-3293-5463>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028001 \"2021-11-23T02:31:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028001 \"lung capillary endothelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4028001 \"pulmonary capillary endothelial cell\")\nEquivalentClasses(obo:CL_4028001 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048)))\nSubClassOf(obo:CL_4028001 obo:CL_2000016)\nSubClassOf(obo:CL_4028001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0016405))\n\n# Class: obo:CL_4028002 (alveolar capillary type 1 endothelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31233341\") Annotation(oboInOwl:hasDbXref \"PMID:32059772\") Annotation(oboInOwl:hasDbXref \"PMID:32059779\") Annotation(oboInOwl:hasDbXref \"PMID:32091393\") Annotation(oboInOwl:hasDbXref \"PMID:33057196\") Annotation(oboInOwl:hasDbXref \"PMID:33705684\") obo:IAO_0000115 obo:CL_4028002 \"An alveolar capillary endothelial cell that is located distally to alveolar capillary type 2 endothelial cells.\")\nAnnotationAssertion(terms:contributor obo:CL_4028002 <https://orcid.org/0000-0002-3293-5463>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028002 \"2021-11-23T03:23:53Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028002 \"capillary 1 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33057196\") oboInOwl:hasBroadSynonym obo:CL_4028002 \"general capillary cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028002 \"CAP1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33057196\") Annotation(oboInOwl:hasSynonymType obo: