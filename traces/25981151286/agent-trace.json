sOf(obo:CL_4030024 obo:CL_0000066)\n\n# Class: obo:CL_4030025 (renal cortical fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\nAnnotationAssertion(terms:date obo:CL_4030025 \"2022-07-05T15:50:17Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\nAnnotationAssertion(rdfs:label obo:CL_4030025 \"renal cortical fibroblast\")\nEquivalentClasses(obo:CL_4030025 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005270)))\n\n# Class: obo:CL_4030026 (BEST4+ enterocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-7431-4139>) Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:35176508\") obo:IAO_0000115 obo:CL_4030026 \"An enterocyte of the human intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.\")\nAnnotationAssertion(terms:date obo:CL_4030026 \"2022-09-07T12:34:20Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030026 \"BEST4+ enterocyte\")\nEquivalentClasses(obo:CL_4030026 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\nSubClassOf(obo:CL_4030026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n\n# Class: obo:CL_4030027 (GABAergic amacrine cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.cell.2020.08.013\") obo:IAO_0000115 obo:CL_4030027 \"An amacrine cell that uses GABA as a neurotransmitter.\")\nAnnotationAssertion(terms:date obo:CL_4030027 \"2022-10-17T12:35:11Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030027 \"amacrine cell, GABAergic\")\nAnnotationAssertion(rdfs:label obo:CL_4030027 \"GABAergic amacrine cell\")\nEquivalentClasses(obo:CL_4030027 ObjectIntersectionOf(obo:CL_0000561 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n\n# Class: obo:CL_4030028 (glycinergic amacrine cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.cell.2020.08.013\") obo:IAO_0000115 obo:CL_4030028 \"An amacrine cell that uses glycine as a neurotransmitter.\")\nAnnotationAssertion(terms:date obo:CL_4030028 \"2022-10-17T12:40:06Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030028 \"amacrine cell, glycinergic\")\nAnnotationAssertion(rdfs:label obo:CL_4030028 \"glycinergic amacrine cell\")\nEquivalentClasses(obo:CL_4030028 ObjectIntersectionOf(obo:CL_0000561 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061537)))\n\n# Class: obo:CL_4030029 (blood lymphocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) obo:IAO_0000115 obo:CL_4030029 \"A lymphocyte located in blood.\")\nAnnotationAssertion(terms:date obo:CL_4030029 \"2022-11-04T14:40:00Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030029 \"blood lymphocyte\")\nEquivalentClasses(obo:CL_4030029 ObjectIntersectionOf(obo:CL_0000542 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000178)))\n\n# Class: obo:CL_4030030 (peripheral blood lymphocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0003-2534-198X>) Annotation(oboInOwl:hasDbXref \"PMID:31092833\") Annotation(oboInOwl:hasDbXref \"https://sciencing.com/what-peripheral-blood-4672930.html\") obo:IAO_0000115 obo:CL_4030030 \"A blood lymphocyte located in the flowing, circulating blood of the body.\")\nAnnotationAssertion(terms:date obo:CL_4030030 \"2022-11-14T10:08:14Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030030 \"peripheral blood lymphocyte\")\nAnnotationAssertion(rdfs:seeAlso obo:CL_4030030 \"https://github.com/obophenotype/cell-ontology/pull/1725\")\nSubClassOf(obo:CL_4030030 obo:CL_4030029)\nSubClassOf(obo:CL_4030030 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0013755))\nSubClassOf(obo:CL_4030030 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0013756))\n\n# Class: obo:CL_4030031 (interstitial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24987007\") obo:IAO_0000115 obo:CL_4030031 \"Any cell that is located within the interstitium between the cells most prominent in defining a given tissue. \\\"Interstitial cell\\\" is a morphological term and refers to a variety of cells with differing origins and phenotypes.\")\nAnnotationAssertion(terms:date obo:CL_4030031 \"2022-11-30T14:35:08Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030031 \"interstitial cell\")\nEquivalentClasses(obo:CL_4030031 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005169)))\n\n# Class: obo:CL_4030032 (valve interstitial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7655-4833>) Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1098/rsif.2017.0580\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1161/ATVBAHA.120.314789\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1161/JAHA.117.006339\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.2353/ajpath.2007.070251\") obo:IAO_0000115 obo:CL_4030032 \"An interstitial cell that is part of a cardiac valve leaflet. Along with valve endothelial cells, a valve interstitial cell maintains tissue homeostasis for the function of cardiac valves through secreting biochemical signals, matrix proteins and matrix remodeling enzymes.\")\nAnnotationAssertion(terms:date obo:CL_4030032 \"2022-12-06T14:18:45Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"PMID:30796046\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030032 \"VIC\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030032 \"cardiac valve interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") oboInOwl:hasExactSynonym obo:CL_4030032 \"valvular interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\nAnnotationAssertion(rdfs:label obo:CL_4030032 \"valve interstitial cell\")\nEquivalentClasses(obo:CL_4030032 ObjectIntersectionOf(obo:CL_4030031 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000946)))\nSubClassOf(obo:CL_4030032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n\n# Class: obo:CL_4030033 (valve endothelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") obo:IAO_0000115 obo:CL_4030033 \"An endothelial cell that lines a surface of a cardiac valve leaflet. Along with valve interstitial cells, a valve endothelial cell maintains tissue homeostasis for the function of cardiac valves through secreting biochemical signals, matrix proteins and matrix remodeling enzymes.\")\nAnnotationAssertion(terms:date obo:CL_4030033 \"2022-12-09T11:58:49Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"PMID:30796046\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030033 \"VEC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") oboInOwl:hasExactSynonym obo:CL_4030033 \"valvular endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030033 \"At least in some mammalian species, a valve endothelial cell expresses CD31. Valve endothelial cells can undergo an endothelial to mesenchymal transition to acquire a fibroblast or myofibroblast phenotype that leads to changes in the microenvironmental signals and facilitates tissue regeneration.\")\nAnnotationAssertion(rdfs:label obo:CL_4030033 \"valve endothelial cell\")\nEquivalentClasses(obo:CL_4030033 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000946)))\n\n# Class: obo:CL_4030034 (respiratory tract multiciliated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18757316\") Annotation(oboInOwl:hasDbXref \"PMID:21364219\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4030034 \"A multiciliated epithelial cell located in the respiratory tract epithelium, characterized by a columnar shape and motile cilia on its apical surface. This cell develops through a highly orchestrated process, transitioning from a basal progenitor via an intermediate deuterosomal cell stage that generates centrioles essential for ciliogenesis.\")\nAnnotationAssertion(terms:date obo:CL_4030034 \"2023-01-25T11:06:01Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"ciliated cell of the respiratory tract\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"respiratory ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"respiratory multiciliated cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030034 \"respiratory tract multiciliated cell\")\nEquivalentClasses(obo:CL_4030034 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\nSubClassOf(obo:CL_4030034 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033044))\n\n# Class: obo:CL_4030035 (dental pulp stem cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-2825-0621>) Annotation(oboInOwl:hasDbXref \"DOI:10.1177/154405910208100806\") obo:IAO_0000115 obo:CL_4030035 \"A dental pulp cell that possesses stem-cell-like qualities, including self-renewal capability and multi-lineage differentiation.\")\nAnnotationAssertion(terms:date obo:CL_4030035 \"2023-01-10T14:02:02Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030035 \"DPSC\")\nAnnotationAssertion(rdfs:label obo:CL_4030035 \"dental pulp stem cell\")\nEquivalentClasses(obo:CL_4030035 ObjectIntersectionOf(obo:CL_0000034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001754)))\nSubClassOf(obo:CL_4030035 obo:CL_0002148)\n\n# Class: obo:CL_4030036 (early spermatid)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Germ+cells#earlyspermatids\") obo:IAO_0000115 obo:CL_4030036 \"A spermatid in an early stage of maturation that has a round morphology and is transcriptionally active.\")\nAnnotationAssertion(terms:date obo:CL_4030036 \"2023-02-01T13:56:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/B978-0-323-01970-5.50014-2\") oboInOwl:hasExactSynonym obo:CL_4030036 \"round spermatid\")\nAnnotationAssertion(rdfs:label obo:CL_4030036 \"early spermatid\")\nSubClassOf(obo:CL_4030036 obo:CL_0000018)\nSubClassOf(obo:CL_4030036 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000079))\nSubClassOf(obo:CL_4030036 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0007286))\n\n# Class: obo:CL_4030037 (late spermatid)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Germ+cells#latespermatids\") obo:IAO_0000115 obo:CL_4030037 \"A spermatid in a late stage of maturation that has an elongated morphology and is transcriptionally inert when the acrosome is fully developed.\")\nAnnotationAssertion(terms:date obo:CL_4030037 \"2023-02-01T14:02:15Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/B978-0-323-01970-5.50014-2\") oboInOwl:hasExactSynonym obo:CL_4030037 \"elongated spermatid\")\nAnnotationAssertion(rdfs:label obo:CL_4030037 \"late spermatid\")\nSubClassOf(obo:CL_4030037 obo:CL_0000018)\nSubClassOf(obo:CL_4030037 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000079))\nSubClassOf(obo:CL_4030037 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4030036))\nSubClassOf(obo:CL_4030037 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0007286))\n\n# Class: obo:CL_4030038 (CD24-positive, CD-133-positive, vimentin-positive proximal tubular cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21281815\") Annotation(oboInOwl:hasDbXref \"PMID:23124355\") obo:IAO_0000115 obo:CL_4030038 \"A CD24-positive, CD-133-positive, vimentin-positive cell found scattered throughout a renal proximal tubule and that may participate in tubular regeneration. Compared to other proximal tubular cell types, this cell contains less cytoplasm, fewer mitochondria and no brush border.\")\nAnnotationAssertion(terms:date obo:CL_4030038 \"2023-03-07T14:17:39Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1002/stem.1130\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD133+CD24+CD106- tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD24+CD133+ tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD24-positive tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") rdfs:comment obo:CL_4030038 \"After acute tubular injury, this cell type becomes more numerous. In healthy rat kidneys, this cell is not detectable, whereas after unilateral ureteral obstruction (renal injury), it may appear de novo, arguing against the notion that this cell type represents a pre-existing progenitor cell population. In at least one study, data indicate that this cell type represents transiently dedifferentiated tubular cells involved in regeneration.\")\nAnnotationAssertion(rdfs:label obo:CL_4030038 \"CD24-positive, CD-133-positive, vimentin-positive proximal tubular cell\")\nSubClassOf(obo:CL_4030038 obo:CL_0002306)\nSubClassOf(obo:CL_4030038 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008404))\nSubClassOf(obo:CL_4030038 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001786))\nSubClassOf(obo:CL_4030038 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001932))\nSubClassOf(obo:CL_4030038 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000017298))\n\n# Class: obo:CL_4030039 (von Economo neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1007/BF02970950\") Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") Annotation(oboInOwl:hasDbXref \"PMID:32127543\") obo:IAO_0000115 obo:CL_4030039 \"An extratelencephalic-projecting glutamatergic cortical neuron that is morphologically-defined with a large, spindle-shaped cell body, thick bipolar dendrites with limited branching and a moderate density of spines, and often an axon initial segment that emanates from the side of the cell body. This cell type is associated with markers POU3F, BMP3 and ITGA4.\")\nAnnotationAssertion(terms:date obo:CL_4030039 \"2023-05-25T07:29:21Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32127543\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030039 \"VEN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32127543\") rdfs:comment obo:CL_4030039 \"In humans, a von Economo neuron is restricted to layer 5 of the anterior cingulate, frontoinsular, and medial frontopolar regions of cerebral cortex, while in some other species it is also found in the frontal and occipital poles and may not be restricted to layer 5.\")\nAnnotationAssertion(rdfs:label obo:CL_4030039 \"von Economo neuron\")\nSubClassOf(obo:CL_4030039 obo:CL_4023009)\nSubClassOf(obo:CL_4030039 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070006))\n\n# Class: obo:CL_4030040 (endometrial multiciliated epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31290979\") Annotation(oboInOwl:hasDbXref \"PMID:37999981\") Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.coemr.2024.100503\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Glandular+epithelial+cells#endometrialciliatedcells\") obo:IAO_0000115 obo:CL_4030040 \"A multi-ciliated cell of the endometrial epithelium. This cell is characterized by the presence of 9+2 motile cilia on its apical surface, which facilitates the movement of mucus across the endometrial surface.\")\nAnnotationAssertion(terms:date obo:CL_4030040 \"2023-02-09T11:25:14Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030040 \"ciliated cell of the uterus\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030040 \"uterine ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"ciliated cell of the endometrium\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"endometrial ciliated epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"endometrium ciliated epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ttps://www.nature.com/articles/s41591-020-1040-z\") rdfs:comment obo:CL_4030040 \"In human samples, the expression of FOXJ1 protein, a regulator for motile cilia with epithelial lineage identity, has been noted.\")\nAnnotationAssertion(rdfs:label obo:CL_4030040 \"endometrial multiciliated epithelial cell\")\nEquivalentClasses(obo:CL_4030040 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004811) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0097729) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n\n# Class: obo:CL_4030041 (luminal endometrial multiciliated epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_4030041 \"A ciliated cell of the endometrial luminal epithelium. This cell is characterized by the presence of motile cilia on its apical surface.\")\nAnnotationAssertion(terms:date obo:CL_4030041 \"2023-02-09T11:34:42Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030041 \"luminal endometrial ciliated epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030041 \"luminal endometrial multiciliated epithelial cell\")\nSubClassOf(obo:CL_4030041 obo:CL_4030040)\nSubClassOf(obo:CL_4030041 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949))\n\n# Class: obo:CL_4030042 (glandular endometrial multiciliated epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_4030042 \"A ciliated cell of the endometrial glandular epithelium. This cell is characterized by the presence of motile cilia on its apical surface.\")\nAnnotationAssertion(terms:date obo:CL_4030042 \"2023-02-09T11:37:30Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030042 \"glandular endometrial ciliated epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030042 \"glandular endometrial multiciliated epithelial cell\")\nSubClassOf(obo:CL_4030042 obo:CL_4030040)\nSubClassOf(obo:CL_4030042 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012276))\n\n# Class: obo:CL_4030043 (matrix D1 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030043 \"A DRD1-expressing medium spiny neuron that is part of a matrix compartment of dorsal striatum.\")\nAnnotationAssertion(terms:date obo:CL_4030043 \"2023-06-02T14:05:03Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"D1-matrix\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"D1M\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"matrix D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030043 \"In Rhesus macaques, both matrix D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: EPHA4, GDA, STXBP6, and SEMA3E. Broadly understood, matrix MSNs receive neocortical inputs from the associative and sensorimotor cortex and give rise to the direct and indirect pathways.\")\nAnnotationAssertion(rdfs:label obo:CL_4030043 \"matrix D1 medium spiny neuron\")\nSubClassOf(obo:CL_4030043 obo:CL_4023026)\nSubClassOf(obo:CL_4030043 ObjectSomeValuesFrom(obo:RO_0002100 ObjectIntersectionOf(obo:UBERON_0027368 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005382))))\n\n# Class: obo:CL_4030047 (matrix D2 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030047 \"A DRD2-expressing medium spiny neuron that is part of a matrix compartment of dorsal striatum.\")\nAnnotationAssertion(terms:date obo:CL_4030047 \"2023-06-02T14:40:25Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"D2-matrix\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"D2M\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"matrix D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030047 \"In Rhesus macaques, both matrix D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: EPHA4, GDA, STXBP6, and SEMA3E. Broadly understood, matrix MSNs receive neocortical inputs from the associative and sensorimotor cortex and give rise to the direct and indirect pathways.\")\nAnnotationAssertion(rdfs:label obo:CL_4030047 \"matrix D2 medium spiny neuron\")\nSubClassOf(obo:CL_4030047 obo:CL_4023029)\nSubClassOf(obo:CL_4030047 ObjectSomeValuesFrom(obo:RO_0002100 ObjectIntersectionOf(obo:UBERON_0027368 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005382))))\n\n# Class: obo:CL_4030048 (striosomal D1 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030048 \"A DRD1-expressing medium spiny neuron that is part of a striosome of dorsal striatum.\")\nAnnotationAssertion(terms:date obo:CL_4030048 \"2023-06-02T14:50:43Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030048 \"striosome D1 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"D1-striosome\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"D1S\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"striosome D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030048 \"In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.\")\nAnnotationAssertion(rdfs:label obo:CL_4030048 \"striosomal D1 medium spiny neuron\")\nSubClassOf(obo:CL_4030048 obo:CL_4023026)\nSubClassOf(obo:CL_4030048 ObjectSomeValuesFrom(obo:RO_0002100 ObjectIntersectionOf(obo:UBERON_0027371 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005382))))\n\n# Class: obo:CL_4030049 (striosomal D2 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030049 \"A DRD2-expressing medium spiny neuron that is part of a striosome of dorsal striatum.\")\nAnnotationAssertion(terms:date obo:CL_4030049 \"2023-06-02T15:03:08Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030049 \"striosome D2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"D2-striosome\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"D2S\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"striosome D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030049 \"In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.\")\nAnnotationAssertion(rdfs:label obo:CL_4030049 \"striosomal D2 medium spiny neuron\")\nSubClassOf(obo:CL_4030049 obo:CL_4023029)\nSubClassOf(obo:CL_4030049 ObjectSomeValuesFrom(obo:RO_0002100 ObjectIntersectionOf(obo:UBERON_0027371 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005382))))\n\n# Class: obo:CL_4030050 (D1/D2-hybrid medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030050 \"A medium spiny neuron that expresses both DRD1 and DRD2 and is part of an extra-striosomal part of dorsal striatum.\")\nAnnotationAssertion(terms:date obo:CL_4030050 \"2023-06-02T15:19:45Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/D2 hybrid\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/D2-hybrid MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"hybrid D1/2 cell type\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030050 \"It has been noted in non-human primate species that the D1/D2-hybrid medium spiny neuron (D1/2) cell type shows the same amount of DRD1 expression as nearby D1 medium spiny neurons but far less DRD2 expression compared to nearby D2 medium spiny neurons. In Rhesus macaques, RXFP1 has been noted as a highly specific marker gene for the D1/2 cell type. The D1/2 cell type has also been described as having characteristics similar to a novel medium spiny neuron described in rodents (D1H or eccentric spiny projection neuron). Although an extrastriosomal cell type, the D1/2 cell type had been noted to express many of the genes associated with striosome, suggesting a possible homology to ‘‘exo-patch’’ cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4030050 \"D1/D2-hybrid medium spiny neuron\")\nSubClassOf(obo:CL_4030050 obo:CL_1001474)\nSubClassOf(obo:CL_4030050 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005382))\nSubClassOf(obo:CL_4030050 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\nSubClassOf(obo:CL_4030050 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001177))\n\n# Class: obo:CL_4030051 (nucleus accumbens shell and olfactory tubercle D1 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030051 \"A DRD1-expressing medium spiny neuron that is part of a nucleus accumbens shell or olfactory tubercle.\")\nAnnotationAssertion(terms:date obo:CL_4030051 \"2023-06-14T13:03:50Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030051 \"NAc shell and OT D1 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030051 \"D1Sh\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030051 \"NAc shell and OT D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030051 \"In Rhesus macaques, both nucleus accumbens shell and olfactory tubercle D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: GREB1L, ARHGAP6, and GRIA4.\")\nAnnotationAssertion(rdfs:label obo:CL_4030051 \"nucleus accumbens shell and olfactory tubercle D1 medium spiny neuron\")\nSubClassOf(obo:CL_4030051 obo:CL_1001474)\nSubClassOf(obo:CL_4030051 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005403))\nSubClassOf(obo:CL_4030051 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\n\n# Class: obo:CL_4030052 (nucleus accumbens shell and olfactory tubercle D2 medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030052 \"A DRD2-expressing medium spiny neuron that is part of a nucleus accumbens shell or olfactory tubercle.\")\nAnnotationAssertion(terms:date obo:CL_4030052 \"2023-06-14T13:27:51Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030052 \"NAc shell and OT D2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"D2Sh\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"NAc shell and OT D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"nucleus accumbens shell and olfactory tubercle D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030052 \"In Rhesus macaques, both nucleus accumbens shell and olfactory tubercle D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: GREB1L, ARHGAP6, and GRIA4.\")\nAnnotationAssertion(rdfs:label obo:CL_4030052 \"nucleus accumbens shell and olfactory tubercle D2 medium spiny neuron\")\nSubClassOf(obo:CL_4030052 obo:CL_1001474)\nSubClassOf(obo:CL_4030052 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005403))\nSubClassOf(obo:CL_4030052 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001177))\n\n# Class: obo:CL_4030053 (Island of Calleja granule cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030053 \"A DRD1-expressing, medium spiny neuron-like granule cell that is part of an Island of Calleja.\")\nAnnotationAssertion(terms:date obo:CL_4030053 \"2023-06-14T13:37:45Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030053 \"D1-ICj\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030053 \"In Rhesus macaques, the Island of Calleja granule cell type has been noted to have enriched gene expression of CPNE4.\")\nAnnotationAssertion(rdfs:label obo:CL_4030053 \"Island of Calleja granule cell\")\nSubClassOf(obo:CL_4030053 obo:CL_0000120)\nSubClassOf(obo:CL_4030053 ObjectSomeValuesFrom(obo:RO_0002100 ObjectIntersectionOf(obo:UBERON_0001881 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005403))))\nSubClassOf(obo:CL_4030053 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\n\n# Class: obo:CL_4030054 (D1-NUDAP medium spiny neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030054 \"STRv D1 NUDAP MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4030054 \"A DRD1-expressing medium spiny neuron that is part of dense, RXFP1-positive cell islands throughout the nucleus accumbens, putamen, and near the adjacent septal nuclei.\")\nAnnotationAssertion(terms:date obo:CL_4030054 \"2023-06-14T14:46:08Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") oboInOwl:hasExactSynonym obo:CL_4030054 \"RXFP1-positive interface island D1-medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030054 \"D1-NUDAP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") rdfs:comment obo:CL_4030054 \"Regarding the abbreviation D1-NUDAP, NUDAP stands for \\\"neurochemically unique domains in the accumbens and putamen\\\". In Rhesus macaques, the RXFP1-positive interface island D1-medium spiny neuron (D1-NUDAP) has been noted to have upregulation of OPRM1 compared to DRD1-expressing medium spiny neurons located outside of the D1-exclusive island and in Islands of Calleja. Kappa-opioid receptor gene (OPRK1) has been noted to be absent from D1-NUDAP cells. Many striosome-specific markers have been noted to be upregulated in D1-NUDAP cells, including KCNIP1, KCNT1, KHDRBS3, and BACH2. PDYN, an acknowledged D1-striosome marker gene, has also been noted to be expressed in D1-NUDAPs. D1-NUDAPs also express some genes found to be selectively expressed in the matrix, including STXBP6, GDA, and SEMA3E. Gene enrichment analysis has revealed that D1-NUDAP neurons express genes that have been implicated in drug addiction and many other functions.\")\nAnnotationAssertion(rdfs:label obo:CL_4030054 \"D1-NUDAP medium spiny neuron\")\nSubClassOf(obo:CL_4030054 obo:CL_1001474)\nSubClassOf(obo:CL_4030054 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005403))\nSubClassOf(obo:CL_4030054 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\nSubClassOf(obo:CL_4030054 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001666))\n\n# Class: obo:CL_4030055 (intermediate cell of urothelium)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") obo:IAO_0000115 obo:CL_4030055 \"A urothelial cell that is part of the regenerative layer(s) of cells directly superficial to basal cells in urothelium. The layer of intermediate cells in the urothelium ranges from one to several layers thick depending on the species with intermediate cells attached to adjacent cell layers and one another via desmosomes.\")\nAnnotationAssertion(terms:contributor obo:CL_4030055 \"https://orcid.org/0000-0003-3065-9183\")\nAnnotationAssertion(terms:date obo:CL_4030055 \"2023-06-16T07:53:43Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030055 \"FMA:84155\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-14366-4_8\") oboInOwl:hasExactSynonym obo:CL_4030055 \"urothelial intermediate cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") rdfs:comment obo:CL_4030055 \"It has been noted in at least some mammalian species that the urothelial intermediate cell type is similar to basal cells by expressing CK17 and (unlike umbrella cells) p63 but is positive for uroplakins (UPK) and negative for CK5. Urothelial intermediate cells have also been noted to be larger in diameter than urothelial basal cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4030055 \"intermediate cell of urothelium\")\nSubClassOf(obo:CL_4030055 obo:CL_0000731)\n\n# Class: obo:CL_4030056 (umbrella cell of urothelium)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") obo:IAO_0000115 obo:CL_4030056 \"A urothelial cell that is terminally differentiated and part of the urothelial apical surface that forms the high-resistance barrier of urothelium. Umbrella cells have been described as the largest of urothelial cell types, highly polarized, and, in some species, multinucleated. In the relaxed state, these cells form a dome-shaped structure at the apical pole and can also cover multiple underlying intermediate cells, leading to the name umbrella cells. In contrast, these cells flatten when the bladder is filled.\")\nAnnotationAssertion(terms:contributor obo:CL_4030056 \"https://orcid.org/0000-0003-3065-9183\")\nAnnotationAssertion(terms:date obo:CL_4030056 \"2023-06-16T07:59:43Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030056 \"FMA:84149\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") oboInOwl:hasExactSynonym obo:CL_4030056 \"facet cell of urothelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") oboInOwl:hasExactSynonym obo:CL_4030056 \"superficial cell of urothelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") rdfs:comment obo:CL_4030056 \"Umbrella cells are attached to sub-superficial cell layers via desmosomes, while tight junctions localized between superficial cells aid in forming a high-resistance barrier function. Another distinguishing feature of an umbrella cell type is the presence of subapical discoidal/fusiform-shaped vesicles contributing to the plasticity in urothelial cell surface area through a regulated process of endocytosis/exocytosis. It has been noted in at least some mammalian species that the urothelial umbrella cell type expresses UPK1A, UPK1B, UPK2 and UPK3A. Unlike intermediate and basal cells of the urothelium, CK17 is reported to be completely absent and p63 not expressed in umbrella cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4030056 \"umbrella cell of urothelium\")\nSubClassOf(obo:CL_4030056 obo:CL_0000731)\n\n# Class: obo:CL_4030057 (eccentric medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4030057 \"A medium spiny neuron that exhibits transcriptional divergence from direct and indirect spiny projection neurons, for example, enrichment in Casz1, Otof, Cacng5 and Pcdh8 noted in mice. Whilst in general medium spiny neurons have been found to be differentially distributed across the basal ganglia, the eccentric medium spiny neuron cell type has been found to be more evenly distributed throughout cerebral nuclei.\")\nAnnotationAssertion(terms:date obo:CL_4030057 \"2023-06-23T14:59:36Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") oboInOwl:hasExactSynonym obo:CL_4030057 \"eccentric spiny projection neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eSPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eccentric MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eccentric SPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4030057 \"The term “eccentric” is used in the name eccentric medium spiny neuron (MSN) due to the exhibited transcriptional divergence from canonical spiny projection neurons. It has been noted in at least one study that an eccentric MSN differs in expression from direct and indirect MSNs by 110 genes (more than the 68 that distinguished direct and indirect spiny projection neurons from each other) and expresses many genes that have little expression in the rest of the striatum. It also has been noted in at least one human study that most eccentric MSNs expressed only DRD1, but many in the basal ganglia co-expressed DRD1 and DRD2, suggesting regional specialization of a more broadly distributed cell type.\")\nAnnotationAssertion(rdfs:label obo:CL_4030057 \"eccentric medium spiny neuron\")\nSubClassOf(obo:CL_4030057 obo:CL_1001474)\n\n# Class: obo:CL_4030058 (TCR-positive macrophage)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) Annotation(oboInOwl:hasDbXref \"PMID:26074923\") obo:IAO_0000115 obo:CL_4030058 \"A macrophage that expresses the T cell receptor complex at the cell surface.\")\nAnnotationAssertion(terms:contributor obo:CL_4030058 <https://orcid.org/0000-0003-3308-6245>)\nAnnotationAssertion(terms:date obo:CL_4030058 \"2023-09-26T12:27:14Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26074923\") oboInOwl:hasExactSynonym obo:CL_4030058 \"T cell receptor positive macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26074923\") oboInOwl:hasExactSynonym obo:CL_4030058 \"TCR+ macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:37500727\") oboInOwl:hasRelatedSynonym obo:CL_4030058 \"TCR.macs\")\nAnnotationAssertion(rdfs:label obo:CL_4030058 \"TCR-positive macrophage\")\nEquivalentClasses(obo:CL_4030058 ObjectIntersectionOf(obo:CL_0000235 ObjectSomeValuesFrom(obo:RO_0002104 obo:GO_0042101)))\n\n# Class: obo:CL_4030059 (L2/3 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030059 \"L2/3 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030059 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential.\")\nAnnotationAssertion(terms:contributor obo:CL_4030059 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030059 \"2023-10-10T14:10:21Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030059 \"ILX:0770156\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030059 \"L2/3 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") rdfs:comment obo:CL_4030059 \"Hystorically, the L2/3 intratelencephalic projectic glutametergic neuron was known to have its soma in cortical layer 2/3. MERFISH data showed that this intratelencephalic-projecting glutametergic neuron can have its soma in layer 2/3, 4B, 4C. The position of the soma in layer 4b and 4C is less frequent for this neuronal type in comparison to cortical layer 2/3.\")\nAnnotationAssertion(rdfs:label obo:CL_4030059 \"L2/3 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030059 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440000)))\n\n# Class: obo:CL_4030060 (L2 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030060 \"L2 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030060 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 2.\")\nAnnotationAssertion(terms:contributor obo:CL_4030060 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030060 \"2023-10-10T14:10:36Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030060 \"L2 IT\")\nAnnotationAssertion(rdfs:label obo:CL_4030060 \"L2 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030060 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005391)))\n\n# Class: obo:CL_4030061 (L3 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030061 \"L3 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030061 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3.\")\nAnnotationAssertion(terms:contributor obo:CL_4030061 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030061 \"2023-10-10T14:10:47Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030061 \"L3 IT\")\nAnnotationAssertion(rdfs:label obo:CL_4030061 \"L3 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030061 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005392)))\n\n# Class: obo:CL_4030062 (L4/5 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030062 \"L4/5 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030062 \"An intratelencephalic-projecting glutamatergic with a soma located in cortical layer 4/5.\")\nAnnotationAssertion(terms:contributor obo:CL_4030062 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030062 \"2023-10-10T14:11:04Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030062 \"L4/5 IT\")\nAnnotationAssertion(rdfs:label obo:CL_4030062 \"L4/5 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030062 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440001)))\n\n# Class: obo:CL_4030063 (L4 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030063 \"L4 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030063 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B.\")\nAnnotationAssertion(terms:contributor obo:CL_4030063 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030063 \"2023-10-10T14:11:25Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030063 \"L4 IT\")\nAnnotationAssertion(rdfs:comment obo:CL_4030063 \"Historically, the L4 intratelencephalic projectic glutametergic neuron was known to have its soma in cortical layer 4. MERFISH data showed that this intratelencephalic-projecting glutametergic neuron can also have its soma in layer 3.\")\nAnnotationAssertion(rdfs:label obo:CL_4030063 \"L4 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030063 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005393)))\n\n# Class: obo:CL_4030064 (L5 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030064 \"L5 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030064 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5.\")\nAnnotationAssertion(terms:contributor obo:CL_4030064 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030064 \"2023-10-10T14:11:59Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030064 \"ILX:0770157\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:37292694\") oboInOwl:hasRelatedSynonym obo:CL_4030064 \"L5 IT\")\nAnnotationAssertion(rdfs:label obo:CL_4030064 \"L5 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030064 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394)))\n\n# Class: obo:CL_4030065 (L6 intratelencephalic projecting glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030065 \"L6 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030065 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.\")\nAnnotationAssertion(terms:contributor obo:CL_4030065 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030065 \"2023-10-10T14:12:23Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030065 \"ILX:0770158\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030065 \"L6 IT\")\nAnnotationAssertion(rdfs:label obo:CL_4030065 \"L6 intratelencephalic projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030065 ObjectIntersectionOf(obo:CL_4023040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005395)))\n\n# Class: obo:CL_4030066 (ureteric bud cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17133361\") Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:IAO_0000115 obo:CL_4030066 \"An epithelial cell that is part of a ureteric bud. A ureteric bud cell has the potential to induce metanephric mesenchymal cells to proliferate and convert to epithelia that form renal tubules via: (1) the secretion of multiple diffusible growth factors that rescue renal progenitors from apoptosis and stimulate them to proliferate and (2) contact-dependent mechanisms that induce mesenchymal-epithelial conversion.\")\nAnnotationAssertion(terms:contributor obo:CL_4030066 \"https://orcid.org/0000-0002-1425-877X\")\nAnnotationAssertion(terms:date obo:CL_4030066 \"2023-10-13T11:22:42Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030066 \"UB cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030066 \"ureteric bud cell\")\nEquivalentClasses(obo:CL_4030066 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000084)))\nSubClassOf(Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:CL_4030066 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_2001013))\n\n# Class: obo:CL_4030067 (L5/6 near-projecting glutamatergic neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4030067 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6.\")\nAnnotationAssertion(terms:contributor obo:CL_4030067 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030067 \"2023-11-17T11:35:06Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030067 \"L5/6 NP\")\nAnnotationAssertion(rdfs:label obo:CL_4030067 \"L5/6 near-projecting glutamatergic neuron\")\nEquivalentClasses(obo:CL_4030067 ObjectIntersectionOf(obo:CL_4023012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440002)))\n\n# Class: obo:CL_4030068 (L6 intratelencephalic projecting Car3 glutamatergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4030068 \"L6 IT Car3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") obo:IAO_0000115 obo:CL_4030068 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6.\")\nAnnotationAssertion(terms:contributor obo:CL_4030068 <https://orcid.org/0000-0003-4389-9821>)\nAnnotationAssertion(terms:date obo:CL_4030068 \"2023-11-23T09:16:14Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(o