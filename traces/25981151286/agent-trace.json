DbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29752282\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4028006 \"A pulmonary interstitial fibroblast that is part of the alveolus and localizes to vascular adventitia.\")\nAnnotationAssertion(terms:contributor obo:CL_4028006 <https://orcid.org/0000-0002-3293-5463>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028006 \"2021-12-09T15:53:21Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"adventitial fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"alveolar fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"matrix fibroblast 2\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"mesenchymal alveolar niche cell\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"type-2 associated stromal cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028006 \"alveolar type 2 fibroblast cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"AF2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"AdvF\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"MANC\")\nAnnotationAssertion(rdfs:label obo:CL_4028006 \"alveolar adventitial fibroblast\")\nSubClassOf(obo:CL_4028006 obo:CL_0002241)\nSubClassOf(obo:CL_4028006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002299))\n\n# Class: obo:CL_4029001 (gamete-nursing cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029001 \"A cell that supports the development of a gamete by providing it cytoplasmic material (including entire organelles) by direct cross-membrane channels (del Pino, 2021).\")\nAnnotationAssertion(terms:contributor obo:CL_4029001 <http://orcid.org/0000-0002-6095-8718>)\nAnnotationAssertion(terms:date obo:CL_4029001 \"2022-06-08T15:29:54Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4029001 \"BTO:0000953\")\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029001 \"cell\")\nAnnotationAssertion(rdfs:label obo:CL_4029001 \"gamete-nursing cell\")\nSubClassOf(obo:CL_4029001 obo:CL_0000000)\n\n# Class: obo:CL_4029002 (germline-derived nurse cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029002 \"A gamete-nursing cell that derives from a germline cell (del Pino, 2021).\")\nAnnotationAssertion(terms:contributor obo:CL_4029002 <http://orcid.org/0000-0002-6095-8718>)\nAnnotationAssertion(terms:date obo:CL_4029002 \"2022-06-08T15:32:29Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029002 \"cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1126/science.aad2156\") rdfs:comment obo:CL_4029002 \"Nurse cells were first described in insects, but recent works suggest they also exist in some mammals (Lei and Spradling, 2016).\")\nAnnotationAssertion(rdfs:label obo:CL_4029002 \"germline-derived nurse cell\")\nSubClassOf(obo:CL_4029002 obo:CL_0000039)\nSubClassOf(obo:CL_4029002 obo:CL_4029001)\n\n# Class: obo:CL_4029003 (somatic nurse-like cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029003 \"A gamete-nursing cell that derives from the somatic tissues of the gonad (del Pino, 2021).\")\nAnnotationAssertion(terms:contributor obo:CL_4029003 <http://orcid.org/0000-0002-6095-8718>)\nAnnotationAssertion(terms:date obo:CL_4029003 \"2022-06-08T15:38:03Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029003 \"cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1111/andr.12165\") rdfs:comment obo:CL_4029003 \"We follow what seems to be a common usage in the literature, which is to reserve the term “nurse cell” proper to cells from the germ line, hence the label “nurse-like”. This term encompasses pyriform cells described in reptiles, bird, and amphibians (del Pino, 2021); it does not encompass mammalian Sertoli cells, which do not appear to transfer cytoplasmic material to spermatogonia (França et al., 2016).\")\nAnnotationAssertion(rdfs:label obo:CL_4029003 \"somatic nurse-like cell\")\nSubClassOf(obo:CL_4029003 obo:CL_4029001)\n\n# Class: obo:CL_4030000 (choroidal melanocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_4030000 \"A melanocyte located in the vascular uvea and involved in photoprotection, regulation of oxidative damage and immune responses.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4030000 \"2022-01-20T12:59:06Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030000 \"uveal melanocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"PMID:34082079\") rdfs:comment obo:CL_4030000 \"Cellular functions and extracellular interactions of choroidal melanocytes are distinct to skin melanocytes. They might have both neuroectodermal as well as mesectodermal origins.\")\nAnnotationAssertion(rdfs:label obo:CL_4030000 \"choroidal melanocyte\")\nEquivalentClasses(obo:CL_4030000 ObjectIntersectionOf(obo:CL_0000148 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001768)))\n\n# Class: obo:CL_4030001 (stromal cell of thymus)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030001 \"A stromal cell that is part of the thymus.\")\nAnnotationAssertion(terms:date obo:CL_4030001 \"2022-07-08T11:39:38Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030001 \"thymic stromal cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030001 \"stromal cell of thymus\")\nEquivalentClasses(obo:CL_4030001 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002370)))\n\n# Class: obo:CL_4030002 (effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2825-0621\") obo:IAO_0000115 obo:CL_4030002 \"An alpha-beta memory T cell with the phenotype CD45RA-positive.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4030002 \"2022-02-01T13:04:46Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"TEMRA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"effector memory RA T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"TEMRA cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory CD45RA+ T cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/T_cell#Memory_T_cells\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory cells re-expressing CD45RA\")\nAnnotationAssertion(rdfs:label obo:CL_4030002 \"effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated\")\nSubClassOf(obo:CL_4030002 obo:CL_0000791)\n\n# Class: obo:CL_4030003 (interstitial cell of thymus)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030003 \"A cell that makes up the loose connective tissue of the thymus.\")\nAnnotationAssertion(terms:date obo:CL_4030003 \"2022-07-08T11:48:36Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030003 \"thymic interstitial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030003 \"interstitial cell of thymus\")\nSubClassOf(obo:CL_4030003 obo:CL_4030001)\n\n# Class: obo:CL_4030004 (thymic nurse cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Thymic_nurse_cell\") obo:IAO_0000115 obo:CL_4030004 \"A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.\")\nAnnotationAssertion(terms:contributor obo:CL_4030004 <https://orcid.org/0000-0002-0819-0473>)\nAnnotationAssertion(terms:date obo:CL_4030004 \"2022-02-18T12:43:20Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030004 \"thymic nurse cell\")\nSubClassOf(obo:CL_4030004 obo:CL_0002293)\n\n# Class: obo:CL_4030005 (kidney collecting duct beta-intercalated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24051376\") Annotation(oboInOwl:hasDbXref \"PMID:31300091\") Annotation(oboInOwl:hasDbXref \"PMID:32016094\") obo:IAO_0000115 obo:CL_4030005 \"A renal beta-intercalated cell that is part of the cortical collecting duct. The medullary collecting duct does not contain the renal beta-intercalated cell type.\")\nAnnotationAssertion(terms:date obo:CL_4030005 \"2022-09-14T16:19:11Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_4030005 \"B-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_4030005 \"kidney collecting duct intercalated cell type B\")\nAnnotationAssertion(rdfs:label obo:CL_4030005 \"kidney collecting duct beta-intercalated cell\")\nEquivalentClasses(obo:CL_4030005 ObjectIntersectionOf(obo:CL_0002201 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004203)))\n\n# Class: obo:CL_4030006 (fallopian tube secretory epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1186/1477-7827-7-129\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.3390/cells8080933\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") obo:IAO_0000115 obo:CL_4030006 \"An epithelial cell that is part of the fallopian tube that secretes mucus and oviduct-specific products in response to hormonal stimulation from estrogen and luteinizing hormone. This fallopian tube secretory cell is similar in height to the ciliated cell, but typically exhibits a more narrow, columnar shape. Its nucleus is ovoid and oriented perpendicular to the cell's long axis, with denser chromatin and a smaller nucleolus compared to the ciliated cell.\")\nAnnotationAssertion(terms:contributor obo:CL_4030006 <https://orcid.org/0000-0002-0819-0473>)\nAnnotationAssertion(terms:date obo:CL_4030006 \"2022-03-03T10:39:31Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030006 \"oviduct secretory epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030006 \"uterine tube secretory epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\nAnnotationAssertion(rdfs:label obo:CL_4030006 \"fallopian tube secretory epithelial cell\")\nSubClassOf(obo:CL_4030006 obo:CL_1001591)\nSubClassOf(obo:CL_4030006 obo:CL_4052019)\nSubClassOf(obo:CL_4030006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n\n# Class: obo:CL_4030007 (fallopian tube multiciliated epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16565155\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube\") obo:IAO_0000115 obo:CL_4030007 \"A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.\")\nAnnotationAssertion(terms:contributor obo:CL_4030007 <https://orcid.org/0000-0002-0819-0473>)\nAnnotationAssertion(terms:date obo:CL_4030007 \"2022-03-08T12:40:19Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030007 \"oviduct ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube multiciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"uterine tube ciliated epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030007 \"fallopian tube multiciliated epithelial cell\")\nSubClassOf(obo:CL_4030007 obo:CL_0005012)\nSubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\nSubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007589))\n\n# Class: obo:CL_4030008 (pronephric podocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10322630\") obo:IAO_0000115 obo:CL_4030008 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the pronephros.\")\nAnnotationAssertion(terms:contributor obo:CL_4030008 <https://orcid.org/0000-0002-2244-7917>)\nAnnotationAssertion(terms:date obo:CL_4030008 \"2022-03-11T14:38:32Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0001673\") oboInOwl:hasExactSynonym obo:CL_4030008 \"pronephric glomerular visceral epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030008 \"pronephric podocyte\")\nEquivalentClasses(obo:CL_4030008 ObjectIntersectionOf(obo:CL_0000653 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002120)))\nSubClassOf(obo:CL_4030008 obo:CL_0000653)\n\n# Class: obo:CL_4030009 (epithelial cell of proximal tubule segment 1)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030009 \"A brush border cell that is part of segment 1 (S1) of the proximal tubule epithelium, located in the renal cortex.\")\nAnnotationAssertion(terms:date obo:CL_4030009 \"2022-05-10T13:14:00Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030009 \"epithelial cell of segment 1 of proximal tubule\")\nAnnotationAssertion(rdfs:label obo:CL_4030009 \"epithelial cell of proximal tubule segment 1\")\nEquivalentClasses(obo:CL_4030009 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004196) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\nSubClassOf(obo:CL_4030009 obo:CL_0002307)\n\n# Class: obo:CL_4030010 (epithelial cell of proximal tubule segment 2)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:31253652\") obo:IAO_0000115 obo:CL_4030010 \"A brush border cell that is part of segment 2 (S2) of the proximal tubule epithelium, located in the renal cortex. In addition to its reabsorptive functions, it is also specialized in the secretion of organic anions and cations, including para-aminohippurate.\")\nAnnotationAssertion(terms:date obo:CL_4030010 \"2022-05-10T13:26:13Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030010 \"epithelial cell of segment 2 of proximal tubule\")\nAnnotationAssertion(rdfs:label obo:CL_4030010 \"epithelial cell of proximal tubule segment 2\")\nEquivalentClasses(obo:CL_4030010 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004197) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\nSubClassOf(obo:CL_4030010 obo:CL_0002307)\n\n# Class: obo:CL_4030011 (epithelial cell of proximal tubule segment 3)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030011 \"A brush border cell that is part of segment 3 (S3) of the proximal tubule epithelium, which extends from the medullary rays of the renal cortex into the outer medulla.\")\nAnnotationAssertion(terms:date obo:CL_4030011 \"2022-05-10T13:31:06Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030011 \"epithelial cell of segment 3 of proximal tubule\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") rdfs:comment obo:CL_4030011 \"The epithelial cell of proximal tubule segment 3 operates under relatively hypoxic conditions and is particularly susceptible to ischemic injury.\")\nAnnotationAssertion(rdfs:label obo:CL_4030011 \"epithelial cell of proximal tubule segment 3\")\nEquivalentClasses(obo:CL_4030011 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001290) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\nSubClassOf(obo:CL_4030011 obo:CL_0002307)\n\n# Class: obo:CL_4030012 (kidney loop of Henle short descending thin limb epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030012 \"Epithelial cell of the descending thin limb of the short loop (cortical) nephron limited to the outer medulla (mainly inner strip). It is known in some mammalian species that the short descending limb of the loop of Henle selectively expresses the serine protease Corin, the homeobox TF Uncx, and the urea channel Slc14a2.\")\nAnnotationAssertion(terms:contributor obo:CL_4030012 <https://orcid.org/0000-0003-2804-127X>)\nAnnotationAssertion(terms:date obo:CL_4030012 \"2022-05-13T11:00:29Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030012 \"epithelial cell of the descending thin limb of the short loop of Henle\")\nAnnotationAssertion(rdfs:label obo:CL_4030012 \"kidney loop of Henle short descending thin limb epithelial cell\")\nEquivalentClasses(obo:CL_4030012 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005099)))\nSubClassOf(obo:CL_4030012 obo:CL_0000076)\nSubClassOf(obo:CL_4030012 obo:CL_1001111)\n\n# Class: obo:CL_4030013 (kidney loop of Henle long descending thin limb outer medulla epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030013 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the outer medulla (inner stripe). It is known in some mammalian species that the long descending limb of the loop of Henle in the outer medulla selectively expresses the secreted activin-antagonist protein follistatin (Fst), the GPI-linked adhesion protein Cdh13, and the protein kinase Stk32a.\")\nAnnotationAssertion(terms:date obo:CL_4030013 \"2022-05-13T11:11:07Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030013 \"epithelial cell of the outer medulla of the long descending limb of the loop of Henle\")\nAnnotationAssertion(rdfs:label obo:CL_4030013 \"kidney loop of Henle long descending thin limb outer medulla epithelial cell\")\nSubClassOf(obo:CL_4030013 obo:CL_1001111)\nSubClassOf(obo:CL_4030013 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005100))\n\n# Class: obo:CL_4030014 (kidney loop of Henle long descending thin limb inner medulla epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/gene/8170\") obo:IAO_0000115 obo:CL_4030014 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the inner medulla. It is known in some mammalian species that the long descending limb of the loop of Henle in the inner medulla selectively expresses the nuclear receptor Nr2e3, the Ig kappa chain Igkc, and the secreted protein dermokine (Dmkn). SLC14A2, which expresses a urea transporter, is also expressed in the inner medulla.\")\nAnnotationAssertion(terms:date obo:CL_4030014 \"2022-05-13T11:16:54Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030014 \"epithelial cell of the inner medulla of the long descending limb of the loop of Henle\")\nAnnotationAssertion(rdfs:label obo:CL_4030014 \"kidney loop of Henle long descending thin limb inner medulla epithelial cell\")\nSubClassOf(obo:CL_4030014 obo:CL_1001111)\nSubClassOf(obo:CL_4030014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005100))\n\n# Class: obo:CL_4030015 (kidney collecting duct alpha-intercalated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030015 \"A renal alpha-intercalated cell that is part of the collecting duct of the renal tubule.\")\nAnnotationAssertion(terms:contributor obo:CL_4030015 <https://orcid.org/0000-0003-2804-127X>)\nAnnotationAssertion(terms:date obo:CL_4030015 \"2022-05-31T11:15:10Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030015 \"kidney collecting duct intercalated cell type A\")\nAnnotationAssertion(rdfs:label obo:CL_4030015 \"kidney collecting duct alpha-intercalated cell\")\nEquivalentClasses(obo:CL_4030015 ObjectIntersectionOf(obo:CL_0005011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232)))\n\n# Class: obo:CL_4030016 (epithelial cell of early distal convoluted tubule)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:24855283\") obo:IAO_0000115 obo:CL_4030016 \"An epithelial cell located in the early distal convoluted tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030016 \"2022-06-21T12:47:48Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") oboInOwl:hasBroadSynonym obo:CL_4030016 \"DCT1 cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030016 \"epithelial cell of early distal convoluted tubule\")\nEquivalentClasses(obo:CL_4030016 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005101)))\n\n# Class: obo:CL_4030017 (epithelial cell of late distal convoluted tubule)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:24855283\") obo:IAO_0000115 obo:CL_4030017 \"An epithelial cell located in the late distal convoluted tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030017 \"2022-06-21T13:51:46Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") oboInOwl:hasBroadSynonym obo:CL_4030017 \"DCT2 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") rdfs:comment obo:CL_4030017 \"Although mineralocorticoid receptors are expressed throughout the entire [distal convoluted tubule], the DCT2 is sensitive to the actions of aldosterone, because it expresses an enzyme called 11-β hydroxysteroid dehydrogenase 2 (11-βHSD2)\")\nAnnotationAssertion(rdfs:label obo:CL_4030017 \"epithelial cell of late distal convoluted tubule\")\nEquivalentClasses(obo:CL_4030017 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005102)))\n\n# Class: obo:CL_4030018 (kidney connecting tubule principal cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:27582101\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030018 \"A renal principal cell located in the connecting tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030018 \"2022-06-27T15:25:10Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030018 \"kidney connecting tubule principal cell\")\nEquivalentClasses(obo:CL_4030018 ObjectIntersectionOf(obo:CL_0005009 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005097)))\nSubClassOf(obo:CL_4030018 obo:CL_1000768)\n\n# Class: obo:CL_4030019 (kidney connecting tubule intercalated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030019 \"A renal intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030019 \"2022-06-29T11:25:22Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4030019 \"kidney connecting tubule intercalated cell\")\nEquivalentClasses(obo:CL_4030019 ObjectIntersectionOf(obo:CL_0005010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005097)))\nSubClassOf(obo:CL_4030019 obo:CL_1000768)\n\n# Class: obo:CL_4030020 (kidney connecting tubule alpha-intercalated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2254448\") Annotation(oboInOwl:hasDbXref \"PMID:24937428\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030020 \"A renal alpha-intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030020 \"2022-06-29T12:48:43Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24937428\") oboInOwl:hasExactSynonym obo:CL_4030020 \"connecting tubule A-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030020 \"kidney connecting tubule intercalated cell type A\")\nAnnotationAssertion(rdfs:label obo:CL_4030020 \"kidney connecting tubule alpha-intercalated cell\")\nEquivalentClasses(obo:CL_4030020 ObjectIntersectionOf(obo:CL_0005011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005097)))\n\n# Class: obo:CL_4030021 (kidney connecting tubule beta-intercalated cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2254448\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030021 \"A renal beta-intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(terms:date obo:CL_4030021 \"2022-06-29T14:31:18Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32065116\") oboInOwl:hasExactSynonym obo:CL_4030021 \"connecting tubule B-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030021 \"kidney connecting tubule intercalated cell type B\")\nAnnotationAssertion(rdfs:label obo:CL_4030021 \"kidney connecting tubule beta-intercalated cell\")\nEquivalentClasses(obo:CL_4030021 ObjectIntersectionOf(obo:CL_0002201 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005097)))\n\n# Class: obo:CL_4030022 (renal medullary fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1101/2021.07.28.454201>) Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030022 \"A fibroblast that is located in the renal medulla interstitium.\")\nAnnotationAssertion(terms:date obo:CL_4030022 \"2022-07-05T12:13:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030022 \"kidney medullary fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") rdfs:comment obo:CL_4030022 \"It has been noted that