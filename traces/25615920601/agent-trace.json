/////////\n    //\n    // Datatypes\n    //\n    ///////////////////////////////////////////////////////////////////////////////////////\n     -->\n\n    \n\n\n    <!-- \n    ///////////////////////////////////////////////////////////////////////////////////////\n    //\n    // Classes\n    //\n    ///////////////////////////////////////////////////////////////////////////////////////\n     -->\n\n    \n\n\n    <!-- http://purl.obolibrary.org/obo/PR_000001005 -->\n\n    <Class rdf:about=\"http://purl.obolibrary.org/obo/PR_000001005\">\n        <rdfs:label rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">integrin alpha with A domain</rdfs:label>\n    </Class>\n    \n\n\n    <!-- http://purl.obolibrary.org/obo/PR_000001012 -->\n\n    <Class rdf:about=\"http://purl.obolibrary.org/obo/PR_000001012\">\n        <rdfs:label rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">integrin alpha-M</rdfs:label>\n        <rdfs:subClassOf rdf:resource=\"http://purl.obolibrary.org/obo/PR_000001005\"/>\n        <ns3:IAO_0000115 rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">An integrin alpha with A domain that is a translation product of the human ITGAM gene or a 1:1 ortholog thereof. They constitute subunits of the integrin alpha-M/beta-2 receptor. This receptor is implicated in various adhesive interactions of monocytes, macrophages and granulocytes as well as in mediating the uptake of complement-coated particles. It is also a receptor for fibrinogen, factor X and ICAM1.</ns3:IAO_0000115>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">CD11 antigen-like family member B</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasRelatedSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">CD11B</oboInOwl:hasRelatedSynonym>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">CD11b</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">CR-3 alpha chain</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasRelatedSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">CR3A</oboInOwl:hasRelatedSynonym>\n        <rdfs:comment rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">Category=gene. Requested by=CL.</rdfs:comment>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">ITGAM</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasDbXref rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">IUPHARobj:2452</oboInOwl:hasDbXref>\n        <oboInOwl:id rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">PR:000001012</oboInOwl:id>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">cell surface glycoprotein MAC-1 subunit alpha</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">leukocyte adhesion receptor MO1</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasExactSynonym rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">neutrophil adherence receptor</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasOBONamespace rdf:datatype=\"http://www.w3.org/2001/XMLSchema#string\">protein</oboInOwl:hasOBONamespace>\n    </Class>\n</rdf:RDF>\n\n\n\n<!-- Generated by the OWL API (version 3.2.4.1806) http://owlapi.sourceforge.net -->\n\n\n\n","metadata":{"truncated":false},"title":"https://www.ontobee.org/ontology/PR?iri=http://purl.obolibrary.org/obo/PR_000001012 (text/xml;charset=UTF-8)","time":{"start":1778377993223,"end":1778377994139}},"metadata":{"openai":{"itemId":"fc_0a1825b92853febd0169ffe509193c819db41218fb367a2854"}},"id":"prt_e0f96ac03001BYKxmaZ2XIPOKr","sessionID":"ses_1f06a5040ffejlBw2G47PE46SS","messageID":"msg_e0f969d25001bV0b0ETEgVovzx"}}
