///////////////\n    //\n    // Datatypes\n    //\n    ///////////////////////////////////////////////////////////////////////////////////////\n     -->\n\n    \n\n\n    <!-- \n    ///////////////////////////////////////////////////////////////////////////////////////\n    //\n    // Object Properties\n    //\n    ///////////////////////////////////////////////////////////////////////////////////////\n     -->\n\n    \n\n\n    <!-- http://purl.obolibrary.org/obo/BFO_0000051 -->\n\n    <ObjectProperty rdf:about=\"http://purl.obolibrary.org/obo/BFO_0000051\">\n        <rdf:type rdf:resource=\"http://www.w3.org/2002/07/owl#TransitiveProperty\"/>\n        <rdfs:label xml:lang=\"en\">has part</rdfs:label>\n    </ObjectProperty>\n    \n\n\n    <!-- http://purl.obolibrary.org/obo/RO_0002104 -->\n\n    <ObjectProperty rdf:about=\"http://purl.obolibrary.org/obo/RO_0002104\">\n        <rdfs:label xml:lang=\"en\">has plasma membrane part</rdfs:label>\n        <ns2:IAO_0000424>&lt;http://purl.obolibrary.org/obo/BFO_0000051&gt; some (&lt;http://purl.obolibrary.org/obo/GO_0005886&gt; and &lt;http://purl.obolibrary.org/obo/BFO_0000051&gt; some ?Y)</ns2:IAO_0000424>\n        <ns2:IAO_0000112 xml:lang=\"en\">Every B cell[CL_0000236] has plasma membrane part some immunoglobulin complex[GO_0019814]</ns2:IAO_0000112>\n        <ns2:IAO_0000115>Holds between a cell c and a protein complex or protein p if and only if that cell has as part a plasma_membrane[GO:0005886], and that plasma membrane has p as part.</ns2:IAO_0000115>\n        <rdfs:subPropertyOf rdf:resource=\"http://purl.obolibrary.org/obo/BFO_0000051\"/>\n        <ns2:IAO_0000114 rdf:resource=\"http://purl.obolibrary.org/obo/IAO_0000125\"/>\n        <ns2:RO_0001900 rdf:resource=\"http://purl.obolibrary.org/obo/RO_0001901\"/>\n        <rdfs:domain rdf:resource=\"http://purl.obolibrary.org/obo/UBERON_0000465\"/>\n        <rdfs:range rdf:resource=\"http://purl.obolibrary.org/obo/UBERON_0000465\"/>\n        <ns2:IAO_0000119 rdf:res