ateTime)\n34304:AnnotationAssertion(terms:date obo:CL_4047054 \"2025-03-17T17:37:37Z\"^^xsd:dateTime)\n34314:AnnotationAssertion(terms:date obo:CL_4047056 \"2025-03-20T14:21:41Z\"^^xsd:dateTime)\n34324:AnnotationAssertion(terms:date obo:CL_4047060 \"2025-05-06T14:41:24Z\"^^xsd:dateTime)\n34334:AnnotationAssertion(terms:date obo:CL_4047101 \"2024-07-29T13:43:11Z\"^^xsd:dateTime)\n34347:# Class: obo:CL_4052001 (multiciliated ependymal cell)\n34349:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") obo:IAO_0000115 obo:CL_4052001 \"An ependymal cell that lines the lateral, third, and fourth ventricles of the brain. The cell is characterized by multiple motile cilia on its apical surface, which beats in a coordinated manner to facilitate the movement of cerebrospinal fluid (CSF), contributing to brain homeostasis.\")\n34350:AnnotationAssertion(terms:contributor obo:CL_4052001 <https://orcid.org/0009-0000-8480-9277>)\n34351:AnnotationAssertion(terms:date obo:CL_4052001 \"2024-08-20T10:06:15Z\"^^xsd:dateTime)\n34352:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") oboInOwl:hasBroadSynonym obo:CL_4052001 \"multiciliated ependymal cells\")\n34353:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052001 \"E1\")\n34354:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:27311928\") rdfs:comment obo:CL_4052001 \"multiciliated ependymal cell, with an average of 16 motile cilia per cell, exhibits two types of planar cell polarity (PCP): rotational polarity, with unidirectional cilia orientation, and translational polarity, with asymmetric cilia positioning in the apical area. This location-specific PCP varies across the ventricular wall, aligning with the direction of CSF flow. These cells are interconnected by adherens and gap junctions, which support intercellular communication and maintain the structural integrity of the ependymal layer. Unlike some other cell types, these cells lack tight junctions.\")\n34355:AnnotationAssertion(rdfs:label obo:CL_4052001 \"multiciliated ependymal cell\")\n34356:EquivalentClasses(obo:CL_4052001 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004670) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n34358:# Class: obo:CL_4052002 (syncytial cell)\n34360:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20851884\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Syncytium\") obo:IAO_0000115 obo:CL_4052002 \"A multinucleate cell formed by the fusion of multiple uninuclear cells through plasma membrane fusion. This process leads to a single large cell containing multiple nuclei within a shared cytoplasm.\")\n34361:AnnotationAssertion(terms:contributor obo:CL_4052002 <https://orcid.org/0009-0000-8480-9277>)\n34362:AnnotationAssertion(terms:date obo:CL_4052002 \"2024-08-15T10:38:46Z\"^^xsd:dateTime)\n34363:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WBbt:0008074\") oboInOwl:hasExactSynonym obo:CL_4052002 \"syncytium\")\n34364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9067520\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052002 \"SC\")\n34365:AnnotationAssertion(rdfs:label obo:CL_4052002 \"syncytial cell\")\n34366:EquivalentClasses(obo:CL_4052002 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001908) ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0000768)))\n34368:# Class: obo:CL_4052003 (intestinal villus capillary endothelial cell)\n34370:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:35810168\") Annotation(oboInOwl:hasDbXref \"PMID:38051275\") obo:IAO_0000115 obo:CL_4052003 \"A capillary endothelial cell that is part of the intestinal villus. This cell is highly fenestrated, with fenestrations most numerous at the villus tips, and plays a vital role in nutrient absorption and maintaining the selective permeability of the intestinal barrier.\")\n34371:AnnotationAssertion(terms:contributor obo:CL_4052003 <https://orcid.org/0009-0000-8480-9277>)\n34372:AnnotationAssertion(terms:date obo:CL_4052003 \"2024-09-17T10:03:25Z\"^^xsd:dateTime)\n34373:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35810168\") oboInOwl:hasBroadSynonym obo:CL_4052003 \"villus blood capillary endothelial cells\")\n34374:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38051275\") oboInOwl:hasRelatedSynonym obo:CL_4052003 \"villus tip endothelial cell\")\n34375:AnnotationAssertion(rdfs:label obo:CL_4052003 \"intestinal villus capillary endothelial cell\")\n34376:EquivalentClasses(obo:CL_4052003 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001213)))\n34377:SubClassOf(obo:CL_4052003 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34379:# Class: obo:CL_4052004 (intestinal fibroblastic reticular cell)\n34381:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\n34382:AnnotationAssertion(terms:contributor obo:CL_4052004 <https://orcid.org/0009-0000-8480-9277>)\n34383:AnnotationAssertion(terms:date obo:CL_4052004 \"2024-09-19T11:22:18Z\"^^xsd:dateTime)\n34384:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\n34385:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\n34386:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\n34387:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\n34388:AnnotationAssertion(rdfs:label obo:CL_4052004 \"intestinal fibroblastic reticular cell\")\n34389:SubClassOf(obo:CL_4052004 obo:CL_0009101)\n34390:SubClassOf(obo:CL_4052004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001962))\n34392:# Class: obo:CL_4052005 (intestinal subserosal fibroblast)\n34394:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\n34395:AnnotationAssertion(terms:contributor obo:CL_4052005 <https://orcid.org/0009-0000-8480-9277>)\n34396:AnnotationAssertion(terms:date obo:CL_4052005 \"2024-09-19T12:58:29Z\"^^xsd:dateTime)\n34397:AnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\n34398:SubClassOf(obo:CL_4052005 obo:CL_0000057)\n34399:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001243))\n34400:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012375))\n34402:# Class: obo:CL_4052006 (intestinal enteroendocrine progenitor)\n34404:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\n34405:AnnotationAssertion(terms:contributor obo:CL_4052006 <https://orcid.org/0009-0000-8480-9277>)\n34406:AnnotationAssertion(terms:date obo:CL_4052006 \"2024-09-20T12:13:26Z\"^^xsd:dateTime)\n34407:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052006 \"EEC Progenitor\")\n34408:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25670791\") rdfs:comment obo:CL_4052006 \"The EEC progenitor is also present in other organisms; for example, flies have EEC progenitors but lack intestinal crypts and do not express the same markers. Instead, they are Dl+ and Pros+.\")\n34409:AnnotationAssertion(rdfs:label obo:CL_4052006 \"intestinal enteroendocrine progenitor\")\n34410:SubClassOf(obo:CL_4052006 obo:CL_0002563)\n34411:SubClassOf(obo:CL_4052006 obo:CL_0011026)\n34412:SubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\n34413:SubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\n34415:# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\n34417:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n34418:AnnotationAssertion(terms:contributor obo:CL_4052007 <https://orcid.org/0009-0000-8480-9277>)\n34419:AnnotationAssertion(terms:date obo:CL_4052007 \"2024-09-23T09:59:27Z\"^^xsd:dateTime)\n34420:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\n34421:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\n34422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\n34423:AnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\n34424:SubClassOf(obo:CL_4052007 obo:CL_0000057)\n34425:SubClassOf(obo:CL_4052007 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0001277))\n34427:# Class: obo:CL_4052008 (crypt-bottom fibroblast)\n34429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\n34430:AnnotationAssertion(terms:contributor obo:CL_4052008 <https://orcid.org/0009-0000-8480-9277>)\n34431:AnnotationAssertion(terms:date obo:CL_4052008 \"2024-09-23T10:23:18Z\"^^xsd:dateTime)\n34432:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052008 \"CBFs\")\n34433:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\n34434:AnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\n34435:SubClassOf(obo:CL_4052008 obo:CL_4052007)\n34436:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:CL_0002250))\n34437:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013739))\n34439:# Class: obo:CL_4052009 (crypt-top fibroblast)\n34441:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\n34442:AnnotationAssertion(terms:contributor obo:CL_4052009 <https://orcid.org/0009-0000-8480-9277>)\n34443:AnnotationAssertion(terms:date obo:CL_4052009 \"2024-09-23T11:14:04Z\"^^xsd:dateTime)\n34444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052009 \"CTFs\")\n34445:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\n34446:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\n34447:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\n34448:AnnotationAssertion(rdfs:label obo:CL_4052009 \"crypt-top fibroblast\")\n34449:SubClassOf(obo:CL_4052009 obo:CL_4052007)\n34450:SubClassOf(obo:CL_4052009 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013740))\n34452:# Class: obo:CL_4052010 (pre-theca cell)\n34454:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_4052010 \"A stromal cell that serves as a precursor to the theca cell layers in the ovary growing follicles. This cell is present in the early stages of follicular growth, particularly in smaller follicles. Unlike mature theca cell, a pre-theca cell is initially non-steroidogenic and lacks luteinizing hormone receptors.\")\n34455:AnnotationAssertion(terms:contributor obo:CL_4052010 <https://orcid.org/0009-0000-8480-9277>)\n34456:AnnotationAssertion(terms:date obo:CL_4052010 \"2024-09-25T11:15:57Z\"^^xsd:dateTime)\n34457:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052010 \"early theca cell\")\n34458:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") oboInOwl:hasExactSynonym obo:CL_4052010 \"progenitor theca cell\")\n34459:AnnotationAssertion(rdfs:label obo:CL_4052010 \"pre-theca cell\")\n34460:SubClassOf(obo:CL_4052010 obo:CL_0000499)\n34461:SubClassOf(obo:CL_4052010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012186))\n34462:SubClassOf(obo:CL_4052010 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000503))\n34464:# Class: obo:CL_4052011 (follicle associated enterocyte)\n34466:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29339448\") Annotation(oboInOwl:hasDbXref \"PMID:34634036\") Annotation(oboInOwl:hasDbXref \"PMID:7107724\") obo:IAO_0000115 obo:CL_4052011 \"An enterocyte found in the follicle-associated epithelium (FAE) that covers Peyer's patches and other mucosa-associated lymphoid tissues. This cell has reduced absorptive capacity and expresses higher levels of chemokines CCL20 and CXCL16, compared to regular villus enterocytes. It contributes to antigen sampling and immune interactions, supporting the specialized function of the FAE in mucosal immunity.\")\n34467:AnnotationAssertion(terms:contributor obo:CL_4052011 <https://orcid.org/0009-0000-8480-9277>)\n34468:AnnotationAssertion(terms:date obo:CL_4052011 \"2024-09-25T15:28:25Z\"^^xsd:dateTime)\n34469:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasExactSynonym obo:CL_4052011 \"follicle-associated epithelium enterocyte\")\n34470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052011 \"FAE enterocyte\")\n34471:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasRelatedSynonym obo:CL_4052011 \"follicular enterocyte\")\n34472:AnnotationAssertion(rdfs:label obo:CL_4052011 \"follicle associated enterocyte\")\n34473:SubClassOf(obo:CL_4052011 obo:CL_0000584)\n34474:SubClassOf(obo:CL_4052011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004693))\n34476:# Class: obo:CL_4052012 (interna theca cell)\n34478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_interna\") obo:IAO_0000115 obo:CL_4052012 \"A specialized theca cell that forms the inner, highly vascularized layer of the theca surrounding ovarian follicles. Originating from progenitor theca cells, the theca interna cell is steroidogenic, playing a crucial role in the production of androgens, which serves as a precursor for estrogen synthesis in granulosa cells. This cell expresses luteinizing hormone receptors, enabling it to respond to hormonal signals that regulate steroidogenesis.\")\n34479:AnnotationAssertion(terms:contributor obo:CL_4052012 <https://orcid.org/0009-0000-8480-9277>)\n34480:AnnotationAssertion(terms:date obo:CL_4052012 \"2024-09-30T11:10:15Z\"^^xsd:dateTime)\n34481:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"androgenic theca cell\")\n34482:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"inTC\")\n34483:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"interna TC\")\n34484:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"steroidogenic theca interna cell\")\n34485:AnnotationAssertion(rdfs:label obo:CL_4052012 \"interna theca cell\")\n34486:EquivalentClasses(obo:CL_4052012 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000157)))\n34487:SubClassOf(obo:CL_4052012 obo:CL_0000593)\n34488:SubClassOf(obo:CL_4052012 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\n34489:DisjointClasses(obo:CL_4052012 obo:CL_4052013)\n34491:# Class: obo:CL_4052013 (externa theca cell)\n34493:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n34494:AnnotationAssertion(terms:contributor obo:CL_4052013 <https://orcid.org/0009-0000-8480-9277>)\n34495:AnnotationAssertion(terms:date obo:CL_4052013 \"2024-09-30T11:10:15Z\"^^xsd:dateTime)\n34496:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"exTC\")\n34497:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"externa TC\")\n34498:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052013 \"structural theca cell\")\n34499:AnnotationAssertion(rdfs:label obo:CL_4052013 \"externa theca cell\")\n34500:EquivalentClasses(obo:CL_4052013 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000156)))\n34501:SubClassOf(obo:CL_4052013 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\n34503:# Class: obo:CL_4052014 (pancreatic islet capillary endothelial cell)\n34505:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:27124642\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") Annotation(oboInOwl:hasDbXref \"PMID:33200981\") obo:IAO_0000115 obo:CL_4052014 \"A capillary endothelial cell that is part of islet of Langerhans, characterized by a high density of fenestrations —approximately ten times greater than those in exocrine pancreatic capillaries. These fenestrations facilitate efficient hormone exchange, which is essential for maintaining glucose homeostasis. The cell's structure and function are regulated by the local production of vascular endothelial growth factor-A (VEGF-A), which maintains its fenestrated architecture.\")\n34506:AnnotationAssertion(terms:contributor obo:CL_4052014 <https://orcid.org/0009-0000-8480-9277>)\n34507:AnnotationAssertion(terms:date obo:CL_4052014 \"2024-09-30T14:36:12Z\"^^xsd:dateTime)\n34508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"islet endothelial cell\")\n34509:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"pancreatic islet endothelial cell\")\n34510:AnnotationAssertion(rdfs:label obo:CL_4052014 \"pancreatic islet capillary endothelial cell\")\n34511:EquivalentClasses(obo:CL_4052014 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000006)))\n34512:SubClassOf(obo:CL_4052014 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34514:# Class: obo:CL_4052015 (endocrine gland capillary endothelial cell)\n34516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") obo:IAO_0000115 obo:CL_4052015 \"Any capillary endothelial cell that is part of an endocrine gland.\")\n34517:AnnotationAssertion(terms:contributor obo:CL_4052015 <https://orcid.org/0009-0000-8480-9277>)\n34518:AnnotationAssertion(terms:date obo:CL_4052015 \"2024-09-30T15:27:49Z\"^^xsd:dateTime)\n34519:AnnotationAssertion(rdfs:label obo:CL_4052015 \"endocrine gland capillary endothelial cell\")\n34520:EquivalentClasses(obo:CL_4052015 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002368)))\n34522:# Class: obo:CL_4052016 (pituitary gland capillary endothelial cell)\n34524:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10810312\") Annotation(oboInOwl:hasDbXref \"PMID:32910242\") obo:IAO_0000115 obo:CL_4052016 \"A capillary endothelial cell that is part of the pituitary gland. This cell is characterized by its fenestrated structure which facilitates the efficient transport of hormones and other signaling molecules, essential for endocrine signalling.\")\n34525:AnnotationAssertion(terms:contributor obo:CL_4052016 <https://orcid.org/0009-0000-8480-9277>)\n34526:AnnotationAssertion(terms:date obo:CL_4052016 \"2024-09-30T15:31:45Z\"^^xsd:dateTime)\n34527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:4899902\") rdfs:comment obo:CL_4052016 \"In the anterior pituitary gland of rats, capillary endothelial cells are distinguished by numerous fenestrations, which are covered by a single-layered diaphragm. The diaphragm features a dense ring-like structure.\")\n34528:AnnotationAssertion(rdfs:label obo:CL_4052016 \"pituitary gland capillary endothelial cell\")\n34529:EquivalentClasses(obo:CL_4052016 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000007)))\n34530:SubClassOf(obo:CL_4052016 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34532:# Class: obo:CL_4052017 (choroid plexus capillary endothelial cell)\n34534:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:32375819\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK27998/\") obo:IAO_0000115 obo:CL_4052017 \"A capillary endothelial cell that is part of the choroid plexus, characterized by its fenestrated nature with 60 to 80 nm fenestrations and lack of tight junctions. This fenestrated structure allows for the rapid delivery of water and other components, aiding in the production of cerebrospinal fluid (CSF).\")\n34535:AnnotationAssertion(terms:contributor obo:CL_4052017 <https://orcid.org/0009-0000-8480-9277>)\n34536:AnnotationAssertion(terms:date obo:CL_4052017 \"2024-10-01T11:38:22Z\"^^xsd:dateTime)\n34537:AnnotationAssertion(rdfs:label obo:CL_4052017 \"choroid plexus capillary endothelial cell\")\n34538:EquivalentClasses(obo:CL_4052017 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001886)))\n34539:SubClassOf(obo:CL_4052017 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34541:# Class: obo:CL_4052018 (fallopian tube epithelial cell)\n34543:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\n34544:AnnotationAssertion(terms:contributor obo:CL_4052018 <https://orcid.org/0009-0000-8480-9277>)\n34545:AnnotationAssertion(terms:date obo:CL_4052018 \"2024-10-01T12:09:12Z\"^^xsd:dateTime)\n34546:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasBroadSynonym obo:CL_4052018 \"oviduct epithelial cell\")\n34547:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasExactSynonym obo:CL_4052018 \"uterine tube epithelial cell\")\n34548:AnnotationAssertion(rdfs:label obo:CL_4052018 \"fallopian tube epithelial cell\")\n34549:EquivalentClasses(obo:CL_4052018 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34551:# Class: obo:CL_4052019 (fallopian tube non-ciliated epithelial cell)\n34553:AnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\n34554:AnnotationAssertion(terms:contributor obo:CL_4052019 <https://orcid.org/0009-0000-8480-9277>)\n34555:AnnotationAssertion(terms:date obo:CL_4052019 \"2024-10-01T12:12:12Z\"^^xsd:dateTime)\n34556:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052019 \"fallopian tube non-ciliated cell\")\n34557:AnnotationAssertion(rdfs:label obo:CL_4052019 \"fallopian tube non-ciliated epithelial cell\")\n34558:SubClassOf(obo:CL_4052019 obo:CL_0000066)\n34559:SubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n34560:SubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:CL_4030045 obo:GO_0005929))\n34562:# Class: obo:CL_4052020 (lung resident granzyme K-associated CD8 T cell)\n34564:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") obo:IAO_0000115 obo:CL_4052020 \"A granzyme K-associated CD8 T cell that resides in the lung, characterized by the expression of granzyme K (GZMK), and tissue residency markers CD103 and CD49a. This cell exhibits cytotoxic potential through its expression of multiple granzymes (GZMA, GZMB, GZMH, GZMM) in addition to GZMK.\")\n34565:AnnotationAssertion(terms:contributor obo:CL_4052020 <https://orcid.org/0000-0002-2336-2552>)\n34566:AnnotationAssertion(terms:contributor obo:CL_4052020 <https://orcid.org/0009-0000-8480-9277>)\n34567:AnnotationAssertion(terms:date obo:CL_4052020 \"2024-10-14T15:42:41Z\"^^xsd:dateTime)\n34568:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052020 \"lung resident CD8-GZMK\")\n34569:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28322863\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") rdfs:comment obo:CL_4052020 \"Lung resident granzyme K-associated CD8 T cell represents an intermediate stage of T cell differentiation, with GZMK expression peaking during this phase.\")\n34570:AnnotationAssertion(rdfs:label obo:CL_4052020 \"lung resident granzyme K-associated CD8 T cell\")\n34571:EquivalentClasses(obo:CL_4052020 ObjectIntersectionOf(obo:CL_4033040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34573:# Class: obo:CL_4052021 (granzyme K-associated CD8 T cell)\n34575:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasDbXref \"PMID:37449888\") obo:IAO_0000115 obo:CL_4052021 \"A CD8 T cell characterized by high expression of Granzyme K (GZMK). This cell is enriched in both inflamed tissues, such as synovial tissue in rheumatoid arthritis and respiratory tissues during COVID-19, as well as non-inflamed tissues like the gut and kidneys. Unlike highly cytotoxic GZMB+ CD8+ T cell, GZMK+ CD8+ T cell exhibits lower direct cytotoxic potential, and is involved in producing pro-inflammatory cytokines such as IFN-γ and TNF-α.\")\n34576:AnnotationAssertion(terms:contributor obo:CL_4052021 <https://orcid.org/0009-0000-8480-9277>)\n34577:AnnotationAssertion(terms:date obo:CL_4052021 \"2024-10-18T09:51:48Z\"^^xsd:dateTime)\n34578:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"granzyme K+ CD8 T cell\")\n34579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"tissue-enriched expressing GzmK CD8 cell\")\n34580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36347862\") oboInOwl:hasNarrowSynonym obo:CL_4052021 \"GZMK high CD8+ T effector memory cell\")\n34581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"CD8-GZMK cell\")\n34582:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"TteK CD8 cell\")\n34583:AnnotationAssertion(rdfs:label obo:CL_4052021 \"granzyme K-associated CD8 T cell\")\n34584:EquivalentClasses(obo:CL_4052021 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34586:# Class: obo:CL_4052022 (fallopian tube smooth muscle cell)\n34588:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31183831\") Annotation(oboInOwl:hasDbXref \"PMID:31613440\") obo:IAO_0000115 obo:CL_4052022 \"A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.\")\n34589:AnnotationAssertion(terms:contributor obo:CL_4052022 <https://orcid.org/0009-0000-8480-9277>)\n34590:AnnotationAssertion(terms:date obo:CL_4052022 \"2024-10-21T12:16:54Z\"^^xsd:dateTime)\n34591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasBroadSynonym obo:CL_4052022 \"oviduct smooth muscle cell\")\n34592:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasExactSynonym obo:CL_4052022 \"uterine tube smooth muscle cell\")\n34593:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18621753\") rdfs:comment obo:CL_4052022 \"The fallopian tube smooth muscle cell in the human contracts dynamically in response to hormones and signaling molecules. Prostaglandins, particularly PGF2α and PGE2, have been shown to increase muscular contractions, while progesterone, levonorgestrel, mifepristone, oxytocin, and human chorionic gonadotropin (hCG) decrease them. These contractile responses are crucial for regulating gamete and embryo transport through the fallopian tube.\")\n34594:AnnotationAssertion(rdfs:label obo:CL_4052022 \"fallopian tube smooth muscle cell\")\n34595:EquivalentClasses(obo:CL_4052022 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34597:# Class: obo:CL_4052023 (luminal endometrial unciliated epithelial cell)\n34599:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32929266\") Annotation(oboInOwl:hasDbXref \"PMID:36581776\") Annotation(oboInOwl:hasDbXref \"PMID:38559249\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052023 \"An epithelial cell that is part of the endometrial luminal epithelium, forming a continuous layer lining the uterine cavity. This cell undergoes cyclical changes during the menstrual cycle, proliferating under estrogen in the proliferative phase, and differentiating under progesterone in the secretory phase to prepare for potential implantation. During the window of implantation, this cell changes from a tall columnar shape to a shorter columnar or cuboidal form, loses polarity, and becomes receptive to blastocyst implantation.\")\n34600:AnnotationAssertion(terms:contributor obo:CL_4052023 <https://orcid.org/0009-0000-8480-9277>)\n34601:AnnotationAssertion(terms:date obo:CL_4052023 \"2024-10-22T12:02:23Z\"^^xsd:dateTime)\n34602:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") rdfs:comment obo:CL_4052023 \"The luminal endometrial unciliated epithelial cell expresses WNT7A, and LGR5 during the proliferative phase, transitioning to express VTCN1 and SULT1E1 in the early secretory phase, and LEFTY1, IL6, and PTGS1 in the mid- to late-secretory phases.\")\n34603:AnnotationAssertion(rdfs:label obo:CL_4052023 \"luminal endometrial unciliated epithelial cell\")\n34604:EquivalentClasses(obo:CL_4052023 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032940)))\n34606:# Class: obo:CL_4052024 (myotendinous junction nucleus)\n34608:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasDbXref \"PMID:38398025\") obo:IAO_0000115 obo:CL_4052024 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.\")\n34609:AnnotationAssertion(terms:contributor obo:CL_4052024 <https://orcid.org/0009-0000-8480-9277>)\n34610:AnnotationAssertion(terms:contributor obo:CL_4052024 <https://orcid.org/0009-0001-6947-615X>)\n34611:AnnotationAssertion(terms:date obo:CL_4052024 \"2024-10-30T13:47:39Z\"^^xsd:dateTime)\n34612:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction myonuclei\")\n34613:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction nuclei\")\n34614:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052024 \"MTJ nucleus\")\n34615:AnnotationAssertion(rdfs:label obo:CL_4052024 \"myotendinous junction nucleus\")\n34616:EquivalentClasses(obo:CL_4052024 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:BFO_0000050 obo:CL_0008046) ObjectSomeValuesFrom(obo:RO_0002131 obo:GO_0005927)))\n34618:# Class: obo:CL_4052025 (neuromuscular junction nucleus)\n34620:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33037211\") Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") obo:IAO_0000115 obo:CL_4052025 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.\")\n34621:AnnotationAssertion(terms:contributor obo:CL_4052025 <https://orcid.org/0009-0000-8480-9277>)\n34622:AnnotationAssertion(terms:contributor obo:CL_4052025 <https://orcid.org/0009-0001-6947-615X>)\n34623:AnnotationAssertion(terms:date obo:CL_4052025 \"2024-10-31T11:09:04Z\"^^xsd:dateTime)\n34624:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction myonuclei\")\n34625:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction nuclei\")\n34626:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052025 \"NMJ nuclues\")\n34627:AnnotationAssertion(rdfs:label obo:CL_4052025 \"neuromuscular junction nucleus\")\n34628:EquivalentClasses(obo:CL_4052025 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:BFO_0000050 obo:CL_0008046) ObjectSomeValuesFrom(obo:RO_0002131 obo:GO_0098522)))\n34630:# Class: obo:CL_4052026 (type IIx muscle cell)\n34632:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") Annotation(oboInOwl:hasDbXref \"PMID:35908794\") Annotation(oboInOwl:hasDbXref \"PMID:36361732\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") obo:IAO_0000115 obo:CL_4052026 \"A fast type II muscle cell that is part of the skeletal muscle tissue. This cell is characterized by its intermediate metabolic profile, utilizing both glycolytic and oxidative pathways for energy production. In humans, it is distinguished by the expression of myosin heavy chain 1 (MYH1).\")\n34633:AnnotationAssertion(terms:contributor obo:CL_4052026 <https://orcid.org/0009-0000-8480-9277>)\n34634:AnnotationAssertion(terms:date obo:CL_4052026 \"2024-11-04T10:26:29Z\"^^xsd:dateTime)\n34635:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x fiber\")\n34636:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle cell\")\n34637:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle fiber\")\n34638:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type IIx muscle fiber\")\n34639:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199166\") Annotation(oboInOwl:hasDbXref \"PMID:34727990\") rdfs:comment obo:CL_4052026 \"In humans, type IIx fiber contains high levels of MYLK2, enhancing contraction speed and force via myosin phosphorylation, especially under low calcium. This mechanism supports post-activation potentiation, increasing force output in fast-twitch muscles. Additionally, this fiber has abundant ACTN3 (α-actinin-3), linked to muscle power, and exhibits the highest shortening velocity among human muscle fiber types. Notably, type IIx fiber is selectively lost in aging-related sarcopenia, increases in proportion in type 2 diabetes and obesity, and is the first to degenerate in Duchenne Muscular Dystrophy, impacting muscle function across various conditions.\")\n34640:AnnotationAssertion(rdfs:label obo:CL_4052026 \"type IIx muscle cell\")\n34641:SubClassOf(obo:CL_4052026 obo:CL_0002212)\n34642:SubClassOf(obo:CL_4052026 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001134))\n34644:# Class: obo:CL_4052027 (atretic theca cell)\n34646:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4052027 \"A theca cell undergoing atresia, characterized by distinct morphological changes including hypertrophy, altered cell shape, and disrupted layered organization. This cell exhibits reduced steroidogenic capacity and changes in surrounding vascularization. The onset of theca cell atresia can vary, occurring at different stages of follicle atresia depending on the phase of folliculogenesis.\")\n34647:AnnotationAssertion(terms:contributor obo:CL_4052027 <https://orcid.org/0009-0000-8480-9277>)\n34648:AnnotationAssertion(terms:date obo:CL_4052027 \"2024-11-06T10:10:51Z\"^^xsd:dateTime)\n34649:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") rdfs:comment obo:CL_4052027 \"During atresia, theca interna and externa cells undergo distinct morphological and functional changes. Theca interna cells round up, expand in cytoplasmic area, and thicken the internal layer as organization degrades, while showing reduced STAR expression, which lowers androgen production. Theca externa cells display decreased ACTA2 expression, weakening structural integrity.\")\n34650:AnnotationAssertion(rdfs:label obo:CL_4052027 \"atretic theca cell\")\n34651:SubClassOf(obo:CL_4052027 obo:CL_4033089)\n34652:SubClassOf(obo:CL_4052027 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000503))\n34654:# Class: obo:CL_4052028 (uterine natural killer cell)\n34656:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Uterine_natural_killer_cells\") obo:IAO_0000115 obo:CL_4052028 \"A natural killer cell that is part of the uterus, specifically within the endometrium during the non-pregnant state and in the decidua during pregnancy. This cell exhibits dynamic changes in frequency throughout the menstrual cycle, with lower levels during menstruation and a significant increase during the mid-secretory phase and early pregnancy.\")\n34657:AnnotationAssertion(terms:contributor obo:CL_4052028 <https://orcid.org/0009-0000-8480-9277>)\n34658:AnnotationAssertion(terms:date obo:CL_4052028 \"2024-11-15T10:12:40Z\"^^xsd:dateTime)\n34659:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") oboInOwl:hasNarrowSynonym obo:CL_4052028 \"endometrial natural killer cell\")\n34660:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052028 \"uNK cell\")\n34661:AnnotationAssertion(rdfs:label obo:CL_4052028 \"uterine natural killer cell\")\n34662:EquivalentClasses(obo:CL_4052028 ObjectIntersectionOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n34664:# Class: obo:CL_4052029 (subpleural fibroblast)\n34666:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\n34667:AnnotationAssertion(terms:contributor obo:CL_4052029 <https://orcid.org/0009-0000-8480-9277>)\n34668:AnnotationAssertion(terms:date obo:CL_4052029 \"2024-11-29T13:54:15Z\"^^xsd:dateTime)\n34669:AnnotationAssertion(rdfs:label obo:CL_4052029 \"subpleural fibroblast\")\n34670:SubClassOf(obo:CL_4052029 obo:CL_0000057)\n34671:SubClassOf(obo:CL_4052029 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048))\n34673:# Class: obo:CL_4052030 (adventitial fibroblast)\n34675:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\n34676:AnnotationAssertion(terms:contributor obo:CL_4052030 <https://orcid.org/0009-0000-8480-9277>)\n34677:AnnotationAssertion(terms:date obo:CL_4052030 \"2024-12-05T11:01:15Z\"^^xsd:dateTime)\n34678:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\n34679:AnnotationAssertion(rdfs:label obo:CL_4052030 \"adventitial fibroblast\")\n34680:EquivalentClasses(obo:CL_4052030 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005734)))\n34681:SubClassOf(obo:CL_4052030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816))\n34682:SubClassOf(obo:CL_4052030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n34684:# Class: obo:CL_4052031 (respiratory airway secretory cell)\n34686:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") obo:IAO_0000115 obo:CL_4052031 \"A secretory epithelial cell of the respiratory and terminal bronchioles.\")\n34687:AnnotationAssertion(terms:contributor obo:CL_4052031 <https://orcid.org/0009-0000-8480-9277>)\n34688:AnnotationAssertion(terms:date obo:CL_4052031 \"2024-11-29T16:14:31Z\"^^xsd:dateTime)\n34689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36796082\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052031 \"RAS cell\")\n34690:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355018\") oboInOwl:hasRelatedSynonym obo:CL_4052031 \"terminal and respiratory bronchioles secretory cell\")\n34691:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") rdfs:comment obo:CL_4052031 \"The respiratory airway secretory cell is cuboidal and has a unique transcriptomic profile compared to other epithelial cells in the same region. In humans, it functions as a multipotent progenitor, capable of regenerating alveolar type 2 (AT2) cells.\")\n34692:AnnotationAssertion(rdfs:label obo:CL_4052031 \"respiratory airway secretory cell\")\n34693:SubClassOf(obo:CL_4052031 obo:CL_1100001)\n34694:SubClassOf(obo:CL_4052031 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002051))\n34696:# Class: obo:CL_4052032 (granzyme H-associated CD8 T cell)\n34698:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") obo:IAO_0000115 obo:CL_4052032 \"A CD8 T cell characterized by high expression of Granzyme H (GZMH). This cell exhibits a restricted TCR repertoire and elevated expression of cytotoxic, exhaustion, and type I interferon-stimulated gene signatures compared to controls.\")\n34699:AnnotationAssertion(terms:contributor obo:CL_4052032 <https://orcid.org/0000-0002-3958-7465>)\n34700:AnnotationAssertion(terms:contributor obo:CL_4052032 <https://orcid.org/0009-0000-8480-9277>)\n34701:AnnotationAssertion(terms:date obo:CL_4052032 \"2025-01-10T10:14:31Z\"^^xsd:dateTime)\n34702:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") oboInOwl:hasExactSynonym obo:CL_4052032 \"granzyme H+ CD8 T cell\")\n34703:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052032 \"GZMH+ CD8+ T cell\")\n34704:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") rdfs:comment obo:CL_4052032 \"This cell type is significantly expanded in systemic lupus erythematosus (SLE) patients. Unlike other CD8 T cell populations, GZMH+ CD8 T cells can comprise up to 50% of all lymphocytes in some SLE patients.\")\n34705:AnnotationAssertion(rdfs:label obo:CL_4052032 \"granzyme H-associated CD8 T cell\")\n34706:EquivalentClasses(obo:CL_4052032 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003490)))\n34708:# Class: obo:CL_4052033 (biliary tuft cell)\n34710:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") Annotation(oboInOwl:hasDbXref \"PMID:37863104\") obo:IAO_0000115 obo:CL_4052033 \"A tuft cell that is part of the extrahepatic biliary tree, including the gallbladder and extrahepatic bile ducts. It shares a core genetic program with intestinal tuft cells but has unique tissue-specific genes. Biliary tuft cell functions as a bile acid-sensitive regulator, suppressing inflammation and modulating microbiome-dependent neutrophil infiltration in biliary tissues. Unlike its intestinal counterparts, this cell decreases in number postnatally as bile acid production matures, with its abundance negatively regulated by bile acids.\")\n34711:AnnotationAssertion(terms:contributor obo:CL_4052033 <https://orcid.org/0009-0000-8480-9277>)\n34712:AnnotationAssertion(terms:date obo:CL_4052033 \"2025-01-20T14:39:06Z\"^^xsd:dateTime)\n34713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") oboInOwl:hasExactSynonym obo:CL_4052033 \"gallbladder/extrahepatic bile duct tuft cell\")\n34714:AnnotationAssertion(rdfs:label obo:CL_4052033 \"biliary tuft cell\")\n34715:SubClassOf(obo:CL_4052033 obo:CL_0002204)\n34716:SubClassOf(obo:CL_4052033 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050728))\n34718:# Class: obo:CL_4052034 (tuft cell of thymus)\n34720:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:35668088\") Annotation(oboInOwl:hasDbXref \"PMID:36351364\") Annotation(oboInOwl:hasDbXref \"PMID:36961668\") obo:IAO_0000115 obo:CL_4052034 \"A tuft cell that is part of the medullary epithelium of the thymus, characterized by lateral microvilli and specific markers, including L1CAM in both mice (Zhang et al., 2022) and humans (Sun et al., 2023), as well as MHC II in mice (Miller et al., 2018). This cell is pivotal in immune functions such as antigen presentation, central tolerance, and type 2 immunity. A tuft cell in the thymus exhibits characteristics of both a medullary thymic epithelial cell (mTEC) and a peripheral tuft cell. Its development is governed by transcription factors such as POU2F3.\")\n34721:AnnotationAssertion(terms:contributor obo:CL_4052034 <https://orcid.org/0009-0000-8480-9277>)\n34722:AnnotationAssertion(terms:date obo:CL_4052034 \"2025-01-16T11:29:54Z\"^^xsd:dateTime)\n34723:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") oboInOwl:hasExactSynonym obo:CL_4052034 \"thymic tuft cell\")\n34724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") rdfs:comment obo:CL_4052034 \"A thymic tuft cell is a subset of terminally differentiated medullary thymic epithelial cell comprising 5-10% of total mTECs. Lineage-tracing studies indicate that this cell arises from mature MHCII mTECs, with development occurring through both Aire-dependent and Aire-independent pathways. However, its exact origins remain unclear.\")\n34725:AnnotationAssertion(rdfs:label obo:CL_4052034 \"tuft cell of thymus\")\n34726:EquivalentClasses(obo:CL_4052034 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003846)))\n34727:SubClassOf(obo:CL_4052034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002124))\n34728:SubClassOf(obo:CL_4052034 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002491))\n34730:# Class: obo:CL_4052035 (tuft cell of pancreatic duct)\n34732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:32717220\") obo:IAO_0000115 obo:CL_4052035 \"A tuft cell that is part of the epithelium of pancreatic duct. Present in humans and rats, this cell is absent in the murine pancreas under normal conditions but emerges during acinar-to-ductal metaplasia triggered by injury, inflammation, or oncogenic mutations. It modulates the immune response and protects against pancreatic ductal adenocarcinoma progression by producing suppressive eicosanoids, such as prostaglandin D2. A tuft cell in the pancreatic duct highly expresses the transcription factor POU2F3, which is essential for its development and presence.\")\n34733:AnnotationAssertion(terms:contributor obo:CL_4052035 <https://orcid.org/0009-0000-8480-9277>)\n34734:AnnotationAssertion(terms:date obo:CL_4052035 \"2025-01-16T11:50:08Z\"^^xsd:dateTime)\n34735:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9749964\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic brush cell\")\n34736:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32717220\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic tuft cell\")\n34737:AnnotationAssertion(rdfs:label obo:CL_4052035 \"tuft cell of pancreatic duct\")\n34738:EquivalentClasses(obo:CL_4052035 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009970)))\n34740:# Class: obo:CL_4052036 (tuft cell of nasal cavity)\n34742:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052036 \"A tuft cell that is part of the nasal cavity epithelium, located in both the respiratory and olfactory epithelia of the nose. This cell plays key roles in chemosensation, lipid mediator production, immune responses, and epithelial homeostasis.\")\n34743:AnnotationAssertion(terms:contributor obo:CL_4052036 <https://orcid.org/0009-0000-8480-9277>)\n34744:AnnotationAssertion(terms:date obo:CL_4052036 \"2025-01-21T09:04:03Z\"^^xsd:dateTime)\n34745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34692913\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal brush cell\")\n34746:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal tuft cell\")\n34747:AnnotationAssertion(rdfs:label obo:CL_4052036 \"tuft cell of nasal cavity\")\n34748:EquivalentClasses(obo:CL_4052036 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005384)))\n34750:# Class: obo:CL_4052037 (tuft cell of olfactory epithelium)\n34752:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") obo:IAO_0000115 obo:CL_4052037 \"A tuft cell that is part of the olfactory epithelium, characterized by a globular body and the expression of neurogranin (Nrgn) in mice. This cell plays a crucial role in allergen recognition and regulating olfactory stem cell proliferation via TRPM5-dependent ATP sensing and cysteinyl leukotriene production. Unlike nasal respiratory tuft cells, it has low to absent expression of taste receptors, including the G protein Gα gustducin, and rarely contacts olfactory sensory neurons directly.\")\n34753:AnnotationAssertion(terms:contributor obo:CL_4052037 <https://orcid.org/0009-0000-8480-9277>)\n34754:AnnotationAssertion(terms:date obo:CL_4052037 \"2025-02-06T15:03:53Z\"^^xsd:dateTime)\n34755:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052037 \"olfactory tuft cell\")\n34756:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TPRM5+ tuft-MVC\")\n34757:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous cell\")\n34758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous tuft cell\")\n34759:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"tuft-microvillous cell\")\n34760:AnnotationAssertion(rdfs:label obo:CL_4052037 \"tuft cell of olfactory epithelium\")\n34761:EquivalentClasses(obo:CL_4052037 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001997)))\n34762:SubClassOf(obo:CL_4052037 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0072091))\n34764:# Class: obo:CL_4052038 (tuft cell of nasal cavity respiratory epithelium)\n34766:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n34767:AnnotationAssertion(terms:contributor obo:CL_4052038 <https://orcid.org/0009-0000-8480-9277>)\n34768:AnnotationAssertion(terms:date obo:CL_4052038 \"2025-02-06T15:28:14Z\"^^xsd:dateTime)\n34769:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"Gɑ-gustducin high respiratory tuft cell\")\n34770:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"nasal respiratory solitary chemosensory cell\")\n34771:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"tuft-solitary chemosensory cell\")\n34772:AnnotationAssertion(rdfs:label obo:CL_4052038 \"tuft cell of nasal cavity respiratory epithelium\")\n34773:EquivalentClasses(obo:CL_4052038 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005385)))\n34775:# Class: obo:CL_4052039 (tuft cell of submandibular gland)\n34777:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\n34778:AnnotationAssertion(terms:contributor obo:CL_4052039 <https://orcid.org/0009-0000-8480-9277>)\n34779:AnnotationAssertion(terms:date obo:CL_4052039 \"2025-02-12T10:38:11Z\"^^xsd:dateTime)\n34780:AnnotationAssertion(rdfs:label obo:CL_4052039 \"tuft cell of submandibular gland\")\n34781:EquivalentClasses(obo:CL_4052039 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003359)))\n34783:# Class: obo:CL_4052040 (tuft cell of stomach)\n34785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:38117182\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.02.16.480779\") obo:IAO_0000115 obo:CL_4052040 \"A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.\")\n34786:AnnotationAssertion(terms:contributor obo:CL_4052040 <https://orcid.org/0009-0000-8480-9277>)\n34787:AnnotationAssertion(terms:date obo:CL_4052040 \"2025-02-12T11:24:56Z\"^^xsd:dateTime)\n34788:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38117182\") oboInOwl:hasExactSynonym obo:CL_4052040 \"gastric tuft cell\")\n34789:AnnotationAssertion(rdfs:label obo:CL_4052040 \"tuft cell of stomach\")\n34790:EquivalentClasses(obo:CL_4052040 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001276)))\n34792:# Class: obo:CL_4052041 (tuft cell of auditory tube)\n34794:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\n34795:AnnotationAssertion(terms:contributor obo:CL_4052041 <https://orcid.org/0009-0000-8480-9277>)\n34796:AnnotationAssertion(terms:date obo:CL_4052041 \"2025-02-12T12:00:10Z\"^^xsd:dateTime)\n34797:AnnotationAssertion(rdfs:label obo:CL_4052041 \"tuft cell of auditory tube\")\n34798:EquivalentClasses(obo:CL_4052041 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010062)))\n34799:SubClassOf(obo:CL_4052041 obo:CL_0002491)\n34801:# Class: obo:CL_4052042 (tuft cell of urethra)\n34803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\n34804:AnnotationAssertion(terms:contributor obo:CL_4052042 <https://orcid.org/0009-0000-8480-9277>)\n34805:AnnotationAssertion(terms:date obo:CL_4052042 \"2025-02-12T14:39:03Z\"^^xsd:dateTime)\n34806:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral brush cell\")\n34807:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral cholinergic chemosensory cell\")\n34808:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\n34809:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\n34810:AnnotationAssertion(rdfs:label obo:CL_4052042 \"tuft cell of urethra\")\n34811:EquivalentClasses(obo:CL_4052042 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002325)))\n34812:SubClassOf(obo:CL_4052042 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0060083))\n34814:# Class: obo:CL_4052045 (steroidogenic stromal cell of ovary)\n34816:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\n34817:AnnotationAssertion(terms:contributor obo:CL_4052045 <https://orcid.org/0009-0000-8480-9277>)\n34818:AnnotationAssertion(terms:date obo:CL_4052045 \"2025-03-05T13:37:44Z\"^^xsd:dateTime)\n34819:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic interstitial stromal cell\")\n34820:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic stromal cell\")\n34821:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasRelatedSynonym obo:CL_4052045 \"Enpp2− interstitial cell\")\n34822:AnnotationAssertion(rdfs:label obo:CL_4052045 \"steroidogenic stromal cell of ovary\")\n34823:EquivalentClasses(obo:CL_4052045 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006960) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0120178)))\n34825:# Class: obo:CL_4052046 (early luteal cell)\n34827:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052046 \"A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.\")\n34828:AnnotationAssertion(terms:contributor obo:CL_4052046 <https://orcid.org/0009-0000-8480-9277>)\n34829:AnnotationAssertion(terms:date obo:CL_4052046 \"2025-03-05T16:40:18Z\"^^xsd:dateTime)\n34830:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052046 \"active corpus luteum cell\")\n34831:AnnotationAssertion(rdfs:label obo:CL_4052046 \"early luteal cell\")\n34832:SubClassOf(obo:CL_4052046 obo:CL_0000175)\n34833:SubClassOf(obo:CL_4052046 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006701))\n34835:# Class: obo:CL_4052047 (late luteal cell)\n34837:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31803139\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052047 \"A luteal cell that is part of the older, regressing corpus luteum. This cell exhibits increased expression of genes involved in progesterone metabolism - Akr1c18 in mice (Lan et al., 2024), cell cycle arrest, and apoptosis. A late luteal cell contributes to corpus luteum regression and eventual clearance from the ovary through luteolysis.\")\n34838:AnnotationAssertion(terms:contributor obo:CL_4052047 <https://orcid.org/0009-0000-8480-9277>)\n34839:AnnotationAssertion(terms:date obo:CL_4052047 \"2025-03-05T16:47:20Z\"^^xsd:dateTime)\n34840:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052047 \"regressing corpus luteum cell\")\n34841:AnnotationAssertion(rdfs:label obo:CL_4052047 \"late luteal cell\")\n34842:SubClassOf(obo:CL_4052047 obo:CL_0000175)\n34843:SubClassOf(obo:CL_4052047 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006709))\n34845:# Class: obo:CL_4052048 (intercalated cell of salivary gland)\n34847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n34848:AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0000-0003-4389-9821>)\n34849:AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0009-0000-8480-9277>)\n34850:AnnotationAssertion(terms:date obo:CL_4052048 \"2024-09-11T09:55:55Z\"^^xsd:dateTime)\n34851:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasBroadSynonym obo:CL_4052048 \"intercalated duct cell\")\n34852:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\n34853:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35799078\") oboInOwl:hasRelatedSynonym obo:CL_4052048 \"Id cell\")\n34854:AnnotationAssertion(rdfs:label obo:CL_4052048 \"intercalated cell of salivary gland\")\n34855:SubClassOf(obo:CL_4052048 obo:CL_1001596)\n34856:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014727))\n34857:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34859:# Class: obo:CL_4052049 (striated cell of salivary gland)\n34861:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n34862:AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0000-0003-4389-9821>)\n34863:AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0009-0000-8480-9277>)\n34864:AnnotationAssertion(terms:date obo:CL_4052049 \"2024-09-11T10:00:25Z\"^^xsd:dateTime)\n34865:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"SD cells\")\n34866:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\n34867:AnnotationAssertion(rdfs:label obo:CL_4052049 \"striated cell of salivary gland\")\n34868:EquivalentClasses(obo:CL_4052049 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014729)))\n34869:SubClassOf(obo:CL_4052049 obo:CL_1001596)\n34870:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34871:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0036376))\n34872:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990573))\n34874:# Class: obo:CL_4052050 (luminal epithelial cell of endometrium)\n34876:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36273006\") obo:IAO_0000115 obo:CL_4052050 \"An epithelial cell that is part of an endometrium luminal epithelium.\")\n34877:AnnotationAssertion(terms:contributor obo:CL_4052050 <https://orcid.org/0009-0000-8480-9277>)\n34878:AnnotationAssertion(terms:date obo:CL_4052050 \"2025-03-13T13:46:13Z\"^^xsd:dateTime)\n34879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31317179\") oboInOwl:hasExactSynonym obo:CL_4052050 \"endometrial luminal epithelial cell\")\n34880:AnnotationAssertion(rdfs:label obo:CL_4052050 \"luminal epithelial cell of endometrium\")\n34881:EquivalentClasses(obo:CL_4052050 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949)))\n34883:# Class: obo:CL_4052051 (uterine natural killer cell 1, human)\n34885:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34512661\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052051 \"​​A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018). It expresses the uterine resident marker CD49a and is distinguished from uNK2 and uNK3 by CD39 expression and the absence of CD103 (Whettlock et al., 2022) and CD160 (Marečková et al., 2024). It also expresses higher levels of killer-cell immunoglobulin-like receptors (KIRs) and leukocyte immunoglobulin-like receptor B1 (LILRB1), which facilitate interaction with human leukocyte antigens (HLAs) on extravillous trophoblast cells, promoting immune tolerance and implantation. Enriched in the endometrium post-ovulation (Marečková et al., 2024) and prominent in early pregnancy (Whettlock et al., 2022), uNK1 regulates trophoblast invasion and spiral artery remodeling (Zhang & Wei, 2021).\")\n34886:AnnotationAssertion(terms:contributor obo:CL_4052051 <https://orcid.org/0009-0000-8480-9277>)\n34887:AnnotationAssertion(terms:date obo:CL_4052051 \"2025-03-14T10:48:38Z\"^^xsd:dateTime)\n34888:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052051 \"decidual natural killer cell 1\")\n34889:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052051 \"uNK1\")\n34890:AnnotationAssertion(rdfs:label obo:CL_4052051 \"uterine natural killer cell 1, human\")\n34891:EquivalentClasses(obo:CL_4052051 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34893:# Class: obo:CL_4052052 (uterine natural killer cell 2, human)\n34895:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\n34896:AnnotationAssertion(terms:contributor obo:CL_4052052 <https://orcid.org/0009-0000-8480-9277>)\n34897:AnnotationAssertion(terms:date obo:CL_4052052 \"2025-03-14T14:31:03Z\"^^xsd:dateTime)\n34898:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\n34899:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\n34900:AnnotationAssertion(rdfs:label obo:CL_4052052 \"uterine natural killer cell 2, human\")\n34901:EquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34903:# Class: obo:CL_4052053 (uterine natural killer cell 3, human)\n34905:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\n34906:AnnotationAssertion(terms:contributor obo:CL_4052053 <https://orcid.org/0009-0000-8480-9277>)\n34907:AnnotationAssertion(terms:date obo:CL_4052053 \"2025-03-14T16:15:39Z\"^^xsd:dateTime)\n34908:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\n34909:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\n34910:AnnotationAssertion(rdfs:label obo:CL_4052053 \"uterine natural killer cell 3, human\")\n34911:EquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34913:# Class: obo:CL_4052055 (mature NK T cell, human)\n34915:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\n34916:AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0000-0001-5742-4697>)\n34917:AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0009-0000-8480-9277>)\n34918:AnnotationAssertion(terms:date obo:CL_4052055 \"2025-03-26T11:56:38Z\"^^xsd:dateTime)\n34919:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\n34920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\n34921:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\n34922:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NKT cell, human\")\n34923:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T cell, human\")\n34924:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T lymphocyte, human\")\n34925:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T-lymphocyte, human\")\n34926:AnnotationAssertion(rdfs:label obo:CL_4052055 \"mature NK T cell, human\")\n34927:EquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34929:# Class: obo:CL_4052058 (Merkel cell of epidermis)\n34931:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_4052058 \"A Merkel cell found mainly in the basal layer of the epidermis and the outer root sheath of hair follicles, particularly concentrated in areas with high tactile acuity, such as touch domes, hair follicles, and fingertips.\")\n34932:AnnotationAssertion(terms:contributor obo:CL_4052058 <https://orcid.org/0009-0000-8480-9277>)\n34933:AnnotationAssertion(terms:date obo:CL_4052058 \"2025-06-11T10:01:40Z\"^^xsd:dateTime)\n34934:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6207057\") oboInOwl:hasExactSynonym obo:CL_4052058 \"epdiermal Merkel cell\")\n34935:AnnotationAssertion(rdfs:label obo:CL_4052058 \"Merkel cell of epidermis\")\n34936:EquivalentClasses(obo:CL_4052058 ObjectIntersectionOf(obo:CL_0000242 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34938:# Class: obo:CL_4052060 (spinous cell)\n34940:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34283481\") Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") obo:IAO_0000115 obo:CL_4052060 \"A differentiating keratinocyte found in the epidermis and oral epithelium, located in the stratum spinosum, characterized by a spiny appearance due to abundant intercellular desmosomal junctions.\")\n34941:AnnotationAssertion(terms:contributor obo:CL_4052060 <https://orcid.org/0009-0000-8480-9277>)\n34942:AnnotationAssertion(terms:date obo:CL_4052060 \"2025-07-02T12:21:06Z\"^^xsd:dateTime)\n34943:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_4052060 \"prickle cell\")\n34944:AnnotationAssertion(rdfs:label obo:CL_4052060 \"spinous cell\")\n34945:SubClassOf(obo:CL_4052060 obo:CL_0000312)\n34946:SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030057))\n34947:SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001365))\n34949:# Class: obo:CL_4052061 (epidermal keratinocyte)\n34951:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\n34952:AnnotationAssertion(terms:contributor obo:CL_4052061 <https://orcid.org/0009-0000-8480-9277>)\n34953:AnnotationAssertion(terms:date obo:CL_4052061 \"2025-07-02T12:32:13Z\"^^xsd:dateTime)\n34954:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052061 \"keratincyte of epidermis\")\n34955:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39185948\") oboInOwl:hasExactSynonym obo:CL_4052061 \"skin keratinocyte\")\n34956:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") rdfs:comment obo:CL_4052061 \"Keratinocytes are reportedly CDw210a(IL-10RA)-negative , CDw210b(IL-10RB)-positive, IL22Ra1-positive, Human keratinocytes are reportedly capable of secreting BD-2, BD-3, hCAP-18, CXCL1, CXCL5, CXCL8, elafin, MMP-3, NGAL, PDGF-A, S100A7, S100A8, and S100A9. Transcription factors: STAT3-positive.\")\n34957:AnnotationAssertion(rdfs:label obo:CL_4052061 \"epidermal keratinocyte\")\n34958:EquivalentClasses(obo:CL_4052061 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34959:SubClassOf(obo:CL_4052061 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0090023))\n34961:# Class: obo:CL_4052062 (onychofibroblast)\n34963:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\n34964:AnnotationAssertion(terms:contributor obo:CL_4052062 <https://orcid.org/0009-0000-8480-9277>)\n34965:AnnotationAssertion(terms:date obo:CL_4052062 \"2025-07-22T14:35:00Z\"^^xsd:dateTime)\n34966:AnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n34967:SubClassOf(obo:CL_4052062 obo:CL_0000057)\n34968:SubClassOf(obo:CL_4052062 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001705))\n34970:# Class: obo:CL_4052063 (nail bed keratinocyte)\n34972:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10651700\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:33799809\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052063 \"A keratinocyte that resides in the nail bed, responsible for tightly attaching the nail plate to the underlying dermis. Unlike typical epidermal keratinocytes, it exhibits limited proliferation, undergoes modified differentiation that skips the granular layer and conventional cornification, and primarily ensures adhesion and maintenance of the nail plate. In humans, this cell expresses characteristic markers, including the protease inhibitor SPINK6 and the differentiation-associated protein KRT16.\")\n34973:AnnotationAssertion(terms:contributor obo:CL_4052063 <https://orcid.org/0009-0000-8480-9277>)\n34974:AnnotationAssertion(terms:date obo:CL_4052063 \"2024-07-22T15:30:00Z\"^^xsd:dateTime)\n34975:AnnotationAssertion(rdfs:label obo:CL_4052063 \"nail bed keratinocyte\")\n34976:SubClassOf(obo:CL_4052063 obo:CL_0000312)\n34977:SubClassOf(obo:CL_4052063 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005273))\n34979:# Class: obo:CL_4052064 (nail matrix keratinocyte)\n34981:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\n34982:AnnotationAssertion(terms:contributor obo:CL_4052064 <https://orcid.org/0009-0000-8480-9277>)\n34983:AnnotationAssertion(terms:date obo:CL_4052064 \"2025-07-22T15:30:00Z\"^^xsd:dateTime)\n34984:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39044464\") oboInOwl:hasExactSynonym obo:CL_4052064 \"nail matrix epithelial keratinocyte\")\n34985:AnnotationAssertion(rdfs:label obo:CL_4052064 \"nail matrix keratinocyte\")\n34986:EquivalentClasses(obo:CL_4052064 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002283)))\n34988:# Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n34990:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n34991:AnnotationAssertion(terms:contributor obo:CL_4052065 <https://orcid.org/0009-0000-8480-9277>)\n34992:AnnotationAssertion(terms:date obo:CL_4052065 \"2025-08-05T15:24:46Z\"^^xsd:dateTime)\n34993:AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n34994:EquivalentClasses(obo:CL_4052065 ObjectIntersectionOf(obo:CL_0000313 obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013232)))\n34995:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0042588))\n34996:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0005983))\n34998:# Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n35000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n35001:AnnotationAssertion(terms:contributor obo:CL_4052066 <https://orcid.org/0009-0000-8480-9277>)\n35002:AnnotationAssertion(terms:date obo:CL_4052066 \"2025-08-05T15:33:46Z\"^^xsd:dateTime)\n35003:AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n35004:EquivalentClasses(obo:CL_4052066 ObjectIntersectionOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014717)))\n35005:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0098594))\n35006:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070254))\n35008:# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n35010:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n35011:AnnotationAssertion(terms:contributor obo:CL_4052067 <https://orcid.org/0009-0000-8480-9277>)\n35012:AnnotationAssertion(terms:date obo:CL_4052067 \"2025-08-06T11:26:37Z\"^^xsd:dateTime)\n35013:AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n35014:SubClassOf(obo:CL_4052067 obo:CL_0000159)\n35015:SubClassOf(obo:CL_4052067 obo:CL_0002623)\n35017:# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n35019:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n35020:AnnotationAssertion(terms:contributor obo:CL_4052069 <https://orcid.org/0009-0000-8480-9277>)\n35021:AnnotationAssertion(terms:date obo:CL_4052069 \"2025-08-08T11:20:00Z\"^^xsd:dateTime)\n35022:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n35023:AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n35024:SubClassOf(obo:CL_4052069 obo:CL_1001596)\n35025:SubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n35027:# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n35029:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n35030:AnnotationAssertion(terms:contributor obo:CL_4052070 <https://orcid.org/0009-0000-8480-9277>)\n35031:AnnotationAssertion(terms:date obo:CL_4052070 \"2025-08-12T16:05:47Z\"^^xsd:dateTime)\n35032:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_4052070 \"unclassified fallopian tube progenitor\")\n35033:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\n35034:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\n35035:AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n35036:SubClassOf(obo:CL_4052070 obo:CL_0011026)\n35037:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600124))\n35038:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35040:# Class: obo:CL_4052071 (quiescent fibroblast)\n35042:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\n35043:AnnotationAssertion(terms:contributor obo:CL_4052071 <https://orcid.org/0009-0000-8480-9277>)\n35044:AnnotationAssertion(terms:date obo:CL_4052071 \"2025-08-13T15:42:37Z\"^^xsd:dateTime)\n35045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\n35046:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\n35047:AnnotationAssertion(rdfs:label obo:CL_4052071 \"quiescent fibroblast\")\n35048:SubClassOf(obo:CL_4052071 obo:CL_0000057)\n35050:# Class: obo:CL_4052108 (IgD-negative class switched memory B cell)\n35052:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20839340\") Annotation(oboInOwl:hasDbXref \"PMID:32741082\") Annotation(oboInOwl:hasDbXref \"PMID:36617261\") Annotation(oboInOwl:hasDbXref \"PMID:37254600\") obo:IAO_0000115 obo:CL_4052108 \"A class switched memory B cell that lacks IgD on the cell surface.\")\n35053:AnnotationAssertion(terms:contributor obo:CL_4052108 <https://orcid.org/0009-0000-8480-9277>)\n35054:AnnotationAssertion(terms:date obo:CL_4052108 \"2025-12-08T10:33:49Z\"^^xsd:dateTime)\n35055:AnnotationAssertion(rdfs:label obo:CL_4052108 \"IgD-negative class switched memory B cell\")\n35056:EquivalentClasses(obo:CL_4052108 ObjectIntersectionOf(obo:CL_0000972 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738)))\n35058:# Class: obo:CL_4070010 (gastric mill neuron)\n35060:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070010 \"A motor neuron that moves the medial tooth forward\")\n35061:AnnotationAssertion(obo:RO_0002175 obo:CL_4070010 obo:NCBITaxon_6712)\n35062:AnnotationAssertion(obo:RO_0002175 obo:CL_4070010 obo:NCBITaxon_6752)\n35063:AnnotationAssertion(terms:contributor obo:CL_4070010 <https://orcid.org/0000-0002-1909-7004>)\n35064:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070010 \"GM\")\n35065:AnnotationAssertion(rdfs:label obo:CL_4070010 \"gastric mill neuron\")\n35066:SubClassOf(obo:CL_4070010 obo:CL_0000100)\n35067:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35068:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35070:# Class: obo:CL_4070011 (lateral gastric neuron)\n35072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070011 \"A motor neuron that closes the lateral teeth.\")\n35073:AnnotationAssertion(obo:RO_0002175 obo:CL_4070011 obo:NCBITaxon_6712)\n35074:AnnotationAssertion(obo:RO_0002175 obo:CL_4070011 obo:NCBITaxon_6752)\n35075:AnnotationAssertion(terms:contributor obo:CL_4070011 <https://orcid.org/0000-0002-1909-7004>)\n35076:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070011 \"LG\")\n35077:AnnotationAssertion(rdfs:label obo:CL_4070011 \"lateral gastric neuron\")\n35078:SubClassOf(obo:CL_4070011 obo:CL_0000100)\n35079:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35080:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35082:# Class: obo:CL_4070012 (inferior cardiac neuron)\n35084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070012 \"A motor neuron that controls ventral stomach grooves leading to pyloric filter.\")\n35085:AnnotationAssertion(obo:RO_0002175 obo:CL_4070012 obo:NCBITaxon_6712)\n35086:AnnotationAssertion(obo:RO_0002175 obo:CL_4070012 obo:NCBITaxon_6752)\n35087:AnnotationAssertion(terms:contributor obo:CL_4070012 <https://orcid.org/0000-0002-1909-7004>)\n35088:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070012 \"IC\")\n35089:AnnotationAssertion(rdfs:label obo:CL_4070012 \"inferior cardiac neuron\")\n35090:SubClassOf(obo:CL_4070012 obo:CL_0000100)\n35091:SubClassOf(obo:CL_4070012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35092:SubClassOf(obo:CL_4070012 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35094:# Class: obo:CL_4070013 (ventricular dilator motor neuron)\n35096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070013 \"A motor neuron that controls  ventral stomach grooves leading to pyloric filter.\")\n35097:AnnotationAssertion(obo:RO_0002175 obo:CL_4070013 obo:NCBITaxon_6712)\n35098:AnnotationAssertion(obo:RO_0002175 obo:CL_4070013 obo:NCBITaxon_6752)\n35099:AnnotationAssertion(terms:contributor obo:CL_4070013 <https://orcid.org/0000-0002-1909-7004>)\n35100:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070013 \"VD\")\n35101:AnnotationAssertion(rdfs:label obo:CL_4070013 \"ventricular dilator motor neuron\")\n35102:SubClassOf(obo:CL_4070013 obo:CL_0000100)\n35103:SubClassOf(obo:CL_4070013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35104:SubClassOf(obo:CL_4070013 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35106:# Class: obo:CL_4070014 (pyloric motor neuron)\n35108:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070014 \"A motor neuron that controls pyloric filter movements; innervates the pyloric muscle.\")\n35109:AnnotationAssertion(obo:RO_0002175 obo:CL_4070014 obo:NCBITaxon_6712)\n35110:AnnotationAssertion(obo:RO_0002175 obo:CL_4070014 obo:NCBITaxon_6752)\n35111:AnnotationAssertion(terms:contributor obo:CL_407