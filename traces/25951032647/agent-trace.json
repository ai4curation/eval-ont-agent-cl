{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"rg -n 'CL_0020040|CL_0020042|CL_4072103|CL_4072104|Declaration\\\\(Class\\\\(obo:CL_002004' src/ontology/cl-edit.owl\"","aggregated_output":"2299:Declaration(Class(obo:CL_0020040))\n2300:Declaration(Class(obo:CL_0020041))\n2301:Declaration(Class(obo:CL_0020042))\n3303:Declaration(Class(obo:CL_4072103))\n3304:Declaration(Class(obo:CL_4072104))\n25668:SubClassOf(obo:CL_0020018 obo:CL_4072104)\n25934:# Class: obo:CL_0020040 (calcified zone articular chondrocyte)\n25936:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18455690\") Annotation(oboInOwl:hasDbXref \"PMID:23015907\") Annotation(oboInOwl:hasDbXref \"PMID:41226342\") obo:IAO_0000115 obo:CL_0020040 \"An articular chondrocyte located in the calcified cartilage zone below the tidemark at the interface between articular cartilage and subchondral bone, embedded within a mineralized extracellular matrix. In humans, this cell exhibits a hypertrophic-like phenotype and typically expresses collagen type X (COL10A1). Together with the surrounding calcified matrix, it forms a transitional region that mechanically couples the deep articular cartilage to the underlying subchondral bone.\")\n25937:AnnotationAssertion(terms:contributor obo:CL_0020040 <https://orcid.org/0000-0003-0098-4399>)\n25938:AnnotationAssertion(terms:date obo:CL_0020040 \"2026-02-18T11:06:13Z\"^^xsd:dateTime)\n25939:AnnotationAssertion(rdfs:label obo:CL_0020040 \"calcified zone articular chondrocyte\")\n25940:SubClassOf(obo:CL_0020040 obo:CL_1001607)\n25941:SubClassOf(obo:CL_0020040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005693))\n25952:# Class: obo:CL_0020042 (oRGC5)\n25954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020042 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together OFF parasol RGCs from primate foveal and peripheral retina with their molecularly homologous mouse α RGC subtype (OFF-transient α RGC, C45) (Hahn et al., 2023; Tran et al., 2019). Reference to transcriptomic evidence can be found at: GSE237215.\")\n25955:AnnotationAssertion(terms:contributor obo:CL_0020042 <https://orcid.org/0000-0002-5507-2103>)\n25956:AnnotationAssertion(terms:date obo:CL_0020042 \"2025-12-08T11:46:13Z\"^^xsd:dateTime)\n25957:AnnotationAssertion(rdfs:label obo:CL_0020042 \"oRGC5\")\n25958:AnnotationAssertion(Annotation(rdfs:label \"reference transcriptomic data on GEO\") rdfs:seeAlso obo:CL_0020042 \"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE237215\")\n25959:SubClassOf(obo:CL_0020042 obo:CL_0000740)\n35649:# Class: obo:CL_4072103 (hair follicle dermal stem cell)\n35651:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasDbXref \"PMID:29691589\") Annotation(oboInOwl:hasDbXref \"PMID:35036581\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_4072103 \"A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle's mesenchymal compartments.\")\n35652:AnnotationAssertion(terms:contributor obo:CL_4072103 <https://orcid.org/0009-0000-8480-9277>)\n35653:AnnotationAssertion(oboInOwl:creation_date obo:CL_4072103 \"2025-11-05T11:49:53Z\"^^xsd:dateTime)\n35654:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38016881\") oboInOwl:hasNarrowSynonym obo:CL_4072103 \"dermal sheath cup cell\")\n35655:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072103 \"hfDSC\")\n35656:AnnotationAssertion(rdfs:label obo:CL_4072103 \"hair follicle dermal stem cell\")\n35657:EquivalentClasses(obo:CL_4072103 ObjectIntersectionOf(obo:CL_0000134 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\n35658:SubClassOf(obo:CL_4072103 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042634))\n35660:# Class: obo:CL_4072104 (fibrochondrocyte)\n35662:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35663:AnnotationAssertion(terms:contributor obo:CL_4072104 <https://orcid.org/0009-0000-8480-9277>)\n35664:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35665:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35666:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\n35667:AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n35668:EquivalentClasses(obo:CL_4072104 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0