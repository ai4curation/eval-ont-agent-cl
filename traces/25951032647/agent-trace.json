ref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\n35503:AnnotationAssertion(rdfs:label obo:CL_4072038 \"L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35504:SubClassOf(obo:CL_4072038 obo:CL_4030064)\n35505:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35506:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000068))\n35508:# Class: obo:CL_4072039 (L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35510:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072039 \"L4 IT (Homo sapiens)\")\n35511:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072039 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L4 IT.\")\n35512:AnnotationAssertion(obo:RO_0002175 obo:CL_4072039 obo:NCBITaxon_9606)\n35513:AnnotationAssertion(terms:date obo:CL_4072039 \"2025-09-10T10:05:26Z\"^^xsd:dateTime)\n35514:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072039 \"L4 IT (