197:AnnotationAssertion(rdfs:comment obo:CL_0000042 \"These cells are CD11b-negative, CD15-negative, CD16-negative, CD35-negative, CD49d-positive, CD68-positive, lactotransferrin-negative, and fMLP receptor-negative. They are found in the Band 3 fraction.\")\n4199:EquivalentClasses(obo:CL_0000042 ObjectIntersectionOf(obo:CL_0000835 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001944) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000005307) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007857) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000010799) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000014362) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030223)))\n4214:EquivalentClasses(obo:CL_0000043 ObjectIntersectionOf(obo:CL_0000767 ObjectSomeValuesFrom(obo:BFO_0000051 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001979))) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002349) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002351) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002830) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0008015) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032616) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032633) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0048295)))\n4260:EquivalentClasses(obo:CL_0000048 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001402) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145)))\n4293:EquivalentClasses(obo:CL_0000050 ObjectIntersectionOf(obo:CL_0002032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030218) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030219)))\n4313:EquivalentClasses(obo:CL_0000051 ObjectIntersectionOf(obo:CL_0002032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030098)))\n4370:AnnotationAssertion(rdfs:comment obo:CL_0000057 \"These cells may be vimentin-positive, fibronectin-positive, fsp1-positive, MMP-1-positive, collagen I-positive, collagen III-positive, and alpha-SMA-negative.\")\n4401:SubClassOf(obo:CL_0000059 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0097186))\n4562:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\n4593:EquivalentClasses(obo:CL_0000081 ObjectIntersectionOf(obo:CL_0000988 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0008015)))\n4628:EquivalentClasses(obo:CL_0000084 ObjectIntersectionOf(obo:CL_0000542 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002456)))\n4683:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D007728\") Annotation(oboInOwl:hasDbXref \"PMID:15771589\") Annotation(oboInOwl:hasDbXref \"PMID:17105582\") obo:IAO_0000115 obo:CL_0000091 \"A tissue-resident macrophage of the reticuloendothelial system found on the luminal surface of the hepatic sinusoids involved in erythrocyte clearance. Markers include F4/80+, CD11b-low, CD68-positive, sialoadhesin-positive, CD163/SRCR-positive. Irregular, with long processes including lamellipodia extending into the sinusoid lumen, have flattened nucleus with cytoplasm containing characteristic invaginations of the plasma membrane (vermiform bodies); lie within the sinusoid lumen attached to the endothelial surface; derived from the bone marrow, form a major part of the body's mononuclear phagocyte system.\")\n4692:AnnotationAssertion(rdfs:comment obo:CL_0000091 \"Markers: Mouse: F4/80+, CD11b-low, CD68+, sialoadhesin+, CD163/SRCR+; role or process: immune, antigen-presentation, clearance of senescent erythrocytes, iron metabolism. Kupffer cells are also reportedly C3aR-positive, CD14-low, CD54-positive, CD88-positive, and CD284-positive. They are also capable of producing IL-1, IL-6, TNF-alpha, nitric oxide, PGD2, PGE2, PGF2alpha, and TXA2.\")\n4694:EquivalentClasses(obo:CL_0000091 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001813) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001925) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002064) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0034102) ObjectSomeValuesFrom(obo:RO_0015016 obo:PR_000001012)))\n4707:EquivalentClasses(obo:CL_0000092 ObjectIntersectionOf(obo:CL_0000766 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001474) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001850) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001937) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001944) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007597) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000011178) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001954) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002062) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045453)))\n4731:EquivalentClasses(obo:CL_0000094 ObjectIntersectionOf(obo:CL_0000766 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030141) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001002) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001020) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001024) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001084) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001012) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001332) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001969) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0008015)))\n4758:EquivalentClasses(obo:CL_0000096 ObjectIntersectionOf(obo:CL_0000775 ObjectSomeValuesFrom(obo:BFO_0000051 obo:CL_0017500) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0070820) ObjectSomeValuesFrom(obo:BFO_0000051 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001979))) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000009978) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000010543) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000010799) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001256) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001257) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001456) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001483) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001879) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001944) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000007597) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002536) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002690) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006909) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032637)))\n4773:EquivalentClasses(obo:CL_0000097 ObjectIntersectionOf(obo:CL_0000766 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030141) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001865) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001255) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000006169) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002349) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002539) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002660) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002690) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002830) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030210) ObjectSomeValuesFrom(obo:RO_0015015 obo:PR_000002065) ObjectSomeValuesFrom(obo:RO_0015015 obo:PR_000007431)))\n4785:EquivalentClasses(obo:CL_0000098 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050906)))\n4817:EquivalentClasses(obo:CL_0000101 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050906)))\n4876:EquivalentClasses(obo:CL_0000108 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055)))\n4890:SubClassOf(obo:CL_0000110 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002790))\n4911:SubClassOf(obo:CL_0000112 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0007601))\n4933:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D042783\") Annotation(oboInOwl:hasDbXref \"PMID:21275341\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Endothelial_cell\") Annotation(oboInOwl:hasDbXref \"https://sourceforge.net/tracker/?func=detail&atid=440764&aid=3364936&group_id=36855\") obo:IAO_0000115 obo:CL_0000115 \"An endothelial cell comprises the outermost layer or lining of anatomical structures and can be squamous or cuboidal. In mammals, endothelial cell has vimentin filaments and is derived from the mesoderm.\")\n4938:AnnotationAssertion(rdfs:comment obo:CL_0000115 \"From FMA: 9.07.2001: Endothelial cell has always been classified as a kind of epithelial cell, specifically a squamous cell but that is not true. First, endothelial cell can either be squamous or cuboidal (e.g. high-endothelial cell) and secondly, it has different embryological derivation (mesodermal) than a true epithelial cell (ectodermal and endodermal). The basis for present classification is the fact that it comprises the outermost layer or lining of anatomical structures (location-based) but a better structural basis for the differentia is the cytoskeleton of the cell. Endothelial cell has vimentin filaments while an epithelial cell has keratin filaments. [Onard].\")\n4961:EquivalentClasses(obo:CL_0000118 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070002) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n5003:SubClassOf(obo:CL_0000121 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n5058:AnnotationAssertion(rdfs:comment obo:CL_0000127 \"Astrocytes are reportedly CD68-negative, CD121a-positive, CD184-positive, CD192-positive, CRF-positive, EGFR-positive, GFAP-positive, GLUT1-positive, MBP-negative, and NGFR-positive.\")\n5079:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D017628\") Annotation(oboInOwl:hasDbXref \"PMID:11517395\") Annotation(oboInOwl:hasDbXref \"PMID:12430718\") Annotation(oboInOwl:hasDbXref \"PMID:14561199\") Annotation(oboInOwl:hasDbXref \"PMID:14612429\") Annotation(oboInOwl:hasDbXref \"PMID:16177057\") Annotation(oboInOwl:hasDbXref \"PMID:19461673\") Annotation(oboInOwl:hasDbXref \"PMID:2089275\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Microglia\") obo:IAO_0000115 obo:CL_0000129 \"A transcriptomically distinct central nervous system macrophage found in the parenchyma of the central nervous system. Marker include CD11b-positive, F4/80-positive, and CD68-positive.\")\n5089:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23616747\") rdfs:comment obo:CL_0000129 \"Unlike macroglial cells, microglial cells  arise from hematopoietic stem cells in the yolk sac during early embryogenesis that populate the central nervous system. They derive from embryonic mesoderm and are not from neuroectoderm where glioblast develops from. Markers: Mouse: CD11b+, F4/80+, CD68+. They represent ~12% of the cells in the CNS, but they are not uniformly distributed within the CNS. A normal adult mouse brain has approximately 3.5x10e6 microglia. Microglia are also reportedly CD3-negative, CD4-positive, CD8-negative, CD11b-positive, CD11c-high, CD14-negative, CD19-negative, CD45-low, CD56-negative, CD163-negative, CD200R-positive, CD281-positive, CD282-positive, CD283-positive, CD284-positive, CD285-positive, CD286-positive, CD287-positive, CD288-positive, CD289-positive, Gr1-negative, nestin-positive, and PU.1-positive.\")\n5091:EquivalentClasses(obo:CL_0000129 ObjectIntersectionOf(obo:CL_0000125 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001012) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001813) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002064) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045087)))\n5155:AnnotationAssertion(rdfs:comment obo:CL_0000135 \"Cultured human fibrocytes are MHCI-positive, MHCII-positive, CD1a-negative, CD3-negative, CD4-negative, CD8-negative, CD10-negative, CD11b-positive, CD13-positive, CD14-negative, CD16-negative, CD18-positive, CD19-negative, CD25-negative, CD29-positive, CD32-positive, CD33-negative, CD34-positive, CD38-negative, CD40-positive, CD44-negative, CD45RO-positive, CD49a-positive, CD49b-positive, CD49c-negative, CD49d-negative, CD49e-positive, CD49f-negative, CD56-negative, CD58-positive, CD61-positive, CD64-positive, CD70-negative, CD71-positive, CD80-positive, CD83-negative, CD86-positive, CD103-negative, CD105-positive, CD181-positive, CD182-negative, CD183-positive, CD184-positive, CD185-negative, CD186-negative, CD191-positive, CD192-negative, CD193-positive, CD194-positive, CD195-positive, CD196-negative, CD197-positive, CD199-positive, desmin-negative, F4/80-positive, Gr1-positive, LSP-1-positive, MHCI-positive, MHCII-positive, alpha-SMA-negative, TCRab-negative, TCRgd-negative, and vimentin-positive. Fibrocytes are also capable of secreting angiogenin, bFGF, CCL2, CCL3, CCL4, CCL8, CXCL1, type I collagen, type III collagen, CTGF, fibronectin, GM-CSF, IL-1a, IL-6, IL-8, IL-10, M-CSF, MMP-9, PDGF-A, TGF-alpha, TGF-beta1, TNF-alpha, and VEGF-A.\")\n5160:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002495))\n5161:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042060))\n5162:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045766))\n5261:EquivalentClasses(obo:CL_0000145 ObjectIntersectionOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002504)))\n5311:EquivalentClasses(obo:CL_0000151 ObjectIntersectionOf(obo:CL_0000000 ObjectS