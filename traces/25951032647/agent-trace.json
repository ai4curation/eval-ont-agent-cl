\"AB\")\n35137:AnnotationAssertion(rdfs:label obo:CL_4070016 \"anterior burster neuron\")\n35138:SubClassOf(obo:CL_4070016 obo:CL_0000099)\n35139:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35140:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35142:# Class: obo:CL_4070017 (lateral pyloric motor neuron)\n35144:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070017 \"A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.\")\n35145:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6712)\n35146:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6752)\n35147:AnnotationAssertion(terms:contributor obo:CL_4070017 <https://orcid.org/0000-0002-1909-7004>)\n35148:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\n35149:AnnotationAssertion(rdfs:label obo:CL_4070017 \"lateral pyloric motor neuron\")\n35150:SubClassOf(obo:CL_4070017 obo:CL_0000100)\n35151:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n35152:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35154:# Class: obo:CL_4072001 (newly formed oligodendrocyte)\n35156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\n35157:AnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\n35158:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\n35159:AnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\n35160:SubClassOf(obo:CL_4072001 obo:CL_0000123)\n35161:SubClassOf(obo:CL_4072001 obo:CL_0000128)\n35162:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n35163:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\n35165:# Class: obo:CL_4072002 (myelin-forming oligodendrocyte)\n35167:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n35168:AnnotationAssertion(terms:contributor obo:CL_4072002 <https://orcid.org/0000-0002-5507-2103>)\n35169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\n35170:AnnotationAssertion(rdfs:label obo:CL_4072002 \"myelin-forming oligodendrocyte\"@en)\n35171:SubClassOf(obo:CL_4072002 obo:CL_0000128)\n35172:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n35173:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n35174:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n35176:# Class: obo:CL_4072003 (mature myelinating oligodendrocyte)\n35178:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\n35179:AnnotationAssertion(terms:contributor obo:CL_4072003 <https://orcid.org/0000-0002-5507-2103>)\n35180:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\n35181:AnnotationAssertion(rdfs:label obo:CL_4072003 \"mature myelinating oligodendrocyte\")\n35182:SubClassOf(obo:CL_4072003 obo:CL_0000128)\n35183:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n35184:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072002))\n35185:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n35187:# Class: obo:CL_4072005 (A8 dopaminergic neuron)\n35189:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\n35190:AnnotationAssertion(terms:date obo:CL_4072005 \"2025-05-02T08:37:36Z\"^^xsd:dateTime)\n35191:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\n35192:AnnotationAssertion(rdfs:label obo:CL_4072005 \"A8 dopaminergic neuron\")\n35193:SubClassOf(obo:CL_4072005 obo:CL_2000097)\n35194:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n35195:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n35197:# Class: obo:CL_4072006 (A9 dopaminergic neuron)\n35199:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\n35200:AnnotationAssertion(terms:date obo:CL_4072006 \"2025-05-02T09:59:34Z\"^^xsd:dateTime)\n35201:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\n35202:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\n35203:AnnotationAssertion(rdfs:label obo:CL_4072006 \"A9 dopaminergic neuron\")\n35204:SubClassOf(obo:CL_4072006 obo:CL_4042025)\n35205:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))\n35206:SubClassOf(obo:CL_4072006 O