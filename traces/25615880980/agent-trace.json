bo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/pull/1950\") obo:CL_0000535 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n8404:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000548 <https://github.com/obophenotype/cell-ontology/issues/2124>)\n8640:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0000569 \"A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.\")\n9183:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000627 <https://github.com/obophenotype/cell-ontology/issues/2990>)\n9190:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000628 \"A cell that can perform photosynthesis, in which carbohydrates are synthesized from carbon dioxide and water, using light as the energy source.\")\n9453:AnnotationAssertion(rdfs:seeAlso obo:CL_0000653 \"https://github.com/obophenotype/cell-ontology/issues/1460\")\n9530:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000663 <https://github.com/obophenotype/cell-ontology/issues/726>)\n9537:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000664 <https://github.com/obophenotype/cell-ontology/issues/726>)\n9544:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000665 <https://github.com/obophenotype/cell-ontology/issues/726>)\n9970:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000717 <https://github.com/obophenotype/cell-ontology/issues/1364>)\n10037:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000727 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10044:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000728 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10051:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000729 <https://github.com/obophenotype/cell-ontology/issues/1930>)\n10168:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35179487\") rdfs:comment obo:CL_0000743 \"Despite historical descriptions as 'terminally differentiated,' hypertrophic chondrocytes survive and transdifferentiate into osteoblasts. Genetic lineage tracing shows that hypertrophic chondrocytes do not simply undergo apoptosis but cross the cartilage–bone boundary, dedifferentiate into skeletal stem/progenitor cells, and then redifferentiate into osteoblasts and osteocytes. Single-cell RNA-seq further indicates that these chondrocyte-derived SSPCs are a major source of trabecular osteoblasts and marrow adipocytes.\")\n11061:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:11861604\") Annotation(oboInOwl:hasDbXref \"PMID:20933013\") Annotation(oboInOwl:hasDbXref \"PMID:21220451\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/B-1_cell\") obo:IAO_0000115 obo:CL_0000819 \"A B cell of distinct lineage and surface marker expression. B-1 B cells are thought to be the primary source of natural IgM immunoglobulin, that is, IgM produced in large quantities without prior antigenic stimulation and generally reactive against various microorganisms, as well as the source of T-independent IgA immunoglobulin in the mucosal areas. These cells are CD43-positive.\")\n13625:AnnotationAssertion(rdfs:comment obo:CL_0001061 \"https://github.com/obophenotype/cell-ontology/issues/448\")\n13651:AnnotationAssertion(rdfs:comment obo:CL_0001063 \"https://github.com/obophenotype/cell-ontology/issues/448\")\n13663:AnnotationAssertion(rdfs:comment obo:CL_0001064 \"https://github.com/obophenotype/cell-ontology/issues/448\")\n15848:AnnotationAssertion(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:RO_0002161 obo:CL_0002174 obo:NCBITaxon_50557)\n15981:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:16824012\") Annotation(oboInOwl:hasDbXref \"PMID:32187560\") Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Basal_cell\") Annotation(oboInOwl:hasDbXref \"doi:/10.1073/pnas.1734203100\") obo:IAO_0000115 obo:CL_0002187 \"A mitotically active, columnar-shaped keratinocyte located in the stratum basale of the epidermis and attached to the basement membrane. This cell exhibits heterogeneity, encompassing stem and progenitor subpopulations with distinct molecular and proliferative characteristics (Haensel et al., 2020), and serves as the primary source of new keratinocytes for epidermal renewal, homeostasis, and regeneration.\")\n16033:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002191 \"FMA:83519\")\n16077:AnnotationAssertion(rdfs:seeAlso obo:CL_0002195 \"https://github.com/obophenotype/cell-ontology/issues/800\")\n17086:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15738192\") obo:IAO_0000115 obo:CL_0002287 \"A rounded, mitotically active stem cell which is the source of new cells of the taste bud; located basally.\")\n18009:AnnotationAssertion(obo:IAO_0000233 obo:CL_0002371 <https://github.com/obophenotype/cell-ontology/issues/1150>)\n18813:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:hjd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15987436\") Annotation(oboInOwl:hasDbXref \"PMID:16397499\") Annotation(oboInOwl:hasDbXref \"PMID:17851544\") obo:IAO_0000115 obo:CL_0002451 \"A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.\")\n20417:AnnotationAssertion(rdfs:seeAlso obo:CL_0002619 \"https://github.com/obophenotype/cell-ontology/issues/1410\")\n20418:AnnotationAssertion(rdfs:seeAlso obo:CL_0002619 \"https://github.com/obophenotype/cell-ontology/issues/348\")\n22550:AnnotationAssertion(rdfs:seeAlso obo:CL_0005026 \"https://github.com/obophenotype/cell-ontology/issues/800\")\n22763:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://github.com/obophenotype/cell-ontology/issues/583\") oboInOwl:hasExactSynonym obo:CL_0007021 \"club cell (zebrafish)\")\n22764:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN-10:0412429403\") Annotation(oboInOwl:hasDbXref \"https://github.com/obophenotype/cell-ontology/issues/583\") oboInOwl:hasRelatedSynonym obo:CL_0007021 \"club cell\")\n22983:AnnotationAssertion(obo:IAO_0000233 obo:CL_0008029 <https://github.com/obophenotype/cell-ontology/issues/1540>)\n22992:AnnotationAssertion(obo:IAO_0000233 obo:CL_0008030 <https://github.com/obophenotype/cell-ontology/issues/1540>)\n23254:AnnotationAssertion(rdfs:seeAlso obo:CL_0009003 \"https://github.com/obophenotype/cell-ontology/issues/710\")\n24283:AnnotationAssertion(rdfs:seeAlso obo:CL_0009101 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24295:AnnotationAssertion(rdfs:seeAlso obo:CL_0009102 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24306:AnnotationAssertion(rdfs:seeAlso obo:CL_0009103 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24320:AnnotationAssertion(rdfs:seeAlso obo:CL_0009104 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24333:AnnotationAssertion(rdfs:seeAlso obo:CL_0009105 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24348:AnnotationAssertion(rdfs:seeAlso obo:CL_0009106 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24446:AnnotationAssertion(rdfs:seeAlso obo:CL_0009115 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n24461:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/417>) Annotation(oboInOwl:hasDbXref \"PMID:2478566\") Annotation(oboInOwl:hasDbXref \"PMID:28445731\") Annotation(oboInOwl:hasDbXref \"PMID:30420661\") obo:IAO_0000115 obo:CL_0010000 \"A differentiating matrix keratinocyte that has initiated terminal differentiation and keratin synthesis. This cell undergoes a characteristic change while migrating upward from the hair follicle bulb, representing a committed progenitor cell destined to form the hair medulla, cortex and hair root sheath.\")\n24486:AnnotationAssertion(obo:IAO_0000233 obo:CL_0010003 <https://github.com/obophenotype/cell-ontology/issues/2429>)\n24530:SubClassOf(Annotation(rdfs:seeAlso \"https://github.com/obophenotype/cell-ontology/issues/2245\") obo:CL_0010009 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000966))\n24558:AnnotationAssertion(rdfs:seeAlso obo:CL_0010012 \"https://github.com/obophenotype/cell-ontology/issues/1359\")\n24592:AnnotationAssertion(rdfs:seeAlso obo:CL_0010017 <https://github.com/obophenotype/cell-ontology/issues/786>)\n25050:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30069044\") Annotation(oboInOwl:hasDbXref \"PMID:30069046\") obo:IAO_0000115 obo:CL_0017000 \"An ionocyte that is part of the lung epithelium. The cells from this type are major sources of the CFTR protein in human and mice.\")\n25157:AnnotationAssertion(obo:IAO_0000233 obo:CL_0017501 <https://github.com/obophenotype/cell-ontology/issues/734>)\n25194:AnnotationAssertion(obo:IAO_0000233 obo:CL_0017505 <https://github.com/obophenotype/cell-ontology/issues/2251>)\n25470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:21925242\") Annotation(oboInOwl:hasDbXref \"PMID:2329464\") Annotation(oboInOwl:hasDbXref \"PMID:25374536\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") obo:IAO_0000115 obo:CL_0020008 \"A large aspiny interneuron of the striatum that serves as the principal intrinsic source of acetylcholine while simultaneously releasing GABA. It is defined by coexpression of cholinergic markers (ChAT and VAChT/Slc18a3) and GABAergic markers (GAD65/Gad2 and VGAT/Slc32a1) (Lozovaya et al., 2018). This MGE-derived neuron maintains Lhx6 expression associated with dual-transmitter identity (Fragkouli et al., 2009; Marin et al., 2000). Morphologically, it possesses a large soma (20–50 μm diameter), 2–4 thick aspiny dendrites extending radially ~1 mm, and locally ramified axons with hundreds of thousands of varicosities (Wilson et al., 1990; Lim et al., 2014).\")\n25682:AnnotationAssertion(obo:IAO_0000233 obo:CL_0020026 \"https://github.com/obophenotype/cell-ontology/issues/3493\")\n28183:AnnotationAssertion(rdfs:comment obo:CL_1001064 \"Note that the source of this term is KUPO:0001096 (artery smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28191:AnnotationAssertion(rdfs:comment obo:CL_1001066 \"Note that the source of this term is KUPO:0001098 (arteriole smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28199:AnnotationAssertion(rdfs:comment obo:CL_1001068 \"Note that the source of this term is KUPO:0001068 (venous system smooth muscle cell), which we believe actually denotes the kidney specific structure.\")\n28658:AnnotationAssertion(obo:IAO_0000233 obo:CL_1001566 <https://github.com/obophenotype/cell-ontology/issues/1443>)\n29830:AnnotationAssertion(obo:IAO_0000233 obo:CL_2000082 <https://github.com/obophenotype/cell-ontology/issues/1562>)\n30452:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023034 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n30805:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023067 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n30834:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023070 <https://github.com/obophenotype/cell-ontology/pull/2374>)\n30870:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023073 <https://github.com/obophenotype/cell-ontology/issues/2043>)\n30921:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023078 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31675:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\n32999:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23613519\") oboInOwl:hasExactSynonym obo:CL_4033065 \"pre-plasmablast\")\n34508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n35420:AnnotationAssertion(obo:IAO_0000233 obo:CL_7770002 \"https://github.com/obophenotype/cell-ontology/issues/3275\")\n35546:SubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742)) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000031))\n","exit_co