0:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004117 \"A monostratified retinal ganglion cell with large soma and large dendritic field.\")\n21687:AnnotationAssertion(rdfs:comment obo:CL_0004117 \"This group includes all of the large bodied/large field RGCs in the rat. Group RGA cells have large somata (15 to 39 micrometers in diameter) and large, radially branching dendritic fields (235 to 748 micrometers in diameter), and many exhibit tracer coupling.\")\n21688:AnnotationAssertion(rdfs:label obo:CL_0004117 \"retinal ganglion cell A\")\n21693:# Class: obo:CL_0004119 (retinal ganglion cell B1)\n21695:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004119 \"A retinal ganglion cell B that has medium body size, medium dendritic field and dense dendritic arbor, and has post synaptic terminals in S2.\")\n21699:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0004119 \"retinal ganglion cell B4\")\n21703:AnnotationAssertion(rdfs:label obo:CL_0004119 \"retinal ganglion cell B1\")\n21707:# Class: obo:CL_0004120 (retinal ganglion cell A1)\n21709:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004120 \"A retinal ganglion A cell found in the retina with large somata, often polygonal in shape. The dendritic fields consist of three to seven stout dendrites that are sparce near soma. Dendrites terminate in S4.\")\n21714:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0004120 \"inner alpha retinal ganglion cell\")\n21718:AnnotationAssertion(rdfs:label obo:CL_0004120 \"retinal ganglion cell A1\")\n21722:# Class: obo:CL_0004121 (retinal ganglion cell B2)\n21724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004121 \"A retinal ganglion cell B that has a very small but very dense dendritic field, and has post synaptic terminals in S2.\")\n21730:AnnotationAssertion(rdfs:label obo:CL_0004121 \"retinal ganglion cell B2\")\n21734:# Class: obo:CL_0004124 (retinal ganglion cell C1)\n21736:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004124 \"A retinal ganglion cell C inner that has medium dendritic diversity.\")\n21745:AnnotationAssertion(rdfs:label obo:CL_0004124 \"retinal ganglion cell C1\")\n21748:# Class: obo:CL_0004125 (retinal ganglion cell C2 inner)\n21750:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004125 \"A retinal ganglion cell C inner that has dense dendritic diversity.\")\n21756:AnnotationAssertion(rdfs:label obo:CL_0004125 \"retinal ganglion cell C2 inner\")\n21759:# Class: obo:CL_0004126 (retinal ganglion cell C2 outer)\n21761:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004126 \"A retinal ganglion cell C outer that has symmetrical and dense dendritic dendritic tree with a large dendritic field.\")\n21767:AnnotationAssertion(rdfs:label obo:CL_0004126 \"retinal ganglion cell C2 outer\")\n21770:# Class: obo:CL_0004137 (retinal ganglion cell A2 inner)\n21772:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004137 \"A retinal ganglion A2 cell with dendrites terminating in S4.\")\n21778:AnnotationAssertion(rdfs:label obo:CL_0004137 \"retinal ganglion cell A2 inner\")\n21782:# Class: obo:CL_0004138 (retinal ganglion cell A2)\n21784:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004138 \"A retinal ganglion A cell with dense arbor near soma.\")\n21787:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0004138 \"outer alpha retinal ganglion cell\")\n21792:AnnotationAssertion(rdfs:label obo:CL_0004138 \"retinal ganglion cell A2\")\n21795:# Class: obo:CL_0004139 (retinal ganglion cell A2 outer)\n21797:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004139 \"A retinal ganglion A2 cell with dendrites terminating in S2.\")\n21803:AnnotationAssertion(rdfs:label obo:CL_0004139 \"retinal ganglion cell A2 outer\")\n21830:# Class: obo:CL_0004183 (retinal ganglion cell B3)\n21832:AnnotationAssertion(obo:IAO_0000115 obo:CL_0004183 \"A monostratified retinal ganglion cell with medium soma, sparse dendritic tree, and medium dendritic field.\")\n21838:AnnotationAssertion(rdfs:comment obo:CL_0004183 \"Sixty to eighty neurons with small somata (12 to 24 micrometers in diameter), small dendritic fields (99 to 289 micrometers in diameter), and small axonal diameters (04. to 07. micrometers in diameter) make up Group RGB. We classified cells with a large soma and a large dendritic field as RGA, cells with a small to medium to sized soma and a small to medium to sized dendritic field as RGB, and cells with a small to medium to sized soma but a medium to large dendritic field RGC.\")\n21839:AnnotationAssertion(rdfs:label obo:CL_0004183 \"retinal ganglion cell B3\")\n29325:# Class: obo:CL_2000050 (obsolete retina retinal ganglion cell)\n29327:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000050 \"Any retinal ganglion cell that is part of a retina.\")\n29332:AnnotationAssertion(rdfs:label obo:CL_2000050 \"obsolete retina retinal ganglion cell\")\n30241:# Class: obo:CL_4023032 (ON retinal ganglion cell)\n30244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\n30245:AnnotationAssertion(rdfs:label obo:CL_4023032 \"ON retinal ganglion cell\")\n30248:# Class: obo:CL_4023033 (OFF retinal ganglion cell)\n30250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\n30252:AnnotationAssertion(rdfs:label obo:CL_4023033 \"OFF retinal ganglion cell\")\n31292:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\n31303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\n31308:AnnotationAssertion(rdfs:comment obo:CL_4023189 \"These cells should not be confused with M1-M14 retinal ganglion cells described in PMID:16626866 which refer to a different classification of retinal ganglion cells.\")\n32573:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033046 \"ON-midget RGC\")\n32584:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget RGC\")\n32629:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol RGC\")\n32630:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\n32640:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol RGC\")\n32641:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\n32646:# Class: obo:CL_4033053 (small bistratified retinal ganglion cell)\n32648:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\n32655:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"sbRGC\")\n32656:AnnotationAssertion(rdfs:label obo:CL_4033053 \"small bistratified retinal ganglion cell\")\n","exit_code":0,"status":"completed"}}
