{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"rg -n 'squamous epithelial cell|stratified squamous|squamous cell of' src/ontology/cl-edit.owl\"","aggregated_output":"4527:# Class: obo:CL_0000076 (squamous epithelial cell)\n4530:AnnotationAssertion(rdfs:label obo:CL_0000076 \"squamous epithelial cell\")\n4539:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\n6096:# Class: obo:CL_0000240 (stratified squamous epithelial cell)\n6099:AnnotationAssertion(rdfs:label obo:CL_0000240 \"stratified squamous epithelial cell\")\n6133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000244 \"A cell characteristically found lining hollow organs that are subject to great mechanical change due to contraction and distention; originally thought to represent a transition between stratified squamous and columnar epithelium.\")\n6593:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19256306\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:29713660\") Annotation(oboInOwl:hasDbXref \"PMID:37873034\") obo:IAO_0000115 obo:CL_0000312 \"An epithelial cell of stratified squamous tissues, including skin, oral mucosa (Hiroshima et al., 2011), and esophagus (Whelan et al., 2018), that produces keratin proteins and secretes antimicrobial peptides to form a resilient barrier against environmental damage, dehydration, pathogens, and microbial invasion. It undergoes successive stages of differentiation marked by changes in keratin expression, supporting tissue integrity, wound repair, and contributing to immune defense.\")\n15669:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0002153 \"The dead keratin-filled squamous cell of the stratum corneum. This cell type lacks a nucleus.\")\n16051:# Class: obo:CL_0002190 (squamous cell of epidermis)\n16057:AnnotationAssertion(rdfs:label obo:CL_0002190 \"squamous cell of epidermis\")\n16392:# Class: obo:CL_0002221 (keratinized squamous cell of esophagus)\n16398:AnnotationAssertion(rdfs:label obo:CL_0002221 \"keratinized squamous cell of esophagus\")\n16638:# Class: obo:CL_0002244 (squamous cell of ectocervix)\n16640:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:32644501\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/j.autneu.2015.04.008\") Annotation(oboInOwl:hasDbXref \"http://www.bu.edu/histology/p/19404loa.htm\") obo:IAO_0000115 obo:CL_0002244 \"A stratified squamous epithelial cell located in the ectocervix.\")\n16645:AnnotationAssertion(rdfs:label obo:CL_0002244 \"squamous cell of ectocervix\")\n17694:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15339667\") Annotation(oboInOwl:hasDbXref \"PMID:20568222\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") obo:IAO_0000115 obo:CL_0002337 \"A stem cell found in the basal layer of the epidermis, hair follicle, and sebaceous gland, characterised by its quiescent nature, high proliferative potential, and capacity for long-term self-renewal. This cell maintains epidermal homeostasis by producing transit-amplifying cells that differentiate to replenish the stratified squamous epithelium.\")\n23965:# Class: obo:CL_0009066 (stratified squamous epithelial cell of anal canal)\n23967:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009066 \"A stratified squamous epithelial cell that is part of the anal canal.\")\n23969:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009066 \"anal canal stratified squamous epithelial cell\")\n23972:AnnotationAssertion(rdfs:label obo:CL_0009066 \"stratified squamous epithelial cell of anal canal\")\n24274:# Class: obo:CL_0009096 (esophagus non-keratinized squamous epithelial cell)\n24276:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11694559\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-2034-601X\") obo:IAO_0000115 obo:CL_0009096 \"Any cell that is part of the esophageal non-keratinized stratified squamous epithelium. In humans, the esophagus, which requires flexibility to accommodate swallowing of a bolus, is covered with a non-keratinized epithelium.\")\n24280:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophageal non-keratinized squamous epithelial cell\")\n24281:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophageal nonkeratinized squamous epithelial cell\")\n24282:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophagus non-keratinizing squamous epithelial cell\")\n24283:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophagus nonkeratinizing squamous epithelial cell\")\n24284:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"non-keratinized squamous epithelial cell of esophagus\")\n24285:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"non-keratinizing squamous epithelial cell of esophagus\")\n24286:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"nonkeratinized squamous epithelial cell of esophagus\")\n24287:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"nonkeratinizing squamous epithelial cell of esophagus\")\n24288:AnnotationAssertion(rdfs:label obo:CL_0009096 \"esophagus non-keratinized squamous epithelial cell\")\n28784:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1251\") oboInOwl:hasRelatedSynonym obo:CL_1001575 \"cervix squamous epithelial cell\")\n28785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1251\") oboInOwl:hasRelatedSynonym obo:CL_1001575 \"cervix, uterine squamous epithelial cells\")\n28786:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1251\") oboInOwl:hasRelatedSynonym obo:CL_1001575 \"uterine cervix squamous epithelial cell\")\n28787:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1251\") oboInOwl:hasRelatedSynonym obo:CL_1001575 \"uterine cervix squamous epithelial cells\")\n28797:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1252\") oboInOwl:hasRelatedSynonym obo:CL_1001576 \"oral cavity mucosa squamous epithelial cell\")\n28798:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1252\") oboInOwl:hasRelatedSynonym obo:CL_1001576 \"oral mucosa squamous epithelial cell\")\n28799:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1252\") oboInOwl:hasRelatedSynonym obo:CL_1001576 \"oral mucosa squamous epithelial cells\")\n28807:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1253\") oboInOwl:hasRelatedSynonym obo:CL_1001577 \"tonsil squamous epithelial cell\")\n28808:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1253\") oboInOwl:hasRelatedSynonym obo:CL_1001577 \"tonsil squamous epithelial cells\")\n28810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1253\") oboInOwl:hasRelatedSynonym obo:CL_1001577 \"tonsillar squamous epithelial cell\")\n28819:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1254\") oboInOwl:hasRelatedSynonym obo:CL_1001578 \"vagina squamous epithelial cell\")\n28820:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1254\") oboInOwl:hasRelatedSynonym obo:CL_1001578 \"vagina squamous epithelial cells\")\n28822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"C