f \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:36138472\") Annotation(oboInOwl:hasDbXref \"PMID:8540632\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0002063 \"A pulmonary alveolar epithelial cell that modulates the fluid surrounding the alveolar epithelium by secreting and recycling surfactants via specialized organelles called alveolar lamellar bodies. This cell type also contributes to tissue repair and can differentiate after injury into a pulmonary alveolar type 1 cell. This cuboidal cell is thicker than squamous alveolar cells, has a rounded apical surface that projects above the level of the surrounding epithelium, and its free surface is covered by short microvilli.\")\nAnnotationAssertion(terms:contributor obo:CL_0002063 <https://orcid.org/0000-0003-1980-3228>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0002063 \"2010-06-24T12:04:13Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002063 \"BTO:0000538\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002063 \"FMA:62501\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"cuboidal type II cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"granular pneumocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"great alveolar cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"lung type 2 cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type 2 alveolar epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type 2 alveolocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type 2 pneumocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type II alveolar cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type II alveolar epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type II alveolocyte\")\nAnnotationAssertion(Annotation(obo