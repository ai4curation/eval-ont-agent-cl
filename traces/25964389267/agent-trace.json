rdfs:label obo:CL_0002648 \"obsolete epithelial cell of nasal part of viscerocranial mucosa\")\n20725:# Class: obo:CL_0002649 (obsolete epithelial cell of gingival part of viscerocranial mucosa)\n20727:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002649 \"An ecto-epithelial cell of the gingival region of the viscerocranial mucosa.\")\n20731:AnnotationAssertion(rdfs:label obo:CL_0002649 \"obsolete epithelial cell of gingival part of viscerocranial mucosa\")\n20734:# Class: obo:CL_0002650 (obsolete epithelial cell of paranasal sinus part of viscerocranial mucosa)\n20736:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002650 \"An ecto-epithelial cell of the paranasal region of the viscerocranial mucosa.\")\n20740:AnnotationAssertion(rdfs:label obo:CL_0002650 \"obsolete epithelial cell of paranasal sinus part of viscerocranial mucosa\")\n20765:# Class: obo:CL_0002653 (squamous endothelial cell)\n20767:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dos\") obo:IAO_0000115 obo:CL_0002653 \"A squamous shaped endothelial cell.\")\n20770:AnnotationAssertion(rdfs:label obo:CL_0002653 \"squamous endothelial cell\")\n20773:# Class: obo:CL_0002654 (epithelial cell of stratum corneum of esophageal epithelium)\n20775:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002654 \"An epithelial cell of stratum corneum of esophageal epithelium.\")\n20779:AnnotationAssertion(rdfs:label obo:CL_0002654 \"epithelial cell of stratum corneum of esophageal epithelium\")\n20782:# Class: obo:CL_0002655 (epithelial cell of stratum spinosum of esophageal epithelium)\n20784:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002655 \"An epithelial cell of stratum spinosum of esophageal epithelium.\")\n20788:AnnotationAssertion(rdfs:label obo:CL_0002655 \"epithelial cell of stratum spinosum of esophageal epithelium\")\n20791:# Class: obo:CL_0002656 (glandular endometrial unciliated epithelial cell)\n20793:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:25023676\") obo:IAO_0000115 obo:CL_0002656 \"A glandular epithelial cell of the endometrium. Following ovulation, these cells secrete a glycogen-rich substance known as histotroph or uterine milk, which nourishes the embryo if implantation occurs.\")\n20798:AnnotationAssertion(rdfs:label obo:CL_0002656 \"glandular endometrial unciliated epithelial cell\")\n20803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002657 \"A glandular epithelial cell of the esophagus.\")\n20814:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002658 \"A glandular epithelial cell of the large intestine.\")\n20823:# Class: obo:CL_0002659 (glandular epithelial cell of stomach)\n20825:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002659 \"A glandular epithelial cell that is part of the stomach.\")\n20831:AnnotationAssertion(rdfs:label obo:CL_0002659 \"glandular epithelial cell of stomach\")\n20836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002660 \"A luminal epithelial cell of mammary gland located in acinus of structure.\")\n20855:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") obo:IAO_0000115 obo:CL_0002662 \"A luminal epithelial cell of the lactiferous duct. This cuboidal epithelial cell expresses keratin-18 and is estrogen-receptor alpha positive.\")\n22417:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17555741\") Annotation(oboInOwl:hasDbXref \"PMID:19268451\") obo:IAO_0000115 obo:CL_0005006 \"Specialized epithelial cells involved in the maintenance of osmotic homeostasis. They are characterized by abundant mitochondria and ion transporters. In amniotes, they are present in the renal system. In freshwater fish, ionocytes in the skin and gills help maintain osmotic homeostasis by absorbing salt from the external environment.\")\n22441:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005009 \"A cuboidal epithelial cell of the kidney which regulates sodium and potassium balance. The activity of sodium and potassium channels on the apical membrane of the cell is regulated by aldosterone and vasopressin. In mammals this cell type is located in the renal collecting duct system.\")\n22448:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005010 \"A cuboidal epithelial cell of the kidney that regulates acid/base balance.\")\n22460:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005011 \"A cuboidal epithelial cell of the kidney which secretes acid and reabsorbs base to regulate acid/base balance.\")\n22468:# Class: obo:CL_0005012 (multiciliated epithelial cell)\n22470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") Annotation(oboInOwl:hasDbXref \"PMID:28400610\") Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"PMID:38032388\") obo:IAO_0000115 obo:CL_0005012 \"A columnar/cuboidal epithelial cell with multiple motile cilia on its apical surface. These cells facilitate the movement of liquids such as mucus or cerebrospinal fluid across the epithelial surface.\")\n22473:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005012 \"multi-ciliated epithelial cell\")\n22474:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005012 \"multiciliated epithelial cell\"@en)\n22476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22118931\") Annotation(oboInOwl:hasDbXref \"PMID:23959957\") Annotation(oboInOwl:hasDbXref \"PMID:25729351\") Annotation(oboInOwl:hasDbXref \"PMID:26378583\") rdfs:comment obo:CL_0005012 \"While the term 'multi-ciliated epithelial cell' refers to cells with multiple motile cilia, there are exceptions where epithelial cells may have multiple non-motile cilia. Examples include olfactory sensory neurons, which have non-motile cilia for sensory detection, and choroid plexus epithelial cells, which possess multiple non-motile cilia with transient motility during development. Multiciliated cells are essential for human health, and their dysfunction can lead to various diseases known as ciliopathies, such as primary ciliary dyskinesia. This condition affects the respiratory system, brain ventricles, and reproductive system, leading to chronic respiratory infections, hydrocephalus, and infertility\")\n22477:AnnotationAssertion(rdfs:label obo:CL_0005012 \"multiciliated epithelial cell\")\n22480:# Class: obo:CL_0005013 (single ciliated epithelial cell)\n22482:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005013 \"A ciliated epithelial cell with a single cilium.\")\n22483:AnnotationAssertion(rdfs:label obo:CL_0005013 \"single ciliated epithelial cell\")\n23003:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dos\") obo:IAO_0000115 obo:CL_0008026 \"An epithelial cell that is part of the epithelium of a tracheal tube in an open tracheal system, such as that found in insects.\")\n23131:# Class: obo:CL_0008040 (squamous endothelial cell of venule)\n23133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0008040 \"An endothelial cell of the venule that is squamous shaped. This is in contrast to the cubodial shape of high endothelial venule cells.\")\n23136:AnnotationAssertion(rdfs:label obo:CL_0008040 \"squamous endothelial cell of venule\"@en)\n23232:# Class: obo:CL_0008055 (respiratory tract secretory epithelial cell)\n23234:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41591-023-02327-2.\") obo:IAO_0000115 obo:CL_0008055 \"A secretory epithelial cell of the respiratory tract epithelium.  These cells have an endodermal origin.\")\n23237:AnnotationAssertion(rdfs:label obo:CL_0008055 \"respiratory tract secretory epithelial cell\")\n23379:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20801415\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009011 \"A rapidly proliferating population of cells that differentiate from stem cells of the intestinal crypt of the colon. Stem cells located in the crypts of Lieberkühn give rise to proliferating progenitor or transit amplifying cells that differentiate into the four major epithelial cell types. These include columnar absorptive cells or enterocytes, mucous secreting goblet cells, enteroendocrine cells and paneth cells.\")\n23394:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20801415\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009012 \"A rapidly proliferating population of cells that differentiate from stem cells of the intestinal crypt of the small intestine. Stem cells located in the crypts of Lieberkühn give rise to proliferating progenitor or transit amplifying cells that differentiate into the four major epithelial cell types. These include columnar absorptive cells or enterocytes, mucous secreting goblet cells, enteroendocrine cells and paneth cells.\")\n23956:# Class: obo:CL_0009066 (stratified squamous epithelial cell of anal canal)\n23958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009066 \"A stratified squamous epithelial cell that is part of the anal canal.\")\n23960:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009066 \"anal canal stratified squamous epithelial cell\")\n23963:AnnotationAssertion(rdfs:label obo:CL_0009066 \"stratified squamous epithelial cell of anal canal\")\n23996:# Class: obo:CL_0009070 (corticomedullary thymic epithelial cell)\n23998:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") obo:IAO_0000115 obo:CL_0009070 \"A thymic epithelial cell located at the corticomedullary junction.\")\n24001:AnnotationAssertion(rdfs:label obo:CL_0009070 \"corticomedullary thymic epithelial cell\")\n24005:# Class: obo:CL_0009071 (medullary thymic epithelial cell type 1)\n24007:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24084687\") Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") obo:IAO_0000115 obo:CL_0009071 \"A thymic medullary epithelial cell considered to be a pre-AIRE mTEC population.\")\n24010:AnnotationAssertion(rdfs:label obo:CL_0009071 \"medullary thymic epithelial cell type 1\")\n24014:# Class: obo:CL_0009072 (medullary thymic epithelial cell type 2)\n24016:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17067941\") Annotation(oboInOwl:hasDbXref \"PMID:24084687\") Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") obo:IAO_0000115 obo:CL_0009072 \"A thymic medullary epithelial cell that expresses AIRE or other canonical markers of mature mTECs like Fezf2.\")\n24019:AnnotationAssertion(rdfs:label obo:CL_0009072 \"medullary thymic epithelial cell type 2\")\n24023:# Class: obo:CL_0009073 (medullary thymic epithelial cell type 3)\n24025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16121185\") Annotation(oboInOwl:hasDbXref \"PMID:17067941\") Annotation(oboInOwl:hasDbXref \"PMID:20861360\") Annotation(oboInOwl:hasDbXref \"PMID:24084687\") Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") Annotation(oboInOwl:hasDbXref \"PMID:33868260\") obo:IAO_0000115 obo:CL_0009073 \"A thymic medullary epithelial cell considered to be a post-AIRE cell. This group of AIRE-mTECs is heterogeneous and also includes mTECs within Hassall's Corpuscles.\")\n24029:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33868260\") oboInOwl:hasExactSynonym obo:CL_0009073 \"corneocyte-like medullary thymic epithelial cell\")\n24032:AnnotationAssertion(rdfs:label obo:CL_0009073 \"medullary thymic epithelial cell type 3\")\n24036:# Class: obo:CL_0009074 (medullary thymic epithelial cell type 4)\n24038:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009074 \"A thymic medullary epithelial cell that expresses typical tuft cell markers instead of classical mTEC or cTEC markers. This population has a bulbous-like structure.\")\n24042:AnnotationAssertion(rdfs:label obo:CL_0009074 \"medullary thymic epithelial cell type 4\")\n24046:# Class: obo:CL_0009075 (myo-medullary thymic epithelial cell)\n24048:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") obo:IAO_0000115 obo:CL_0009075 \"A thymic medullary epithelial cell that expresses muscle-specific biomarkers.\")\n24051:AnnotationAssertion(rdfs:label obo:CL_0009075 \"myo-medullary thymic epithelial cell\")\n24055:# Class: obo:CL_0009076 (neuro-medullary thymic epithelial cell)\n24057:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") Annotation(oboInOwl:hasDbXref \"PMID:33597545\") obo:IAO_0000115 obo:CL_0009076 \"A thymic medullary epithelial cell that expresses neuroendocrine biomarkers.\")\n24060:AnnotationAssertion(rdfs:label obo:CL_0009076 \"neuro-medullary thymic epithelial cell\")\n24064:# Class: obo:CL_0009077 (subcapsular thymic epithelial cell)\n24066:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6209968\") obo:IAO_0000115 obo:CL_0009077 \"A thymic epithelial cell located within the subcapsular region of the thymus.\")\n24069:AnnotationAssertion(rdfs:label obo:CL_0009077 \"subcapsular thymic epithelial cell\")\n24139:# Class: obo:CL_0009084 (glandular epithelial cell of endometrium)\n24141:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-3440-1876\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009084 \"An epithelial cell that is part of an endometrium glandular epithelium.\")\n24145:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009084 \"endometrial glandular epithelial cell\")\n24146:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009084 \"epithelial cell of endometrial gland\")\n24148:AnnotationAssertion(rdfs:label obo:CL_0009084 \"glandular epithelial cell of endometrium\")\n24265:# Class: obo:CL_0009096 (esophagus non-keratinized squamous epithelial cell)\n24267:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11694559\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-2034-601X\") obo:IAO_0000115 obo:CL_0009096 \"Any cell that is part of the esophageal non-keratinized stratified squamous epithelium. In humans, the esophagus, which requires flexibility to accommodate swallowing of a bolus, is covered with a non-keratinized epithelium.\")\n24271:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophageal non-keratinized squamous epithelial cell\")\n24272:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophageal nonkeratinized squamous epithelial cell\")\n24273:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophagus non-keratinizing squamous epithelial cell\")\n24274:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"esophagus nonkeratinizing squamous epithelial cell\")\n24275:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"non-keratinized squamous epithelial cell of esophagus\")\n24276:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"non-keratinizing squamous epithelial cell of esophagus\")\n24277:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"nonkeratinized squamous epithelial cell of esophagus\")\n24278:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009096 \"nonkeratinizing squamous epithelial cell of esophagus\")\n24279:AnnotationAssertion(rdfs:label obo:CL_0009096 \"esophagus non-keratinized squamous epithelial cell\")\n24492:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19063729\") Annotation(oboInOwl:hasDbXref \"PMID:20346151\") Annotation(oboInOwl:hasDbXref \"PMID:21930782\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4412-7970\") obo:IAO_0000115 obo:CL_0009116 \"A progenitor cell with the potential to differentiate into luminal epithelial cells of mammary glands. In mouse, CD61 and c-kit were found to be coexpressed by the majority of, but not all, committed luminal progenitor cells.\")\n24516:# Class: obo:CL_0010002 (epithelial cell of umbilical artery)\n24518:AnnotationAssertion(obo:IAO_0000115 obo:CL_0010002 \"An epithelial cell that is part_of a umbilical artery.\")\n24520:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0010002 \"umbilical artery epithelial cell\")\n24521:AnnotationAssertion(rdfs:label obo:CL_0010002 \"epithelial cell of umbilical artery\")\n24524:# Class: obo:CL_0010003 (obsolete epithelial cell of alveolus of lung)\n24526:AnnotationAssertion(obo:IAO_0000115 obo:CL_0010003 \"OBSOLETE. An epithelial cell that is part_of a alveolus of lung.\")\n24531:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0010003 \"alveolus of lung epithelial cell\")\n24532:AnnotationAssertion(rdfs:comment obo:CL_0010003 \"This cell type is exactly the same as 'pulmonary alveolar epithelial cell'.\")\n24533:AnnotationAssertion(rdfs:label obo:CL_0010003 \"obsolete epithelial cell of alveolus of lung\")\n24995:# Class: obo:CL_0011108 (colon epithelial cell)\n24997:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") obo:IAO_0000115 obo:CL_0011108 \"Epithelial cell that is part of the colon epithelium.\")\n24998:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0011108 \"colonic epithelial cell\")\n24999:AnnotationAssertion(rdfs:label obo:CL_0011108 \"colon epithelial cell\")\n25114:# Class: obo:CL_0017003 (epithelial cell of prostatic urethra)\n25116:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30566875\") obo:IAO_0000115 obo:CL_0017003 \"An epithelial cell that is part of the prostatic urethra.\")\n25118:AnnotationAssertion(rdfs:label obo:CL_0017003 \"epithelial cell of prostatic urethra\")\n25343:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23720296\") obo:IAO_0000115 obo:CL_0019020 \"An epithelial cell of the extrahepatic bile ducts, including the left and right hepatic duct, common hepatic duct, and common bile duct. They are columnar in shape, and have a large nuclear-to-cytoplasmic ratio relative to small/intrahepatic cholangiocytes.\")\n25777:# Class: obo:CL_1000022 (mesonephric nephron tubule epithelial cell)\n25779:AnnotationAssertion(rdfs:label obo:CL_1000022 \"mesonephric nephron tubule epithelial cell\")\n25818:# Class: obo:CL_1000090 (pronephric nephron tubule epithelial cell)\n25820:AnnotationAssertion(rdfs:label obo:CL_1000090 \"pronephric nephron tubule epithelial cell\")\n25823:# Class: obo:CL_1000123 (metanephric nephron tubule epithelial cell)\n25825:AnnotationAssertion(rdfs:label obo:CL_1000123 \"metanephric nephron tubule epithelial cell\")\n25905:# Class: obo:CL_1000271 (lung multiciliated epithelial cell)\n25907:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27864314\") obo:IAO_0000115 obo:CL_1000271 \"An epithelial cell that is part of the lung epithelium. This cell is characterised by the presence of cilia on its apical surface.\")\n25909:AnnotationAssertion(rdfs:label obo:CL_1000271 \"lung multiciliated epithelial cell\")\n26103:# Class: obo:CL_1000296 (epithelial cell of urethra)\n26105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000296 \"An epithelial cell that is part of the urethra.\")\n26107:AnnotationAssertion(rdfs:label obo:CL_1000296 \"epithelial cell of urethra\")\n26120:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:256516\") oboInOwl:hasExactSynonym obo:CL_1000298 \"squamous mesothelial cell of dura mater\")\n26534:AnnotationAsserti