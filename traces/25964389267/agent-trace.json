{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"rg -n -i 'squamous|cuboidal|epithelial cell|columnar cuboidal' src/ontology/cl-edit.owl\"","aggregated_output":"4452:# Class: obo:CL_0000066 (epithelial cell)\n4461:AnnotationAssertion(rdfs:label obo:CL_0000066 \"epithelial cell\")\n4467:# Class: obo:CL_0000067 (ciliated epithelial cell)\n4469:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000067 \"An epithelial cell that has a cilia.\")\n4471:AnnotationAssertion(rdfs:label obo:CL_0000067 \"ciliated epithelial cell\")\n4474:# Class: obo:CL_0000068 (duct epithelial cell)\n4476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000068 \"An epithelial cell that is part of a duct.\")\n4477:AnnotationAssertion(rdfs:label obo:CL_0000068 \"duct epithelial cell\")\n4481:# Class: obo:CL_0000069 (branched duct epithelial cell)\n4483:AnnotationAssertion(rdfs:label obo:CL_0000069 \"branched duct epithelial cell\")\n4486:# Class: obo:CL_0000070 (obsolete epithelial cell of gland)\n4488:AnnotationAssertion(rdfs:label obo:CL_0000070 \"obsolete epithelial cell of gland\")\n4499:# Class: obo:CL_0000072 (non-branched duct epithelial cell)\n4501:AnnotationAssertion(rdfs:label obo:CL_0000072 \"non-branched duct epithelial cell\")\n4505:# Class: obo:CL_0000073 (obsolete barrier epithelial cell)\n4509:AnnotationAssertion(rdfs:label obo:CL_0000073 \"obsolete barrier epithelial cell\")\n4519:# Class: obo:CL_0000075 (columnar/cuboidal epithelial cell)\n4521:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0002065\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000075 \"A columnar/cuboidal epithelial cell is a cell usually found in a two dimensional sheet with a free surface. Columnar/cuboidal epithelial cells take on the shape of a column or cube.\")\n4522:AnnotationAssertion(rdfs:label obo:CL_0000075 \"columnar/cuboidal epithelial cell\")\n4525:# Class: obo:CL_0000076 (squamous epithelial cell)\n4528:AnnotationAssertion(rdfs:label obo:CL_0000076 \"squamous epithelial cell\")\n4533:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_0000077 \"A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement.\")\n4536:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\n4547:# Class: obo:CL_0000079 (stratified epithelial cell)\n4549:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/B978-0-12-410424-2.00003-2\") Annotation(oboInOwl:hasDbXref \"https://www.biologyonline.com/dictionary/stratified-epithelium\") obo:IAO_0000115 obo:CL_0000079 \"An epithelial cell, organized into multiple layers, with only the basal layer being in contact with the basement membrane.\")\n4550:AnnotationAssertion(rdfs:label obo:CL_0000079 \"stratified epithelial cell\")\n4569:# Class: obo:CL_0000082 (epithelial cell of lung)\n4571:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000082 \"An epithelial cell of the lung.\")\n4573:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000082 \"lung epithelial cell\")\n4574:AnnotationAssertion(rdfs:label obo:CL_0000082 \"epithelial cell of lung\")\n4577:# Class: obo:CL_0000083 (epithelial cell of pancreas)\n4579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000083 \"An epithelial cell of the pancreas.\")\n4581:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000083 \"pancreas epithelial cell\")\n4582:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000083 \"pancreatic epithelial cell\")\n4583:AnnotationAssertion(rdfs:label obo:CL_0000083 \"epithelial cell of pancreas\")\n4751:# Class: obo:CL_0000098 (sensory epithelial cell)\n4753:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000098 \"A specialized epithelial cell involved in sensory perception. Restricted to special sense organs of the olfactory, gustatory, and vestibulocochlear receptor systems; contain sensory cells surrounded by supportive, non-receptive cells.\")\n4754:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000098 \"neuroepithelial cell\")\n4756:AnnotationAssertion(rdfs:comment obo:CL_0000098 \"The term \\\"neuroepithelial cell\\\" is used to describe both this cell type and neurecto-epithelial cell (CL:0000710).\")\n4757:AnnotationAssertion(rdfs:label obo:CL_0000098 \"sensory epithelial cell\")\n4906:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D042783\") Annotation(oboInOwl:hasDbXref \"PMID:21275341\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Endothelial_cell\") Annotation(oboInOwl:hasDbXref \"https://sourceforge.net/tracker/?func=detail&atid=440764&aid=3364936&group_id=36855\") obo:IAO_0000115 obo:CL_0000115 \"An endothelial cell comprises the outermost layer or lining of anatomical structures and can be squamous or cuboidal. In mammals, endothelial cell has vimentin filaments and is derived from the mesoderm.\")\n4911:AnnotationAssertion(rdfs:comment obo:CL_0000115 \"From FMA: 9.07.2001: Endothelial cell has always been classified as a kind of epithelial cell, specifically a squamous cell but that is not true. First, endothelial cell can either be squamous or cuboidal (e.g. high-endothelial cell) and secondly, it has different embryological derivation (mesodermal) than a true epithelial cell (ectodermal and endodermal). The basis for present classification is the fact that it comprises the outermost layer or lining of anatomical structures (location-based) but a better structural basis for the differentia is the cytoskeleton of the cell. Endothelial cell has vimentin filaments while an epithelial cell has keratin filaments. [Onard].\")\n5237:# Class: obo:CL_0000146 (simple columnar epithelial cell)\n5239:AnnotationAssertion(rdfs:label obo:CL_0000146 \"simple columnar epithelial cell\")\n5269:# Class: obo:CL_0000150 (glandular secretory epithelial cell)\n5271:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ORCID:0000-0002-7073-9172\") obo:IAO_0000115 obo:CL_0000150 \"An epithelial cell, located in a gland, that is specialised for the synthesis and secretion of specific biomolecules, such as hormones, or mucous.\")\n5274:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000150 \"glandular epithelial cell\")\n5275:AnnotationAssertion(rdfs:label obo:CL_0000150 \"glandular secretory epithelial cell\")\n5310:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:21907708\") Annotation(oboInOwl:hasDbXref \"PMID:30571046\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Gastric_chief_cell\") obo:IAO_0000115 obo:CL_0000155 \"An epithelial cell of the stomach that is part of the fundic gastric gland. This cell is characterized by a basally located nucleus, abundant rough endoplasmic reticulum, and large apical secretory granules. It produces and secretes pepsinogen, the inactive precursor of the digestive enzyme pepsin.\")\n5356:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D020397\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Goblet_cell\") obo:IAO_0000115 obo:CL_0000160 \"A specialized, columnar, mucus secreting epithelial cell shaped like a flask or goblet. A narrow basal end contains the nucleus while the apical end is swollen by the accumulation of mucus laden secretory granules.  Short microvilli project from the apical plasma membrane.\")\n5377:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31613538\") Annotation(oboInOwl:hasDbXref \"PMID:31670611\") obo:IAO_0000115 obo:CL_0000162 \"An epithelial cell of the stomach that is part of the fundic gastric gland. This cell is characterized by its pyramidal shape, abundant mitochondria, and a complex network of secretory canaliculi lined with microvilli. It secretes hydrochloric acid into the stomach lumen and produces intrinsic factor, essential for vitamin B12 absorption.\")\n5580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"MESH:D022781\") Annotation(oboInOwl:hasDbXref \"PMID:19717280\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatocyte\") obo:IAO_0000115 obo:CL_0000182 \"The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated.\")\n5605:# Class: obo:CL_0000185 (myoepithelial cell)\n5611:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000185 \"basket epithelial cell\")\n5613:AnnotationAssertion(rdfs:label obo:CL_0000185 \"myoepithelial cell\")\n5837:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000213 \"OBSOLETE. A cell within an epithelial cell sheet whose main function is to act as an internal or external covering for a tissue or an organism.\")\n6071:# Class: obo:CL_0000237 (keratinizing barrier epithelial cell)\n6073:AnnotationAssertion(rdfs:label obo:CL_0000237 \"keratinizing barrier epithelial cell\")\n6078:# Class: obo:CL_0000238 (non keratinizing barrier epithelial cell)\n6080:AnnotationAssertion(rdfs:label obo:CL_0000238 \"non keratinizing barrier epithelial cell\")\n6083:# Class: obo:CL_0000239 (brush border epithelial cell)\n6085:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000239 \"An epithelial cell characterized by the presence of a brush border on its apical surface, which increases the surface area for absorption.\")\n6088:AnnotationAssertion(rdfs:comment obo:CL_0000239 \"All brush border cells are columnar-cuboidal.  The formal logical definition of this term asserts this. Brush border epithelial cells are predominantly found lining the small intestine and the proximal tubules of the kidneys.\")\n6089:AnnotationAssertion(rdfs:label obo:CL_0000239 \"brush border epithelial cell\")\n6093:# Class: obo:CL_0000240 (stratified squamous epithelial cell)\n6095:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_squamous_epithelium\") obo:IAO_0000115 obo:CL_0000240 \"A stratified epithelial cell that is part of squamous epithelium, characterized by multiple layers of cells. The basal layer is directly attached to the basement membrane and the apical layer consists of flattened squamous cells. This provides a protective barrier, commonly found in areas subject to abrasion, such as the skin, oral cavity, and esophagus.\")\n6096:AnnotationAssertion(rdfs:label obo:CL_0000240 \"stratified squamous epithelial cell\")\n6100:# Class: obo:CL_0000241 (stratified cuboidal epithelial cell)\n6102:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_cuboidal_epithelium\") obo:IAO_0000115 obo:CL_0000241 \"A stratified epithelial cell that is part of cuboidal epithelium, characterized by multiple layers of cuboidal cells forming the apical layer. This provides a protective lining for ducts in large glands, such as sweat glands.\")\n6103:AnnotationAssertion(rdfs:label obo:CL_0000241 \"stratified cuboidal epithelial cell\")\n6109:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018862\") Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:24862916\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_0000242 \"A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.\")\n6127:# Class: obo:CL_0000244 (transitional epithelial cell)\n6129:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000244 \"A cell characteristically found lining hollow organs that are subject to great mechanical change due to contraction and distention; originally thought to represent a transition between stratified squamous and columnar epithelium.\")\n6131:AnnotationAssertion(rdfs:label obo:CL_0000244 \"transitional epithelial cell\")\n6555:# Class: obo:CL_0000307 (tracheal epithelial cell)\n6557:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000307 \"An epithelial cell found in the trachea.\")\n6560:AnnotationAssertion(rdfs:comment obo:CL_0000307 \"This class is for the vertebrate tracheal structure. For the analagous insect cell type, see 'respiratory tube epithelial cell'\")\n6561:AnnotationAssertion(rdfs:label obo:CL_0000307 \"tracheal epithelial cell\")\n6589:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19256306\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:29713660\") Annotation(oboInOwl:hasDbXref \"PMID:37873034\") obo:IAO_0000115 obo:CL_0000312 \"An epithelial cell of stratified squamous tissues, including skin, oral mucosa (Hiroshima et al., 2011), and esophagus (Whelan et al., 2018), that produces keratin proteins and secretes antimicrobial peptides to form a resilient barrier against environmental damage, dehydration, pathogens, and microbial invasion. It undergoes successive stages of differentiation marked by changes in keratin expression, supporting tissue integrity, wound repair, and contributing to immune defense.\")\n6630:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D012629\") Annotation(oboInOwl:hasDbXref \"PMID:19944183\") obo:IAO_0000115 obo:CL_0000317 \"An epithelial cell that is part of a sebaceous gland. This cell produces and secretes sebum, an oily, lipid-rich substance, through holocrine secretion where the entire cell ruptures to release its contents.\")\n6668:# Class: obo:CL_0000322 (pulmonary alveolar epithelial cell)\n6670:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") obo:IAO_0000115 obo:CL_0000322 \"An epithelial cell that lines the peripheral gas exchange region of the lungs of air-breathing vertebrates.\")\n6677:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolar epithelial cell\")\n6678:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolus of lung epithelial cell\")\n6679:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"epithelial cell of alveolus of lung\")\n6682:AnnotationAssertion(rdfs:label obo:CL_0000322 \"pulmonary alveolar epithelial cell\")\n6969:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Flybase:dsj\") Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000362 \"An epithelial cell of the integument (the outer layer of an organism).\")\n6975:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:62411\") oboInOwl:hasNarrowSynonym obo:CL_0000362 \"epithelial cell of skin\")\n7317:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/hermaphrodite/hypodermis/mainframe.htm\") obo:IAO_0000115 obo:CL_0000411 \"An epithelial cell of the hypodermis of Caenorhabditis.\")\n7368:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/ver1/handbook/hypodermis/hypsupportother.htm#arcadecells\") obo:IAO_0000115 obo:CL_0000418 \"An epithelial cell found in C. elegans that firmly hold the outer body wall and the lips to the inner cylinder of the pharynx in a manner that keeps these organs from breaking apart, while still giving each organ freedom of movement during feeding.\")\n7381:# Class: obo:CL_0000420 (syncytial epithelial cell)\n7383:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000420 \"An epithelial cell that forms a syncytium, which is a multinucleated cell resulting from the fusion of multiple cells.\")\n7385:AnnotationAssertion(rdfs:label obo:CL_0000420 \"syncytial epithelial cell\")\n7444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00412-016-0595-4\") obo:IAO_0000115 obo:CL_0000429 \"A columnar epithelial cell that is part of an insect imaginal disc.\")\n7445:AnnotationAssertion(rdfs:comment obo:CL_0000429 \"This term does not encompass all the cell types that may be found in an epithelial disc (such as the peripodial or adepithelial cells), only the cells that form the disc epithelium proper.\")\n7575:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69078\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000446 \"An epithelial cell of the parathyroid gland that is arranged in wide, irregular interconnecting columns; responsible for the synthesis and secretion of parathyroid hormone.\")\n7716:# Class: obo:CL_0000462 (adepithelial cell)\n7719:AnnotationAssertion(rdfs:label obo:CL_0000462 \"adepithelial cell\")\n7726:AnnotationAssertion(rdfs:comment obo:CL_0000463 \"While insect epidermis is generally columnar/cuboidal, there are certainly well studied cases where it is not (e.g.- Rhodnius prolixus when starved). So it would be safer to add this as a differentium for particular species where this is known. -DSJ.\")\n7775:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000469 \"A neural progenitor cell that is the daughter of a neuroblast (sensu arthopoda).  The progeny of ganglion mother cells develop into neurons, glia and (occasionally) epithelial cells.\")\n7835:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000477 \"A somatic epithelial cell of the insect egg chamber.\")\n8007:# Class: obo:CL_0000500 (follicular epithelial cell)\n8010:AnnotationAssertion(rdfs:label obo:CL_0000500 \"follicular epithelial cell\")\n8015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006107\") obo:IAO_0000115 obo:CL_0000501 \"A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.\")\n8091:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D019879\") Annotation(oboInOwl:hasDbXref \"PMID:29184701\") Annotation(oboInOwl:hasDbXref \"PMID:32308658\") Annotation(oboInOwl:hasDbXref \"PMID:33484640\") obo:IAO_0000115 obo:CL_0000510 \"An epithelial cell found in the basal part of the intestinal glands (crypts of Lieberkuhn) including the appendix. Paneth cells synthesize and secrete lysozyme and cryptdins. Numerous in the deeper parts of the intestinal crypts, particularly in the duodenum, rich in zinc, contain large acidophilic granules, with irregular apical microvilli and prominent membrane-bound vacuoles containing matrix.\")\n8245:# Class: obo:CL_0000529 (pigmented epithelial cell)\n8247:AnnotationAssertion(rdfs:label obo:CL_0000529 \"pigmented epithelial cell\")\n8674:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000570 \"A neuroepithelial cells that occurs singly or in small groups, close to the outer follicular borders but within the follicular basement membrane of the thyroid. This cell expresses a form of the neural cell adhesion molecule (N-CAM) on its surface and secretes calcitonin and serotonin (5-hydroxytryptamine).\")\n8719:# Class: obo:CL_0000575 (corneal epithelial cell)\n8721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000575 \"An epithelial cell of the cornea.\")\n8725:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70551\") oboInOwl:hasExactSynonym obo:CL_0000575 \"epithelial cell of cornea\")\n8726:AnnotationAssertion(rdfs:label obo:CL_0000575 \"corneal epithelial cell\")\n8823:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000584 \"An epithelial cell that has its apical plasma membrane folded into microvilli to provide ample surface for the absorption of nutrients from the intestinal lumen.\")\n9274:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000634 \"A cuboidal cell which along with Boettcher's cells form the floor of the external spiral sulcus, external to the organ of Corti.\")\n9388:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000646 \"Undifferentiated; mitotic stem cell for other epithelial cell types; rounded or elliptical with little cytoplasm and few organelles; contain cytokeratin intermediate filament.\")\n9471:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1101/2021.10.10.463829\") obo:IAO_0000115 obo:CL_0000653 \"A specialized kidney epithelial cell, contained within a glomerulus, that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other podocytes.\")\n9472:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70967\") oboInOwl:hasBroadSynonym obo:CL_0000653 \"epithelial cell of visceral layer of glomerular capsule\")\n9476:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000653 \"glomerular visceral epithelial cell\")\n9527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000658 \"An epithelial cell that secretes cuticle.\")\n9749:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000686 \"A columnar/cuboidal epithelial cell that secretes cerebrospinal fluid.\")\n9904:# Class: obo:CL_0000706 (choroid plexus epithelial cell)\n9910:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000706 \"epithelial cell of choroid plexus\")\n9911:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25729351\") rdfs:comment obo:CL_0000706 \"A choroid plexus epithelial cell possesses non-motile 9+0 cilia. While these cilia can exhibit transient motility during development, they generally do not contribute significantly to the directional flow of cerebrospinal fluid (CSF). Instead, they are primarily involved in sensory functions.\")\n9912:AnnotationAssertion(rdfs:label obo:CL_0000706 \"choroid plexus epithelial cell\")\n9940:# Class: obo:CL_0000710 (neurecto-epithelial cell)\n9942:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000710 \"Epithelial cells derived from neural plate and neural crest.\")\n9943:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000710 \"neuroepithelial cell\")\n9946:AnnotationAssertion(rdfs:comment obo:CL_0000710 \"The term \\\"neuroepithelial cell\\\" is used to describe both this cell type and sensory epithelial cell (CL:0000098).\")\n9947:AnnotationAssertion(rdfs:label obo:CL_0000710 \"neurecto-epithelial cell\")\n10093:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000731 \"urinary tract transitional epithelial cell\")\n11429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11223304\") obo:IAO_0000115 obo:CL_0000846 \"An epithelial cell of the vestibular sensory organ that is characterized by intense enzymatic activities and numerous basal membrane infoldings.\")\n14627:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0002062 \"A squamous pulmonary alveolar epithelial cell that is flattened and branched. A pulmonary alveolar type 1 cell covers more than 98% of the alveolar surface. This large cell has thin (50-100 nm) cytoplasmic extensions to form the air-blood barrier essential for normal gas exchange.\")\n14636:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002062 \"squamous alveolar cell\")\n14637:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002062 \"squamous alveolar lining cell\")\n14638:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002062 \"type 1 alveolar epithelial cells\")\n14641:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002062 \"type I alveolar epithelial cells\")\n14651:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:36138472\") Annotation(oboInOwl:hasDbXref \"PMID:8540632\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0002063 \"A pulmonary alveolar epithelial cell that modulates the fluid surrounding the alveolar epithelium by secreting and recycling surfactants via specialized organelles called alveolar lamellar bodies. This cell type also contributes to tissue repair and can differentiate after injury into a pulmonary alveolar type 1 cell. This cuboidal cell is thicker than squamous alveolar cells, has a rounded apical surface that projects above the level of the surrounding epithelium, and its free surface is covered by short microvilli.\")\n14656:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"cuboidal type II cell\")\n14660:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type 2 alveolar epithelial cell\")\n14664:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002063 \"type II alveolar epithelial cell\")\n14759:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:22288583\") Annotation(oboInOwl:hasDbXref \"PMID:35626748\") Annotation(oboInOwl:hasDbXref \"PMID:38872928\") obo:IAO_0000115 obo:CL_0002071 \"A columnar absorptive epithelial cell found in the epithelium of large intestine, specialized for water and electrolyte absorption. Unlike small intestinal enterocytes, those in the large intestine have fewer apical microvilli.\")\n14807:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15817800\") Annotation(oboInOwl:hasDbXref \"PMID:30291131\") Annotation(oboInOwl:hasDbXref \"PMID:37925434\") obo:IAO_0000115 obo:CL_0002075 \"A rare type of columnar epithelial cell that is part of the tracheobronchial epithelium. This cell is characterized by a distinctive tuft of apical microvilli, which extends into the cytoplasm, and a pear-shaped morphology, broad at the base and tapering to a narrow apex. It plays vital roles in chemosensation, producing cytokines like IL-25, and enhancing mucociliary clearance through acetylcholine release to support mucus movement and airway defense.\")\n14815:# Class: obo:CL_0002076 (endo-epithelial cell)\n14817:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69075\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002076 \"An epithelial cell derived from endoderm.\")\n14821:AnnotationAssertion(rdfs:label obo:CL_0002076 \"endo-epithelial cell\")\n14824:# Class: obo:CL_0002077 (ecto-epithelial cell)\n14826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69074\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002077 \"An epithelial cell derived from ectoderm.\")\n14830:AnnotationAssertion(rdfs:label obo:CL_0002077 \"ecto-epithelial cell\")\n14833:# Class: obo:CL_0002078 (meso-epithelial cell)\n14835:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69076\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002078 \"Epithelial cell derived from mesoderm or mesenchyme.\")\n14840:AnnotationAssertion(rdfs:label obo:CL_0002078 \"meso-epithelial cell\")\n14845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:63099\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:14740223\") obo:IAO_0000115 obo:CL_0002079 \"Epithelial cell found in the ducts of the pancreas. This cell type contributes to the high luminal pH.\")\n14856:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12142741\") Annotation(oboInOwl:hasDbXref \"PMID:20018761\") Annotation(oboInOwl:hasDbXref \"PMID:8185160\") obo:IAO_0000115 obo:CL_0002080 \"A cubodial epithelial cell that is continuous with the lining of intercalated ducts that drain the acinus. This cell type secretes a high pH solution to aid in activation of zymogens, and can differentiate into endocrine and exocrine pancreatic cell types.\")\n15084:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002099 \"epithelial cell of zona glomerulosa of adrenal gland\")\n15580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:28400610\") obo:IAO_0000115 obo:CL_0002145 \"A multi-ciliated epithelial cell located in the trachea and bronchi, characterized by a columnar shape and motile cilia on its apical surface. These cilia facilitate mucociliary clearance by moving mucus and trapped particles toward the pharynx.\")\n15621:# Class: obo:CL_0002149 (epithelial cell of uterus)\n15623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:16960017\") Annotation(oboInOwl:hasDbXref \"PMID:21698266\") obo:IAO_0000115 obo:CL_0002149 \"An epithelial cell of the uterus. This cell has a mesodermal origin.\")\n15627:AnnotationAssertion(rdfs:label obo:CL_0002149 \"epithelial cell of uterus\")\n15633:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015622\") Annotation(oboInOwl:hasDbXref \"PMID:12673090\") obo:IAO_0000115 obo:CL_0002150 \"Epithelioid macrophage is an activated macrophage that resembles an epithelial cell with finely granular, pale eosinophilic cytoplasm and central, ovoid nucleus (oval or elongate). This cell type is able to merge into one another to form aggregates. The presence of such aggregates may characterize some pathologic conditions, mainly granulomatous inflammation.\")\n15655:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/j.autneu.2015.04.008\") obo:IAO_0000115 obo:CL_0002152 \"A simple columnar epithelial cell located in the endocervix.\")\n15664:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0002153 \"The dead keratin-filled squamous cell of the stratum corneum. This cell type lacks a nucleus.\")\n15710:# Class: obo:CL_0002158 (external epithelial cell of tympanic membrane)\n15712:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:5686391\") obo:IAO_0000115 obo:CL_0002158 \"Epithelial cell found on the external side of the tympanic membrane\")\n15716:AnnotationAssertion(rdfs:label obo:CL_0002158 \"external epithelial cell of tympanic membrane\")\n15719:# Class: obo:CL_0002159 (general ecto-epithelial cell)\n15721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002159 \"Epithelial cells derived from general body ectoderm and ectoderm placodes.\")\n15725:AnnotationAssertion(rdfs:label obo:CL_0002159 \"general ecto-epithelial cell\")\n15728:# Class: obo:CL_0002160 (basal external epithelial cell of tympanic membrane)\n15733:AnnotationAssertion(rdfs:label obo:CL_0002160 \"basal external epithelial cell of tympanic membrane\")\n15736:# Class: obo:CL_0002161 (superficial external epithelial cell of tympanic membrane)\n15741:AnnotationAssertion(rdfs:label obo:CL_0002161 \"superficial external epithelial cell of tympanic membrane\")\n15744:# Class: obo:CL_0002162 (internal epithelial cell of tympanic membrane)\n15750:AnnotationAssertion(rdfs:label obo:CL_0002162 \"internal epithelial cell of tympanic membrane\")\n15781:# Class: obo:CL_0002166 (epithelial cell of Malassez)\n15783:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0815129521\") obo:IAO_0000115 obo:CL_0002166 \"An epithelial cell that remains from the disintegration of the epithelial root sheath involved in the development of teeth.\")\n15787:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002166 \"epithelial cell rests of Malassez\")\n15789:AnnotationAssertion(rdfs:label obo:CL_0002166 \"epithelial cell of Malassez\")\n15793:# Class: obo:CL_0002167 (olfactory epithelial cell)\n15799:AnnotationAssertion(rdfs:label obo:CL_0002167 \"olfactory epithelial cell\")\n15816:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:7143026\") obo:IAO_0000115 obo:CL_0002169 \"An epithelial cell located on the basal lamina of the olfactory epithelium.\")\n15838:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17468753\") obo:IAO_0000115 obo:CL_0002171 \"A rounded or elliptical epithelial cell, with pale-staining open face nucleus and pale cytoplasm rich in free ribosomes and clusters of centrioles; form a distinct basal zone spaced slightly from the basal surface of the epithelium.\")\n15914:# Class: obo:CL_0002178 (epithelial cell of stomach)\n15916:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002178 \"An epithelial cell found in the lining of the stomach.\")\n15920:AnnotationAssertion(rdfs:label obo:CL_0002178 \"epithelial cell of stomach\")\n15939:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002180 \"An epithelial cell of the stomach. This cell produces mucous.\")\n15975:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002183 \"A stomach epithelial cell that is olumnar in form with a few short apical microvilli; relatively undifferentiated mitotic cell from which other types of gland are derived; few in number, situated in the isthmus region of the gland and base of the gastric pit.\")\n15987:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:11891623\") obo:IAO_0000115 obo:CL_0002184 \"A flat or angular epithelial cell with condensed nuclei and darkly staining cytoplasm containing numerous intermediate filaments inserted into desmosomes contacting surrounding supporting cells; lie in contact with the basal lamina of olfactory epithelium.\")\n16046:# Class: obo:CL_0002190 (squamous cell of epidermis)\n16052:AnnotationAssertion(rdfs:label obo:CL_0002190 \"squamous cell of epidermis\")\n16134:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:20013317\") obo:IAO_0000115 obo:CL_0002198 \"A large epithelial cell with an extremely acidophilic and granular cytoplasm, containing vast numbers of mitochondria; such cells may undergo neoplastic transformation. From the Greek word onkos meaning swelling, this cell type is found in parathyroid, salivary and thyroid glands.\")\n16174:# Class: obo:CL_0002202 (epithelial cell of tracheobronchial tree)\n16176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002202 \"An epithelial cell of the tracheobronchial tree.\")\n16180:AnnotationAssertion(rdfs:label obo:CL_0002202 \"epithelial cell of tracheobronchial tree\")\n16198:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15817800\") Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36704202\") obo:IAO_0000115 obo:CL_0002204 \"An epithelial cell found in various organs, including the gastrointestinal and respiratory tracts, characterized by a tuft of 120-140 blunt microvilli on its apical surface. This cell exhibits diverse functions depending on its location, which includes chemosensation, initiation of immune responses, contribution to mucociliary clearance, and defense against parasites.\")\n16250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002209 \"An epithelial cell present in the trachea and bronchi; columnar in shape; generally lack cilia; immature forms of ciliated or secretory cells which have been formed from stem cells.\")\n16387:# Class: obo:CL_0002221 (keratinized squamous cell of esophagus)\n16389:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11694559\") obo:IAO_0000115 obo:CL_0002221 \"A squamous cell that has keratin in the esophagus.\")\n16393:AnnotationAssertion(rdfs:label obo:CL_0002221 \"keratinized squamous cell of esophagus\")\n16411:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002223 \"A cell of the transparent layer of simple cuboidal epithelium over the anterior surface of the lens; transform into lens fiber(s).\")\n16418:# Class: obo:CL_0002224 (lens epithelial cell)\n16420:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Lens_%28anatomy%29#Lens_epithelium\") obo:IAO_0000115 obo:CL_0002224 \"A cell of the cuboidal epithelium that covers the lens. The cells of the lens epithelium regulate most of the homeostatic functions of the lens. As ions, nutrients, and liquid enter the lens from the aqueous humor, Na+/K+ ATPase pumps in the lens epithelial cells pump ions out of the lens to maintain appropriate lens osmolarity and volume, with equatorially positioned lens epithelium cells contributing most to this current. The activity of the Na+/K+ ATPases keeps water and current flowing through the lens from the poles and exiting through the equatorial regions. The cells of the lens epithelium also serve as the progenitors for new lens fibers. It constantly lays down fibers in the embryo, fetus, infant, and adult, and continues to lay down fibers for lifelong growth.\")\n16424:AnnotationAssertion(rdfs:label obo:CL_0002224 \"lens epithelial cell\")\n16486:# Class: obo:CL_0002231 (epithelial cell of prostate)\n16488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002231 \"An epithelial cell of the prostate.\")\n16493:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002231 \"prostate epithelial cell\")\n16494:AnnotationAssertion(rdfs:label obo:CL_0002231 \"epithelial cell of prostate\")\n16498:# Class: obo:CL_0002232 (epithelial cell of prostatic duct)\n16500:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002232 \"An epithelial cell of prostatic duct.\")\n16504:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:74224\") oboInOwl:hasExactSynonym obo:CL_0002232 \"ductal epithelial cell of prostate\")\n16505:AnnotationAssertion(rdfs:label obo:CL_0002232 \"epithelial cell of prostatic duct\")\n16510:# Class: obo:CL_0002233 (epithelial cell of prostatic acinus)\n16512:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2673349\") obo:IAO_0000115 obo:CL_0002233 \"An epithelial cell of the prostatic acinus.\")\n16516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:74223\") oboInOwl:hasExactSynonym obo:CL_0002233 \"acinar epithelial cell of prostate\")\n16517:AnnotationAssertion(rdfs:label obo:CL_0002233 \"epithelial cell of prostatic acinus\")\n16527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:74265\") oboInOwl:hasExactSynonym obo:CL_0002234 \"basal epithelial cell of prostatic acinus\")\n16540:# Class: obo:CL_0002236 (basal epithelial cell of prostatic duct)\n16546:AnnotationAssertion(rdfs:label obo:CL_0002236 \"basal epithelial cell of prostatic duct\")\n16549:# Class: obo:CL_0002237 (luminal epithelial cell of prostatic duct)\n16555:AnnotationAssertion(rdfs:label obo:CL_0002237 \"luminal epithelial cell of prostatic duct\")\n16622:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"ISBN:0721694128\") obo:IAO_0000115 obo:CL_0002243 \"A circular smooth muscle cell of the iris, innervated by the ciliary nerves (parasympathetic), and acting to contract the pupil. This muscle cell derives from neuroectoderm. This smooth muscle cell results from transformation of epithelial cells to smooth muscle cells.\")\n16633:# Class: obo:CL_0002244 (squamous cell of ectocervix)\n16635:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:32644501\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/j.autneu.2015.04.008\") Annotation(oboInOwl:hasDbXref \"http://www.bu.edu/histology/p/19404loa.htm\") obo:IAO_0000115 obo:CL_0002244 \"A stratified squamous epithelial cell located in the ectocervix.\")\n16639:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002244 \"ectocervical squamous cell\")\n16640:AnnotationAssertion(rdfs:label obo:CL_0002244 \"squamous cell of ectocervix\")\n16706:# Class: obo:CL_0002251 (epithelial cell of alimentary canal)\n16708:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0002251 \"An epithelial cell of the musculomembranous digestive tube extending from the mouth to the anus.\")\n16711:AnnotationAssertion(rdfs:label obo:CL_0002251 \"epithelial cell of alimentary canal\")\n16715:# Class: obo:CL_0002252 (epithelial cell of esophagus)\n16717:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002252 \"An epithelial cell of the lining of the esophagus.\")\n16721:AnnotationAssertion(rdfs:label obo:CL_0002252 \"epithelial cell of esophagus\")\n16725:# Class: obo:CL_0002253 (epithelial cell of large intestine)\n16727:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002253 \"An epithelial cell of the lining of the large intestine.\")\n16732:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0002253 \"epithelial cell of colon\")\n16733:AnnotationAssertion(rdfs:label obo:CL_0002253 \"epithelial cell of large intestine\")\n16738:# Class: obo:CL_0002254 (epithelial cell of small intestine)\n16740:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002254 \"An epithelial cell of the lining of the small intestine.\")\n16744:AnnotationAssertion(rdfs:label obo:CL_0002254 \"epithelial cell of small intestine\")\n16774:# Class: obo:CL_0002257 (epithelial cell of thyroid gland)\n16776:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002257 \"An epithelial cell of thyroid gland.\")\n16781:AnnotationAssertion(rdfs:label obo:CL_0002257 \"epithelial cell of thyroid gland\")\n16788:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31869123\") obo:IAO_0000115 obo:CL_0002258 \"An epithelial cell that is part of the thyroid follicle epithelium, with a shape that ranges from squamous when inactive to cuboidal or columnar when active, reflecting its hormonal activity. Its apical surface is lined with microvilli projecting into the colloid-filled lumen, where it synthesizes, stores, and secretes the thyroid hormones thyroxine (T4) and triiodothyronine (T3), releasing them into the bloodstream in response to thyroid-stimulating hormone (TSH).\")\n16813:# Class: obo:CL_0002260 (epithelial cell of parathyroid gland)\n16815:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002260 \"An epithelial cell of the parathyroid gland.\")\n16819:AnnotationAssertion(rdfs:label obo:CL_0002260 \"epithelial cell of parathyroid gland\")\n16843:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") obo:IAO_0000115 obo:CL_0002263 \"One of three types of epithelial cells that populate the parathyroid gland; cytological characteristics intermediate between those of the chief cell and of the oxyphil cell. Because only one hormone is produced, the three cell forms are widely believed to be different phases in the life cycle of a single cell type, with the chief cell being its physiologically active stage.\")\n17069:# Class: obo:CL_0002283 (ecto-epithelial cell of viscerocranial mucosa)\n17071:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0323052908\") obo:IAO_0000115 obo:CL_0002283 \"An epithelial cell of the mucosa associated with facial skeleton.\")\n17075:AnnotationAssertion(rdfs:label obo:CL_0002283 \"ecto-epithelial cell of viscerocranial mucosa\")\n17171:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002292 \"A round or oval neuroepithelial cell that contacts other type I cells or capillaries. They occur in clusters that are surrounded by sheath cells (type-II cells) in the carotid body. This cell type is capable of secreting a number of neurotransmitters.\")\n17179:# Class: obo:CL_0002293 (epithelial cell of thymus)\n17181:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n17186:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002293 \"epithelial cell of thymus gland\")\n17189:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002293 \"thymic epithelial cell\")\n17190:AnnotationAssertion(rdfs:label obo:CL_0002293 \"epithelial cell of thymus\")\n17194:# Class: obo:CL_0002294 (type-1 epithelial cell of thymus)\n17196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002294 \"An epithelial cell with a well defined Golgi apparatus that makes up the continuous layer of cells bordering the thymic tissue beneath the capsule.\")\n17200:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18194204\") Annotation(oboInOwl:hasDbXref \"PMID:2694455\") oboInOwl:hasRelatedSynonym obo:CL_0002294 \"subcapsular thymic epithelial cell\")\n17201:AnnotationAssertion(rdfs:label obo:CL_0002294 \"type-1 epithelial cell of thymus\")\n17204:# Class: obo:CL_0002295 (type-6 epithelial cell of thymus)\n17206:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002295 \"A thymic epithelial cell that has an eccentric, round, or irregularly shaped hetero or euchromatic nucleus. The hallmark of this cell type is the presence of vacuoles, which are clustered in one area of the cytoplasm in the vicinity of the nucleus. The vacuoles are small and acquire a grape-like form, occasionally showing delicate internal microvillous projections.\")\n17210:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002295 \"cystic thymic epithelial cells\")\n17212:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002295 \"large medullary thymic epithelial cells\")\n17213:AnnotationAssertion(rdfs:label obo:CL_0002295 \"type-6 epithelial cell of thymus\")\n17216:# Class: obo:CL_0002296 (type-4 epithelial cell of thymus)\n17218:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:0412046911\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002296 \"An epithelial cell with high nuclear and cytoplasmic electron-density. This cell type is found in the deeper portions of the cortex but is more abundant in the medulla of the thymus.\")\n17222:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002296 \"dark thymic epithelial cell\")\n17223:AnnotationAssertion(rdfs:label obo:CL_0002296 \"type-4 epithelial cell of thymus\")\n17227:# Class: obo:CL_0002297 (type-3 epithelial cell of thymus)\n17229:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002297 \"A thymic epithelial cell with moderate nuclear and cytoplasmic electron-density. Scattered in the cortex, this cell type is predominant in the mid and deep cortex.\")\n17233:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002297 \"intermediate thymic epithelial cell\")\n17234:AnnotationAssertion(rdfs:label obo:CL_0002297 \"type-3 epithelial cell of thymus\")\n17237:# Class: obo:CL_0002298 (type-5 epithelial cell of thymus)\n17239:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002298 \"A thymic epithelial cell type with low nuclear and cytoplasmic electrondensity; has a round, euchromatic nucleus and occurs in small groups at the corticomedullary junction or scattered singly in the medulla.\")\n17244:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002298 \"undifferentiated medullary thymic epithelial cell\")\n17245:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002298 \"undifferentiated thymic epithelial cell\")\n17246:AnnotationAssertion(rdfs:label obo:CL_0002298 \"type-5 epithelial cell of thymus\")\n17249:# Class: obo:CL_0002299 (type-2 epithelial cell of thymus)\n17251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002299 \"An epithelial cell scattered in the cortex, predominant in the outer cortex with a large pale nucleus and a prominent nucleolus.\")\n17255:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002299 \"pale thymic epithelial cell\")\n17256:AnnotationAssertion(rdfs:label obo:CL_0002299 \"type-2 epithelial cell of thymus\")\n17259:# Class: obo:CL_0002300 (type-7 epithelial cell of thymus)\n17261:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") obo:IAO_0000115 obo:CL_0002300 \"A small medullary thymic epithelial cell with a spindle shape, often arranged in groups and connected to each other by large desmosomes and interdigitations. The cytoplasm is sparse, with scanty organelles and thick bundles of cytokeratin.\")\n17265:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002300 \"spindle shaped medullary thymic epithelial cell\")\n17266:AnnotationAssertion(rdfs:label obo:CL_0002300 \"type-7 epithelial cell of thymus\")\n17301:# Class: obo:CL_0002303 (pigmented ciliary epithelial cell)\n17303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15106942\") obo:IAO_0000115 obo:CL_0002303 \"A cell that is part of pigmented ciliary epithelium. This cell type uptakes sodium and chloride ions from stromal interstitium and passes the ions to non-pigmented ciliary epithelial cells via gap junctions.\")\n17309:AnnotationAssertion(rdfs:label obo:CL_0002303 \"pigmented ciliary epithelial cell\")\n17313:# Class: obo:CL_0002304 (non-pigmented ciliary epithelial cell)\n17315:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15106942\") obo:IAO_0000115 obo:CL_0002304 \"A cell that is part of non-pigmented ciliary epithelium. This cell type participates in aqueous humor formation by releasing solute, principally sodium and chloride ions received from pigmented epithelial cells via gap junctions, into the aqueous humor of the eye.\")\n17320:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10913011\") oboInOwl:hasExactSynonym obo:CL_0002304 \"nonpigmented ciliary epithelial cell\")\n17322:AnnotationAssertion(rdfs:label obo:CL_0002304 \"non-pigmented ciliary epithelial cell\")\n17326:# Class: obo:CL_0002305 (epithelial cell of distal tubule)\n17328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002305 \"An epithelial cell of the distal convoluted tubule of the kidney that helps regulate systemic levels of potassium, sodium, calcium, and pH.\")\n17331:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002305 \"kidney distal tubule epithelial cell\")\n17332:AnnotationAssertion(rdfs:label obo:CL_0002305 \"epithelial cell of distal tubule\")\n17339:# Class: obo:CL_0002306 (epithelial cell of proximal tubule)\n17341:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:1-4160-2328-3\") obo:IAO_0000115 obo:CL_0002306 \"An epithelial cell of the proximal tubule of the kidney.\")\n17344:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002306 \"kidney proximal tubule epithelial cell\")\n17345:AnnotationAssertion(rdfs:comment obo:CL_0002306 \"The vast majority of proximal tubule epithelial cells have a brush border, but there are rare exceptions.\")\n17346:AnnotationAssertion(rdfs:label obo:CL_0002306 \"epithelial cell of proximal tubule\")\n17354:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:1-4160-2328-3\") Annotation(oboInOwl:hasDbXref \"PMID:23799132\") obo:IAO_0000115 obo:CL_0002307 \"A brush border epithelial cell located in the proximal tubule of the kidney, essential for reabsorbing substances like glucose and amino acids from the glomerular filtrate. These cells also secrete organic ions, playing a crucial role in maintaining kidney homeostasis, including electrolyte and acid-base balance, and excreting metabolic waste.\")\n17357:AnnotationAssertion(rdfs:comment obo:CL_0002307 \"The vast majority of proximal tubule epithelial cells have a brush border, but there are rare exceptions.\")\n17362:# Class: obo:CL_0002308 (epithelial cell of skin gland)\n17364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002308 \"An epithelial cell of a skin gland.\")\n17368:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002308 \"epithelial cell of gland of skin\")\n17369:AnnotationAssertion(rdfs:label obo:CL_0002308 \"epithelial cell of skin gland\")\n17429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002313 \"An ecto-epithelial cell of the prostate gland that secretes hormones.\")\n17436:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002313 \"neuro-epithelial cell of prostate gland\")\n17479:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:14592528\") obo:IAO_0000115 obo:CL_0002318 \"A mesothelial cell capable of circulating in the blood by first losing its squamous character. This cell can incorporate into the regenerating mesothelium.\")\n17544:# Class: obo:CL_0002324 (basal-myoepithelial cell of mammary gland)\n17546:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11250738\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") Annotation(oboInOwl:hasDbXref \"PMID:38059556\") obo:IAO_0000115 obo:CL_0002324 \"A myoepithelial cell that is part of a mammary gland and is located in the basal layer. During lactation, a basal-myoepithelial cell of mammary gland contracts under the stimulation of oxytocin. In humans, a basal-myoepithelial cell of mammary gland can be identified by high levels of CD49f and low levels of EpCAM.\")\n17551:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37694522\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal myoepithelial cell\")\n17552:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal-myoepithelial cell\")\n17555:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11250738\") oboInOwl:hasExactSynonym obo:CL_0002324 \"myoepithelial cell of mammary gland\")\n17557:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0002324 \"myoepithelial cell of lactiferous gland\")\n17561:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38059556\") rdfs:comment obo:CL_0002324 \"Due inconsistencies in naming this and other mammary gland epithelial cell types, several mammary gland experts gathered for a breast atlas annotation jamboree organized by Chan-Zuckerberg initiative. They agreed to label this cell type as basal-myoepithelial cell (and abbreviated: B-Myo cell).\")\n17562:AnnotationAssertion(rdfs:label obo:CL_0002324 \"basal-myoepithelial cell of mammary gland\")\n17568:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") Annotation(oboInOwl:hasDbXref \"PMID:28717367\") Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasDbXref \"PMID:35377806\") Annotation(oboInOwl:hasDbXref \"doi:10.1177/156482659601700404\") obo:IAO_0000115 obo:CL_0002325 \"A milk-producing glandular epithelial cell that is part of a mammary gland alveolus and differentiates from a luminal adaptive secretory precursor cell during secretory differentiation (also termed lactogenesis I). Following secretory activation (also termed lactogenesis II), a lactocyte is involved in the synthesis and/or transport of milk constituents including proteins, oligosaccharides, lactose, micronutrients, fat, hormones, immunoglobulins, and cytokines into the lumen of the lactating mammary gland.\")\n17576:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002325 \"epithelial cell of lactiferous gland\")\n17577:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") oboInOwl:hasExactSynonym obo:CL_0002325 \"lactaction-associated mammary epithelial cell\")\n17580:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002325 \"mammary alveolar epithelial cell\")\n17581:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002325 \"mammary gland alveolar epithelial cell\")\n17589:# Class: obo:CL_0002326 (luminal epithelial cell of mammary gland)\n17591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") obo:IAO_0000115 obo:CL_0002326 \"A mammary epithelial cell that occurs in the lumen of the ductal and alveoli structure in the breast.\")\n17596:AnnotationAssertion(rdfs:label obo:CL_0002326 \"luminal epithelial cell of mammary gland\")\n17601:# Class: obo:CL_0002327 (mammary gland epithelial cell)\n17603:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") obo:IAO_0000115 obo:CL_0002327 \"An epithelial cell of the mammary gland.\")\n17607:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002327 \"breast epithelial cell\")\n17608:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002327 \"mammary epithelial cell\")\n17609:AnnotationAssertion(rdfs:label obo:CL_0002327 \"mammary gland epithelial cell\")\n17612:# Class: obo:CL_0002328 (bronchial epithelial cell)\n17614:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002328 \"An epithelial cell of the bronchus.\")\n17618:AnnotationAssertion(rdfs:label obo:CL_0002328 \"bronchial epithelial cell\")\n17622:# Class: obo:CL_0002329 (basal epithelial cell of tracheobronchial tree)\n17624:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002329 \"An epithelial cell type that lacks the columnar shape typical for other respiratory epithelial cells. This cell type is able to differentiate into other respiratory epithelial cells in response to injury.\")\n17627:AnnotationAssertion(rdfs:label obo:CL_0002329 \"basal epithelial cell of tracheobronchial tree\")\n17644:# Class: obo:CL_0002332 (multiciliated epithelial cell of the bronchus)\n17646:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18757316\") obo:IAO_0000115 obo:CL_0002332 \"A multi-ciliated epithelial cell located in the bronchus epithelium, characterized by a columnar shape and motile cilia on its apical surface.\")\n17649:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002332 \"ciliated epithelial cell of the bronchus\")\n17650:AnnotationAssertion(rdfs:label obo:CL_0002332 \"multiciliated epithelial cell of the bronchus\")\n17689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15339667\") Annotation(oboInOwl:hasDbXref \"PMID:20568222\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") obo:IAO_0000115 obo:CL_0002337 \"A stem cell found in the basal layer of the epidermis, hair follicle, and sebaceous gland, characterised by its quiescent nature, high proliferative potential, and capacity for long-term self-renewal. This cell maintains epidermal homeostasis by producing transit-amplifying cells that differentiate to replenish the stratified squamous epithelium.\")\n17711:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15226377\") obo:IAO_0000115 obo:CL_0002339 \"A prostate epithelial cell that is CD133-positive, CD44-positive, integrin A2beta3-high. This cell is a stem cell for the prostate epithelium.\")\n17714:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002339 \"CD133-positive prostate epithelial cell\")\n17722:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002340 \"The exocrine cell of the prostate, this epithelial cell secretes prostatic acid phosphotase and PSA, and is dependent on androgen hormones for survival.\")\n17960:# Class: obo:CL_0002364 (cortical thymic epithelial cell)\n17962:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18403190\") obo:IAO_0000115 obo:CL_0002364 \"An epithelial cell of the cortical portion of the thymus. Epithelial cells in this region are required for positive selection of CD8-positive T cells.\")\n17967:AnnotationAssertion(rdfs:label obo:CL_0002364 \"cortical thymic epithelial cell\")\n17971:# Class: obo:CL_0002365 (medullary thymic epithelial cell)\n17973:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18180458\") obo:IAO_0000115 obo:CL_0002365 \"An epithelial cell of the medullary thymus. This cell type expresses a diverse range of tissue-specific antigens. This promiscuous gene expression is a cell-autonomous property of medullary epithelial cells and is maintained during the entire period of thymic T cell output.\")\n17978:AnnotationAssertion(rdfs:label obo:CL_0002365 \"medullary thymic epithelial cell\")\n18002:# Class: obo:CL_0002368 (respiratory tract epithelial cell)\n18004:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002368 \"An epithelial cell of the respiratory tract epithelium.  These cells have an endodermal origin.\")\n18008:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002368 \"airway epithelial cell\")\n18009:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002368 \"respiratory epithelial cell\")\n18010:AnnotationAssertion(rdfs:label obo:CL_0002368 \"respiratory tract epithelial cell\")\n18025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0002370 \"A simple columnar epithelial cell that secretes mucin. Rough endoplasmic reticulum, mitochondria, the nucleus, and other organelles are concentrated in the basal portion. The apical plasma membrane projects microvilli to increase surface area for secretion.\")\n18125:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.aippg.net/forum/viewtopic.php?t=62590\") obo:IAO_0000115 obo:CL_0002379 \"A neurecto-epithelial cell found in the arachnoid villi of dura mater. This cell type facilitates flow of cerebrospinal fluid into the blood.\")\n18841:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:hjd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15987436\") Annotation(oboInOwl:hasDbXref \"PMID:16397499\") Annotation(oboInOwl:hasDbXref \"PMID:17851544\") obo:IAO_0000115 obo:CL_0002451 \"A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.\")\n19145:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cjm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0006420\") obo:IAO_0000115 obo:CL_0002481 \"The flattened smooth myoepithelial cells of mesodermal origin that lie just outside the basal lamina of the seminiferous tubule.\")\n19235:# Class: obo:CL_0002491 (auditory epithelial cell)\n19240:AnnotationAssertion(rdfs:label obo:CL_0002491 \"auditory epithelial cell\")\n19499:# Class: obo:CL_0002518 (kidney epithelial cell)\n19501:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"KUPO:SJ\") obo:IAO_0000115 obo:CL_0002518 \"An epithelial cell of the kidney.\")\n19505:AnnotationAssertion(rdfs:label obo:CL_0002518 \"kidney epithelial cell\")\n19509:# Class: obo:CL_0002519 (interrenal epithelial cell)\n19511:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mh\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12668625\") obo:IAO_0000115 obo:CL_0002519 \"An interrenal epithelial kidney cell is an epithelial cell found in the anterior kidney of teleosts fish. This cell type is arranged in layers around the posterior cardinal vein and contains many mitochondria with tubulovesicular cristae. Interrenal chromaffin cells are interspersed among the tissue layer created by this cell type.\")\n19514:AnnotationAssertion(rdfs:label obo:CL_0002519 \"interrenal epithelial cell\")\n19548:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002523 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the mesonephros.\")\n19552:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0001674\") oboInOwl:hasExactSynonym obo:CL_0002523 \"mesonephric glomerular visceral epithelial cell\")\n19567:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002525 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the metanephros.\")\n19570:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s004180050142\") oboInOwl:hasExactSynonym obo:CL_0002525 \"metanephric glomerular visceral epithelial cell\")\n19648:# Class: obo:CL_0002535 (epithelial cell of cervix)\n19650:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002535 \"An epithelial cell of the cervix.\")\n19653:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") oboInOwl:hasExactSyno