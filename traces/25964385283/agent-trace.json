O_0000115 obo:CL_2000050 \"Any retinal ganglion cell that is part of a retina.\")\n29332:AnnotationAssertion(rdfs:label obo:CL_2000050 \"obsolete retina retinal ganglion cell\")\n30241:# Class: obo:CL_4023032 (ON retinal ganglion cell)\n30244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\n30245:AnnotationAssertion(rdfs:label obo:CL_4023032 \"ON retinal ganglion cell\")\n30248:# Class: obo:CL_4023033 (OFF retinal ganglion cell)\n30250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\n30252:AnnotationAssertion(rdfs:label obo:CL_4023033 \"OFF retinal ganglion cell\")\n31292:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\n31303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\n31308:AnnotationAssertion(rdfs:comment obo:CL_4023189 \"These cells should not be confused with M1-M14 retinal ganglion cells described in PMID:16626866 which refer to a different classification of retinal ganglion cells.\")\n32630:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\n32641:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\n32646:# Class: obo:CL_4033053 (small bistratified retinal ganglion cell)\n32648:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\n32656:AnnotationAssertion(rdfs:label obo:CL_4033053 \"small bistratified retinal ganglion cell\")\n","exit_code":0,"status":"completed"}}
