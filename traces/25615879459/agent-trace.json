luesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015665)))\n30059:SubClassOf(obo:CL_4023017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n30060:SubClassOf(obo:CL_4023017 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n30062:# Class: obo:CL_4023018 (pvalb GABAergic interneuron)\n30064:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023018 \"pvalb interneuron\")\n30065:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023018 \"A transcriptomically distinct GABAergic interneuron with a soma located in the pallium. These neurons express Parvalbumin.\")\n30066:AnnotationAssertion(terms:contributor obo:CL_4023018 <https://orcid.org/0000-0001-7258-9596>)\n30067:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023018 \"ILX:0770154\")\n30068:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023018 cl:BDS_subset)\n30069:AnnotationAssertion(rdfs:comment obo:CL_4023018 \"Historically this term was used to refer to all Pvalb expressing GABAergic interneurons, but transcriptomic classification separates out some Pvalb expressing GABAergic interneurons as sibling classes (e.g. Pvalb chandelier).  We follow the transcriptomic classifications.\")\n30070:AnnotationAssertion(rdfs:label obo:CL_4023018 \"pvalb GABAergic interneuron\")\n30071:SubClassOf(obo:CL_4023018 obo:CL_0000099)\n30072:SubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n30073:SubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n30074:SubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30075:SubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n30077:# Class: obo:CL_4023019 (L5/6 cck, VIP GABAergic interneuron (Mmus))\n30079:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023019 \"A VIP GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\n30080:AnnotationAssertion(terms:contributor obo:CL_4023019 <https://orcid.org/0000-0001-7258-9596>)\n30081:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023019 \"L5/6 CCK Vip (Mus musculus)\")\n30082:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023019 cl:BDS_subset)\n30083:AnnotationAssertion(rdfs:label obo:CL_4023019 \"L5/6 cck, VIP GABAergic interneuron (Mmus)\")\n30084:EquivalentClasses(obo:CL_4023019 ObjectIntersectionOf(obo:CL_4023071 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648)))\n30086:# Class: obo:CL_4023020 (dynamic gamma motor neuron)\n30088:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023020 \"A gamma motor neuron that innervates dynamic nuclear bag fibers (bag1 fibers) and enhances the sensitivities of Ia sensory neurons. They alter muscle spindle sensitivity and increases its discharge in response to velocity of muscle length (rather than just magnitude).\")\n30089:AnnotationAssertion(terms:contributor obo:CL_4023020 <https://orcid.org/0000-0001-7258-9596>)\n30090:AnnotationAssertion(rdfs:label obo:CL_4023020 \"dynamic gamma motor neuron\")\n30091:SubClassOf(obo:CL_4023020 obo:CL_0008037)\n30092:SubClassOf(obo:CL_4023020 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_4023005))\n30094:# Class: obo:CL_4023021 (static gamma motor neuron)\n30096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023021 \"A gamma motor neuron that innervates static nuclear bag fibers (bag2 fibers) and increases their firing, in response to an increase in the magnitude of change in length, and controls the static sensitivity of the stretch reflex.\")\n30097:AnnotationAssertion(terms:contributor obo:CL_4023021 <https://orcid.org/0000-0001-7258-9596>)\n30098:AnnotationAssertion(rdfs:label obo:CL_4023021 \"static gamma motor neuron\")\n30099:SubClassOf(obo:CL_4023021 obo:CL_0008037)\n30100:SubClassOf(obo:CL_4023021 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_4023006))\n30102:# Class: obo:CL_4023022 (canopy lamp5 GABAergic cortical interneuron (Mmus))\n30104:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023022 \"canopy lamp5 interneuron\")\n30105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") obo:IAO_0000115 obo:CL_4023022 \"A Lamp5 GABAergic cortical interneuron that has extended axons in the surface of L1. Canopy Lamp5 cells resemble neurogliaform cells in having elongated horizontal axonal arbors largely confined to L1; but the dendritic arbors are wider and have fewer branches, while the axon is less tortuous and extends further from the soma\")\n30106:AnnotationAssertion(terms:contributor obo:CL_4023022 <https://orcid.org/0000-0001-7258-9596>)\n30107:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023022 cl:BDS_subset)\n30108:AnnotationAssertion(rdfs:label obo:CL_4023022 \"canopy lamp5 GABAergic cortical interneuron (Mmus)\")\n30109:SubClassOf(obo:CL_4023022 obo:CL_0000099)\n30110:SubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30111:SubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30112:SubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30113:SubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n30115:# Class: obo:CL_4023023 (L5,6 neurogliaform lamp5 GABAergic interneuron (Mmus))\n30117:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023023 \"L5,6 NGC Lamp5 interneuron (Mus)\")\n30118:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023023 \"A lamp 5 GABAergic cortical interneuron with neurogliaform morphology with a soma found in L5,6. L5,6 NGC lamp5 have deep afterhyperpolarization (AHP) but narrow action potentials (APs). Unlike other deep neurogliaform cells (which are caudal ganglionic eminence (CGE) derived), L5,6 NGC lamp5 cells are medial ganglionic eminence (MGE)-derived\")\n30119:AnnotationAssertion(terms:contributor obo:CL_4023023 <https://orcid.org/0000-0001-7258-9596>)\n30120:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023023 \"L5,6 NGC Lamp5 (Mus musculus)\")\n30121:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023023 cl:BDS_subset)\n30122:AnnotationAssertion(rdfs:label obo:CL_4023023 \"L5,6 neurogliaform lamp5 GABAergic interneuron (Mmus)\")\n30123:SubClassOf(obo:CL_4023023 obo:CL_0000099)\n30124:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070001))\n30125:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30126:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30127:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30128:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n30130:# Class: obo:CL_4023024 (neurogliaform lamp5 GABAergic cortical interneuron (Mmus))\n30132:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023024 \"NGC Lamp5 interneuron (Mus)\")\n30133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") obo:IAO_0000115 obo:CL_4023024 \"A lamp5 GABAergic cortical interneuron with layer-adapting morphology. NGC lamp5 cells have a small round soma, short dendrites, and a wide dense axonal arbor that tends to establish a dense axonal mesh with high connection probability both to themselves and L2 pyramidal cells. NGC lamp5 cells have unique synaptic properties that distinguish them from other GABAergic interneurons, including the release of GABA to the extracellular space via volume transmission, and the ability to produce GABA-B responses in connected postsynaptic targets.\")\n30134:AnnotationAssertion(terms:contributor obo:CL_4023024 <https://orcid.org/0000-0001-7258-9596>)\n30135:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023024 \"NGC Lamp5 (Mus musculus)\")\n30136:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023024 cl:BDS_subset)\n30137:AnnotationAssertion(rdfs:label obo:CL_4023024 \"neurogliaform lamp5 GABAergic cortical interneuron (Mmus)\")\n30138:SubClassOf(obo:CL_4023024 obo:CL_0000099)\n30139:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070001))\n30140:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30141:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30142:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30143:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n30145:# Class: obo:CL_4023025 (long-range projecting sst GABAergic cortical interneuron (Mmus))\n30147:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023025 \"A sst GABAergic cortical interneuron that is both an interneuron and a projecting neuron. They are found in all layers from upper L2/3 down to the bottom of L6. They have long-range projections, some with axons fading into white matter. These cells have low rebound potential, low hyperpolarization sag, and high variability in membrane time constant.\")\n30148:AnnotationAssertion(terms:contributor obo:CL_4023025 <https://orcid.org/0000-0001-7258-9596>)\n30149:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023025 \"LP SST (Mus musculus)\")\n30150:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023025 cl:BDS_subset)\n30151:AnnotationAssertion(rdfs:label obo:CL_4023025 \"long-range projecting sst GABAergic cortical interneuron (Mmus)\")\n30152:SubClassOf(obo:CL_4023025 obo:CL_4023121)\n30153:SubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30154:SubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30155:SubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30156:SubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n30158:# Class: obo:CL_4023026 (direct pathway medium spiny neuron)\n30160:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023026 \"A medium spiny neuron that expresses dopamine type 1 receptors and projects to the globus pallidus internus or the substantia nigra pars reticulata.\")\n30161:AnnotationAssertion(terms:contributor obo:CL_4023026 <https://orcid.org/0000-0001-7258-9596>)\n30162:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023026 \"D1-MSN\")\n30163:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023026 \"dSPN\")\n30164:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023026 \"dopamine 1 medium spiny neuron\")\n30165:AnnotationAssertion(rdfs:label obo:CL_4023026 \"direct pathway medium spiny neuron\")\n30166:SubClassOf(obo:CL_4023026 obo:CL_1001474)\n30167:SubClassOf(obo:CL_4023026 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\n30169:# Class: obo:CL_4023027 (L5 sst T-Martinotti interneuron (Mmus))\n30171:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023027 \"L5 T Martinotti sst interneuron (Mus)\")\n30172:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023027 \"A sst GABAergic cortical interneuron with a soma found in L5 and possesses 'T-shaped' Martinotti morphologies with local axonal plexus in L5a and translaminar axons restricted to the uppermost part of L1. They show low-threshold spiking patterns with strong rebound firing, and inhibit the L1 apical tuft of nearby pyramidal cells.\")\n30173:AnnotationAssertion(terms:contributor obo:CL_4023027 <https://orcid.org/0000-0001-7258-9596>)\n30174:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023027 \"L5 T Martinotti SST (Mus musculus)\")\n30175:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023027 cl:BDS_subset)\n30176:AnnotationAssertion(rdfs:label obo:CL_4023027 \"L5 sst T-Martinotti interneuron (Mmus)\")\n30177:SubClassOf(obo:CL_4023027 obo:CL_0000099)\n30178:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070008))\n30179:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30180:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394))\n30181:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30182:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30183:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n30185:# Class: obo:CL_4023028 (L5 non-Martinotti sst GABAergic interneuron (Mmus))\n30187:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023028 \"L5 non-Martinotti sst interneuron (Mus)\")\n30188:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023028 \"A sst GABAergic cortical interneuron with a soma found in lower L5 with mostly local axonal arborization but with some sparse ascending axons. L5 non-Martinotti sst cells show somatic localization and local axon plexus in L5b and L5b/6 and substantial innervation of L3 and L4, and receive thalamic input from the ventral posteromedial nucleus and specifically target L4 neurons, avoiding L5 pyramidal cells. L5 non-Martinotti sst cells tend to show a higher input resistance and seem to be less stuttering.\")\n30189:AnnotationAssertion(terms:contributor obo:CL_4023028 <https://orcid.org/0000-0001-7258-9596>)\n30190:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023028 \"L5 non-Martinotti SST (Mus musculus)\")\n30191:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023028 cl:BDS_subset)\n30192:AnnotationAssertion(rdfs:label obo:CL_4023028 \"L5 non-Martinotti sst GABAergic interneuron (Mmus)\")\n30193:SubClassOf(obo:CL_4023028 obo:CL_0000099)\n30194:SubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394))\n30195:SubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30196:SubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30197:SubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n30199:# Class: obo:CL_4023029 (indirect pathway medium spiny neuron)\n30201:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023029 \"A medium spiny neuron that expresses dopamine type 2 receptors and projects to the external globus pallidus.\")\n30202:AnnotationAssertion(terms:contributor obo:CL_4023029 <https://orcid.org/0000-0001-7258-9596>)\n30203:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"D2-MSN\")\n30204:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023029 \"dopamine 2 medium spiny neuron\")\n30205:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"iSPN\")\n30206:AnnotationAssertion(rdfs:label obo:CL_4023029 \"indirect pathway medium spiny neuron\")\n30207:SubClassOf(obo:CL_4023029 obo:CL_1001474)\n30208:SubClassOf(obo:CL_4023029 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001177))\n30210:# Class: obo:CL_4023030 (L2/3/5 fan Martinotti sst GABAergic interneuron (Mmus))\n30212:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023030 \"L2/3/5 fan Martinotti sst interneuron (Mus)\")\n30213:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27225074\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023030 \"A sst GABAergic cortical interneuron that has \\\"fanning-out' Martinotti morphology that is found in layer 2/3/5 of the cerebral cortex. They have local axon arbor and long ascending axons that spreads horizontally and arborizes significantly in L1.\")\n30214:AnnotationAssertion(terms:contributor obo:CL_4023030 <https://orcid.org/0000-0001-7258-9596>)\n30215:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023030 \"L2/3/5 fan Martinotti SST (Mus musculus)\")\n30216:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023030 cl:BDS_subset)\n30217:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023030 \"L2/3/5 fan Martionotti SST cells have an adapting firing pattern and non-zero afterdepolarization (ADP).\")\n30218:AnnotationAssertion(rdfs:label obo:CL_4023030 \"L2/3/5 fan Martinotti sst GABAergic interneuron (Mmus)\")\n30219:SubClassOf(obo:CL_4023030 obo:CL_0000099)\n30220:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070009))\n30221:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30222:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30223:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30224:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n30226:# Class: obo:CL_4023031 (L4 sst Martinotti interneuron (Mmus))\n30228:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023031 \"L4 sst interneuron (Mus)\")\n30229:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023031 \"A sst GABAergic cortical interneuron with a soma found in lower L2/3 and upper 5, L4 Sst cells have Martinotti morphology with ascending axons but denser local axons and sparser ‘fanning-out’ projections to L1. L4 sst cells have smaller membrane time constant to calb2 (L2/3/5 fan Martinotti Cell) and non-zero afterdepolarization (ADP).\")\n30230:AnnotationAssertion(terms:contributor obo:CL_4023031 <https://orcid.org/0000-0001-7258-9596>)\n30231:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023031 \"L4 SST (Mus musculus)\")\n30232:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023031 cl:BDS_subset)\n30233:AnnotationAssertion(rdfs:label obo:CL_4023031 \"L4 sst Martinotti interneuron (Mmus)\")\n30234:SubClassOf(obo:CL_4023031 obo:CL_0000099)\n30235:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070007))\n30236:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005393))\n30237:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30238:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30239:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n30241:# Class: obo:CL_4023032 (ON retinal ganglion cell)\n30243:AnnotationAssertion(terms:contributor obo:CL_4023032 <http://orcid.org/0000-0001-7258-9596>)\n30244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\n30245:AnnotationAssertion(rdfs:label obo:CL_4023032 \"ON retinal ganglion cell\")\n30246:SubClassOf(obo:CL_4023032 obo:CL_0000740)\n30248:# Class: obo:CL_4023033 (OFF retinal ganglion cell)\n30250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\n30251:AnnotationAssertion(terms:contributor obo:CL_4023033 <http://orcid.org/0000-0001-7258-9596>)\n30252:AnnotationAssertion(rdfs:label obo:CL_4023033 \"OFF retinal ganglion cell\")\n30253:SubClassOf(obo:CL_4023033 obo:CL_0000740)\n30255:# Class: obo:CL_4023034 (obsolete L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus))\n30257:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023034 \"OBSOLETE A sst GABAergic cortical interneuron transcriptomically between the sst and the pvalb families with a soma found in L2/3. Some L2/3 PV-like sst cells have Martinotti morphology while some have basket cell morphology. L2/3 PV-like sst cells have lower AP width and higher firing rate than typical Sst subclass cells. L2/3 PV-like sst cells have high maximum firing rate variability, with many classified as belonging to the pvalb subclass on the basis of electrophysiology.\")\n30258:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023034 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n30259:AnnotationAssertion(obo:IAO_0100001 obo:CL_4023034 obo:PCL_1000002)\n30260:AnnotationAssertion(terms:contributor obo:CL_4023034 <https://orcid.org/0000-0001-7258-9596>)\n30261:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023034 \"L2/3 PV-like SST Mus)\")\n30262:AnnotationAssertion(rdfs:comment obo:CL_4023034 \"Moved to PCL. Use PCL:1000002 instead.\")\n30263:AnnotationAssertion(rdfs:label obo:CL_4023034 \"obsolete L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus)\")\n30264:AnnotationAssertion(owl:deprecated obo:CL_4023034 \"true\"^^xsd:boolean)\n30266:# Class: obo:CL_4023035 (lateral ganglionic eminence derived neuron)\n30268:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipediaversioned:Ganglionic_eminence&oldid=1186824360\") obo:IAO_0000115 obo:CL_4023035 \"A neuron that is derived from a precursor cell in the lateral ganglion eminence.\")\n30269:AnnotationAssertion(terms:contributor obo:CL_4023035 \"https://orcid.org/0000-0001-7258-9596\")\n30270:AnnotationAssertion(terms:contributor obo:CL_4023035 \"https://orcid.org/0000-0002-7073-9172\")\n30271:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377350\") oboInOwl:hasExactSynonym obo:CL_4023035 \"LGE-derived neuron\")\n30272:AnnotationAssertion(rdfs:label obo:CL_4023035 \"lateral ganglionic eminence derived neuron\"@en)\n30273:EquivalentClasses(obo:CL_4023035 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004025)))\n30274:SubClassOf(obo:CL_4023035 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n30276:# Class: obo:CL_4023036 (pvalb chandelier GABAergic interneuron)\n30278:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023036 \"Pvalb Chandelier\")\n30279:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4023036 \"A transcriptomically distinct pvalb GABAergic interneuron located in the pallium. It is recognizable by the straight terminal axonal 'cartridges' of vertically oriented strings of synaptic boutons. Chandelier PV cells' boutons target exclusively the axon initial segment (AIS) of pyramidal cells, with a single cell innervating hundreds of pyramidal cells in a clustered manner.  These cells are fast-spiking.\")\n30280:AnnotationAssertion(terms:contributor obo:CL_4023036 <https://orcid.org/0000-0001-7258-9596>)\n30281:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:33862423\") Annotation(oboInOwl:hasDbXref \"PMID:39012795\") oboInOwl:hasBroadSynonym obo:CL_4023036 \"axo-axonic cell\")\n30282:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0107356\")\n30283:AnnotationAssertion(Annotation(obo:IAO_0000116 \"Interlex cross reference refers specifically to Markram 2015 rat chandelier cell.\") oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0777213\")\n30284:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier PV\")\n30285:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier cell\")\n30286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023036 \"ChC\")\n30287:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023036 cl:BDS_subset)\n30288:AnnotationAssertion(rdfs:label obo:CL_4023036 \"pvalb chandelier GABAergic interneuron\")\n30289:SubClassOf(obo:CL_4023036 obo:CL_0000099)\n30290:SubClassOf(obo:CL_4023036 obo:CL_4023069)\n30291:SubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070011))\n30292:SubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n30293:SubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30294:SubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n30296:# Class: obo:CL_4023038 (L6b glutamatergic cortical neuron)\n30298:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023038 \"L6b glut\")\n30299:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023038 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate.\")\n30300:AnnotationAssertion(terms:contributor obo:CL_4023038 <https://orcid.org/0000-0001-7258-9596>)\n30301:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023038 \"ILX:0770163\")\n30302:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023038 cl:BDS_subset)\n30303:AnnotationAssertion(rdfs:label obo:CL_4023038 \"L6b glutamatergic cortical neuron\")\n30304:EquivalentClasses(obo:CL_4023038 ObjectIntersectionOf(obo:CL_0000679 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440003)))\n30306:# Class: obo:CL_4023039 (amygdala excitatory neuron)\n30308:AnnotationAssertion(terms:contributor obo:CL_4023039 <http://orcid.org/0000-0001-7258-9596>)\n30309:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4023039 \"An excitatory neuron that is located in the amygdala.\")\n30310:AnnotationAssertion(rdfs:label obo:CL_4023039 \"amygdala excitatory neuron\")\n30311:EquivalentClasses(obo:CL_4023039 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001876) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535)))\n30313:# Class: obo:CL_4023040 (L2/3-6 intratelencephalic projecting glutamatergic neuron)\n30315:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023040 \"L2/3-6 IT glut\")\n30316:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4023040 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layers L2/3-6.\")\n30317:AnnotationAssertion(terms:contributor obo:CL_4023040 <https://orcid.org/0000-0001-7258-9596>)\n30318:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023040 \"L2/3-6 IT projecting neuron\")\n30319:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023040 cl:BDS_subset)\n30320:AnnotationAssertion(rdfs:label obo:CL_4023040 \"L2/3-6 intratelencephalic projecting glutamatergic neuron\")\n30321:SubClassOf(obo:CL_4023040 obo:CL_4023008)\n30323:# Class: obo:CL_4023041 (L5 extratelencephalic projecting glutamatergic cortical neuron)\n30325:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023041 \"L5 ET glut\")\n30326:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023041 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics.\")\n30327:AnnotationAssertion(terms:contributor obo:CL_4023041 <https://orcid.org/0000-0001-7258-9596>)\n30328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4023041 \"subcerebral projection (SCPN) neuron\")\n30329:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4023041 \"Pyramidal tract-like (PT-l)\")\n30330:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4023041 \"burst-firing layer 5 neuron\")\n30331:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4023041 \"thick-tufted layer 5 (TTL5) pyramidal neuron\")\n30332:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4023041 \"pyramidal tract (PT) neuron\")\n30333:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023041 \"L5b neuron\")\n30334:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023041 cl:BDS_subset)\n30335:AnnotationAssertion(rdfs:label obo:CL_4023041 \"L5 extratelencephalic projecting glutamatergic cortical neuron\")\n30336:EquivalentClasses(obo:CL_4023041 ObjectIntersectionOf(obo:CL_4023009 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394)))\n30337:SubClassOf(obo:CL_4023041 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070015))\n30339:# Class: obo:CL_4023042 (L6 corticothalamic-projecting glutamatergic cortical neuron)\n30341:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023042 \"L6 CT glut\")\n30342:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023042 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6.\")\n30343:AnnotationAssertion(terms:contributor obo:CL_4023042 <https://orcid.org/0000-0001-7258-9596>)\n30344:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023042 \"L6 CT\")\n30345:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023042 cl:BDS_subset)\n30346:AnnotationAssertion(rdfs:label obo:CL_4023042 \"L6 corticothalamic-projecting glutamatergic cortical neuron\")\n30347:EquivalentClasses(obo:CL_4023042 ObjectIntersectionOf(obo:CL_4023013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005395)))\n30348:SubClassOf(obo:CL_4023042 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0010225))\n30350:# Class: obo:CL_4023043 (L5/6 near-projecting glutamatergic neuron of the primary motor cortex)\n30352:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023043 \"L5/6 NP glut MOp\")\n30353:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023043 \"A transcriptomically distinct near-projecting glutamatergic neuron with a soma found in layer 5/6 of the primary motor cortex. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', cluster L5/6 NP.\")\n30354:AnnotationAssertion(terms:contributor obo:CL_4023043 <https://orcid.org/0000-0001-7258-9596>)\n30355:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023043 \"ILX:0770161\")\n30356:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP M1\")\n30357:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP MOp\")\n30358:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023043 cl:BDS_subset)\n30359:AnnotationAssertion(rdfs:label obo:CL_4023043 \"L5/6 near-projecting glutamatergic neuron of the primary motor cortex\")\n30360:EquivalentClasses(obo:CL_4023043 ObjectIntersectionOf(obo:CL_4030067 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001384)))\n30362:# Class: obo:CL_4023044 (non-medulla, extratelencephalic-projecting glutamatergic neuron of the primary motor cortex)\n30364:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023044 \"non-MY ET glut MOp\")\n30365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023044 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that does not project to the medulla. Non-MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. Non-MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\n30366:AnnotationAssertion(terms:contributor obo:CL_4023044 <https://orcid.org/0000-0001-7258-9596>)\n30367:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET M1\")\n30368:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET MOp (Mus)\")\n30369:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023044 cl:BDS_subset)\n30370:AnnotationAssertion(rdfs:label obo:CL_4023044 \"non-medulla, extratelencephalic-projecting glutamatergic neuron of the primary motor cortex\")\n30371:SubClassOf(obo:CL_4023044 obo:CL_4023041)\n30372:SubClassOf(obo:CL_4023044 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001384))\n30374:# Class: obo:CL_4023045 (medulla-projecting glutamatergic neuron of the primary motor cortex)\n30376:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023045 \"MY ET glut MOp\")\n30377:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023045 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that projects to the medulla. MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\n30378:AnnotationAsse