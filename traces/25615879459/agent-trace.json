89:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") obo:RO_0002175 obo:CL_4023122 obo:NCBITaxon_10090)\n31090:AnnotationAssertion(terms:contributor obo:CL_4023122 <https://orcid.org/0000-0001-7258-9596>)\n31091:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023122 \"OxtrINs\")\n31092:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") rdfs:comment obo:CL_4023122 \"These cells were first identified in mouse.\")\n31093:AnnotationAssertion(rdfs:label obo:CL_4023122 \"oxytocin receptor sst GABAergic cortical interneuron\")\n31094:SubClassOf(obo:CL_4023122 obo:CL_0000099)\n31095:SubClassOf(obo:CL_4023122 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n31096:SubClassOf(obo:CL_4023122 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n31097:SubClassOf(obo:CL_4023122 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001635))\n31098:SubClassOf(obo:CL_4023122 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015665))\n31100:# Class: obo:CL_4023123 (hypothalamus kisspeptin neuron)\n31102:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023123 \"A kisspeptin neuron that is located in the hypothalamus. These neurons project to and activate gonadotrophin-releasing hormone neurons (acting via the kisspeptin receptor) in the hypothalamus and stimulate the secretion of gonadotrophin-releasing hormone.\")\n31103:AnnotationAssertion(terms:contributor obo:CL_4023123 <https://orcid.org/0000-0001-7258-9596>)\n31104:AnnotationAssertion(terms:contributor obo:CL_4023123 <https://orcid.org/0000-0002-0819-0473>)\n31105:AnnotationAssertion(rdfs:label obo:CL_4023123 \"hypothalamus kisspeptin neuron\")\n31106:EquivalentClasses(obo:CL_4023123 ObjectIntersectionOf(obo:CL_4023130 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001898)))\n31108:# Class: obo:CL_4023124 (dentate gyrus kisspeptin neuron)\n31110:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Kisspeptin&oldid=1042853037\") obo:IAO_0000115 obo:CL_4023124 \"A kisspeptin neuron that is located in the dentate gyrus of the hippocampus.\")\n31111:AnnotationAssertion(terms:contributor obo:CL_4023124 <https://orcid.org/0000-0001-7258-9596>)\n31112:AnnotationAssertion(terms:contributor obo:CL_4023124 <https://orcid.org/0000-0002-0819-0473>)\n31113:AnnotationAssertion(rdfs:label obo:CL_4023124 \"dentate gyrus kisspeptin neuron\")\n31114:EquivalentClasses(obo:CL_4023124 ObjectIntersectionOf(obo:CL_4023130 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001885)))\n31116:# Class: obo:CL_4023125 (KNDy neuron)\n31118:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") obo:IAO_0000115 obo:CL_4023125 \"A hypothalamus kisspeptin neuron that coexpresses kisspeptin, neurokinin B and dynorphin.\")\n31119:AnnotationAssertion(terms:contributor obo:CL_4023125 <https://orcid.org/0000-0001-7258-9596>)\n31120:AnnotationAssertion(terms:contributor obo:CL_4023125 <https://orcid.org/0000-0002-0819-0473>)\n31121:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023125 \"kisspeptin, neurokinin B and dynorphin expressing neuron\")\n31122:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") rdfs:comment obo:CL_4023125 \"KNDy neurons are involved in the negative feedback of gonadotropin-releasing hormone release in the hypothalamic–pituitary–gonadal axis. Sex steroids released from the gonads act on KNDy neurons as inhibitors of kisspeptin release. This inhibition provides negative feedback control on the hypothalamic–pituitary–gonadal axis. Other roles of KNDy neurons include influences on prolactin production; puberty; stress' effects on reproduction; and the control of thermoregulation.\")\n31123:AnnotationAssertion(rdfs:label obo:CL_4023125 \"KNDy neuron\")\n31124:EquivalentClasses(obo:CL_4023125 ObjectIntersectionOf(obo:CL_4023123 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000012526) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000016004)))\n31126:# Class: obo:CL_4023127 (arcuate nucleus of hypothalamus KNDy neuron)\n31128:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023127 \"a KNDy neuron that is located in the arcuate nucleus of the hypothalamus.\")\n31129:AnnotationAssertion(terms:contributor obo:CL_4023127 <https://orcid.org/0000-0001-7258-9596>)\n31130:AnnotationAssertion(terms:contributor obo:CL_4023127 <https://orcid.org/0000-0002-0819-0473>)\n31131:AnnotationAssertion(rdfs:label obo:CL_4023127 \"arcuate nucleus of hypothalamus KNDy neuron\")\n31132:EquivalentClasses(obo:CL_4023127 ObjectIntersectionOf(obo:CL_4023125 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932)))\n31134:# Class: obo:CL_4023128 (rostral periventricular region of the third ventricle KNDy neuron)\n31136:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") obo:IAO_0000115 obo:CL_4023128 \"a KNDy neuron that is located in the rostral periventricular region of the third ventricle.\")\n31137:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Anteroventral_periventricular_nucleus&oldid=966137187\") obo:IAO_0000116 obo:CL_4023128 \"In rats and mice, the anteroventral periventricular nucleus plus the periventricular nucleus make up the rostral periventricular region of the third ventricle (RP3V).\")\n31138:AnnotationAssertion(terms:contributor obo:CL_4023128 <https://orcid.org/0000-0001-7258-9596>)\n31139:AnnotationAssertion(terms:contributor obo:CL_4023128 <https://orcid.org/0000-0002-0819-0473>)\n31140:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023128 \"RP3V KNDy neuron\")\n31141:AnnotationAssertion(rdfs:label obo:CL_4023128 \"rostral periventricular region of the third ventricle KNDy neuron\")\n31142:EquivalentClasses(obo:CL_4023128 ObjectIntersectionOf(obo:CL_4023125 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440005)))\n31144:# Class: obo:CL_4023129 (retinoblast)\n31146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17565741\") obo:IAO_0000115 obo:CL_4023129 \"A retinal cell that is immature or undifferentiated.\")\n31147:AnnotationAssertion(terms:contributor obo:CL_4023129 <https://orcid.org/0000-0001-7258-9596>)\n31148:AnnotationAssertion(terms:contributor obo:CL_4023129 <https://orcid.org/0000-0002-0819-0473>)\n31149:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17565741\") oboInOwl:hasExactSynonym obo:CL_4023129 \"retinal stem cell\")\n31150:AnnotationAssertion(rdfs:label obo:CL_4023129 \"retinoblast\")\n31151:SubClassOf(obo:CL_4023129 obo:CL_0009004)\n31152:SubClassOf(obo:CL_4023129 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000966))\n31154:# Class: obo:CL_4023130 (kisspeptin neuron)\n31156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023130 \"A neuron that expresses kisspeptin. These neurons are predominantly located in the hypothalamus, but also found in other parts of the brain including the hippocampal dentate gyrus.\")\n31157:AnnotationAssertion(terms:contributor obo:CL_4023130 <https://orcid.org/0000-0001-7258-9596>)\n31158:AnnotationAssertion(terms:contributor obo:CL_4023130 <https://orcid.org/0000-0002-0819-0473>)\n31159:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") rdfs:comment obo:CL_4023130 \"Gonadal sex steroids stimulate kisspeptin neurons in the RP3V, but inhibit kisspeptin neurons in the ARC.\")\n31160:AnnotationAssertion(rdfs:label obo:CL_4023130 \"kisspeptin neuron\")\n31161:EquivalentClasses(obo:CL_4023130 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000009344)))\n31162:SubClassOf(obo:CL_4023130 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n31164:# Class: obo:CL_4023154 (myelinating glial cell)\n31166:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1007/3-540-29623-9_3240\") obo:IAO_0000115 obo:CL_4023154 \"A glial cell that myelinates axonal processes.\")\n31167:AnnotationAssertion(terms:contributor obo:CL_4023154 <https://orcid.org/0000-0001-7258-9596>)\n31168:AnnotationAssertion(rdfs:label obo:CL_4023154 \"myelinating glial cell\")\n31169:EquivalentClasses(obo:CL_4023154 ObjectIntersectionOf(obo:CL_0000125 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209)))\n31171:# Class: obo:CL_4023158 (octopus cell of the mammalian cochlear nucleus)\n31173:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:title=Cochlear_nucleus&oldid=1090176664\") obo:IAO_0000115 obo:CL_4023158 \"A neuron in the posterior ventral cochlear nucleus that is distinguished by their long, thick and tentacle-shaped dendrites that typically emanate from one side of the cell body.\")\n31174:AnnotationAssertion(obo:IAO_0000116 obo:CL_4023158 \"This term is restricted to the mammalian cochlear nucleus to disambiguate for cells of octopus.\")\n31175:AnnotationAssertion(terms:contributor obo:CL_4023158 <http://orcid.org/0000-0001-7258-9596>)\n31176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11976365\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:title=Cochlear_nucleus&oldid=1090176664\") rdfs:comment obo:CL_4023158 \"Octopus cells respond only at the onset of a broad-band simple tonal stimulus and form a pathway to the superior paraolivary nucleus and to the ventral nucleus of the lateral lemniscus.\")\n31177:AnnotationAssertion(rdfs:label obo:CL_4023158 \"octopus cell of the mammalian cochlear nucleus\")\n31178:SubClassOf(obo:CL_4023158 obo:CL_0000540)\n31179:SubClassOf(obo:CL_4023158 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002831))\n31180:SubClassOf(obo:CL_4023158 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_8440043))\n31182:# Class: obo:CL_4023159 (double bouquet cell)\n31184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") obo:IAO_0000115 obo:CL_4023159 \"An interneuron that has double bouquet morphology.\")\n31185:AnnotationAssertion(terms:contributor obo:CL_4023159 <http://orcid.org/0000-0001-7258-9596>)\n31186:AnnotationAssertion(rdfs:label obo:CL_4023159 \"double bouquet cell\")\n31187:EquivalentClasses(obo:CL_4023159 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070061)))\n31189:# Class: obo:CL_4023160 (cartwheel cell)\n31191:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0102311\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Cartwheel_cell&oldid=1040398094\") obo:IAO_0000115 obo:CL_4023160 \"A neuron of the dorsal cochlear nucleus with spiny dendrites that receive input from the axons of granule cells and with axons that release GABA and glycine onto cartwheel, pyramidal and giant cell targets.\")\n31192:AnnotationAssertion(terms:contributor obo:CL_4023160 <http://orcid.org/0000-0001-7258-9596>)\n31193:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023160 \"ILX:0102311\")\n31194:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0102311\") rdfs:comment obo:CL_4023160 \"Cartwheel cells share many of the features, molecular and electrophysiological, of cerebellar Purkinje neurons.\")\n31195:AnnotationAssertion(rdfs:label obo:CL_4023160 \"cartwheel cell\")\n31196:SubClassOf(obo:CL_4023160 obo:CL_0000540)\n31197:SubClassOf(obo:CL_4023160 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002829))\n31198:SubClassOf(obo:CL_4023160 ObjectSomeValuesFrom(obo:RO_0002103 obo:CL_0000120))\n31199:SubClassOf(obo:CL_4023160 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n31200:SubClassOf(obo:CL_4023160 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061537))\n31202:# Class: obo:CL_4023161 (unipolar brush cell)\n31204:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9193142\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Unipolar_brush_cell&oldid=1045937026\") obo:IAO_0000115 obo:CL_4023161 \"An excitatory glutamatergic interneuron found in the granular layer of the cerebellar cortex and also in the granule cell domain of the cochlear nucleus. Unipolar brush cells have a round or oval cell body with usually a single short dendrite that ends in a brush-like tuft of short dendrites unique to them known as dendrioles.\")\n31205:AnnotationAssertion(terms:contributor obo:CL_4023161 <http://orcid.org/0000-0001-7258-9596>)\n31206:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023161 \"neuronal brush cell\")\n31207:AnnotationAssertion(rdfs:label obo:CL_4023161 \"unipolar brush cell\")\n31208:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_4023161 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\n31209:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_4023161 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n31210:SubClassOf(obo:CL_4023161 obo:CL_0000099)\n31211:SubClassOf(obo:CL_4023161 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0044293))\n31212:SubClassOf(obo:CL_4023161 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070025))\n31213:SubClassOf(obo:CL_4023161 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002028))\n31214:SubClassOf(obo:CL_4023161 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535))\n31216:# Class: obo:CL_4023162 (bushy cell)\n31218:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023162 \"A neuron found in the anterior part of the ventral cochlear nucleus that has the appearance of bushes, having short dendrites. Bushy cells give outputs to different parts of the superior olivary complex.\")\n31219:AnnotationAssertion(terms:contributor obo:CL_4023162 <http://orcid.org/0000-0001-7258-9596>)\n31220:AnnotationAssertion(rdfs:label obo:CL_4023162 \"bushy cell\")\n31221:SubClassOf(obo:CL_4023162 obo:CL_0000540)\n31222:SubClassOf(obo:CL_4023162 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002830))\n31223:SubClassOf(obo:CL_4023162 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0002128))\n31225:# Class: obo:CL_4023163 (spherical bushy cell)\n31227:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023163 \"A bushy cell that receives only few large excitatory endbulb synapses from auditory nerves. Spherical bush cells give excitatory input to the lateral and medial parts of the superior olive.\")\n31228:AnnotationAssertion(terms:contributor obo:CL_4023163 <http://orcid.org/0000-0001-7258-9596>)\n31229:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023163 \"SBC\")\n31230:AnnotationAssertion(rdfs:label obo:CL_4023163 \"spherical bushy cell\")\n31231:SubClassOf(obo:CL_4023163 obo:CL_4023162)\n31233:# Class: obo:CL_4023164 (globular bushy cell)\n31235:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023164 \"A bushy cell that receives a large number of medium-sized synapses, called modified endbulbs. Globular bushy cells extend to the superior olive on both sides of the brainstem where they give input to the bipolar neurons.\")\n31236:AnnotationAssertion(terms:contributor obo:CL_4023164 <http://orcid.org/0000-0001-7258-9596>)\n31237:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023164 \"GBC\")\n31238:AnnotationAssertion(rdfs:label obo:CL_4023164 \"globular bushy cell\")\n31239:SubClassOf(obo:CL_4023164 obo:CL_4023162)\n31241:# Class: obo:CL_4023168 (somatosensory neuron)\n31243:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22865660\") obo:IAO_0000115 obo:CL_4023168 \"A neuron that is part of the somatic sensory system. Somatosensory neurons innervate the skin or integument to detect different types of thermal, chemical, and mechanical touch stimuli.\")\n31244:AnnotationAssertion(terms:contributor obo:CL_4023168 <http://orcid.org/0000-0001-7258-9596>)\n31245:AnnotationAssertion(rdfs:label obo:CL_4023168 \"somatosensory neuron\")\n31246:EquivalentClasses(obo:CL_4023168 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003942) ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000010)))\n31248:# Class: obo:CL_4023169 (trigeminal neuron)\n31250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22190641\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Trigeminal_nerve&oldid=1099897926\") obo:IAO_0000115 obo:CL_4023169 \"A neuron that is responsible for sensation in the face or motor functions such as biting and chewing. Trigeminal neurons extend a single axon shaft along the lateral white matter of the hindbrain and spinal cord. The highly branched axons innervate the integument of the head.\")\n31251:AnnotationAssertion(terms:contributor obo:CL_4023169 <http://orcid.org/0000-0001-7258-9596>)\n31252:AnnotationAssertion(rdfs:label obo:CL_4023169 \"trigeminal neuron\")\n31253:SubClassOf(obo:CL_4023169 obo:CL_0000540)\n31254:SubClassOf(obo:CL_4023169 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n31256:# Class: obo:CL_4023170 (trigeminal sensory neuron)\n31258:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539823/\") obo:IAO_0000115 obo:CL_4023170 \"A trigeminal neuron that is responsible for sensation in the face.\")\n31259:AnnotationAssertion(terms:contributor obo:CL_4023170 <http://orcid.org/0000-0001-7258-9596>)\n31260:AnnotationAssertion(rdfs:label obo:CL_4023170 \"trigeminal sensory neuron\")\n31261:EquivalentClasses(obo:CL_4023170 ObjectIntersectionOf(obo:CL_4023169 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050906)))\n31262:SubClassOf(obo:CL_4023170 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003942))\n31264:# Class: obo:CL_4023171 (trigeminal motor neuron)\n31266:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539823/\") obo:IAO_0000115 obo:CL_4023171 \"A trigeminal neuron that is responsible for motor functions such as biting and chewing.\")\n31267:AnnotationAssertion(terms:contributor obo:CL_4023171 <http://orcid.org/0000-0001-7258-9596>)\n31268:AnnotationAssertion(rdfs:label obo:CL_4023171 \"trigeminal motor neuron\")\n31269:EquivalentClasses(obo:CL_4023171 ObjectIntersectionOf(obo:CL_0000100 obo:CL_4023169))\n31271:# Class: obo:CL_4023181 (hypendymal cell)\n31273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7258-9596>) Annotation(oboInOwl:hasDbXref \"PMID:26778959\") Annotation(oboInOwl:hasDbXref \"PMID:9579598\") obo:IAO_0000115 obo:CL_4023181 \"A neurecto-epithelial cell that is part of the basal layer of the subcommissural organ and specializes in the secretion of proteins into the subarachnoid space. Hypendymal cells have similar characteristics to ependymal cells and express SCO-spondin.\")\n31274:AnnotationAssertion(terms:contributor obo:CL_4023181 <http://orcid.org/0000-0002-2105-0715>)\n31275:AnnotationAssertion(rdfs:label obo:CL_4023181 \"hypendymal cell\")\n31276:SubClassOf(obo:CL_4023181 obo:CL_0000710)\n31277:SubClassOf(obo:CL_4023181 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002139))\n31278:SubClassOf(obo:CL_4023181 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015658))\n31280:# Class: obo:CL_4023187 (koniocellular cell)\n31282:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Lateral_geniculate_nucleus&oldid=1098375993\") obo:IAO_0000115 obo:CL_4023187 \"A neuron with a small cell body that is located in a koniocellular layer of the lateral geniculate nucleus (LGN).\")\n31283:AnnotationAssertion(terms:contributor obo:CL_4023187 <http://orcid.org/0000-0001-7258-9596>)\n31284:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023187 \"NIFEXT:44\")\n31285:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") oboInOwl:hasExactSynonym obo:CL_4023187 \"K cell\")\n31286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") rdfs:comment obo:CL_4023187 \"In adult monkeys, koniocellular cells can be distinguished from parvocellular and magnocellular of the LGN by their expression of calbindin, the alpha subunit of type II calmodulin-dependent protein kinase, and the gamma subunit of protein kinase C.\")\n31287:AnnotationAssertion(rdfs:label obo:CL_4023187 \"koniocellular cell\")\n31288:EquivalentClasses(obo:CL_4023187 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0013615)))\n31290:# Class: obo:CL_4023188 (midget ganglion cell of retina)\n31292:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\n31293:AnnotationAssertion(terms:contributor obo:CL_4023188 \"https://orcid.org/0000-0001-7258-9596\")\n31294:AnnotationAssertion(terms:contributor obo:CL_4023188 \"https://orcid.org/0000-0001-7655-4833\")\n31295:AnnotationAssertion(rdfs:comment obo:CL_4023188 \"There are midget bipolar cells of retina and midget ganglion cells of retina and they are not the same:\n31297:AnnotationAssertion(rdfs:label obo:CL_4023188 \"midget ganglion cell of retina\")\n31298:SubClassOf(obo:CL_4023188 obo:CL_0000740)\n31299:SubClassOf(obo:CL_4023188 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0013607))\n31301:# Class: obo:CL_4023189 (parasol ganglion cell of retina)\n31303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\n31304:AnnotationAssertion(terms:contributor obo:CL_4023189 \"https://orcid.org/0000-0001-7258-9596\")\n31305:AnnotationAssertion(terms:contributor obo:CL_4023189 \"https://orcid.org/0000-0001-7655-4833\")\n31306:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M cell\")\n31307:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M ganglion cell\")\n31308:AnnotationAssertion(rdfs:comment obo:CL_4023189 \"These cells should not be confused with M1-M14 retinal ganglion cells described in PMID:16626866 which refer to a different classification of retinal ganglion cells.\")\n31309:AnnotationAssertion(rdfs:label obo:CL_4023189 \"parasol ganglion cell of retina\")\n31310:SubClassOf(obo:CL_4023189 obo:CL_0000740)\n31311:SubClassOf(obo:CL_4023189 ObjectSomeValuesFrom(obo:RO_0013001 obo:UBERON_0013606))\n31420:# Class: obo:CL_4030000 (choroidal melanocyte)\n31422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_4030000 \"A melanocyte located in the vascular uvea and involved in photoprotection, regulation of oxidative damage and immune responses.\")\n31423:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030000 \"2022-01-20T12:59:06Z\"^^xsd:dateTime)\n31424:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030000 \"uveal melanocyte\")\n31425:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"PMID:34082079\") rdfs:comment obo:CL_4030000 \"Cellular functions and extracellular interactions of choroidal melanocytes are distinct to skin melanocytes. They might have both neuroectodermal as well as mesectodermal origins.\")\n31426:AnnotationAssertion(rdfs:label obo:CL_4030000 \"choroidal melanocyte\")\n31427:EquivalentClasses(obo:CL_4030000 ObjectIntersectionOf(obo:CL_0000148 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001768)))\n31429:# Class: obo:CL_4030001 (stromal cell of thymus)\n31431:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030001 \"A stromal cell that is part of the thymus.\")\n31432:AnnotationAssertion(terms:date obo:CL_4030001 \"2022-07-08T11:39:38Z\"^^xsd:dateTime)\n31433:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030001 \"thymic stromal cell\")\n31434:AnnotationAssertion(rdfs:label obo:CL_4030001 \"stromal cell of thymus\")\n31435:EquivalentClasses(obo:CL_4030001 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002370)))\n31437:# Class: obo:CL_4030002 (effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated)\n31439:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2825-0621\") obo:IAO_0000115 obo:CL_4030002 \"An alpha-beta memory T cell with the phenotype CD45RA-positive.\")\n31440:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030002 \"2022-02-01T13:04:46Z\"^^xsd:dateTime)\n31441:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"TEMRA\")\n31442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"effector memory RA T cell\")\n31443:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"TEMRA cell\")\n31444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory CD45RA+ T cells\")\n31445:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/T_cell#Memory_T_cells\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory cells re-expressing CD45RA\")\n31446:AnnotationAssertion(rdfs:label obo:CL_4030002 \"effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated\")\n31447:SubClassOf(obo:CL_4030002 obo:CL_0000791)\n31449:# Class: obo:CL_4030003 (interstitial cell of thymus)\n31451:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030003 \"A cell that makes up the loose connective tissue of the thymus.\")\n31452:AnnotationAssertion(terms:date obo:CL_4030003 \"2022-07-08T11:48:36Z\"^^xsd:dateTime)\n31453:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030003 \"thymic interstitial cell\")\n31454:AnnotationAssertion(rdfs:label obo:CL_4030003 \"interstitial cell of thymus\")\n31455:SubClassOf(obo:CL_4030003 obo:CL_4030001)\n31457:# Class: obo:CL_4030004 (thymic nurse cell)\n31459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Thymic_nurse_cell\") obo:IAO_0000115 obo:CL_4030004 \"A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.\")\n31460:AnnotationAssertion(terms:contributor obo:CL_4030004 <https://orcid.org/0000-0002-0819-0473>)\n31461:AnnotationAssertion(terms:date obo:CL_4030004 \"2022-02-18T12:43:20Z\"^^xsd:dateTime)\n31462:AnnotationAssertion(rdfs:label obo:CL_4030004 \"thymic nurse cell\")\n31463:SubClassOf(obo:CL_4030004 obo:CL_0002293)\n31465:# Class: obo:CL_4030005 (kidney collecting duct beta-intercalated cell)\n31467:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24051376\") Annotation(oboInOwl:hasDbXref \"PMID:31300091\") Annotation(oboInOwl:hasDbXref \"PMID:32016094\") obo:IAO_0000115 obo:CL_4030005 \"A renal beta-intercalated cell that is part of the cortical collecting duct. The medullary collecting duct does not contain the renal beta-intercalated cell type.\")\n31468:AnnotationAssertion(terms:date obo:CL_4030005 \"2022-09-14T16:19:11Z\"^^xsd:dateTime)\n31469:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_4030005 \"B-IC\")\n31470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_4030005 \"kidney collecting duct intercalated cell type B\")\n31471:AnnotationAssertion(rdfs:label obo:CL_4030005 \"kidney collecting duct beta-intercalated cell\")\n31472:EquivalentClasses(obo:CL_4030005 ObjectIntersectionOf(obo:CL_0002201 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004203)))\n31474:# Class: obo:CL_4030006 (fallopian tube secretory epithelial cell)\n31476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1186/1477-7827-7-129\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.3390/cells8080933\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") obo:IAO_0000115 obo:CL_4030006 \"An epithelial cell that is part of the fallopian tube that secretes mucus and oviduct-specific products in response to hormonal stimulation from estrogen and luteinizing hormone. This fallopian tube secretory cell is similar in height to the ciliated cell, but typically exhibits a more narrow, columnar shape. Its nucleus is ovoid and oriented perpendicular to the cell's long axis, with denser chromatin and a smaller nucleolus compared to the ciliated cell.\")\n31477:AnnotationAssertion(terms:contributor obo:CL_4030006 <https://orcid.org/0000-0002-0819-0473>)\n31478:AnnotationAssertion(terms:date obo:CL_4030006 \"2022-03-03T10:39:31Z\"^^xsd:dateTime)\n31479:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030006 \"oviduct secretory epithelial cell\")\n31480:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030006 \"uterine tube secretory epithelial cell\")\n31481:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\n31482:AnnotationAssertion(rdfs:label obo:CL_4030006 \"fallopian tube secretory epithelial cell\")\n31483:SubClassOf(obo:CL_4030006 obo:CL_1001591)\n31484:SubClassOf(obo:CL_4030006 obo:CL_4052019)\n31485:SubClassOf(obo:CL_4030006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n31487:# Class: obo:CL_4030007 (fallopian tube multiciliated epithelial cell)\n31489:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16565155\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube\") obo:IAO_0000115 obo:CL_4030007 \"A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.\")\n31490:AnnotationAssertion(terms:contributor obo:CL_4030007 <https://orcid.org/0000-0002-0819-0473>)\n31491:AnnotationAssertion(terms:date obo:CL_4030007 \"2022-03-08T12:40:19Z\"^^xsd:dateTime)\n31492:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030007 \"oviduct ciliated cell\")\n31493:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube ciliated cell\")\n31494:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube multiciliated cell\")\n31495:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"uterine tube ciliated epithelial cell\")\n31496:AnnotationAssertion(rdfs:label obo:CL_4030007 \"fallopian tube multiciliated epithelial cell\")\n31497:SubClassOf(obo:CL_4030007 obo:CL_0005012)\n31498:SubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n31499:SubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007589))\n31501:# Class: obo:CL_4030008 (pronephric podocyte)\n31503:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10322630\") obo:IAO_0000115 obo:CL_4030008 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the pronephros.\")\n31504:AnnotationAssertion(terms:contributor obo:CL_4030008 <https://orcid.org/0000-0002-2244-7917>)\n31505:AnnotationAssertion(terms:date obo:CL_4030008 \"2022-03-11T14:38:32Z\"^^xsd:dateTime)\n31506:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0001673\") oboInOwl:hasExactSynonym obo:CL_4030008 \"pronephric glomerular visceral epithelial cell\")\n31507:AnnotationAssertion(rdfs:label obo:CL_4030008 \"pronephric podocyte\")\n31508:EquivalentClasses(obo:CL_4030008 ObjectIntersectionOf(obo:CL_0000653 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002120)))\n31509:SubClassOf(obo:CL_4030008 obo:CL_0000653)\n31511:# Class: obo:CL_4030009 (epithelial cell of proximal tubule segment 1)\n31513:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030009 \"A brush border cell that is part of segment 1 (S1) of the proximal tubule epithelium, located in the renal cortex.\")\n31514:AnnotationAssertion(terms:date obo:CL_4030009 \"2022-05-10T13:14:00Z\"^^xsd:dateTime)\n31515:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030009 \"epithelial cell of segment 1 of proximal tubule\")\n31516:AnnotationAssertion(rdfs:label obo:CL_4030009 \"epithelial cell of proximal tubule segment 1\")\n31517:EquivalentClasses(obo:CL_4030009 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004196) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31518:SubClassOf(obo:CL_4030009 obo:CL_0002307)\n31520:# Class: obo:CL_4030010 (epithelial cell of proximal tubule segment 2)\n31522:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:31253652\") obo:IAO_0000115 obo:CL_4030010 \"A brush border cell that is part of segment 2 (S2) of the proximal tubule epithelium, located in the renal cortex. In addition to its reabsorptive functions, it is also specialized in the secretion of organic anions and cations, including para-aminohippurate.\")\n31523:AnnotationAssertion(terms:date obo:CL_4030010 \"2022-05-10T13:26:13Z\"^^xsd:dateTime)\n31524:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030010 \"epithelial cell of segment 2 of proximal tubule\")\n31525:AnnotationAssertion(rdfs:label obo:CL_4030010 \"epithelial cell of proximal tubule segment 2\")\n31526:EquivalentClasses(obo:CL_4030010 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004197) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31527:SubClassOf(obo:CL_4030010 obo:CL_0002307)\n31529:# Class: obo:CL_4030011 (epithelial cell of proximal tubule segment 3)\n31531:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030011 \"A brush border cell that is part of segment 3 (S3) of the proximal tubule epithelium, which extends from the medullary rays of the renal cortex into the outer medulla.\")\n31532:AnnotationAssertion(terms:date obo:CL_4030011 \"2022-05-10T13:31:06Z\"^^xsd:dateTime)\n31533:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030011 \"epithelial cell of segment 3 of proximal tubule\")\n31534:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") rdfs:comment obo:CL_4030011 \"The epithelial cell of proximal tubule segment 3 operates under relatively hypoxic conditions and is particularly susceptible to ischemic injury.\")\n31535:AnnotationAssertion(rdfs:label obo:CL_4030011 \"epithelial cell of proximal tubule segment 3\")\n31536:EquivalentClasses(obo:CL_4030011 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001290) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31537:SubClassOf(obo:CL_4030011 obo:CL_0002307)\n31539:# Class: obo:CL_4030012 (kidney loop of Henle short descending thin limb epithelial cell)\n31541:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030012 \"Epithelial cell of the descending thin limb of the short loop (cortical) nephron limited to the outer medulla (mainly inner strip). It is known in some mammalian species that the short descending limb of the loop of Henle selectively expresses the serine protease Corin, the homeobox TF Uncx, and the urea channel Slc14a2.\")\n31542:AnnotationAssertion(terms:contributor obo:CL_4030012 <https://orcid.org/0000-0003-2804-127X>)\n31543:AnnotationAssertion(terms:date obo:CL_4030012 \"2022-05-13T11:00:29Z\"^^xsd:dateTime)\n31544:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030012 \"epithelial cell of the descending thin limb of the short loop of Henle\")\n31545:AnnotationAssertion(rdfs:label obo:CL_4030012 \"kidney loop of Henle short descending thin limb epithelial cell\")\n31546:EquivalentClasses(obo:CL_4030012 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005099)))\n31547:SubClassOf(obo:CL_4030012 obo:CL_0000076)\n31548:SubClassOf(obo:CL_4030012 obo:CL_1001111)\n31550:# Class: obo:CL_4030013 (kidney loop of Henle long descending thin limb outer medulla epithelial cell)\n31552:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030013 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the outer medulla (inner stripe). It is known in some mammalian species that the long descending limb of the loop of Henle in the outer medulla selectively expresses the secreted activin-antagonist protein follistatin (Fst), the GPI-linked adhesion protein Cdh13, and the protein kinase Stk32a.\")\n31553:AnnotationAssertion(terms:date obo:CL_4030013 \"2022-05-13T11:11:07Z\"^^xsd:dateTime)\n31554:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030013 \"epithelial cell of the outer medulla of the long descending limb of the loop of Henle\")\n31555:AnnotationAssertion(rdfs:label obo:CL_4030013 \"kidney loop of Henle long descending thin limb outer medulla epithelial cell\")\n31556:SubClassOf(obo:CL_4030013 obo:CL_1001111)\n31557:SubClassOf(obo:CL_4030013 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005100))\n31559:# Class: obo:CL_4030014 (kidney loop of Henle long descending thin limb inner medulla epithelial cell)\n31561:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/gene/8170\") obo:IAO_0000115 obo:CL_4030014 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the inner medulla. It is known in some mammalian species that the long descending limb of the loop of Henle in the inner medulla selectively expresses the nuclear receptor Nr2e3, the Ig kappa chain Igkc, and the secreted protein dermokine (Dmkn). SLC14A2, which expresses a urea transporter, is also expressed in the inner medulla.\")\n31562:AnnotationAssertion(terms:date obo:CL_4030014 \"2022-05-13T11:16:54Z\"^^xsd:dateTime)\n31563:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030014 \"epithelial cell of the inner medulla of the long descending limb of the loop of Henle\")\n31564:AnnotationAssertion(rdfs:label obo:CL_4030014 \"kidney loop of Henle long descending thin limb inner medulla epithelial cell\")\n31565:SubClassOf(obo:CL_4030014 obo:CL_1001111)\n31566:SubClassOf(obo:CL_4030014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005100))\n31568:# Class: obo:CL_4030015 (kidney collecting duct alpha-intercalated cell)\n31570:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030015 \"A renal alpha-intercalated cell that is part of the collecting duct of the renal tubule.\")\n31571:AnnotationAssertion(terms:contributor obo:CL_4030015 <https://orcid.org/0000-0003-2804-127X>)\n31572:AnnotationAssertion(terms:date obo:CL_4030015 \"2022-05-31T11:15:10Z\"^^xsd:dateTime)\n31573:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030015 \"kidney collecting duct intercalated cell type A\")\n31574:AnnotationAssertion(rdfs:label obo:CL_4030015 \"kidney collecting duct alpha-intercalated cell\")\n31575:EquivalentClasses(obo:CL_4030015 ObjectIntersectionOf(obo:CL_0005011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232)))\n31577:# Class: obo:CL_4030016 (epithelial cell of early distal convoluted tubule)\n31579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0