contributor obo:CL_4023014 <https://orcid.org/0000-0001-7258-9596>)\n30004:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023014 \"L5 VIP (Mus musculus)\")\n30005:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023014 cl:BDS_subset)\n30006:AnnotationAssertion(rdfs:label obo:CL_4023014 \"L5 VIP GABAergic interneuron (Mmus)\")\n30007:SubClassOf(obo:CL_4023014 obo:CL_0000099)\n30008:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394))\n30009:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30010:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30011:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n30013:# Class: obo:CL_4023015 (sncg GABAergic interneuron)\n30015:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023015 \"sncg interneuron\")\n30016:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023015 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein.\")\n30017:AnnotationAssertion(terms:contributor obo:CL_4023015 <https://orcid.org/0000-0001-7258-9596>)\n30018:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023015 \"ILX:0770150\")\n30019:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023015 cl:BDS_subset)\n30020:AnnotationAssertion(rdfs:label obo:CL_4023015 \"sncg GABAergic interneuron\")\n30021:EquivalentClasses(obo:CL_4023015 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325)))\n30022:SubClassOf(obo:CL_4023015 obo:CL_4023064)\n30023:SubClassOf(obo:CL_4023015 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325))\n30025:# Class: obo:CL_4023016 (VIP GABAergic interneuron)\n30027:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023016 \"VIP interneuron\")\n30028:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023016 \"A transcriptomically distinct GABAergic neuron derived from the CGE and that expresses the vasoactive intestinal polypeptide. Its soma is located in the forebrain.\")\n30029:AnnotationAssertion(terms:contributor obo:CL_4023016 <https://orcid.org/0000-0001-7258-9596>)\n30030:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP interneuron\")\n30031:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP neuron\")\n30032:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35221922\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP-Expressing GABAergic Neuron\")\n30033:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"Vip GABAergic neuron\")\n30034:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023016 \"ILX:0770151\")\n30035:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP neuron\")\n30036:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP type\")\n30037:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP-IN\")\n30038:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"Vip\")\n30039:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023016 cl:BDS_subset)\n30040:AnnotationAssertion(rdfs:label obo:CL_4023016 \"VIP GABAergic interneuron\")\n30041:EquivalentClasses(obo:CL_4