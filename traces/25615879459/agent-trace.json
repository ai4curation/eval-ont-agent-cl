jectSomeValuesFrom(obo:RO_0002120 obo:CL_0008046))\n29865:SubClassOf(obo:CL_4023000 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_0008047))\n29867:# Class: obo:CL_4023001 (static beta motor neuron)\n29869:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023001 \"A beta motor neuron that innervates nuclear chain fibers.\")\n29870:AnnotationAssertion(terms:contributor obo:CL_4023001 <https://orcid.org/0000-0001-7258-9596>)\n29871:AnnotationAssertion(rdfs:label obo:CL_4023001 \"static beta motor neuron\")\n29872:SubClassOf(obo:CL_4023001 obo:CL_4023000)\n29874:# Class: obo:CL_4023002 (dynamic beta motor neuron)\n29876:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023002 \"A beta motor neuron that innervates the nuclear bag fibers of muscle spindles.\")\n29877:AnnotationAssertion(terms:contributor obo:CL_4023002 <https://orcid.org/0000-0001-7258-9596>)\n29878:AnnotationAssertion(rdfs:label obo:CL_4023002 \"dynamic beta motor neuron\")\n29879:SubClassOf(obo:CL_4023002 obo:CL_4023000)\n29881:# Class: obo:CL_4023003 (nuclear chain fiber)\n29883:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023003 \"A type of intrafusal muscle fiber that has nuclei arranged in a linear row. Unlike nuclear bag fibers, the equatorial region of these fibers (in the centre of the spindle) is not expanded. These fibers are responsible for the detection of changes in muscle length. They are innervated by static gamma motor neurons and are principally associated with type II sensory fibers.\")\n29884:AnnotationAssertion(terms:contributor obo:CL_4023003 <https://orcid.org/0000-0001-7258-9596>)\n29885:AnnotationAssertion(rdfs:label obo:CL_4023003 \"nuclear chain fiber\")\n29886:SubClassOf(obo:CL_4023003 obo:CL_0008047)\n29888:# Class: obo:CL_4023004 (nuclear bag fiber)\n29890:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023004 \"A type of intrafusal muscle fiber that lies in the center of a muscle spindle. Nuclei are clustered centrally and give the equatorial region a swollen appearance. They are associated with associated with dynamic gamma motor neurons, and the stretching of the equatorial region of the nuclear bag fibers results in an increase in the firing rate of type Ia sensory fibers.\")\n29891:AnnotationAssertion(terms:contributor obo:CL_4023004 <https://orcid.org/0000-0001-7258-9596>)\n29892:AnnotationAssertion(rdfs:label obo:CL_4023004 \"nuclear bag fiber\")\n29893:SubClassOf(obo:CL_4023004 obo:CL_0008047)\n29895:# Class: obo:CL_4023005 (dynamic nuclear bag fiber)\n29897:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023005 \"A nuclear bag fiber that is sensitive mainly to the rate of change in muscle length.\")\n29898:AnnotationAssertion(terms:contributor obo:CL_4023005 <https://orcid.org/0000-0001-7258-9596>)\n29899:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"bag1 fiber\")\n29900:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"nuclear bag1 intrafusal fiber\")\n29901:AnnotationAssertion(rdfs:label obo:CL_4023005 \"dynamic nuclear bag fiber\")\n29902:SubClassOf(obo:CL_4023005 obo:CL_4023004)\n29904:# Class: obo:CL_4023006 (static nuclear bag fiber)\n29906:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023006 \"A nuclear bag fiber that is sensitive only changes in muscle length but not the rate of that change.\")\n29907:AnnotationAssertion(terms:contributor obo:CL_4023006 <https://orcid.org/0000-0001-7258-9596>)\n29908:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"bag2 fiber\")\n29909:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"nuclear bag2 intrafusal fiber\")\n29910:AnnotationAssertion(rdfs:label obo:CL_4023006 \"static nuclear bag fiber\")\n29911:SubClassOf(obo:CL_4023006 obo:CL_4023004)\n29913:# Class: obo:CL_4023007 (L2/3 bipolar VIP GABAergic interneuron (Mmus))\n29915:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023007 \"L2/3 bipolar VIP interneuron (Mus)\")\n29916:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") obo:IAO_0000115 obo:CL_4023007 \"A VIP GABAergic cortical interneuron with bipolar morphology, with a soma found in L2/3. L2/3 bipolar VIP cells have extending axons across all layers (with preferences for layers II/III and Va) and a dendritic tree that is vertically more restricted than deeper layer VIP cells and extend fewer dendrites into the layers outside their home layer (location of soma). L2/3 bipolar VIP cells have great variability in firing patterns, though most are continuous adapting. L2/3 bipolar VIP cells are more depolarized in their resting state, had less fast rectification, and had smaller after hyperpolarization than deeper VIP cells.\")\n29917:AnnotationAssertion(terms:contributor obo:CL_4023007 <https://orcid.org/0000-0001-7258-9596>)\n29918:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023007 \"L2/3 bipolar Vip (Mus musculus)\")\n29919:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023007 cl:BDS_subset)\n29920:AnnotationAssertion(rdfs:label obo:CL_4023007 \"L2/3 bipolar VIP GABAergic interneuron (Mmus)\")\n29921:SubClassOf(obo:CL_4023007 obo:CL_0000099)\n29922:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070006))\n29923:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n29924:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8440000))\n29925:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n29926:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n29927:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n29929:# Class: obo:CL_4023008 (intratelencephalic-projecting glutamatergic cortical neuron)\n29931:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023008 \"IT neuron\")\n29932:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") obo:IAO_0000115 obo:CL_4023008 \"A glutamatergic neuron located in the cerebral cortex that projects to structures of telencephalic origins.\")\n29933:AnnotationAssertion(terms:contributor obo:CL_4023008 <https://orcid.org/0000-0001-7258-9596>)\n29934:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023008 \"ILX:0770100\")\n29935:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-021-24565-z\") oboInOwl:hasExactSynonym obo:CL_4023008 \"IT neuron\")\n29936:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023008 cl:BDS_subset)\n29937:AnnotationAssertion(rdfs:label obo:CL_4023008 \"intratelencephalic-projecting glutamatergic cortical neuron\")\n29938:EquivalentClasses(obo:CL_4023008 ObjectIntersectionOf(obo:CL_0000679 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070034) ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956)))\n29940:# Class: obo:CL_4023009 (extratelencephalic-projecting glutamatergic cortical neuron)\n29942:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023009 \"ET glut\")\n29943:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023009 \"A glutamatergic neuron located in the cerebral cortex that projects to structures not derived from telencephalon.\")\n29944:AnnotationAssertion(terms:contributor obo:CL_4023009 <https://orcid.org/0000-0001-7258-9596>)\n29945:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023009 \"ILX:0770101\")\n29946:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023009 \"ET projecting neuron\")\n29947:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023009 cl:BDS_subset)\n29948:AnnotationAssertion(rdfs:label obo:CL_4023009 \"extratelencephalic-projecting glutamatergic cortical neuron\")\n29949:EquivalentClasses(obo:CL_4023009 ObjectIntersectionOf(obo:CL_0000679 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070028) ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956)))\n29951:# Class: obo:CL_4023010 (alpha7 GABAergic cortical interneuron (Mmus))\n29953:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023010 \"A7 interneuron\")\n29954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023010 \"A GABAergic cortical interneuron that is strongly labelled for α7 nAChRs. These cells have soma found in L1 and have multipolar dendrites with vertically descending axonal collaterals that project deep into the column, usually branching and terminating in L5A.\")\n29955:AnnotationAssertion(terms:contributor obo:CL_4023010 <https://orcid.org/0000-0001-7258-9596>)\n29956:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023010 \"A7 cell (Mus musculus)\")\n29957:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023010 cl:BDS_subset)\n29958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023010 \"Unlike typical Lamp5 electrophysiology, A7 cells have Vip- and Sst-like firing properties, with active depolarizing hump at near-threshold membrane potentials, and  larger hyperpolarization sag, stronger burst, and rebound firing. A7 cells have a transcriptomics signature that looks like Lamp5 GABAergic interneuron.\")\n29959:AnnotationAssertion(rdfs:label obo:CL_4023010 \"alpha7 GABAergic cortical interneuron (Mmus)\")\n29960:SubClassOf(obo:CL_4023010 obo:CL_0000099)\n29961:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n29962:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n29963:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n29964:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005460))\n29966:# Class: obo:CL_4023011 (lamp5 GABAergic interneuron)\n29968:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023011 \"Lamp5 interneuron\")\n29969:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023011 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5.\")\n29970:AnnotationAssertion(terms:contributor obo:CL_4023011 <https://orcid.org/0000-0001-7258-9596>)\n29971:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023011 \"ILX:0770149\")\n29972:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023011 cl:BDS_subset)\n29973:AnnotationAssertion(rdfs:label obo:CL_4023011 \"lamp5 GABAergic interneuron\")\n29974:EquivalentClasses(obo:CL_4023011 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148)))\n29975:SubClassOf(obo:CL_4023011 obo:CL_4023064)\n29976:SubClassOf(obo:CL_4023011 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\n29978:# Class: obo:CL_4023012 (near-projecting glutamatergic cortical neuron)\n29980:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023012 \"NP glut neuron\")\n29981:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023012 \"A glutamatergic neuron located in the cerebral cortex that projects axons locally rather than distantly.\")\n29982:AnnotationAssertion(terms:contributor obo:CL_4023012 <https://orcid.org/0000-0001-7258-9596>)\n29983:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023012 \"ILX:0770103\")\n29984:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023012 \"NP neuron\")\n29985:Annotat