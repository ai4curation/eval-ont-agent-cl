tion(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004121 \"A retinal ganglion cell B that has a very small but very dense dendritic field, and has post synaptic terminals in S2.\")\nAnnotationAssertion(rdfs:label obo:CL_0004121 \"retinal ganglion cell B2\")\n# Class: obo:CL_0004124 (retinal ganglion cell C1)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004124 \"A retinal ganglion cell C inner that has medium dendritic diversity.\")\nAnnotationAssertion(rdfs:label obo:CL_0004124 \"retinal ganglion cell C1\")\n# Class: obo:CL_0004125 (retinal ganglion cell C2 inner)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004125 \"A retinal ganglion cell C inner that has dense dendritic diversity.\")\nAnnotationAssertion(rdfs:label obo:CL_0004125 \"retinal ganglion cell C2 inner\")\n# Class: obo:CL_0004126 (retinal ganglion cell C2 outer)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004126 \"A retinal ganglion cell C outer that has symmetrical and dense dendritic dendritic tree with a large dendritic field.\")\nAnnotationAssertion(rdfs:label obo:CL_0004126 \"retinal ganglion cell C2 outer\")\n# Class: obo:CL_0004137 (retinal ganglion cell A2 inner)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004137 \"A retinal ganglion A2 cell with dendrites terminating in S4.\")\nAnnotationAssertion(rdfs:label obo:CL_0004137 \"retinal ganglion cell A2 inner\")\n# Class: obo:CL_0004138 (retinal ganglion cell A2)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004138 \"A retinal ganglion A cell with dense arbor near soma.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0004138 \"outer alpha retinal ganglion cell\")\nAnnotationAssertion(rdfs:label obo:CL_0004138 \"retinal ganglion cell A2\")\n# Class: obo:CL_0004139 (retinal ganglion cell A2 outer)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12209831\") obo:IAO_0000115 obo:CL_0004139 \"A retinal ganglion A2 cell with dendrites terminating in S2.\")\nAnnotationAssertion(rdfs:label obo:CL_0004139 \"retinal ganglion cell A2 outer\")\n# Class: obo:CL_0004183 (retinal ganglion cell B3)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0004183 \"A monostratified retinal ganglion cell with medium soma, sparse dendritic tree, and medium dendritic field.\")\nAnnotationAssertion(rdfs:label obo:CL_0004183 \"retinal ganglion cell B3\")\n# Class: obo:CL_2000050 (obsolete retina retinal ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000050 \"Any retinal ganglion cell that is part of a retina.\")\nAnnotationAssertion(rdfs:label obo:CL_2000050 \"obsolete retina retinal ganglion cell\")\n# Class: obo:CL_4023032 (ON retinal ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\nAnnotationAssertion(rdfs:label obo:CL_4023032 \"ON retinal ganglion cell\")\n# Class: obo:CL_4023033 (OFF retinal ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\nAnnotationAssertion(rdfs:label obo:CL_4023033 \"OFF retinal ganglion cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023115 \"type I spiral ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") rdfs:comment obo:CL_4023115 \"Type 1 spiral ganglion neurons comprise the vast majority of spiral ganglion cells.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023116 \"type II spiral ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") rdfs:comment obo:CL_4023116 \"Outer hair cells form reciprocal synapses onto type 2 spiral ganglion cells, suggesting that the type 2 cells have both afferent and efferent roles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21557506\") Annotation(oboInOwl:hasDbXref \"PMID:67960\") obo:IAO_0000115 obo:CL_4023119 \"A subpopulation of amacrine cell that migrate further than other amacrine cells, and come to lie basal to the inner plexiform layer (IPL) in the ganglion cell layer. Displaced amacrine cells still have their neurites extending apically into the IPL, and therefore exhibit an inverted polarity with respect to the other amacrine cells.\")\n# Class: obo:CL_4023188 (midget ganglion cell of retina)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\nAnnotationAssertion(rdfs:comment obo:CL_4023188 \"There are midget bipolar cells of retina and midget ganglion cells of retina and they are not the same:\nMidget bipolar cells (imb, fmb) have larger axon terminals at greater distances from the fovea (retinal eccentricity of 4.5mm as compared to 12 mm). Midget ganglion cells (MGC) have larger dendritic fields (here seen at 8 mm) as they increase in eccentricity.\")\nAnnotationAssertion(rdfs:label obo:CL_4023188 \"midget ganglion cell of retina\")\n# Class: obo:CL_4023189 (parasol ganglion cell of retina)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M ganglion cell\")\nAnnotationAssertion(rdfs:comment obo:CL_4023189 \"These cells should not be confused with M1-M14 retinal ganglion cells described in PMID:16626866 which refer to a different classification of retinal ganglion cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4023189 \"parasol ganglion cell of retina\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033019 \"The axons of a blue cone bipolar cell terminate close to the ganglion cell layer, where they transfer the S-cone ON signal to small bistratified ganglion cells. Other targets of a blue cone bipolar cell include amacrine cells and possibly large bistratified ganglion cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033032 \"An ON diffuse bipolar cell that has a large dendritic field and large axon terminals, which show little or no overlap. This cell predominantly connects to narrow thorny ganglion cells.\")\n# Class: obo:CL_4033046 (ON midget ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033046 \"A midget ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from invaginating midget bipolar cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4033046 \"ON midget ganglion cell\")\n# Class: obo:CL_4033047 (OFF midget ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033047 \"A midget ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from flat midget bipolar cells.\")\nAnnotationAssertion(rdfs:label obo:CL_4033047 \"OFF midget ganglion cell\")\n# Class: obo:CL_4033051 (OFF parasol ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033051 \"A parasol ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB3a bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033051 \"OFF parasol ganglion cell\")\n# Class: obo:CL_4033052 (ON parasol ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033052 \"A parasol ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB4 bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033052 \"ON parasol ganglion cell\")\n# Class: obo:CL_4033053 (small bistratified retinal ganglion cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1002/cne.22183\") oboInOwl:hasExactSynonym obo:CL_4033053 \"small bistratified cell, blue-ON/yellow-OFF ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"SBS ganglion cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033053 \"small bistratified retinal ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033085 \"An ON diffuse bipolar cell that stratifies in the stratum 3 of the inner plexiform layer to make synapses with ON parasol ganglion cells. A diffuse bipolar 5 cell has high expression of MYO16 compared with other bipolar cells.\")\n","exit_code":0,"status":"completed"}}
