aluesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34680:# Class: obo:CL_4070017 (lateral pyloric motor neuron)\n34682:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070017 \"A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.\")\n34683:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6712)\n34684:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6752)\n34685:AnnotationAssertion(terms:contributor obo:CL_4070017 <https://orcid.org/0000-0002-1909-7004>)\n34686:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\n34687:AnnotationAssertion(rdfs:label obo:CL_4070017 \"lateral pyloric motor neuron\")\n34688:SubClassOf(obo:CL_4070017 obo:CL_0000100)\n34689:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34690:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34692:# Class: obo:CL_4072001 (newly formed oligodendrocyte)\n34694:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\n34695:AnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\n34696:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\n34697:AnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\n34698:SubClassOf(obo:CL_4072001 obo:CL_0000123)\n34699:SubClassOf(obo:CL_4072001 obo:CL_0000128)\n34700:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34701:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\n34703:# Class: obo:CL_4072002 (myelin-forming oligodendrocyte)\n34705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n34706:AnnotationAssertion(terms:contributor obo:CL_4072002 <https://orcid.org/0000-0002-5507-2103>)\n34707:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\n34708:AnnotationAssertion(rdfs:label obo:CL_4072002 \"myelin-forming oligodendrocyte\"@en)\n34709:SubClassOf(obo:CL_4072002 obo:CL_0000128)\n34710:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34711:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n34712:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34714:# Class: obo:CL_4072003 (mature myelinating oligodendrocyte)\n34716:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\n34717:AnnotationAssertion(terms:contributor obo:CL_4072003 <https://orcid.org/0000-0002-5507-2103>)\n34718:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\n34719:AnnotationAssertion(rdfs:label obo:CL_4072003 \"mature myelinating oligodendrocyte\")\n34720:SubClassOf(obo:CL_4072003 obo:CL_0000128)\n34721:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n34722:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072002))\n34723:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34725:# Class: obo:CL_4072005 (A8 dopaminergic neuron)\n34727:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\n34728:AnnotationAssertion(terms:date obo:CL_4072005 \"2025-05-02T08:37:36Z\"^^xsd:dateTime)\n34729:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\n34730:AnnotationAssertion(rdfs:label obo:CL_4072005 \"A8 dopaminergic neuron\")\n34731:SubClassOf(obo:CL_4072005 obo:CL_2000097)\n34732:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n34733:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34735:# Class: obo:CL_4072006 (A9 dopaminergic neuron)\n34737:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\n34738:AnnotationAssertion(terms:date obo:CL_4072006 \"2025-05-02T09:59:34Z\"^^xsd:dateTime)\n34739:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\n34740:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\n34741:AnnotationAssertion(rdfs:label obo:CL_4072006 \"A9 dopaminergic neuron\")\n34742:SubClassOf(obo:CL_4072006 obo:CL_4042025)\n34743:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))\n34744:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34745:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n34746:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535))\n34748:# Class: obo:CL_4072007 (A10 dopaminergic 