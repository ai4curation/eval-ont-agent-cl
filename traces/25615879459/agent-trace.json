nnotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072037 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L2/3 IT.\")\n35018:AnnotationAssertion(obo:RO_0002175 obo:CL_4072037 obo:NCBITaxon_9606)\n35019:AnnotationAssertion(terms:contributor obo:CL_4072037 \"https://orcid.org/0000-0002-5507-2103\")\n35020:AnnotationAssertion(terms:date obo:CL_4072037 \"2025-09-10T09:15:51Z\"^^xsd:dateTime)\n35021:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072037 \"ILX:0770156\")\n35022:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\n35023:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072037 cl:cellxgene_subset)\n35024:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072037 \"The marker set ONECUT2, COL5A2 can identify the Human cell type L2/3 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.670149932 (NS-Forest FBeta value).\")\n35025:AnnotationAssertion(rdfs:label obo:CL_4072037 \"L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35026:SubClassOf(obo:CL_4072037 obo:CL_4030059)\n35027:SubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35028:SubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000065))\n35030:# Class: obo:CL_4072038 (L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35032:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072038 \"L5 IT (Homo sapiens)\")\n35033:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072038 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L5 IT.\")\n35034:AnnotationAssertion(obo:RO_0002175 obo:CL_4072038 obo:NCBITaxon_9606)\n35035:AnnotationAssertion(terms:contributor obo:CL_4072038 \"https://orcid.org/0000-0002-5507-2103\")\n35036:AnnotationAssertion(terms:date obo:CL_4072038 \"2025-09-10T09:47:23Z\"^^xsd:dateTime)\n35037:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072038 \"ILX:0770157\")\n35038:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072038 \"L5 IT (Homo sapiens)\")\n35039:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072038 cl:cellxgene_subset)\n35040:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\n35041:AnnotationAssertion(rdfs:label obo:CL_4072038 \"L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35042:SubClassOf(obo:CL_4072038 obo:CL_4030064)\n35043:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35044:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000068))\n35046:# Class: obo:CL_4072039 (L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35048:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072039 \"L4 IT (Homo sapiens)\")\n35049:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072039 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L4 IT.\")\n35050:AnnotationAssertion(obo:RO_0002175 obo:CL_4072039 obo:NCBITaxon_9606)\n35051:AnnotationAssertion(terms:date obo:CL_4072039 \"2025-09-10T10:05:26Z\"^^xsd:dateTime)\n35052:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072039 \"L4 IT (Homo sapiens)\")\n35053:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072039 cl:cellxgene_subset)\n35054:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072039 \"The marker set RORB, ST8SIA4 can identify the Human cell type L4 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.720108696 (NS-Forest FBeta value).\")\n35055:AnnotationAssertion(rdfs:label obo:CL_4072039 \"L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35056:SubClassOf(obo:CL_4072039 obo:CL_4030063)\n35057:SubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35058:SubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000066))\n35060:# Class: obo:CL_4072040 (L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens))\n35062:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\n35063:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072040 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_cluster', L6 IT Car3.\")\n35064:AnnotationAssertion(obo:RO_0002175 obo:CL_4072040 obo:NCBITaxon_9606)\n35065:AnnotationAssertion(terms:contributor obo:CL_4072040 \"https://orcid.org/0000-0002-5507-2103\")\n35066:AnnotationAssertion(terms:date obo:CL_4072040 \"2025-09-10T10:23:11Z\"^^xsd:dateTime)\n35067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4072040 \"L6 IT Car3 glutamatergic neuron (Homo sapiens)\")\n35068:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\n35069:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 neuron (Homo sapiens)\")\n35070:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 (Homo sapiens)\")\n35071:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 cell (Homo sapiens)\")\n35072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072040 \"The marker set SMYD1, THEMIS can identify the Human cell type L6 intratelencephalic projecting Car3 glutamatergic neuron in the neocortex with a confidence of 0.877752028 (NS-Forest FBeta value).\")\n35073:AnnotationAssertion(rdfs:label obo:CL_4072040 \"L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens)\")\n35074:SubClassOf(obo:CL_4072040 obo:CL_4030068)\n35075:SubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35076:SubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000072))\n35078:# Class: obo:CL_4072041 (L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35080:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35081:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072041 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.  The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L6 IT.\")\n35082:AnnotationAssertion(obo:RO_0002175 obo:CL_4072041 obo:NCBITaxon_9606)\n35083:AnnotationAssertion(terms:contributor obo:CL_4072041 \"https://orcid.org/0000-0002-5507-2103\")\n35084:AnnotationAssertion(terms:date obo:CL_4072041 \"2025-09-11T14:38:02Z\"^^xsd:dateTime)\n35085:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072041 \"ILX:0770158\")\n35086:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35087:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072041 cl:cellxgene_subset)\n35088:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\n35089:AnnotationAssertion(rdfs:label obo:CL_4072041 \"L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35090:SubClassOf(obo:CL_4072041 obo:CL_4030065)\n35091:SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35092:SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000071))\n35094:# Class: obo:CL_4072042 (L5/6 near-projecting glutamatergic neuron (Homo sapiens))\n35096:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35097:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\n35098:AnnotationAssertion(obo:RO_0002175 obo:CL_4072042 obo:NCBITaxon_9606)\n35099:AnnotationAssertion(terms:contributor obo:CL_4072042 \"https://orcid.org/0000-0002-5507-2103\")\n35100:AnnotationAssertion(terms:date obo:CL_4072042 \"2025-09-16T08:55:09Z\"^^xsd:dateTime)\n35101:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35102:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072042 cl:cellxgene_subset)\n35103:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\n35104:AnnotationAssertion(rdfs:label obo:CL_4072042 \"L5/6 near-projecting glutamatergic neuron (Homo sapiens)\")\n35105:SubClassOf(obo:CL_4072042 obo:CL_4030067)\n35106:SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35107:SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000069))\n35109:# Class: obo:CL_4072043 (L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens))\n35111:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072043 \"L5 ET glut (Homo sapiens)\")\n35112:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\n35113:AnnotationAssertion(obo:RO_0002175 obo:CL_4072043 obo:NCBITaxon_9606)\n35114:AnnotationAssertion(terms:contributor obo:CL_4072043 \"https://orcid.org/0000-0002-5507-2103\")\n35115:AnnotationAssertion(terms:date obo:CL_4072043 \"2025-09-16T09:26:37Z\"^^xsd:dateTime)\n35116:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\n35117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\n35118:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\n35119:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\n35120:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\n35121:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\n35122:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:BDS_subset)\n35123:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:cellxgene_subset)\n35124:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\n35125:AnnotationAssertion(rdfs:label obo:CL_4072043 \"L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens)\")\n35126:SubClassOf(obo:CL_4072043 obo:CL_4023041)\n35127:SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35128:SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000067))\n35130:# Class: obo:CL_4072044 (L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens))\n35132:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072044 \"L6 CT glut (Homo sapiens)\")\n35133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L6 CT.\")\n35134:AnnotationAssertion(obo:RO_0002175 obo:CL_4072044 obo:NCBITaxon_9606)\n35135:AnnotationAssertion(terms:contributor obo:CL_4072044 \"https://orcid.org/0000-0002-5507-2103\")\n35136:AnnotationAssertion(terms:date obo:CL_4072044 \"2025-09-16T09:42:20Z\"^^xsd:dateTime)\n35137:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4072044 \"L6 CT (Homo sapiens)\")\n35138:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:BDS_subset)\n35139:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:cellxgene_subset)\n35140:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072044 \"The marker set SEMA5B, ADAMTSL1, SULF1 can identify the Human cell type L6 corticothalamic-projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.631898455 (NS-Forest FBeta value).\")\n35141:AnnotationAssertion(rdfs:label obo:CL_4072044 \"L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens)\")\n35142:SubClassOf(obo:CL_4072044 obo:CL_4023042)\n35143:SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35144:SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000070))\n35146:# Class: obo:CL_4072045 (L6b glutamatergic cortical neuron (Homo sapiens))\n35148:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072045 \"L6b glut (Homo sapiens)\")\n35149:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072045 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neuron', Author Categories: 'CrossArea_subclass', cluster L6b.\")\n35150:AnnotationAssertion(obo:RO_0002175 obo:CL_4072045 obo:NCBITaxon_9606)\n35151:AnnotationAssertion(terms:contributor obo:CL_4072045 \"https://orcid.org/0000-0002-5507-2103\")\n35152:AnnotationAssertion(terms:date obo:CL_4072045 \"2025-09-16T10:30:38Z\"^^xsd:dateTime)\n35153:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072045 \"ILX:0770163\")\n35154:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:BDS_subset)\n35155:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:cellxgene_subset)\n35156:AnnotationAssertion(rdfs:label obo:CL_4072045 \"L6b glutamatergic cortical neuron (Homo sapiens)\")\n35157:SubClassOf(obo:CL_4072045 obo:CL_4023038)\n35158:SubClassOf(obo:CL_4072045 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35160:# Class: obo:CL_4072046 (pvalb chandelier GABAergic interneuron (Homo sapiens))\n35162:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072046 \"chandelier PV interneuron (Homo sapiens)\")\n35163:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:3782465