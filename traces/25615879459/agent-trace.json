ctionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005211)))\n31637:# Class: obo:CL_4030023 (respiratory tract hillock cell)\n31639:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7772-9578>) Annotation(oboInOwl:hasDbXref \"PMID:30069044\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"PMID:33442032\") obo:IAO_0000115 obo:CL_4030023 \"A hillock cell that is located in respiratory epithelium. In some mammalian species, this cell type has been noted to express KRT13 and KRT4 and is postulated to play a role in squamous barrier function and immunomodulation.\")\n31640:AnnotationAssertion(terms:date obo:CL_4030023 \"2022-06-06T08:31:09Z\"^^xsd:dateTime)\n31641:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030023 \"hillock cell of respiratory tract\")\n31642:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030023 \"respiratory hillock cell\")\n31643:AnnotationAssertion(rdfs:label obo:CL_4030023 \"respiratory tract hillock cell\")\n31644:EquivalentClasses(obo:CL_4030023 ObjectIntersectionOf(obo:CL_4030024 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802)))\n31646:# Class: obo:CL_4030024 (hillock cell)\n31648:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30069044\") obo:IAO_0000115 obo:CL_4030024 \"An epithelial, transitional cell type between basal and secretory; located in stratified, non-ciliated structures (called hillocks) with high cell turnover in epithelium. In some mammalian species, this cell type has been noted to express KRT13 and is postulated to play a role in squamous barrier function and immunomodulation.\")\n31649:AnnotationAssertion(terms:date obo:CL_4030024 \"2022-06-24T14:52:24Z\"^^xsd:dateTime)\n31650:AnnotationAssertion(rdfs:label obo:CL_4030024 \"hillock cell\")\n31651:SubClassOf(obo:CL_4030024 obo:CL_0000066)\n31653:# Class: obo:CL_4030025 (renal cortical fibroblast)\n31655:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\n31656:AnnotationAssertion(terms:date obo:CL_4030025 \"2022-07-05T15:50:17Z\"^^xsd:dateTime)\n31657:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\n31658:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\n31659:AnnotationAssertion(rdfs:label obo:CL_4030025 \"renal cortical fibroblast\")\n31660:EquivalentClasses(obo:CL_4030025 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005270)))\n31662:# Class: obo:CL_4030026 (BEST4+ enterocyte)\n31664:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-7431-4139>) Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:35176508\") obo:IAO_0000115 obo:CL_4030026 \"An enterocyte of the human intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.\")\n31665:AnnotationAssertion(terms:date obo:CL_4030026 \"2022-09-07T12:34:20Z\"^^xsd:dateTime)\n31666:AnnotationAssertion(rdfs:label obo:CL_4030026 \"BEST4+ enterocyte\")\n31667:EquivalentClasses(obo:CL_4030026 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n31668:SubClassOf(obo:CL_4030026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n31670:# Class: obo:CL_4030027 (GABAergic amacrine cell)\n31672:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.cell.2020.08.013\") obo:IAO_0000115 obo:CL_4030027 \"An amacrine cell that uses GABA as a neurotransmitter.\")\n31673:AnnotationAssertion(terms:date obo:CL_4030027 \"2022-10-17T12:35:11Z\"^^xsd