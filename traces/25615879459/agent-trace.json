l)\n32581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033047 \"A midget ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from flat midget bipolar cells.\")\n32582:AnnotationAssertion(terms:contributor obo:CL_4033047 <https://orcid.org/0000-0001-6677-8489>)\n32583:AnnotationAssertion(terms:date obo:CL_4033047 \"2023-08-08T11:05:37Z\"^^xsd:dateTime)\n32584:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget RGC\")\n32585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget cell\")\n32586:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033047 \"outer stratifying midget cell\")\n32587:AnnotationAssertion(rdfs:label obo:CL_4033047 \"OFF midget ganglion cell\")\n32588:EquivalentClasses(obo:CL_4033047 ObjectIntersectionOf(obo:CL_4023033 obo:CL_4023188))\n32590:# Class: obo:CL_4033048 (respiratory tract suprabasal cell)\n32592:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\n32593:AnnotationAssertion(terms:contributor obo:CL_4033048 <https://orcid.org/0000-0001-6677-8489>)\n32594:AnnotationAssertion(terms:contributor obo:CL_4033048 <https://orcid.org/0000-0002-9185-3994>)\n32595:AnnotationAssertion(terms:date obo:CL_4033048 \"2023-06-20T10:44:30Z\"^^xsd:dateTime)\n32596:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory parabasal cell\")\n32597:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal cell\")\n32598:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\n32599:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.20.537495\") rdfs:comment obo:CL_4033048 \"In humans, respiratory tract suprabasal cells have been noted to have enriched expression of the following: CK8, KRT13, IVL, and SERPINB3. Single-cell sequencing indicates that suprabasal cells derived from the nasal epithelium are distinct from those in the tracheobronchial epithelium.\")\n32600:AnnotationAssertion(rdfs:label obo:CL_4033048 \"respiratory tract suprabasal cell\")\n32601:SubClassOf(obo:CL_4033048 obo:CL_0011026)\n32602:SubClassOf(obo:CL_4033048 obo:CL_7770004)\n32603:SubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802))\n32604:SubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002633))\n32606:# Class: obo:CL_4033049 (taste receptor cell of tongue)\n32608:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1111/j.1096-3642.1981.tb01137.x\") Annotation(oboInOwl:hasDbXref \"PMID:10052456\") Annotation(oboInOwl:hasDbXref \"PMID:28655883\") Annotation(oboInOwl:hasDbXref \"http://www.nejohnston.org/Birds/documents/AvianTongues_Johnston.pdf\") obo:IAO_0000115 obo:CL_4033049 \"A taste receptor cell that is part of a taste bud of a tongue.\")\n32609:AnnotationAsse