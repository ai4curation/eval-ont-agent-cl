{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"rg -n 'obo:CL_0000119|obo:CL_0000121|obo:CL_4042030' src/ontology/cl-edit.owl\"","aggregated_output":"173:Declaration(Class(obo:CL_0000119))\n175:Declaration(Class(obo:CL_0000121))\n3143:Declaration(Class(obo:CL_4042030))\n4949:# Class: obo:CL_0000119 (cerebellar Golgi cell)\n4951:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NIFSTD:sao1415726815\") obo:IAO_0000115 obo:CL_0000119 \"Large intrinsic neuron located in the granule layer of the cerebellar cortex that extends its dendrites into the molecular layer where they receive contact from parallel fibers. The axon of the Golgi cell ramifies densely in the granule layer and enters into a complex arrangement with mossy fiber terminals and granule cell dendrites to form the cerebellar glomerulus. Llinas, Walton and Lang. In The Synaptic Organization of the Brain. 5th ed. 2004.\")\n4952:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000119 \"MESH:D000080906\")\n4953:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"Golgi cell\")\n4954:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"Golgi neuron\")\n4955:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"cerebellar Golgi neuron\")\n4956:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"cerebellum Golgi cell\")\n4957:AnnotationAssertion(rdfs:label obo:CL_0000119 \"cerebellar Golgi cell\")\n4958:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_0000119 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\n4959:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0000119 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.png>)\n4960:SubClassOf(obo:CL_0000119 obo:CL_0011005)\n4961:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002956))\n4962:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002113 obo:UBERON_0002956))\n4963:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002360 obo:UBERON_0002974))\n4973:# Class: obo:CL_0000121 (Purkinje cell)\n4975:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D011689\") Annotation(oboInOwl:hasDbXref \"PMID:12907269\") Annotation(oboInOwl:hasDbXref \"PMID:14568361\") Annotation(oboInOwl:hasDbXref \"PMID:31424738\") Annotation(oboInOwl:hasDbXref \"PMID:33288911\") Annotation(oboInOwl:hasDbXref \"PMID:38168772\") obo:IAO_0000115 obo:CL_0000121 \"An inhibitory neuron and the sole output neuron of the cerebellar cortex, the Purkinje cell's soma is located between the granular and molecular layers of the cerebellum. It is one of the largest neural cells in the mammalian brain, ranging from 50 to 80 micrometres in diameter. Purkinje cells have planar, fan-shaped dendrites that branch extensively with little overlap. This cell type receives synaptic input from parallel fibres, which modulate high-frequency spike activity known as \\\"simple spikes,\\\" and climbing fibres, which modulate infrequent calcium spike activity known as \\\"complex spikes\\\". Purkinje cells are involved in motor coordination, particularly in correcting movements in progress.\")\n4976:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"BTO:0001011\")\n4977:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"CALOHA:TS-0845\")\n4978:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"FMA:67969\")\n4979:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28821816\") oboInOwl:hasExactSynonym obo:CL_0000121 \"Purkinje neuron\")\n4980:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.proghi.2004.07.002\") oboInOwl:hasExactSynonym obo:CL_0000121 \"cerebellar Purkinje cell\")\n4981:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38168772\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000121 \"PC\")\n4982:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28821816\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000121 \"PN\")\n4983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17535929\") Annotation(oboInOwl:hasDbXref \"PMID:27215193\") Annotation(oboInOwl:hasDbXref \"PMID:37426070\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.stem.2023.11.013\") rdfs:comment obo:CL_0000121 \"Neurodegenerative disorders affecting Purkinje cells disrupt motor functions. Some of the neurodegenerative disorders that causes loss and degeration of Purkinje cells are Spinocerebellar ataxias (SCAs) (Josef P Kapfhammer and Etsuko Shimobayashi 2023), Friedreich's ataxia (FRDA) (Kevin C Kemp et al., 2016), Fetal alcohol syndrome (Laurent Servais et al., 2016), Dandy-Walker malformation (Alexander Atamian et al., 2024).\")\n4984:AnnotationAssertion(rdfs:label obo:CL_0000121 \"Purkinje cell\")\n4985:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_0000121 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\n4986:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0000121 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n4987:SubClassOf(obo:CL_0000121 obo:CL_0000540)\n4988:SubClassOf(obo:CL_0000121 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n4989:SubClassOf(obo:CL_0000121 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n33835:# Class: obo:CL_4042030 (candelabrum cell)\n33837:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") obo:IAO_0000115 obo:CL_4042030 \"A GABAergic interneuron located in the Purkinje layer of the cerebellar cortex. This GABAergic interneuron type has a distinct morphology, it presents a small cell soma near the Purkinje cell layer (PCL), dendrites that extend to the surface of the molecular layer, and beaded axons that make local synapses contacts within the molecular layer. A candelabrum cell is excited by mossy fibers and granule cells but inhibited by Purkinje cells, and it inhibits molecular layer interneurons, which leads to the disinhibition of Purkinje cells.\")\n33838:AnnotationAssertion(terms:contributor obo:CL_4042030 <https://orcid.org/0000-0002-0098-8958>)\n33839:AnnotationAssertion(terms:date obo:CL_4042030 \"2024-10-15T11:06:31Z\"^^xsd:dateTime)\n33840:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") oboInOwl:hasExactSynonym obo:CL_4042030 \"candelabrum interneuron\")\n33841:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042030 \"CC\")\n33842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") rdfs:comment obo:CL_4042030 \"Candelabrum cells are the most abundant interneurons in the Purkinje cell layer and are present in all cerebellar lobules.\")\n33843:AnnotationAssertion(rdfs:label obo:CL_4042030 \"candelabrum cell\"@en)\n33844:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_4042030 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n33845:SubClassOf(obo:CL_4042030 obo:CL_0000099)\n33846:SubClassOf(obo:CL_4042030 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n33847:SubClassOf(obo:CL_4042030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n","exit_code":0,"status":"completed"}}
