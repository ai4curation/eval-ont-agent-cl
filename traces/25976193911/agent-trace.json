{"type":"tool_use","timestamp":1778975634330,"sessionID":"ses_1cccb23aeffeggp6wQdr0yt1hz","part":{"type":"tool","tool":"read","callID":"call_51LtJjG4jlNLMbxFIYiaIB56","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":25580,"limit":130},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n25580: SubClassOf(obo:CL_0020014 obo:CL_0000210)\n25581: SubClassOf(obo:CL_0020014 obo:CL_0000740)\n25582: SubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\n25583: SubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n25584: \n25585: # Class: obo:CL_0020015 (transitional principal-intercalated cell of kidney collecting duct)\n25586: \n25587: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33893305\") Annotation(oboInOwl:hasDbXref \"PMID:37468583\") obo:IAO_0000115 obo:CL_0020015 \"A transitional cell located in the renal collecting duct that co-expresses markers of both principal cell (PC) and intercalated cell (IC). This hybrid cell is enriched in Chronic Kidney Disease (CKD).\")\n25588: AnnotationAssertion(dc:creator obo:CL_0020015 \"GitHub Copilot\")\n25589: AnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0000-0002-2999-0103>)\n25590: AnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0009-0000-8480-9277>)\n25591: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") oboInOwl:hasBroadSynonym obo:CL_0020015 \"hybrid principal-intercalated cell\")\n25592: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020015 \"tPC-IC cell\")\n25593: AnnotationAssertion(rdfs:label obo:CL_0020015 \"transitional principal-intercalated cell of kidney collecting duct\")\n25594: SubClassOf(obo:CL_0020015 obo:CL_1000454)\n25595: SubClassOf(obo:CL_0020015 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232))\n25596: \n25597: # Class: obo:CL_0020016 (osteochondral skeletal stem cell)\n25598: \n25599: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")\n25600: AnnotationAssertion(terms:contributor obo:CL_0020016 <https://orcid.org/0009-0000-8480-9277>)\n25601: AnnotationAssertion(terms:creator obo:CL_0020016 \"GitHub Copilot\")\n25602: AnnotationAssertion(terms:date obo:CL_0020016 \"2025-11-27T00:00:00Z\"^^xsd:dateTime)\n25603: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020016 \"ocSSC\")\n25604: AnnotationAssertion(rdfs:label obo:CL_0020016 \"osteochondral skeletal stem cell\")\n25605: SubClassOf(obo:CL_0020016 obo:CL_0000034)\n25606: SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001434))\n25607: SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001649))\n25608: SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145))\n25609: SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051216))\n25610: \n25611: # Class: obo:CL_0020017 (M0 macrophage)\n25612: \n25613: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") Annotation(oboInOwl:hasDbXref \"PMID:30861466\") obo:IAO_0000115 obo:CL_0020017 \"A macrophage that has not yet undergone polarization into a specific macrophage subtype. These cells are non-activated and have the potential to differentiate into inflammatory (M1) or alternatively activated (M2) macrophage subtypes in response to appropriate stimuli.\")\n25614: AnnotationAssertion(dc:creator obo:CL_0020017 \"GitHub Copilot\")\n25615: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"naive macrophage\")\n25616: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"non-activated macrophage\")\n25617: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") oboInOwl:hasExactSynonym obo:CL_0020017 \"resting-state macrophages\")\n25618: AnnotationAssertion(rdfs:label obo:CL_0020017 \"M0 macrophage\")\n25619: SubClassOf(obo:CL_0020017 obo:CL_0000235)\n25620: \n25621: # Class: obo:CL_0020018 (proliferative fibrochondrocyte)\n25622: \n25623: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:39759119\") obo:IAO_0000115 obo:CL_0020018 \"A fibrochondrocyte located in fibrocartilage that exhibits active proliferation capacity and is in S phase of the cell cycle. It functions as a progenitor cell positioned at the root of developmental trajectories alongside fibrochondrocyte progenitors (FCP), with the capacity to diverge toward one of two developmental fates: (1) fibrochondrocytes and prehypertrophic chondrocytes, or (2) regulatory chondrocytes and prehypertrophic chondrocytes. It is characterised by co-expression of COL1A1, the growth factors FGF7 and CTGF, and the cell-cycle genes STMN1, KIAA0101, and MCM3 in humans. During early progenitor differentiation, FGF7 and COL1A1 expression increases and then declines as the cell commits to terminal fates.\")\n25624: AnnotationAssertion(terms:contributor obo:CL_0020018 <https://orcid.org/0009-0000-8480-9277>)\n25625: AnnotationAssertion(terms:creator obo:CL_0020018 \"GitHub Copilot\")\n25626: AnnotationAssertion(terms:date obo:CL_0020018 \"2025-11-27T12:48:39Z\"^^xsd:dateTime)\n25627: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020018 \"ProFC\")\n25628: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020018 \"Lineage relationships are inferred from single-cell RNA-seq trajectories and validated through experimental approaches, including FACS isolation, functional differentiation assays, and in vivo developmental gene expression analysis.\")\n25629: AnnotationAssertion(rdfs:label obo:CL_0020018 \"proliferative fibrochondrocyte\")\n25630: SubClassOf(obo:CL_0020018 obo:CL_4072104)\n25631: SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0022402))\n25632: SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n25633: SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007498))\n25634: \n25635: # Class: obo:CL_0020019 (regulatory chondrocyte)\n25636: \n25637: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020019 \"A chondrocyte located mainly in the superficial zone of articular cartilage. In healthy human cartilage, regulatory chondrocytes are characterized by expression of EIF5A, PGK1, ANXA1, and TUBA1A. During osteoarthritis, a distinct subpopulation expands, marked by high expression of CHI3L1, CHI3L2, CRTAC1, and AEBP1, with enrichment for signaling pathway regulation (including Toll-like receptor, mTOR, and TGF-beta signaling) and antigen-processing gene expression, with a small proportion expressing MHC class II genes, suggesting potential immune cell-like regulatory functions during osteoarthritis progression.\")\n25638: AnnotationAssertion(dc:creator obo:CL_0020019 \"GitHub Copilot\")\n25639: AnnotationAssertion(terms:contributor obo:CL_0020019 <https://orcid.org/0009-0000-8480-9277>)\n25640: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") oboInOwl:hasRelatedSynonym obo:CL_0020019 \"RegC\")\n25641: AnnotationAssertion(rdfs:label obo:CL_0020019 \"regulatory chondrocyte\")\n25642: SubClassOf(obo:CL_0020019 obo:CL_0000138)\n25643: \n25644: # Class: obo:CL_0020020 (homeostatic chondrocyte)\n25645: \n25646: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020020 \"A chondrocyte identified in both healthy and osteoarthritic human articular cartilage, and in intervertebral disc tissue. In healthy articular cartilage, a homeostatic chondrocyte is characterised by the expression of TXNIP, IFITM3, GDF15, and TIMP1 (Wang et al., 2021), among other extracellular matrix and regulatory molecules. This cell maintains cartilage integrity by producing key ECM components and supporting baseline tissue homeostasis. In OA cartilage, this cell is enriched for genes related to cellular homeostasis modulation, including regulation of the cell cycle, development, and RNA metabolism (Ji et al., 2018).\")\n25647: AnnotationAssertion(dc:creator obo:CL_0020020 \"GitHub Copilot\")\n25648: AnnotationAssertion(terms:contributor obo:CL_0020020 <https://orcid.org/0009-0000-8480-9277>)\n25649: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020020 \"HomC\")\n25650: AnnotationAssertion(rdfs:label obo:CL_0020020 \"homeostatic chondrocyte\")\n25651: SubClassOf(obo:CL_0020020 obo:CL_0000138)\n25652: SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n25653: SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990079))\n25654: \n25655: # Class: obo:CL_0020021 (fibrochondrocyte progenitor cell)\n25656: \n25657: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:36338137\") obo:IAO_0000115 obo:CL_0020021 \"A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.\")\n25658: AnnotationAssertion(terms:contributor obo:CL_0020021 <https://orcid.org/0009-0000-8480-9277>)\n25659: AnnotationAssertion(terms:creator obo:CL_0020021 \"GitHub Copilot\")\n25660: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020021 \"FCP\")\n25661: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020021 \"A fibrochondrocyte progenitor cell demonstrates colony-forming capacity and multi-lineage differentiation potential toward osteogenic and adipogenic lineages.\")\n25662: AnnotationAssertion(rdfs:label obo:CL_0020021 \"fibrochondrocyte progenitor cell\")\n25663: SubClassOf(obo:CL_0020021 obo:CL_0008019)\n25664: SubClassOf(obo:CL_0020021 obo:CL_0011026)\n25665: SubClassOf(obo:CL_0020021 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995))\n25666: \n25667: # Class: obo:CL_0020022 (prehypertrophic chondrocyte)\n25668: \n25669: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29985449\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34137454\") obo:IAO_0000115 obo:CL_0020022 \"A post-proliferative chondrocyte in the prehypertrophic zone of the cartilage tissue, located between the proliferative and hypertrophic zones. This cell is characterised by increased cell volume and expression of Indian Hedgehog (Ihh), PTH1R, and Runx2/3 in both humans and mice (Hallett et al., 2021). It coordinates the PTHrP-Ihh feedback loop that regulates chondrocyte differentiation and functions as a signalling hub for communication between proliferative chondrocytes, hypertrophic chondrocytes, and periosteal osteoblasts (Hallett et al., 2021).\")\n25670: AnnotationAssertion(terms:contributor obo:CL_0020022 <https://orcid.org/0009-0000-8480-9277>)\n25671: AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020022 \"preHTC\")\n25672: AnnotationAssertion(rdfs:label obo:CL_0020022 \"prehypertrophic chondrocyte\")\n25673: SubClassOf(obo:CL_0020022 obo:CL_0000138)\n25674: SubClassOf(obo:CL_0020022 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_0000743))\n25675: \n25676: # Class: obo:CL_0020023 (effector chondrocyte)\n25677: \n25678: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21652695\") Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:38868774\") Annotation(oboInOwl:hasDbXref \"PMID:40753276\") obo:IAO_0000115 obo:CL_0020023 \"A metabolically highly active chondrocyte that is identified in the cartilaginous tissues, including articular cartilage and intervertebral disc cartilage. In the human articular cartilage, this cell is marked by genes such as CYTL1, FRZB, CLEC3A, and S100B (Ji et al., 2018; Raut et al.,2025). This cell demonstrates strong metabolic activity and is implicated in extracellular matrix regulation and adaptive responses (Ji et al., 2018; Gan et al., 2021; Raut et al.,2025).\")\n25679: AnnotationAssertion(terms:contributor obo:CL_0020023 <https://orcid.org/0009-0000-8480-9277>)\n25680: AnnotationAssertion(terms:creator obo:CL_0020023 \"GitHub Copilot\")\n25681: AnnotationAssertion(oboInOwl:creation_date obo:CL_0020023 \"2025-12-01T11:46:23Z\"^^xsd:dateTime)\n25682: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38868774\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020023 \"EC\")\n25683: AnnotationAssertion(rdfs:label obo:CL_0020023 \"effector chondrocyte\")\n25684: SubClassOf(obo:CL_0020023 obo:CL_0000138)\n25685: \n25686: # Class: obo:CL_0020024 (alpha retinal ganglion cell OFF-sustained (Mmus))\n25687: \n25688: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020024 \"A mouse retinal ganglion cell type defined by a large soma and a wide, monostratified dendritic arbor that stratifies just distal to the outer ChAT band of the inner plexiform layer (Krieger et al., 2017). It corresponds to the G5 physiological type (Baden et al., 2016; Goetz et al., 2022) and the C42 transcriptomic cluster (Tran et al., 2019), and is considered the evolutionary ortholog of the primate OFF midget RGC (Hahn et al., 2023). The cell projects a thick, fast-conducting axon to the dorsal lateral geniculate nucleus and superior colliculus. It shows a sustained increase in firing to light decrements with a slow decay time constant of roughly 250 ms and a large receptive field center with weak surround antagonism (Krieger et al., 2017). Its molecular profile includes expression of Spp1 and Neurofilament (Smi32) together with Brn3a (Pou4f1) and Brn3b (Pou4f2), absence of Brn3c (Pou4f3) and Calbindin (Calb1), and strong enrichment of Fes (Krieger et al., 2017; Tran et al., 2019).\")\n25689: AnnotationAssertion(obo:RO_0002175 obo:CL_0020024 obo:NCBITaxon_10090)\n25690: AnnotationAssertion(terms:contributor obo:CL_0020024 <https://orcid.org/0000-0002-5507-2103>)\n25691: AnnotationAssertion(terms:creator obo:CL_0020024 \"GitHub Copilot\")\n25692: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020024 \"C42\")\n25693: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") oboInOwl:hasExactSynonym obo:CL_0020024 \"G5\")\n25694: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020024 \"alpha retinal ganglion cell OFF-s\")\n25695: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020024 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25696: AnnotationAssertion(rdfs:label obo:CL_0020024 \"alpha retinal ganglion cell OFF-sustained (Mmus)\")\n25697: SubClassOf(obo:CL_0020024 obo:CL_0004117)\n25698: SubClassOf(obo:CL_0020024 obo:CL_4023033)\n25699: SubClassOf(obo:CL_0020024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n25700: \n25701: # Class: obo:CL_0020025 (alpha retinal ganglion cell ON-sustained (Mmus))\n25702: \n25703: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:38092908\") obo:IAO_0000115 obo:CL_0020025 \"A retinal ganglion cell type that has a large soma and a wide, monostratified dendritic arbor that stratifies in the inner sublamina of the inner plexiform layer, with dendrites located just proximal to the inner ChAT band (Krieger et al., 2017). It shows a sustained increase in firing rate to ON stimuli (Krieger et al., 2017). It corresponds to the G24 functional type (Baden et al., 2016; Goetz et al., 2022), the C43 transcriptomic cluster (Tran et al., 2019), and is considered the mouse ortholog of the primate ON midget retinal ganglion cell (Hahn et al., 2023). It is molecularly defined by expression of Spp1, Smi32, Brn3b, Calbindin, and Tbr2 (Krieger et al., 2017; Tran et al., 2019).\")\n25704: AnnotationAssertion(obo:RO_0002175 obo:CL_0020025 obo:NCBITaxon_10090)\n25705: AnnotationAssertion(terms:contributor obo:CL_0020025 \"https://orcid.org/0000-0002-5507-2103\")\n25706: AnnotationAssertion(terms:creator obo:CL_0020025 \"GitHub Copilot\")\n25707: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020025 \"C43\")\n25708: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") oboInOwl:hasExactSynonym obo:CL_0020025 \"G24\")\n25709: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020025 \"alpha retinal ganglion cell ON-s\")\n\n(Showing lines 25580-25709 of 35584. Use offset=25710 to continue.)\n</content>","metadata":{"preview":"SubClassOf(obo:CL_0020014 obo:CL_0000210)\nSubClassOf(obo:CL_0020014 obo:CL_0000740)\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n\n# Class: obo:CL_0020015 (transitional principal-intercalated cell of kidney collecting duct)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33893305\") Annotation(oboInOwl:hasDbXref \"PMID:37468583\") obo:IAO_0000115 obo:CL_0020015 \"A transitional cell located in the renal collecting duct that co-expresses markers of both principal cell (PC) and intercalated cell (IC). This hybrid cell is enriched in Chronic Kidney Disease (CKD).\")\nAnnotationAssertion(dc:creator obo:CL_0020015 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0000-0002-2999-0103>)\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") oboInOwl:hasBroadSynonym obo:CL_0020015 \"hybrid principal-intercalated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020015 \"tPC-IC cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020015 \"transitional principal-intercalated cell of kidney collecting duct\")\nSubClassOf(obo:CL_0020015 obo:CL_1000454)\nSubClassOf(obo:CL_0020015 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232))\n\n# Class: obo:CL_0020016 (osteochondral skeletal stem cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778975634250,"end":1778975634328}},"id":"prt_e3335f0d8001k8315DElurIEu9","sessionID":"ses_1cccb23aeffeggp6wQdr0yt1hz","messageID":"msg_e3335eb8b001kmAvbJq9j339UR"}}
