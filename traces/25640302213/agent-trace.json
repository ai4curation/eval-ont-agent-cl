28991).\")\nSubClassOf(obo:CL_0002453 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000047))\nSubClassOf(obo:CL_0002453 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000339))\nSubClassOf(obo:CL_0002461 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002010))\nSubClassOf(obo:CL_0002462 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002010))\nSubClassOf(obo:CL_0002528 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002527))\nSubClassOf(obo:CL_0002531 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002530))\nSubClassOf(obo:CL_0002534 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002533))\n# Class: obo:CL_0002546 (embryonic blood vessel endothelial progenitor cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002546 \"An endothelial progenitor cell that participates in angiogenesis during development.\")\nAnnotationAssertion(rdfs:label obo:CL_0002546 \"embryonic blood vessel endothelial progenitor cell\")\n# Class: obo:CL_0002619 (adult endothelial progenitor cell)\nAnnotationAssertion(rdfs:comment obo:CL_0002619 \"The existence of adult endothelial progenitor cells has been controversial in the past.\")\nAnnotationAssertion(rdfs:label obo:CL_0002619 \"adult endothelial progenitor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17519333\") Annotation(oboInOwl:hasDbXref \"PMID:19745164\") oboInOwl:hasExactSynonym obo:CL_0002664 \"cardiovascular progenitor cell\")\n# Class: obo:CL_0002672 (retinal progenitor cell)\nAnnotationAssertion(rdfs:label obo:CL_0002672 \"retinal progenitor cell\")\nSubClassOf(obo:CL_0002672 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000133))\nSubClassOf(obo:CL_0002676 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333))\nSubClassOf(obo:CL_0005001 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333))\nSubClassOf(obo:CL_0005002 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333))\nSubClassOf(obo:CL_0005003 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333))\nSubClassOf(obo:CL_0005004 ObjectSomeValuesFrom(obo: