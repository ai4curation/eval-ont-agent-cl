o:IAO_0000115 obo:CL_0009088 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. These cells do not form colonies.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33419165\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_colony_forming_cell&oldid=1068242094\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_0009090 \"An adult endothelial progenitor cell that is resident of adult vasculature and capable of differentiating to regenerate endothelial cell populations. Endothelial colony forming cells are characterised in vivo by clonal proliferative status, de novo vessel formation, homing to ischemic sites and paracrine support of angiogenesis. These cells are phenotypically similar to endothelial cells.\")\n# Class: obo:CL_0009099 (fibro/adipogenic progenitor cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\nAnnotationAssertion(rdfs:label obo:CL_0009099 \"fibro/adipogenic progenitor cell\")\n# Class: obo:CL_0009116 (progenitor cell of mammary luminal epithelium)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19063729\") Annotation(oboInOwl:hasDbXref \"PMID:20346151\") Annotation(oboInOwl:hasDbXref \"PMID:21930782\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4412-7970\") obo:IAO_0000115 obo:CL_0009116 \"A progenitor cell with the potential to differentiate into luminal epithelial cells of mammary glands. In mouse, CD61 and c-kit were found to be coexpressed by the majority of, but not all, committed luminal progenitor cells.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009116 \"luminal progenitor cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009116 \"progenitor cell of luminal mammary epithelium\")\nAnnotationAssertion(rdfs:label obo:CL_0009116 \"progenitor cell of mammary luminal epithelium\")\n# Class: obo:CL_0011020 (neural progenitor cell)\nAnnotationAssertion(rdfs:label obo:CL_0011020 \"neural progenitor cell\")\nSubClassOf(obo:CL_0011020 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000047))\n# Class: obo:CL_0011026 (progenitor cell)\nAnnotationAssertion(rdfs:label obo:CL_0011026 \"progenitor cell\")\nEquivalentClasses(obo:CL_0011026 ObjectIntersectionOf(obo:CL_0011115 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000034)))\nSubClassOf(obo:CL_0011031 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000576))\nSubClassOf(obo:CL_0019031 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4047017))\nSubClassOf(obo:CL_0019032 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\nSubClassOf(obo:CL_1000488 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0005026))\nSubClassOf(obo:CL_2000002 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002255))\nSubClassOf(obo:CL_4023017 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\nSubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\nEquivalentClasses(obo:CL_4023035 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004025)))\nSubClassOf(obo:CL_4023051 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0011012))\nSubClassOf(obo:CL_4023054 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000077))\nSubClassOf(obo:CL_4023059 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002453))\nEquivalentClasses(obo:CL_4023063 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024)))\nEquivalentClasses(obo:CL_4023064 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026)))\nEquivalentClasses(obo:CL_4023069 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\nEquivalentClasses(obo:CL_4023079 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0001891)))\n# Class: obo:CL_4023098 (obsolete L2/3 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_4023098 \"obsolete L2/3 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023099 (obsolete L5 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_4023099 \"obsolete L5 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023100 (obsolete L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_4023100 \"obsolete L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023101 (obsolete L5/6 near-projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_4023101 \"obsolete L5/6 near-projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\nSubClassOf(obo:CL_4023121 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n# Class: obo:CL_4030006 (fallopian tube secretory epithelial cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\nAnnotationAssertion(rdfs:label obo:CL_4030006 \"fallopian tube secretory epithelial cell\")\nSubClassOf(obo:CL_4030006 obo:CL_4052019)\n# Class: obo:CL_4030007 (fallopian tube multiciliated epithelial cell)\nAnnotationAssertion(rdfs:label obo:CL_4030007 \"fallopian tube multiciliated epithelial cell\")\nSubClassOf(obo:CL_4030037 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4030036))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") rdfs:comment obo:CL_4030038 \"After acute tubular injury, this cell type becomes more numerous. In healthy rat kidneys, this cell is not detectable, whereas after unilateral ureteral obstruction (renal injury), it may appear de novo, arguing against the notion that this cell type represents a pre-existing progenitor cell population. In at least one study, data indicate that this cell type represents transiently dedifferentiated tubular cells involved in regeneration.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2210508\") Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasDbXref \"PMID:30023181\") obo:IAO_0000115 obo:CL_4033014 \"A small, narrow, peg-shaped epithelial cell with little cytoplasm that is part of oviduct epithelium. This cell is rarer than the ciliated and secretory epithelial cells of the fallopian tube epithelium and is often found intercalated between them. Peg cells are generally distributed basally along the epithelium and have been found in high concentrations at the fimbriated, distal end of the fallopian tube in humans. It may have a regenerative/stem-cell function. In humans, markers include EPCAM, CD44, and ITGA6.\")\nSubClassOf(obo:CL_4033014 obo:CL_4052019)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\nSubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002633))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor cell\")\nSubClassOf(obo:CL_4033062 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0008036))\nSubClassOf(obo:CL_4033063 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0008036))\nSubClassOf(obo:CL_4033065 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000788))\nSubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4033084))\nSubClassOf(obo:CL_4033090 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000501))\nSubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10467245\") obo:IAO_0000115 obo:CL_4042021 \"A progenitor cell of the central nervous system that differentiates exclusively onto neurons. This progenitor cell is found in a hippocampus subventricular zone, developing cortex and spinal cord of the central nervous system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15531362\") Annotation(oboInOwl:hasDbXref \"PMID:33052610\") obo:IAO_0000115 obo:CL_4042022 \"A progenitor cell of the central nervous system that differentiates exclusively onto astrocytes. This progenitor cell expresses CD44 and S100 calcium-binding protein B.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") rdfs:comment obo:CL_4042022 \"In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.\")\nSubClassOf(obo:CL_4042031 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002453))\nSubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\nSubClassOf(obo:CL_4042039 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\nSubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\nSubClassOf(obo:CL_4052012 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\nSubClassOf(obo:CL_4052013 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\n# Class: obo:CL_4052018 (fallopian tube epithelial cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\nAnnotationAssertion(terms:contributor obo:CL_4052018 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052018 \"2024-10-01T12:09:12Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasBroadSynonym obo:CL_4052018 \"oviduct epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasExactSynonym obo:CL_4052018 \"uterine tube epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052018 \"fallopian tube epithelial cell\")\nEquivalentClasses(obo:CL_4052018 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n# Class: obo:CL_4052019 (fallopian tube non-ciliated epithelial cell)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\nAnnotationAssertion(terms:contributor obo:CL_4052019 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052019 \"2024-10-01T12:12:12Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052019 \"fallopian tube non-ciliated cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052019 \"fallopian tube non-ciliated epithelial cell\")\nSubClassOf(obo:CL_4052019 obo:CL_0000066)\nSubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\nSubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:CL_4030045 obo:GO_0005929))\nSubClassOf(obo:CL_4052027 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000503))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\nSubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000860))\nSubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742)) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000031))\n","exit_code":0,"status":"completed"}}
