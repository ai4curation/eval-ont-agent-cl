{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '31215,31248p' src/ontology/cl-edit.owl && sed -n '33820,33850p' src/ontology/cl-edit.owl && sed -n '33868,33882p' src/ontology/cl-edit.owl && sed -n '34180,34208p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(terms:date obo:CL_4030005 \"2022-09-14T16:19:11Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_4030005 \"B-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_4030005 \"kidney collecting duct intercalated cell type B\")\nAnnotationAssertion(rdfs:label obo:CL_4030005 \"kidney collecting duct beta-intercalated cell\")\nEquivalentClasses(obo:CL_4030005 ObjectIntersectionOf(obo:CL_0002201 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004203)))\n\n# Class: obo:CL_4030006 (fallopian tube secretory epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1186/1477-7827-7-129\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.3390/cells8080933\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") obo:IAO_0000115 obo:CL_4030006 \"An epithelial cell that is part of the fallopian tube that secretes mucus and oviduct-specific products in response to hormonal stimulation from estrogen and luteinizing hormone. This fallopian tube secretory cell is similar in height to the ciliated cell, but typically exhibits a more narrow, columnar shape. Its nucleus is ovoid and oriented perpendicular to the cell's long axis, with denser chromatin and a smaller nucleolus compared to the ciliated cell.\")\nAnnotationAssertion(terms:contributor obo:CL_4030006 <https://orcid.org/0000-0002-0819-0473>)\nAnnotationAssertion(terms:date obo:CL_4030006 \"2022-03-03T10:39:31Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030006 \"oviduct secretory epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030006 \"uterine tube secretory epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\nAnnotationAssertion(rdfs:label obo:CL_4030006 \"fallopian tube secretory epithelial cell\")\nSubClassOf(obo:CL_4030006 obo:CL_1001591)\nSubClassOf(obo:CL_4030006 obo:CL_4052019)\nSubClassOf(obo:CL_4030006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n\n# Class: obo:CL_4030007 (fallopian tube multiciliated epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16565155\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube\") obo:IAO_0000115 obo:CL_4030007 \"A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.\")\nAnnotationAssertion(terms:contributor obo:CL_4030007 <https://orcid.org/0000-0002-0819-0473>)\nAnnotationAssertion(terms:date obo:CL_4030007 \"2022-03-08T12:40:19Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030007 \"oviduct ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube multiciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"uterine tube ciliated epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4030007 \"fallopian tube multiciliated epithelial cell\")\nSubClassOf(obo:CL_4030007 obo:CL_0005012)\nSubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\nSubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007589))\n\n# Class: obo:CL_4030008 (pronephric podocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:32375819\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK27998/\") obo:IAO_0000115 obo:CL_4052017 \"A capillary endothelial cell that is part of the choroid plexus, characterized by its fenestrated nature with 60 to 80 nm fenestrations and lack of tight junctions. This fenestrated structure allows for the rapid delivery of water and other components, aiding in the production of cerebrospinal fluid (CSF).\")\nAnnotationAssertion(terms:contributor obo:CL_4052017 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052017 \"2024-10-01T11:38:22Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4052017 \"choroid plexus capillary endothelial cell\")\nEquivalentClasses(obo:CL_4052017 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001886)))\nSubClassOf(obo:CL_4052017 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n\n# Class: obo:CL_4052018 (fallopian tube epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\nAnnotationAssertion(terms:contributor obo:CL_4052018 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052018 \"2024-10-01T12:09:12Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasBroadSynonym obo:CL_4052018 \"oviduct epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasExactSynonym obo:CL_4052018 \"uterine tube epithelial cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052018 \"fallopian tube epithelial cell\")\nEquivalentClasses(obo:CL_4052018 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n\n# Class: obo:CL_4052019 (fallopian tube non-ciliated epithelial cell)\n\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\nAnnotationAssertion(terms:contributor obo:CL_4052019 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052019 \"2024-10-01T12:12:12Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052019 \"fallopian tube non-ciliated cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052019 \"fallopian tube non-ciliated epithelial cell\")\nSubClassOf(obo:CL_4052019 obo:CL_0000066)\nSubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\nSubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:CL_4030045 obo:GO_0005929))\n\n# Class: obo:CL_4052020 (lung resident granzyme K-associated CD8 T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"CD8-GZMK cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"TteK CD8 cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052021 \"granzyme K-associated CD8 T cell\")\nEquivalentClasses(obo:CL_4052021 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n\n# Class: obo:CL_4052022 (fallopian tube smooth muscle cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31183831\") Annotation(oboInOwl:hasDbXref \"PMID:31613440\") obo:IAO_0000115 obo:CL_4052022 \"A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.\")\nAnnotationAssertion(terms:contributor obo:CL_4052022 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052022 \"2024-10-21T12:16:54Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasBroadSynonym obo:CL_4052022 \"oviduct smooth muscle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasExactSynonym obo:CL_4052022 \"uterine tube smooth muscle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18621753\") rdfs:comment obo:CL_4052022 \"The fallopian tube smooth muscle cell in the human contracts dynamically in response to hormones and signaling molecules. Prostaglandins, particularly PGF2α and PGE2, have been shown to increase muscular contractions, while progesterone, levonorgestrel, mifepristone, oxytocin, and human chorionic gonadotropin (hCG) decrease them. These contractile responses are crucial for regulating gamete and embryo transport through the fallopian tube.\")\nAnnotationAssertion(rdfs:label obo:CL_4052022 \"fallopian tube smooth muscle cell\")\nEquivalentClasses(obo:CL_4052022 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n# Class: obo:CL_4052052 (uterine natural killer cell 2, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(terms:contributor obo:CL_4052052 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052052 \"2025-03-14T14:31:03Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\nAnnotationAssertion(rdfs:label obo:CL_4052052 \"uterine natural killer cell 2, human\")\nEquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n\n# Class: obo:CL_4052053 (uterine natural killer cell 3, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(terms:contributor obo:CL_4052053 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052053 \"2025-03-14T16:15:39Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\nAnnotationAssertion(rdfs:label obo:CL_4052053 \"uterine natural killer cell 3, human\")\nEquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n\n# Class: obo:CL_4052055 (mature NK T cell, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\nAnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052055 \"2025-03-26T11:56:38Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\n","exit_code":0,"status":"completed"}}
