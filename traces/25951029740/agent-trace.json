id obo:CL_2000078 \"CL:2000078\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000079 \"Any mesenchymal stem cell of the bone marrow that is part of a femur.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000079 \"2014-12-02T19:07:31Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000079 \"CL:2000079\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000080 \"Any mesenchymal stem cell of adipose tissue that is part of an abdomen.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000080 \"2014-12-02T19:10:34Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_2000080 \"mesenchymal stem cell of abdominal adipose\")\nAnnotationAssertion(oboInOwl:id obo:CL_2000080 \"CL:2000080\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000081 \"Any melanocyte of skin that is part of a skin of face.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000081 \"2014-12-02T19:10:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000081 \"CL:2000081\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000082 \"OBSOLETE. Any melanocyte of skin that is part of a skin of prepuce of penis.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000082 \"2014-12-02T19:10:45Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000082 \"CL:2000082\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000083 \"Any hair follicle dermal papilla cell that is part of a scalp.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000083 \"2014-12-02T19:10:50Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000083 \"CL:2000083\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:27091323\") Annotation(oboInOwl:hasDbXref \"PMID:28475124\") Annotation(oboInOwl:hasDbXref \"PMID:31734511\") obo:IAO_0000115 obo:CL_2000084 \"A goblet cell that is part of the conjunctival epithelium, characterized by apical accumulation of mucin granules (containing MUC5AC in humans; Muc5ac/Muc5b in mice). These gel-forming mucins support tear film stability, ocular lubrication, and pathogen defence. The conjunctival goblet cell forms tight junctions with neighbouring epithelial cells via species-specific claudins (claudin-10 in humans, claudin-2 in mice) and regulates immune homeostasis by facilitating soluble antigen transport to dendritic cells through goblet cell-associated antigen passages (GAPs) (Barbosa et al., 2017). The transcription factor SPDEF is essential for its differentiation.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000084 \"2014-12-02T19:28:38Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31734511\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_2000084 \"CGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000085 \"Any mononuclear cell that is part of a umbilical cord.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000085 \"2014-12-02T20:14:16Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000085 \"CL:2000085\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000086 \"Any basket cell that is part of a neocortex.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000086 \"2014-12-24T00:37:19Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000086 \"CL:2000086\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000087 \"Any basket cell that is part of a dentate gyrus of hippocampal formation.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000087 \"2014-12-24T00:37:24Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000087 \"CL:2000087\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000088 \"Any basket cell that is part of a Ammon's horn.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000088 \"2014-12-24T00:37:30Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000088 \"CL:2000088\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:17765709\") obo:IAO_0000115 obo:CL_2000089 \"A granule cell that has soma location in the dentate gyrus cell layer of the hippocampal formation and has an elliptical cell body and characteristic cone-shaped tree of spiny apical dendrites. The branches extend throughout the molecular layer and the distal tips of the dendritic tree end just at the hippocampal fissure or at the ventricular surface. The dentate gyrus granule cell is the principal cell type of the dentate gyrus.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000089 \"2015-02-23T05:48:23Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_2000089 \"dentate gyrus of hippocampal formation granule cell\")\nAnnotationAssertion(oboInOwl:id obo:CL_2000089 \"CL:2000089\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17765709\") rdfs:comment obo:CL_2000089 \"As far as can be determined, all dentate granule cells appear to project to CA3 and the axon trajectory is partially correlated with the position of the parent cell body.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000090 \"Any stellate cell that is part of a dentate gyrus of hippocampal formation.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000090 \"2015-02-23T05:48:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000090 \"CL:2000090\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000091 \"Any microvascular endothelial cell that is part of a endometrial blood vessel.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000091 \"2015-03-31T21:02:36Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000091 \"CL:2000091\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000092 \"Any keratinocyte that is part of a hair follicle.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000092 \"2015-03-31T21:07:02Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000092 \"CL:2000092\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000093 \"Any fibroblast of lung that is part of a bronchus.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000093 \"2015-03-31T21:16:22Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000093 \"CL:2000093\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000094 \"Any epithelial cell of viscerocranial mucosa that is part of a nasal cavity respiratory epithelium.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000094 \"2015-03-31T22:25:17Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000094 \"CL:2000094\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000095 \"Any hematopoietic stem cell that is part of a umbilical cord blood.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000095 \"2015-05-26T18:58:34Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000095 \"CL:2000095\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:29266210\") Annotation(oboInOwl:hasDbXref \"PMID:35212000\") Annotation(oboInOwl:hasDbXref \"PMID:36232952\") Annotation(oboInOwl:hasDbXref \"PMID:37646029\") obo:IAO_0000115 obo:CL_2000096 \"A fibroblast of dermis that resides in the deep reticular layer, characterised by robust extracellular matrix production with high type I collagen deposition forming densely packed, organised fibrillar networks (Ghetti et al., 2018). This cell exhibits pro-fibrotic properties during wound healing, entering wounds early where it proliferates and deposits collagen to restore dermal architecture (Knoedler et al., 2023; McAndrews et al., 2022). It is distinguished from papillary dermal fibroblasts by expression of COL11A1, POSTN, and SPP1 in humans (Wu et al., 2022).\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000096 \"2015-08-11T16:28:16Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29266210\") oboInOwl:hasRelatedSynonym obo:CL_2000096 \"reticular fibroblast\")\nAnnotationAssertion(oboInOwl:id obo:CL_2000096 \"CL:2000096\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000097 \"Any dopaminergic neuron that is part of a midbrain.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000097 \"2015-12-03T16:42:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000097 \"CL:2000097\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:29802404\") obo:IAO_0000115 obo:CL_3000000 \"A ciliated epithelial cell of the esophagus.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_3000000 \"2019-02-09T16:40:30Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_3000000 \"CL:3000000\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:30498493\") Annotation(oboInOwl:hasDbXref \"PMID:34745147\") Annotation(oboInOwl:hasDbXref \"PMID:35438172\") obo:IAO_0000115 obo:CL_3000001 \"A tissue-resident macrophage that is part of the placenta. A Hofbauer cell expresses high levels of growth factors and metalloproteinases that support vasculogenesis, angiogenesis, branching morphogenesis and tissue remodeling. A Hofbauer cell has a fetal origin, is found in the villous stroma, chorion, and amnion, and is present throughout pregnancy.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_3000001 \"2019-02-18T19:41:20Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasExactSynonym obo:CL_3000001 \"fetal Hofbauer cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_3000001 \"HBC\")\nAnnotationAssertion(oboInOwl:id obo:CL_3000001 \"CL:3000001\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30498493\") rdfs:comment obo:CL_3000001 \"Hofbauer cells are a heterogenic group of macrophages that resemble M2-like cells. Initially described in chorionic villi in humans, a Hofbauer cell is now often used to describe any fetal-derived placental macrophage that resides within the placental villous core, amnion, and chorion laeve.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_3000002 \"Sympathetic noradrenergic neuron.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_3000002 \"2019-02-25T19:30:14Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_3000002 \"CL:3000002\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_3000003 \"A type of autonomic neuron that releases acetylcholine.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_3000003 \"2019-02-25T19:32:20Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_3000003 \"CL:3000003\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:31554486\") Annotation(oboInOwl:hasDbXref \"PMID:35858549\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Sensory_neuron\") Annotation(oboInOwl:hasDbXref \"https://www.britannica.com/science/sensory-neuron\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539846/\") obo:IAO_0000115 obo:CL_3000004 \"A neuron type that is located in a peripheral nervous system and it transmits sensory information from the peripheral (PNS) to the central nervous system (CNS). A sensory neuron converts physical (light, sound, touch) or chemical (such as taste and smell) stimuli into an electrical signal through a process known as sensory transduction. The function of a sensory neuron is to carry informations from the external environment and internal body conditions to the central nervous system for further processing.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_3000004 \"2019-02-25T19:34:33Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_3000004 \"CL:3000004\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Sensory_neuron\") rdfs:comment obo:CL_3000004 \"Typically, a sensory neuron has a pseudounipolar morphology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006000 \"breast fibroblast\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006001 \"skin of scalp fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023000 \"A motor neuron that innervates both intrafusal and extrafusal muscle fibers. Low abundancy. They control both muscle contraction and responsiveness of the sensory feedback from muscle spindles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023001 \"A beta motor neuron that innervates nuclear chain fibers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023002 \"A beta motor neuron that innervates the nuclear bag fibers of muscle spindles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023003 \"A type of intrafusal muscle fiber that has nuclei arranged in a linear row. Unlike nuclear bag fibers, the equatorial region of these fibers (in the centre of the spindle) is not expanded. These fibers are responsible for the detection of changes in muscle length. They are innervated by static gamma motor neurons and are principally associated with type II sensory fibers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023004 \"A type of intrafusal muscle fiber that lies in the center of a muscle spindle. Nuclei are clustered centrally and give the equatorial region a swollen appearance. They are associated with associated with dynamic gamma motor neurons, and the stretching of the equatorial region of the nuclear bag fibers results in an increase in the firing rate of type Ia sensory fibers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023005 \"A nuclear bag fiber that is sensitive mainly to the rate of change in muscle length.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"bag1 fiber\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"nuclear bag1 intrafusal fiber\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023006 \"A nuclear bag fiber that is sensitive only changes in muscle length but not the rate of that change.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"bag2 fiber\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"nuclear bag2 intrafusal fiber\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") obo:IAO_0000115 obo:CL_4023007 \"A VIP GABAergic cortical interneuron with bipolar morphology, with a soma found in L2/3. L2/3 bipolar VIP cells have extending axons across all layers (with preferences for layers II/III and Va) and a dendritic tree that is vertically more restricted than deeper layer VIP cells and extend fewer dendrites into the layers outside their home layer (location of soma). L2/3 bipolar VIP cells have great variability in firing patterns, though most are continuous adapting. L2/3 bipolar VIP cells are more depolarized in their resting state, had less fast rectification, and had smaller after hyperpolarization than deeper VIP cells.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023007 \"L2/3 bipolar Vip (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023007 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") obo:IAO_0000115 obo:CL_4023008 \"A glutamatergic neuron located in the cerebral cortex that projects to structures of telencephalic origins.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023008 \"ILX:0770100\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-021-24565-z\") oboInOwl:hasExactSynonym obo:CL_4023008 \"IT neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023008 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023009 \"A glutamatergic neuron located in the cerebral cortex that projects to structures not derived from telencephalon.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023009 \"ILX:0770101\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023009 \"ET projecting neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023009 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023010 \"A GABAergic cortical interneuron that is strongly labelled for α7 nAChRs. These cells have soma found in L1 and have multipolar dendrites with vertically descending axonal collaterals that project deep into the column, usually branching and terminating in L5A.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023010 \"A7 cell (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023010 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023010 \"Unlike typical Lamp5 electrophysiology, A7 cells have Vip- and Sst-like firing properties, with active depolarizing hump at near-threshold membrane potentials, and  larger hyperpolarization sag, stronger burst, and rebound firing. A7 cells have a transcriptomics signature that looks like Lamp5 GABAergic interneuron.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023011 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023011 \"ILX:0770149\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023011 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023012 \"A glutamatergic neuron located in the cerebral cortex that projects axons locally rather than distantly.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023012 \"ILX:0770103\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023012 \"NP neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023012 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023013 \"A glutamatergic neuron located in the cerebral cortex that projects to the thalamus.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023013 \"CT projecting neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023013 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:26612957\") obo:IAO_0000115 obo:CL_4023014 \"A VIP GABAergic cortical interneuron with a soma found in L5. L5 VIP cells have mostly local morphology with some deep-projecting axons. They show only moderate resistance, comparable to that of sst subclass and unlike typical VIP subclass cells that tend to show high input resistance. L5 VIP cells show particularly low resting membrane potential.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023014 \"L5 VIP (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023014 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023015 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023015 \"ILX:0770150\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023015 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023016 \"A transcriptomically distinct GABAergic neuron derived from the CGE and that expresses the vasoactive intestinal polypeptide. Its soma is located in the forebrain.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35221922\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP-Expressing GABAergic Neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"Vip GABAergic neuron\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023016 \"ILX:0770151\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP type\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP-IN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"Vip\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023016 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023017 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst) and derived from the MGE.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023017 \"ILX:0770152\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"SOM+ inhibitory interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"SST+ IN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"somatostatin-expressing inhibitory interneuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023017 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023018 \"A transcriptomically distinct GABAergic interneuron with a soma located in the pallium. These neurons express Parvalbumin.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023018 \"ILX:0770154\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023018 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023019 \"A VIP GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023019 \"L5/6 CCK Vip (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023019 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023020 \"A gamma motor neuron that innervates dynamic nuclear bag fibers (bag1 fibers) and enhances the sensitivities of Ia sensory neurons. They alter muscle spindle sensitivity and increases its discharge in response to velocity of muscle length (rather than just magnitude).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023021 \"A gamma motor neuron that innervates static nuclear bag fibers (bag2 fibers) and increases their firing, in response to an increase in the magnitude of change in length, and controls the static sensitivity of the stretch reflex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") obo:IAO_0000115 obo:CL_4023022 \"A Lamp5 GABAergic cortical interneuron that has extended axons in the surface of L1. Canopy Lamp5 cells resemble neurogliaform cells in having elongated horizontal axonal arbors largely confined to L1; but the dendritic arbors are wider and have fewer branches, while the axon is less tortuous and extends further from the soma\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023022 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023023 \"A lamp 5 GABAergic cortical interneuron with neurogliaform morphology with a soma found in L5,6. L5,6 NGC lamp5 have deep afterhyperpolarization (AHP) but narrow action potentials (APs). Unlike other deep neurogliaform cells (which are caudal ganglionic eminence (CGE) derived), L5,6 NGC lamp5 cells are medial ganglionic eminence (MGE)-derived\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023023 \"L5,6 NGC Lamp5 (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023023 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") obo:IAO_0000115 obo:CL_4023024 \"A lamp5 GABAergic cortical interneuron with layer-adapting morphology. NGC lamp5 cells have a small round soma, short dendrites, and a wide dense axonal arbor that tends to establish a dense axonal mesh with high connection probability both to themselves and L2 pyramidal cells. NGC lamp5 cells have unique synaptic properties that distinguish them from other GABAergic interneurons, including the release of GABA to the extracellular space via volume transmission, and the ability to produce GABA-B responses in connected postsynaptic targets.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023024 \"NGC Lamp5 (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023024 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023025 \"A sst GABAergic cortical interneuron that is both an interneuron and a projecting neuron. They are found in all layers from upper L2/3 down to the bottom of L6. They have long-range projections, some with axons fading into white matter. These cells have low rebound potential, low hyperpolarization sag, and high variability in membrane time constant.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023025 \"LP SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023025 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2147780\") Annotation(oboInOwl:hasDbXref \"PMID:215920\") Annotation(oboInOwl:hasDbXref \"PMID:23354054\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasDbXref \"PMID:9004351\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023026 \"A GABAergic medium spiny neuron located in the striatum that gives rise to the direct basal ganglia pathway. It projects directly to the GPi and SNr, where it inhibits tonically active GABAergic output neurons to disinhibit thalamic and brainstem motor targets (Gerfen. 2023). In mice and humans, this cell selectively expresses the D1 dopamine receptor (DRD1), which couples to stimulatory G-proteins (Gs/Gαolf) to increase cAMP and activate PKA-dependent signaling cascades (Gerfen et al., 1990; Kebabian & Calne, 1979). Functionally, activation of this cell promotes selected motor actions by disinhibiting thalamic and midbrain motor centers (Mink, 1996; Cui et al., 2013).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023026 \"dopamine 1 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023026 \"D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023026 \"dSPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26018615\") Annotation(oboInOwl:hasDbXref \"PMID:29737578\") rdfs:comment obo:CL_4023026 \"Despite the direct and indirect circuits are often described not only as functionally opposing but also as anatomically segregated there are several anatomical and functional studies that have challenged this notion of pure segregation based on extensive collateral projections between pathways, dual-projection neurons, simultaneous co-activation during behavior.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023027 \"A sst GABAergic cortical interneuron with a soma found in L5 and possesses 'T-shaped' Martinotti morphologies with local axonal plexus in L5a and translaminar axons restricted to the uppermost part of L1. They show low-threshold spiking patterns with strong rebound firing, and inhibit the L1 apical tuft of nearby pyramidal cells.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023027 \"L5 T Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023027 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023028 \"A sst GABAergic cortical interneuron with a soma found in lower L5 with mostly local axonal arborization but with some sparse ascending axons. L5 non-Martinotti sst cells show somatic localization and local axon plexus in L5b and L5b/6 and substantial innervation of L3 and L4, and receive thalamic input from the ventral posteromedial nucleus and specifically target L4 neurons, avoiding L5 pyramidal cells. L5 non-Martinotti sst cells tend to show a higher input resistance and seem to be less stuttering.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023028 \"L5 non-Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023028 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27453468\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasDbXref \"PMID:9004351\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023029 \"A GABAergic medium spiny neuron located in the striatum that gives rise to the indirect basal ganglia pathway. It projects to the GPe, where its axon typically ramifies in two regions but does not extend beyond this nucleus (Gerfen et al., 2022). It selectively expresses the D2 dopamine receptor (DRD2), which couples to inhibitory G-proteins (Gi/o) to decrease cAMP and suppress PKA-mediated signaling (Gerfen et al., 2022). Morphologically, this cell displays fewer and shorter dendrites than the MSN-D1 and receives fewer glutamatergic inputs, yet it exhibits significantly higher intrinsic excitability (Gertler et al., 2022). Functionally, activation of this cell suppresses competing or alternative motor actions by inhibiting GPe neurons, leading through STN and other GPe circuits to increased GPi/SNr output and stronger inhibition of thalamic and brainstem targets (Mink, 1996; Tecuapetla et al., 2016).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023029 \"dopamine 2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"iSPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26018615\") Annotation(oboInOwl:hasDbXref \"PMID:29737578\") rdfs:comment obo:CL_4023029 \"Despite the direct and indirect circuits are often described not only as functionally opposing but also as anatomically segregated there are several anatomical and functional studies that have challenged this notion of pure segregation based on extensive collateral projections between pathways, dual-projection neurons, simultaneous co-activation during behavior.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27225074\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023030 \"A sst GABAergic cortical interneuron that has \\\"fanning-out' Martinotti morphology that is found in layer 2/3/5 of the cerebral cortex. They have local axon arbor and long ascending axons that spreads horizontally and arborizes significantly in L1.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023030 \"L2/3/5 fan Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023030 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023030 \"L2/3/5 fan Martionotti SST cells have an adapting firing pattern and non-zero afterdepolarization (ADP).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023031 \"A sst GABAergic cortical interneuron with a soma found in lower L2/3 and upper 5, L4 Sst cells have Martinotti morphology with ascending axons but denser local axons and sparser ‘fanning-out’ projections to L1. L4 sst cells have smaller membrane time constant to calb2 (L2/3/5 fan Martinotti Cell) and non-zero afterdepolarization (ADP).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023031 \"L4 SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023031 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023034 \"OBSOLETE A sst GABAergic cortical interneuron transcriptomically between the sst and the pvalb families with a soma found in L2/3. Some L2/3 PV-like sst cells have Martinotti morphology while some have basket cell morphology. L2/3 PV-like sst cells have lower AP width and higher firing rate than typical Sst subclass cells. L2/3 PV-like sst cells have high maximum firing rate variability, with many classified as belonging to the pvalb subclass on the basis of electrophysiology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023034 \"L2/3 PV-like SST Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipediaversioned:Ganglionic_eminence&oldid=1186824360\") obo:IAO_0000115 obo:CL_4023035 \"A neuron that is derived from a precursor cell in the lateral ganglion eminence.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377350\") oboInOwl:hasExactSynonym obo:CL_4023035 \"LGE-derived neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4023036 \"A transcriptomically distinct pvalb GABAergic interneuron located in the pallium. It is recognizable by the straight terminal axonal 'cartridges' of vertically oriented strings of synaptic boutons. Chandelier PV cells' boutons target exclusively the axon initial segment (AIS) of pyramidal cells, with a single cell innervating hundreds of pyramidal cells in a clustered manner.  These cells are fast-spiking.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:33862423\") Annotation(oboInOwl:hasDbXref \"PMID:39012795\") oboInOwl:hasBroadSynonym obo:CL_4023036 \"axo-axonic cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0107356\")\nAnnotationAssertion(Annotation(obo:IAO_0000116 \"Interlex cross reference refers specifically to Markram 2015 rat chandelier cell.\") oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0777213\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier PV\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023036 \"ChC\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023036 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023038 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023038 \"ILX:0770163\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023038 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4023039 \"An excitatory neuron that is located in the amygdala.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4023040 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layers L2/3-6.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023040 \"L2/3-6 IT projecting neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023040 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023041 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4023041 \"subcerebral projection (SCPN) neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4023041 \"Pyramidal tract-like (PT-l)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4023041 \"burst-firing layer 5 neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4023041 \"thick-tufted layer 5 (TTL5) pyramidal neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4023041 \"pyramidal tract (PT) neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023041 \"L5b neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023041 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023042 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023042 \"L6 CT\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023042 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023043 \"A transcriptomically distinct near-projecting glutamatergic neuron with a soma found in layer 5/6 of the primary motor cortex. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', cluster L5/6 NP.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023043 \"ILX:0770161\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023043 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023044 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that does not project to the medulla. Non-MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. Non-MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET MOp (Mus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023044 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023045 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that projects to the medulla. MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"MY ET M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"MY ET MOp\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"medulla-projecting extratelencephalic-projecting glutamatergic neuron of the primary motor cortex\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023045 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023046 \"An excitatory glutamatergic neuron transcriptomically related to the CT subclass, with a soma preferentially located in the bottom of L6 of the primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023046 \"L6b subplate glutamatergic neuron of the primary motor cortex\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023046 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") obo:IAO_0000115 obo:CL_4023047 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 2/3 of the primary motor cortex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023047 \"L2/3 IT M1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023047 \"L2/3 IT MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023047 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023048 \"An intratelencephalic-projecting glutamatergic with a soma located in upper L5 of the primary motor cortex. These cells have thin untufted apical dendrites.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023048 \"ILX:0770174\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023048 \"L4/5 IT M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023048 \"L4/5 IT MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023048 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023049 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in L5 of the primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023049 \"ILX:0770157\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023049 \"L5 IT M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023049 \"L5 IT MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023049 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") Annotation(oboInOwl:hasDbXref \"PMID:34616063\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023050 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023050 \"ILX:0770158\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023050 \"L6 IT M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023050 \"L6 IT MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023050 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023051 \"ILX:0770143\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023051 \"VLMC\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023051 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") Annotation(oboInOwl:hasDbXref \"PMID:18558853\") Annotation(oboInOwl:hasDbXref \"PMID:28751609\") obo:IAO_0000115 obo:CL_4023052 \"A Betz cell that synapses with lower motor neurons directly.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") Annotation(oboInOwl:hasDbXref \"PMID:18558853\") obo:IAO_0000115 obo:CL_4023053 \"A Betz cell that syanpses with spinal interneurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_4023054 \"A mesothelial cell that has undergone mesothelial-to-mesenchymal transition (MMT) to become a fibroblast cell.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20556241\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023055 \"A corticothalamic-projecting glutamatergic neuron that is located in L6 and lower L5 of the primary motor cortex, with a pyramidal morphology and mostly untufted apical dendrites terminating in midcortical layers. CT VAL/VM (ventroanterior-ventrolateral complex/ventromedial nucleus) cells have a near tonic firing pattern and are distinguished from L6 IT neurons by a lower inter-spike interval adaptation index.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023055 \"CT VAL/VM M1\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023055 \"CT VAL/VM MOp\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023055 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023056 \"VLMC (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023056 cl:BDS_subset)\nSubClassOf(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:CL_4023056 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P11087))\nSubClassOf(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:CL_4023056 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P26618))\nSubClassOf(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:CL_4023056 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P51885))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023057 \"A GABAergic interneuron whose soma is located in the cerebellar cortex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32066987\") obo:IAO_0000115 obo:CL_4023059 \"An oligodendrocyte precursor cell that is committed to differentiate.\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023059 \"COP\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023059 \"differentiation-committed oligodendrocyte precursor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") rdfs:comment obo:CL_4023059 \"COPs are distinct from OPCs in that the lack expression of Pdgfra and Cspg4 and come out as distinct clusters in transcriptomic profiling. This is the reason that this term is not modelled as a subclassOf OPC but instead linked using develops_from.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023060 \"A neuron that has its soma located in CA1-3 of the hippocampus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023061 \"A neuron that has its soma located in CA4 of the hippocampus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") Annotation(oboInOwl:hasDbXref \"PMID:19709629\") obo:IAO_0000115 obo:CL_4023063 \"An interneuron that is derived from the medial ganglionic eminence. In mice and humans, it expresses LHX6 and SOX6.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023063 \"MGE interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824663\") obo:IAO_0000115 obo:CL_4023064 \"An interneuron that is derived from the caudal ganglionic eminence.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") oboInOwl:hasExactSynonym obo:CL_4023064 \"caudal ganglionic eminence derived GABAergic interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824663\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27034423\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE-derived GABAergic IN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27034423\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE-derived cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE-derived interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") obo:IAO_0000115 obo:CL_4023065 \"A GABAergic cell located in the cerebral cortex that expresses meis2.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023065 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023066 \"A pyramidal neuron which has an apical tree which is oriented parallel to the pia. This is unlike typical pyramidal neurons which have its apical dendrite aligned vertically.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023066 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023067 \"OBSOLETE A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has Martinotti morphology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023067 \"Martinotti L2/3 PV-like SST (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30083593\") Annotation(oboInOwl:hasDbXref \"PMID:31196673\") Annotation(oboInOwl:hasDbXref \"PMID:35278647\") Annotation(oboInOwl:hasDbXref \"PMID:37163009\") Annotation(oboInOwl:hasDbXref \"PMID:37824663\") Annotation(oboInOwl:hasDbXref \"PMID:38739251\") obo:IAO_0000115 obo:CL_4023068 \"An excitatory neuron that has its soma located in the thalamic complex. This neuron type can be involved in a series of circuits related to sensory integration, motor integration, pain processing, social behaviour and reward response.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11532718\") Annotation(oboInOwl:hasDbXref \"PMID:30083593\") Annotation(oboInOwl:hasDbXref \"PMID:38739251\") rdfs:comment obo:CL_4023068 \"Abnormalities in glutametergic neurons of the thalamic complex are associated with pathologies such as schizophrenia, colorectal visceral pain and Parkinson's disease.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12637172\") obo:IAO_0000115 obo:CL_4023069 \"A GABAergic interneuron that develops from the medial ganglionic eminence and has migrated to the cerebral cortex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") obo:IAO_0000115 obo:CL_4023070 \"OBSOLETE. A GABAergic cortical interneuron that develops from the caudal ganglionic eminence and has migrated to the cerebral cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023070 \"CGE cortical interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023071 \"A GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023071 \"L5/6 CCK (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023071 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023072 \"A cell that is part of the brain vasculature.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023073 \"OBSOLETE. A cell that is part of the choroid plexus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023074 \"A neuron that has its soma located in the mammillary body.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22357664\") obo:IAO_0000115 obo:CL_4023075 \"A sst GABAergic cortical interneuron found in L6 that expresses tyrosine hydroxylase. L6 Th+ SST cells have mostly local axonal arborization within L6.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023075 \"L6 Th+ SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023075 \"L6 tyrosine hydroxylase positive sst expressing GABAergic cortical interneuron (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023075 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Martinotti_cell&oldid=9947732\") obo:IAO_0000115 obo:CL_4023076 \"An interneuron that has Martinotti morphology. These interneurons are scattered throughout various layers of the cerebral cortex, sending their axons up to the cortical layer I where they form axonal arborization.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023076 \"ILX:0107375\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023076 \"NIFEXT:55\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023076 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18568015\") obo:IAO_0000115 obo:CL_4023077 \"A type of interneuron that has two clusters of dendritic branches that originate directly from the soma and extend in opposite directions and axons that form a plexus which spreads widely. Compared to bipolar neurons, bitufted neurons have branching that occur close to the soma.\")\nAnnotationAssertion(Annotation(obo:IAO_0000116 \"Interlex cross reference refers specifically to Markram 2015 rat bitufted cell.\") oboInOwl:hasDbXref obo:CL_4023077 \"ILX:0777212\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023077 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023078 \"OBSOLETE A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has basket morphology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023078 \"basket L2/3 PV-like SST (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023079 \"A GABAergic inhibitory neuron that is derived from the midbrain.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023080 \"a L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex that has stellate pyramidal morphology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023080 \"stellate L6 IT MOp (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023080 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023081 \"a L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex that has inverted pyramidal morphology.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023081 \"inverted L6 IT MOp (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023081 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/b978-0-12-369497-3.10004-4\") obo:IAO_0000115 obo:CL_4023086 \"A Martinotti neuron that has axons that form a horizontal ramification, making it T-shaped.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023086 \"T-shaped Martinotti neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023086 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/b978-0-12-369497-3.10004-4\") obo:IAO_0000115 obo:CL_4023087 \"A Martinotti neuron that has axons that form a fan-like plexus.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023087 \"fanning-out Martinotti neuron\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023087 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11884355\") obo:IAO_0000115 obo:CL_4023088 \"A basket cell that is large, and typically ascends to give rise to many long horizontally and vertically projecting axon collaterals that traverse neighboring columns and can extend through all cortical layers.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023088 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11884355\") obo:IAO_0000115 obo:CL_4023089 \"A basket cell which has simpler dendritic arbors (compared to small or large basket cells), and an axonal plexus of intermediate density, composed of a few long, smooth axonal branches.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023089 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11884355\") obo:IAO_0000115 obo:CL_4023090 \"A basket cell with axonal arbors composed of frequent, short, curvy axonal branches that tend to be near their somata and within the same layer.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023090 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023092 \"A pyramidal neuron which has an apical tree which is oriented towards the white matter.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023092 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023093 \"A pyramidal neuron which lacks a tuft formation but extends small radial distances forming a star-like shape.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023093 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023094 \"A pyramidal neuron which has a distinctive tuft formation, distal from the soma.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023094 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023095 \"A pyramidal neuron which lacks a clear tuft formation but extends to large radial distances.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023095 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23298861\") obo:IAO_0000115 obo:CL_4023097 \"A mesothelial fibroblast of the arachnoid barrier layer. Arachnoid barrier cells make up the tight-junctioned layer in the leptomeninx that functions as the physiologic barrier between the cerebrospinal fluid in the subarachnoid space and the fenestrated capillaries in the dura.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23298861\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023097 \"AB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023097 \"ABC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023098 \"OBSOLETE An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 2/3 of the human primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023098 \"L2/3 IT MOp (human)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023099 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 5 of the human primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023099 \"ILX:0770157\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023099 \"L5 IT MOp (human)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023100 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 6 of the human primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023100 \"ILX:0770158\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023100 \"L6 IT MOp (human)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023101 \"OBSOLETE. A near-projecting glutamatergic neuron with a soma found in layer 5/6 of the human primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023101 \"ILX:0770161\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023101 \"L5/6 NP MOp (human)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023102 \"OBSOLETE. A near-projecting glutamatergic neuron with a soma found in layer 5/6 of the marmoset primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023102 \"ILX:0770161\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023102 \"L5/6 NP MOp (marmoset)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023103 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 2/3 of the marmoset primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023103 \"L2/3 IT MOp (marmoset)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023104 \"OBSOLETE An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 5 of the marmoset primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023104 \"ILX:0770157\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023104 \"L5 IT MOp (marmoset)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023105 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 6 of the marmoset primary motor cortex.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023105 \"ILX:0770158\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023105 \"L6 IT MOp (marmoset)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023105 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023106 \"OBSOLETE. A mouse GABAergic cell located in the marmoset cerebral cortex that expresses meis2.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023106 \"Meis2 (Marmoset)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29720934\") obo:IAO_0000115 obo:CL_4023107 \"A neuron with soma location in the reticular formation with axons that extend into the spinal cord such. Reticulospinal neuron activity can lead to a variety of motor behaviors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29720934\") oboInOwl:hasExactSynonym obo:CL_4023107 \"RSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Magnocellular_neurosecretory_cell&oldid=1021059931\") obo:IAO_0000115 obo:CL_4023108 \"A magnocellular neurosecretory cell that is capable of producing and secreting oxytocin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Magnocellular_neurosecretory_cell&oldid=1021059931\") obo:IAO_0000115 obo:CL_4023109 \"A magnocellular neurosecretory cell that is capable of producing and secreting vasopressin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1375860\") obo:IAO_0000115 obo:CL_4023110 \"A pyramidal neuron with soma located in the amygdala.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023111 \"A pyramidal neuron with soma located in the cerebral cortex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2585041\") obo:IAO_0000115 obo:CL_4023112 \"An afferent neuron of the vestibular system that innervate the base of the hair cell and increase or decrease their neural firing rate as the receptor cell is excited or inhibited.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10706428\") obo:IAO_0000115 obo:CL_4023113 \"A vestibular afferent neuron that makes bouton synapses to type II hair cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25355208\") obo:IAO_0000115 obo:CL_4023114 \"A vestibular afferent neuron which posseses a unique postsynaptic terminal, the calyx, which completely covers the basolateral walls of type I hair cells and receives input from multiple ribbon synapses.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") obo:IAO_0000115 obo:CL_4023115 \"A spiral ganglion neuron that innervates inner hair cells. Type 1 spiral ganglion neurons are myelinated and bipolar.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023115 \"type I spiral ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") rdfs:comment obo:CL_4023115 \"Type 1 spiral ganglion neurons comprise the vast majority of spiral ganglion cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") obo:IAO_0000115 obo:CL_4023116 \"A spiral ganglion neuron that innervates outer hair cells. Type 1 spiral ganglion neurons are unmyelinated and unipolar.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023116 \"type II spiral ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Spiral_ganglion&oldid=994446209\") rdfs:comment obo:CL_4023116 \"Outer hair cells form reciprocal synapses onto type 2 spiral ganglion cells, suggesting that the type 2 cells have both afferent and efferent roles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") obo:IAO_0000115 obo:CL_4023118 \"A sst GABAergic interneuron does not have Martinotti morphology with a soma found in L5/6 of the cerebral cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023118 \"L5/6 non-Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023118 \"L5/6 non-Martinotti morphology sst expressing GABAergic cortical interneuron (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023118 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") rdfs:comment obo:CL_4023118 \"L5/6 non-Martinotti SST cells have strongly facilitating excitatory inputs and moderately depressing outputs. They have faster action potential than Martinotti morphology SST cells and slightly slower than PV basket cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21557506\") Annotation(oboInOwl:hasDbXref \"PMID:67960\") obo:IAO_0000115 obo:CL_4023119 \"A subpopulation of amacrine cell that migrate further than other amacrine cells, and come to lie basal to the inner plexiform layer (IPL) in the ganglion cell layer. Displaced amacrine cells still have their neurites extending apically into the IPL, and therefore exhibit an inverted polarity with respect to the other amacrine cells.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023119 \"dACs\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023119 \"inverted amacrine cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18719084\") rdfs:comment obo:CL_4023119 \"Displaced amacrine cells are a subset of Sox2 expressing amacrine cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Hair_cell\") obo:IAO_0000115 obo:CL_4023120 \"An auditory hair cell found in the cochlea.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023120 \"FMA:62364\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023120 \"cochlear hair cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023121 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4023121 \"long-range GABAergic interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") obo:IAO_0000115 obo:CL_4023122 \"An interneuron located in the cerebral cortex that expresses the oxytocin receptor. These interneurons also express somatostatin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") obo:RO_0002175 obo:CL_4023122 obo:NCBITaxon_10090)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023122 \"OxtrINs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") rdfs:comment obo:CL_4023122 \"These cells were first identified in mouse.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023123 \"A kisspeptin neuron that is located in the hypothalamus. These neurons project to and activate gonadotrophin-releasing hormone neurons (acting via the kisspeptin receptor) in the hypothalamus and stimulate the secretion of gonadotrophin-releasing hormone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Kisspeptin&oldid=1042853037\") obo:IAO_0000115 obo:CL_4023124 \"A kisspeptin neuron that is located in the dentate gyrus of the hippocampus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") obo:IAO_0000115 obo:CL_4023125 \"A hypothalamus kisspeptin neuron that coexpresses kisspeptin, neurokinin B and dynorphin.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023125 \"kisspeptin, neurokinin B and dynorphin expressing neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") rdfs:comment obo:CL_4023125 \"KNDy neurons are involved in the negative feedback of gonadotropin-releasing hormone release in the hypothalamic–pituitary–gonadal axis. Sex steroids released from the gonads act on KNDy neurons as inhibitors of kisspeptin release. This inhibition provides negative feedback control on the hypothalamic–pituitary–gonadal axis. Other roles of KNDy neurons include influences on prolactin production; puberty; stress' effects on reproduction; and the control of thermoregulation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023127 \"a KNDy neuron that is located in the arcuate nucleus of the hypothalamus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:KNDy_neuron&oldid=964682278\") obo:IAO_0000115 obo:CL_4023128 \"a KNDy neuron that is located in the rostral periventricular region of the third ventricle.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Anteroventral_periventricular_nucleus&oldid=966137187\") obo:IAO_0000116 obo:CL_4023128 \"In rats and mice, the anteroventral periventricular nucleus plus the periventricular nucleus make up the rostral periventricular region of the third ventricle (RP3V).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023128 \"RP3V KNDy neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17565741\") obo:IAO_0000115 obo:CL_4023129 \"A retinal cell that is immature or undifferentiated.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17565741\") oboInOwl:hasExactSynonym obo:CL_4023129 \"retinal stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") obo:IAO_0000115 obo:CL_4023130 \"A neuron that expresses kisspeptin. These neurons are predominantly located in the hypothalamus, but also found in other parts of the brain including the hippocampal dentate gyrus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30042117\") rdfs:comment obo:CL_4023130 \"Gonadal sex steroids stimulate kisspeptin neurons in the RP3V, but inhibit kisspeptin neurons in the ARC.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1007/3-540-29623-9_3240\") obo:IAO_0000115 obo:CL_4023154 \"A glial cell that myelinates axonal processes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:title=Cochlear_nucleus&oldid=1090176664\") obo:IAO_0000115 obo:CL_4023158 \"A neuron in the posterior ventral cochlear nucleus that is distinguished by their long, thick and tentacle-shaped dendrites that typically emanate from one side of the cell body.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11976365\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:title=Cochlear_nucleus&oldid=1090176664\") rdfs:comment obo:CL_4023158 \"Octopus cells respond only at the onset of a broad-band simple tonal stimulus and form a pathway to the superior paraolivary nucleus and to the ventral nucleus of the lateral lemniscus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") obo:IAO_0000115 obo:CL_4023159 \"An interneuron that has double bouquet morphology.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0102311\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Cartwheel_cell&oldid=1040398094\") obo:IAO_0000115 obo:CL_4023160 \"A neuron of the dorsal cochlear nucleus with spiny dendrites that receive input from the axons of granule cells and with axons that release GABA and glycine onto cartwheel, pyramidal and giant cell targets.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023160 \"ILX:0102311\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0102311\") rdfs:comment obo:CL_4023160 \"Cartwheel cells share many of the features, molecular and electrophysiological, of cerebellar Purkinje neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9193142\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Unipolar_brush_cell&oldid=1045937026\") obo:IAO_0000115 obo:CL_4023161 \"An excitatory glutamatergic interneuron found in the granular layer of the cerebellar cortex and also in the granule cell domain of the cochlear nucleus. Unipolar brush cells have a round or oval cell body with usually a single short dendrite that ends in a brush-like tuft of short dendrites unique to them known as dendrioles.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023161 \"neuronal brush cell\")\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_4023161 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_4023161 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023162 \"A neuron found in the anterior part of the ventral cochlear nucleus that has the appearance of bushes, having short dendrites. Bushy cells give outputs to different parts of the superior olivary complex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023163 \"A bushy cell that receives only few large excitatory endbulb synapses from auditory nerves. Spherical bush cells give excitatory input to the lateral and medial parts of the superior olive.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023163 \"SBC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Bushy_cell&oldid=879061753\") obo:IAO_0000115 obo:CL_4023164 \"A bushy cell that receives a large number of medium-sized synapses, called modified endbulbs. Globular bushy cells extend to the superior olive on both sides of the brainstem where they give input to the bipolar neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31881018\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023164 \"GBC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22865660\") obo:IAO_0000115 obo:CL_4023168 \"A neuron that is part of the somatic sensory system. Somatosensory neurons innervate the skin or integument to detect different types of thermal, chemical, and mechanical touch stimuli.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22190641\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Trigeminal_nerve&oldid=1099897926\") obo:IAO_0000115 obo:CL_4023169 \"A neuron that is responsible for sensation in the face or motor functions such as biting and chewing. Trigeminal neurons extend a single axon shaft along the lateral white matter of the hindbrain and spinal cord. The highly branched axons innervate the integument of the head.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539823/\") obo:IAO_0000115 obo:CL_4023170 \"A trigeminal neuron that is responsible for sensation in the face.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539823/\") obo:IAO_0000115 obo:CL_4023171 \"A trigeminal neuron that is responsible for motor functions such as biting and chewing.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7258-9596>) Annotation(oboInOwl:hasDbXref \"PMID:26778959\") Annotation(oboInOwl:hasDbXref \"PMID:9579598\") obo:IAO_0000115 obo:CL_4023181 \"A neurecto-epithelial cell that is part of the basal layer of the subcommissural organ and specializes in the secretion of proteins into the subarachnoid space. Hypendymal cells have similar characteristics to ependymal cells and express SCO-spondin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Lateral_geniculate_nucleus&oldid=1098375993\") obo:IAO_0000115 obo:CL_4023187 \"A neuron with a small cell body that is located in a koniocellular layer of the lateral geniculate nucleus (LGN).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023187 \"NIFEXT:44\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") oboInOwl:hasExactSynonym obo:CL_4023187 \"K cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10845061\") rdfs:comment obo:CL_4023187 \"In adult monkeys, koniocellular cells can be distinguished from parvocellular and magnocellular of the LGN by their expression of calbindin, the alpha subunit of type II calmodulin-dependent protein kinase, and the gamma subunit of protein kinase C.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Midget_cell&oldid=982299713\") obo:IAO_0000115 obo:CL_4023188 \"A retinal ganglion cell that originate in the ganglion cell layer of the retina, and project to the parvocellular layers of the lateral geniculate nucleus (LGN). These cells are known as midget retinal ganglion cells due to the small sizes of their dendritic trees and cell bodies.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32533915\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Parasol_cell&oldid=1032171532\") obo:IAO_0000115 obo:CL_4023189 \"A retinal ganglion cell located in the ganglion cell layer of the retina. This cell projects to magnocellular cells in the lateral geniculate nucleus (LGN). They have large cell bodies and extensive, branching dendritic networks that contribute to their large receptive fields.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_4023189 \"M ganglion cell\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028001 \"2021-11-23T02:31:40Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028001 \"lung capillary endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31233341\") Annotation(oboInOwl:hasDbXref \"PMID:32059772\") Annotation(oboInOwl:hasDbXref \"PMID:32059779\") Annotation(oboInOwl:hasDbXref \"PMID:32091393\") Annotation(oboInOwl:hasDbXref \"PMID:33057196\") Annotation(oboInOwl:hasDbXref \"PMID:33705684\") obo:IAO_0000115 obo:CL_4028002 \"An alveolar capillary endothelial cell that is located distally to alveolar capillary type 2 endothelial cells.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028002 \"2021-11-23T03:23:53Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028002 \"capillary 1 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33057196\") oboInOwl:hasBroadSynonym obo:CL_4028002 \"general capillary cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028002 \"CAP1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33057196\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028002 \"gCAP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31233341\") Annotation(oboInOwl:hasDbXref \"PMID:32059772\") Annotation(oboInOwl:hasDbXref \"PMID:32059779\") Annotation(oboInOwl:hasDbXref \"PMID:32091393\") Annotation(oboInOwl:hasDbXref \"PMID:33057196\") obo:IAO_0000115 obo:CL_4028003 \"An alveolar capillary endothelial cell that is located proximally to alveolar capillary type 1 endothelial cells and in close apposition to alveolar type 1 epithelial cells (also known as type I pneumocytes).\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028003 \"2021-11-23T03:23:53Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028003 \"CD34hi endothelial cells\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028003 \"Car4+ capillary endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33057196\") oboInOwl:hasBroadSynonym obo:CL_4028003 \"aerocyte\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028003 \"alveolar capillary cell\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028003 \"capillary 2 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028003 \"aCAP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22268140\") Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29489752\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasDbXref \"PMID:33707239\") Annotation(oboInOwl:hasDbXref \"PMID:9074756\") obo:IAO_0000115 obo:CL_4028004 \"A pulmonary interstitial fibroblast that is part of the alveolus and contains lipid droplets.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028004 \"2021-12-09T15:34:13Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast 1\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"lipid interstitial cell\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"lipofibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"matrix fibroblast 1\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"pulmonary lipofibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028004 \"AF1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29752282\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4028006 \"A pulmonary interstitial fibroblast that is part of the alveolus and localizes to vascular adventitia.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4028006 \"2021-12-09T15:53:21Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"adventitial fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"alveolar fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"matrix fibroblast 2\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"mesenchymal alveolar niche cell\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"type-2 associated stromal cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028006 \"alveolar type 2 fibroblast cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"AF2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"AdvF\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4028006 \"MANC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029001 \"A cell that supports the development of a gamete by providing it cytoplasmic material (including entire organelles) by direct cross-membrane channels (del Pino, 2021).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4029001 \"BTO:0000953\")\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029001 \"cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029002 \"A gamete-nursing cell that derives from a germline cell (del Pino, 2021).\")\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029002 \"cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1126/science.aad2156\") rdfs:comment obo:CL_4029002 \"Nurse cells were first described in insects, but recent works suggest they also exist in some mammals (Lei and Spradling, 2016).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029003 \"A gamete-nursing cell that derives from the somatic tissues of the gonad (del Pino, 2021).\")\nAnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029003 \"cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1111/andr.12165\") rdfs:comment obo:CL_4029003 \"We follow what seems to be a common usage in the literature, which is to reserve the term “nurse cell” proper to cells from the germ line, hence the label “nurse-like”. This term encompasses pyriform cells described in reptiles, bird, and amphibians (del Pino, 2021); it does not encompass mammalian Sertoli cells, which do not appear to transfer cytoplasmic material to spermatogonia (França et al., 2016).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_4030000 \"A melanocyte located in the vascular uvea and involved in photoprotection, regulation of oxidative damage and immune responses.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4030000 \"2022-01-20T12:59:06Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030000 \"uveal melanocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"PMID:34082079\") rdfs:comment obo:CL_4030000 \"Cellular functions and extracellular interactions of choroidal melanocytes are distinct to skin melanocytes. They might have both neuroectodermal as well as mesectodermal origins.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030001 \"A stromal cell that is part of the thymus.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030001 \"thymic stromal cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2825-0621\") obo:IAO_0000115 obo:CL_4030002 \"An alpha-beta memory T cell with the phenotype CD45RA-positive.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4030002 \"2022-02-01T13:04:46Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"TEMRA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"effector memory RA T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"TEMRA cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory CD45RA+ T cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/T_cell#Memory_T_cells\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory cells re-expressing CD45RA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030003 \"A cell that makes up the loose connective tissue of the thymus.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030003 \"thymic interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Thymic_nurse_cell\") obo:IAO_0000115 obo:CL_4030004 \"A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24051376\") Annotation(oboInOwl:hasDbXref \"PMID:31300091\") Annotation(oboInOwl:hasDbXref \"PMID:32016094\") obo:IAO_0000115 obo:CL_4030005 \"A renal beta-intercalated cell that is part of the cortical collecting duct. The medullary collecting duct does not contain the renal beta-intercalated cell type.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_4030005 \"B-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_4030005 \"kidney collecting duct intercalated cell type B\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1186/1477-7827-7-129\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.3390/cells8080933\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") obo:IAO_0000115 obo:CL_4030006 \"An epithelial cell that is part of the fallopian tube that secretes mucus and oviduct-specific products in response to hormonal stimulation from estrogen and luteinizing hormone. This fallopian tube secretory cell is similar in height to the ciliated cell, but typically exhibits a more narrow, columnar shape. Its nucleus is ovoid and oriented perpendicular to the cell's long axis, with denser chromatin and a smaller nucleolus compared to the ciliated cell.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030006 \"oviduct secretory epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030006 \"uterine tube secretory epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16565155\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube\") obo:IAO_0000115 obo:CL_4030007 \"A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030007 \"oviduct ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube multiciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"uterine tube ciliated epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10322630\") obo:IAO_0000115 obo:CL_4030008 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the pronephros.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0001673\") oboInOwl:hasExactSynonym obo:CL_4030008 \"pronephric glomerular visceral epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030009 \"A brush border cell that is part of segment 1 (S1) of the proximal tubule epithelium, located in the renal cortex.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030009 \"epithelial cell of segment 1 of proximal tubule\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:31253652\") obo:IAO_0000115 obo:CL_4030010 \"A brush border cell that is part of segment 2 (S2) of the proximal tubule epithelium, located in the renal cortex. In addition to its reabsorptive functions, it is also specialized in the secretion of organic anions and cations, including para-aminohippurate.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030010 \"epithelial cell of segment 2 of proximal tubule\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030011 \"A brush border cell that is part of segment 3 (S3) of the proximal tubule epithelium, which extends from the medullary rays of the renal cortex into the outer medulla.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030011 \"epithelial cell of segment 3 of proximal tubule\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") rdfs:comment obo:CL_4030011 \"The epithelial cell of proximal tubule segment 3 operates under relatively hypoxic conditions and is particularly susceptible to ischemic injury.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030012 \"Epithelial cell of the descending thin limb of the short loop (cortical) nephron limited to the outer medulla (mainly inner strip). It is known in some mammalian species that the short descending limb of the loop of Henle selectively expresses the serine protease Corin, the homeobox TF Uncx, and the urea channel Slc14a2.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030012 \"epithelial cell of the descending thin limb of the short loop of Henle\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030013 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the outer medulla (inner stripe). It is known in some mammalian species that the long descending limb of the loop of Henle in the outer medulla selectively expresses the secreted activin-antagonist protein follistatin (Fst), the GPI-linked adhesion protein Cdh13, and the protein kinase Stk32a.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030013 \"epithelial cell of the outer medulla of the long descending limb of the loop of Henle\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/gene/8170\") obo:IAO_0000115 obo:CL_4030014 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the inner medulla. It is known in some mammalian species that the long descending limb of the loop of Henle in the inner medulla selectively expresses the nuclear receptor Nr2e3, the Ig kappa chain Igkc, and the secreted protein dermokine (Dmkn). SLC14A2, which expresses a urea transporter, is also expressed in the inner medulla.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030014 \"epithelial cell of the inner medulla of the long descending limb of the loop of Henle\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030015 \"A renal alpha-intercalated cell that is part of the collecting duct of the renal tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030015 \"kidney collecting duct intercalated cell type A\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:24855283\") obo:IAO_0000115 obo:CL_4030016 \"An epithelial cell located in the early distal convoluted tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") oboInOwl:hasBroadSynonym obo:CL_4030016 \"DCT1 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:24855283\") obo:IAO_0000115 obo:CL_4030017 \"An epithelial cell located in the late distal convoluted tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") oboInOwl:hasBroadSynonym obo:CL_4030017 \"DCT2 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24855283\") rdfs:comment obo:CL_4030017 \"Although mineralocorticoid receptors are expressed throughout the entire [distal convoluted tubule], the DCT2 is sensitive to the actions of aldosterone, because it expresses an enzyme called 11-β hydroxysteroid dehydrogenase 2 (11-βHSD2)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:27582101\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030018 \"A renal principal cell located in the connecting tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030019 \"A renal intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2254448\") Annotation(oboInOwl:hasDbXref \"PMID:24937428\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030020 \"A renal alpha-intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24937428\") oboInOwl:hasExactSynonym obo:CL_4030020 \"connecting tubule A-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030020 \"kidney connecting tubule intercalated cell type A\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2254448\") Annotation(oboInOwl:hasDbXref \"PMID:9890303\") obo:IAO_0000115 obo:CL_4030021 \"A renal beta-intercalated cell that is part of the renal connecting tubule.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32065116\") oboInOwl:hasExactSynonym obo:CL_4030021 \"connecting tubule B-IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9890303\") oboInOwl:hasExactSynonym obo:CL_4030021 \"kidney connecting tubule intercalated cell type B\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1101/2021.07.28.454201>) Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030022 \"A fibroblast that is located in the renal medulla interstitium.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030022 \"kidney medullary fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") rdfs:comment obo:CL_4030022 \"It has been noted that inner medullary fibroblasts are involved in the regulation of water and electrolyte homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7772-9578>) Annotation(oboInOwl:hasDbXref \"PMID:30069044\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"PMID:33442032\") obo:IAO_0000115 obo:CL_4030023 \"A hillock cell that is located in respiratory epithelium. In some mammalian species, this cell type has been noted to express KRT13 and KRT4 and is postulated to play a role in squamous barrier function and immunomodulation.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030023 \"hillock cell of respiratory tract\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030023 \"respiratory hillock cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30069044\") obo:IAO_0000115 obo:CL_4030024 \"An epithelial, transitional cell type between basal and secretory; located in stratified, non-ciliated structures (called hillocks) with high cell turnover in epithelium. In some mammalian species, this cell type has been noted to express KRT13 and is postulated to play a role in squamous barrier function and immunomodulation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-7431-4139>) Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:35176508\") obo:IAO_0000115 obo:CL_4030026 \"An enterocyte of the human intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.cell.2020.08.013\") obo:IAO_0000115 obo:CL_4030027 \"An amacrine cell that uses GABA as a neurotransmitter.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030027 \"amacrine cell, GABAergic\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.cell.2020.08.013\") obo:IAO_0000115 obo:CL_4030028 \"An amacrine cell that uses glycine as a neurotransmitter.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030028 \"amacrine cell, glycinergic\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) obo:IAO_0000115 obo:CL_4030029 \"A lymphocyte located in blood.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0003-2534-198X>) Annotation(oboInOwl:hasDbXref \"PMID:31092833\") Annotation(oboInOwl:hasDbXref \"https://sciencing.com/what-peripheral-blood-4672930.html\") obo:IAO_0000115 obo:CL_4030030 \"A blood lymphocyte located in the flowing, circulating blood of the body.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24987007\") obo:IAO_0000115 obo:CL_4030031 \"Any cell that is located within the interstitium between the cells most prominent in defining a given tissue. \\\"Interstitial cell\\\" is a morphological term and refers to a variety of cells with differing origins and phenotypes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-7655-4833>) Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1098/rsif.2017.0580\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1161/ATVBAHA.120.314789\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1161/JAHA.117.006339\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.2353/ajpath.2007.070251\") obo:IAO_0000115 obo:CL_4030032 \"An interstitial cell that is part of a cardiac valve leaflet. Along with valve endothelial cells, a valve interstitial cell maintains tissue homeostasis for the function of cardiac valves through secreting biochemical signals, matrix proteins and matrix remodeling enzymes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"PMID:30796046\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030032 \"VIC\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030032 \"cardiac valve interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") oboInOwl:hasExactSynonym obo:CL_4030032 \"valvular interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") obo:IAO_0000115 obo:CL_4030033 \"An endothelial cell that lines a surface of a cardiac valve leaflet. Along with valve interstitial cells, a valve endothelial cell maintains tissue homeostasis for the function of cardiac valves through secreting biochemical signals, matrix proteins and matrix remodeling enzymes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") Annotation(oboInOwl:hasDbXref \"PMID:30796046\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030033 \"VEC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") oboInOwl:hasExactSynonym obo:CL_4030033 \"valvular endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030033 \"At least in some mammalian species, a valve endothelial cell expresses CD31. Valve endothelial cells can undergo an endothelial to mesenchymal transition to acquire a fibroblast or myofibroblast phenotype that leads to changes in the microenvironmental signals and facilitates tissue regeneration.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18757316\") Annotation(oboInOwl:hasDbXref \"PMID:21364219\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4030034 \"A multiciliated epithelial cell located in the respiratory tract epithelium, characterized by a columnar shape and motile cilia on its apical surface. This cell develops through a highly orchestrated process, transitioning from a basal progenitor via an intermediate deuterosomal cell stage that generates centrioles essential for ciliogenesis.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"ciliated cell of the respiratory tract\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"respiratory ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030034 \"respiratory multiciliated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-2825-0621>) Annotation(oboInOwl:hasDbXref \"DOI:10.1177/154405910208100806\") obo:IAO_0000115 obo:CL_4030035 \"A dental pulp cell that possesses stem-cell-like qualities, including self-renewal capability and multi-lineage differentiation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030035 \"DPSC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Germ+cells#earlyspermatids\") obo:IAO_0000115 obo:CL_4030036 \"A spermatid in an early stage of maturation that has a round morphology and is transcriptionally active.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/B978-0-323-01970-5.50014-2\") oboInOwl:hasExactSynonym obo:CL_4030036 \"round spermatid\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Germ+cells#latespermatids\") obo:IAO_0000115 obo:CL_4030037 \"A spermatid in a late stage of maturation that has an elongated morphology and is transcriptionally inert when the acrosome is fully developed.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/B978-0-323-01970-5.50014-2\") oboInOwl:hasExactSynonym obo:CL_4030037 \"elongated spermatid\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21281815\") Annotation(oboInOwl:hasDbXref \"PMID:23124355\") obo:IAO_0000115 obo:CL_4030038 \"A CD24-positive, CD-133-positive, vimentin-positive cell found scattered throughout a renal proximal tubule and that may participate in tubular regeneration. Compared to other proximal tubular cell types, this cell contains less cytoplasm, fewer mitochondria and no brush border.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1002/stem.1130\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD133+CD24+CD106- tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD24+CD133+ tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") oboInOwl:hasBroadSynonym obo:CL_4030038 \"CD24-positive tubular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") rdfs:comment obo:CL_4030038 \"After acute tubular injury, this cell type becomes more numerous. In healthy rat kidneys, this cell is not detectable, whereas after unilateral ureteral obstruction (renal injury), it may appear de novo, arguing against the notion that this cell type represents a pre-existing progenitor cell population. In at least one study, data indicate that this cell type represents transiently dedifferentiated tubular cells involved in regeneration.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1007/BF02970950\") Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") Annotation(oboInOwl:hasDbXref \"PMID:32127543\") obo:IAO_0000115 obo:CL_4030039 \"An extratelencephalic-projecting glutamatergic cortical neuron that is morphologically-defined with a large, spindle-shaped cell body, thick bipolar dendrites with limited branching and a moderate density of spines, and often an axon initial segment that emanates from the side of the cell body. This cell type is associated with markers POU3F, BMP3 and ITGA4.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32127543\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030039 \"VEN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32127543\") rdfs:comment obo:CL_4030039 \"In humans, a von Economo neuron is restricted to layer 5 of the anterior cingulate, frontoinsular, and medial frontopolar regions of cerebral cortex, while in some other species it is also found in the frontal and occipital poles and may not be restricted to layer 5.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31290979\") Annotation(oboInOwl:hasDbXref \"PMID:37999981\") Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.coemr.2024.100503\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/Glandular+epithelial+cells#endometrialciliatedcells\") obo:IAO_0000115 obo:CL_4030040 \"A multi-ciliated cell of the endometrial epithelium. This cell is characterized by the presence of 9+2 motile cilia on its apical surface, which facilitates the movement of mucus across the endometrial surface.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030040 \"ciliated cell of the uterus\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030040 \"uterine ciliated cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"ciliated cell of the endometrium\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"endometrial ciliated epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030040 \"endometrium ciliated epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ttps://www.nature.com/articles/s41591-020-1040-z\") rdfs:comment obo:CL_4030040 \"In human samples, the expression of FOXJ1 protein, a regulator for motile cilia with epithelial lineage identity, has been noted.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_4030041 \"A ciliated cell of the endometrial luminal epithelium. This cell is characterized by the presence of motile cilia on its apical surface.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030041 \"luminal endometrial ciliated epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_4030042 \"A ciliated cell of the endometrial glandular epithelium. This cell is characterized by the presence of motile cilia on its apical surface.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030042 \"glandular endometrial ciliated epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030043 \"A DRD1-expressing medium spiny neuron that is part of a matrix compartment of dorsal striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"D1-matrix\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"D1M\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030043 \"matrix D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030043 \"In Rhesus macaques, both matrix D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: EPHA4, GDA, STXBP6, and SEMA3E. Broadly understood, matrix MSNs receive neocortical inputs from the associative and sensorimotor cortex and give rise to the direct and indirect pathways.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030047 \"A DRD2-expressing medium spiny neuron that is part of a matrix compartment of dorsal striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"D2-matrix\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"D2M\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030047 \"matrix D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030047 \"In Rhesus macaques, both matrix D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: EPHA4, GDA, STXBP6, and SEMA3E. Broadly understood, matrix MSNs receive neocortical inputs from the associative and sensorimotor cortex and give rise to the direct and indirect pathways.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030048 \"A DRD1-expressing medium spiny neuron that is part of a striosome of dorsal striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030048 \"striosome D1 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"D1-striosome\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"D1S\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030048 \"striosome D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030048 \"In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030049 \"A DRD2-expressing medium spiny neuron that is part of a striosome of dorsal striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030049 \"striosome D2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"D2-striosome\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"D2S\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030049 \"striosome D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030049 \"In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030050 \"A medium spiny neuron that expresses both DRD1 and DRD2 and is part of an extra-striosomal part of dorsal striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/D2 hybrid\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"D1/D2-hybrid MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030050 \"hybrid D1/2 cell type\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030050 \"It has been noted in non-human primate species that the D1/D2-hybrid medium spiny neuron (D1/2) cell type shows the same amount of DRD1 expression as nearby D1 medium spiny neurons but far less DRD2 expression compared to nearby D2 medium spiny neurons. In Rhesus macaques, RXFP1 has been noted as a highly specific marker gene for the D1/2 cell type. The D1/2 cell type has also been described as having characteristics similar to a novel medium spiny neuron described in rodents (D1H or eccentric spiny projection neuron). Although an extrastriosomal cell type, the D1/2 cell type had been noted to express many of the genes associated with striosome, suggesting a possible homology to ‘‘exo-patch’’ cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030051 \"A DRD1-expressing medium spiny neuron that is part of a nucleus accumbens shell or olfactory tubercle.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030051 \"NAc shell and OT D1 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030051 \"D1Sh\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030051 \"NAc shell and OT D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030051 \"In Rhesus macaques, both nucleus accumbens shell and olfactory tubercle D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: GREB1L, ARHGAP6, and GRIA4.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030052 \"A DRD2-expressing medium spiny neuron that is part of a nucleus accumbens shell or olfactory tubercle.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") oboInOwl:hasExactSynonym obo:CL_4030052 \"NAc shell and OT D2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"D2Sh\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"NAc shell and OT D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030052 \"nucleus accumbens shell and olfactory tubercle D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030052 \"In Rhesus macaques, both nucleus accumbens shell and olfactory tubercle D1 and D2 medium spiny neuron cell types have been noted to have enriched gene expression of the following: GREB1L, ARHGAP6, and GRIA4.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34795450\") Annotation(oboInOwl:hasDbXref \"PMID:37898623\") Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") obo:IAO_0000115 obo:CL_4030053 \"A GABAergic neuron that resides in the islands of calleja and shows the cytoarchitectural and molecular features characteristic of this granule-like cell population. In mice and primates, it expresses D1 and D3 dopamine receptors (Drd1; Drd3), GABAergic markers (GAD1/2) and form densely packed granule cell clusters in the olfactory tubercle within the ventral striatum. Moreover it receives dense dopaminergic input from the VTA, and functionally associated with self-grooming behaviors and depression-like behaviors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030053 \"D1-ICj\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030053 \"In Rhesus macaques, the Island of Calleja granule cell type has been noted to have enriched gene expression of CPNE4.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4030054 \"A DRD1-expressing medium spiny neuron that is part of dense, RXFP1-positive cell islands throughout the nucleus accumbens, putamen, and near the adjacent septal nuclei.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") oboInOwl:hasExactSynonym obo:CL_4030054 \"RXFP1-positive interface island D1-medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030054 \"D1-NUDAP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") rdfs:comment obo:CL_4030054 \"Regarding the abbreviation D1-NUDAP, NUDAP stands for \\\"neurochemically unique domains in the accumbens and putamen\\\". In Rhesus macaques, the RXFP1-positive interface island D1-medium spiny neuron (D1-NUDAP) has been noted to have upregulation of OPRM1 compared to DRD1-expressing medium spiny neurons located outside of the D1-exclusive island and in Islands of Calleja. Kappa-opioid receptor gene (OPRK1) has been noted to be absent from D1-NUDAP cells. Many striosome-specific markers have been noted to be upregulated in D1-NUDAP cells, including KCNIP1, KCNT1, KHDRBS3, and BACH2. PDYN, an acknowledged D1-striosome marker gene, has also been noted to be expressed in D1-NUDAPs. D1-NUDAPs also express some genes found to be selectively expressed in the matrix, including STXBP6, GDA, and SEMA3E. Gene enrichment analysis has revealed that D1-NUDAP neurons express genes that have been implicated in drug addiction and many other functions.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") obo:IAO_0000115 obo:CL_4030055 \"A urothelial cell that is part of the regenerative layer(s) of cells directly superficial to basal cells in urothelium. The layer of intermediate cells in the urothelium ranges from one to several layers thick depending on the species with intermediate cells attached to adjacent cell layers and one another via desmosomes.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030055 \"FMA:84155\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-14366-4_8\") oboInOwl:hasExactSynonym obo:CL_4030055 \"urothelial intermediate cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") rdfs:comment obo:CL_4030055 \"It has been noted in at least some mammalian species that the urothelial intermediate cell type is similar to basal cells by expressing CK17 and (unlike umbrella cells) p63 but is positive for uroplakins (UPK) and negative for CK5. Urothelial intermediate cells have also been noted to be larger in diameter than urothelial basal cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") obo:IAO_0000115 obo:CL_4030056 \"A urothelial cell that is terminally differentiated and part of the urothelial apical surface that forms the high-resistance barrier of urothelium. Umbrella cells have been described as the largest of urothelial cell types, highly polarized, and, in some species, multinucleated. In the relaxed state, these cells form a dome-shaped structure at the apical pole and can also cover multiple underlying intermediate cells, leading to the name umbrella cells. In contrast, these cells flatten when the bladder is filled.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030056 \"FMA:84149\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") oboInOwl:hasExactSynonym obo:CL_4030056 \"facet cell of urothelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") oboInOwl:hasExactSynonym obo:CL_4030056 \"superficial cell of urothelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") rdfs:comment obo:CL_4030056 \"Umbrella cells are attached to sub-superficial cell layers via desmosomes, while tight junctions localized between superficial cells aid in forming a high-resistance barrier function. Another distinguishing feature of an umbrella cell type is the presence of subapical discoidal/fusiform-shaped vesicles contributing to the plasticity in urothelial cell surface area through a regulated process of endocytosis/exocytosis. It has been noted in at least some mammalian species that the urothelial umbrella cell type expresses UPK1A, UPK1B, UPK2 and UPK3A. Unlike intermediate and basal cells of the urothelium, CK17 is reported to be completely absent and p63 not expressed in umbrella cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4030057 \"A medium spiny neuron that exhibits transcriptional divergence from direct and indirect spiny projection neurons, for example, enrichment in Casz1, Otof, Cacng5 and Pcdh8 noted in mice. Whilst in general medium spiny neurons have been found to be differentially distributed across the basal ganglia, the eccentric medium spiny neuron cell type has been found to be more evenly distributed throughout cerebral nuclei.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") oboInOwl:hasExactSynonym obo:CL_4030057 \"eccentric spiny projection neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eSPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eccentric MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030057 \"eccentric SPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4030057 \"The term “eccentric” is used in the name eccentric medium spiny neuron (MSN) due to the exhibited transcriptional divergence from canonical spiny projection neurons. It has been noted in at least one study that an eccentric MSN differs in expression from direct and indirect MSNs by 110 genes (more than the 68 that distinguished direct and indirect spiny projection neurons from each other) and expresses many genes that have little expression in the rest of the striatum. It also has been noted in at least one human study that most eccentric MSNs expressed only DRD1, but many in the basal ganglia co-expressed DRD1 and DRD2, suggesting regional specialization of a more broadly distributed cell type.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-9990-8331>) Annotation(oboInOwl:hasDbXref \"PMID:26074923\") obo:IAO_0000115 obo:CL_4030058 \"A macrophage that expresses the T cell receptor complex at the cell surface.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26074923\") oboInOwl:hasExactSynonym obo:CL_4030058 \"T cell receptor positive macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26074923\") oboInOwl:hasExactSynonym obo:CL_4030058 \"TCR+ macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:37500727\") oboInOwl:hasRelatedSynonym obo:CL_4030058 \"TCR.macs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030059 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030059 \"ILX:0770156\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030059 \"L2/3 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") rdfs:comment obo:CL_4030059 \"Hystorically, the L2/3 intratelencephalic projectic glutametergic neuron was known to have its soma in cortical layer 2/3. MERFISH data showed that this intratelencephalic-projecting glutametergic neuron can have its soma in layer 2/3, 4B, 4C. The position of the soma in layer 4b and 4C is less frequent for this neuronal type in comparison to cortical layer 2/3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030060 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 2.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030060 \"L2 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030061 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030061 \"L3 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") obo:IAO_0000115 obo:CL_4030062 \"An intratelencephalic-projecting glutamatergic with a soma located in cortical layer 4/5.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030062 \"L4/5 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030063 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030063 \"L4 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030064 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030064 \"ILX:0770157\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:37292694\") oboInOwl:hasRelatedSynonym obo:CL_4030064 \"L5 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4030065 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4030065 \"ILX:0770158\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030065 \"L6 IT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17133361\") Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:IAO_0000115 obo:CL_4030066 \"An epithelial cell that is part of a ureteric bud. A ureteric bud cell has the potential to induce metanephric mesenchymal cells to proliferate and convert to epithelia that form renal tubules via: (1) the secretion of multiple diffusible growth factors that rescue renal progenitors from apoptosis and stimulate them to proliferate and (2) contact-dependent mechanisms that induce mesenchymal-epithelial conversion.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030066 \"UB cell\")\nSubClassOf(Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:CL_4030066 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_2001013))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4030067 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030067 \"L5/6 NP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") obo:IAO_0000115 obo:CL_4030068 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4030068 \"L6 IT Car3 glutamatergic neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030068 \"L6 IT Car3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030068 \"L6 IT Car3 neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030068 \"L6-IT-Car3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4030068 \"L6-IT-Car3 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30566875\") Annotation(oboInOwl:hasDbXref \"PMID:32497356\") obo:IAO_0000115 obo:CL_4032000 \"An epithelial cell of the urethra that has an expression profile similar to lung club cells. Club-like cells of the urethra epithelium are similar to lung club cells in their expression of SCGB1A1 and in their enrichment of immunomodulatory programs.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4032000 \"club cell of the urethra epithelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4032000 \"club-like cell of the prostatic urethra epithelium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30566875\") oboInOwl:hasExactSynonym obo:CL_4032000 \"prostate club cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30566875\") rdfs:comment obo:CL_4032000 \"Club cells typically refer to bronchiolar exocrine cells found in the lungs. This cell type is given the name club cell due to their similarity to club cells in the lungs.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23803971\") obo:IAO_0000115 obo:CL_4032001 \"A GABAergic interneuron located in the cerebral cortex that expresses reelin (rln).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29904965\") oboInOwl:hasExactSynonym obo:CL_4032001 \"rln GABAergic cortical interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28217126\") obo:IAO_0000115 obo:CL_4033000 \"A(n) endothelial cell that is part of a(n) venule of lymph node.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28217126\") obo:IAO_0000115 obo:CL_4033001 \"A(n) endothelial cell that is part of a(n) arteriole of lymph node.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31390635\") obo:IAO_0000115 obo:CL_4033002 \"A(n) neuroendocrine cell that is part of a(n) epithelium of crypt of Lieberkuhn.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19996346\") Annotation(oboInOwl:hasDbXref \"PMID:5487122\") obo:IAO_0000115 obo:CL_4033003 \"A(n) myoepithelial cell that is part of a(n) bronchus submucosal gland.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10715339\") Annotation(oboInOwl:hasDbXref \"PMID:22320805\") obo:IAO_0000115 obo:CL_4033004 \"A(n) smooth muscle cell that is part of a(n) taenia coli.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:5487122\") Annotation(oboInOwl:hasDbXref \"PMID:9651178\") obo:IAO_0000115 obo:CL_4033005 \"A(n) serous secreting cell that is part of a(n) bronchus submucosal gland.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32094869\") obo:IAO_0000115 obo:CL_4033006 \"A(n) endothelial cell that is part of a(n) efferent lymphatic vessel.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15817800\") obo:IAO_0000115 obo:CL_4033007 \"A(n) brush cell that is part of a(n) epithelium of lobar bronchus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34030460\") obo:IAO_0000115 obo:CL_4033008 \"A(n) vein endothelial cell that is part of a(n) respiratory system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18757316\") obo:IAO_0000115 obo:CL_4033009 \"A(n) goblet cell that is part of a(n) epithelium of lobar bronchus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26711336\") Annotation(oboInOwl:hasDbXref \"PMID:33355253\") obo:IAO_0000115 obo:CL_4033010 \"A(n) neuroendocrine cell that is part of a(n) epithelium of lobar bronchus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24997029\") obo:IAO_0000115 obo:CL_4033011 \"A(n) smooth muscle cell that is part of a(n) large intestine smooth muscle circular layer.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24997029\") obo:IAO_0000115 obo:CL_4033012 \"A(n) smooth muscle cell that is part of a(n) large intestine smooth muscle longitudinal layer.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22375063\") Annotation(oboInOwl:hasDbXref \"PMID:35883599\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/squamous+epithelial+cells#suprabasalkeratinocytes\") obo:IAO_0000115 obo:CL_4033013 \"A keratinocyte that resides in the epidermal suprabasal layer and expresses differentiation markers, including keratin 1 and keratin 10, in both humans and mice. In human interfollicular epidermis, this cell retains proliferative capacity and possesses retrodifferentiation potential, acquiring basal-like properties during wound healing or basement membrane contact.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4033013 \"2023-02-02T11:17:04Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2210508\") Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasDbXref \"PMID:30023181\") obo:IAO_0000115 obo:CL_4033014 \"A small, narrow, peg-shaped epithelial cell with little cytoplasm that is part of oviduct epithelium. This cell is rarer than the ciliated and secretory epithelial cells of the fallopian tube epithelium and is often found intercalated between them. Peg cells are generally distributed basally along the epithelium and have been found in high concentrations at the fimbriated, distal end of the fallopian tube in humans. It may have a regenerative/stem-cell function. In humans, markers include EPCAM, CD44, and ITGA6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"FTE stem-like cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4033014 \"FTESC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"fallopian tube epithelial stem-like cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"intercalary cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") rdfs:comment obo:CL_4033014 \"In vitro evidence supports a stem-cell/regenerative function for these cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25236977\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") obo:IAO_0000115 obo:CL_4033015 \"A star-shaped glial cell that is part of some retina. This cell links neurons to blood vessels and may provide structural and physiological support to optic nerve head axons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33796062\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033015 \"retinal astroglia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32555229\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") rdfs:comment obo:CL_4033015 \"In response to elevated intraocular pressure, a retinal astrocyte may modulate extracellular matrix remodeling. In the human retina, a retinal astrocyte is GFAP-positive, SOD3-positive and GYPC-positive.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasExactSynonym obo:CL_4033016 \"secondary-crest myofibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033016 \"SCMF\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25448080\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033016 \"SCMFs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasRelatedSynonym obo:CL_4033016 \"alveolar myofibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:9781260462982\") Annotation(oboInOwl:hasDbXref \"PMID:15347627\") obo:IAO_0000115 obo:CL_4033017 \"A smooth muscle cell that is part of a bronchiole.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33351116\") obo:IAO_0000115 obo:CL_4033018 \"A megakaryocyte that is resident in the lung connective tissue.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36524131\") oboInOwl:hasExactSynonym obo:CL_4033018 \"lung resident megakaryocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36524131\") oboInOwl:hasExactSynonym obo:CL_4033018 \"lung-resident megakaryocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36524131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033018 \"MKL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33351116\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033018 \"lung MKs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033019 \"An ON bipolar cell type with dendrites selectively contacting S-cones.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033019 \"BB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033019 \"The axons of a blue cone bipolar cell terminate close to the ganglion cell layer, where they transfer the S-cone ON signal to small bistratified ganglion cells. Other targets of a blue cone bipolar cell include amacrine cells and possibly large bistratified ganglion cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18931053\") Annotation(oboInOwl:hasDbXref \"PMID:29656943\") obo:IAO_0000115 obo:CL_4033020 \"A mucus secreting cell that is part of a submucosal gland of the trachea.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18931053\") oboInOwl:hasExactSynonym obo:CL_4033020 \"tracheal submucosal gland mucous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29656943\") obo:IAO_0000115 obo:CL_4033021 \"A myoepithelial cell that is part of a submucosal gland of the trachea.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19965983\") obo:IAO_0000115 obo:CL_4033022 \"A mucus secreting cell of a submucosal gland of the bronchus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:5487122\") oboInOwl:hasExactSynonym obo:CL_4033022 \"bronchial gland mucous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25648514\") Annotation(oboInOwl:hasDbXref \"PMID:29656943\") obo:IAO_0000115 obo:CL_4033023 \"An epithelial cell that is part of a collecting duct of an airway submucosal gland.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29656943\") Annotation(oboInOwl:hasDbXref \"PMID:35046051\") obo:IAO_0000115 obo:CL_4033024 \"A basal cell that is part of a duct of an airway submucosal gland.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Perichondrium\") obo:IAO_0000115 obo:CL_4033025 \"A fibroblast that is part of the fibrous layer of the perichondrium. This cell is responsible for collagen fiber production.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") obo:IAO_0000115 obo:CL_4033026 \"A perichondrial fibroblast that is part of the lung.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033026 \"PC-fibro\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") obo:IAO_0000115 obo:CL_4033027 \"An OFF diffuse bipolar cell that makes synaptic contact with both L/M and S-cone photoreceptors and only minimal contact with rod photoreceptors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") oboInOwl:hasExactSynonym obo:CL_4033027 \"Diffuse Bipolar Cell Type DB1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 bipolar\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 bipolar cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033027 \"In primates, a diffuse bipolar 1 cell on average makes 81 ribbon (output) synapses, 13 contacts are with OFF parasol cells and 47 contacts are with OFF midget cells. This cell might make flat contacts at both triad-associated and non-triad-associated positions on the cone pedicle.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25309346\") Annotation(oboInOwl:hasDbXref \"PMID:26500507\") Annotation(oboInOwl:hasDbXref \"PMID:27833534\") obo:IAO_0000115 obo:CL_4033028 \"An OFF diffuse bipolar cell that predominantly connects to ON parasol cells and lateral amacrine cells. This cell contains a large number of synaptic ribbons and a small axon arbor area.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033028 \"DB2 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033028 \"In primates, a diffuse bipolar 2 cell makes an average of 133 ribbon synapses, 47 contacts are with OFF parasol cells and 4 contacts are with OFF midget cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") Annotation(oboInOwl:hasDbXref \"PMID:33009001\") obo:IAO_0000115 obo:CL_4033029 \"An OFF calbindin-positive bipolar cell that has a large dendritic field and stratifies narrowly close to the middle of the inner plexiform layer. Its axon terminal is characterized by regularly branching and varicose processes resembling beads on a string. Most of DB3a contacts with cones are triad-associated.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fnana.2015.00122\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033029 \"DB3 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033029 \"DB3a cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fnana.2015.00122\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033029 \"Originally, DB3a cells were termed diffuse bipolar 3 (DB3) cells. When an additional bipolar type which stratifies slightly more vitread and is calbindin negative was detected, this cell was renamed diffuse bipolar 3a cell. The axons of neighboring DB3a cells make homologous gap junctions. The DB3a cells provide the majority of their output to OFF parasol cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033030 \"An OFF calbindin-negative bipolar cell that has a large dendritic field and stratifies narrowly close to the middle of the inner plexiform layer. Its axon terminal is characterized by regularly branching and varicose processes resembling beads on a string. Most of DB3b contacts with cones are non-triad-associated.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033030 \"DB3b cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24107939\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:33009001\") rdfs:comment obo:CL_4033030 \"In humans, a DB3b cell is CD15 positive. A DB3b cell might make sparse contacts to rod photoreceptors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033031 \"An ON diffuse bipolar cell that predominantly connects to ON parasol cells and lateral amacrine cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033031 \"DB4 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033032 \"An ON diffuse bipolar cell that has a large dendritic field and large axon terminals, which show little or no overlap. This cell predominantly connects to narrow thorny ganglion cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033032 \"DB6 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033033 \"An OFF bipolar cell with a small dendritic tree that provides most of the triad-associated basal (flat) contacts at cone pedicles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033033 \"FMB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033034 \"An ON bipolar cell with a small dendritic tree that forms most of the central (invaginating) elements opposite the synaptic ribbon at the cone triad.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033034 \"IMB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033035 \"An ON bipolar cell that has large dendritic and axonal fields.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033035 \"GB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033035 \"A giant bipolar cell is usually monostratified, although, very rarely, it can be bistratified.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30712875\") Annotation(oboInOwl:hasDbXref \"PMID:31995762\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033036 \"An OFF bipolar cell that is fovea-specific and expresses FEZF1, NXPH1 and NXPH2.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30864819\") obo:IAO_0000115 obo:CL_4033037 \"A mucus secreting cell of a submucosal gland of the tracheobronchial tree.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24064670\") Annotation(oboInOwl:hasDbXref \"PMID:31265968\") obo:IAO_0000115 obo:CL_4033038 \"An alpha-beta CD4 T cell that resides in the lung.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24064670\") oboInOwl:hasExactSynonym obo:CL_4033038 \"lung resident memory CD4 T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31265968\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033038 \"lung CD4-positive TRM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28418771\") Annotation(oboInOwl:hasDbXref \"PMID:31265968\") obo:IAO_0000115 obo:CL_4033039 \"An alpha-beta CD8 T cell that resides in the lung.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31265968\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033039 \"lung CD8-positive TRM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558615\") rdfs:comment obo:CL_4033039 \"In the lung, CXCR6 regulates the localization of lung resident memory CD8-positive, alpha-beta T cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27776108\") obo:IAO_0000115 obo:CL_4033040 \"A lung resident memory CD8-positive, alpha-beta T cell that is CD103-positive.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27776108\") oboInOwl:hasExactSynonym obo:CL_4033040 \"lung TRM CD8-positive, CD103-positive cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27776108\") oboInOwl:hasExactSynonym obo:CL_4033040 \"lung TRM CD8-positive, integrin alpha E-positive cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27776108\") oboInOwl:hasExactSynonym obo:CL_4033040 \"lung resident memory CD8-positive CD103-positive, alpha-beta T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4033041 \"An alveolar macrophage that expresses CCL3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") oboInOwl:hasExactSynonym obo:CL_4033041 \"alveolar macrophage CCL3-positive\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4033042 \"An alveolar macrophage that expresses metallothionein.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") oboInOwl:hasExactSynonym obo:CL_4033042 \"alveolar macrophage MT-positive\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") oboInOwl:hasExactSynonym obo:CL_4033042 \"alveolar macrophage metallothionein-positive\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33382972\") Annotation(oboInOwl:hasDbXref \"PMID:35017701\") Annotation(oboInOwl:hasDbXref \"PMID:36211428\") obo:IAO_0000115 obo:CL_4033043 \"A macrophage that is part of the lung connective tissue (pulmonary interstitium). This cell performs tissue remodeling and contributes to barrier immunity through antigen presentation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36211428\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033043 \"lung IM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558434\") Annotation(oboInOwl:hasDbXref \"PMID:331922198\") Annotation(oboInOwl:hasDbXref \"PMID:36883528\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4033044 \"An epithelial cell part of respiratory tract epithelium that is a precursor of a multi-ciliated cell. This cell actively amplifies centrioles, a required step for multiciliogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558434\") Annotation(oboInOwl:hasDbXref \"PMID:331922198\") Annotation(oboInOwl:hasDbXref \"PMID:36883528\") rdfs:comment obo:CL_4033044 \"In humans, deuterosomal cells have been noted to have enriched expression of the following: PLK4, FOXJ1, DEUP1, FOXN4, YPEL1, HES6 and CDC20B. Deuterosomal cells were termed after deuterosomes, the platforms of active centriole amplification.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") obo:IAO_0000115 obo:CL_4033045 \"A dendritic cell that captures antigens in a lung and migrates to a lymph node or to the spleen to activate T cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033045 \"lung mDC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033045 \"lung mDCs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033046 \"A midget ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from invaginating midget bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033046 \"ON-midget RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033046 \"ON-midget cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033046 \"inner stratifying midget cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033047 \"A midget ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from flat midget bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033047 \"outer stratifying midget cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory parabasal cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.20.537495\") rdfs:comment obo:CL_4033048 \"In humans, respiratory tract suprabasal cells have been noted to have enriched expression of the following: CK8, KRT13, IVL, and SERPINB3. Single-cell sequencing indicates that suprabasal cells derived from the nasal epithelium are distinct from those in the tracheobronchial epithelium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1111/j.1096-3642.1981.tb01137.x\") Annotation(oboInOwl:hasDbXref \"PMID:10052456\") Annotation(oboInOwl:hasDbXref \"PMID:28655883\") Annotation(oboInOwl:hasDbXref \"http://www.nejohnston.org/Birds/documents/AvianTongues_Johnston.pdf\") obo:IAO_0000115 obo:CL_4033049 \"A taste receptor cell that is part of a taste bud of a tongue.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/s0022-5320(69)80043-2\") oboInOwl:hasRelatedSynonym obo:CL_4033049 \"gustatory cell of tongue\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0521442516\") Annotation(oboInOwl:hasDbXref \"PMID:12094209\") obo:IAO_0000115 obo:CL_4033050 \"A neuron that releases catecholamine as a neurotransmitter.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10191060\") Annotation(oboInOwl:hasDbXref \"PMID:12128258\") Annotation(oboInOwl:hasDbXref \"PMID:34880760\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2244-7917\") rdfs:comment obo:CL_4033050 \"Frequently used when describing the developing nervous system in zebrafish. A catecholaminergic neuron expresses tyrosine hydroxylase (TH), tyrosine hydroxylase 2 (TH2), aromatic amino acid decarboxylase (AADC), dopamine b-hydroxylase (DBH), and phenylethanolamine-N-methyl transferase (PEMT), which are enzymes necessary for catecholamine synthesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033051 \"A parasol ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB3a bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033051 \"outer parasol cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033052 \"A parasol ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB4 bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033052 \"inner parasol cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033053 \"small bistratified cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1002/cne.22183\") oboInOwl:hasExactSynonym obo:CL_4033053 \"small bistratified cell, blue-ON/yellow-OFF ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasRelatedSynonym obo:CL_4033053 \"Polyak's shrub cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"SBS ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"sbRGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24928499\") Annotation(oboInOwl:hasDbXref \"PMID:27889329\") obo:IAO_0000115 obo:CL_4033054 \"A cell that is adjacent to a vessel. A perivascular cell plays a crucial role in maintaining vascular function and tissue homeostasis. This cell type regulates vessel integrity and flow dynamics.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17707699\") Annotation(oboInOwl:hasDbXref \"PMID:30864819\") obo:IAO_0000115 obo:CL_4033055 \"A multi-ciliated epithelial cell located in ciliated duct of an airway submucosal gland, characterized by a columnar shape and motile cilia on its apical surface.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4033055 \"airway submucosal gland duct ciliated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24079581\") Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39451193\") obo:IAO_0000115 obo:CL_4033056 \"A terminally differentiated, specialized keratinocyte originating primarily from the nail matrix. During onychokeratinization, these cells undergo progressive flattening and produce high levels of hard, disulfide cross-linked keratins (Eckhart et al., 2024) that form the rigid, compact nail plate. Unlike epidermal keratinocytes, onychocytes are firmly integrated into the nail plate and do not desquamate.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19648928\") Annotation(oboInOwl:hasDbXref \"PMID:35617956\") Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") obo:IAO_0000115 obo:CL_4033057 \"A luminal epithelial cell of the mammary gland that can proliferate and has the potential to differentiate into a lactocyte during pregnancy. In humans, a luminal adaptive secretory precursor cell can be identified by high levels of the markers EpCAM and CD49f, and in mice it can be identified by low levels of CD29 and high levels of CD14, Kit, CD61, and Tspan8.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35617956\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"alveolar cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"alveolar progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal secretory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") oboInOwl:hasExactSynonym obo:CL_4033057 \"ER-negative luminal alveolar progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"AP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35617956\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"AV\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LASP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LumSec\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19648928\") Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasDbXref \"PMID:34156490\") Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") obo:IAO_0000115 obo:CL_4033058 \"A luminal epithelial cell of the mammary gland that transduces endocrine cues to orchestrate proliferation, architectural remodeling, and differentiation of other cells in the mammary gland via paracrine signaling. This cell expresses high levels of estrogen receptors. In humans, a luminal hormone-sensing cell can be identified by high levels of EpCAM and low levels of CD49f, and in mice it can be identified by low levels of CD29 and high levels of Foxa1, CD133, and Sca1 (Ly6a).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"hormone sensing cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"hormone-sensing mammary epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"luminal hormone-responsive cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"luminal mature cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") oboInOwl:hasExactSynonym obo:CL_4033058 \"ER-positive luminal hormone-sensor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"HS\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"HS-MEC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"LHS\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"LumHR\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasDbXref \"PMID:34156490\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4969-670X\") rdfs:comment obo:CL_4033058 \"Following lineage specification, a luminal hormone-sensing cell expresses receptors for one or more hormones, such as estrogens, progesterone, androgens, and prolactin. In response to progesterone, luminal hormone-sensing cells express TNFSF11, WNT4, and RSPO1, among other factors, which cause branching, proliferation, and partial differentiation in LASP and B-Myo cells during luteal phases of the estrous/menstrual cycle and during gestation. During ductal elongation, ER activity drives expression of AREG in LHS cells, which is necessary for proliferation of the epithelium to fill the mammary fat pad.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasDbXref \"PMID:35377806\") obo:IAO_0000115 obo:CL_4033059 \"A lactocyte that highly expresses genes associated with transcription, immune cell function, and cellular stress. A lactocyte type 1 also expresses genes involved in milk component biosynthesis (e.g., LALBA and CSNs), albeit at lower levels than a lactocyte type 2.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34097179\") oboInOwl:hasBroadSynonym obo:CL_4033059 \"luminal cluster 1 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033059 \"LC1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") oboInOwl:hasRelatedSynonym obo:CL_4033059 \"LMC major luminal cluster 1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033059 \"progenitor MEC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasDbXref \"PMID:35377806\") obo:IAO_0000115 obo:CL_4033060 \"A lactocyte that highly expresses genes associated with lipid production and milk component biosynthesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35377806\") oboInOwl:hasBroadSynonym obo:CL_4033060 \"luminal cluster 2 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033060 \"LC2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") oboInOwl:hasRelatedSynonym obo:CL_4033060 \"LMC major luminal cluster 2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28287163\") obo:IAO_0000115 obo:CL_4033061 \"An endothelial cell that is part of a central vein of liver.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28287163\") oboInOwl:hasBroadSynonym obo:CL_4033061 \"endothelial cell of central vein\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033062 \"A trophoblast cell that invades the uterine wall to anchor the placenta to the uterus. An interstitial extravillous trophoblast cell differentiates from an extravillous trophoblast cell, becoming hyperchromatic and changing its morphology to a fibroblast-like spindle-shaped cell. In humans, this cell can be distinguished by the expression of placental-specific protein 8, which stimulates migration.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") oboInOwl:hasExactSynonym obo:CL_4033062 \"invasive interstitial extravillous trophoblast cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033062 \"iEVT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") oboInOwl:hasRelatedSynonym obo:CL_4033062 \"interstitial extravillous trophoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11337369\") oboInOwl:hasRelatedSynonym obo:CL_4033062 \"interstitial trophoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033063 \"A trophoblast cell that invades the maternal spiral arteries and replace the endothelial lining, remodeling the vessels and allowing for adequate blood transport into the placenta. An endovascular extravillous trophoblast cell differentiates from an extravillous trophoblast cell. In humans, this cell can be distinguished by the expression of CD56.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033063 \"eEVT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") oboInOwl:hasRelatedSynonym obo:CL_4033063 \"endovascular extravillous trophoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11337369\") oboInOwl:hasRelatedSynonym obo:CL_4033063 \"endovascular trophoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") rdfs:comment obo:CL_4033063 \"Shortly after implantation, the endovascular extravillous trophoblast cells occlude the maternal spiral arteries, preventing premature oxygen delivery to the placental villi and reducing fetal oxidative stress.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") obo:IAO_0000115 obo:CL_4033064 \"A tissue-resident macrophage that is part of the uterus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") oboInOwl:hasBroadSynonym obo:CL_4033064 \"uterine macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") rdfs:comment obo:CL_4033064 \"Uterine macrophages are reported to be evenly distributed throughout the endometrial stroma but with aggregations observed close to the lumen of superficial secretory glands.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasDbXref \"PMID:30755708\") Annotation(oboInOwl:hasDbXref \"PMID:33150420\") obo:IAO_0000115 obo:CL_4033065 \"A mature B cell that serves as an intermediate stage in the differentiation of naive B cells into a plasmablast. A preplasmablast expresses CD30 and IL-6R and lacks expression of CD20, CD23, CD38 and CD138.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23613519\") oboInOwl:hasExactSynonym obo:CL_4033065 \"pre-plasmablast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33661294\") oboInOwl:hasExactSynonym obo:CL_4033065 \"preplasmablastic cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033065 \"prePB\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:38178246\") obo:IAO_0000115 obo:CL_4033066 \"A supporting cell that is part of the ovary and differentiates into a granulosa cell. A pre-granulosa cell develops from an early supporting gonadal cell by repressing testis determination, which can then proliferate to form primordial follicles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"ovarian pregranulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"pregranulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033066 \"PG cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27815559\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:34198768\") obo:IAO_0000115 obo:CL_4033067 \"A follicular cell of ovary that differentiates from a cuboidal granulosa cell during the secondary follicle stage. Mural granulosa cells line the inner surface of the follicle wall, surrounding the fluid-filled antral cavity. These cells produce oestrogen during the follicular phase in response to follicle-stimulating hormone (FSH), and progesterone after ovulation in response to luteinizing hormone (LH).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4033067 \"EFO:0005289\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1530/REP-16-0500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"MGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34198768\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"mural GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033083 \"A granulosa cell that has a squamous morphology and form a single layer around the oocyte in primordial follicles. This cell develops directly into a cuboidal granulosa cell during the primordial-to-primary follicle transition.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22402964\") oboInOwl:hasExactSynonym obo:CL_4033083 \"flattened granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") oboInOwl:hasRelatedSynonym obo:CL_4033083 \"pre-granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033083 \"squamous GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") rdfs:comment obo:CL_4033083 \"Often in literature squamous granulosa cell and pre-granulosa cell are used as synonyms. However, this term only makes reference to the quiescent granulosa cells that surround the primordial ovarian follicle, while a pre-granulosa cell proliferates to form the primordial follicle (and thus cells become the squamous granulosa cells).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033084 \"A granulosa cell that has a cuboidal morphology and develops from squamous granulosa cell during the transition between primordial follicle to primary follicle. Cuboidal granulosa cells proliferate to form a second layer within secondary follicles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") oboInOwl:hasExactSynonym obo:CL_4033084 \"columnar granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31849844\") oboInOwl:hasExactSynonym obo:CL_4033084 \"cuboidal epithelial granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"columnar GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"cuboidal GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033085 \"An ON diffuse bipolar cell that stratifies in the stratum 3 of the inner plexiform layer to make synapses with ON parasol ganglion cells. A diffuse bipolar 5 cell has high expression of MYO16 compared with other bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033085 \"DB5 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") rdfs:comment obo:CL_4033085 \"A diffuse bipolar 5 cell typically contacts 7–8 cone photoreceptors. The number and thickness of its dendritic processes are intermediate between those of a diffuse bipolar 6 cell (less dense and thinner) and a diffuse bipolar 4 cell (denser and thicker).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31257031\") Annotation(oboInOwl:hasDbXref \"PMID:34876704\") Annotation(oboInOwl:hasDbXref \"PMID:35712121\") obo:IAO_0000115 obo:CL_4033086 \"A tissue-resident macrophage that is associated with lipids. This cell responsible of anti-inflammatory functions, lipid accumulation and enhancing phagocytosis (Wculek et al., 2022, Liu et al., 2022). In mice and humans, a lipid-associated macrophage is characterized by the marker Trem2 (Jaitlin et al., 2019).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31257031\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033086 \"LAM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35021063\") Annotation(oboInOwl:hasDbXref \"PMID:37153549\") rdfs:comment obo:CL_4033086 \"Distinct from “adipose macrophage” in Trem2 expression, and is not limited to adipose tissue. Guilliams et al. describe these cells as being distinct from Kupffer cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033087 \"A tissue-resident macrophage that is part of the placenta. This cell helps preventing immunological rejection of the fetus by modulating the immune environment. A placental resident macrophage has high plasticity to adapt to the changing needs of each phase of pregnancy.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033087 \"placental macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033088 \"A resident macrophage that is part of the decidua. Some decidual macrophages are derived from maternal blood monocytes that are recruited to the uterus shortly after conception. The main functions of a decidual macrophage are implantation, placental development, immune regulation and vascular remodeling.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033088 \"decidual macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033088 \"maternal decidual macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4033089 \"A follicular cell of ovary that has begun to degenerate and undergo atresia, a specialized apoptosis. This cell is found in an atretic follicle, which is an ovarian follicle that started to mature but failed to reach full development and instead regresses.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15353131\") Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4033090 \"A granulosa cell that is undergoing atresia. This cell type displays distinct morphological alterations compared with a healthy granulosa cell, including pyknosis (nuclear condensation) and cellular shrinkage.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15353131\") oboInOwl:hasRelatedSynonym obo:CL_4033090 \"apoptotic granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37124720\") obo:IAO_0000115 obo:CL_4033091 \"An amacrine cell that uses both GABA and glycine as neurotransmitters.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37124720\") oboInOwl:hasExactSynonym obo:CL_4033091 \"glycinergic/GABAergic amacrine neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") obo:IAO_0000115 obo:CL_4033092 \"An enterocyte that is part of a duodenal epithelium and expresses beta-1,3-glucuronyltransferase 1 (B3GAT1), also known as CD57 or HNK-1.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") oboInOwl:hasExactSynonym obo:CL_4033092 \"CD57+ enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") rdfs:comment obo:CL_4033092 \"While CD57 is traditionally associated with immune cells (e.g., NK cells), its expression on enterocytes marks unique epithelial subsets with specific functions or maturation states. These cells are specially enriched in areas of the duodenum within submucosal glands.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") Annotation(oboInOwl:hasDbXref \"PMID:29105366\") Annotation(oboInOwl:hasDbXref \"PMID:36983561\") Annotation(oboInOwl:hasDbXref \"PMID:37768272\") obo:IAO_0000115 obo:CL_4033093 \"A stem cell that is part of the corneo-scleral limbus. This cell type resides at the basal layer of the epithelium and has a small size and high nuclear to cytoplasmatic ratio (Secker and Daniels, 2009). A limbal stem cell is responsible for corneal epithelial renewal and repair (Li et al., 2023), and to help maintain a clear corneal surface by preventing conjunctival epithelial cells from migrating onto the cornea (Wang et al., 2023).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") oboInOwl:hasExactSynonym obo:CL_4033093 \"limbal epithelial stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17562792\") oboInOwl:hasExactSynonym obo:CL_4033093 \"limbal stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033093 \"LESC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36983561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033093 \"LSC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30873171\") Annotation(oboInOwl:hasDbXref \"PMID:31986068\") Annotation(oboInOwl:hasDbXref \"PMID:35298565\") Annotation(oboInOwl:hasDbXref \"PMID:35798993\") obo:IAO_0000115 obo:CL_4033094 \"A transcriptionally distinct memory B cell whose presence increases with age, during infections, and in autoimmune diseases. In humans and mice, this cell type can be identified by the expression of T-bet, CD11c, CD11b, and the lack of CD21. An age-associated B cell responds to TLR stimuli, may produce autoantibodies, and participates in antiviral responses and pathogen clearance.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35798993\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033094 \"ABC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31995762\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") obo:IAO_0000115 obo:CL_4033095 \"An ON bipolar cell that has high expression of DIRC3, KCNJ3, LINC01915, PTPRK compared with other bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033095 \"DB4a\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31995762\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") obo:IAO_0000115 obo:CL_4033096 \"An ON bipolar cell that has high expression of NOS1AP compared with other bipolar cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033096 \"DB4b\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasDbXref \"PMID:25223880\") obo:IAO_0000115 obo:CL_4033097 \"A specialised endothelial cell that is part of the canal of Schlemm. This cell type shares characteristics and expresses markers of both blood and lymphatic endothelial cells (Kizhatil et al., 2014) and regulates aqueous humor outflow resistance by modulating pore formation and responding to mechanical strain (Stamer et al., 2015).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033097 \"SC endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033097 \"SEC\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells.\") foaf:depiction obo:CL_4033097 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15454474\") Annotation(oboInOwl:hasDbXref \"PMID:26402712\") obo:IAO_0000115 obo:CL_4033098 \"A Schlemm's canal endothelial cell that lines the inner wall of the Schlemm's canal. This cell exhibits a cobblestone appearance due to the significant biomechanical load it experiences, as well as the segmental flow of aqueous humor. The degree of biomechanical stress can lead to the formation of dome-like outpouchings known as giant vacuoles. In addition, the cell contains transcellular pores that mediate aqueous humor transport (Dautriche et al., 2015). This endothelial cell also displays prominent peripheral F-actin bands which help maintain structural integrity under pressure (Ethier et al., 2004).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26402712\") oboInOwl:hasNarrowSynonym obo:CL_4033098 \"human Schlemm's canal inner wall cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033098 \"HSCIW cell\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells. The inner wall endocrine cells, shown in blue, line the canal surface facing the trabecular meshwork. Some of the inner wall cells contain giant vacuoles.\") foaf:depiction obo:CL_4033098 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1426078\") Annotation(oboInOwl:hasDbXref \"PMID:15454474\") Annotation(oboInOwl:hasDbXref \"PMID:26402712\") obo:IAO_0000115 obo:CL_4033099 \"A Schlemm's canal endothelial cell that lines the outer wall of the Schlemm's canal. This cell displays a smooth and flat morphology (Dautriche et al., 2015) and it is distinguished by the presence of Weibel-Palade bodies, specialized organelles that produce, store, and release P-Selectin (Hamanaka et al., 1992). This endothelial cell also exhibits stellate (star-shaped) actin arrangements distributed throughout much of the cell (Ethier et al., 2004).\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells. The outer wall endocrine cells, shown in green, line the side of Schlemm’s canal facing the collector channels and venous system.\") foaf:depiction obo:CL_4033099 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10719353\") obo:IAO_0000115 obo:CL_4040000 \"A glial precursor cell that generates oligodendrocytes and type-1 and type-2 astrocytes. It has been shown in some mammals that this cell type may express A2B5, nestin, FGFR-1, FGFR-2, FGFR-3, PLP, and DM-20 antigens. Unlike oligodendrocyte precursor cell, it does not initially express PDGFR-alpha and can differentiate into both type-1 and type-2 astrocytes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10719353\") oboInOwl:hasBroadSynonym obo:CL_4040000 \"glial restricted precursor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11921204\") oboInOwl:hasExactSynonym obo:CL_4040000 \"tripotential glial-restricted precursor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11756508\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4040000 \"GRP cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27280409\") Annotation(oboInOwl:hasDbXref \"PMID:35328607\") obo:IAO_0000115 obo:CL_4040001 \"A horse-specific, highly invasive trophoblast cell that invades the endometrium where it forms endometrial cups.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35328607\") oboInOwl:hasExactSynonym obo:CL_4040001 \"equine chorionic girdle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27280409\") rdfs:comment obo:CL_4040001 \"Humans, mice and rats have a highly invasive (hemochorial) placentation. Horses have a non-invasive epitheliochorial placenta, except for the transient endometrial cup.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16336493\") Annotation(oboInOwl:hasDbXref \"PMID:17483847\") Annotation(oboInOwl:hasDbXref \"PMID:25975510\") obo:IAO_0000115 obo:CL_4040002 \"Glial cell that provides support to the enteric nervous system. It is involved in enteric neurotransmission, in maintaining the integrity of the mucosal barrier of the gut and serves as a link between the nervous and immune systems of the gut. In enteric nerve strands, glial processes ensheath multiaxonal bundles which distinguishes enteric glia from all other peripheral glia. Ultrastructurally, the most conspicuous trait of an enteroglial cell is the presence of 10 nm filaments, which criss-cross the cell body, form axial bundles in the processes and appear to firmly anchor the cells to the ganglionic surfaces. Similar to astrocytes, their main constituent is glial fibrillary acidic protein (GFAP).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11169131\") Annotation(oboInOwl:hasDbXref \"PMID:25170211\") oboInOwl:hasExactSynonym obo:CL_4040002 \"enteric glial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11169131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4040002 \"enteric glia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1316350\") obo:IAO_0000115 obo:CL_4040003 \"Precursor of type II pneumocyte. These cells do not have lamellar bodies, which are a marker of type II pneumocyte maturity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9624168\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal alveolar pre-type II epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-0819-0473\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type 2 pneumocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12114192\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type II alveolar epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type II pneumocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0819-0473>) obo:IAO_0000115 obo:CL_4040004 \"Any mesenchymal stem cell of adipose tissue that is part of an orbital region.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31377878\") oboInOwl:hasExactSynonym obo:CL_4040004 \"OAMSC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30210548\") oboInOwl:hasExactSynonym obo:CL_4040004 \"Orbital ASCs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31377878\") oboInOwl:hasExactSynonym obo:CL_4040004 \"orbital adipose-derived mesenchymal stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasDbXref \"PMID:34026757\") obo:IAO_0000115 obo:CL_4040005 \"A mesenchymal stem cell that is part of the apical papilla tooth root.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasBroadSynonym obo:CL_4040005 \"stem cells from the apical papilla\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37887345\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4040005 \"SCAP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4040005 \"SCAPs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34026757\") rdfs:comment obo:CL_4040005 \"The mesenchymal stem cells of the apical papilla have high capacity for osteogenic, adipogenic, and chondrogenic differentiation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28553007\") obo:IAO_0000115 obo:CL_4040006 \"A chromatophore that is part of the dermis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4042001 \"A GABAergic interneuron that has its soma located in the striatum and that has an enriched expression of the genes TAC3 and LHX6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") oboInOwl:hasExactSynonym obo:CL_4042001 \"TAC3 interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4042002 \"A nucleus accumbens shell and olfactory tubercle D1 medium spiny neuron that co-expresses TAC3 and the DRD1 receptor.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"D1Sh TAC3 archetype\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"TAC3-positive D1Sh-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"TAC3-positive MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") rdfs:comment obo:CL_4042002 \"A TAC3-positive medium spiny neuron has its soma in a cluster in the medial shell region of the nucleus accumbens. In Rhesus Macaque, this medium spiny neuron has an enriched expression of the genes MPPED1, HPCAL1, MEIS3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasDbXref \"PMID:37626977\") obo:IAO_0000115 obo:CL_4042003 \"A central nervous system macrophage that is part of a choroid plexus, a meninx and a perivascular space. A border associated macrophage interacts with various components of the CNS vasculature and meninges, it participates in immune surveillance and in the regulation of the blood brain barrier.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36945367\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042003 \"BAM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33556248\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042003 \"CAM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") oboInOwl:hasRelatedSynonym obo:CL_4042003 \"CNS-associated macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29426702\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") rdfs:comment obo:CL_4042003 \"In humans, a border associate macrophage expresses CD45 and CD11B. This cell is also known to have the following molecular signature: CD206, CD38, LYVE1, CD163, CD169.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") obo:IAO_0000115 obo:CL_4042004 \"A choroid plexus macrophage that is part of the apical surface of some choroid plexus epithelium. This macrophage has a star-like shaped body.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31433571\") oboInOwl:hasExactSynonym obo:CL_4042004 \"Kolmer’s cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042004 \"cpepiMΦ\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042004 \"epiplexus cpMΦ\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") obo:IAO_0000115 obo:CL_4042005 \"A choroid plexus macrophage that is part of a choroid plexus stroma.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37626977\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042005 \"cpstMΦ\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042005 \"stromal cpMΦ\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") obo:IAO_0000115 obo:CL_4042006 \"A border associated macrophage which is part of a dura matter. This macrophage phagocytoses intruding pathogens and foreign molecules detected in the bloodstream or in the cerebrospinal fluid. This cell has an amoeboid body with dynamic protrusions in homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042006 \"dmMΦ\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:25904839\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042007 \"An astrocyte with highly branched protrusions, found in neocortex layers 2-6. It is involved with the formation and elimination of synapses, glutamate clearance, modulation of synaptic functions and regulation of blood flow in response to synaptic activity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:20012068\") rdfs:comment obo:CL_4042007 \"This astrocyte extends its branches to several hundred of dendrites to multiple neurons to envelope 100,000 or more synapses. In humans, a protoplasmic astrocyte has an average diameter of 142 µm, and its diameter ranges between 100 and 400 µm. In rodents the average diameter of a protoplasmic astrocites is 56 µm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:22144298\") Annotation(oboInOwl:hasDbXref \"PMID:28280934\") Annotation(oboInOwl:hasDbXref \"PMID:31435019\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042008 \"A cell type located in the first layer of the neocortex with radial protrusions extending transversely into the deeper cortex layers, herby facilitating communication across neurons, astrocytes, capillaries, meninges and cerebrospinal fluid through contact with neurons, pia mater and capillaries.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28280934\") rdfs:comment obo:CL_4042008 \"In humans, a fibrous astrocyte diameter is circa 182 µm. In rodents, a fibrous astrocyte diameter is circa 85 µm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:30552685\") Annotation(oboInOwl:hasDbXref \"PMID:31435019\") Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042009 \"An astrocyte type that presents radial protrusions across the layers of a cortex. The soma of this astrocyte is part of the first layer of a neocortex. This astrocyte extents its protrusions transversally to the deeper layers of a cortex and it creates contact with neurons, the pia matter and capillaries. This astrocyte is involved in facilitating the communication across neurons, astrocytes, capillaries, meninges and the cerebrospinal fluid.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30552685\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042009 \"ILA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042010 \"An interlaminar astrocyte whose soma is part of the first layer of a neocortex and is in contact with a pia surface.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042011 \"An interlaminar astrocyte type whose soma is part of the upper first layer of the neocortex and its processes extend to a pia surface.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29311847\") Annotation(oboInOwl:hasDbXref \"PMID:32108571\") obo:IAO_0000115 obo:CL_4042012 \"An L2 intratelencephalic projecting glutamatergic neuron with a soma on the L1-L2 border. This neuron type has small apical dendrites projecting to L1.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32108571\") oboInOwl:hasExactSynonym obo:CL_4042012 \"layer 2 marginal neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29311847\") Annotation(oboInOwl:hasDbXref \"PMID:32108571\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042012 \"L2MN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042013 \"A transcriptomically distinct GABAergic interneuron marked by Lamp5 and Lhx6 expression, derived from the Medial Ganglionic Eminence (MGE), and located in the pallium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36007006\") oboInOwl:hasExactSynonym obo:CL_4042013 \"Ivy cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") oboInOwl:hasExactSynonym obo:CL_4042013 \"Lamp5-Lhx6 type\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") obo:IAO_0000115 obo:CL_4042014 \"A VIP GABAergic cortical interneuron with a soma located in L1-3 of some neocortex in Mmus. This neuron has a multipolar morphology with spiny dendrites concentrating on L1 of the cortex, and has a burst firing electrophysiological signature with highly dynamic dendritic spines.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") oboInOwl:hasExactSynonym obo:CL_4042014 \"superficial VIP-positive spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") oboInOwl:hasRelatedSynonym obo:CL_4042014 \"multipolar VIP neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:31754098\") Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasDbXref \"PMID:33301603\") obo:IAO_0000115 obo:CL_4042015 \"A VIP GABAergic cortical interneuron expressing vasoactive intestinal polypeptide and choline acetyltransferase in the Mmus neocortex. This interneuron releases both γ-aminobutyric acid and acetylcholine.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33301603\") oboInOwl:hasExactSynonym obo:CL_4042015 \"VIP+/ChAT+ interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32027647\") oboInOwl:hasExactSynonym obo:CL_4042015 \"VIP/ChAT interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042015 \"VChI\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33301603\") oboInOwl:hasRelatedSynonym obo:CL_4042015 \"VIP+/ChAT+ cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasDbXref \"PMID:33301603\") rdfs:comment obo:CL_4042015 \"Work in the mouse barrel cortex and somatosensory cortex shows that a VIP-ChAT interneuron is predominantely located in L2/3 and more rarely in the deeper layers of the cortex (Dudai et al., 2021; Dudai et al., 2020). This neuronal type could be transcriptomically distinct as transcriptomic studies have identified VIP neurons expressing ChAT in a whole brain mouse transcriptomic study (Tasic et al., 2018).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4042016 \"A serous secreting cell that is part of a submucosal gland in the nasal cavity respiratory epithelium.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4042016 \"https://cellxgene.cziscience.com/e/9f222629-9e39-47d0-b83f-e08d610c7479.cxg/\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11005715\") oboInOwl:hasRelatedSynonym obo:CL_4042016 \"nasal mucous secretory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042017 \"The dorsal-most tanycyte type of the third venticle.  These cells projects into the ventromedial or dorsomedial nucleus of the hypothalamus. This type of tanycyte extends its protrusions close to parenchymal neurons without contacting blood vessels. It expresses the glial marker S-100β.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042017 \"DMH tanycyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042017 \"VMH tanycyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26578855\") rdfs:comment obo:CL_4042017 \"In rodents, a1 tanycytes are known to express DARPP-32, GPR50, NA Vimentin, Connexin 43, GLT-1, GLUT1(+) (Goodman and Hajihosseini 2015; Prevot et al., 2018).\")\nAnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042017 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042017 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042018 \"Tanycyte of the third ventricle, located immediately ventral to alpha-1 tanycytes. These cells project to the ventromedial and arcuate nuclei of the hypothalamus and express the glial marker S-100β.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042018 \"dmARH tanycyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26578855\") rdfs:comment obo:CL_4042018 \"In rodents, this type of tanycyte is more developmentally advanced than alpha1 tanycytes, shows a high neurogenic competence and expresses the following markers DARPP-32, Vimentin, GPR50, Connexin-43, GLT-1, GLUT1(+) (Goodman and Hajihosseini 2015; Prevot et al., 2018)\")\nAnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042018 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042018 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042019 \"A type of tanycyte located in ventral part of the lateral wall of the third ventricle and in the lateral infundibular recess of the brain. This tanycyte has an elongated morphology with multiple microvilli extending into the median eminence. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042019 \"vmARH tanycyte\")\nAnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042019 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042019 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042020 \"A type of tanycyte located in the floor of third ventricle and the infindibular recess. This tanycyte has an elongated morphology with multiple microvilli extending medially and ventrally to the median eminence, contacting the pial surface and blood vessels. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042020 \"ME tanycyte\")\nAnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042020 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042020 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10467245\") obo:IAO_0000115 obo:CL_4042021 \"A progenitor cell of the central nervous system that differentiates exclusively onto neurons. This progenitor cell is found in a hippocampus subventricular zone, developing cortex and spinal cord of the central nervous system.\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:12429182\") oboInOwl:hasRelatedSynonym obo:CL_4042021 \"NRP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12429182\") Annotation(oboInOwl:hasDbXref \"PMID:9354325\") rdfs:comment obo:CL_4042021 \"In vitro cultures of embryonic mouse neural tubes show that neuronal-restricted precursors (NRPs) are derived from multipotent neuroepithelial cells to give rise to neurons. This progression suggests a linear relationship between multipotent progenitors and neuronal-restricted differentiation. (Mayer-Proschel et al., 1997). In the spinal cord of rats, neural-restricted precursor cells give rise cholinergic, GABAergic, glutametergic neurons (Cao and Howard et al., 2002).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15531362\") Annotation(oboInOwl:hasDbXref \"PMID:33052610\") obo:IAO_0000115 obo:CL_4042022 \"A progenitor cell of the central nervous system that differentiates exclusively onto astrocytes. This progenitor cell expresses CD44 and S100 calcium-binding protein B.\")\nAnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:33052610\") oboInOwl:hasRelatedSynonym obo:CL_4042022 \"ARP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") oboInOwl:hasRelatedSynonym obo:CL_4042022 \"astrocyte precursor cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") rdfs:comment obo:CL_4042022 \"In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30134177\") Annotation(oboInOwl:hasDbXref \"PMID:37292997\") obo:IAO_0000115 obo:CL_4042023 \"A GABAergic interneuron expressing PTHLH and PVALB that has its soma in a striatum. This GABAergic interneuron type presents a spatial expression gradient of PVALB in the mouse striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") oboInOwl:hasRelatedSynonym obo:CL_4042023 \"PTHLH/PVALB cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") oboInOwl:hasRelatedSynonym obo:CL_4042023 \"PTHLH +/PVALB+ interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") rdfs:comment obo:CL_4042023 \"According to spatial transcriptomic data in the human striatum, pthlh-expressing interneurons are one of the most abundant population of interneurons in the striatum (Leonardo D. Garma, et al., 2024).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30134177\") obo:IAO_0000115 obo:CL_4042024 \"A pthlh-expressing interneuron that expresses MOXD1 and has its soma in a striatum.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32826893\") Annotation(oboInOwl:hasDbXref \"PMID:35308118\") obo:IAO_0000115 obo:CL_4042025 \"A midbrain dopaminergic neuron that has its soma located in a substantia nigra. This dopaminergic neuron type is highly metabolically active and it is involved in the regulation of movement, cognition, motivation and reward. Neurodegeneration of this dopaminergic neuronal type causes loss in fine motor control in Parkinson's Disease.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35308118\") oboInOwl:hasNarrowSynonym obo:CL_4042025 \"SNpc dopaminergic neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") obo:IAO_0000115 obo:CL_4042026 \"A GABAergic interneuron that has its soma in the anterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterized by the expression of Six3 and Foxp1 and it develops from Nkx6-2 expressing neuronal progenitors in the ventrolateral midbrain-diencephalon region.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042026 \"aSNpr\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") obo:IAO_0000115 obo:CL_4042027 \"A GABAergic interneuron that has its soma in the posterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterised by the expression of the transcription factors Pax5, Ctip2 and Pou6f2 and it develops from the ventrolateral r1 neuroepithelium expresing NKX61.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") oboInOwl:hasRelatedSynonym obo:CL_4042027 \"pSNpr\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31096632\") Annotation(oboInOwl:hasDbXref \"PMID:32116519\") Annotation(oboInOwl:hasDbXref \"PMID:37833544\") obo:IAO_0000115 obo:CL_4042028 \"A neuron in the central nervous system that is not committed to a differentiated fate, has not been newly derived from neurogenesis, and does not integrate into any circuit.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32116519\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042028 \"IN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32116519\") rdfs:comment obo:CL_4042028 \"It is hypothesised that immature neurons can be utilised as a neurogenic reserve and that they can be involved in circuit plasticity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37833544\") obo:IAO_0000115 obo:CL_4042029 \"An immature neuron of a cerebral cortex. This neuron develops prenatally and remains in an immature state throughout the lifespan of the organism.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37833544\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042029 \"cIN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") obo:IAO_0000115 obo:CL_4042030 \"A GABAergic interneuron located in the Purkinje layer of the cerebellar cortex. This GABAergic interneuron type has a distinct morphology, it presents a small cell soma near the Purkinje cell layer (PCL), dendrites that extend to the surface of the molecular layer, and beaded axons that make local synapses contacts within the molecular layer. A candelabrum cell is excited by mossy fibers and granule cells but inhibited by Purkinje cells, and it inhibits molecular layer interneurons, which leads to the disinhibition of Purkinje cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") oboInOwl:hasExactSynonym obo:CL_4042030 \"candelabrum interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042030 \"CC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") rdfs:comment obo:CL_4042030 \"Candelabrum cells are the most abundant interneurons in the Purkinje cell layer and are present in all cerebellar lobules.\")\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_4042030 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasDbXref \"PMID:35662200\") obo:IAO_0000115 obo:CL_4042031 \"An oligodendrocyte of the central nervous system that exhibits immune properties such as self-presentation and non-self antigen presentation to T cells, phagocytosis of debris, and cytokine and chemokine production. Immune oligodendroglia is immunoreactive during inflammation, neurodegenerative disorders, chronic stress and major depressive disorder.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35615276\") oboInOwl:hasExactSynonym obo:CL_4042031 \"immune oligodendrocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"Im-OL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"ImOL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"ImOLG\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"imOLG\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasDbXref \"PMID:37057892\") rdfs:comment obo:CL_4042031 \"During inflammation, immuno oligodendroglia express MHC II to interact with immune cells in mouse models (Harrington et al., 2023; Madeira et al., 2022). In a mouse model of major depressive disorder and chronic stress, immuno oligodendroglia were associated with prefrontal cortex hypomyelination (Kokkosis et al., 2022).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042032 \"A transcriptomically distinct GABAergic neuron, located in the cerebral cortex and derived from the CGE, that expresses the transcript PAX6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25870542\") Annotation(oboInOwl:hasDbXref \"PMID:28192062\") obo:IAO_0000115 obo:CL_4042033 \"A neuron of the central nervous system that expresses POMC and synthesizes the POMC precursor polypeptide. This neuron type is located in the arcuate nucleus of the hypothalamus and in the nucleus tractus solitarius of the brainstem. The pro-opiomelanocortin neuron is part of the central melanocortin system and it is involved in regulating energy homeostasis, metabolism, and appetite. This neuronal type responds to hormonal signals such as levels of leptin and insulin, and its activation results in the release of α-melanocyte-stimulating hormone (α-MSH), which acts on melanocortin receptors to suppress food intake and increase energy expenditure.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34002087\") oboInOwl:hasRelatedSynonym obo:CL_4042033 \"POMC neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34002087\") oboInOwl:hasRelatedSynonym obo:CL_4042033 \"POMC-expressing neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192062\") Annotation(oboInOwl:hasDbXref \"PMID:33633406\") rdfs:comment obo:CL_4042033 \"Pro-opiomelanocortin neurons have a diverse projection pattern. The neurons in the rostral arcuate nucleus project to autonomic areas, caudal arcuate POMC neurons project mainly to hypothalamic areas (Toda et al., 2017). Dysregulation of pro-opiomelanocortin neurons is associated with obesity and metabolic disorders (Quarta et al., 2020).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") obo:IAO_0000115 obo:CL_4042034 \"An interneuron neuron characterized by the expression of calcitonin gene-related peptide (CGRP), a 37-amino acid neuropeptide. This neuron type is involved in nociception and pain modulation by facilitating the transmission of nociceptive signals from peripheral sensory nerve endings to central nervous system structures. This neuron type is found in the dorsal root ganglia (DRG) and trigeminal ganglion, and the spinal cord dorsal horn.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasExactSynonym obo:CL_4042034 \"Calcitonin gene-related peptide neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasRelatedSynonym obo:CL_4042034 \"CGRP-expressing interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasRelatedSynonym obo:CL_4042034 \"CGRP-positive neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30742002\") Annotation(oboInOwl:hasDbXref \"PMID:33075461\") Annotation(oboInOwl:hasDbXref \"PMID:34616064\") Annotation(oboInOwl:hasDbXref \"PMID:38692278\") obo:IAO_0000115 obo:CL_4042035 \"A type of cerebellar inhibitory GABAergic interneuron that is located in the molecular layer of the cerebellum. This cell type inhibits Purkinje cells and other molecular layer interneurons. This interneuron plays a crucial role in regulating cerebellar output through feedforward inhibition and is characterized by its fast-spiking properties.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33075461\") Annotation(oboInOwl:hasRelatedSynonym obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042035 \"MLI\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30284033\") Annotation(oboInOwl:hasDbXref \"PMID:38020069\") Annotation(oboInOwl:hasDbXref \"PMID:39035036\") obo:IAO_0000115 obo:CL_4042036 \"A neuron of the central nervous system with its soma primarily located in the lateral hypothalamic area and surrounding regions, including the zona incerta. This neuron type expresses melanin-concentrating hormone and is involved in regulating various physiological processes, including sleep, feeding behavior, and energy homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30284033\") oboInOwl:hasRelatedSynonym obo:CL_4042036 \"MCH neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38020069\") rdfs:comment obo:CL_4042036 \"Nearly all melanin-concentrating hormone neurons express the glutamate transporter VGlut2, however a small subset of them expresses the machinery for GABA release and neurotransmission.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30131490\") Annotation(oboInOwl:hasDbXref \"PMID:30467465\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") obo:IAO_0000115 obo:CL_4042037 \"A interneuron of the striatum expressing gamma-aminobutyric acid and somatostatin. This interneuron has a fusiform soma with a diameter between 9 - 25 µm, it has a long axon up to the length of 1mm. This neuron type displays a low threshold Ca2+ spike (LTS), a high input resistance, and the expression of long-lasting plateau potentials following depolarization from rest.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30131490\") oboInOwl:hasBroadSynonym obo:CL_4042037 \"SOM cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4042037 \"striatal SST+ IN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30467465\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") rdfs:comment obo:CL_4042037 \"Some striatal SST GABAergic neurons can co-release glutamate and generate excitation-inhibition responses in postsynaptic neurons. This interneuron type has the least dense dendritic branches in the striatum. In the dorsomedial striatum these neurons regulate the activity of striatal projection neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35431796\") Annotation(oboInOwl:hasDbXref \"PMID:3746410\") obo:IAO_0000115 obo:CL_4042038 \"A type of primary motor neuron situated in the rostral region of the spinal cord. RoP neurons extend their axons to innervate the ventral trunk musculature.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3746410\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042038 \"RoP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12593982\") Annotation(oboInOwl:hasDbXref \"PMID:12637172\") Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK98190/\") obo:IAO_0000115 obo:CL_4042039 \"A neuron of the central nervous system that develops from a caudal ganglionic eminence.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12593982\") Annotation(oboInOwl:hasDbXref \"PMID:12637172\") Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK98190/\") rdfs:comment obo:CL_4042039 \"Neurons derived from the caudal ganglionic eminence consist mostly of neurons populating the cortical layers of the brain and some subcortical areas such as the globus pallidus, the striatus and the hippocampus. Amongst neurons derived from the caudal ganglionic eminence there are cortical GABAergic neurons such as Pax6, Lamp5, VIP, sncg, GABAergic; in the hippocampus, mossy fibers, pyramidal neurons, granule neurons and interneurons; in the striatum and globus pallidus, medium spiny projection neurons.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.jocn.2021.05.056\") Annotation(oboInOwl:hasDbXref \"PMID:11307040\") Annotation(oboInOwl:hasDbXref \"PMID:16276355\") obo:IAO_0000115 obo:CL_4042040 \"A glutametergic neuron with its soma located in a basal ganglia. This neuron type is involved in motor control, decision making and learning.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22498715\") Annotation(oboInOwl:hasDbXref \"PMID:30498197\") Annotation(oboInOwl:hasDbXref \"PMID:33785138\") rdfs:comment obo:CL_4042040 \"The glutametergic neurons in the basal ganglia are part of a series of different circuits such as the corticolstriatal circuit, which is involved in regulating voluntary movements. The subthalamic nucleus circuit, which is involved in modulating the output of the basal ganglia, particularly in controlling movement initiation and inhibition. The thalamocortical loop, which is involved in refining motor movements and integrating sensory information with motor commanding.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35431796\") Annotation(oboInOwl:hasDbXref \"PMID:3746410\") obo:IAO_0000115 obo:CL_4042041 \"A type of primary motor neuron located in the middle region of the spinal cord. This primary motor neuron type is characterized by their distinct axonal pathways that innervate the middle trunk muscles.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4042041 \"ZFA:0005179\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3746410\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042041 \"MiP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047006 \"An endothelial cell that lines an artery in the fetal circulatory system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"endothelial cell of fetal artery\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"fetal arterial EC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"fetal artery EC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21839917\") Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasDbXref \"PMID:32466671\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") Annotation(oboInOwl:hasDbXref \"PMID:36685855\") obo:IAO_0000115 obo:CL_4047007 \"A pericyte that is in an early stage of development, found in newly forming or remodeling blood vessels. An immature pericyte is characterized by it's mesenchymal stem cell-like properties and high proliferative capacity, which allows it to differentiate into various types of pericytes and contribute to the structural and functional maturation of the vasculature. Immature pericytes are stellate in new vessels and elongated with less protrusions in remodeling vessels.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047007 \"imPCs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047007 \"immature PCs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") obo:IAO_0000115 obo:CL_4047011 \"An endothelial cell that lines the veins in the fetal circulatory system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") oboInOwl:hasExactSynonym obo:CL_4047011 \"fetal venous endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047011 \"fetal vein EC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047011 \"fetal venous EC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24853910\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047012 \"A specialized pericyte that actively participates in the formation of new blood vessels during angiogenesis by undergoing phenotypic changes, increasing proliferation, and interacting closely with endothelial cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") Annotation(oboInOwl:hasDbXref \"PMID:33195268\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047017 \"A transit amplifying cell of the gut epithelium, located in the wall of the intestinal crypt, just above intestinal stem cells from which they derive. These are rapidly dividing cells, capable of multiple rounds of division before differentiating into the various cell types of the gut epithelium (enterocyte, goblet, eneterodendocrine, paneth cells).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24813615\") oboInOwl:hasBroadSynonym obo:CL_4047017 \"transit-amplifying cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") oboInOwl:hasRelatedSynonym obo:CL_4047017 \"TA cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28049136\") Annotation(oboInOwl:hasDbXref \"PMID:36060223\") obo:IAO_0000115 obo:CL_4047018 \"An enterocyte that is part of the colon, in the early stages of differentiation, located in the intestinal crypt-villus axis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.01.13.426602\") oboInOwl:hasExactSynonym obo:CL_4047018 \"early enterocyte of colon\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") Annotation(oboInOwl:hasDbXref \"PMID:35235783\") obo:IAO_0000115 obo:CL_4047019 \"An enterocyte in the early stages of development, located above the transit-amplifying cell zone in the intestinal crypt-villus axis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") oboInOwl:hasRelatedSynonym obo:CL_4047023 \"S1 fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17893694\") Annotation(oboInOwl:hasDbXref \"PMID:35406678\") obo:IAO_0000115 obo:CL_4047029 \"An endothelial cell forming the walls of capillaries immediately downstream from arterioles, facilitating the exchange of substances between blood and interstitial fluid. This cell is characterized by a small diameter and may be continuous, fenestrated, or sinusoidal, depending on their location and function. This cell plays a crucial role in tissue oxygenation, nutrient delivery, and maintaining homeostasis within the microvascular network.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41467-022-33324-7\") Annotation(oboInOwl:hasDbXref \"PMID:23620236\") obo:IAO_0000115 obo:CL_4047030 \"A specialized endothelial cell located in the transition zone between capillaries and small venules in the microvascular system. It exhibits characteristics of both capillary and venous cells, expressing markers from both types. This cell plays a role in regulating blood flow and substance exchange between blood and tissues.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41467-022-33324-7\") oboInOwl:hasExactSynonym obo:CL_4047030 \"Cap-Venous endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2019.00282\") obo:IAO_0000115 obo:CL_4047032 \"A specialized pericyte located within the basement membrane of a blood capillary. This cell is characterized by its ability to produce and release a variety of bioactive molecules, collectively known as the pericyte secretome, including cytokines and regulators of angiogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21443757\") Annotation(oboInOwl:hasDbXref \"PMID:33630273\") obo:IAO_0000115 obo:CL_4047034 \"A smooth muscle cell that is part of the muscularis externa of the stomach wall. It is characterized by its fusiform shape, involuntary control, and ability to generate slow, sustained contractions. This cell is organized in distinct layers and is essential for gastric motility and digestion.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21443757\") Annotation(oboInOwl:hasDbXref \"PMID:33630273\") obo:IAO_0000115 obo:CL_4047035 \"A specialized smooth muscle cell located in the outermost layer of the muscularis externa of the stomach wall. This cell is arranged longitudinally along the stomach's axis and is responsible for the contractions that facilitate food movement toward the pylorus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11146428\") Annotation(oboInOwl:hasDbXref \"PMID:32424507\") obo:IAO_0000115 obo:CL_4047036 \"A smooth muscle cell located in the middle layer of the muscularis externa of the stomach wall. This cell is arranged concentrically with the stomach's longitudinal axis, forming a continuous sheet of contractile tissue. It is fusiform in shape, containing actin and myosin filaments that enable contraction without striations. This cell contributes to the mechanical digestion and movement of food within the stomach through coordinated contractions, and plays a role in forming the pyloric sphincter in the pyloric region.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29493959\") obo:IAO_0000115 obo:CL_4047037 \"A smooth muscle cell found in the innermost layer of the muscularis externa of the stomach wall. This cell forms a unique layer of smooth muscle fibers oriented obliquely to the stomach's longitudinal axis. It is responsible for aiding in the mixing and churning of gastric contents, contributing to mechanical digestion within the stomach.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047037 \"stomach smooth muscle oblique layer cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-020-0271-2\") Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-021-00561-y\") Annotation(oboInOwl:hasDbXref \"PMID:32152479\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4047038 \"A multipolar neuron in the myenteric plexus of the gastrointestinal tract, characterized by a small to medium-sized cell body and multiple short dendrites.  This neuron exhibits fast excitatory postsynaptic potentials and can be classified into stubby, spiny and hairy subtypes based on dendritic morphology. (Brehmer, 2021)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18221249\") Annotation(oboInOwl:hasDbXref \"PMID:27445346\") obo:IAO_0000115 obo:CL_4047040 \"A smooth muscle cell that is found in the inner muscular layer of hollow organs. It is characterized by its spiral/helical arrangement around organ lumens. This cell is crucial for peristaltic movements in organs.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19906678\") Annotation(oboInOwl:hasDbXref \"PMID:21865647\") Annotation(oboInOwl:hasDbXref \"PMID:26964064\") Annotation(oboInOwl:hasDbXref \"PMID:28066889\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047042 \"An enteric glial cell located within the myenteric ganglia of the gastrointestinal tract. This cell has a small somata and has very short, irregularly branched processes that surround neuron cell bodies, giving it a protoplasmic-like appearance. It plays crucial roles in modulating myenteric neuron activity, regulating oxidative stress, and influencing neuroinflammation and neurogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047042 \"type 1 MP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2023.1170309\") Annotation(oboInOwl:hasDbXref \"PMID:28487635\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047043 \"An enteric glial cell that is associated with neuron cell bodies within submucosal ganglia of the gastrointestinal tract. This cell is located in the submucosa, a layer of connective tissue beneath the intestinal mucosa. This cell plays a role in modulating secretomotor neuron activity and contributes to the regulation of digestive fluid secretion and absorption.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047043 \"type I SMP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1002/glia.22876\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047044 \"An enteric glial cell that has an elongated, fibrous morphology with long processes that run parallel to nerve fibers connecting enteric myenteric ganglia. This cell is located in the interganglionic fiber tracts of the enteric nervous system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35111752\") oboInOwl:hasExactSynonym obo:CL_4047044 \"type II enteric glia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25161129\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:37153631\") Annotation(oboInOwl:hasDbXref \"PMID:38957473\") obo:IAO_0000115 obo:CL_4047045 \"An enteric glial cell located in the lamina propria of the intestinal mucosa. This cell plays important roles in maintaining gut barrier function, regulating intestinal homeostasis, and mediating interactions between the enteric nervous system and the immune system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.celrep.2023.112194\") Annotation(oboInOwl:hasDbXref \"PMID:29927320\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047047 \"An enteric glial cell located within the ganglia of the enteric nervous system. This cell is characterized by it’s small somata and short, irregularly branched processes that surround neuronal cell bodies in the myenteric and submucosal ganglia. This cell plays important roles in modulating neuronal activity and neurogenesis in the gastrointestinal tract.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") oboInOwl:hasExactSynonym obo:CL_4047047 \"intraganglionic glia\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047047 \"type 1 enteric glia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35111752\") oboInOwl:hasExactSynonym obo:CL_4047047 \"type I enteric glia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:34401661\") obo:IAO_0000115 obo:CL_4047048 \"An enteric glial cell characterized by a small central soma that extends long, thin, bipolar projections. This cell is primarily located along small nerve fibers within the muscle layers of the gastrointestinal tract and is known for its unbranching processes that closely follow these nerve fibers in the muscularis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34401661\") oboInOwl:hasRelatedSynonym obo:CL_4047048 \"intramuscular glia\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047051 \"An enterocyte of the human small intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These enterocytes have a disinctive transcriptomic profile and are scattered through the small intestine epithelium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047052 \"An enterocyte of the human colon expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These cells have a distinct transcriptomic profile compared to other enterocytes and are scattered through the colon epithelium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33033253\") Annotation(oboInOwl:hasDbXref \"PMID:33628208\") Annotation(oboInOwl:hasDbXref \"PMID:35746551\") Annotation(oboInOwl:hasDbXref \"PMID:36750615\") Annotation(oboInOwl:hasDbXref \"PMID:39369473\") obo:IAO_0000115 obo:CL_4047053 \"A macrophage characterized by high expression of Triggering Receptor Expressed on Myeloid cells 2 (TREM2), found in various tissues including the liver, adipose tissue, bone, gut (Colonna, 2023), and tumor microenvironments, where it is associated with immunosuppressive and anti-inflammatory activity (Colmenares, 2024; Khantakova, 2022). This cell exhibits a distinct gene expression profile in the tumor microenvironment, including overexpression of complement system genes (C1QA, C1QB, C1QC, C3), and SPP1 in both mice and humans (Xiong, 2020; Khantakova, 2022). It is involved in phagocytosis, tissue repair, and modulation of immune responses (Coeho, 2021).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39369473\") oboInOwl:hasNarrowSynonym obo:CL_4047053 \"TREM-2 + resident macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35746551\") oboInOwl:hasNarrowSynonym obo:CL_4047053 \"TREM2+ macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28845904\") Annotation(oboInOwl:hasDbXref \"PMID:33681216\") Annotation(oboInOwl:hasDbXref \"PMID:34302064\") obo:IAO_0000115 obo:CL_4047054 \"A dendritic cell capable of capturing antigens in peripheral tissues and migrating through blood or lymphatic vessels to secondary lymphoid organs, where it presents processed antigens to T cells. It expresses MHC class II molecules and lacks lineage markers associated with other leukocyte populations, distinguishing it as a member of the dendritic cell lineage. This cell plays a pivotal role in initiating and regulating adaptive immune responses by linking peripheral antigen capture with T cell activation in lymphoid tissues.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15579435\") Annotation(oboInOwl:hasDbXref \"PMID:26273695\") Annotation(oboInOwl:hasDbXref \"PMID:28261592\") Annotation(oboInOwl:hasDbXref \"doi:10.1002/hep.25595\") Annotation(oboInOwl:hasDbXref \"doi:10.1152/ajpgi.00227.2012\") obo:IAO_0000115 obo:CL_4047056 \"A columnar, mucin-producing cholangiocyte that lines large bile ducts, including the hilar bile duct, right and left hepatic bile ducts, and large intrahepatic bile ducts. This cell expresses phosphorylated STAT3 and TFF-3 in humans and mice.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1152/ajpgi.00227.2012\") oboInOwl:hasNarrowSynonym obo:CL_4047056 \"mucin-secreting cholangiocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20018251\") Annotation(oboInOwl:hasDbXref \"doi:10.21203/rs.3.rs-3229780/v1\") obo:IAO_0000115 obo:CL_4047060 \"A circulating mononuclear phagocyte characterized by the expression of BCL-2-associated athanogene 3 (BAG3) protein, a co-chaperone involved in protein quality control and anti-apoptotic processes. (Fontanella, 2009). It undergoes cellular stress during the differentiation into M2 macrophages and is linked to poor survival rates in multiple cancer types. (Park, 2023)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.21203/rs.3.rs-3229780/v1\") oboInOwl:hasExactSynonym obo:CL_4047060 \"BAG3+ monocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26330348\") Annotation(oboInOwl:hasDbXref \"PMID:26639736\") Annotation(oboInOwl:hasDbXref \"PMID:27798170\") Annotation(oboInOwl:hasDbXref \"PMID:31114585\") Annotation(oboInOwl:hasDbXref \"PMID:32351704\") Annotation(oboInOwl:hasDbXref \"PMID:34230995\") Annotation(oboInOwl:hasDbXref \"PMID:35865550\") obo:IAO_0000115 obo:CL_4047101 \"A natural killer cell resident to the liver, located in the hepatic sinusoids. In humans this cell type is distinguished from circulating natural killer cells by CD49a or CD69 gene expression. Liver-resident natural killer cells have also been shown to express CCR5, EOMES, KLRB1, GZMK, and CXCR6 in humans.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31114585\") oboInOwl:hasExactSynonym obo:CL_4047101 \"he-NK\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fimmu.2019.00946\") oboInOwl:hasExactSynonym obo:CL_4047101 \"hepatic NK\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fimmu.2019.00946\") oboInOwl:hasExactSynonym obo:CL_4047101 \"hepatic natural killer cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33828559\") oboInOwl:hasExactSynonym obo:CL_4047101 \"intrahepatic NK\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26639736\") oboInOwl:hasExactSynonym obo:CL_4047101 \"liver NK cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26330348\") oboInOwl:hasExactSynonym obo:CL_4047101 \"liver resident natural killer cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047101 \"liver-specific natural killer cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35726345\") oboInOwl:hasExactSynonym obo:CL_4047101 \"lr-NK\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34230995\") rdfs:comment obo:CL_4047101 \"Liver-resident natural killer cells play a crucial role in modulating the immune response during inflammation by balancing cytotoxic activity and cytokine production, thereby contributing to the maintenance of liver homeostasis and protection against excessive tissue damage.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") obo:IAO_0000115 obo:CL_4052001 \"An ependymal cell that lines the lateral, third, and fourth ventricles of the brain. The cell is characterized by multiple motile cilia on its apical surface, which beats in a coordinated manner to facilitate the movement of cerebrospinal fluid (CSF), contributing to brain homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") oboInOwl:hasBroadSynonym obo:CL_4052001 \"multiciliated ependymal cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052001 \"E1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:27311928\") rdfs:comment obo:CL_4052001 \"multiciliated ependymal cell, with an average of 16 motile cilia per cell, exhibits two types of planar cell polarity (PCP): rotational polarity, with unidirectional cilia orientation, and translational polarity, with asymmetric cilia positioning in the apical area. This location-specific PCP varies across the ventricular wall, aligning with the direction of CSF flow. These cells are interconnected by adherens and gap junctions, which support intercellular communication and maintain the structural integrity of the ependymal layer. Unlike some other cell types, these cells lack tight junctions.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20851884\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Syncytium\") obo:IAO_0000115 obo:CL_4052002 \"A multinucleate cell formed by the fusion of multiple uninuclear cells through plasma membrane fusion. This process leads to a single large cell containing multiple nuclei within a shared cytoplasm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WBbt:0008074\") oboInOwl:hasExactSynonym obo:CL_4052002 \"syncytium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9067520\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052002 \"SC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:35810168\") Annotation(oboInOwl:hasDbXref \"PMID:38051275\") obo:IAO_0000115 obo:CL_4052003 \"A capillary endothelial cell that is part of the intestinal villus. This cell is highly fenestrated, with fenestrations most numerous at the villus tips, and plays a vital role in nutrient absorption and maintaining the selective permeability of the intestinal barrier.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35810168\") oboInOwl:hasBroadSynonym obo:CL_4052003 \"villus blood capillary endothelial cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38051275\") oboInOwl:hasRelatedSynonym obo:CL_4052003 \"villus tip endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052006 \"EEC Progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25670791\") rdfs:comment obo:CL_4052006 \"The EEC progenitor is also present in other organisms; for example, flies have EEC progenitors but lack intestinal crypts and do not express the same markers. Instead, they are Dl+ and Pros+.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052008 \"CBFs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052009 \"CTFs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_4052010 \"A stromal cell that serves as a precursor to the theca cell layers in the ovary growing follicles. This cell is present in the early stages of follicular growth, particularly in smaller follicles. Unlike mature theca cell, a pre-theca cell is initially non-steroidogenic and lacks luteinizing hormone receptors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052010 \"early theca cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") oboInOwl:hasExactSynonym obo:CL_4052010 \"progenitor theca cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29339448\") Annotation(oboInOwl:hasDbXref \"PMID:34634036\") Annotation(oboInOwl:hasDbXref \"PMID:7107724\") obo:IAO_0000115 obo:CL_4052011 \"An enterocyte found in the follicle-associated epithelium (FAE) that covers Peyer's patches and other mucosa-associated lymphoid tissues. This cell has reduced absorptive capacity and expresses higher levels of chemokines CCL20 and CXCL16, compared to regular villus enterocytes. It contributes to antigen sampling and immune interactions, supporting the specialized function of the FAE in mucosal immunity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasExactSynonym obo:CL_4052011 \"follicle-associated epithelium enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052011 \"FAE enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasRelatedSynonym obo:CL_4052011 \"follicular enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_interna\") obo:IAO_0000115 obo:CL_4052012 \"A specialized theca cell that forms the inner, highly vascularized layer of the theca surrounding ovarian follicles. Originating from progenitor theca cells, the theca interna cell is steroidogenic, playing a crucial role in the production of androgens, which serves as a precursor for estrogen synthesis in granulosa cells. This cell expresses luteinizing hormone receptors, enabling it to respond to hormonal signals that regulate steroidogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"androgenic theca cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"inTC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"interna TC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"steroidogenic theca interna cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"exTC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"externa TC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052013 \"structural theca cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:27124642\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") Annotation(oboInOwl:hasDbXref \"PMID:33200981\") obo:IAO_0000115 obo:CL_4052014 \"A capillary endothelial cell that is part of islet of Langerhans, characterized by a high density of fenestrations —approximately ten times greater than those in exocrine pancreatic capillaries. These fenestrations facilitate efficient hormone exchange, which is essential for maintaining glucose homeostasis. The cell's structure and function are regulated by the local production of vascular endothelial growth factor-A (VEGF-A), which maintains its fenestrated architecture.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"islet endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"pancreatic islet endothelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") obo:IAO_0000115 obo:CL_4052015 \"Any capillary endothelial cell that is part of an endocrine gland.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10810312\") Annotation(oboInOwl:hasDbXref \"PMID:32910242\") obo:IAO_0000115 obo:CL_4052016 \"A capillary endothelial cell that is part of the pituitary gland. This cell is characterized by its fenestrated structure which facilitates the efficient transport of hormones and other signaling molecules, essential for endocrine signalling.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:4899902\") rdfs:comment obo:CL_4052016 \"In the anterior pituitary gland of rats, capillary endothelial cells are distinguished by numerous fenestrations, which are covered by a single-layered diaphragm. The diaphragm features a dense ring-like structure.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:32375819\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK27998/\") obo:IAO_0000115 obo:CL_4052017 \"A capillary endothelial cell that is part of the choroid plexus, characterized by its fenestrated nature with 60 to 80 nm fenestrations and lack of tight junctions. This fenestrated structure allows for the rapid delivery of water and other components, aiding in the production of cerebrospinal fluid (CSF).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasBroadSynonym obo:CL_4052018 \"oviduct epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasExactSynonym obo:CL_4052018 \"uterine tube epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052019 \"fallopian tube non-ciliated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") obo:IAO_0000115 obo:CL_4052020 \"A granzyme K-associated CD8 T cell that resides in the lung, characterized by the expression of granzyme K (GZMK), and tissue residency markers CD103 and CD49a. This cell exhibits cytotoxic potential through its expression of multiple granzymes (GZMA, GZMB, GZMH, GZMM) in addition to GZMK.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052020 \"lung resident CD8-GZMK\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28322863\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") rdfs:comment obo:CL_4052020 \"Lung resident granzyme K-associated CD8 T cell represents an intermediate stage of T cell differentiation, with GZMK expression peaking during this phase.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasDbXref \"PMID:37449888\") obo:IAO_0000115 obo:CL_4052021 \"A CD8 T cell characterized by high expression of Granzyme K (GZMK). This cell is enriched in both inflamed tissues, such as synovial tissue in rheumatoid arthritis and respiratory tissues during COVID-19, as well as non-inflamed tissues like the gut and kidneys. Unlike highly cytotoxic GZMB+ CD8+ T cell, GZMK+ CD8+ T cell exhibits lower direct cytotoxic potential, and is involved in producing pro-inflammatory cytokines such as IFN-γ and TNF-α.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"granzyme K+ CD8 T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"tissue-enriched expressing GzmK CD8 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36347862\") oboInOwl:hasNarrowSynonym obo:CL_4052021 \"GZMK high CD8+ T effector memory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"CD8-GZMK cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"TteK CD8 cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31183831\") Annotation(oboInOwl:hasDbXref \"PMID:31613440\") obo:IAO_0000115 obo:CL_4052022 \"A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasBroadSynonym obo:CL_4052022 \"oviduct smooth muscle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasExactSynonym obo:CL_4052022 \"uterine tube smooth muscle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18621753\") rdfs:comment obo:CL_4052022 \"The fallopian tube smooth muscle cell in the human contracts dynamically in response to hormones and signaling molecules. Prostaglandins, particularly PGF2α and PGE2, have been shown to increase muscular contractions, while progesterone, levonorgestrel, mifepristone, oxytocin, and human chorionic gonadotropin (hCG) decrease them. These contractile responses are crucial for regulating gamete and embryo transport through the fallopian tube.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32929266\") Annotation(oboInOwl:hasDbXref \"PMID:36581776\") Annotation(oboInOwl:hasDbXref \"PMID:38559249\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052023 \"An epithelial cell that is part of the endometrial luminal epithelium, forming a continuous layer lining the uterine cavity. This cell undergoes cyclical changes during the menstrual cycle, proliferating under estrogen in the proliferative phase, and differentiating under progesterone in the secretory phase to prepare for potential implantation. During the window of implantation, this cell changes from a tall columnar shape to a shorter columnar or cuboidal form, loses polarity, and becomes receptive to blastocyst implantation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") rdfs:comment obo:CL_4052023 \"The luminal endometrial unciliated epithelial cell expresses WNT7A, and LGR5 during the proliferative phase, transitioning to express VTCN1 and SULT1E1 in the early secretory phase, and LEFTY1, IL6, and PTGS1 in the mid- to late-secretory phases.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasDbXref \"PMID:38398025\") obo:IAO_0000115 obo:CL_4052024 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction myonuclei\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction nuclei\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052024 \"MTJ nucleus\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33037211\") Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") obo:IAO_0000115 obo:CL_4052025 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction myonuclei\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction nuclei\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052025 \"NMJ nuclues\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") Annotation(oboInOwl:hasDbXref \"PMID:35908794\") Annotation(oboInOwl:hasDbXref \"PMID:36361732\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") obo:IAO_0000115 obo:CL_4052026 \"A fast type II muscle cell that is part of the skeletal muscle tissue. This cell is characterized by its intermediate metabolic profile, utilizing both glycolytic and oxidative pathways for energy production. In humans, it is distinguished by the expression of myosin heavy chain 1 (MYH1).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x fiber\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle fiber\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type IIx muscle fiber\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199166\") Annotation(oboInOwl:hasDbXref \"PMID:34727990\") rdfs:comment obo:CL_4052026 \"In humans, type IIx fiber contains high levels of MYLK2, enhancing contraction speed and force via myosin phosphorylation, especially under low calcium. This mechanism supports post-activation potentiation, increasing force output in fast-twitch muscles. Additionally, this fiber has abundant ACTN3 (α-actinin-3), linked to muscle power, and exhibits the highest shortening velocity among human muscle fiber types. Notably, type IIx fiber is selectively lost in aging-related sarcopenia, increases in proportion in type 2 diabetes and obesity, and is the first to degenerate in Duchenne Muscular Dystrophy, impacting muscle function across various conditions.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4052027 \"A theca cell undergoing atresia, characterized by distinct morphological changes including hypertrophy, altered cell shape, and disrupted layered organization. This cell exhibits reduced steroidogenic capacity and changes in surrounding vascularization. The onset of theca cell atresia can vary, occurring at different stages of follicle atresia depending on the phase of folliculogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") rdfs:comment obo:CL_4052027 \"During atresia, theca interna and externa cells undergo distinct morphological and functional changes. Theca interna cells round up, expand in cytoplasmic area, and thicken the internal layer as organization degrades, while showing reduced STAR expression, which lowers androgen production. Theca externa cells display decreased ACTA2 expression, weakening structural integrity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Uterine_natural_killer_cells\") obo:IAO_0000115 obo:CL_4052028 \"A natural killer cell that is part of the uterus, specifically within the endometrium during the non-pregnant state and in the decidua during pregnancy. This cell exhibits dynamic changes in frequency throughout the menstrual cycle, with lower levels during menstruation and a significant increase during the mid-secretory phase and early pregnancy.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") oboInOwl:hasNarrowSynonym obo:CL_4052028 \"endometrial natural killer cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052028 \"uNK cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") obo:IAO_0000115 obo:CL_4052031 \"A secretory epithelial cell of the respiratory and terminal bronchioles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36796082\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052031 \"RAS cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355018\") oboInOwl:hasRelatedSynonym obo:CL_4052031 \"terminal and respiratory bronchioles secretory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") rdfs:comment obo:CL_4052031 \"The respiratory airway secretory cell is cuboidal and has a unique transcriptomic profile compared to other epithelial cells in the same region. In humans, it functions as a multipotent progenitor, capable of regenerating alveolar type 2 (AT2) cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") obo:IAO_0000115 obo:CL_4052032 \"A CD8 T cell characterized by high expression of Granzyme H (GZMH). This cell exhibits a restricted TCR repertoire and elevated expression of cytotoxic, exhaustion, and type I interferon-stimulated gene signatures compared to controls.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") oboInOwl:hasExactSynonym obo:CL_4052032 \"granzyme H+ CD8 T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052032 \"GZMH+ CD8+ T cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") rdfs:comment obo:CL_4052032 \"This cell type is significantly expanded in systemic lupus erythematosus (SLE) patients. Unlike other CD8 T cell populations, GZMH+ CD8 T cells can comprise up to 50% of all lymphocytes in some SLE patients.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") Annotation(oboInOwl:hasDbXref \"PMID:37863104\") obo:IAO_0000115 obo:CL_4052033 \"A tuft cell that is part of the extrahepatic biliary tree, including the gallbladder and extrahepatic bile ducts. It shares a core genetic program with intestinal tuft cells but has unique tissue-specific genes. Biliary tuft cell functions as a bile acid-sensitive regulator, suppressing inflammation and modulating microbiome-dependent neutrophil infiltration in biliary tissues. Unlike its intestinal counterparts, this cell decreases in number postnatally as bile acid production matures, with its abundance negatively regulated by bile acids.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") oboInOwl:hasExactSynonym obo:CL_4052033 \"gallbladder/extrahepatic bile duct tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:35668088\") Annotation(oboInOwl:hasDbXref \"PMID:36351364\") Annotation(oboInOwl:hasDbXref \"PMID:36961668\") obo:IAO_0000115 obo:CL_4052034 \"A tuft cell that is part of the medullary epithelium of the thymus, characterized by lateral microvilli and specific markers, including L1CAM in both mice (Zhang et al., 2022) and humans (Sun et al., 2023), as well as MHC II in mice (Miller et al., 2018). This cell is pivotal in immune functions such as antigen presentation, central tolerance, and type 2 immunity. A tuft cell in the thymus exhibits characteristics of both a medullary thymic epithelial cell (mTEC) and a peripheral tuft cell. Its development is governed by transcription factors such as POU2F3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") oboInOwl:hasExactSynonym obo:CL_4052034 \"thymic tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") rdfs:comment obo:CL_4052034 \"A thymic tuft cell is a subset of terminally differentiated medullary thymic epithelial cell comprising 5-10% of total mTECs. Lineage-tracing studies indicate that this cell arises from mature MHCII mTECs, with development occurring through both Aire-dependent and Aire-independent pathways. However, its exact origins remain unclear.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:32717220\") obo:IAO_0000115 obo:CL_4052035 \"A tuft cell that is part of the epithelium of pancreatic duct. Present in humans and rats, this cell is absent in the murine pancreas under normal conditions but emerges during acinar-to-ductal metaplasia triggered by injury, inflammation, or oncogenic mutations. It modulates the immune response and protects against pancreatic ductal adenocarcinoma progression by producing suppressive eicosanoids, such as prostaglandin D2. A tuft cell in the pancreatic duct highly expresses the transcription factor POU2F3, which is essential for its development and presence.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9749964\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic brush cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32717220\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052036 \"A tuft cell that is part of the nasal cavity epithelium, located in both the respiratory and olfactory epithelia of the nose. This cell plays key roles in chemosensation, lipid mediator production, immune responses, and epithelial homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34692913\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal brush cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") obo:IAO_0000115 obo:CL_4052037 \"A tuft cell that is part of the olfactory epithelium, characterized by a globular body and the expression of neurogranin (Nrgn) in mice. This cell plays a crucial role in allergen recognition and regulating olfactory stem cell proliferation via TRPM5-dependent ATP sensing and cysteinyl leukotriene production. Unlike nasal respiratory tuft cells, it has low to absent expression of taste receptors, including the G protein Gα gustducin, and rarely contacts olfactory sensory neurons directly.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052037 \"olfactory tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TPRM5+ tuft-MVC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"tuft-microvillous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"Gɑ-gustducin high respiratory tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"nasal respiratory solitary chemosensory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"tuft-solitary chemosensory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:38117182\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.02.16.480779\") obo:IAO_0000115 obo:CL_4052040 \"A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38117182\") oboInOwl:hasExactSynonym obo:CL_4052040 \"gastric tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral brush cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral cholinergic chemosensory cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic interstitial stromal cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic stromal cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasRelatedSynonym obo:CL_4052045 \"Enpp2− interstitial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052046 \"A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052046 \"active corpus luteum cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31803139\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052047 \"A luteal cell that is part of the older, regressing corpus luteum. This cell exhibits increased expression of genes involved in progesterone metabolism - Akr1c18 in mice (Lan et al., 2024), cell cycle arrest, and apoptosis. A late luteal cell contributes to corpus luteum regression and eventual clearance from the ovary through luteolysis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052047 \"regressing corpus luteum cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasBroadSynonym obo:CL_4052048 \"intercalated duct cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35799078\") oboInOwl:hasRelatedSynonym obo:CL_4052048 \"Id cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"SD cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36273006\") obo:IAO_0000115 obo:CL_4052050 \"An epithelial cell that is part of an endometrium luminal epithelium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31317179\") oboInOwl:hasExactSynonym obo:CL_4052050 \"endometrial luminal epithelial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34512661\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052051 \"​​A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018). It expresses the uterine resident marker CD49a and is distinguished from uNK2 and uNK3 by CD39 expression and the absence of CD103 (Whettlock et al., 2022) and CD160 (Marečková et al., 2024). It also expresses higher levels of killer-cell immunoglobulin-like receptors (KIRs) and leukocyte immunoglobulin-like receptor B1 (LILRB1), which facilitate interaction with human leukocyte antigens (HLAs) on extravillous trophoblast cells, promoting immune tolerance and implantation. Enriched in the endometrium post-ovulation (Marečková et al., 2024) and prominent in early pregnancy (Whettlock et al., 2022), uNK1 regulates trophoblast invasion and spiral artery remodeling (Zhang & Wei, 2021).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052051 \"decidual natural killer cell 1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052051 \"uNK1\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NKT cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T-lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_4052058 \"A Merkel cell found mainly in the basal layer of the epidermis and the outer root sheath of hair follicles, particularly concentrated in areas with high tactile acuity, such as touch domes, hair follicles, and fingertips.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6207057\") oboInOwl:hasExactSynonym obo:CL_4052058 \"epdiermal Merkel cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34283481\") Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") obo:IAO_0000115 obo:CL_4052060 \"A differentiating keratinocyte found in the epidermis and oral epithelium, located in the stratum spinosum, characterized by a spiny appearance due to abundant intercellular desmosomal junctions.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_4052060 \"prickle cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052061 \"keratincyte of epidermis\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39185948\") oboInOwl:hasExactSynonym obo:CL_4052061 \"skin keratinocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") rdfs:comment obo:CL_4052061 \"Keratinocytes are reportedly CDw210a(IL-10RA)-negative , CDw210b(IL-10RB)-positive, IL22Ra1-positive, Human keratinocytes are reportedly capable of secreting BD-2, BD-3, hCAP-18, CXCL1, CXCL5, CXCL8, elafin, MMP-3, NGAL, PDGF-A, S100A7, S100A8, and S100A9. Transcription factors: STAT3-positive.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10651700\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:33799809\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052063 \"A keratinocyte that resides in the nail bed, responsible for tightly attaching the nail plate to the underlying dermis. Unlike typical epidermal keratinocytes, it exhibits limited proliferation, undergoes modified differentiation that skips the granular layer and conventional cornification, and primarily ensures adhesion and maintenance of the nail plate. In humans, this cell expresses characteristic markers, including the protease inhibitor SPINK6 and the differentiation-associated protein KRT16.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39044464\") oboInOwl:hasExactSynonym obo:CL_4052064 \"nail matrix epithelial keratinocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_4052070 \"unclassified fallopian tube progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20839340\") Annotation(oboInOwl:hasDbXref \"PMID:32741082\") Annotation(oboInOwl:hasDbXref \"PMID:36617261\") Annotation(oboInOwl:hasDbXref \"PMID:37254600\") obo:IAO_0000115 obo:CL_4052108 \"A class switched memory B cell that lacks IgD on the cell surface.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070010 \"A motor neuron that moves the medial tooth forward\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070010 \"GM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070011 \"A motor neuron that closes the lateral teeth.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070011 \"LG\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070012 \"A motor neuron that controls ventral stomach grooves leading to pyloric filter.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070012 \"IC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070013 \"A motor neuron that controls  ventral stomach grooves leading to pyloric filter.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070013 \"VD\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070014 \"A motor neuron that controls pyloric filter movements; innervates the pyloric muscle.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070014 \"PY\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070015 \"A motor neuron that controls the cardiopyloric valve.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070015 \"PD\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070016 \"Pyloric pacemaker neuron that provides feedback to commissural ganglia (CoG) neurons.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070016 \"AB\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070017 \"A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:3107759\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") obo:IAO_0000115 obo:CL_4072007 \"A type of dopaminergic neuron found in the ventral tegmental area that is involved in reward processes, motivation and addiction.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3107759\") oboInOwl:hasExactSynonym obo:CL_4072007 \"A10 VTA Dopaminergic Neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25343491\") Annotation(oboInOwl:hasDbXref \"PMID:37522391\") Annotation(oboInOwl:hasDbXref \"PMID:8978475\") obo:IAO_0000115 obo:CL_4072008 \"A type of hypothalamic dopaminergic neuron found in the posterior hypothalamus, projecting to the spinal cord where it modulates pain, motor activity (Koblinger et al., 2014), and somatosensory processing (Zhang et a., 2023).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39919032\") obo:IAO_0000115 obo:CL_4072009 \"A type of dopaminergic neuron found in the arcuate hypothalamic nucleus, involved in neuroendocrine regulation, metabolic homeostasis and prolactin secretion.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39919032\") oboInOwl:hasExactSynonym obo:CL_4072009 \"hypothalamic arcuate nucleus dopaminergic neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33318433\") Annotation(oboInOwl:hasDbXref \"PMID:37816347\") obo:IAO_0000115 obo:CL_4072010 \"A type of dopaminergic neuron located in the rostro-medial part of the zona incerta. It is involved in nociception and prehensile movement.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10465451\") Annotation(oboInOwl:hasDbXref \"PMID:19210380\") Annotation(oboInOwl:hasDbXref \"PMID:33257725\") Annotation(oboInOwl:hasDbXref \"PMID:36209152\") obo:IAO_0000115 obo:CL_4072011 \"A type of dopaminergic neuron located in the periventricular nucleus of the hypothalamus and projecting to the lateral septum and the median eminence. It is contributing to neuroendocrine functions, locomotion and stress regulation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26132331\") Annotation(oboInOwl:hasDbXref \"PMID:36209152\") obo:IAO_0000115 obo:CL_4072012 \"A type of dopaminergic neuron located in the preoptic periventricular nucleus of the hypothalamus and implicated in neuroendocrine modulation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28261065\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2023.08.29.554772\") obo:IAO_0000115 obo:CL_4072013 \"A type of dopaminergic interneuron located in the glomerular layer of the main olfactory bulb, characterized by the co-release of dopamine and GABA, and involved in modulating sensory input within olfactory circuits.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") Annotation(oboInOwl:hasDbXref \"PMID:26017494\") obo:IAO_0000115 obo:CL_4072014 \"A specialized, non-ciliated ependymal glial cell located in the ventricular wall of the organum vasculosum of the lamina terminalis (OVLT) and characterized by elongated basal processes extending into the parenchyma to contact fenestrated capillaries. In mice, it is characterised by the expression of tight junction proteins (claudin 1, occludin, ZO-1) forming a continuous honeycomb junctional pattern. This cell contributes to a functional blood–cerebrospinal fluid (CSF) barrier at the ventricular interface of the OVLT.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") oboInOwl:hasBroadSynonym obo:CL_4072014 \"Tanycyte-like cells in CVOs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like cell of OVLT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like ependymal cell of OVLT\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26813785\") Annotation(oboInOwl:hasDbXref \"PMID:31561945\") Annotation(oboInOwl:hasDbXref \"PMID:37740916\") obo:IAO_0000115 obo:CL_4072015 \"A Kupffer cell located within the hepatic sinusoids, derived from circulating bone marrow monocytes that acquire the phenotypic markers and functional properties of resident Kupffer cells through niche-dependent imprinting, typically following depletion of the embryonically derived Kupffer cell population. During liver injury, MoKCs become the dominant Kupffer cell subset, exhibiting enhanced proliferation, resistance to apoptosis, and key roles in tissue repair and fibrosis attenuation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37740916\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072015 \"MoKC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") Annotation(oboInOwl:hasDbXref \"PMID:32376782\") obo:IAO_0000115 obo:CL_4072016 \"An interneuron that expresses neuropeptide Y (NPY) and is mainly located in cortical layers II–III and VI, as well as in various brain regions such as the medial geniculate and inferior colliculus. The NPY cell population is physiologically diverse, displaying a range of firing behaviors, including adapting, fast-spiking, and accelerating patterns.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32376782\") oboInOwl:hasExactSynonym obo:CL_4072016 \"NPY-expressing neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") oboInOwl:hasRelatedSynonym obo:CL_4072016 \"NPY-expressing neocortical interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34469623\") Annotation(oboInOwl:hasDbXref \"PMID:37957320\") Annotation(oboInOwl:hasDbXref \"PMID:39719709\") obo:IAO_0000115 obo:CL_4072017 \"A GABAergic neuron located in the arcuate nucleus of the hypothalamus that expresses agouti-related protein (AgRP). This neuron can coexpress AgRP, GABA, and neuropeptide Y (NPY) in mice, and plays a key role in integrating metabolic signals. It is activated by hunger-related hormones such as ghrelin and inhibited by satiety signals like leptin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39719709\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072017 \"AgRP neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31982322\") Annotation(oboInOwl:hasDbXref \"PMID:39303139\") obo:IAO_0000115 obo:CL_4072018 \"A neuron that generates rhythmic bursts of action potentials independently of synaptic input. This intrinsic property enables it to maintain oscillatory activity even when isolated from other neurons. It populates the brainstem, hypothalamus, basal ganglia, spinal cord, and cerebellum. It plays a crucial role in regulating circadian rhythms in the suprachiasmatic nucleus, generating respiratory rhythms in the preBötzinger complex, and synchronizing neural networks.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") Annotation(oboInOwl:hasDbXref \"PMID:32066983\") obo:IAO_0000115 obo:CL_4072019 \"A type of neuron located in the suprachiasmatic nucleus (SCN) that possesses intrinsic circadian rhythmicity, characterized by strong and rhythmic expression of core clock genes and the ability to independently generate and sustain circadian oscillations. In mice, the specific subtypes Avp+/Nms+, Vip+/Nms+, and Cck+/C1ql3+ neurons have the most robust circadian gene expression and contribute to synchronizing and maintaining rhythmicity within the SCN network (Wen et al., 2020).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") oboInOwl:hasExactSynonym obo:CL_4072019 \"pacemaker neuron of the suprachiasmatic nucleus\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasDbXref \"PMID:2785663\") Annotation(oboInOwl:hasDbXref \"PMID:28790896\") Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasDbXref \"PMID:9662138\") obo:IAO_0000115 obo:CL_4072021 \"A specialised type of interneuron defined by the secretion of corticotropin-releasing hormone (CRH), a key peptide in activating the hypothalamic–pituitary–adrenal (HPA) axis during stress. It is primarily located in the paraventricular nucleus (PVN) of the hypothalamus, with additional presence in the hippocampus, piriform area, central amygdalar nucleus, Barrington’s nucleus, and inferior olivary complex (Peng et al., 2017).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRF neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRH neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"PMID:38712198\") obo:IAO_0000115 obo:CL_4072022 \"A Lamp5 Lhx6 GABAergic interneuron of Homo sapiens. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', Lamp5 Lhx6\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072022 \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") rdfs:comment obo:CL_4072022 \"Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://zenodo.org/records/11165918\") rdfs:comment obo:CL_4072022 \"The marker set CHST9, LAMP5 can identify the Human cell type Lamp5 Lhx6 neuron in the neocortex with a confidence of 0.821678322 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072027 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst). The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Sst.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072027 \"ILX:0770152\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SOM+ inhibitory interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SST+ IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"somatostatin-expressing inhibitory interneuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072027 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072027 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072029 \"A transcriptomically distinct GABAergic interneuron with a soma located in a cerebral cortex and it expresses Parvalbumin. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Pvalb.\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4072031 \"long-range GABAergic interneuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072031 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072031 \"The marker set NPY can identify the Human cell type sst chodl GABAergic interneuron in the neocortex with a confidence of 0.894026187 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072032 \"A transcriptomically distinct GABAergic neuron that expresses the vasoactive intestinal polypeptide and that has its soma located in the forebrain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Vip.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:31210267\") Annotation(oboInOwl:hasDbXref \"PMID:33794534\") Annotation(oboInOwl:hasDbXref \"PMID:35221922\") terms:description obo:CL_4072032 \"This neuronal type is distinguished by its heterogeneous morphology and electrophysiological characteristics  (Pronneke et al., 2015,2020; Apicella and Marchionni, 2022). Variations in morphology and firing patterns are observed in human VIP interneurons. In a study by Lee et al., 2023, four distinct subtypes of VIP neurons were identified, each exhibiting unique morphologies, soma locations, and electrophysiological properties. These subtypes are defined according to their transcriptomic markers: LBH-VIP and CCD184-VIP, both of which display a bipolar morphology with axons and dendrites extending across cortical layers; and SY16-VIP and ADAMTSL1-VIP, characterized by a dendritic arbor that spreads horizontally within the same layer as the soma (Lee et al., 2023). Disruption or malfunction of VIP interneuron is implicated in neurodevelopmental disorders such as Rett Syndrome and Dravet Syndrome (Goff and Goldberg 2021).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072032 \"ILX:0770151\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP type (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP-IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"Vip (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072032 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072032 \"The marker set VIP can identify the Human cell type VIP GABAergic interneuron in the neocortex with a confidence of 0.855531344 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072034 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Lamp5.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072034 \"ILX:0770149\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072034 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072034 \"The marker set LINC00298, KIT can identify the Human cell type lamp5 GABAergic interneuron in the neocortex with a confidence of 0.814687838 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072035 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sncg.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072035 \"ILX:0770150\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072035 \"The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072036 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses the transcript PAX6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters PAX\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072036 \"The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072037 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L2/3 IT.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072037 \"ILX:0770156\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072037 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072037 \"The marker set ONECUT2, COL5A2 can identify the Human cell type L2/3 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.670149932 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072038 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L5 IT.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072038 \"ILX:0770157\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072038 \"L5 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072038 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072039 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L4 IT.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072039 \"L4 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072039 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072039 \"The marker set RORB, ST8SIA4 can identify the Human cell type L4 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.720108696 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072040 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_cluster', L6 IT Car3.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4072040 \"L6 IT Car3 glutamatergic neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 cell (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072040 \"The marker set SMYD1, THEMIS can identify the Human cell type L6 intratelencephalic projecting Car3 glutamatergic neuron in the neocortex with a confidence of 0.877752028 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072041 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.  The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L6 IT.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072041 \"ILX:0770158\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072041 \"L6 IT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072041 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072042 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L6 CT.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4072044 \"L6 CT (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072044 \"The marker set SEMA5B, ADAMTSL1, SULF1 can identify the Human cell type L6 corticothalamic-projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.631898455 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072045 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neuron', Author Categories: 'CrossArea_subclass', cluster L6b.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072045 \"ILX:0770163\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072046 \"A transcriptomically definined GABAergic interneuron of the human pallium.  These cells correspond to the classically defined pvalb chandelier neuron type. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Chandelier.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072046 \"ILX:0107356\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"Chandelier PV (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"chandelier pvalb GABAergic interneuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072046 \"The marker set GPR149, CA8 can identify the Human cell type chandelier pvalb GABAergic cortical interneuron in the neocortex with a confidence of 0.799748111 (NS-Forest FBeta value).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") obo:IAO_0000115 obo:CL_4072102 \"A type of GABAergic interneuron residing in the Purkinje cell layer of the cerebellar cortex.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072102 \"PLI\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasDbXref \"PMID:29691589\") Annotation(oboInOwl:hasDbXref \"PMID:35036581\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_4072103 \"A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle's mesenchymal compartments.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_4072103 \"2025-11-05T11:49:53Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38016881\") oboInOwl:hasNarrowSynonym obo:CL_4072103 \"dermal sheath cup cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072103 \"hfDSC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_7770002 \"2025-01-29T08:52:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_7770002 \"JCT cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27443500\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770003 \"A beam cell within the eye's trabecular meshwork, molecularly distinguished by FABP4 expression in humans and spatially intermingled with Beam B cells throughout the uveal and corneoscleral meshwork regions. In mice, a transcriptionally analogous Beam A–like cluster (mC14) exists, sharing core TM markers (Myoc, Mgp, Pdpn, Chil1) and functional attributes.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_7770003 \"2025-08-29T08:53:47Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770003 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17020902\") Annotation(oboInOwl:hasDbXref \"PMID:30837987\") Annotation(oboInOwl:hasDbXref \"PMID:32187560\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"PMID:37672481\") obo:IAO_0000115 obo:CL_7770004 \"An epithelial cell that resides in the layer(s) immediately above the basal layer in stratified or pseudostratified epithelia. This cell mainly originates from basal cells and is found across various tissues, including skin, esophagus, oral mucosa, airway, and cornea.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:27443500\") obo:IAO_0000115 obo:CL_7770005 \"A trabecular meshwork cell that is part of the eye's trabecular meshwork, residing in the uveal and corneoscleral meshwork regions and serving as the primary biological filter in the aqueous humor drainage cascade. This cell exhibits endothelial-like properties, including production of antithrombogenic substances such as tissue plasminogen activator, while also demonstrating phagocytic activity to remove cellular debris from aqueous humour before the fluid moves deeper into the less porous juxtacanalicular tissue.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_7770005 \"2025-09-12T11:19:45Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770005 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_7770005 obo:CL_0002367)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770006 \"A trabecular meshwork cell within the eye's trabecular meshwork. This cell is molecularly distinguished by TMEFF2 expression in humans. A beam B cell is spatially intermingled with beam A cells throughout the uveal and corneoscleral meshwork regions, but demonstrates a tendency to localise closer to the juxtacanalicular tissue.\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\nSubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742)) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000031))\n","exit_code":0,"status":"completed"}}
