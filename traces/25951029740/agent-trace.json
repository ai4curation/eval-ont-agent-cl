nAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000063 \"Any fibroblast that is part of a female gonad.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000063 \"2014-10-07T17:57:42Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000063 \"CL:2000063\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:12052228\") Annotation(oboInOwl:hasDbXref \"PMID:15749958\") Annotation(oboInOwl:hasDbXref \"PMID:23467088\") Annotation(oboInOwl:hasDbXref \"PMID:31672973\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_2000064 \"A meso-epithelial cell of the ovarian surface epithelium, varying in shape from flat to cuboidal to pseudostratified columnar. This cell plays a crucial role in ovulation by producing proteolytic enzymes in response to gonadotropins, facilitating follicle rupture through tissue breakdown and TNF-alpha signaling. Additionally, this cell contributes to post-ovulatory wound repair (Morris et al., 2022) and exhibits stem cell-like properties (Flesken-Nikitin et al., 2013; Wang et al., 2019).\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000064 \"2014-10-07T17:59:13Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000064 \"CL:2000064\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000065 \"Any microvascular endothelial cell that is part of a female urethra.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000065 \"2014-10-07T18:18:01Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000065 \"CL:2000065\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000066 \"Any fibroblast that is part of a cardiac ventricle.\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_2000066 \"2014-10-07T18:35:38Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_2000066 \"CL:2000066\")\nAnnotationAssertion(Annotat