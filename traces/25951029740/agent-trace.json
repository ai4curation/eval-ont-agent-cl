ym obo:CL_0000228 \"multinucleated cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Multinucleate\") oboInOwl:hasExactSynonym obo:CL_0000228 \"polynuclear cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D004912\") obo:IAO_0000115 obo:CL_0000232 \"A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000232 \"BTO:0000424\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000232 \"CALOHA:TS-0290\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000232 \"FMA:81100\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000232 \"RBC\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000232 \"red blood cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000232 obo:CL_0000764)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D001792\") Annotation(oboInOwl:hasDbXref \"PMID:11110672\") Annotation(oboInOwl:hasDbXref \"PMID:16987572\") Annotation(oboInOwl:hasDbXref \"PMID:17204662\") Annotation(oboInOwl:hasDbXref \"PMID:17479180\") Annotation(oboInOwl:hasDbXref \"PMID:20414831\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Platelet\") obo:IAO_0000115 obo:CL_0000233 \"A non-nucleated disk-shaped cell formed by extrusion from megakaryocytes, found in the blood of all mammals, and mainly involved in blood coagulation.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000233 \"BTO:0000132\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000233 \"CALOHA:TS-0803\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000233 \"FMA:62851\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000233 \"anucleate thrombocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000233 \"blood platelet\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000233 \"enucleate thrombocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000233 obo:CL_0000763)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000234 \"Any cell capable of ingesting particulate matter via phagocytosis.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000234 \"BTO:0001044\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000234 \"FMA:83806\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000234 \"MESH:D010586\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16213494\") Annotation(oboInOwl:hasDbXref \"PMID:1919437\") obo:IAO_0000115 obo:CL_0000235 \"A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000235 \"BTO:0000801\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000235 \"CALOHA:TS-0587\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000235 \"FMA:63261\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000235 \"FMA:83585\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000235 \"MESH:D008264\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000235 \"histiocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000235 obo:CL_0000766)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000236 \"A lymphocyte of B lineage that is capable of B cell mediated immunity.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000236 \"BTO:0000776\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000236 \"CALOHA:TS-0068\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000236 \"FMA:62869\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000236 \"MESH:D001402\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000236 \"VHOG:0001480\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000236 \"B lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000236 \"B-cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000236 \"B-lymphocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000236 obo:CL_0000945)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000239 <https://doi.org/10.1152/ajpgi.00005.2011>)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000239 \"PMID:25422372\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_squamous_epithelium\") obo:IAO_0000115 obo:CL_0000240 \"A stratified epithelial cell that is part of squamous epithelium, characterized by multiple layers of cells. The basal layer is directly attached to the basement membrane and the apical layer consists of flattened squamous cells. This provides a protective barrier, commonly found in areas subject to abrasion, such as the skin, oral cavity, and esophagus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_cuboidal_epithelium\") obo:IAO_0000115 obo:CL_0000241 \"A stratified epithelial cell that is part of cuboidal epithelium, characterized by multiple layers of cuboidal cells forming the apical layer. This provides a protective lining for ducts in large glands, such as sweat glands.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018862\") Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:24862916\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_0000242 \"A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000242 \"FMA:70548\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000242 \"Merkel's cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24862916\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000242 \"MC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009457\") obo:IAO_0000115 obo:CL_0000243 \"A non-neuronal cell of the nervous system. They not only provide physical support, but also respond to injury, regulate the ionic and chemical composition of the extracellular milieu. Form the myelin insulation of nervous pathways, guide neuronal migration during development, and exchange metabolites with neurons. Neuroglia have high-affinity transmitter uptake systems, voltage-dependent and transmitter-gated ion channels, and can release transmitters, but their role in signaling (as in many other functions) is unclear.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000244 \"A cell characteristically found lining hollow organs that are subject to great mechanical change due to contraction and distention; originally thought to represent a transition between stratified squamous and columnar epithelium.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000244 \"FMA:66778\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000245 \"Obsolete. Use PO:0000353 from Plant Ontology instead. Cell in exodermis or endodermis that remains thin walled when the associated cells develop thick secondary walls. Has casparian strip in endodermis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"VHOG:0001484\") obo:IAO_0000115 obo:CL_0000247 \"Type of neuron that is a primary mechanosensory cell, with peripheral neurites innervating the skin with free nerve endings.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000247 \"AAO:0010316\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000247 \"EFO:0003711\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000247 \"VHOG:0001484\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000247 \"ZFA:0009150\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"VHOG:0001484\") oboInOwl:hasExactSynonym obo:CL_0000247 \"Rohon Beard cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000247 \"Rohon-Beard cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"VHOG:0001484\") oboInOwl:hasRelatedSynonym obo:CL_0000247 \"RB neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000248 \"Obsolete. Use PO:0020047 from Plant Ontology instead. A diploid (2n) cell that undergoes meiosis and forms four haploid (1n) microspores; also called microspore mother cell and, in seed plants, pollen mother cell.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000248 \"pollen mother cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000248 \"primary sporogenous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000250 \"Obsolete. Use PO:0020019 from Plant Ontology instead. A haploid (1n) spore developing into a female gametophyte in heterosporous plants.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000252 \"Obsolete. Use PO:0020048 from Plant Ontology instead. A haploid (1n) spore developing into a male gametophyte in heterosporous plants; the uninucleate pollen grain in seed plants.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000254 \"Obsolete. Use PO:0020094 from Plant Ontology instead. The female gamete of plants.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000254 \"female gametophyte egg cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000255 \"MESH:D005057\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000258 \"Obsolete. Use PO:0000355 from Plant Ontology instead. A fiber like tracheid in the secondary xylem; commonly thick walled, with pointed ends and bordered pits that have lenticular to slit like apertures.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000260 \"Obsolete. Use PO:0000373 from Plant Ontology instead. Cell containing mucilages or gums or similar carbohydrate material characterized by the property of swelling in water.\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000261 \"http://purl.obolibrary.org/obo/DDANAT_0000002\"^^xsd:anyURI)\nAnnotationAssertion(oboInOwl:consider obo:CL_0000261 \"false\"^^xsd:boolean)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000262 \"Obsolete. Use PO:0000351 from Plant Ontology instead. An epidermal cell that divides to produce the guard cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000264 \"Obsolete. Use PO:0000400 from Plant Ontology instead. A cambial cell on the phloem side of the cambial zone that is the source of one or more cells arising by periclinal divisions and differentiating into phloem elements with or without additional divisions in various planes.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000264 \"phloem mother cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000266 \"Obsolete. Use PO:0004011 from Plant Ontology instead. A cell constituting an active locus of meristematic activity in a tissue composed of somewhat older, differentiating cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000268 \"Obsolete. Consult Plant Ontology instead. The cell in the phloem tissue concerned with mainly longitudinal conduction of food materials. Classified into sieve cell and sieve tube member.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:047124520\") obo:IAO_0000115 obo:CL_0000270 \"Obsolete. Use PO:0000284 from Plant Ontology instead. An epidermal cell associated with a stoma and at least morphologically distinguishable from the epidermal cells composing the groundmass of the tissue.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000272 \"OBSOLETE, use term from Plant Ontology. A cell localized in the vascular cambium or phellogen. Its periclinal division can contribute cells either to the outside or to the inside of the axis; in vascular cambium, classified into fusiform initials (source of axial cells of xylem and phloem) and ray initials (source of the ray cells).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000276 \"Obsolete. Use PO:0000077 from Plant Ontology instead. Cell variable in form and size, being more or less thick, often lignified, secondary walls. Belongs to the category of subcells and may or may not be devoid of protoplast at maturity.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DictyBase:DDB\") obo:IAO_0000115 obo:CL_0000277 \"OBSOLETE: Initial population of prestalk cells that activate the ecmA promoter at the mound stage and that presumably further differentiate into pstA and pstO cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000278 \"Obsolete. Use PO:0020090 from Plant Ontology instead. OBSOLETED, use term from Plant Ontology. A cell containing the two polar nuclei which, after double fertilization, will develop into the endosperm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000280 \"Obsolete. Use PO:0020097 from Plant Ontology instead. The cell that will give rise to the generative nuclei which will participate in fertilization.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") Annotation(oboInOwl:hasDbXref \"PMID:10938806\") obo:IAO_0000115 obo:CL_0000282 \"Obsolete. Use PO:0000282 from Plant Ontology instead. An outgrowth from the epidermis. Trichomes vary in size and complexity and include hairs, scales, and other structures and may be glandular. In Arabidopsis, patterning of trichome development is not random but does not appear to be lineage-based like stomata.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0879015322\") obo:IAO_0000115 obo:CL_0000284 \"Obsolete. Use PO:0000071 from Plant Ontology instead. A specialized parenchyma cell associated with a sieve-tube member in angiosperm phloem and arising from the same mother cell as the sieve-tube member.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000286 \"A cell of a filament of a fungal mycelium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:047125208\") obo:IAO_0000115 obo:CL_0000288 \"Obsolete. Use PO:0000191 from Plant Ontology instead. A cell in the micropylar end of the embryo sac associated with the egg in the egg apparatus of angiosperms. Plays a vital role in fertilization.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000290 \"Obsolete. Use PO:0000274 from Plant Ontology instead. A fiber of the xylem tissue, Two types are recognized in the secondary xylem: fiber tracheids and libriform fibers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000292 \"Obsolete. Use PO:0000293 from Plant Ontology instead. One of a pair of cells flanking the stomatal pore and causing the opening and closing of the pore by changes in turgor.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000292 \"stomatal guard cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000293 \"OBSOLETE. A cell whose primary function is to provide structural support, to provide strength and physical integrity to the organism.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000294 \"Obsolete. Consult Plant Ontology instead. A type of sieve element that has relatively undifferentiated sieve areas (with narrow pores), rather uniform in structure on all walls; that is, there are no sieve plates. Typical of gymnosperms and lower vascular plants.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000295 \"A peptide hormone secreting cell that produces growth hormone, somatotropin.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000295 \"growth hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000295 \"somatotrophin secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0140514031\") Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000296 \"Obsolete. Use PO:0020099 from Plant Ontology instead. Cell type formed after the first mitotic division of the microgametophye, The nucleus of this cell migrates to the tip of the pollen tube after germination and disintegrates when the pollen tube penetrates the nucellus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10938806\") obo:IAO_0000115 obo:CL_0000297 \"Obsolete. Use PO:0000115 from Plant Ontology instead. A cell that surrounds a trichome and provides support for the trichome.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000298 \"Obsolete. Use PO:0000273 from Plant Ontology instead. A cell composing the xylem.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000299 \"OBSOLETED. Commonly used for a cell in root epidermis that gives rise to a root hair. The daughter cell produced by the asymmetric division of a root epidermal cell that gives rise to a root hair.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000300 \"A mature sexual reproductive cell having a single set of unpaired chromosomes.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000300 \"CALOHA:TS-0395\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000300 \"FMA:18649\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000300 \"haploid nucleated cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000300 \"haploid germ cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000300 obo:CL_0000586)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1017/CBO9780511818202.015\") obo:IAO_0000115 obo:CL_0000301 \"A primordial germ cell of insects. Such cells form at the posterior pole of the early embryo.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000306 \"lens cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000307 \"An epithelial cell found in the trachea.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000307 \"FMA:74793\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000307 \"tracheocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000307 obo:CL_0002202)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000309 \"cuprophilic cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19256306\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:29713660\") Annotation(oboInOwl:hasDbXref \"PMID:37873034\") obo:IAO_0000115 obo:CL_0000312 \"An epithelial cell of stratified squamous tissues, including skin, oral mucosa (Hiroshima et al., 2011), and esophagus (Whelan et al., 2018), that produces keratin proteins and secretes antimicrobial peptides to form a resilient barrier against environmental damage, dehydration, pathogens, and microbial invasion. It undergoes successive stages of differentiation marked by changes in keratin expression, supporting tissue integrity, wound repair, and contributing to immune defense.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000312 \"BTO:0000667\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000312 \"CALOHA:TS-0500\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000312 \"FMA:62879\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000312 obo:CL_0000237)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000313 \"Columnar glandular cell with irregular nucleus, copious granular endoplasmic reticulum and supranuclear granules. Secretes a watery fluid containing proteins known as serous fluid.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000313 \"BTO:0003687\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000313 \"FMA:62511\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000313 \"serous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013666\") obo:IAO_0000115 obo:CL_0000315 \"A cell secreting tears, the fluid secreted by the lacrimal glands. This fluid moistens the conjunctiva and cornea.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000315 \"tears secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000316 \"Obsolete. Use PO:0000082 from Plant Ontology instead. A meristemic ray cell in the vascular cambium that gives rise to ray cells of the secondary xylem and secondary phloem.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D012629\") Annotation(oboInOwl:hasDbXref \"PMID:19944183\") obo:IAO_0000115 obo:CL_0000317 \"An epithelial cell that is part of a sebaceous gland. This cell produces and secretes sebum, an oily, lipid-rich substance, through holocrine secretion where the entire cell ruptures to release its contents.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000317 \"sebum secreting cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000317 obo:CL_0000151)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013542\") obo:IAO_0000115 obo:CL_0000318 \"A cell secreting sweat, the fluid excreted by the sweat glands of mammals. It consists of water containing sodium chloride, phosphate, urea, ammonia, and other waste products.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000319 \"BTO:0003689\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000319 \"mucous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000320 \"Obsolete. Use PO:0000431 from Plant Ontology instead. A diploid (2n) cell that undergoes meiosis and produces four haploid (1n) megaspores; also called megaspore mother cell.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000320 \"archesporial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000320 \"megaspore mother cell\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000321 obo:CL_1001597)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") obo:IAO_0000115 obo:CL_0000322 \"An epithelial cell that lines the peripheral gas exchange region of the lungs of air-breathing vertebrates.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000322 \"BTO:0000395\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000322 \"CALOHA:TS-2168\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000322 \"FMA:62499\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000322 \"MESH:D056809\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolar epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolus of lung epithelial cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"epithelial cell of alveolus of lung\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32491474\") oboInOwl:hasExactSynonym obo:CL_0000322 \"pneumocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"pneumonocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000325 \"A cell that is specialised to accumulate a particular substance(s).\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_0000325 ubprop:_upper_level)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000330 \"Obsolete. Use PO:0000075 from Plant Ontology instead. An elongated living cell with unevenly thickened nonlignified primary walls.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000331 \"Obsolete. Use PO:0000301 from Plant Ontology instead. A tracheary element of the xylem that has no perforations, as contrasted with a vessel member. May occur in primary and in secondary xylem. May have any kind of secondary wall thickening found in tracheary elements.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0387987819\") obo:IAO_0000115 obo:CL_0000332 \"OBSOLETE, use term from Plant Ontology. A cell formed after asymmetric division of root epidermal cell that does not give rise to a root hair.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000332 \"non-hair cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.stem.2015.02.017\") obo:IAO_0000115 obo:CL_0000333 \"A cell derived from the specialized ectoderm flanking each side of the embryonic neural plate, which after the closure of the neural tube, forms masses of cells that migrate out from the dorsal aspect of the neural tube to spread throughout the body.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000333 \"FMA:86667\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000334 \"BTO:0002307\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000334 \"FAO:0000032\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000334 \"yeast-form\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:5025404\") obo:IAO_0000115 obo:CL_0000335 \"A mesenchymal cell in embryonic development found in a contracting mass and that gives rise to osteoprogenitors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.britannica.com/EBchecked/topic/6405/adrenal-gland\") obo:IAO_0000115 obo:CL_0000336 \"A cell found within the adrenal medulla that secrete biogenic amine hormones upon stimulation.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000336 \"FMA:69262\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69262\") oboInOwl:hasExactSynonym obo:CL_0000336 \"medullary chromaffin cell of adrenal gland\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000336 obo:CL_0000150)\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000336 obo:CL_0000166)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1295739\") obo:IAO_0000115 obo:CL_0000338 \"A neural precursor of the central nervous system.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000338 \"neuroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0000339 \"An early neural cell developing from the early ependymal cell of the neural tube.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000339 \"FMA:70564\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000339 \"spongioblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1002/glia.21162\") obo:IAO_0000115 obo:CL_0000340 \"A precursor of the central nervous system that gives rise to glial cells only.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000342 \"Any animal cell containing pigment granules.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000343 \"A pigment cell that is capable of detecting light stimulus that is involved in visual perception.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000343 \"FMA:63846\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000343 obo:CL_0000342)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000345 \"A mesenchymal cell that is part of a small mass of condensed mesenchyme in the enamel organ; it differentiates into the dentin and dental pulp.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28418596\") Annotation(oboInOwl:hasDbXref \"PMID:39798934\") Annotation(oboInOwl:hasDbXref \"PMID:40867641\") obo:IAO_0000115 obo:CL_0000346 \"A specialized fibroblast that resides in the dermal papilla located at the bottom of hair follicles. This cell orchestrates reciprocal epithelial-mesenchymal signaling essential for hair follicle morphogenesis and cycling, regulating matrix cell proliferation and differentiation to control hair shaft size, shape, and growth. The dermal papilla cell is replenished each hair cycle from bipotent hair follicle dermal stem cells in the dermal sheath that simultaneously self-renew and contribute progeny to the papilla, particularly during anagen.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39798934\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000346 \"hair follicle DPC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21444748\") rdfs:comment obo:CL_0000346 \"The dermal papilla contains functionally heterogeneous Sox2-positive subpopulations that serve as a niche for multipotent stem cells. These cells exhibit progenitor properties, generate skin-derived precursors (SKPs), and can differentiate into adipogenic and osteogenic lineages.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000347 \"A cell of the sclera of the eye.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000348 \"A cell that is part of optic choroid.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D014327\") Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_0000351 \"An extraembryonic cell that develops from a trophectodermal cell. This cell is found in the outer layer of the blastocyst and can invade other structures in the uterus once the blastocyst implants into the uterine wall. A trophoblast cell is involved in the implantation of the embryo into the uterine wall, placental formation, remodelling of maternal vasculature in the uterus, nutrient and gas exchange, hormone production, and immune modulation to support fetal development.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000351 \"FMA:83028\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") oboInOwl:hasExactSynonym obo:CL_0000351 \"trophoblastic cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000351 obo:CL_0000349)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0000352 \"A cell of the outer layer of a blastula that gives rise to the ectoderm after gastrulation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D001756\") obo:IAO_0000115 obo:CL_0000353 \"An undifferentiated cell produced by early cleavages of the fertilized egg (zygote).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000353 \"BTO:0001473\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000353 \"FMA:72551\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000353 \"blastomere\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000354 \"ncithesaurus:Blastemal_Cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000354 \"blastema cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18282570\") obo:IAO_0000115 obo:CL_0000355 \"A multifate stem cell found in skeletal muscle than can differentiate into many different cell types, including muscle. Distinct cell type from satellite cell.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000355 \"FMA:86767\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000355 obo:CL_0000048)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cjm\") obo:IAO_0000115 obo:CL_0000358 \"A smooth muscle cell that is part of a sphincter. A sphincter is a typically circular muscle that normally maintains constriction of a natural body passage or orifice and which relaxes as required by normal physiological functioning.\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000358 obo:CL_0000192)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000359 \"A smooth muscle cell associated with the vasculature.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000359 \"VSMC\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000359 \"vascular smooth muscle cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000359 obo:CL_0000192)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009028\") obo:IAO_0000115 obo:CL_0000360 \"A cell of the early embryo at the developmental stage in which the blastomeres, resulting from repeated mitotic divisions of the fertilized ovum (zygote), form a compact cell mass.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D005775\") obo:IAO_0000115 obo:CL_0000361 \"A cell of the embryo in the early stage following the blastula, characterized by morphogenetic cell movements, cell differentiation, and the formation of the three germ layers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Flybase:dsj\") Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000362 \"An epithelial cell of the integument (the outer layer of an organism).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000362 \"BTO:0001470\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000362 \"CALOHA:TS-0283\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000362 \"FMA:62411\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000362 \"MESH:D000078404\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:62411\") oboInOwl:hasExactSynonym obo:CL_0000362 \"cell of epidermis\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:62411\") oboInOwl:hasNarrowSynonym obo:CL_0000362 \"epithelial cell of skin\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000363 \"Obsolete. Use PO:0000081 from Plant Ontology instead. OBSOLETE, use term from the Plant Ontology. A secondary vascular cell that develops from the fusiform cambial initials and oriented with their longest diameter parallel with the main axis of stem or root. These cells make up the axial system, also known as vertical or longitudinal system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000364 \"Obsolete. Consult Plant Ontology. A cell that develops from the ray initial and composes all rays (panels of tissue variable in height and width, formed by the ray initials in the vascular cambium and extending radially in the secondary xylem and secondary phloem) in the secondary vascular tissues.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000365 \"Diploid cell produced by the fusion of sperm cell nucleus and egg cell.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000365 \"zygote\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000365 \"BTO:0000854\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000365 \"EHDAA2:0004546\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000365 \"FMA:72395\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000366 \"Obsolete. Use PO:0000084 from Plant Ontology instead. Male gamete, part of male germ unit.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000366 \"gametophyte sperm cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000366 \"male gametophyte sperm cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000366 \"pollen germ cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000367 \"glial cell (sensu Nematoda)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000368 \"Obsolete. Use PO:0000352 from Plant Ontology instead. Cell containing glucosinolates ('mustard oil glucosides') and myrosinases, enzymes hydrolyzing the glucosinolates. Occurs in eleven dicotyledon families, the two largest of which are the Brassicaceae and Euphorbiaceae.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000370 \"Obsolete. Use PO:0000078 from Plant Ontology instead. Parenchyma cell with the wall ingrowth (or invaginations) that increase the surface of the plasmalemma. Appears to be specialized for short-distance transfer of solutes.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000370 \"intermediary cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000371 \"The cell protoplasm after removal of the cell wall.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000371 \"MESH:D011523\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:978-0801481253\") obo:IAO_0000115 obo:CL_0000372 \"An epidermal cell that is part of a cell cluster organ of the insect integument (such as a sensillum) and that secretes a cuticular specialization that forms a socket around the base of a cuticular specialization produced by a trichogen cell.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:978-0801481253\") oboInOwl:hasBroadSynonym obo:CL_0000372 \"socket cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2022.01.045\") obo:IAO_0000115 obo:CL_0000373 \"A progenitor cell found in the larval epidermis of insects and that gives rise to the adult abdominal epidermis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:978-0801481253\") obo:IAO_0000115 obo:CL_0000374 \"An epidermal cell that is part of a cell cluster organ of the insect integument (such as a sensillum) and that secretes a cuticular specialization, often in the form of a hair, bristle, peg or scale. The base of this specialization is often surrounded by a socket produced by a closely associated tormogen cell.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000374 \"hair cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000374 \"BTO:0004744\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000375 \"BTO:0002051\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000378 \"support cell (sensu Nematoda and Protostomia)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Fbbt:00005173\") obo:IAO_0000115 obo:CL_0000380 \"The support cell that makes the thecogen dendritic cap - a cuticle-like matrix around the tip of the eo-dendrite and which encloses the soma of the eo-neuron.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000380 \"fly sheath cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50012-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1017/CBO9780511818202.024\") obo:IAO_0000115 obo:CL_0000382 \"A cell that is part of a scolopidium and surrounds the dendrite of a scolopidial neuron.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:978-087969828-7\") oboInOwl:hasExactSynonym obo:CL_0000382 \"scolopidial sheath cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000385 \"A precursor of mature hemocytes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000387 \"A blood cell of the circulatory system of arthropods.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:37894875\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibroblast that is part of a tendon. Its cytoplasm is stretched between the collagen fibres of the tendon, and it possesses a central nucleus with a prominent nucleolus. Tendon cell has a well-developed rough endoplasmic reticulum, and it is responsible for the synthesis and turnover of tendon fibres and ground substance.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000388 \"muscle attachment cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000388 \"tenocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000392 \"A hemocyte that synthesizes and secretes melanins as part of the antimicrobial immune response. It is characterized morphologically by crystal inclusions of phenoloxidases in its cytoplasm, hence its name.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000393 \"A cell whose function is determined by its response to an electric signal.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000394 \"A phagocytic hemocyte, responsible for the engulfment of small particles, microbes, and apoptotic tissue debris. It may also secretes antimicrobial peptides and contribute to the production and secretion of proteins of the hemolymph.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000394 \"macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000395 \"A precursor of mature crystal cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000396 \"A hemocyte found in immuno-stimulated larvae.\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000397 obo:CL_0000099)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000399 \"Obsolete. Consult Plant Ontology instead. OBSOLETED, not defined prior to obsoletion.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:087694289\") obo:IAO_0000115 obo:CL_0000400 \"Obsolete. Use PO:0000332 from Plant Ontology instead. An epidermal cell with a characteristic convoluted anticlinal cell wall that gives a jigsaw like appearance to the lamina.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-0-12-817424-1.00001-X\") obo:IAO_0000115 obo:CL_0000402 \"OBSOLETE. An interneuron that has its cell body in a central nervous system.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000404 \"A cell that initiates an electrical signal and passes that signal to another cell.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-0-12-408088-1.00002-6\") Annotation(oboInOwl:hasDbXref \"doi:10.1023/a:1018564904170\") obo:IAO_0000115 obo:CL_0000407 \"A cell that anchors the cell body of a scolopidial neuron to the integument.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000408 \"BTO:0001277\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000408 \"CALOHA:TS-0949\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000408 obo:CL_0000015)\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000408 obo:CL_0000300)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/hermaphrodite/hypodermis/mainframe.htm\") obo:IAO_0000115 obo:CL_0000411 \"An epithelial cell of the hypodermis of Caenorhabditis.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000411 \"roundworm hypodermal cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000411 \"WBbt:0007846\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"PMID:32646579\") Annotation(oboInOwl:hasDbXref \"https://bio.libretexts.org/Bookshelves/Introductory_and_General_Biology/Biology_(Kimball)/07%3A_Cell_Division/7.04%3A_Polyploidy\"^^xsd:anyURI) obo:IAO_0000115 obo:CL_0000412 \"A cell that contains more than two haploid sets of chromosomes.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000413 \"A cell whose nucleus contains a single haploid genome.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000414 \"OBSOLETE: A classification of cells by the number of haploid genome equivalents of their nucleus or nuclei.\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000414 \"CL:0000000\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000414 \"CL:0000003\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000414 \"CL:0000255\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000414 \"CL:0001034\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000415 \"A cell whose nucleus has two haploid genomes.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000415 \"FMA:72300\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/ver1/handbook/hypodermis/hypsupportother.htm#arcadecells\") obo:IAO_0000115 obo:CL_0000418 \"An epithelial cell found in C. elegans that firmly hold the outer body wall and the lips to the inner cylinder of the pharynx in a manner that keeps these organs from breaking apart, while still giving each organ freedom of movement during feeding.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000418 \"WBbt:0005793\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/hermaphrodite/seam%20cells/mainframe.htm\") obo:IAO_0000115 obo:CL_0000419 \"An epithelial fate stem cell found in flatworms.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000419 \"BTO:0003039\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000420 \"Wikipedia:Syncytium\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000421 \"A free floating cell, including amebocytes and eleocytes, in the coelom of certain animals, especially annelids.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000421 \"BTO:0002856\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000421 \"WBbt:0005751\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000422 \"A cell whose primary function is to cause growth by stimulating cell division in its immediate cellular environment.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19783135\") obo:IAO_0000115 obo:CL_0000424 \"A cell involved in the elimination of metabolic and foreign toxins, and in maintaining the ionic, acid-base and water balance of biological fluids.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000424 \"WBbt:0005812\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000425 \"Forms the terminal part of the cuticle-lined excretory duct of C. elegans.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://wormatlas.psc.edu/hermaphrodite/muscleGLR/mainframe.htm\") obo:IAO_0000115 obo:CL_0000427 \"A scaffolding cell type found in C. elegans, this cell plays a supportive role to the muscle arms. May also have an endocrine role.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00412-016-0595-4\") obo:IAO_0000115 obo:CL_0000429 \"A columnar epithelial cell that is part of an insect imaginal disc.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000430 \"A pigment cell derived from the neural crest. Contains cartenoid pigments in structures called pterinosomes or xanthosomes. This gives an appearance ranging from a golden yellow to orange and red.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000430 \"xanthophore\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000431 \"A pigment cell derived from the neural crest. The cell contains flat light-reflecting platelets, probably of guanine, in stacks called reflecting platelets or iridisomes. The color-generating components produce a silver, gold, or iridescent color.\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000431 \"guanophore\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000432 \"FMA:62877\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000432 \"reticulum cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000433 \"Obsolete. Use PO:0000244 from Plant Ontology instead. In monosporic and bisporic megasporogenesis: the megaspore(s) that will undergo megagametogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0198547684\") obo:IAO_0000115 obo:CL_0000434 \"A secretory cell that discharges its product without loss of cytoplasm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Gonadotroph\") obo:IAO_0000115 obo:CL_0000437 \"A rounded cell that is usually situated next to sinusoids; secretes follicular stimulating hormone (FSH) and luteinizing hormone (LH).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000437 \"BTO:0002482\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000437 \"FMA:83100\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"delta basophil\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"follicle stimulating hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"gonadotrope\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"gonadotrope cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"gonadotroph\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"gonadotropic cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000437 \"pituitary delta cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000438 \"A peptide hormone secreting cell pituitary that produces luteinizing hormone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000439 \"A peptide hormone cell that secretes prolactin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000440 \"A cell of the intermediate pituitary that produces melanocyte stimulating hormone.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000440 \"BTO:0002277\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000440 \"melanotrope\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000440 \"melanotroph\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50005-5\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-19361-0\") Annotation(oboInOwl:hasDbXref \"doi:10.1242/dev.121.11.3797\") obo:IAO_0000115 obo:CL_0000441 \"A stem cell that gives rise to the follicle cells that surround the oocyte in female arthropods.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.devcel.2005.08.012\") oboInOwl:hasBroadSynonym obo:CL_0000441 \"somatic stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:127520252\") obo:IAO_0000115 obo:CL_0000442 \"A cell with extensive dendritic processes found in the B cell areas (primary follicles and germinal centers) of lymphoid tissue. They are unrelated to the dendritic cell associated with T cells. Follicular dendritic cells have Fc receptors and C3b receptors, but unlike other dendritic cells, they do not process or present antigen in a way that allows recognition by T cells. Instead, they hold antigen in the form of immune complexes on their surfaces for long periods and can present antigen to B cells during an immune response.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"BTO:0004267\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"FMA:83037\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"MESH:D020566\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:DOS\") Annotation(oboInOwl:hasDbXref \"PMID:8720463\") obo:IAO_0000115 obo:CL_0000444 \"A muscle cell in which the fibers are organised into sarcomeres but in which adjacent myofibrils are offset from each other, producing an oblique banding pattern.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69078\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000446 \"An epithelial cell of the parathyroid gland that is arranged in wide, irregular interconnecting columns; responsible for the synthesis and secretion of parathyroid hormone.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"BTO:0004712\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"CALOHA:TS-2140\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"FMA:69078\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid chief cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid gland chief cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"principal cell of parathyroid gland\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D052438\") obo:IAO_0000115 obo:CL_0000448 \"An adipocyte with light coloration and few mitochondria. It contains a scant ring of cytoplasm surrounding a single large lipid droplet or vacuole.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000448 \"CALOHA:TS-1119\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000448 \"FMA:83434\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000448 \"white adipose cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000448 \"white fat cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D002001\") obo:IAO_0000115 obo:CL_0000449 \"A cell from the thermogenic form of adipose tissue found in many species,  particularly in newborns and hibernating mammals, but also in lesser amounts in adults of other mammals including humans. Brown fat is capable of rapid liberation of energy and seems to be important in the maintenance of body temperature immediately after birth and upon waking from hibernation.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000449 \"CALOHA:TS-0099\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000449 \"FMA:83435\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000449 \"brown adipose cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000449 \"brown fat cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000451 \"A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"BTO:0002042\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"CALOHA:TS-0194\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"FMA:83036\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"MESH:D003713\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000451 \"interdigitating cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000451 \"veiled cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000451 obo:CL_0000738)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2346585\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") obo:IAO_0000115 obo:CL_0000453 \"Langerhans cell is a conventional dendritic cell that has plasma membrane part CD207. A Langerhans cell is a stellate dendritic cell of myeloid origin, that appears clear on light microscopy and has a dark-staining, indented nucleus and characteristic inclusions (Birbeck granules) in the cytoplasm; Langerhans cells are found principally in the stratum spinosum of the epidermis, but they also occur in other stratified epithelia and have been identified in the lung, lymph nodes, spleen, and thymus.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"BTO:0000705\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"CALOHA:TS-2375\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"FMA:63072\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"MESH:D007801\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000453 \"LC\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000453 obo:CL_0000990)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12438093\") obo:IAO_0000115 obo:CL_0000454 \"A cell capable of producing epinephrine. Epiniphrine is synthesized from norepiniphrine by the actions of the phenylethanolamine N-methyltransferase enzyme, which is expressed in the adrenal glands, androgenic neurons, and in other cell types.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0048242\") oboInOwl:hasExactSynonym obo:CL_0000454 \"adrenaline secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000454 \"epinephrin secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:044174520\") obo:IAO_0000115 obo:CL_0000455 \"Obsolete. Use PO:0004531 from Plant Ontology instead. A cell characterized by conspicuous and rather stable accumulation of starch.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19630576\") obo:IAO_0000115 obo:CL_0000458 \"A cell type that secretes 5-Hydroxytryptamine (serotonin).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000458 \"5-HT secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000458 \"5-Hydroxytryptamine secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0000459 \"A cell capable of producting norepiniphrine. Norepiniphrine is a catecholamine with multiple roles including as a hormone and a neurotransmitter. In addition, epiniphrine is synthesized from norepiniphrine by the actions of the phenylethanolamine N-methyltransferase enzyme.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"noradrenaline secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"norepinephrin secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"norepinephrine secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/S0925-4773(97)00654-0\") obo:IAO_0000115 obo:CL_0000462 \"A cell of mesodermal origin that is closely associated with the epithelium of an imaginal disc. It is a precursor of some of the insect's adult muscles.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FlyBase:ds\") Annotation(oboInOwl:hasDbXref \"ISBN:ISBN:978-0801481253\") obo:IAO_0000115 obo:CL_0000463 \"An epidermal cell that secretes chitinous cuticle from its apical side.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:7576311\") obo:IAO_0000115 obo:CL_0000464 \"An epidermal progenitor cell that arises from neuroectoderm and in turn gives rise to the epidermal sheath of ventral and cephalic regions.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/BF00360522\") obo:IAO_0000115 obo:CL_0000465 \"A precursor of the cells that form the dorsal vessel of arthropods.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000467 \"A peptide hormone secreting cell that produces adrenocorticotropin, or corticotropin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0051458\") oboInOwl:hasExactSynonym obo:CL_0000467 \"ACTH secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000467 \"adrenocorticotrophic hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000467 \"corticotrophin hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000467 \"corticotropin hormone secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0051458\") oboInOwl:hasExactSynonym obo:CL_0000467 \"corticotropin secreting cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1002/glia.21162\") obo:IAO_0000115 obo:CL_0000468 \"A precursor of the central nervous system that gives rise to both neurons and glial cells.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000468 \"neuro-glioblast\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000468 \"neuroglioblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000472 \"Obsolete. Use PO:0000076 from Plant Ontology instead. OBSOLETE, use term from Plant Ontology. Parenchyma cells containing chloroplasts; a component of leaf mesophyll and other green parenchyma tissue.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FBbt:00003184\") Annotation(oboInOwl:hasDbXref \"GO:0061320\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19783135\") obo:IAO_0000115 obo:CL_0000474 \"An insect renal cell that filters hemolymph and is found with other pericardial nephrocytes in two rows flanking the dorsal vessel.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FBbt:00005058\") Annotation(oboInOwl:hasDbXref \"GO:0061320\") oboInOwl:hasNarrowSynonym obo:CL_0000474 \"pericardial cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000475 \"Obsolete. Use PO:0000245 from Plant Ontology instead. In monosporic and bisporic megasporogenesis: the megaspore(s) that do not participate in megagametogenesis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000476 \"A basophil cell of the anterior pituitary that produces thyroid stimulating hormone, thyrotrophin. This cell type is elongated, polygonal and lie in clusters towards the adenohypophyseal center.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000476 \"FMA:83099\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000476 \"MESH:D052684\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"beta-basophil\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"thyroid stimulating hormone secreting cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"thyrotrope\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000477 \"follicle cell\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000477 \"ovarian follicle cell\")\nSubClassOf(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:CL_0000477 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000478 \"A peptide hormone secreting cell that secretes oxytocin stimulating hormone\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000479 \"A peptide hormone secreting cell that secretes vasopressin stimulating hormone\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000480 \"A peptide hormone secreting cell that secretes secretin stimulating hormone\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000481 \"A peptide hormone secreting cell that secretes cholecystokin stimulating hormone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000482 \"An endocrine cell that secretes juvenile hormone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000483 \"A peptide hormone secreting cell that secretes bombesin stimulating hormone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19923473\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") obo:IAO_0000115 obo:CL_0000484 \"Mast cell subtype whose granules contain both the serine proteases tryptase and chymase. These cells are primarily found in connective tissue, such as the peritoneal cavity, skin, and intestinal submucosa. Their development is T-cell independent.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"MC(TC)\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"MCTC\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"TC mast cells\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000484 obo:CL_0000097)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMID:19923473\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") obo:IAO_0000115 obo:CL_0000485 \"Mast cell subtype that contains only the serine protease trypase in its granules. These cells are primarily found in mucosal tissue, such as intestinal mucosa and alveoli. They depend upon T-cells for development of phenotype.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"MC(T)\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"MCT\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"T mast cells\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000485 obo:CL_0000097)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19783135\") Annotation(oboInOwl:hasDbXref \"fbbt:00005059\") obo:IAO_0000115 obo:CL_0000486 \"A large binucleate cell that forms a 'garland' around the anterior end of the proventriculus (cardia) at its junction with the esophagus in both adults and larvae flies. Each cell is surrounded by a basement membrane and there are numerous micro-invaginations (lacunae) extending from the surface into the cytoplasm. At the mouth of each lacuna is a doubled filament forming a specialised filtration system (diaphragm). The filtrate is endocytosed from the lacunae.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0061321\") oboInOwl:hasBroadSynonym obo:CL_0000486 \"garland nephrocyte\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000486 \"BTO:0004596\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:bf\") Annotation(oboInOwl:hasDbXref \"PMID:11171397\") Annotation(oboInOwl:hasDbXref \"PMID:24397521\") Annotation(oboInOwl:hasDbXref \"PMID:34208190\") Annotation(oboInOwl:hasDbXref \"https://www.merriam-webster.com/dictionary/oenocyte\") obo:IAO_0000115 obo:CL_0000487 \"A secretory cell of ectodermal origin. This cell may have important functions in fatty acid and hydrocarbon metabolism and is metabolically linked to the fat body and tracheae. This cell is exclusive of arthropods.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24397521\") Annotation(oboInOwl:hasDbXref \"PMID:34208190\") rdfs:comment obo:CL_0000487 \"Oenocytes are highly variable in size, shape, cluster formation and anatomical location. In adults, oenocytes tend to be smaller but more numerous than in larvae. While oenocytes have been found in arachnids and crustaceans, they have been most abundantly described in insects.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000488 \"A photoreceptor cell that detects visible light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"MESH:D006377\") obo:IAO_0000115 obo:CL_0000492 \"A CD4-positive, alpha-beta T cell that cooperates with other lymphocytes via direct contact or cytokine release to initiate a variety of immune functions.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000492 \"CALOHA:TS-1146\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000492 \"FMA:70572\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive T-helper cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T-cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T-lymphocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000492 obo:CL_0000624)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000494 \"A photoreceptor cell that detects ultraviolet light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000495 \"A photoreceptor cell that is sensitive to blue light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000496 \"A photoreceptor cell that is sensitive to green light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000497 \"A photoreceptor cell that is sensitive to red light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Interneuron\") obo:IAO_0000115 obo:CL_0000498 \"An interneuron (also called relay neuron, association neuron or local circuit neuron) is a multipolar neuron which connects afferent neurons and efferent neurons in neural pathways. Like motor neurons, interneuron cell bodies are always located in the central nervous system (CNS).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000498 \"FMA:84776\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D017154\") obo:IAO_0000115 obo:CL_0000499 \"A connective tissue cell of an organ found in the loose connective tissue.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000499 \"BTO:0002064\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000499 \"FMA:83624\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006107\") obo:IAO_0000115 obo:CL_0000501 \"A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"BTO:0000542\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"CALOHA:TS-0729\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"FMA:18718\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000501 \"granulosa cell of ovary\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D019864\") obo:IAO_0000115 obo:CL_0000502 \"A cell found throughout the gastrointestinal tract and in the pancreas. They secrete somatostatin in both an endocrine and paracrine manner. Somatostatin inhibits gastrin, cholecystokinin, insulin, glucagon, pancreatic enzymes, and gastric hydrochloric acid. A variety of substances which inhibit gastric acid secretion (vasoactive intestinal peptide, calcitonin gene-related peptide, cholecystokinin, beta-adrenergic agonists, and gastric inhibitory peptide) are thought to act by releasing somatostatin.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000502 \"FMA:62935\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000502 \"D cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013799\") Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") obo:IAO_0000115 obo:CL_0000503 \"A specialized stromal cell that forms the theca layer outside the basal lamina lining the ovarian follicle, appearing during the secondary follicle stage.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000503 \"BTO:0002850\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D019861\") obo:IAO_0000115 obo:CL_0000504 \"A enteroendocrine cell part of the glands of the gastric mucosa. They produce histamine and peptides such as chromogranins. This cell type respond to gastrin by releasing histamine which acts as a paracrine stimulator of the release of hydrochloric acid from the gastric parietal cells.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000504 \"BTO:0002692\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000504 \"ECL\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000505 \"A peptide hormone secreting cell that secretes substance P.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000506 \"An endorphi