InOwl:hasExactSynonym obo:CL_0000561 \"amacrine neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000561 \"AC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000561 \"ACs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOc:tfm\") obo:IAO_0000115 obo:CL_0000562 \"An erythrocyte having a nucleus.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000562 \"RBC\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000562 \"red blood cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000562 obo:CL_0000232)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0000563 \"A rounded, inactive form that certain bacteria assume under conditions of extreme temperature, dryness, or lack of food. The bacterium develops a waterproof cell wall that protects it from being dried out or damaged.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000563 \"BTO:0002779\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000563 \"bacterial spore\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") obo:IAO_0000115 obo:CL_0000564 \"A promyelocyte committed to the neutrophil lineage. This cell type is GATA-1-positive, C/EBPa-positive, AML-1-positive, MPO-positive, has low expression of PU.1 transcription factor and lacks lactotransferrin expression.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000564 \"FMA:84196\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000564 \"neutrophilic premyelocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000564 \"neutrophilic progranulocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000564 obo:CL_0000836)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000565 \"A cell found in fat bodies whose primary function is intermediary metabolism.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12768659\") obo:IAO_0000115 obo:CL_0000566 \"A mesenchymal stem cell capable of developing into blood vessel endothelium.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000566 \"angioblast\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000566 \"chondroplast\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000566 obo:CL_0000134)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000568 \"A cell that originates in the neural crest, that has certain cytochemical and ultrastructural characteristics and is found scattered throughout the body; types include melanocytes, the cells of the chromaffin system, and cells in the hypothalamus, hypophysis, thyroid, parathyroids, lungs, gastrointestinal tract, and pancreas. This cell type concentrates the amino acid precursors of certain amines and decarboxylate them, forming amines that function as regulators and neurotransmitters. This cell type produces substances such as epinephrine, norepinephrine, dopamine, serotonin, enkephalin, somatostatin, neurotensin, and substance P, the actions of which may affect contiguous cells, nearby groups of cells, or distant cells, thus functioning as local or systemic hormones. The name is an acronym for amine precursor uptake and decarboxylation cell.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"BTO:0003866\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"FMA:83114\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"MESH:D001078\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000568 \"APUD cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0000569 \"A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000570 \"A neuroepithelial cells that occurs singly or in small groups, close to the outer follicular borders but within the follicular basement membrane of the thyroid. This cell expresses a form of the neural cell adhesion molecule (N-CAM) on its surface and secretes calcitonin and serotonin (5-hydroxytryptamine).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000570 \"FMA:68653\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000570 \"SCTID:176770005\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000570 \"C cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"C cell of thyroid gland\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"clear cell of thyroid gland\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"parafollicular cell of thyroid gland\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"thyroid parafollicular cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000570 obo:CL_0000710)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000571 \"A pigment cell derived from the neural crest. Contains uric acid or other purine crystals deposited in stacks called leucosomes. The crystals reflect light and this gives a white appearance under white light.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017949\") obo:IAO_0000115 obo:CL_0000573 \"One of the two photoreceptor cell types in the vertebrate retina. In cones the photopigment is in invaginations of the cell membrane of the outer segment. Cones are less sensitive to light than rods, but they provide vision with higher spatial and temporal acuity, and the combination of signals from cones with different pigments allows color vision.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"BTO:0001036\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"CALOHA:TS-0866\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"FMA:67748\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") oboInOwl:hasRelatedSynonym obo:CL_0000573 \"cone\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000574 \"A pigment cell derived from the neural crest. Contains pteridine and/or carotenoid pigments in structures called pterinosomes or erythrosomes. This gives an orange to red appearance.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000575 \"An epithelial cell of the cornea.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"BTO:0004298\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"CALOHA:TS-0173\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"FMA:70551\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70551\") oboInOwl:hasExactSynonym obo:CL_0000575 \"epithelial cell of cornea\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"MESH:D009000\") obo:IAO_0000115 obo:CL_0000576 \"Myeloid mononuclear recirculating leukocyte that can act as a precursor of tissue macrophages, osteoclasts and some populations of tissue dendritic cells.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"BTO:0000876\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"CALOHA:TS-0638\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"FMA:62864\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000576 obo:CL_0000766)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9505449\") obo:IAO_0000115 obo:CL_0000577 \"A subtype of enteroendocrine cells found in the gastrointestinal mucosa, particularly in the glands of pyloric antrum; duodenum; and ileum. These cell type secretes serotonin and some neurotransmitters including enkephalins and substance P. Their secretory granules stain readily with silver (argentaffin stain).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"FMA:62934\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"FMA:83132\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"MESH:D004759\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"Kulchitsky cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"argentaffin cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"enterochromaffin cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"ReO:mhb\") obo:IAO_0000115 obo:CL_0000578 \"A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FBbt:00004905\") obo:IAO_0000115 obo:CL_0000579 \"A follicle cell that migrates from the anterior pole of the insect egg chamber to the anterior of the oocyte where they participate in the formation of the micropyle.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:10618520\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000580 \"A neutrophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte; in this stage, production of primary granules is complete and neutrophil-specific granules has started. No nucleolus is present. This cell type is CD13-positive, CD16-negative, integrin alpha-M-positive, CD15-positive, CD33-positive, CD24-positive, C/EBP-a-positive, C/EBPe-positive, PU.1-positive, lactotransferrin-positive, myeloperoxidase-positive and NGAL-positive.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000580 \"BTO:0003455\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000580 \"FMA:83540\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000580 obo:CL_0000776)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017737\") Annotation(oboInOwl:hasDbXref \"PMID:15771589\") Annotation(oboInOwl:hasDbXref \"PMID:19201820\") obo:IAO_0000115 obo:CL_0000581 \"A macrophage resident in the peritoneum under non-inflammatory conditions. Markers include F4/80-high, CD11b-high, CD68-positive, SIGNR1-positive, CD115-high, MHC-II-negative, and Dectin-1-positive.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000581 \"BTO:0001034\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000581 \"FMA:83025\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000581 obo:CL_0000864)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:10618520\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000582 \"A neutrophil precursor in the granulocytic series, being a cell intermediate in development between a myelocyte and the band form neutrophil. The protein synthesis seen in earlier stages decreases or stops; the nucleus becomes indented where the indentation is smaller than half the distance to the farthest nuclear margin; chromatin becomes coarse and clumped; specific granules predominate while primary granules are rare; and the cytoplasm becomes amphophilic like that of a mature granulocyte. This cell type is integrin alpha-M-positive, CD13-negative, CD15-positive, CD16-positive, CD33-positive, CD24-positive, fMLP receptor-negative and has expression of C/EBP-a, C/EBP-e, PU.1 transcription factor, lactotransferrin, myeloperoxidase and neutrophil gelatinase associated lipocalin.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000582 \"FMA:84197\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000582 \"juvenile neutrophil\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000582 obo:CL_0000776)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ana\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"MESH:D016676\") obo:IAO_0000115 obo:CL_0000583 \"A tissue-resident macrophage found in the alveoli of the lungs. Ingests small inhaled particles resulting in degradation and presentation of the antigen to immunocompetent cells. Markers include F4/80-positive, CD11b-/low, CD11c-positive, CD68-positive, sialoadhesin-positive, dectin-1-positive, MR-positive, CX3CR1-negative.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"BTO:0000802\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"CALOHA:TS-0030\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"FMA:83023\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000583 \"dust cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000583 \"MF.Lu\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000583 obo:CL_0000864)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000584 \"An epithelial cell that has its apical plasma membrane folded into microvilli to provide ample surface for the absorption of nutrients from the intestinal lumen.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"BTO:0000398\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"FMA:62122\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"MESH:D020895\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33290721\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-9610-7627\") oboInOwl:hasNarrowSynonym obo:CL_0000584 \"differentiated enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33290721\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-9610-7627\") oboInOwl:hasNarrowSynonym obo:CL_0000584 \"mature enterocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D005854\") obo:IAO_0000115 obo:CL_0000586 \"The reproductive cell in multicellular organisms.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"BTO:0000535\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"NCIT:C12597\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"VHOG:0001534\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"WBbt:0006796\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000586 obo:CL_0000039)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000587 \"A thermoreceptor cell that detects reduced temperatures.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000588 \"A specialized osteoclast associated with the absorption and removal of cementum.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000588 \"BTO:0002516\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000588 \"FMA:83027\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000588 obo:CL_0000092)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006199\") obo:IAO_0000115 obo:CL_0000589 \"A bulbous cell that is medially placed in one row in the organ of Corti. In contrast to the outer hair cells, the inner hair cells are fewer in number, have fewer sensory hairs, and are less differentiated.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000589 \"inner hair cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000589 \"BTO:0003667\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000589 \"FMA:62365\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D008184\") obo:IAO_0000115 obo:CL_0000590 \"A progesterone secreting cell in the corpus luteum that develops from theca cells.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000590 \"BTO:0002850\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000590 \"FMA:18690\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000590 \"small lutein cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000590 \"theca lutein cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000591 \"A thermoreceptor cell that detects increased temperatures.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D008184\") obo:IAO_0000115 obo:CL_0000592 \"A large, progesterone secreting cell in the corpus luteum that develops from the granulosa cells.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000592 \"FMA:18689\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000592 \"granulosa lutein cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000592 \"granulosoluteocytus\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000593 \"A steroid hormone secreting cell that secretes androgen.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D032496\") Annotation(oboInOwl:hasDbXref \"PMID:21849021\") Annotation(oboInOwl:hasDbXref \"PMID:23303905\") obo:IAO_0000115 obo:CL_0000594 \"An elongated, spindle-shaped, cell that is located between the basal lamina and the plasmalemma of a muscle fiber. These cells are mostly quiescent, but upon activation they divide to produce cells that generate new muscle fibers.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000595 \"An erythrocyte lacking a nucleus.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000595 \"red blood cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000595 \"RBC\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000595 obo:CL_0000232)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FAO:0000017\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000596 \"A spore formed following meiosis. Sometimes following meiosis, prospores may undergo one or more rounds of mitosis before they are fully mature.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000596 \"FAO:0000017\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000596 \"meiotically-derived spore\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"PMID:8357339\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000597 \"The smaller of two types of asexual spores formed by some fungi. An ovoid to pear-shaped asexual spore that contains very little cytoplasm and organelles, is uninucleate, and forms in vegetative hypae within a mycelium. Micronidia are extruded from the hyphal cell wall.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000597 \"FAO:0000028\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D017966\") obo:IAO_0000115 obo:CL_0000598 \"Pyramidal neurons have a pyramid-shaped soma with a single axon, a large apical dendrite and multiple basal dendrites. The apex and an apical dendrite typically point toward the pial surface and other dendrites and an axon emerging from the base. The axons may have local collaterals but also project outside their region. Pyramidal neurons are found in the cerebral cortex, the hippocampus, and the amygdala.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"BTO:0003102\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"FMA:67310\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"FMA:86775\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"NIFSTD:sao862606388\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000598 \"projection neuron\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000598 \"pyramidal cell\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_0000598 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"PMID:2524423\") Annotation(oboInOwl:hasDbXref \"PMID:9529886\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000599 \"An asexual, nonmotile spore formed by higher fungi; conidia are usually made from the side or tip of specialized sporogenous cells and do not form by progressive cleavage of the cytoplasm.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000599 \"BTO:0000283\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000599 \"FAO:0000024\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000600 \"A fungal cell with two or more genetically distinct nuclei.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018072\") obo:IAO_0000115 obo:CL_0000601 \"A mechanoreceptor in the organ of Corti. In mammals the outer hair cells are arranged in three rows which are further from the modiolus than the single row of inner hair cells. The motile properties of the outer hair cells may contribute actively to tuning the sensitivity and frequency selectivity of the cochlea.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000601 \"BTO:0003666\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000601 \"FMA:62366\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D011311\") obo:IAO_0000115 obo:CL_0000602 \"A receptor in the vascular system, particularly the aorta and carotid sinus, which is sensitive to stretch of the vessel walls.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000603 \"A fungal cell with two genetically distinct haploid nuclei.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017948\") obo:IAO_0000115 obo:CL_0000604 \"One of the two photoreceptor cell types of the vertebrate retina. In rods the photopigment is in stacks of membranous disks separate from the outer cell membrane. Rods are more sensitive to light than cones, but rod mediated vision has less spatial and temporal resolution than cone vision.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"BTO:0001024\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"CALOHA:TS-0870\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"FMA:67747\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") oboInOwl:hasRelatedSynonym obo:CL_0000604 \"rod\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:2524423\") Annotation(oboInOwl:hasDbXref \"PMID:9529886\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000605 \"A spore formed following mitosis or mitoses.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000605 \"FAO:0000023\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000606 \"The larger of two types of asexual spores formed by some fungi; usually round or oblong.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000606 \"FAO:0000038\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000607 \"A thick walled spore that stores and protects one or more nuclei following sexual reproduction in an Ascomycete.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000607 \"BTO:0000097\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000607 \"FAO:0000020\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000608 \"A thick walled, sexual, resting spore formed by Zygomycetes; sometimes refers to the spore and the multi-layered cell wall that encloses the spore, the zygosporangium.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000608 \"FAO:0000040\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D018069\") obo:IAO_0000115 obo:CL_0000609 \"A mechanoreceptor located in the acoustic maculae and the semicircular canals that mediates the sense of balance, movement, and head position. The vestibular hair cells are connected to accessory structures in such a way that movements of the head displace their stereocilia. This influences the membrane potential of the cells which relay information about movements via the vestibular part of the vestibulocochlear nerve to the brain stem.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000609 \"FMA:62351\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000609 \"vestibular receptor cell\")\nAnnotationAssertion(oboInOwl:consider obo:CL_0000610 \"PO:0009002\")\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000611 \"CFU-Eo\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMCID:PMC2212039\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000611 \"EoP\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000611 \"colony forming unit eosinophil\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000611 \"eosinophil stem cell\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000611 obo:CL_0002191)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:19622087\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000612 \"A eosinophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte;in this stage, production of primary granules is complete and eosinophil-specific granules has started. No nucleolus is present. These cells are integrin alpha-M-positive, CD13-positive, CD15-positive, CD16-negative, CD24-positive, and CD33-positive.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000612 \"BTO:0003454\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000612 \"FMA:83542\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000612 obo:CL_0000772)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000613 \"A progenitor cell committed to the basophil lineage. This cell lacks hematopoietic lineage markers (lin-negative) and is CD34-positive, T1/ST2-low, CD117-negative, and FceRIa-high. This cell also expresses Gata-1, Gata-2 and C/EBPa.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000613 \"BaP\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"CFU-Bas\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"basophilic stem cell\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"colony forming unit basophil\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000613 obo:CL_0002191)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18466030\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000614 \"A basophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte; in this stage, production of primary granules is complete and basophil-specific granules has started. No nucleolus is present. Markers are being integrin alpha-M-positive, fucosyltransferase FUT4-positive, CD33-positive, CD24-positive, aminopeptidase N-positive.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000614 \"BTO:0003456\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000614 \"FMA:83543\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000614 obo:CL_0000768)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:clt\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000615 \"A thick walled spore containing one or more haploid nuclei produced by sexual reproduction in an Basidiomycete; formed externally on extrusions of the basidium.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000615 \"BTO:0002166\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000615 \"FAO:0000021\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000616 \"OBSOLETE: A walled spore produced in a sporangium.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000617 \"A neuron that uses GABA as a vesicular neurotransmitter\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"FMA:84788\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"MESH:D059330\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"WBbt:0005190\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000617 \"GABA-ergic neuron\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000619 \"support cell (sensu Nematoda)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000620 \"OBSOLETE: A sporangiospore that is motile, having flagella.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000620 \"FAO:0000039\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22274696\") obo:IAO_0000115 obo:CL_0000621 \"A myoblast that is committed to a myotube-specific program of differentiation but not yet fused. It undergoes very limited additional proliferation. After fusion, it will take on a muscle identity specified by a `muscle founder cell` (CL:0008006).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000622 \"A secretory cell that is grouped together with other cells of the same type to form grape shaped clusters known as acini (singular acinus).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000622 \"FMA:83625\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000622 \"MESH:D061354\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000622 \"acinic cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000622 \"acinous cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:15771571\") obo:IAO_0000115 obo:CL_0000623 \"A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation via germline encoded activation receptors and also regulate immune responses via cytokine release and direct contact with other cells.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000623 \"large granular lymphocyte\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000623 \"null cell\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"BTO:0000914\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"BTO:0004716\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"CALOHA:TS-0664\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"FMA:63147\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"FMA:83601\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"MESH:D007694\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"VHOG:0001697\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000623 \"NK cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000624 \"A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T-cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T-lymphocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000624 obo:CL_0000791)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000625 \"A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T-cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T-lymphocyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000625 obo:CL_0000791)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") obo:IAO_0000115 obo:CL_0000626 \"A granule cell that has a soma located in an olfactory bulb granule cell layer. An olfactory granule cell is an interneuron that lacks an axon, makes reciprocal dendro-dendritic synapses with mitral cells and tufted cells and is involved in the fine spatio-temporal tuning of the responses of these principal olfactory bulb neurons to odors.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") oboInOwl:hasExactSynonym obo:CL_0000626 \"olfactory bulb granule cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") rdfs:comment obo:CL_0000626 \"Granule cells are the most abundant neuronal population in the olfactory bulb and are continuously renewed throughout life.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000627 \"OBSOLETE. A cell involved in transporting nutrients, minerals, water, gases and other chemicals between cells for a variety of purposes including conveying nutrition to other tissues, removing waste products from the tissues, conveying gases for respiration, distributing heat and repelling invasion of foreign substances.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000628 \"A cell that can perform photosynthesis, in which carbohydrates are synthesized from carbon dioxide and water, using light as the energy source.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000629 \"A cell that is specialized to store a particular substance(s), which is(are) later released from the store for a particular purpose.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000630 \"A cell whose primary function is to support other cell types.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000630 \"BTO:0002315\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000630 \"supportive cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D007760\") obo:IAO_0000115 obo:CL_0000631 \"Cells forming a framework supporting the organ of Corti. Specific cells are those of Claudius, Deiters and Hensen.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"BTO:0002741\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"CALOHA:TS-0452\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"FMA:67763\")\nAnnotatio