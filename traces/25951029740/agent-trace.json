 \"helper T cell type 2\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000546 obo:CL_0000492)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:1638021\") obo:IAO_0000115 obo:CL_0000547 \"An immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000547 \"FMA:83518\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000547 \"rubriblast\")\nAnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000547 \"pronormoblast\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000547 obo:CL_0000764)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000548 \"metazoan cell\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_0000548 ubprop:_upper_level)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000549 \"A nucleated immature erythrocyte, having cytoplasm generally similar to that of the earlier proerythroblast but sometimes even more basophilic, and usually regular in outline. The nucleus is still relatively large, but the chromatin strands are thicker and more deeply staining, giving a coarser appearance; the nucleoli have disappeared. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000549 \"FMA:83505\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"basophilic normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"early erythroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"early normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"prorubricyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000549 obo:CL_0000765)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000550 \"A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely basophilic, but takes on acidophilic aspects, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000550 \"FMA:83506\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"intermediate erythroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"intermediate normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatic erythroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatic normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatophilic normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"rubricyte\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000550 obo:CL_0000765)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000552 \"The final stage of the nucleated, immature erythrocyte, before nuclear loss. Typically the cytoplasm is described as acidophilic, but it still shows a faint polychromatic tint. The nucleus is small and initially may still have coarse, clumped chromatin, as in its precursor, the polychromatophilic erythroblast, but ultimately it becomes pyknotic, and appears as a deeply staining, blue-black, homogeneous structureless mass. The nucleus is often eccentric and sometimes lobulated.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000552 \"FMA:84646\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"acidophilic erythroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"eosinophilic erythroblast\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000552 \"late erythoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"orthochromatic normoblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"pyknotic eto enrythroblast\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000552 obo:CL_0000765)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000553 \"The earliest cytologically identifiable precursor in the thrombocytic series. This cell is capable of endomitosis and lacks expression of hematopoieitic lineage markers (lin-negative).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"BTO:0001164\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"CALOHA:TS-0610\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"FMA:84235\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"MESH:D055016\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11722431\