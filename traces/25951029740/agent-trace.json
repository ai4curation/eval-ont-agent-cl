hasExactSynonym obo:CL_0000557 \"granulocyte/monocyte progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000557 \"CFU-GM\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000557 \"GMP\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000557 obo:CL_0002032)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15946868\") Annotation(oboInOwl:hasDbXref \"PMID:2037622\") obo:IAO_0000115 obo:CL_0000558 \"An immature erythrocyte that changes the protein composition of its plasma membrane by exosome formation and extrusion. The types of protein removed differ between species though removal of the transferrin receptor is apparent in mammals and birds.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"BTO:0001173\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"CALOHA:TS-0864\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"MESH:D012156\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000558 obo:CL_0000764)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000559 \"A precursor in the monocytic series, being a cell intermediate in development between the monoblast and monocyte. This cell is CD11b-positive and has fine azurophil granules.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000559 \"BTO:0004657\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000559 \"FMA:83551\")\nSubClassOf(Annotation(obo