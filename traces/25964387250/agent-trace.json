CL_4033012 \"A(n) smooth muscle cell that is part of a(n) large intestine smooth muscle longitudinal layer.\")\n32342:AnnotationAssertion(terms:contributor obo:CL_4033012 <https://orcid.org/0000-0001-6677-8489>)\n32343:AnnotationAssertion(rdfs:label obo:CL_4033012 \"smooth muscle cell of large intestine smooth muscle longitudinal layer\")\n32344:EquivalentClasses(obo:CL_4033012 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012399)))\n32345:SubClassOf(obo:CL_4033012 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001278))\n32347:# Class: obo:CL_4033013 (suprabasal keratinocyte)\n32349:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22375063\") Annotation(oboInOwl:hasDbXref \"PMID:35883599\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/single+cell+type/squamous+epithelial+cells#suprabasalkeratinocytes\") obo:IAO_0000115 obo:CL_4033013 \"A keratinocyte that resides in the epidermal suprabasal layer and expresses differentiation markers, including keratin 1 and keratin 10, in both humans and mice. In human interfollicular epidermis, this cell retains proliferative capacity and possesses retrodifferentiation potential, acquiring basal-like properties during wound healing or basement membrane contact.\")\n32350:AnnotationAssertion(terms:contributor obo:CL_4033013 <http://orcid.org/0000-0001-6677-8489>)\n32351:AnnotationAssertion(oboInOwl:creation_date obo:CL_4033013 \"2023-02-02T11:17:04Z\"^^xsd:dateTime)\n32352:AnnotationAssertion(rdfs:label obo:CL_4033013 \"suprabasal keratinocyte\")\n32353:EquivalentClasses(obo:CL_4033013 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010402)))\n32354:SubClassOf(obo:CL_4033013 obo:CL_7770004)\n32356:# Class: obo:CL_4033014 (peg cell)\n32358:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2210508\") Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasDbXref \"PMID:30023181\") obo:IAO_0000115 obo:CL_4033014 \"A small, narrow, peg-shaped epithelial cell with little cytoplasm that is part of oviduct epithelium. This cell is rarer than the ciliated and secretory epithelial cells of the fallopian tube epithelium and is often found intercalated between them. Peg cells are generally distributed basally along the epithelium and have been found in high concentrations at the fimbriated, distal end of the fallopian tube in humans. It may have a regenerative/stem-cell function. In humans, markers include EPCAM, CD44, and ITGA6.\")\n32359:AnnotationAssertion(terms:contributor obo:CL_4033014 <https://orcid.org/0000-0001-6677-8489>)\n32360:AnnotationAssertion(terms:date obo:CL_4033014 \"2023-02-02T15:07:12Z\"^^xsd:dateTime)\n32361:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"FTE stem-like cell\")\n32362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4033014 \"FTESC\")\n32363:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"fallopian tube epithelial stem-like cell\")\n32364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") oboInOwl:hasExactSynonym obo:CL_4033014 \"intercalary cell\")\n32365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22911892\") rdfs:comment obo:CL_4033014 \"In vitro evidence supports a stem-cell/regenerative function for these cells\")\n32366:AnnotationAssertion(rdfs:label obo:CL_4033014 \"peg cell\")\n32367:SubClassOf(obo:CL_4033014 obo:CL_4052019)\n32368:SubClassOf(obo:CL_4033014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004804))\n32370:# Class: obo:CL_4033015 (retinal astrocyte)\n32372:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25236977\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") obo:IAO_0000115 obo:CL_4033015 \"A star-shaped glial cell that is part of some retina. This cell links neurons to blood vessels and may provide structural and physiological support to optic nerve head axons.\")\n32373:AnnotationAssertion(terms:contributor obo:CL_4033015 <https://orcid.org/0000-0001-6677-8489>)\n32374:AnnotationAssertion(terms:date obo:CL_4033015 \"2023-03-02T14:38:32Z\"^^xsd:dateTime)\n32375:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33796062\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033015 \"retinal astroglia\")\n32376:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32555229\") Annotation(oboInOwl:hasDbXref \"PMID:33796062\") rdfs:comment obo:CL_4033015 \"In response to elevated intraocular pressure, a retinal astrocyte may modulate extracellular matrix remodeling. In the human retina, a retinal astrocyte is GFAP-positive, SOD3-positive and GYPC-positive.\")\n32377:AnnotationAssertion(rdfs:label obo:CL_4033015 \"retinal astrocyte\")\n32378:EquivalentClasses(obo:CL_4033015 ObjectIntersectionOf(obo:CL_0000127 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000966)))\n32380:# Class: obo:CL_4033016 (secondary crest myofibroblast)\n32382:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\n32383:AnnotationAssertion(terms:contributor obo:CL_4033016 <https://orcid.org/0000-0001-6677-8489>)\n32384:AnnotationAssertion(terms:contributor o