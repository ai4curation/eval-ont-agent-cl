002770))\n34903:SubClassOf(obo:CL_4072008 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34905:# Class: obo:CL_4072009 (A12 dopaminergic neuron)\n34907:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39919032\") obo:IAO_0000115 obo:CL_4072009 \"A type of dopaminergic neuron found in the arcuate hypothalamic nucleus, involved in neuroendocrine regulation, metabolic homeostasis and prolactin secretion.\")\n34908:AnnotationAssertion(terms:date obo:CL_4072009 \"2025-05-02T10:43:50Z\"^^xsd:dateTime)\n34909:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39919032\") oboInOwl:hasExactSynonym obo:CL_4072009 \"hypothalamic arcuate nucleus dopaminergic neuron\")\n34910:AnnotationAssertion(rdfs:label obo:CL_4072009 \"A12 dopaminergic neuron\")\n34911:SubClassOf(obo:CL_4072009 obo:CL_0000700)\n34912:SubClassOf(obo:CL_4072009 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932))\n34913:SubClassOf(obo:CL_4072009 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34915:# Class: obo:CL_4072010 (A13 dopaminergic neuron)\n34917:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33318433\") Annotation(oboInOwl:hasDbXref \"PMID:37816347\") obo:IAO_0000115 obo:CL_4072010 \"A type of dopaminergic neuron located in the rostro-medial part of the zona incerta. It is involved in nociception and prehensile movement.\")\n34918:AnnotationAssertion(terms:date obo:CL_4072010 \"2025-05-02T14:46:33Z\"^^xsd:dateTime)\n34919:AnnotationAssertion(rdfs:label obo:CL_4072010 \"A13 dopaminergic neuron\")\n34920:SubClassOf(obo:CL_4072010 obo:CL_0000700)\n34921:SubClassOf(obo:CL_4072010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0036007))\n34922:SubClassOf(obo:CL_4072010 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34924:# Class: obo:CL_4072011 (A14 dopaminergic neuron)\n34926:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10465451\") Annotation(oboInOwl:hasDbXref \"PMID:19210380\") Annotation(oboInOwl:hasDbXref \"PMID:33257725\") Annotation(oboInOwl:hasDbXref \"PMID:36209152\") obo:IAO_0000115 obo:CL_4072011 \"A type of dopaminergic neuron located in the periventricular nucleus of the hypothalamus and projecting to the lateral septum and the median eminence. It is contributing to neuroendocrine functions, locomotion and stress regulation.\")\n34927:AnnotationAssertion(terms:date obo:CL_4072011 \"2025-05-06T12:46:22Z\"^^xsd:dateTime)\n34928:AnnotationAssertion(rdfs:label obo:CL_4072011 \"A14 dopaminergic neuron\")\n34929:SubClassOf(obo:CL_4072011 obo:CL_0000700)\n34930:SubClassOf(obo:CL_4072011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002322))\n34931:SubClassOf(obo:CL_4072011 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34933:# Class: obo:CL_4072012 (A15 dopaminergic neuron)\n34935:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26132331\") Annotation(oboInOwl:hasDbXref \"PMID:36209152\") obo:IAO_0000115 obo:CL_4072012 \"A type of dopaminergic neuron located in the preoptic periventricular nucleus of the hypothalamus and implicated in neuroendocrine modulation.\")\n34936:AnnotationAssertion(terms:date obo:CL_4072012 \"2025-05-06T13:00:54Z\"^^xsd:dateTime)\n34937:AnnotationAssertion(rdfs:label obo:CL_4072012 \"A15 dopaminergic neuron\")\n34938:SubClassOf(obo:CL_4072012 obo:CL_0000700)\n34939:SubClassOf(obo:CL_4072012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002622))\n34940:SubClassOf(obo:CL_4072012 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34942:# Class: obo:CL_4072013 (A16 dopaminergic neuron)\n34944:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28261065\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2023.08.29.554772\") obo:IAO_0000115 obo:CL_4072013 \"A type of dopaminergic interneuron located in the glomerular layer of the main olfactory bulb, characterized by the co-release of dopamine and GABA, and involved in modulating sensory input within olfactory circuits.\")\n34945:AnnotationAssertion(terms:date obo:CL_4072013 \"2025-05-06T13:12:14Z\"^^xsd:dateTime)\n34946:AnnotationAssertion(rdfs:label obo:CL_4072013 \"A16 dopaminergic neuron\")\n34947:SubClassOf(obo:CL_4072013 obo:CL_0000099)\n34948:SubClassOf(obo:CL_4072013 obo:CL_0000700)\n34949:SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005377))\n34950:SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34951:SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n34953:# Class: obo:CL_4072014 (tanycyte of vascular organ of lamina terminalis)\n34955:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") Annotation(oboInOwl:hasDbXref \"PMID:26017494\") obo:IAO_0000115 obo:CL_4072014 \"A specialized, non-ciliated ependymal glial cell located in the ventricular wall of the organum vasculosum of the lamina terminalis (OVLT) and characterized by elongated basal processes extending into the parenchyma to contact fenestrated capillaries. In mice, it is characterised by the expression of tight junction proteins (claudin 1, occludin, ZO-1) forming a continuous honeycomb junctional pattern. This cell contributes to a functional blood–cerebrospinal fluid (CSF) barrier at the ventricular interface of the OVLT.\")\n34956:AnnotationAssertion(terms:date obo:CL_4072014 \"2025-06-04T10:27:59Z\"^^xsd:dateTime)\n34957:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") oboInOwl:hasBroadSynonym obo:CL_4072014 \"Tanycyte-like cells in CVOs\")\n34958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like cell of OVLT\")\n34959:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like ependymal cell of OVLT\")\n34960:AnnotationAssertion(rdfs:label obo:CL_4072014 \"tanycyte of vascular organ of lamina terminalis\")\n34961:SubClassOf(obo:CL_4072014 obo:CL_0002085)\n34962:SubClassOf(obo:CL_4072014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002689))\n34964:# Class: obo:CL_4072015 (monocyte-derived Kupffer cell)\n34966:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26813785\") Annotation(oboInOwl:hasDbXref \"PMID:31561945\") Annotation(oboInOwl:hasDbXref \"PMID:37740916\") obo:IAO_0000115 obo:CL_4072015 \"A Kupffer cell located within the hepatic sinusoids, derived from circulating bone marrow monocytes that acquire the phenotypic markers and functional properties of resident Kupffer cells through niche-dependent imprinting, typically following depletion of the embryonically derived Kupffer cell population. During liver injury, MoKCs become the dominant Kupffer cell subset, exhibiting enhanced proliferation, resistance to apoptosis, and key roles in tissue repair and fibrosis attenuation.\")\n34967:AnnotationAssertion(terms:date obo:CL_4072015 \"2025-07-11T00:00:00Z\"^^xsd:dateTime)\n34968:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37740916\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072015 \"MoKC\")\n34969:AnnotationAssertion(rdfs:label obo:CL_4072015 \"monocyte-derived Kupffer cell\")\n34970:SubClassOf(obo:CL_4072015 obo:CL_0000091)\n34971:SubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281))\n34972:SubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000860))\n34974:# Class: obo:CL_4072016 (NPY interneuron)\n34976:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") Annotation(oboInOwl:hasDbXref \"PMID:32376782\") obo:IAO_0000115 obo:CL_4072016 \"An interneuron that expresses neuropeptide Y (NPY) and is mainly located in cortical layers II–III and VI, as well as in various brain regions such as the medial geniculate and inferior colliculus. The NPY cell population is physiologically diverse, displaying a range of firing behaviors, including adapting, fast-spiking, and accelerating patterns.\")\n34977:AnnotationAssertion(terms:date obo:CL_4072016 \"2025-07-07T09:04:45Z\"^^xsd:dateTime)\n34978:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32376782\") oboInOwl:hasExactSynonym obo:CL_4072016 \"NPY-expressing neuron\")\n34979:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") oboInOwl:hasRelatedSynonym obo:CL_4072016 \"NPY-expressing neocortical interneuron\")\n34980:AnnotationAssertion(rdfs:label obo:CL_4072016 \"NPY interneuron\")\n34981:SubClassOf(obo:CL_4072016 obo:CL_0000099)\n34982:SubClassOf(obo:CL_4072016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n34983:SubClassOf(obo:CL_4072016 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011387))\n34985:# Class: obo:CL_4072017 (agouti-related protein expressing neuron)\n34987:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34469623\") Annotation(oboInOwl:hasDbXref \"PMID:37957320\") Annotation(oboInOwl:hasDbXref \"PMID:39719709\") obo:IAO_0000115 obo:CL_4072017 \"A GABAergic neuron located in the arcuate nucleus of the hypothalamus that expresses agouti-related protein (AgRP). This neuron can coexpress AgRP, GABA, and neuropeptide Y (NPY) in mice, and plays a key role in integrating metabolic signals. It is activated by hunger-related hormones such as ghrelin and inhibited by satiety signals like leptin.\")\n34988:AnnotationAssertion(terms:date obo:CL_4072017 \"2025-07-07T09:55:43Z\"^^xsd:dateTime)\n34989:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39719709\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072017 \"AgRP neuron\")\n34990:AnnotationAssertion(rdfs:label obo:CL_4072017 \"agouti-related protein expressing neuron\")\n34991:SubClassOf(obo:CL_4072017 obo:CL_0000617)\n34992:SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932))\n34993:SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003846))\n34994:SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011387))\n34996:# Class: obo:CL_4072018 (pacemaker neuron)\n34998:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31982322\") Annotation(oboInOwl:hasDbXref \"PMID:39303139\") obo:IAO_0000115 obo:CL_4072018 \"A neuron that generates rhythmic bursts of action potentials independently of synaptic input. This intrinsic property enables it to maintain oscillatory activity even when isolated from other neurons. It populates the brainstem, hypothalamus, basal ganglia, spinal cord, and cerebellum. It plays a crucial role in regulating circadian rhythms in the suprachiasmatic nucleus, generating respiratory rhythms in the preBötzinger complex, and synchronizing neural networks.\")\n34999:AnnotationAssertion(terms:date obo:CL_4072018 \"2025-07-07T12:37:16Z\"^^xsd:dateTime)\n35000:AnnotationAssertion(rdfs:label obo:CL_4072018 \"pacemaker neuron\")\n35001:SubClassOf(obo:CL_4072018 obo:CL_0000540)\n35002:SubClassOf(obo:CL_4072018 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0019226))\n35004:# Class: obo:CL_4072019 (SCN pacemaker neuron)\n35006:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") Annotation(oboInOwl:hasDbXref \"PMID:32066983\") obo:IAO_0000115 obo:CL_4072019 \"A type of neuron located in the suprachiasmatic nucleus (SCN) that possesses intrinsic circadian rhythmicity, characterized by strong and rhythmic expression of core clock genes and the ability to independently generate and sustain circadian oscillations. In mice, the specific subtypes Avp+/Nms+, Vip+/Nms+, and Cck+/C1ql3+ neurons have the most robust circadian gene expression and contribute to synchronizing and maintaining rhythmicity within the SCN network (Wen et al., 2020).\")\n35007:AnnotationAssertion(terms:date obo:CL_4072019 \"2025-07-14T10:10:28Z\"^^xsd:dateTime)\n35008:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") oboInOwl:hasExactSynonym obo:CL_4072019 \"pacemaker neuron of the suprachiasmatic nucleus\")\n35009:AnnotationAssertion(rdfs:label obo:CL_4072019 \"SCN pacemaker neuron\")\n35010:SubClassOf(obo:CL_4072019 obo:CL_0000540)\n35011:SubClassOf(obo:CL_4072019 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002034))\n35013:# Class: obo:CL_4072021 (corticotropin-releasing neuron)\n35015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasDbXref \"PMID:2785663\") Annotation(oboInOwl:hasDbXref \"PMID:28790896\") Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasDbXref \"PMID:9662138\") obo:IAO_0000115 obo:CL_4072021 \"A specialised type of interneuron defined by the secretion of corticotropin-releasing hormone (CRH), a key peptide in activating the hypothalamic–pituitary–adrenal (HPA) axis during stress. It is primarily located in the paraventricular nucleus (PVN) of the hypothalamus, with additional presence in the hippocampus, piriform area, central amygdalar nucleus, Barrington’s nucleus, and inferior olivary complex (Peng et al., 2017).\")\n35016:AnnotationAssertion(terms:date obo:CL_4072021 \"2025-07-14T12:17:35Z\"^^xsd:dateTime)\n35017:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRF neuron\")\n35018:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRH neuron\")\n35019:AnnotationAssertion(rdfs:label obo:CL_4072021 \"corticotropin-releasing neuron\")\n35020:SubClassOf(obo:CL_4072021 obo:CL_0000099)\n35021:SubClassOf(obo:CL_4072021 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051458))\n35023:# Class: obo:CL_4072022 (Lamp5 Lhx6 GABAergic interneuron (Homo sapiens))\n35025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"PMID:38712198\") obo:IAO_0000115 obo:CL_4072022 \"A Lamp5 Lhx6 GABAergic interneuron of Homo sapiens. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', Lamp5 Lhx6\")\n35026:AnnotationAssertion(obo:RO_0002175 obo:CL_4072022 obo:NCBITaxon_9606)\n35027:AnnotationAssertion(terms:date obo:CL_4072022 \"2025-07-31T14:01:52Z\"^^xsd:dateTime)\n35028:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072022 \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\")\n35029:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") rdfs:comment obo:CL_4072022 \"Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.\")\n35030:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://zenodo.org/records/11165918\") rdfs:comment obo:CL_4072022 \"The marker set CHST9, LAMP5 can identify the Human cell type Lamp5 Lhx6 neuron in the neocortex with a confidence of 0.821678322 (NS-Forest FBeta value).\")\n35031:AnnotationAssertion(rdfs:label obo:CL_4072022 \"Lamp5 Lhx6 GABAergic interneuron (Homo sapiens)\")\n35032:SubClassOf(obo:CL_4072022 obo:CL_4042013)\n35033:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n35034:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35035:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35036:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148))\n35037:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032533))\n35038:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000075))\n35040:# Class: obo:CL_4072027 (sst GABAergic interneuron (Homo sapiens))\n35042:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072027 \"sst interneuron (Homo sapiens)\")\n35043:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072027 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst). The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Sst.\")\n35044:AnnotationAssertion(obo:RO_0002175 obo:CL_4072027 obo:NCBITaxon_9606)\n35045:AnnotationAssertion(terms:contributor obo:CL_4072027 \"https://orcid.org/0000-0002-5507-2103\")\n35046:AnnotationAssertion(terms:date obo:CL_4072027 \"2025-08-12T10:45:41Z\"^^xsd:dateTime)\n35047:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072027 \"ILX:0770152\")\n35048:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SOM+ inhibitory interneuron (Homo sapiens)\")\n35049:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SST+ IN (Homo sapiens)\")\n35050:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 