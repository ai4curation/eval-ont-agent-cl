produces thyroid stimulating hormone, thyrotrophin. This cell type is elongated, polygonal and lie in clusters towards the adenohypophyseal center.\")\n7814:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000476 \"FMA:83099\")\n7815:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000476 \"MESH:D052684\")\n7816:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"beta-basophil\")\n7817:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"thyroid stimulating hormone secreting cell\")\n7818:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000476 \"thyrotrope\")\n7819:AnnotationAssertion(rdfs:label obo:CL_0000476 \"thyrotroph\")\n7820:SubClassOf(obo:CL_0000476 obo:CL_0000639)\n7821:SubClassOf(obo:CL_0000476 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070460))\n7823:# Class: obo:CL_0000477 (follicle cell of egg chamber)\n7825:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000477 \"A somatic epithelial cell of the insect egg chamber.\")\n7826:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000477 \"follicle cell\")\n7827:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000477 \"ovarian follicle cell\")\n7828:AnnotationAssertion(rdfs:label obo:CL_0000477 \"follicle cell of egg chamber\")\n7829:SubClassOf(obo:CL_0000477 obo:CL_0000500)\n7830:SubClassOf(obo:CL_0000477 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\n7831:SubClassOf(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:CL_0000477 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7832:SubClassOf(obo:CL_0000477 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000441))\n7834:# Class: obo:CL_0000478 (oxytocin stimulating hormone secreting cell)\n7836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000478 \"A peptide hormone secreting cell that secretes oxytocin stimulating hormone\")\n7837:AnnotationAssertion(rdfs:label obo:CL_0000478 \"oxytocin stimulating hormone secreting cell\")\n7838:SubClassOf(obo:CL_0000478 obo:CL_0000167)\n7840:# Class: obo:CL_0000479 (vasopressin stimulating hormone secreting cell)\n7842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000479 \"A peptide hormone secreting cell that secretes vasopressin stimulating hormone\")\n7843:AnnotationAssertion(rdfs:label obo:CL_0000479 \"vasopressin stimulating hormone secreting cell\")\n7844:SubClassOf(obo:CL_0000479 obo:CL_0000167)\n7846:# Class: obo:CL_0000480 (secretin stimulating hormone secreting cell)\n7848:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000480 \"A peptide hormone secreting cell that secretes secretin stimulating hormone\")\n7849:AnnotationAssertion(rdfs:label obo:CL_0000480 \"secretin stimulating hormone secreting cell\")\n7850:SubClassOf(obo:CL_0000480 obo:CL_0000167)\n7852:# Class: obo:CL_0000481 (cholecystokin stimulating hormone secreting cell)\n7854:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000481 \"A peptide hormone secreting cell that secretes cholecystokin stimulating hormone.\")\n7855:AnnotationAssertion(rdfs:label obo:CL_0000481 \"cholecystokin stimulating hormone secreting cell\")\n7856:SubClassOf(obo:CL_0000481 obo:CL_0000167)\n7858:# Class: obo:CL_0000482 (juvenile hormone secreting cell)\n7860:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000482 \"An endocrine cell that secretes juvenile hormone.\")\n7861:AnnotationAssertion(rdfs:label obo:CL_0000482 \"juvenile hormone secreting cell\")\n7862:EquivalentClasses(obo:CL_0000482 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045443)))\n7864:# Class: obo:CL_0000483 (bombesin stimulating hormone secreting cell)\n7866:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000483 \"A peptide hormone secreting cell that secretes bombesin stimulating hormone.\")\n7867:AnnotationAssertion(rdfs:label obo:CL_0000483 \"bombesin stimulating hormone secreting cell\")\n7868:SubClassOf(obo:CL_0000483 obo:CL_0000167)\n7870:# Class: obo:CL_0000484 (connective tissue type mast cell)\n7872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19923473\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") obo:IAO_0000115 obo:CL_0000484 \"Mast cell subtype whose granules contain both the serine proteases tryptase and chymase. These cells are primarily found in connective tissue, such as the peritoneal cavity, skin, and intestinal submucosa. Their development is T-cell independent.\")\n7873:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"MC(TC)\")\n7874:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"MCTC\")\n7875:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000484 \"TC mast cells\")\n7876:AnnotationAssertion(rdfs:comment obo:CL_0000484 \"They are CD88-positive. The cytoplasmic granules contain high levels of histamine and heparin (mouse) or major neutral proteases, tryptase, chymase, carboxypeptidase A, and cathepsin G (humans). Reportedly, they cannot produce leukotrienes (LTC4) and IL-4. They are reportedly very heterogeneous depending upon location and can convert to the MC(T) phenotype.\")\n7877:AnnotationAssertion(rdfs:label obo:CL_0000484 \"connective tissue type mast cell\")\n7878:EquivalentClasses(obo:CL_0000484 ObjectIntersectionOf(obo:CL_0000097 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002384)))\n7879:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000484 obo:CL_0000097)\n7881:# Class: obo:CL_0000485 (mucosal type mast cell)\n7883:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMID:19923473\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") obo:IAO_0000115 obo:CL_0000485 \"Mast cell subtype that contains only the serine protease trypase in its granules. These cells are primarily found in mucosal tissue, such as intestinal mucosa and alveoli. They depend upon T-cells for development of phenotype.\")\n7884:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"MC(T)\")\n7885:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"MCT\")\n7886:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000485 \"T mast cells\")\n7887:AnnotationAssertion(rdfs:comment obo:CL_0000485 \"They are CD88-negative. The cytoplasmic granules contain low levels of histamine and high levels of chondroitin sulfate (mouse) or major neutral proteases and tryptase (humans). Additionally, they can produce leukotrienes (LTC4), IL-5, IL-6, and low levels of IL-4. They are reportedly very heterogeneous depending upon location and can convert to the MC(T) phenotype.\")\n7888:AnnotationAssertion(rdfs:label obo:CL_0000485 \"mucosal type mast cell\")\n7889:EquivalentClasses(obo:CL_0000485 ObjectIntersectionOf(obo:CL_0000097 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001961) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002540)))\n7890:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000485 obo:CL_0000097)\n7892:# Class: obo:CL_0000486 (garland cell)\n7894:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19783135\") Annotation(oboInOwl:hasDbXref \"fbbt:00005059\") obo:IAO_0000115 obo:CL_0000486 \"A large binucleate cell that forms a 'garland' around the anterior end of the proventriculus (cardia) at its junction with the esophagus in both adults and larvae flies. Each cell is surrounded by a basement membrane and there are numerous micro-invaginations (lacunae) extending from the surface into the cytoplasm. At the mouth of each lacuna is a doubled filament forming a specialised filtration system (diaphragm). The filtrate is endocytosed from the lacunae.\")\n7895:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0061321\") oboInOwl:hasBroadSynonym obo:CL_0000486 \"garland nephrocyte\")\n7896:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000486 \"BTO:0004596\")\n7897:AnnotationAssertion(rdfs:label obo:CL_0000486 \"garland cell\")\n7898:SubClassOf(obo:CL_0000486 obo:CL_0000227)\n7899:SubClassOf(obo:CL_0000486 obo:CL_0000519)\n7900:SubClassOf(obo:CL_0000486 obo:CL_0002520)\n7902:# Class: obo:CL_0000487 (oenocyte)\n7904:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:bf\") Annotation(oboInOwl:hasDbXref \"PMID:11171397\") Annotation(oboInOwl:hasDbXref \"PMID:24397521\") Annotation(oboInOwl:hasDbXref \"PMID:34208190\") Annotation(oboInOwl:hasDbXref \"https://www.merriam-webster.com/dictionary/oenocyte\") obo:IAO_0000115 obo:CL_0000487 \"A secretory cell of ectodermal origin. This cell may have important functions in fatty acid and hydrocarbon metabolism and is metabolically linked to the fat body and tracheae. This cell is exclusive of arthropods.\")\n7905:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24397521\") Annotation(oboInOwl:hasDbXref \"PMID:34208190\") rdfs:comment obo:CL_0000487 \"Oenocytes are highly variable in size, shape, cluster formation and anatomical location. In adults, oenocytes tend to be smaller but more numerous than in larvae. While oenocytes have been found in arachnids and crustaceans, they have been most abundantly described in insects.\")\n7906:AnnotationAssertion(rdfs:label obo:CL_0000487 \"oenocyte\")\n7907:SubClassOf(obo:CL_0000487 obo:CL_0000151)\n7908:SubClassOf(obo:CL_0000487 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7910:# Class: obo:CL_0000488 (visible light photoreceptor cell)\n7912:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000488 \"A photoreceptor cell that detects visible light.\")\n7913:AnnotationAssertion(rdfs:label obo:CL_0000488 \"visible light photoreceptor cell\")\n7914:EquivalentClasses(obo:CL_0000488 ObjectIntersectionOf(obo:CL_0000210 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0009584)))\n7915:SubClassOf(obo:CL_0000488 obo:CL_0000210)\n7917:# Class: obo:CL_0000489 (scotopic photoreceptor cell)\n7919:AnnotationAssertion(rdfs:label obo:CL_0000489 \"scotopic photoreceptor cell\")\n7920:SubClassOf(obo:CL_0000489 obo:CL_0000210)\n7922:# Class: obo:CL_0000490 (photopic photoreceptor cell)\n7924:AnnotationAssertion(rdfs:label obo:CL_0000490 \"photopic photoreceptor cell\")\n7925:SubClassOf(obo:CL_0000490 obo:CL_0000488)\n7927:# Class: obo:CL_0000491 (obsolete cytotoxic T cell)\n7929:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000491 \"OBSOLETE: A cell responsible for spontaneous cytotoxicity of a variety of tumor cells without prior immunization. These natural killer cells are found in non-immune humans and experimental animals and are thought by some to be the same as killer cells (killing by antibody-dependent cell cytotoxicity), but they can also kill in the absence of antibody.\")\n7930:AnnotationAssertion(rdfs:comment obo:CL_0000491 \"This term had an incorrect definition and was overly broad. Consider using 'cytotoxic T cell ; CL:0000910' (in most cases) or another lymphocyte cell type if cytotoxicity is shown to be part of the cell's phenotype in a particular experimental situation.\")\n7931:AnnotationAssertion(rdfs:label obo:CL_0000491 \"obsolete cytotoxic T cell\")\n7932:AnnotationAssertion(owl:deprecated obo:CL_0000491 \"true\"^^xsd:boolean)\n7934:# Class: obo:CL_0000492 (CD4-positive helper T cell)\n7936:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"MESH:D006377\") obo:IAO_0000115 obo:CL_0000492 \"A CD4-positive, alpha-beta T cell that cooperates with other lymphocytes via direct contact or cytokine release to initiate a variety of immune functions.\")\n7937:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000492 \"CALOHA:TS-1146\")\n7938:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000492 \"FMA:70572\")\n7939:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive T-helper cell\")\n7940:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T lymphocyte\")\n7941:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T-cell\")\n7942:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000492 \"CD4-positive helper T-lymphocyte\")\n7943:AnnotationAssertion(rdfs:label obo:CL_0000492 \"CD4-positive helper T cell\")\n7944:EquivalentClasses(obo:CL_0000492 ObjectIntersectionOf(obo:CL_0000624 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816)))\n7945:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000492 obo:CL_0000624)\n7946:SubClassOf(obo:CL_0000492 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000896))\n7947:SubClassOf(obo:CL_0000492 ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0030217))\n7949:# Class: obo:CL_0000493 (obsolete regulatory T cell)\n7951:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000493 \"OBSOLETE: Subpopulation of CD4+ cells which induce CD8+ suppressor T cells to suppress antibody production by B cells. They also stimulate other cellular immune responses.\")\n7952:AnnotationAssertion(rdfs:comment obo:CL_0000493 \"This term was defined too narrowly; consider using the term 'regulatory T cell ; CL:0000815' instead.\")\n7953:AnnotationAssertion(rdfs:label obo:CL_0000493 \"obsolete regulatory T cell\")\n7954:AnnotationAssertion(owl:deprecated obo:CL_0000493 \"true\"^^xsd:boolean)\n7956:# Class: obo:CL_0000494 (UV sensitive photoreceptor cell)\n7958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000494 \"A photoreceptor cell that detects ultraviolet light.\")\n7959:AnnotationAssertion(rdfs:label obo:CL_0000494 \"UV sensitive photoreceptor cell\")\n7960:EquivalentClasses(obo:CL_0000494 ObjectIntersectionOf(obo:CL_0000210 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0009589)))\n7961:SubClassOf(obo:CL_0000494 obo:CL_0000210)\n7963:# Class: obo:CL_0000495 (blue sensitive photoreceptor cell)\n7965:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000495 \"A photoreceptor cell that is sensitive to blue light.\")\n7966:AnnotationAssertion(rdfs:label obo:CL_0000495 \"blue sensitive photoreceptor cell\")\n7967:SubClassOf(obo:CL_0000495 obo:CL_0000490)\n7969:# Class: obo:CL_0000496 (green sensitive photoreceptor cell)\n7971:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000496 \"A photoreceptor cell that is sensitive to green light.\")\n7972:AnnotationAssertion(rdfs:label obo:CL_0000496 \"green sensitive photoreceptor cell\")\n7973:SubClassOf(obo:CL_0000496 obo:CL_0000490)\n7975:# Class: obo:CL_0000497 (red sensitive photoreceptor cell)\n7977:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000497 \"A photoreceptor cell that is sensitive to red light.\")\n7978:AnnotationAssertion(rdfs:label obo:CL_0000497 \"red sensitive photoreceptor cell\")\n7979:SubClassOf(obo:CL_0000497 obo:CL_0000490)\n7981:# Class: obo:CL_0000498 (inhibitory interneuron)\n7983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Interneuron\") obo:IAO_0000115 obo:CL_0000498 \"An interneuron (also called relay neuron, association neuron or local circuit neuron) is a multipolar neuron which connects afferent neurons and efferent neurons in neural pathways. Like motor neurons, interneuron cell bodies are always located in the central nervous system (CNS).\")\n7984:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000498 \"FMA:84776\")\n7985:AnnotationAssertion(rdfs:label obo:CL_0000498 \"inhibitory interneuron\")\n7986:SubClassOf(obo:CL_0000498 obo:CL_0000099)\n7988:# Class: obo:CL_0000499 (stromal cell)\n7990:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D017154\") obo:IAO_0000115 obo:CL_0000499 \"A connective tissue cell of an organ found in the loose connective tissue.\")\n7991:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000499 \"BTO:0002064\")\n7992:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000499 \"FMA:83624\")\n7993:AnnotationAssertion(rdfs:label obo:CL_0000499 \"stromal cell\")\n7994:SubClassOf(obo:CL_0000499 obo:CL_0002320)\n7995:SubClassOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000134))\n7997:# Class: obo:CL_0000500 (follicular epithelial cell)\n7999:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000500 \"An epithelial somatic cell associated with a maturing oocyte.\")\n8000:AnnotationAssertion(rdfs:label obo:CL_0000500 \"follicular epithelial cell\")\n8001:SubClassOf(obo:CL_0000500 obo:CL_0000066)\n8003:# Class: obo:CL_0000501 (granulosa cell)\n8005:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006107\") obo:IAO_0000115 obo:CL_0000501 \"A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.\")\n8006:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"BTO:0000542\")\n8007:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"CALOHA:TS-0729\")\n8008:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000501 \"FMA:18718\")\n8009:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000501 \"granulosa cell of ovary\")\n8010:AnnotationAssertion(rdfs:label obo:CL_0000501 \"granulosa cell\")\n8011:SubClassOf(obo:CL_0000501 obo:CL_0000174)\n8012:SubClassOf(obo:CL_0000501 obo:CL_0002174)\n8013:SubClassOf(obo:CL_0000501 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4033066))\n8015:# Class: obo:CL_0000502 (type D enteroendocrine cell)\n8017:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D019864\") obo:IAO_0000115 obo:CL_0000502 \"A cell found throughout the gastrointestinal tract and in the pancreas. They secrete somatostatin in both an endocrine and paracrine manner. Somatostatin inhibits gastrin, cholecystokinin, insulin, glucagon, pancreatic enzymes, and gastric hydrochloric acid. A variety of substances which inhibit gastric acid secretion (vasoactive intestinal peptide, calcitonin gene-related peptide, cholecystokinin, beta-adrenergic agonists, and gastric inhibitory peptide) are thought to act by releasing somatostatin.\")\n8018:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000502 \"FMA:62935\")\n8019:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000502 \"D cell\")\n8020:AnnotationAssertion(rdfs:label obo:CL_0000502 \"type D enteroendocrine cell\")\n8021:SubClassOf(obo:CL_0000502 obo:CL_0000164)\n8022:SubClassOf(obo:CL_0000502 obo:CL_0000165)\n8023:SubClassOf(obo:CL_0000502 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070253))\n8025:# Class: obo:CL_0000503 (theca cell)\n8027:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D013799\") Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") obo:IAO_0000115 obo:CL_0000503 \"A specialized stromal cell that forms the theca layer outside the basal lamina lining the ovarian follicle, appearing during the secondary follicle stage.\")\n8028:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000503 \"BTO:0002850\")\n8029:AnnotationAssertion(rdfs:label obo:CL_0000503 \"theca cell\")\n8030:SubClassOf(obo:CL_0000503 obo:CL_0000499)\n8031:SubClassOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000155))\n8033:# Class: obo:CL_0000504 (enterochromaffin-like cell)\n8035:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D019861\") obo:IAO_0000115 obo:CL_0000504 \"A enteroendocrine cell part of the glands of the gastric mucosa. They produce histamine and peptides such as chromogranins. This cell type respond to gastrin by releasing histamine which acts as a paracrine stimulator of the release of hydrochloric acid from the gastric parietal cells.\")\n8036:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000504 \"BTO:0002692\")\n8037:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000504 \"ECL\")\n8038:AnnotationAssertion(rdfs:comment obo:CL_0000504 \"Consider enterochromaffin cell (CL:0002065). For several years this cell type was \\\"enterochromaffin cell\\\" despite a MESH dbxref and a free text definition that clearly meant enterochromaffin-like cell.\")\n8039:AnnotationAssertion(rdfs:label obo:CL_0000504 \"enterochromaffin-like cell\")\n8040:SubClassOf(obo:CL_0000504 obo:CL_0000164)\n8041:SubClassOf(obo:CL_0000504 obo:CL_0002274)\n8043:# Class: obo:CL_0000505 (substance P secreting cell)\n8045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000505 \"A peptide hormone secreting cell that secretes substance P.\")\n8046:AnnotationAssertion(rdfs:label obo:CL_0000505 \"substance P secreting cell\")\n8047:SubClassOf(obo:CL_0000505 obo:CL_0000167)\n8049:# Class: obo:CL_0000506 (enkephalin secreting cell)\n8051:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000506 \"An endorphine cell that secretes enkephalin.\")\n8052:AnnotationAssertion(rdfs:label obo:CL_0000506 \"enkephalin secreting cell\")\n8053:SubClassOf(obo:CL_0000506 obo:CL_0000507)\n8055:# Class: obo:CL_0000507 (endorphin secreting cell)\n8057:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000507 \"A peptide hormone secreting cell that secretes endorphin.\")\n8058:AnnotationAssertion(rdfs:label obo:CL_0000507 \"endorphin secreting cell\")\n8059:S