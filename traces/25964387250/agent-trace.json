06))\n35136:SubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_O76070))\n35137:SubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000081))\n35139:# Class: obo:CL_4072036 (PAX6 GABAergic interneuron (Homo sapiens))\n35141:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072036 \"Pax6 interneuron (Homo sapiens)\")\n35142:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072036 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses the transcript PAX6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters PAX\")\n35143:AnnotationAssertion(obo:RO_0002175 obo:CL_4072036 obo:NCBITaxon_9606)\n35144:AnnotationAssertion(terms:contributor obo:CL_4072036 \"https://orcid.org/0000-0002-5507-2103\")\n35145:AnnotationAssertion(terms:date obo:CL_4072036 \"2025-09-10T08:47:34Z\"^^xsd:dateTime)\n35146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072036 \"The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).\")\n35147:AnnotationAssertion(rdfs:label obo:CL_4072036 \"PAX6 GABAergic interneuron (Homo sapiens)\")\n35148:SubClassOf(obo:CL_4072036 obo:CL_4042032)\n35149:SubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35150:SubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000079))\n35152:# Class: obo:CL_4072037 (L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35154:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\n35155:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072037 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L2/3 IT.\")\n35156:AnnotationAssertion(obo:RO_0002175 obo:CL_4072037 obo:NCBITaxon_9606)\n35157:AnnotationAssertion(terms:contributor obo:CL_4072037 \"https://orcid.org/0000-0002-5507-2103\")\n35158:AnnotationAssertion(terms:date obo:CL_4072037 \"2025-09-10T09:15:51Z\"^^xsd:dateTime)\n35159:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072037 \"ILX:0770156\")\n35160:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\n35161:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072037 cl:cellxgene_subset)\n35162:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072037 \"The marker set ONECUT2, COL5A2 can identify the Human cell type L2/3 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.670149932 (NS-Forest FBeta value).\")\n35163:AnnotationAssertion(rdfs:label obo:CL_4072037 \"L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35164:SubClassOf(obo:CL_4072037 obo:CL_4030059)\n35165:SubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35166:SubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000065))\n35168:# Class: obo:CL_4072038 (L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35170:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072038 \"L5 IT (Homo sapiens)\")\n35171:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072038 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L5 IT.\")\n35172:AnnotationAssertion(obo:RO_0002175 obo:CL_4072038 obo:NCBITaxon_9606)\n35173:AnnotationAssertion(terms:contributor obo:CL_4072038 \"https://orcid.org/0000-0002-5507-2103\")\n35174:AnnotationAssertion(terms:date obo:CL_4072038 \"2025-09-10T09:47:23Z\"^^xsd:dateTime)\n35175:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072038 \"ILX:0770157\")\n35176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072038 \"L5 IT (Homo sapiens)\")\n35177:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072038 cl:cellxgene_subset)\n35178:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\n35179:AnnotationAssertion(rdfs:label obo:CL_4072038 \"L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35180:SubClassOf(obo:CL_4072038 obo:CL_4030064)\n35181:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35182:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000068))\n35184:# Class: obo:CL_4072039 (L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35186:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072039 \"L4 IT (Homo sapiens)\")\n35187:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072039 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L4 IT.\")\n35188:AnnotationAssertion(obo:RO_0002175 obo:CL_4072039 obo:NCBITaxon_9606)\n35189:AnnotationAssertion(terms:date obo:CL_4072039 \"2025-09-10T10:05:26Z\"^^xsd:dateTime)\n35190:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRela