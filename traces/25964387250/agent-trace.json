4029001 \"A cell that supports the development of a gamete by providing it cytoplasmic material (including entire organelles) by direct cross-membrane channels (del Pino, 2021).\")\n31520:AnnotationAssertion(terms:contributor obo:CL_4029001 <http://orcid.org/0000-0002-6095-8718>)\n31521:AnnotationAssertion(terms:date obo:CL_4029001 \"2022-06-08T15:29:54Z\"^^xsd:dateTime)\n31522:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4029001 \"BTO:0000953\")\n31523:AnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029001 \"cell\")\n31524:AnnotationAssertion(rdfs:label obo:CL_4029001 \"gamete-nursing cell\")\n31525:SubClassOf(obo:CL_4029001 obo:CL_0000000)\n31527:# Class: obo:CL_4029002 (germline-derived nurse cell)\n31529:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029002 \"A gamete-nursing cell that derives from a germline cell (del Pino, 2021).\")\n31530:AnnotationAssertion(terms:contributor obo:CL_4029002 <http://orcid.org/0000-0002-6095-8718>)\n31531:AnnotationAssertion(terms:date obo:CL_4029002 \"2022-06-08T15:32:29Z\"^^xsd:dateTime)\n31532:AnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029002 \"cell\")\n31533:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1126/science.aad2156\") rdfs:comment obo:CL_4029002 \"Nurse cells were first described in insects, but recent works suggest they also exist in some mammals (Lei and Spradling, 2016).\")\n31534:AnnotationAssertion(rdfs:label obo:CL_4029002 \"germline-derived nurse cell\")\n31535:SubClassOf(obo:CL_4029002 obo:CL_0000039)\n31536:SubClassOf(obo:CL_4029002 obo:CL_4029001)\n31538:# Class: obo:CL_4029003 (somatic nurse-like cell)\n31540:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/bs.ctdb.2020.10.008\") obo:IAO_0000115 obo:CL_4029003 \"A gamete-nursing cell that derives from the somatic tissues of the gonad (del Pino, 2021).\")\n31541:AnnotationAssertion(terms:contributor obo:CL_4029003 <http://orcid.org/0000-0002-6095-8718>)\n31542:AnnotationAssertion(terms:date obo:CL_4029003 \"2022-06-08T15:38:03Z\"^^xsd:dateTime)\n31543:AnnotationAssertion(oboInOwl:hasOBONamespace obo:CL_4029003 \"cell\")\n31544:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1111/andr.12165\") rdfs:comment obo:CL_4029003 \"We follow what seems to be a common usage in the literature, which is to reserve the term “nurse cell” proper to cells from the germ line, hence the label “nurse-like”. This term encompasses pyriform cells described in reptiles, bird, and amphibians (del Pino, 2021); it does not encompass mammalian Sertoli cells, which do not appear to transfer cytoplasmic material to spermatogonia (França et al., 2016).\")\n31545:AnnotationAssertion(rdfs:label obo:CL_4029003 \"somatic nurse-like cell\")\n31546:SubClassOf(obo:CL_4029003 obo:CL_4029001)\n31548:# Class: obo:CL_4030000 (choroidal melanocyte)\n31550:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_4030000 \"A melanocyte located in the vascular uvea and involved in photoprotection, regulation of oxidative damage and immune responses.\")\n31551:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030000 \"2022-01-20T12:59:06Z\"^^xsd:dateTime)\n31552:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030000 \"uveal melanocyte\")\n31553:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31819095\") Annotation(oboInOwl:hasDbXref \"PMID:34082079\") rdfs:comment obo:CL_4030000 \"Cellular functions and extracellular interactions of choroidal melanocytes are distinct to skin melanocytes. They might have both neuroectodermal as well as mesectodermal origins.\")\n31554:AnnotationAssertion(rdfs:label obo:CL_4030000 \"choroidal melanocyte\")\n31555:EquivalentClasses(obo:CL_4030000 ObjectIntersectionOf(obo:CL_0000148 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001768)))\n31557:# Class: obo:CL_4030001 (stromal cell of thymus)\n31559:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030001 \"A stromal cell that is part of the thymus.\")\n31560:AnnotationAssertion(terms:date obo:CL_4030001 \"2022-07-08T11:39:38Z\"^^xsd:dateTime)\n31561:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030001 \"thymic stromal cell\")\n31562:AnnotationAssertion(rdfs:label obo:CL_4030001 \"stromal cell of thymus\")\n31563:EquivalentClasses(obo:CL_4030001 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002370)))\n31565:# Class: obo:CL_4030002 (effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated)\n31567:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2825-0621\") obo:IAO_0000115 obo:CL_4030002 \"An alpha-beta memory T cell with the phenotype CD45RA-positive.\")\n31568:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030002 \"2022-02-01T13:04:46Z\"^^xsd:dateTime)\n31569:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"TEMRA\")\n31570:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16237082\") oboInOwl:hasBroadSynonym obo:CL_4030002 \"effector memory RA T cell\")\n31571:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"TEMRA cell\")\n31572:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25104859\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory CD45RA+ T cells\")\n31573:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/T_cell#Memory_T_cells\") oboInOwl:hasExactSynonym obo:CL_4030002 \"terminally differentiated effector memory cells re-expressing CD45RA\")\n31574:AnnotationAssertion(rdfs:label obo:CL_4030002 \"effector memory CD45RA-positive, alpha-beta T cell, terminally differentiated\")\n31575:SubClassOf(obo:CL_4030002 obo:CL_0000791)\n31577:# Class: obo:CL_4030003 (interstitial cell of thymus)\n31579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-20082-7\") obo:IAO_0000115 obo:CL_4030003 \"A cell that makes up the loose connective tissue of the thymus.\")\n31580:AnnotationAssertion(terms:date obo:CL_4030003 \"2022-07-08T11:48:36Z\"^^xsd:dateTime)\n31581:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030003 \"thymic interstitial cell\")\n31582:AnnotationAssertion(rdfs:label obo:CL_4030003 \"interstitial cell of thymus\")\n31583:SubClassOf(obo:CL_4030003 obo:CL_4030001)\n31585:# Class: obo:CL_4030004 (thymic nurse cell)\n31587:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Thymic_nurse_cell\") obo:IAO_0000115 obo:CL_4030004 \"A large epithelial cell found in the thymus. This cell type may internalize thymocytes through extensions of plasma membrane. The cell surface and cytoplasmic vacuoles of a thymic nurse cell express MHC Class I and MHC Class II antigens. The interaction of these antigens with a developing thymocyte determines whether the thymocyte undergoes positive or negative selection.\")\n31588:AnnotationAssertion(terms:contributor obo:CL_4030004 <https://orcid.org/0000-0002-0819-0473>)\n31589:AnnotationAssertion(terms:date obo:CL_4030004 \"2022-02-18T12:43:20Z\"^^xsd:dateTime)\n31590:AnnotationAssertion(rdfs:label obo:CL_4030004 \"thymic nurse cell\")\n31591:SubClassOf(obo:CL_4030004 obo:CL_0002293)\n31593:# Class: obo:CL_4030005 (kidney collecting duct beta-intercalated cell)\n31595:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24051376\") Annotation(oboInOwl:hasDbXref \"PMID:31300091\") Annotation(oboInOwl:hasDbXref \"PMID:32016094\") obo:IAO_0000115 obo:CL_4030005 \"A renal beta-intercalated cell that is part of the cortical collecting duct. The medullary collecting duct does not contain the renal beta-intercalated cell type.\")\n31596:AnnotationAssertion(terms:date obo:CL_4030005 \"2022-09-14T16:19:11Z\"^^xsd:dateTime)\n31597:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_4030005 \"B-IC\")\n31598:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_4030005 \"kidney collecting duct intercalated cell type B\")\n31599:AnnotationAssertion(rdfs:label obo:CL_4030005 \"kidney collecting duct beta-intercalated cell\")\n31600:EquivalentClasses(obo:CL_4030005 ObjectIntersectionOf(obo:CL_0002201 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004203)))\n31602:# Class: obo:CL_4030006 (fallopian tube secretory epithelial cell)\n31604:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1186/1477-7827-7-129\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.3390/cells8080933\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") obo:IAO_0000115 obo:CL_4030006 \"An epithelial cell that is part of the fallopian tube that secretes mucus and oviduct-specific products in response to hormonal stimulation from estrogen and luteinizing hormone. This fallopian tube secretory cell is similar in height to the ciliated cell, but typically exhibits a more narrow, columnar shape. Its nucleus is ovoid and oriented perpendicular to the cell's long axis, with denser chromatin and a smaller nucleolus compared to the ciliated cell.\")\n31605:AnnotationAssertion(terms:contributor obo:CL_4030006 <https://orcid.org/0000-0002-0819-0473>)\n31606:AnnotationAssertion(terms:date obo:CL_4030006 \"2022-03-03T10:39:31Z\"^^xsd:dateTime)\n31607:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030006 \"oviduct secretory epithelial cell\")\n31608:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030006 \"uterine tube secretory epithelial cell\")\n31609:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.ccr.2013.10.013\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/learn/dictionary/normal/fallopian+tube\") rdfs:comment obo:CL_4030006 \"The other cell types of the fallopian tube epithelium include the ciliated cell and the intercalary cell, or peg cell. The fallopian tube secretory epithelial cell type has been implicated as a source of high-grade serous ovarian carcinoma.\")\n31610:AnnotationAssertion(rdfs:label obo:CL_4030006 \"fallopian tube secretory epithelial cell\")\n31611:SubClassOf(obo:CL_4030006 obo:CL_1001591)\n31612:SubClassOf(obo:CL_4030006 obo:CL_4052019)\n31613:SubClassOf(obo:CL_4030006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n31615:# Class: obo:CL_4030007 (fallopian tube multiciliated epithelial cell)\n31617:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16565155\") Annotation(oboInOwl:hasDbXref \"https://www.proteinatlas.org/humanproteome/tissue/fallopian+tube\") obo:IAO_0000115 obo:CL_4030007 \"A multi-ciliated epithelial cell that is part of the fallopian tube, mainly found on the apex of the mucosal folds. This cell exhibits a columnar shape with an oval nucleus and is characterized by the presence of cilia on its surface. The coordinated beating of these cilia, together with peristaltic contractions, contributes to the self-propulsion of spermatozoa, the transport of ovum during ovulation and the transport of the fertilized ovum to the intramural fallopian tube.\")\n31618:AnnotationAssertion(terms:contributor obo:CL_4030007 <https://orcid.org/0000-0002-0819-0473>)\n31619:AnnotationAssertion(terms:date obo:CL_4030007 \"2022-03-08T12:40:19Z\"^^xsd:dateTime)\n31620:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4030007 \"oviduct ciliated cell\")\n31621:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube ciliated cell\")\n31622:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"fallopian tube multiciliated cell\")\n31623:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030007 \"uterine tube ciliated epithelial cell\")\n31624:AnnotationAssertion(rdfs:label obo:CL_4030007 \"fallopian tube multiciliated epithelial cell\")\n31625:SubClassOf(obo:CL_4030007 obo:CL_0005012)\n31626:SubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n31627:SubClassOf(obo:CL_4030007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007589))\n31629:# Class: obo:CL_4030008 (pronephric podocyte)\n31631:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10322630\") obo:IAO_0000115 obo:CL_4030008 \"A specialized epithelial cell that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other glomerular epithelial cells in the pronephros.\")\n31632:AnnotationAssertion(terms:contributor obo:CL_4030008 <https://orcid.org/0000-0002-2244-7917>)\n31633:AnnotationAssertion(terms:date obo:CL_4030008 \"2022-03-11T14:38:32Z\"^^xsd:dateTime)\n31634:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0001673\") oboInOwl:hasExactSynonym obo:CL_4030008 \"pronephric glomerular visceral epithelial cell\")\n31635:AnnotationAssertion(rdfs:label obo:CL_4030008 \"pronephric podocyte\")\n31636:EquivalentClasses(obo:CL_4030008 ObjectIntersectionOf(obo:CL_0000653 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002120)))\n31637:SubClassOf(obo:CL_4030008 obo:CL_0000653)\n31639:# Class: obo:CL_4030009 (epithelial cell of proximal tubule segment 1)\n31641:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030009 \"A brush border cell that is part of segment 1 (S1) of the proximal tubule epithelium, located in the renal cortex.\")\n31642:AnnotationAssertion(terms:date obo:CL_4030009 \"2022-05-10T13:14:00Z\"^^xsd:dateTime)\n31643:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030009 \"epithelial cell of segment 1 of proximal tubule\")\n31644:AnnotationAssertion(rdfs:label obo:CL_4030009 \"epithelial cell of proximal tubule segment 1\")\n31645:EquivalentClasses(obo:CL_4030009 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004196) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31646:SubClassOf(obo:CL_4030009 obo:CL_0002307)\n31648:# Class: obo:CL_4030010 (epithelial cell of proximal tubule segment 2)\n31650:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:23897681\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") Annotation(oboInOwl:hasDbXref \"PMID:31253652\") obo:IAO_0000115 obo:CL_4030010 \"A brush border cell that is part of segment 2 (S2) of the proximal tubule epithelium, located in the renal cortex. In addition to its reabsorptive functions, it is also specialized in the secretion of organic anions and cations, including para-aminohippurate.\")\n31651:AnnotationAssertion(terms:date obo:CL_4030010 \"2022-05-10T13:26:13Z\"^^xsd:dateTime)\n31652:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030010 \"epithelial cell of segment 2 of proximal tubule\")\n31653:AnnotationAssertion(rdfs:label obo:CL_4030010 \"epithelial cell of proximal tubule segment 2\")\n31654:EquivalentClasses(obo:CL_4030010 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004197) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31655:SubClassOf(obo:CL_4030010 obo:CL_0002307)\n31657:# Class: obo:CL_4030011 (epithelial cell of proximal tubule segment 3)\n31659:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23799132\") Annotation(oboInOwl:hasDbXref \"PMID:31249312\") obo:IAO_0000115 obo:CL_4030011 \"A brush border cell that is part of segment 3 (S3) of the proximal tubule epithelium, which extends from the medullary rays of the renal cortex into the outer medulla.\")\n31660:AnnotationAssertion(terms:date obo:CL_4030011 \"2022-05-10T13:31:06Z\"^^xsd:dateTime)\n31661:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030011 \"epithelial cell of segment 3 of proximal tubule\")\n31662:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31249312\") rdfs:comment obo:CL_4030011 \"The epithelial cell of proximal tubule segment 3 operates under relatively hypoxic conditions and is particularly susceptible to ischemic injury.\")\n31663:AnnotationAssertion(rdfs:label obo:CL_4030011 \"epithelial cell of proximal tubule segment 3\")\n31664:EquivalentClasses(obo:CL_4030011 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001290) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005903)))\n31665:SubClassOf(obo:CL_4030011 obo:CL_0002307)\n31667:# Class: obo:CL_4030012 (kidney loop of Henle short descending thin limb epithelial cell)\n31669:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030012 \"Epithelial cell of the descending thin limb of the short loop (cortical) nephron limited to the outer medulla (mainly inner strip). It is known in some mammalian species that the short descending limb of the loop of Henle selectively expresses the serine protease Corin, the homeobox TF Uncx, and the urea channel Slc14a2.\")\n31670:AnnotationAssertion(terms:contributor obo:CL_4030012 <https://orcid.org/0000-0003-2804-127X>)\n31671:AnnotationAssertion(terms:date obo:CL_4030012 \"2022-05-13T11:00:29Z\"^^xsd:dateTime)\n31672:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030012 \"epithelial cell of the descending thin limb of the short loop of Henle\")\n31673:AnnotationAssertion(rdfs:label obo:CL_4030012 \"kidney loop of Henle short descending thin limb epithelial cell\")\n31674:EquivalentClasses(obo:CL_4030012 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005099)))\n31675:SubClassOf(obo:CL_4030012 obo:CL_0000076)\n31676:SubClassOf(obo:CL_4030012 obo:CL_1001111)\n31678:# Class: obo:CL_4030013 (kidney loop of Henle long descending thin limb outer medulla epithelial cell)\n31680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") obo:IAO_0000115 obo:CL_4030013 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the outer medulla (inner stripe). It is known in some mammalian species that the long descending limb of the loop of Henle in the outer medulla selectively expresses the secreted activin-antagonist protein follistatin (Fst), the GPI-linked adhesion protein Cdh13, and the protein kinase Stk32a.\")\n31681:AnnotationAssertion(terms:date obo:CL_4030013 \"2022-05-13T11:11:07Z\"^^xsd:dateTime)\n31682:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030013 \"epithelial cell of the outer medulla of the long descending limb of the loop of Henle\")\n31683:AnnotationAssertion(rdfs:label obo:CL_4030013 \"kidney loop of Henle long descending thin limb outer medulla epithelial cell\")\n31684:SubClassOf(obo:CL_4030013 obo:CL_1001111)\n31685:SubClassOf(obo:CL_4030013 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005100))\n31687:# Class: obo:CL_4030014 (kidney loop of Henle long descending thin limb inner medulla epithelial cell)\n31689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://orcid.org/0000-0003-2804-127X>) Annotation(oboInOwl:hasDbXref \"PMID:33769951\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/gene/8170\") obo:IAO_0000115 obo:CL_4030014 \"Epithelial cell of the descending thin limb of the long loop (juxtamedullary) nephron that spans the inner medulla. It is known in some mammalian species that the long descending limb of the loop of Henle in the inner medulla selectively expresses the nuclear receptor Nr2e3, the Ig kappa chain Igkc, and the secreted protein dermokine (Dmkn). SLC14A2, which expresses a urea transporter, is also expressed in the inner medulla.\")\n31690:AnnotationAssertion(terms:date obo:CL_4030014 \"2022-05-13T11:16:54Z\"^^xsd:dateTime)\n31691:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030014 \"epithelial cell of the inner medulla of the long descending limb of the lo