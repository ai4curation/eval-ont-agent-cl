Class: obo:CL_0000040 (monoblast)\n4131:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:1104740\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Monoblast\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000040 \"A myeloid progenitor cell committed to the monocyte lineage. This cell is CD11b-positive, has basophilic cytoplasm, euchromatin, and the presence of a nucleolus.\")\n4132:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000040 \"CALOHA:TS-1195\")\n4133:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000040 \"FMA:83553\")\n4134:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000040 \"CFU-M\")\n4135:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000040 \"colony forming unit macrophage\")\n4136:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000040 \"colony forming unit monocyte\")\n4137:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000040 \"monocyte stem cell\")\n4138:AnnotationAssertion(rdfs:comment obo:CL_0000040 \"Morphology: mononuclear cell, diameter 12-20 _M, non-granular, N/C ratio 3/1 - 4/1; markers: CD11b (shared with many other myeloid cells); location: Adult: bone marrow; fetal: liver, Yolk Sac; role or process: hematopoiesis, monocyte development; lineage: hematopoietic, myeloid.\")\n4139:AnnotationAssertion(rdfs:label obo:CL_0000040 \"monoblast\")\n4140:EquivalentClasses(obo:CL_0000040 ObjectIntersectionOf(obo:CL_0002194 ObjectSomeValuesFrom(obo:BFO_0000051 obo:CL_0017503) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0000791) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005730) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001012) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030224)))\n4141:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000040 obo:CL_0002194)\n4142:SubClassOf(obo:CL_0000040 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002009))\n4144:# Class: obo:CL_0000041 (mature eosinophil)\n4146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000041 \"A fully differentiated eosinophil, a granular leukocyte with a nucleus that usually has two lobes connected by one or more slender threads, and cytoplasm containing coarse, round granules that are uniform in size and which can be stained by the dye eosin. Cells are also differentiated from other granulocytes by a small nuclear-to-cytoplasm ratio (1:3). This cell type is CD49d-positive.\")\n4147:AnnotationAssertion(obo:IAO_0000116 obo:CL_0000041 \"The status of eosinophils as true professional antigen presenting cells is unclear, despite their ability to present exogenous peptides and peptides processed from exogenous proteins (in certain studies) via MHC Class II and activate T cells. Per the equivalence axioms, 'eosinophil' is reasoned to be a subclass of 'professional antigen presenting cell', though the role of eosinophils as such in the body may be limited.\")\n4148:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000041 \"polymorphonuclear leucocyte\")\n4149:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000041 \"polymorphonuclear leukocyte\")\n4150:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000041 \"mature eosinocyte\")\n4151:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000041 \"mature eosinophil leucocyte\")\n4152:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000041 \"mature eosinophil leukocyte\")\n4153:AnnotationAssertion(rdfs:comment obo:CL_0000041 \"Eosinophils are CD125-positive (IL-5R), GM-CSFR-positive, IL-3R-positive, VLA4-positive. They can also express MHC Class I & II, CD4, CD9, CD11a, CD11b, CD11c, CD13, CD15, CD16, CD17, CD18, CD24, CD25,CD28, CD29, CD32, CD33, CD35, CD37, CD39, CD43, CD44, CD45, CD45RB, CD45RO, CD46, CD47, CD48, CD49d, CD49f, CD50, CD52, CD53, CD54, CD55, CD58, CD59, CD62L, CD63, CD65, CD66, CD69, CD71, CD76, CD80, CD81, CD82, CD86, CD87, CD88, CD89, CD92, CD95, CD97, CD98, CD99, CD100, CD101, CD116, CD117, CD119, CD120, CD123, CD124, CD125, CD131, CD137, CD139, CD148, CD149, CD151, CD153, CD156, CD162, CD161, CD162, CD165, CD174, CD182, CD183, CD191, CD192, CD193, CD196, CD213, IL9R, ad integrin, beta-7 integrin, FceRI, IL13Ra1, TGFbR, PAFR, LTB4R, C3aR, CystLT1R, CystLT2R, fMLPR, CRTH2 (PGD2 receptor), histamine 4R, IDO, KYN, PAR-2, Siglec-8, Siglec-10, LIR1, LIR2, LIR3, LIR7, TLR7, TLR8, and VLA-4. Eosinophils can also secrete CXCL1, eotaxin-1, GM-CSF, IL-2, IL-3, IL-4, IL-5, IL-6, IL-8, IL-10, IL-12, IL-13, IL-16, IL-18, IFN-gamma, LTC4, MIP-1alpha, NGF, PAF, RANTES, substance P, TGF-alpha, TGF-beta, TNF-alpha, and VIP.\")\n4154:AnnotationAssertion(rdfs:label obo:CL_0000041 \"mature eosinophil\")\n4155:EquivalentClasses(obo:CL_0000041 ObjectIntersectionOf(obo:CL_0000771 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007152) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007857) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007858) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000014046) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000014047) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000022006) ObjectSomeValuesFrom(obo:BFO_0000051 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001979))) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000009129) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002495) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002540) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045730)))\n4156:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000041 obo:CL_0000771)\n4157:SubClassOf(obo:CL_0000041 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000774))\n4159:# Class: obo:CL_0000042 (neutrophilic myeloblast)\n4161:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") obo:IAO_0000115 obo:CL_0000042 \"A myeloblast committed to the neutrophil lineage. This cell type is GATA-1 positive, C/EBPa-positive, AML-1-positive, c-myb-positive and has low expression of PU.1 transcription factor.\")\n4162:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000042 \"neutrophilic granuloblast\")\n4163:AnnotationAssertion(rdfs:comment obo:CL_0000042 \"These cells are CD11b-negative, CD15-negative, CD16-negative, CD35-negative, CD49d-positive, CD68-positive, lactotransferrin-negative, and fMLP receptor-negative. They are found in the Band 3 fraction.\")\n4164:AnnotationAssertion(rdfs:label obo:CL_0000042 \"neutrophilic myeloblast\")\n4165:EquivalentClasses(obo:CL_0000042 ObjectIntersectionOf(obo:CL_0000835 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001944) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000005307) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000007857) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000010799) ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000014362) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030223)))\n4166:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000042 obo:CL_0000835)\n4167:SubClassOf(obo:CL_0000042 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000834))\n4169:# Class: obo:CL_0000043 (mature basophil)\n4171:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18466030\") Annotation(oboInOwl:hasDbXref \"PMID:19231594\") Annotation(oboInOwl:hasDbXref \"PMID:20837449\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000043 \"A fully differentiated basophil, a granular leukocyte with an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation.\")\n4172:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000043 \"polymorphonuclear leucocyte\")\n4173:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000043 \"polymorphonuclear leukocyte\")\n4174:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000043 \"BTO:0001026\")\n4175:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000043 \"CALOHA:TS-0688\")\n4176:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000043 \"mature basophil leucocyte\")\n4177:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000043 \"mature basophil leukocyte\")\n4178:AnnotationAssertion(rdfs:comment obo:CL_0000043 \"Mature basophils are also capable of producing IL-3, IL-5, IL-6, IL-8, IL-13, IL-25, CCL22, tslp, vegf, and LTC4.\")\n4179:AnnotationAssertion(rdfs:label obo:CL_0000043 \"mature basophil\")\n4180:EquivalentClasses(obo:CL_0000043 ObjectIntersectionOf(obo:CL_0000767 ObjectSomeValuesFrom(obo:BFO_0000051 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001979))) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002349) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002351) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002830) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0008015) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032616) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032633) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0048295)))\n4181:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000043 obo:CL_0000767)\n4182:SubClassOf(obo:CL_0000043 obo:CL_0002274)\n4183:SubClassOf(obo:CL_0000043 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000770))\n4185:# Class: obo:CL_0000044 (obo:CL_0000044)\n4187:AnnotationAssertion(obo:IAO_0000231 obo:CL_0000044 obo:IAO_0000227)\n4188:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000044 obo:CL_0000051)\n4189:AnnotationAssertion(owl:deprecated obo:CL_0000044 \"true\"^^xsd:boolean)\n4191:# Class: obo:CL_0000045 (obsolete thymus processed stem cell)\n4193:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000045 \"OBSOLETE (was not defined before being made obsolete).\")\n4194:AnnotationAssertion(rdfs:comment obo:CL_0000045 \"Consider using term 'pro-T cell ; CL:0000827' or the term 'thymocyte ; CL:0000893' or one of its children instead.\")\n4195:AnnotationAssertion(rdfs:label obo:CL_0000045 \"obsolete thymus processed stem cell\")\n4196:AnnotationAssertion(owl:deprecated obo:CL_0000045 \"true\"^^xsd:boolean)\n4198:# Class: obo:CL_0000046 (obsolete bursa processed stem cell)\n4200:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000046 \"OBSOLETE (was not defined before being made obsolete).\")\n4201:AnnotationAssertion(rdfs:comment obo:CL_0000046 \"Consider using term 'pro-B cell ; CL:0000826' or the term 'immature B cell ; CL:0000816 or one of its children instead.\")\n4202:AnnotationAssertion(rdfs:label obo:CL_0000046 \"obsolete bursa processed stem cell\")\n4203:AnnotationAssertion(owl:deprecated obo:CL_0000046 \"true\"^^xsd:boolean)\n4205:# Class: obo:CL_0000047 (neural stem cell)\n4207:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30639325\") obo:IAO_0000115 obo:CL_0000047 \"An undifferentiated neural cell that originates from the neuroectoderm and has the capacity both to perpetually self-renew without differentiating and to generate multiple central nervous system neuronal and glial cell types.\")\n4208:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000047 \"BTO:0002881\")\n4209:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000047 \"CALOHA:TS-2360\")\n4210:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000047 \"FMA:86684\")\n4211:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000047 \"NSC\")\n4212:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16305818\") oboInOwl:hasExactSynonym obo:CL_0000047 \"neuronal stem cell\")\n4213:AnnotationAssert