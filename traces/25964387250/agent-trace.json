uding the appendix. Paneth cells synthesize and secrete lysozyme and cryptdins. Numerous in the deeper parts of the intestinal crypts, particularly in the duodenum, rich in zinc, contain large acidophilic granules, with irregular apical microvilli and prominent membrane-bound vacuoles containing matrix.\")\n8082:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000510 \"BTO:0000993\")\n8083:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000510 \"FMA:62897\")\n8084:AnnotationAssertion(rdfs:label obo:CL_0000510 \"paneth cell\")\n8085:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000510 obo:CL_0000066)\n8086:SubClassOf(obo:CL_0000510 obo:CL_0000323)\n8087:SubClassOf(obo:CL_0000510 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\n8088:SubClassOf(obo:CL_0000510 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005773))\n8089:SubClassOf(obo:CL_0000510 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0005902))\n8090:SubClassOf(obo:CL_0000510 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4047017))\n8092:# Class: obo:CL_0000511 (androgen binding protein secreting cell)\n8094:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") obo:IAO_0000115 obo:CL_0000511 \"A peptide hormone secreting cell that secretes androgen binding protein.\")\n8095:AnnotationAssertion(rdfs:label obo:CL_0000511 \"androgen binding protein secreting cell\")\n8096:SubClassOf(obo:CL_0000511 obo:CL_0000154)\n8098:# Class: obo:CL_0000512 (obsolete paracrine cell)\n8100:AnnotationAssertion(oboInOwl:consider obo:CL_0000512 obo:CL_0000151)\n8101:AnnotationAssertion(rdfs:comment obo:CL_0000512 \"The term paracrine describes a role of a secreted hormone. There are a vast number of cell types that could fit this description, however it is difficult to know every case where a secreted hormone has paracrine effects.\")\n8102:AnnotationAssertion(rdfs:label obo:CL_0000512 \"obsolete paracrine cell\")\n8103:AnnotationAssertion(owl:deprecated obo:CL_0000512 \"true\"^^xsd:boolean)\n8105:# Class: obo:CL