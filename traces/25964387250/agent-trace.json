016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000385 \"A precursor of mature hemocytes.\")\n7129:AnnotationAssertion(obo:RO_0002161 obo:CL_0000385 obo:NCBITaxon_33511)\n7130:AnnotationAssertion(rdfs:label obo:CL_0000385 \"prohemocyte (sensu Nematoda and Protostomia)\")\n7131:SubClassOf(obo:CL_0000385 obo:CL_0008001)\n7133:# Class: obo:CL_0000386 (obsolete attachment cell)\n7135:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000386 <https://github.com/obophenotype/cell-ontology/issues/3016>)\n7136:AnnotationAssertion(rdfs:comment obo:CL_0000386 \"The obsoleted term is redundant\")\n7137:AnnotationAssertion(rdfs:label obo:CL_0000386 \"obsolete attachment cell\")\n7138:AnnotationAssertion(owl:deprecated obo:CL_0000386 \"true\"^^xsd:boolean)\n7140:# Class: obo:CL_0000387 (hemocyte (sensu Arthropoda))\n7142:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50008-0\") obo:IAO_0000115 obo:CL_0000387 \"A blood cell of the circulatory system of arthropods.\")\n7143:AnnotationAssertion(rdfs:label obo:CL_0000387 \"hemocyte (sensu Arthropoda)\")\n7144:SubClassOf(obo:CL_0000387 obo:CL_0000390)\n7145:SubClassOf(obo:CL_0000387 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7146:SubClassOf(obo:CL_0000387 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000385))\n7148:# Class: obo:CL_0000388 (tendon cell)\n7150:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:37894875\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibroblast that is part of a tendon. Its cytoplasm is stretched between the collagen fibres of the tendon, and it possesses a central nucleus with a prominent nucleolus. Tendon cell has a well-developed rough endoplasmic reticulum, and it is responsible for the synthesis and turnover of tendon fibres and ground substance.\")\n7151:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000388 