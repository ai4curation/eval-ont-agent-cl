{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"rg -n 'ossification|osteoblastogenesis|angiogenesis' src/ontology/cl-edit.owl | head -n 80\"","aggregated_output":"10184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") Annotation(oboInOwl:hasDbXref \"PMID:15951842\") obo:IAO_0000115 obo:CL_0000743 \"Chondrocyte that is terminally differentiated, produces type X collagen, is large in size, and often associated with the replacement of cartilage by bone (endochondral ossification).\")\n19749:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002546 \"An endothelial progenitor cell that participates in angiogenesis during development.\")\n20426:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20807818\") Annotation(oboInOwl:hasDbXref \"PMID:9020076\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016\") obo:IAO_0000115 obo:CL_0002619 \"An adult angioblastic cell released from the bone marrow, or from the kidney in some teleost species, capable of blood circulation and participation in angiogenesis by differentiating into blood vessel endothelial cells.\")\n24127:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Colony_forming_unit_–_Hill\") obo:IAO_0000115 obo:CL_0009085 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. They may form discrete colonies.\")\n24157:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Circulating_angiogenic_cell\") obo:IAO_0000115 obo:CL_0009088 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. These cells do not form colonies.\")\n24177:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33419165\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_colony_forming_cell&oldid=1068242094\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_0009090 \"An adult endothelial progenitor cell that is resident of adult vasculature and capable of differentiating to regenerate endothelial cell populations. Endothelial colony forming cells are characterised in vivo by clonal proliferative status, de novo vessel formation, homing to ischemic sites and paracrine support of angiogenesis. These cells are phenotypically similar to endothelial cells.\")\n29929:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:30498493\") Annotation(oboInOwl:hasDbXref \"PMID:34745147\") Annotation(oboInOwl:hasDbXref \"PMID:35438172\") obo:IAO_0000115 obo:CL_3000001 \"A tissue-resident macrophage that is part of the placenta. A Hofbauer cell expresses high levels of growth factors and metalloproteinases that support vasculogenesis, angiogenesis, branching morphogenesis and tissue remodeling. A Hofbauer cell has a fetal origin, is found in the villous stroma, chorion, and amnion, and is present throughout pregnancy.\")\n33758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24853910\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047012 \"A specialized pericyte that actively participates in the formation of new blood vessels during angiogenesis by undergoing phenotypic changes, increasing proliferation, and interacting closely with endothelial cells.\")\n33828:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2019.00282\") obo:IAO_0000115 obo:CL_4047032 \"A specialized pericyte located within the basement membrane of a blood capillary. This cell is characterized by its ability to produce and release a variety of bioactive molecules, collectively known as the pericyte secretome, including cytokines and regulators of angiogenesis.\")\n","exit_code":0,"status":"completed"}}
