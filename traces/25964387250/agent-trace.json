))\n35218:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35219:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072041 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.  The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L6 IT.\")\n35220:AnnotationAssertion(obo:RO_0002175 obo:CL_4072041 obo:NCBITaxon_9606)\n35221:AnnotationAssertion(terms:contributor obo:CL_4072041 \"https://orcid.org/0000-0002-5507-2103\")\n35222:AnnotationAssertion(terms:date obo:CL_4072041 \"2025-09-11T14:38:02Z\"^^xsd:dateTime)\n35223:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072041 \"ILX:0770158\")\n35224:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35225:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072041 cl:cellxgene_subset)\n35226:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\n35227:AnnotationAssertion(rdfs:label obo:CL_4072041 \"L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35228:SubClassOf(obo:CL_4072041 obo:CL_4030065)\n35229:SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35230:SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000071))\n35232:# Class: obo:CL_4072042 (L5/6 near-projecting glutamatergic neuron (Homo sapiens))\n35234:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35235:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\n35236:AnnotationAssertion(obo:RO_0002175 obo:CL_4072042 obo:NCBITaxon_9606)\n35237:AnnotationAssertion(terms:contributor obo:CL_4072042 \"https://orcid.org/0000-0002-5507-2103\")\n35238:AnnotationAssertion(terms:date obo:CL_4072042 \"2025-09-16T08:55:09Z\"^^xsd:dateTime)\n35239:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35240:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072042 cl:cellxgene_subset)\n35241:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\n35242:AnnotationAssertion(rdfs:label obo:CL_4072042 \"L5/6 near-projecting glutamatergic neuron (Homo sapiens)\")\n35243:SubClassOf(obo:CL_4072042 obo:CL_4030067)\n35244:SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35245:SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000069))\n35247:# Class: obo:CL_4072043 (L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens))\n35249:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072043 \"L5 ET glut (Homo sapiens)\")\n35250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\n35251:AnnotationAssertion(obo:RO_0002175 obo:CL_4072043 obo:NCBITaxon_9606)\n35252:AnnotationAssertion(terms:contributor obo:CL_4072043 \"https://orcid.org/0000-0002-5507-2103\")\n35253:AnnotationAssertion(terms:date obo:CL_4072043 \"2025-09-16T09:26:37Z\"^^xsd:dateTime)\n35254:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\n35255:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\n35256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\n35257:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\n35258:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\n35259:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\n35260:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:BDS_subset)\n35261:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:cellxgene_subset)\n35262:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\n35263:AnnotationAssertion(rdfs:label obo:CL_4072043 \"L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens)\")\n35264:SubClassOf(obo:CL_4072043 obo:CL_4023041)\n35265:SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35266:SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000067))\n35268:# Class: obo:CL_4072044 (L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens))\n35270:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072044 \"L6 CT glut (Homo sapiens)\")\n35271:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L6 CT.\")\n35272:AnnotationAssertion(obo:RO_0002175 obo:CL_4072044 obo:NCBITaxon_9606)\n35273:AnnotationAssertion(terms:contributor obo:CL_4072044 \"https://orcid.org/0000-0002-5507-2103\")\n35274:AnnotationAssertion(terms:date obo:CL_4072044 \"2025-09-16T09:42:20Z\"^^xsd:dateTime)\n35275:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4072044 \"L6 CT (Homo sapiens)\")\n35276:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:BDS_subset)\n35277:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:cellxgene_subset)\n35278:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072044 \"The marker set SEMA5B, ADAMTSL1, SULF1 can identify the Human cell type L6 corticothalamic-projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.631898455 (NS-Forest FBeta value).\")\n35279:AnnotationAssertion(rdfs:label obo:CL_4072044 \"L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens)\")\n35280:SubClassOf(obo:CL_4072044 obo:CL_4023042)\n35281:SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35282:SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000070))\n35284:# Class: obo:CL_4072045 (L6b glutamatergic cortical neuron (Homo sapiens))\n35286:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072045 \"L6b glut (Homo sapiens)\")\n35287:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072045 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neuron', Author Categories: 'CrossArea_subclass', cluster L6b.\")\n35288:AnnotationAssertion(obo:RO_0002175 obo:CL_4072045 obo:NCBITaxon_9606)\n35289:AnnotationAssertion(terms:contributor obo:CL_4072045 \"https://orcid.org/0000-0002-5507-2103\")\n35290:AnnotationAssertion(terms:date obo:CL_4072045 \"2025-09-16T10:30:38Z\"^^xsd:dateTime)\n35291:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072045 \"ILX:0770163\")\n35292:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:BDS_subset)\n35293:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:cellxgene_subset)\n35294:AnnotationAssertion(rdfs:label obo:CL_4072045 \"L6b glutamatergic cortical neuron (Homo sapiens)\")\n35295:SubClassOf(obo:CL_4072045 obo:CL_4023038)\n35296:SubClassOf(obo:CL_4072045 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35298:# Class: obo:CL_4072046 (pvalb chandelier GABAergic interneuron (Homo sapiens))\n35300:AnnotationAssertion(obo:IAO_0000028 obo:CL_4072046 \"chandelier PV interneuron (Homo sapiens)\")\n35301:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072046 \"A transcriptomically definined GABAergic interneuron of the human pallium.  These cells correspond to the classically defined pvalb chandelier neuron type. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Chandelier.\")\n35302:AnnotationAssertion(obo:RO_0002175 obo:CL_4072046 obo:NCBITaxon_9606)\n35303:AnnotationAssertion(terms:contributor obo:CL_4072046 \"https://orcid.org/0000-0002-5507-2103\")\n35304:AnnotationAssertion(terms:date obo:CL_4072046 \"2025-09-29T10:07:47Z\"^^xsd:dateTime)\n35305:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072046 \"ILX:0107356\")\n35306:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"Chandelier PV (Homo sapiens)\")\n35307:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"chandelier pvalb GABAergic interneuron (Homo sapiens)\")\n35308:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:BDS_subset)\n35309:AnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:cellxgene_subset)\n35310:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072046 \"The marker set GPR149, CA8 can identify the Human cell type chandelier pvalb GABAergic cortical interneuron in the neocortex with a confidence of 0.799748111 (NS-Forest FBeta value).\")\n35311:AnnotationAssertion(rdfs:label obo:CL_4072046 \"pvalb chandelier GABAergic interneuron (Homo sapiens)\")\n35312:SubClassOf(obo:CL_4072046 obo:CL_4023036)\n35313:SubClassOf(obo:CL_4072046 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35314:SubClassOf(obo:CL_4072046 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000063))\n35316:# Class: obo:CL_4072102 (Purkinje layer interneuron)\n35318:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") obo:IAO_0000115 obo:CL_4072102 \"A type of GABAergic interneuron residing in the Purkinje cell layer of the cerebellar cortex.\")\n35319:AnnotationAssertion(terms:date obo:CL_4072102 \"2025-04-29T13:06:36Z\"^^xsd:dateTime)\n35320:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072102 \"PLI\")\n35321:AnnotationAssertion(rdfs:label obo:CL_4072102 \"Purkinje layer interneuron\")\n35322:EquivalentClasses(obo:CL_4072102 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979)))\n35323:SubClassOf(obo:CL_4072102 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35325:# Class: obo:CL_4072103 (hair follicle dermal stem cell)\n35327:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasDbXref \"PMID:29691589\") Annotation(oboInOwl:hasDbXref \"PMID:35036581\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_4072103 \"A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle's mesenchymal compartments.\")\n35328:AnnotationAssertion(terms:contributor obo:CL_4072103 <https://orcid.org/0009-0000-8480-9277>)\n35329:AnnotationAssertion(oboInOwl:creation_date obo:CL_4072103 \"2025-11-05T11:49:53Z\"^^xsd:dateTime)\n35330:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38016881\") oboInOwl:hasNarrowSynonym obo:CL_4072103 \"dermal sheath cup cell\")\n35331:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072103 \"hfDSC\")\n35332:AnnotationAssertion(rdfs:label obo:CL_4072103 \"hair follicle dermal stem cell\")\n35333:EquivalentClasses(obo:CL_4072103 ObjectIntersectionOf(obo:CL_0000134 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\n35334:SubClassOf(obo:CL_4072103 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042634))\n35336:# Class: obo:CL_4072104 (fibrochondrocyte)\n35338:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35339:AnnotationAssertion(terms:contributor obo:CL_4072104 <https://orcid.org/0009-0000-8480-9277>)\n35340:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35341:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35342:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\n35343:AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n35344:EquivalentClasses(obo:CL_4072104 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995)))\n35345:SubClassOf(obo:CL_4072104 obo:CL_0002320)\n35346:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0020021))\n35347:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n35348:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003328))\n35349:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003353))\n35351:# Class: obo:CL_7770002 (juxtacanalicular tissue cell)\n35353:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\n35354:AnnotationAssertion(obo:IAO_0000233 obo:CL_7770002 \"https://github.com/obophenotype/cell-ontology/issues/3275\")\n35355:AnnotationAssertion(terms:contributor obo:CL_7770002 <https://orcid.org/0009-0000-8480-9277>)\n35356:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770002 \"2025-01-29T08:52:00Z\"^^xsd:dateTime)\n35357:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_7770002 \"JCT cell\")\n35358:AnnotationAssertion(rdfs:label obo:CL_7770002 \"juxtacanalicular tissue cell\")\n35359:SubClassOf(obo:CL_7770002 obo:CL_0000327)\n35360:SubClassOf(obo:CL_7770002 obo:CL_0002367)\n35361:SubClassOf(obo:CL_7770002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n35363:# Class: obo:CL_7770003 (beam A cell)\n35365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27443500\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770003 \"A beam cell within the eye's trabecular meshwork, molecularly distinguished by FABP4 expression in humans and spatially intermingled with Beam B cells throughout the uveal and corneoscleral meshwork regions. In mice, a transcriptionally analogous Beam A–like cluster (mC14) exists, sharing core TM markers (Myoc, Mgp, Pdpn, Chil1) and functional attributes.\")\n35366:AnnotationAssertion(terms:contributor obo:CL_7770003 <https://orcid.org/0009-0000-8480-9277>)\n35367:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770003 \"2025-08-29T08:53:47Z\"^^xsd:dateTime)\n35368:AnnotationAssertion(rdfs:label obo:CL_7770003 \"beam A cell\")\n35369:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770003 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35370:SubClassOf(obo:CL_7770003 obo:CL_7770005)\n35372:# Class: obo:CL_7770004 (suprabasal cell)\n35374:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17020902\") Annotation(oboInOwl:hasDbXref \"PMID:30837987\") Annotation(oboInOwl:hasDbXref \"PMID:32187560\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"PMID:37672481\") obo:IAO_0000115 obo:CL_7770004 \"An epithelial cell that resides in the layer(s) immediately above the basal layer in stratified or pseudostratified epithelia. This cell mainly originates from basal cells and is found across various tissues, including skin, esophagus, oral mucosa, airway, and cornea.\")\n35375:AnnotationAssertion(terms:contributor obo:CL_7770004 <https://orcid.org/0009-0000-8480-9277>)\n35376:AnnotationAssertion(terms:date obo:CL_7770004 \"2025-09-05T07:59:28Z\"^^xsd:dateTime)\n35377:AnnotationAssertion(rdfs:label obo:CL_7770004 \"suprabasal cell\")\n35378:SubClassOf(obo:CL_7770004 obo:CL_0000066)\n35380:# Class: obo:CL_7770005 (beam cell)\n35382:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:27443500\") obo:IAO_0000115 obo:CL_7770005 \"A trabecular meshwork cell that is part of the eye's trabecular meshwork, residing in the uveal and corneoscleral meshwork regions and serving as the primary biological filter in the aqueous humor drainage cascade. This cell exhibits endothelial-like properties, including production of antithrombogenic substances such as tissue plasminogen activator, while also demonstrating phagocytic activity to remove cellular debris from aqueous humour before the fluid moves deeper into the less porous juxtacanalicular tissue.\")\n35383:AnnotationAssertion(terms:contributor obo:CL_7770005 <https://orcid.org/0009-0000-8480-9277>)\n35384:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770005 \"2025-09-12T11:19:45Z\"^^xsd:dateTime)\n35385:AnnotationAssertion(rdfs:label obo:CL_7770005 \"beam cell\")\n35386:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770005 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35387:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_7770005 obo:CL_0002367)\n35388:SubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005969))\n35389:SubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006909))\n35391:# Class: obo:CL_7770006 (beam B cell, human)\n35393:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770006 \"A trabecular meshwork cell within the eye's trabecular meshwork. This cell is molecularly distinguished by TMEFF2 expression in humans. A beam B cell is spatially intermingled with beam A cells throughout the uveal and corneoscleral meshwork regions, but demonstrates a tendency to localise closer to the juxtacanalicular tissue.\")\n35394:AnnotationAssertion(terms:contributor obo:CL_7770006 <https://orcid.org/0009-0000-8480-9277>)\n35395:AnnotationAssertion(terms:date obo:CL_7770006 \"2025-09-15T08:48:01Z\"^^xsd:dateTime)\n35396:AnnotationAssertion(rdfs:label obo:CL_7770006 \"beam B cell, human\")\n35397:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35398:SubClassOf(obo:CL_7770006 obo:CL_0002367)\n35399:SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35400:SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9UIK5))\n35404:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000000 obo:CL_0017500)\n35411:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000025 obo:CL_0017501)\n35418:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000027 obo:CL_0017502)\n35425:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000028 obo:CL_0017503)\n35432:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000035 obo:CL_0017504)\n35439:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000037 obo:CL_0017505)\n35446:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000039 obo:CL_0017506)\n35453:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000040 obo:CL_0017507)\n35460:AnnotationAssertion(obo:IAO_0100001 obo:CP_0000043 obo:CL_0017508)\n35467:AnnotationAssertion(obo:IAO_0100001 obo:D96882F1-8709-49AB-BCA9-772A67EA6C33 obo:CL_0017509)\n35474:EquivalentClasses(obo:GO_0051932 ObjectIntersectionOf(obo:GO_0007268 ObjectSomeValuesFrom(obo:RO_0000057 obo:CHEBI_59888) ObjectSomeValuesFrom(obo:RO_0000057 obo:CL_0000617)))\n35477:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000160)) obo:CL_0000164)\n35478:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000945)) obo:CL_0000164)\n35479:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001264)) obo:CL_0000164)\n35480:SubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742)) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000031))\n","exit_code":0,"status":"completed"}}
