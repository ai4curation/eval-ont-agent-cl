Owl:hasExactSynonym obo:CL_4070016 \"AB\")\n34813:AnnotationAssertion(rdfs:label obo:CL_4070016 \"anterior burster neuron\")\n34814:SubClassOf(obo:CL_4070016 obo:CL_0000099)\n34815:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34816:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34818:# Class: obo:CL_4070017 (lateral pyloric motor neuron)\n34820:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6296329\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070017 \"A motor neuron that controls pyloric filter movements; innervates the lateral pyloric muscle.\")\n34821:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6712)\n34822:AnnotationAssertion(obo:RO_0002175 obo:CL_4070017 obo:NCBITaxon_6752)\n34823:AnnotationAssertion(terms:contributor obo:CL_4070017 <https://orcid.org/0000-0002-1909-7004>)\n34824:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\n34825:AnnotationAssertion(rdfs:label obo:CL_4070017 \"lateral pyloric motor neuron\")\n34826:SubClassOf(obo:CL_4070017 obo:CL_0000100)\n34827:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34828:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34830:# Class: obo:CL_4072001 (newly formed oligodendrocyte)\n34832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\n34833:AnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\n34834:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\n34835:AnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\n34836:SubClassOf(obo:CL_4072001 obo:CL_0000123)\n34837:SubClassOf(obo:CL_4072001 obo:CL_0000128)\n34838:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34839:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\n34841:# Class: obo:CL_4072002 (myelin-forming oligodendrocyte)\n34843:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n34844:AnnotationAssertion(terms:contributor obo:CL_4072002 <https://orcid.org/0000-0002-5507-2103>)\n34845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\n34846:AnnotationAssertion(rdfs:label obo:CL_4072002 \"myelin-forming oligodendrocyte\"@en)\n34847:SubClassOf(obo:CL_4072002 obo:CL_0000128)\n34848:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34849:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n34850:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34852:# Class: obo:CL_4072003 (mature myelinating oligodendrocyte)\n34854:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\n34855:AnnotationAssertion(terms:contributor obo:CL_4072003 <https://orcid.org/0000-0002-5507-2103>)\n34856:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\n34857:AnnotationAssertion(rdfs:label obo:CL_4072003 \"mature myelinating oligodendrocyte\")\n34858:SubClassOf(obo:CL_4072003 obo:CL_0000128)\n34859:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n34860:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072002))\n34861:SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34863:# Class: obo:CL_4072005 (A8 dopaminergic neuron)\n34865:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\n34866:AnnotationAssertion(terms:date obo:CL_4072005 \"2025-05-02T08:37:36Z\"^^xsd:dateTime)\n34867:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\n34868:AnnotationAssertion(rdfs:label obo:CL_4072005 \"A8 dopaminergic neuron\")\n34869:SubClassOf(obo:CL_4072005 obo:CL_2000097)\n34870:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n34871:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34873:# Class: obo:CL_4072006 (A9 dopaminergic neuron)\n34875:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\n34876:AnnotationAssertion(terms:date obo:CL_4072006 \"2025-05-02T09:59:34Z\"^^xsd:dateTime)\n34877:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\n34878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\n34879:AnnotationAssertion(rdfs:label obo:CL_4072006 \"A9 dopaminergic neuron\")\n34880:SubClassOf(obo:CL_4072006 obo:CL_4042025)\n34881:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))