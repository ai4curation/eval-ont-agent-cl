t with cell (CL:0000000), native cell (CL:0000003), or cell in vitro (CL:0001034) as appropriate.\")\n3789:AnnotationAssertion(rdfs:label obo:CL_0000004 \"obsolete cell by organism\")\n3790:AnnotationAssertion(owl:deprecated obo:CL_0000004 \"true\"^^xsd:boolean)\n3792:# Class: obo:CL_0000005 (neural crest derived fibroblast)\n3794:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\n3795:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\n3796:AnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n3797:EquivalentClasses(obo:CL_0000005 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333)))\n3798:SubClassOf(obo:CL_0000005 obo:CL_0000057)\n3799:SubClassOf(obo:CL_0000005 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000008))\n3801:# Class: obo:CL_0000006 (neuronal receptor cell)\n3803:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000006 \"neuronal receptor cell (sensu Animalia)\")\n3804:AnnotationAssertion(rdfs:label obo:CL_0000006 \"neuronal receptor cell\")\n3805:EquivalentClasses(obo:CL_0000006 ObjectIntersectionOf(obo:CL_0000197 obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050906)))\n3806:SubClassOf(obo:CL_0000006 obo:CL_0000197)\n3808:# Class: obo:CL_0000007 (early embryonic cell (metazoa))\n3810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000007 \"A cell found in the embryo before the formation of all the gem layers is complete.\")\n3811:AnnotationAssertion(rdfs:label obo:CL_0000007 \"early embryonic cell (metazoa)\")\n3812:SubClassOf(obo:CL_0000007 obo:CL_0002321)\n3814:# Class: obo:CL_0000008 (migratory cranial neural crest cell)\n3816:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0007091\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000008 \"Cell that is part of the migratory cranial neural crest population. Migratory cranial neural crest cells develop from premigratory cranial neural crest cells and have undergone epithelial to mesenchymal transition and delamination.\")\n3817:AnnotationAssertion(rdfs:label obo:CL_0000008 \"migratory cranial neural crest cell\")\n3818:SubClassOf(obo:CL_0000008 obo:CL_0000333)\n3820:# Class: obo:CL_0000009 (obsolete fusiform initial)\n3822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000009 \"Obsolete. Use PO:0000079 from Plant Ontology instead. An elongated cell with approximately wedge-shaped ends, found in the vascular cambium, which gives rise to the elements of the axial system in the secondary vascular tissues.\")\n3823:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000009 obo:PO_0000079)\n3824:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000009 \"xylem initial\")\n3825:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000009 \"xylem mother cell\")\n3826:AnnotationAssertion(rdfs:label obo:CL_0000009 \"obsolete fusiform initial\")\n3827:AnnotationAssertion(owl:deprecated obo:CL_0000009 \"true\"^^xsd:boolean)\n3829:# Class: obo:CL_0000010 (cultured cell)\n3831:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ReO:mhb\") obo:IAO_0000115 obo:CL_0000010 \"A cell in vitro that is or has been maintained or propagated as part of a cell culture.\")\n3832:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000010 \"MESH:D002478\")\n3833:AnnotationAssertion(rdfs:comment obo:CL_0000010 \"Note that this class was re-labeled to 'cultured cell' instead of 'cell line cell', as it intent was clarified to cover any cultured cells of multicellular and unicellular organisms. This includes cells actively being cultured, or cells that have been cultured but are stored in a quiescent state for future use. In having been cultured, cells must establish homeostasis and often replicate in a foreign environment. Accomodation of this stress initiates a selection of cells fit for such challenges, wherein necessary adaptive biochemical and.or genetic changes can occur. These changes can set them apart from the in vivo cells from which they derive, and such changes will typically accumulate and change over increasing time in culture.\")\n3834:AnnotationAssertion(rdfs:label obo:CL_0000010 \"cultured cell\")\n3835:SubClassOf(obo:CL_0000010 obo:CL_0000578)\n3837:# Class: obo:CL_0000011 (migratory trunk neural crest cell)\n3839:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFA:0007095\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000011 \"Cell that is part of the migratory trunk neural crest population. Migratory trunk neural crest cells develop from premigratory trunk neural crest cells and have undergone epithelial to mesenchymal transition and delamination.\")\n3840:AnnotationAssertion(rdfs:label obo:CL_0000011 \"migratory trunk neural crest cell\")\n3841:SubClassOf(obo:CL_0000011 obo:CL_0000333)\n3843:# Class: obo:CL_0000012 (obsolete cell by class)\n3845:AnnotationAssertion(oboInOwl:consider obo:CL_0000012 \"CL:0000000\")\n3846:AnnotationAssertion(oboInOwl:consider obo:CL_0000012 \"CL:0000003\")\n3847:AnnotationAssertion(oboInOwl:consider obo:CL_0000012 \"CL:0001034\")\n3848:AnnotationAssertion(rdfs:comment obo:CL_0000012 \"This term was made obsolete because there is no difference in meaning between it and 'cell', as any cell can be classified. If you have used this term in annotation, please replace it with cell (CL:0000000), native cell (CL:0000003), or cell in vitro (CL:0001034) as appropriate.\")\n3849:AnnotationAssertion(rdfs:label obo:CL_0000012 \"obsolete cell by class\")\n3850:AnnotationAssertion(owl:deprecated obo:CL_0000012 \"true\"^^xsd:boolean)\n3852:# Class: obo:CL_0000013 (obsolete dentine secreting cell)\n3854:AnnotationAssertion(oboInOwl:consider obo:CL_0000013 \"CL:0000140\")\n38