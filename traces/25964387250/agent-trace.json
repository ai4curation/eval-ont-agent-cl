ophage\")\n32672:SubClassOf(obo:CL_4033043 obo:CL_0000235)\n32673:SubClassOf(obo:CL_4033043 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000114))\n32675:# Class: obo:CL_4033044 (deuterosomal cell)\n32677:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558434\") Annotation(oboInOwl:hasDbXref \"PMID:331922198\") Annotation(oboInOwl:hasDbXref \"PMID:36883528\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4033044 \"An epithelial cell part of respiratory tract epithelium that is a precursor of a multi-ciliated cell. This cell actively amplifies centrioles, a required step for multiciliogenesis.\")\n32678:AnnotationAssertion(terms:contributor obo:CL_4033044 <https://orcid.org/0000-0001-6677-8489>)\n32679:AnnotationAssertion(terms:contributor obo:CL_4033044 <https://orcid.org/0000-0002-9185-3994>)\n32680:AnnotationAssertion(terms:date obo:CL_4033044 \"2023-06-20T10:27:17Z\"^^xsd:dateTime)\n32681:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558434\") Annotation(oboInOwl:hasDbXref \"PMID:331922198\") Annotation(oboInOwl:hasDbXref \"PMID:36883528\") rdfs:comment obo:CL_4033044 \"In humans, deuterosomal cells have been noted to have enriched expression of the following: PLK4, FOXJ1, DEUP1, FOXN4, YPEL1, HES6 and CDC20B. Deuterosomal cells were termed after deuterosomes, the platforms of active centriole amplification.\")\n32682:AnnotationAssertion(rdfs:label obo:CL_4033044 \"deuterosomal cell\")\n32683:SubClassOf(obo:CL_4033044 obo:CL_0000066)\n32684:SubClassOf(obo:CL_4033044 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802))\n32685:SubClassOf(obo:CL_4033044 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0098535))\n32687:# Class: obo:CL_4033045 (lung migratory dendritic cell)\n32689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") obo:IAO_0000115 obo:CL_4033045 \"A dendritic cell that captures antigens in a lung and migrates to a lymph node or to the spleen to activate T cells.\")\n32690:AnnotationAssertion(terms:contributor obo:CL_4033045 <https://orcid.org/0000-0001-6677-8489>)\n32691:AnnotationAssertion(terms:contributor obo:CL_4033045 <https://orcid.org/0000-0002-9185-3994>)\n32692:AnnotationAssertion(terms:date obo:CL_4033045 \"2023-06-21T10:04:46Z\"^^xsd:dateTime)\n32693:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033045 \"lung mDC\")\n32694:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34516781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4033045 \"lung mDCs\")\n32695:AnnotationAssertion(rdfs:label obo:CL_4033045 \"lung migratory dendritic cell\")\n32696:SubClassOf(obo:CL_4033045 obo:CL_0000451)\n32698:# Class: obo:CL_4033046 (ON midget ganglion cell)\n32700:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033046 \"A midget ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from invaginating midget bipolar cells.\")\n32701:AnnotationAssertion(terms:contributor obo:CL_4033046 <https://orcid.org/0000-0001-6677-8489>)\n32702:AnnotationAssertion(terms:date obo:CL_4033046 \"2023-08-08T09:40:08Z\"^^xsd:dateTime)\n32703:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033046 \"ON-midget RGC\")\n32704:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033046 \"ON-midget cell\")\n32705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033046 \"inner stratifying midget cell\")\n32706:AnnotationAssertion(rdfs:label obo:CL_4033046 \"ON midget ganglion cell\")\n32707:EquivalentClasses(obo:CL_4033046 ObjectIntersectionOf(obo:CL_4023032 obo:CL_4023188))\n32709:# Class: obo:CL_4033047 (OFF midget ganglion cell)\n32711:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033047 \"A midget ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from flat midget bipolar cells.\")\n32712:AnnotationAssertion(terms:contributor obo:CL_4033047 <https://orcid.org/0000-0001-6677-8489>)\n32713:AnnotationAssertion(terms:date obo:CL_4033047 \"2023-08-08T11:05:37Z\"^^xsd:dateTime)\n32714:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget RGC\")\n32715:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033047 \"OFF-midget cell\")\n32716:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033047 \"outer stratifying midget cell\")\n32717:AnnotationAssertion(rdfs:label obo:CL_4033047 \"OFF midget ganglion cell\")\n32718:EquivalentClasses(obo:CL_4033047 ObjectIntersectionOf(obo:CL_4023033 obo:CL_4023188))\n32720:# Class: obo:CL_4033048 (respiratory tract suprabasal cell)\n32722:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\n32723:AnnotationAssertion(terms:contributor obo:CL_4033048 <https://orcid.org/0000-0001-6677-8489>)\n32724:AnnotationAssertion(terms:contributor obo:CL_4033048 <https://orcid.org/0000-0002-9185-3994>)\n32725:AnnotationAssertion(terms:date obo:CL_4033048 \"2023-06-20T10:44:30Z\"^^xsd:dateTime)\n32726:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory parabasal cell\")\n32727:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal cell\")\n32728:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\n32729:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.20.537495\") rdfs:comment obo:CL_4033048 \"In humans, respiratory tract suprabasal cells have been noted to have enriched expression of the following: CK8, KRT13, IVL, and SERPINB3. Single-cell sequencing indicates that suprabasal cells derived from the nasal epithelium are distinct from those in the tracheobronchial epithelium.\")\n32730:AnnotationAssertion(rdfs:label obo:CL_4033048 \"respiratory tract suprabasal cell\")\n32731:SubClassOf(obo:CL_4033048 obo:CL_0011026)\n32732:SubClassOf(obo:CL_4033048 obo:CL_7770004)\n32733:SubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802))\n32734:SubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002633))\n32736:# Class: obo:CL_4033049 (taste receptor cell of tongue)\n32738:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1111/j.1096-3642.1981.tb01137.x\") Annotation(oboInOwl:hasDbXref \"PMID:10052456\") Annotation(oboInOwl:hasDbXref \"PMID:28655883\") Annotation(oboInOwl:hasDbXref \"http://www.nejohnston.org/Birds/documents/AvianTongues_Johnston.pdf\") obo:IAO_0000115 obo:CL_4033049 \"A taste receptor cell that is part of a taste bud of a tongue.\")\n32739:AnnotationAssertion(terms:contributor obo:CL_4033049 <https://orcid.org/0000-0001-6677-8489>)\n32740:AnnotationAssertion(terms:date obo:CL_4033049 \"2023-05-03T07:59:58Z\"^^xsd:dateTime)\n32741:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/s0022-5320(69)80043-2\") oboInOwl:hasRelatedSynonym obo:CL_4033049 \"gustatory cell of tongue\")\n32742:AnnotationAssertion(rdfs:label obo:CL_4033049 \"taste receptor cell of tongue\")\n32743:EquivalentClasses(obo:CL_4033049 ObjectIntersectionOf(obo:CL_0000209 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014451)))\n32745:# Class: obo:CL_4033050 (catecholaminergic neuron)\n32747:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0521442516\") Annotation(oboInOwl:hasDbXref \"PMID:12094209\") obo:IAO_0000115 obo:CL_4033050 \"A neuron that releases catecholamine as a neurotransmitter.\")\n32748:AnnotationAssertion(terms:contributor obo:CL_4033050 <https://orcid.org/0000-0001-6677-8489>)\n32749:AnnotationAssertion(terms:date obo:CL_4033050 \"2023-05-18T12:07:45Z\"^^xsd:dateTime)\n32750:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10191060\") Annotation(oboInOwl:hasDbXref \"PMID:12128258\") Annotation(oboInOwl:hasDbXref \"PMID:34880760\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2244-7917\") rdfs:comment obo:CL_4033050 \"Frequently used when describing the developing nervous system in zebrafish. A catecholaminergic neuron expresses tyrosine hydroxylase (TH), tyrosine hydroxylase 2 (TH2), aromatic amino acid decarboxylase (AADC), dopamine b-hydroxylase (DBH), and phenylethanolamine-N-methyl transferase (PEMT), which are enzymes necessary for catecholamine synthesis.\")\n32751:AnnotationAssertion(rdfs:label obo:CL_4033050 \"catecholaminergic neuron\")\n32752:EquivalentClasses(obo:CL_4033050 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0160043)))\n32754:# Class: obo:CL_4033051 (OFF parasol ganglion cell)\n32756:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033051 \"A parasol ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB3a bipolar cells.\")\n32757:AnnotationAssertion(terms:contributor obo:CL_4033051 <https://orcid.org/0000-0001-6677-8489>)\n32758:AnnotationAssertion(terms:date obo:CL_4033051 \"2023-08-08T12:34:57Z\"^^xsd:dateTime)\n32759:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol RGC\")\n32760:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\n32761:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033051 \"outer parasol cell\")\n32762:AnnotationAssertion(rdfs:label obo:CL_4033051 \"OFF parasol ganglion cell\")\n32763:EquivalentClasses(obo:CL_4033051 ObjectIntersectionOf(obo:CL_4023033 obo:CL_4023189))\n32765:# Class: obo:CL_4033052 (ON parasol ganglion cell)\n32767:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033052 \"A parasol ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB4 bipolar cells.\")\n32768:AnnotationAssertion(terms:contributor obo:CL_4033052 <https://orcid.org/0000-0001-6677-8489>)\n32769:AnnotationAssertion(terms:date obo:CL_4033052 \"2023-08-08T12:39:35Z\"^^xsd:dateTime)\n32770:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol RGC\")\n32771:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\n32772:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033052 \"inner parasol cell\")\n32773:AnnotationAssertion(rdfs:label obo:CL_4033052 \"ON parasol ganglion cell\")\n32774:EquivalentClasses(obo:CL_4033052 ObjectIntersectionOf(obo:CL_4023032 obo:CL_4023189))\n32776:# Class: obo:CL_4033053 (small bistratified retinal ganglion cell)\n32778:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\n32779:AnnotationAssertion(terms:contributor obo:CL_4033053 <https://orcid.org/0000-0001-6677-8489>)\n32780:AnnotationAssertion(terms:date obo:CL_4033053 \"2023-08-08T12:43:56Z\"^^xsd:dateTime)\n32781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033053 \"small bistratified cell\")\n32782:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1002/cne.22183\") oboInOwl:hasExactSynonym obo:CL_4033053 \"small bistratified cell, blue-ON/yellow-OFF ganglion cell\")\n32783:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasRelatedSynonym obo:CL_4033053 \"Polyak's shrub cell\")\n32784:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"SBS ganglion cell\")\n32785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033053 \"sbRGC\")\n32786:AnnotationAssertion(rdfs:label obo:CL_4033053 \"small bistratified retinal ganglion cell\")\n32787:SubClassOf(obo:CL_4033053 obo:CL_0003001)\n32788:SubClassOf(obo:CL_4033053 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001792))\n32790:# Class: obo:CL_4033054 (perivascular cell)\n32792:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24928499\") Annotation(oboInOwl:hasDbXref \"PMID:27889329\") obo:IAO_0000115 obo:CL_4033054 \"A cell that is adjacent to a vessel. A perivascular cell plays a crucial role in maintaining vascular function and tissue homeostasis. This cell type regulates vessel integrity and flow dynamics.\")\n32793:AnnotationAssertion(terms:contributor obo:CL_4033054 <https://orcid.org/0000-0001-6677-8489>)\n32794:AnnotationAssertion(terms:date obo:CL_4033054 \"2023-08-22T13:40:28Z\"^^xsd:dateTime)\n32795:AnnotationAssertion(rdfs:label obo:CL_4033054 \"perivascular cell\")\n32796:EquivalentClasses(obo:CL_4033054 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0002049)))\n32798:# Class: obo:CL_4033055 (airway submucosal gland duct multiciliated cell)\n32800:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17707699\") Annotation(oboInOwl:hasDbXref \"PMID:30864819\") obo:IAO_0000115 obo:CL_4033055 \"A multi-ciliated epithelial cell located in ciliated duct of an airway submucosal gland, characterized by a columnar shape and motile cilia on its apical surface.\")\n32801:AnnotationAssertion(terms:contributor obo:CL_4033055 <https://orcid.org/0000-0001-6677-8489>)\n32802:AnnotationAssertion(terms:contributor obo:CL_4033055 <https://orcid.org/0000-0002-9185-3994>)\n32803:AnnotationAssertion(terms:date obo:CL_4033055 \"2023-09-08T10:32:27Z\"^^xsd:dateTime)\n32804:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4033055 \"airway submucosal gland duct ciliated cell\")\n32805:AnnotationAssertion(rdfs:label obo:CL_4033055 \"airway submucosal gland duct multiciliated cell\")\n32806:EquivalentClasses(obo:CL_4033055 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8410077) ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600014) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n32808:# Class: obo:CL_4033056 (onychocyte)\n32810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24079581\") Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39451193\") obo:IAO_0000115 obo:CL_4033056 \"A terminally differentiated, specialized keratinocyte originating primarily from the nail matrix. During onychokeratinization, these cells undergo progressive flattening and produce high levels of hard, disulfide cross-linked keratins (Eckhart et al., 2024) that form the rigid, compact nail plate. Unlike epidermal keratinocytes, onychocytes are firmly integrated into the nail plate and do not desquamate.\")\n32811:AnnotationAssertion(terms:contributor obo:CL_4033056 <https://orcid.org/0000-0001-6677-8489>)\n32812:AnnotationAssertion(terms:date obo:CL_4033056 \"2023-10-03T12:49:46Z\"^^xsd:dateTime)\n32813:AnnotationAssertion(rdfs:label obo:CL_4033056 \"onychocyte\")\n32814:SubClassOf(obo:CL_4033056 obo:CL_0000312)\n32815:SubClassOf(obo:CL_4033056 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008198))\n32817:# Class: obo:CL_4033057 (luminal adaptive secretory precursor cell of mammary gland)\n32819:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19648928\") Annotation(oboInOwl:hasDbXref \"PMID:35617956\") Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") obo:IAO_0000115 obo:CL_4033057 \"A luminal epithelial cell of the mammary gland that can proliferate and has the potential to differentiate into a lactocyte during pregnancy. In humans, a luminal adaptive secretory precursor cell can be identified by high levels of the markers EpCAM and CD49f, and in mice it can be identified by low levels of CD29 and high levels of CD14, Kit, CD61, and Tspan8.\")\n32820:AnnotationAssertion(terms:contributor obo:CL_4033057 <https://orcid.org/0000-0001-6677-8489>)\n32821:AnnotationAssertion(terms:contributor obo:CL_4033057 <https://orcid.org/0000-0003-4969-670X>)\n32822:AnnotationAssertion(terms:date obo:CL_4033057 \"2023-10-13T13:02:55Z\"^^xsd:dateTime)\n32823:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35617956\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"alveolar cell\")\n32824:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"alveolar progenitor\")\n32825:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor\")\n32826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor cell\")\n32827:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal secretory cell\")\n32828:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") oboInOwl:hasExactSynonym obo:CL_4033057 \"ER-negative luminal alveolar progenitor\")\n32829:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"AP\")\n32830:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35617956\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"AV\")\n32831:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LASP\")\n32832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LP\")\n32833:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033057 \"LumSec\")\n32834:AnnotationAssertion(rdfs:label obo:CL_4033057 \"luminal adaptive secretory precursor cell of mammary gland\")\n32835:SubClassOf(obo:CL_4033057 obo:CL_0002326)\n32836:SubClassOf(obo:CL_4033057 obo:CL_0011115)\n32838:# Class: obo:CL_4033058 (luminal hormone-sensing cell of mammary gland)\n32840:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19648928\") Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasDbXref \"PMID:34156490\") Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") obo:IAO_0000115 obo:CL_4033058 \"A luminal epithelial cell of the mammary gland that transduces endocrine cues to orchestrate proliferation, architectural remodeling, and differentiation of other cells in the mammary gland via paracrine signaling. This cell expresses high levels of estrogen receptors. In humans, a luminal hormone-sensing cell can be identified by high levels of EpCAM and low levels of CD49f, and in mice it can be identified by low levels of CD29 and high levels of Foxa1, CD133, and Sca1 (Ly6a).\")\n32841:AnnotationAssertion(terms:contributor obo:CL_4033058 <https://orcid.org/0000-0001-6677-8489>)\n32842:AnnotationAssertion(terms:contributor obo:CL_4033058 <https://orcid.org/0000-0003-4969-670X>)\n32843:AnnotationAssertion(terms:date obo:CL_4033058 \"2023-10-16T08:30:25Z\"^^xsd:dateTime)\n32844:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"hormone sensing cell\")\n32845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"hormone-sensing mammary epithelial cell\")\n32846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"luminal hormone-responsive cell\")\n32847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033058 \"luminal mature cell\")\n32848:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") oboInOwl:hasExactSynonym obo:CL_4033058 \"ER-positive luminal hormone-sensor cell\")\n32849:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.04.21.537845\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"HS\")\n32850:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"HS-MEC\")\n32851:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"LHS\")\n32852:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033058 \"LumHR\")\n32853:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26390871\") Annotation(oboInOwl:hasDbXref \"PMID:34156490\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4969-670X\") rdfs:comment obo:CL_4033058 \"Following lineage specification, a luminal hormone-sensing cell expresses receptors for one or more hormones, such as estrogens, progesterone, androgens, and prolactin. In response to progesterone, luminal hormone-sensing cells express TNFSF11, WNT4, and RSPO1, among other factors, which cause branching, proliferation, and partial differentiation in LASP and B-Myo cells during luteal phases of the estrous/menstrual cycle and during gestation. During ductal elongation, ER activity drives expression of AREG in LHS cells, which is necessary for proliferation of the epithelium to fill the mammary fat pad.\")\n32854:AnnotationAssertion(rdfs:label obo:CL_4033058 \"luminal hormone-sensing cell of mammary gland\")\n32855:SubClassOf(obo:CL_4033058 obo:CL_0002326)\n32856:SubClassOf(obo:CL_4033058 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000007204))\n32858:# Class: obo:CL_4033059 (lactocyte type 1)\n32860:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasDbXref \"PMID:35377806\") obo:IAO_0000115 obo:CL_4033059 \"A lactocyte that highly expresses genes associated with transcription, immune cell function, and cellular stress. A lactocyte type 1 also expresses genes involved in milk component biosynthesis (e.g., LALBA and CSNs), albeit at lower levels than a lactocyte type 2.\")\n32861:AnnotationAssertion(terms:contributor obo:CL_4033059 <https://orcid.org/0000-0001-6677-8489>)\n32862:AnnotationAssertion(terms:contributor obo:CL_4033059 <https://orcid.org/0000-0003-4361-817X>)\n32863:AnnotationAssertion(terms:date obo:CL_4033059 \"2023-10-16T13:15:36Z\"^^xsd:dateTime)\n32864:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34097179\") oboInOwl:hasBroadSynonym obo:CL_4033059 \"luminal cluster 1 cell\")\n32865:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033059 \"LC1\")\n32866:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") oboInOwl:hasRelatedSynonym obo:CL_4033059 \"LMC major luminal cluster 1\")\n32867:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033059 \"progenitor MEC\")\n32868:AnnotationAssertion(rdfs:label obo:CL_4033059 \"lactocyte type 1\")\n32869:SubClassOf(obo:CL_4033059 obo:CL_0002325)\n32871:# Class: obo:CL_4033060 (lactocyte type 2)\n32873:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasDbXref \"PMID:35377806\") obo:IAO_0000115 obo:CL_4033060 \"A lactocyte that highly expresses genes associated with lipid production and milk component biosynthesis.\")\n32874:AnnotationAssertion(terms:contributor obo:CL_4033060 <https://orcid.org/0000-0001-6677-8489>)\n32875:AnnotationAssertion(terms:contributor obo:CL_4033060 <https://orcid.org/0000-0003-4361-817X>)\n32876:AnnotationAssertion(terms:date obo:CL_4033060 \"2023-10-16T13:15:55Z\"^^xsd:dateTime)\n32877:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35377806\") oboInOwl:hasBroadSynonym obo:CL_4033060 \"luminal cluster 2 cell\")\n32878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033060 \"LC2\")\n32879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35091553\") oboInOwl:hasRelatedSynonym obo:CL_4033060 \"LMC major luminal cluster 2\")\n32880:AnnotationAssertion(rdfs:label obo:CL_4033060 \"lactocyte type 2\")\n32881:SubClassOf(obo:CL_4033060 obo:CL_0002325)\n32883:# Class: obo:CL_4033061 (endothelial cell of central vein of liver)\n32885:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28287163\") obo:IAO_0000115 obo:CL_4033061 \"An endothelial cell that is part of a central vein of liver.\")\n32886:AnnotationAssertion(terms:contributor obo:CL_4033061 <https://orcid.org/0000-0001-6677-8489>)\n32887:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28287163\") oboInOwl:hasBroadSynonym obo:CL_4033061 \"endothelial cell of central vein\")\n32888:AnnotationAssertion(rdfs:label obo:CL_4033061 \"endothelial cell of central vein of liver\")\n32889:EquivalentClasses(obo:CL_4033061 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006841)))\n32891:# Class: obo:CL_4033062 (interstitial extravillous trophoblast cell)\n32893:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033062 \"A trophoblast cell that invades the uterine wall to anchor the placenta to the uterus. An interstitial extravillous trophoblast cell differentiates from an extravillous trophoblast cell, becoming hyperchromatic and changing its morphology to a fibroblast-like spindle-shaped cell. In humans, this cell can be distinguished by the expression of placental-specific protein 8, which stimulates migration.\")\n32894:AnnotationAssertion(terms:contributor obo:CL_4033062 <https://orcid.org/0000-0001-6677-8489>)\n32895:AnnotationAssertion(terms:date obo:CL_4033062 \"2024-01-08T15:43:15Z\"^^xsd:dateTime)\n32896:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") oboInOwl:hasExactSynonym obo:CL_4033062 \"invasive interstitial extravillous trophoblast cell\")\n32897:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033062 \"iEVT\")\n32898:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") oboInOwl:hasRelatedSynonym obo:CL_4033062 \"interstitial extravillous trophoblast\")\n32899:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11337369\") oboInOwl:hasRelatedSynonym obo:CL_4033062 \"interstitial trophoblast\")\n32900:AnnotationAssertion(rdfs:label obo:CL_4033062 \"interstitial extravillous trophoblast cell\")\n32901:SubClassOf(obo:CL_4033062 obo:CL_0000351)\n32902:SubClassOf(obo:CL_4033062 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0008036))\n32904:# Class: obo:CL_4033063 (endovascular extravillous trophoblast cell)\n32906:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033063 \"A trophoblast cell that invades the maternal spiral arteries and replace the endothelial lining, remodeling the vessels and allowing for adequate blood transport into the placenta. An endovascular extravillous trophoblast cell differentiates from an extravillous trophoblast cell. In humans, this cell can be distinguished by the expression of CD56.\")\n32907:AnnotationAssertion(terms:contributor obo:CL_4033063 <https://orcid.org/0000-0001-6677-8489>)\n32908:AnnotationAssertion(terms:date obo:CL_4033063 \"2024-01-08T15:43:32Z\"^^xsd:dateTime)\n32909:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033063 \"eEVT\")\n32910:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") oboInOwl:hasRelatedSynonym obo:CL_4033063 \"endovascular extravillous trophoblast\")\n32911:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11337369\") oboInOwl:hasRelatedSynonym obo:CL_4033063 \"endovascular trophoblast\")\n32912:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") rdfs:comment obo:CL_4033063 \"Shortly after implantation, the endovascular extravillous trophoblast cells occlude the maternal spiral arteries, preventing premature oxygen delivery to the placental villi and reducing fetal oxidative stress.\")\n32913:AnnotationAssertion(rdfs:label obo:CL_4033063 \"endovascular extravillous trophoblast cell\")\n32914:SubClassOf(obo:CL_4033063 obo:CL_0000351)\n32915:SubClassOf(obo:CL_4033063 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0008036))\n32917:# Class: obo:CL_4033064 (uterine resident macrophage)\n32919:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") obo:IAO_0000115 obo:CL_4033064 \"A tissue-resident macrophage that is part of the uterus.\")\n32920:AnnotationAssertion(terms:contributor obo:CL_4033064 <https://orcid.org/0000-0001-6677-8489>)\n32921:AnnotationAssertion(terms:date obo:CL_4033064 \"2024-01-08T16:05:09Z\"^^xsd:dateTime)\n32922:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") oboInOwl:hasBroadSynonym obo:CL_4033064 \"uterine macrophage\")\n32923:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") rdfs:comment obo:CL_4033064 \"Uterine macrophages are reported to be evenly distributed throughout the endometrial stroma but with aggregations observed close to the lumen of superficial secretory glands.\")\n32924:AnnotationAssertion(rdfs:label obo:CL_4033064 \"uterine resident macrophage\")\n32925:EquivalentClasses(obo:CL_4033064 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n32927:# Class: obo:CL_4033065 (preplasmablast)\n32929:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasDbXref \"PMID:30755708\") Annotation(oboInOwl:hasDbXref \"PMID:33150420\") obo:IAO_0000115 obo:CL_4033065 \"A mature B cell that serves as an intermediate stage in the differentiation of naive B cells into a plasmablast. A preplasmablast expresses CD30 and IL-6R and lacks expression of CD20, CD23, CD38 and CD138.\")\n32930:AnnotationAssertion(terms:contributor obo:CL_4033065 <https://orcid.org/0000-0001-6677-8489>)\n32931:AnnotationAssertion(terms:contributor obo:CL_4033065 <https://orcid.org/0000-0001-7655-4833>)\n32932:AnnotationAssertion(terms:date obo:CL_4033065 \"2024-04-25T09:14:58Z\"^^xsd:dateTime)\n32933:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23613519\") oboInOwl:hasExactSynonym obo:CL_4033065 \"pre-plasmablast\")\n32934:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33661294\") oboInOwl:hasExactSynonym obo:CL_4033065 \"preplasmablastic cell\")\n32935:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033065 \"prePB\")\n32936:AnnotationAssertion(rdfs:label obo:CL_4033065 \"preplasmablast\")\n32937:SubClassOf(obo:CL_4033065 obo:CL_0000785)\n32938:SubClassOf(obo:CL_4033065 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000788))\n32939:SubClassOf(obo:CL_4033065 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000980))\n32941:# Class: obo:CL_4033066 (pre-granulosa cell)\n32943:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:38178246\") obo:IAO_0000115 obo:CL_4033066 \"A supporting cell that is part of the ovary and differentiates into a granulosa cell. A pre-granulosa cell develops from an early supporting gonadal cell by repressing testis determination, which can then proliferate to form primordial follicles.\")\n32944:AnnotationAssertion(terms:contributor obo:CL_4033066 <https://orcid.org/0000-0001-6677-8489>)\n32945:AnnotationAssertion(terms:contributor obo:CL_4033066 <https://orcid.org/0000-0001-7655-4833>)\n32946:AnnotationAssertion(terms:date obo:CL_4033066 \"2024-06-07T12:04:57Z\"^^xsd:dateTime)\n32947:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"ovarian pregranulosa cell\")\n32948:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") oboInOwl:hasExactSynonym obo:CL_4033066 \"pregranulosa cell\")\n32949:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033066 \"PG cell\")\n32950:AnnotationAssertion(rdfs:label obo:CL_4033066 \"pre-granulosa cell\")\n32951:SubClassOf(obo:CL_4033066 obo:CL_0000630)\n32952:SubClassOf(obo:CL_4033066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\n32953:SubClassOf(obo:CL_4033066 ObjectSomeValuesFrom(obo:RO_0002210 obo:CL_4033083))\n32955:# Class: obo:CL_4033067 (mural granulosa cell)\n32957:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27815559\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:34198768\") obo:IAO_0000115 obo:CL_4033067 \"A follicular cell of ovary that differentiates from a cuboidal granulosa cell during the secondary follicle stage. Mural granulosa cells line the inner surface of the follicle wall, surrounding the fluid-filled antral cavity. These cells produce oestrogen during the follicular phase in response to follicle-stimulating hormone (FSH), and progesterone after ovulation in response to luteinizing hormone (LH).\")\n32958:AnnotationAssertion(terms:contributor obo:CL_4033067 <https://orcid.org/0000-0001-6677-8489>)\n32959:AnnotationAssertion(terms:contributor obo:CL_4033067 <https://orcid.org/0000-0001-7655-4833>)\n32960:AnnotationAssertion(terms:date obo:CL_4033067 \"2024-06-07T12:15:13Z\"^^xsd:dateTime)\n32961:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4033067 \"EFO:0005289\")\n32962:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1530/REP-16-0500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"MGC\")\n32963:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34198768\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033067 \"mural GC\")\n32964:AnnotationAssertion(rdfs:label obo:CL_4033067 \"mural granulosa cell\")\n32965:SubClassOf(obo:CL_4033067 obo:CL_0000501)\n32966:SubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\n32967:SubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4033084))\n32969:# Class: obo:CL_4033083 (squamous granulosa cell)\n32971:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033083 \"A granulosa cell that has a squamous morphology and form a single layer around the oocyte in primordial follicles. This cell develops directly into a cuboidal granulosa cell during the primordial-to-primary follicle transition.\")\n32972:AnnotationAssertion(terms:contributor obo:CL_4033083 <https://orcid.org/0000-0001-6677-8489>)\n32973:AnnotationAssertion(terms:date obo:CL_4033083 \"2024-09-24T13:13:24Z\"^^xsd:dateTime)\n32974:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22402964\") oboInOwl:hasExactSynonym obo:CL_4033083 \"flattened granulosa cell\")\n32975:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") oboInOwl:hasRelatedSynonym obo:CL_4033083 \"pre-granulosa cell\")\n32976:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033083 \"squamous GC\")\n32977:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") rdfs:comment obo:CL_4033083 \"Often in literature squamous granulosa cell and pre-granulosa cell are used as synonyms. However, this term only makes reference to the quiescent granulosa cells that surround the primordial ovarian follicle, while a pre-granulosa cell proliferates to form the primordial follicle (and thus cells become the squamous granulosa cells).\")\n32978:AnnotationAssertion(rdfs:label obo:CL_4033083 \"squamous granulosa cell\")\n32979:SubClassOf(obo:CL_4033083 obo:CL_0000501)\n32980:SubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003981))\n32981:SubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033066))\n32982:SubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002210 obo:CL_4033084))\n32984:# Class: obo:CL_4033084 (cuboidal granulosa cell)\n32986:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033084 \"A granulosa cell that has a cuboidal morphology and develops from squamous granulosa cell during the transition between primordial follicle to primary follicle. Cuboidal granulosa cells proliferate to form a second layer within secondary follicles.\")\n32987:AnnotationAssertion(terms:contributor obo:CL_4033084 <https://orcid.org/0000-0001-6677-8489>)\n32988:AnnotationAssertion(terms:date obo:CL_4033084 \"2024-09-24T13:14:57Z\"^^xsd:dateTime)\n32989:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") oboInOwl:hasExactSynonym obo:CL_4033084 \"columnar granulosa cell\")\n32990:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31849844\") oboInOwl:hasExactSynonym obo:CL_4033084 \"cuboidal epithelial granulosa cell\")\n32991:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"columnar GC\")\n32992:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"cuboidal GC\")\n32993:AnnotationAssertion(rdfs:label obo:CL_4033084 \"cuboidal granulosa cell\")\n32994:SubClassOf(obo:CL_4033084 obo:CL_0000501)\n32995:SubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001305))\n32996:SubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033083))\n32998:# Class: obo:CL_4033085 (diffuse bipolar 5 cell)\n33000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033085 \"An ON diffuse bipolar cell that stratifies in the stratum 3 of the inner plexiform layer to make synapses with ON parasol ganglion cells. A diffuse bipolar 5 cell has high expression of MYO16 compared with other bipolar cells.\")\n33001:AnnotationAssertion(obo:RO_0002175 obo:CL_4033085 obo:NCBITaxon_9443)\n33002:AnnotationAssertion(terms:contributor obo:CL_4033085 <https://orcid.org/0000-0001-6677-8489>)\n33003:AnnotationAssertion(terms:date obo:CL_4033085 \"2024-10-16T12:46:53Z\"^^xsd:dateTime)\n33004:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033085 \"DB5 cell\")\n33005:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") rdfs:comment obo:CL_4033085 \"A diffuse bipolar 5 cell typically contacts 7–8 cone photoreceptors. The number and thickness of its dendritic processes are intermediate between those of a diffuse bipolar 6 cell (less dense and thinner) and a diffuse bipolar 4 cell (denser and thicker).\")\n33006:AnnotationAssertion(rdfs:label obo:CL_4033085 \"diffuse bipolar 5 cell\")\n33007:SubClassOf(obo:CL_4033085 obo:CL_0000749)\n33009:# Class: obo:CL_4033086 (lipid-associated macrophage)\n33011:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31257031\") Annotation(oboInOwl:hasDbXref \"PMID:34876704\") Annotation(oboInOwl:hasDbXref \"PMID:35712121\") obo:IAO_0000115 obo:CL_4033086 \"A tissue-resident macrophage that is associated with lipids. This cell responsible of anti-inflammatory functions, lipid accumulation and enhancing phagocytosis (Wculek et al., 2022, Liu et al., 2022). In mice and humans, a lipid-associated macrophage is characterized by the marker Trem2 (Jaitlin et al., 2019).\")\n33012:AnnotationAssertion(terms:contributor obo:CL_4033086 <https://orcid.org/0000-0001-6677-8489>)\n33013:AnnotationAssertion(terms:contributor obo:CL_4033086 <https://orcid.org/0000-0001-8134-3037>)\n33014:AnnotationAssertion(terms:date obo:CL_4033086 \"2024-10-17T10:20:13Z\"^^xsd:dateTime)\n33015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31257031\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033086 \"LAM\")\n33016:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35021063\") Annotation(oboInOwl:hasDbXref \"PMID:37153549\") rdfs:comment obo:CL_4033086 \"Distinct from “adipose macrophage” in Trem2 expression, and is not limited to adipose tissue. Guilliams et al. describe these cells as being distinct from Kupffer cells.\")\n33017:AnnotationAssertion(rdfs:label obo:CL_4033086 \"lipid-associated macrophage\")\n33018:SubClassOf(obo:CL_4033086 obo:CL_0000235)\n33019:SubClassOf(obo:CL_4033086 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000016626))\n33021:# Class: obo:CL_4033087 (placental resident macrophage)\n33023:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033087 \"A tissue-resident macrophage that is part of the placenta. This cell helps preventing immunological rejection of the fetus by modulating the immune environment. A placental resident macrophage has high plasticity to adapt to the changing needs of each phase of pregnancy.\")\n33024:AnnotationAssertion(terms:contributor obo:CL_4033087 <https://orcid.org/0000-0001-6677-8489>)\n33025:AnnotationAssertion(terms:contributor obo:CL_4033087 <https://orcid.org/0000-0001-7655-4833>)\n33026:AnnotationAssertion(terms:date obo:CL_4033087 \"2024-10-31T10:24:21Z\"^^xsd:dateTime)\n33027:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033087 \"placental macrophage\")\n33028:AnnotationAssertion(rdfs:label obo:CL_4033087 \"placental resident macrophage\")\n33029:EquivalentClasses(obo:CL_4033087 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001987)))\n33031:# Class: obo:CL_4033088 (decidual resident macrophage)\n33033:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033088 \"A resident macrophage that is part of the decidua. Some decidual macrophages are derived from maternal blood monocytes that are recruited to the uterus shortly after conception. The main functions of a decidual macrophage are implantation, placental development, immune regulation and vascular remodeling.\")\n33034:AnnotationAssertion(terms:contributor obo:CL_4033088 <https://orcid.org/0000-0001-6677-8489>)\n33035:AnnotationAssertion(terms:contributor obo:CL_4033088 <https://orcid.org/0000-0001-7655-4833>)\n33036:AnnotationAssertion(terms:date obo:CL_4033088 \"2024-10-31T10:33:04Z\"^^xsd:dateTime)\n33037:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033088 \"decidual macrophage\")\n33038:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasBroadSynonym obo:CL_4033088 \"maternal decidual macrophage\")\n33039:AnnotationAssertion(rdfs:label obo:CL_4033088 \"decidual resident macrophage\")\n33040:SubClassOf(obo:CL_4033088 obo:CL_4033087)\n33041:SubClassOf(obo:CL_4033088 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002450))\n33043:# Class: obo:CL_4033089 (atretic follicular cell of ovary)\n33045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4033089 \"A follicular cell of ovary that has begun to degenerate and undergo atresia, a specialized apoptosis. This cell is found in an atretic follicle, which is an ovarian follicle that started to mature but failed to reach full development and instead regresses.\")\n33046:AnnotationAssertion(terms:contributor obo:CL_4033089 <https://orcid.org/0000-0001-6677-8489>)\n33047:AnnotationAssertion(terms:date obo:CL_4033089 \"2024-11-05T11:23:25Z\"^^xsd:dateTime)\n33048:AnnotationAssertion(rdfs:label obo:CL_4033089 \"atretic follicular cell of ovary\")\n33049:EquivalentClasses(obo:CL_4033089 ObjectIntersectionOf(obo:CL_0002174 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0001552)))\n33051:# Class: obo:CL_4033090 (atretic granulosa cell)\n33053:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15353131\") Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4033090 \"A granulosa cell that is undergoing atresia. This cell type displays distinct morphological alterations compared with a healthy granulosa cell, including pyknosis (nuclear condensation) and cellular shrinkage.\")\n33054:AnnotationAssertion(terms:contributor obo:CL_4033090 <https://orcid.org/0000-0001-6677-8489>)\n33055:AnnotationAssertion(terms:date obo:CL_4033090 \"2024-11-05T11:25:28Z\"^^xsd:dateTime)\n33056:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15353131\") oboInOwl:hasRelatedSynonym obo:CL_4033090 \"apoptotic granulosa cell\")\n33057:AnnotationAssertion(rdfs:label obo:CL_4033090 \"atretic granulosa cell\")\n33058:SubClassOf(obo:CL_4033090 obo:CL_4033089)\n33059:SubClassOf(obo:CL_4033090 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000501))\n33061:# Class: obo:CL_4033091 (glycinergic-GABAergic amacrine cell)\n33063:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37124720\") obo:IAO_0000115 obo:CL_4033091 \"An amacrine cell that uses both GABA and glycine as neurotransmitters.\")\n33064:AnnotationAssertion(terms:contributor obo:CL_4033091 <https://orcid.org/0000-0001-6677-8489>)\n33065:AnnotationAssertion(terms:date obo:CL_4033091 \"2024-12-02T13:44:17Z\"^^xsd:dateTime)\n33066:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37124720\") oboInOwl:hasExactSynonym obo:CL_4033091 \"glycinergic/GABAergic amacrine neuron\")\n33067:AnnotationAssertion(rdfs:label obo:CL_4033091 \"glycinergic-GABAergic amacrine cell\")\n33068:EquivalentClasses(obo:CL_4033091 ObjectIntersectionOf(obo:CL_0000561 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061537)))\n33070:# Class: obo:CL_4033092 (CD57-positive enterocyte)\n33072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") obo:IAO_0000115 obo:CL_4033092 \"An enterocyte that is part of a duodenal epithelium and expresses beta-1,3-glucuronyltransferase 1 (B3GAT1), also known as CD57 or HNK-1.\")\n33073:AnnotationAssertion(terms:contributor obo:CL_4033092 <https://orcid.org/0000-0001-6677-8489>)\n33074:AnnotationAssertion(terms:contributor obo:CL_4033092 <https://orcid.org/0000-0001-7655-4833>)\n33075:AnnotationAssertion(terms:contributor obo:CL_4033092 <https://orcid.org/0000-0001-9961-7673>)\n33076:AnnotationAssertion(terms:date obo:CL_4033092 \"2024-12-06T14:32:49Z\"^^xsd:dateTime)\n33077:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") oboInOwl:hasExactSynonym obo:CL_4033092 \"CD57+ enterocyte\")\n33078:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") rdfs:comment obo:CL_4033092 \"While CD57 is traditionally associated with immune cells (e.g., NK cells), its expression on enterocytes marks unique epithelial subsets with specific functions or maturation states. These cells are specially enriched in areas of the duodenum within submucosal glands.\")\n33079:AnnotationAssertion(rdfs:label obo:CL_4033092 \"CD57-positive enterocyte\")\n33080:EquivalentClasses(obo:CL_4033092 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008346) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001440)))\n33082:# Class: obo:CL_4033093 (limbal epithelial stem cell of cornea)\n33084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") Annotation(oboInOwl:hasDbXref \"PMID:29105366\") Annotation(oboInOwl:hasDbXref \"PMID:36983561\") Annotation(oboInOwl:hasDbXref \"PMID:37768272\") obo:IAO_0000115 obo:CL_4033093 \"A stem cell that is part of the corneo-scleral limbus. This cell type resides at the basal layer of the epithelium and has a small size and high nuclear to cytoplasmatic ratio (Secker and Daniels, 2009). A limbal stem cell is responsible for corneal epithelial renewal and repair (Li et al., 2023), and to help maintain a clear corneal surface by preventing conjunctival epithelial cells from migrating onto the cornea (Wang et al., 2023).\")\n33085:AnnotationAssertion(terms:contributor obo:CL_4033093 <https://orcid.org/0000-0001-6677-8489>)\n33086:AnnotationAssertion(terms:contributor obo:CL_4033093 <https://orcid.org/0000-0001-7655-4833>)\n33087:AnnotationAssertion(terms:date obo:CL_4033093 \"2024-12-11T13:59:19Z\"^^xsd:dateTime)\n33088:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") oboInOwl:hasExactSynonym obo:CL_4033093 \"limbal epithelial stem cell\")\n33089:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17562792\") oboInOwl:hasExactSynonym obo:CL_4033093 \"limbal stem cell\")\n33090:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033093 \"LESC\")\n33091:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36983561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033093 \"LSC\")\n33092:AnnotationAssertion(rdfs:label obo:CL_4033093 \"limbal epithelial stem cell of cornea\")\n33093:EquivalentClasses(obo:CL_4033093 ObjectIntersectionOf(obo:CL_0000034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006761)))\n33094:SubClassOf(obo:CL_4033093 obo:CL_0000036)\n33095:SubClassOf(obo:CL_4033093 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000482))\n33096:SubClassOf(obo:CL_4033093 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000575))\n33098:# Class: obo:CL_4033094 (age-associated B cell)\n33100:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30873171\") Annotation(oboInOwl:hasDbXref \"PMID:31986068\") Annotation(oboInOwl:hasDbXref \"PMID:35298565\") Annotation(oboInOwl:hasDbXref \"PMID:35798993\") obo:IAO_0000115 obo:CL_4033094 \"A transcriptionally distinct memory B cell whose presence increases with age, during infections, and in autoimmune diseases. In humans and mice, this cell type can be identified by the expression of T-bet, CD11c, CD11b, and the lack of CD21. An age-associated B cell responds to TLR stimuli, may produce autoantibodies, and participates in antiviral responses and pathogen clearance.\")\n33101:AnnotationAssertion(terms:contributor obo:CL_4033094 <https://orcid.org/0000-0001-6677-8489>)\n33102:AnnotationAssertion(terms:contributor obo:CL_4033094 <https://orcid.org/0000-0001-7655-4833>)\n33103:AnnotationAssertion(terms:date obo:CL_4033094 \"2025-01-08T14:44:57Z\"^^xsd:dateTime)\n33104:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35798993\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033094 \"ABC\")\n33105:AnnotationAssertion(rdfs:label obo:CL_4033094 \"age-associated B cell\")\n33106:SubClassOf(obo:CL_4033094 obo:CL_0000787)\n33108:# Class: obo:CL_4033095 (diffuse bipolar 4a cell)\n33110:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31995762\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") obo:IAO_0000115 obo:CL_4033095 \"An ON bipolar cell that has high expression of DIRC3, KCNJ3, LINC01915, PTPRK compared with other bipolar cells.\")\n33111:AnnotationAssertion(terms:contributor obo:CL_4033095 <https://orcid.org/0000-0001-6677-8489>)\n33112:AnnotationAssertion(terms:date obo:CL_4033095 \"2025-01-14T13:48:42Z\"^^xsd:dateTime)\n33113:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033095 \"DB4a\")\n33114:AnnotationAssertion(rdfs:label obo:CL_4033095 \"diffuse bipolar 4a cell\")\n33115:SubClassOf(obo:CL_4033095 obo:CL_0000749)\n33116:SubClassOf(obo:CL_4033095 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n33118:# Class: obo:CL_4033096 (diffuse bipolar 4b cell)\n33120:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31995762\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") obo:IAO_0000115 obo:CL_4033096 \"An ON bipolar cell that has high expression of NOS1AP compared with other bipolar cells.\")\n33121:AnnotationAssertion(terms:contributor obo:CL_4033096 <https://orcid.org/0000-0001-6677-8489>)\n33122:AnnotationAssertion(terms:date obo:CL_4033096 \"2025-01-14T13:49:08Z\"^^xsd:dateTime)\n33123:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.11.07.566105\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033096 \"DB4b\")\n33124:AnnotationAssertion(rdfs:label obo:CL_4033096 \"diffuse bipolar 4b cell\")\n33125:SubClassOf(obo:CL_4033096 obo:CL_0000749)\n33126:SubClassOf(obo:CL_4033096 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n33128:# Class: obo:CL_4033097 (Schlemm's canal endothelial cell)\n33130:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasDbXref \"PMID:25223880\") obo:IAO_0000115 obo:CL_4033097 \"A specialised endothelial cell that is part of the canal of Schlemm. This cell type shares characteristics and expresses markers of both blood and lymphatic endothelial cells (Kizhatil et al., 2014) and regulates aqueous humor outflow resistance by modulating pore formation and responding to mechanical strain (Stamer et al., 2015).\")\n33131:AnnotationAssertion(terms:contributor obo:CL_4033097 <https://orcid.org/0000-0001-6677-8489>)\n33132:AnnotationAssertion(terms:date obo:CL_4033097 \"2025-06-16T13:55:29Z\"^^xsd:dateTime)\n33133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033097 \"SC endothelial cell\")\n33134:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033097 \"SEC\")\n33135:AnnotationAssertion(rdfs:label obo:CL_4033097 \"Schlemm's canal endothelial cell\")\n33136:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells.\") foaf:depiction obo:CL_4033097 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\n33137:EquivalentClasses(obo:CL_4033097 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004029)))\n33139:# Class: obo:CL_4033098 (inner wall Schlemm's canal endothelial cell)\n33141:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15454474\") Annotation(oboInOwl:hasDbXref \"PMID:26402712\") obo:IAO_0000115 obo:CL_4033098 \"A Schlemm's canal endothelial cell that lines the inner wall of the Schlemm's canal. This cell exhibits a cobblestone appearance due to the significant biomechanical load it experiences, as well as the segmental flow of aqueous humor. The degree of biomechanical stress can lead to the formation of dome-like outpouchings known as giant vacuoles. In addition, the cell contains transcellular pores that mediate aqueous humor transport (Dautriche et al., 2015). This endothelial cell also displays prominent peripheral F-actin bands which help maintain structural integrity under pressure (Ethier et al., 2004).\")\n33142:AnnotationAssertion(terms:contributor obo:CL_4033098 <https://orcid.org/0000-0001-6677-8489>)\n33143:AnnotationAssertion(terms:date obo:CL_4033098 \"2025-06-17T13:33:32Z\"^^xsd:dateTime)\n33144:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26402712\") oboInOwl:hasNarrowSynonym obo:CL_4033098 \"human Schlemm's canal inner wall cell\")\n33145:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033098 \"HSCIW cell\")\n33146:AnnotationAssertion(rdfs:label obo:CL_4033098 \"inner wall Schlemm's canal endothelial cell\")\n33147:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells. The inner wall endocrine cells, shown in blue, line the canal surface facing the trabecular meshwork. Some of the inner wall cells contain giant vacuoles.\") foaf:depiction obo:CL_4033098 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\n33148:SubClassOf(obo:CL_4033098 obo:CL_4033097)\n33149:SubClassOf(obo:CL_4033098 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0046930))\n33151:# Class: obo:CL_4033099 (outer wall Schlemm's canal endothelial cell)\n33153:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1426078\") Annotation(oboInOwl:hasDbXref \"PMID:15454474\") Annotation(oboInOwl:hasDbXref \"PMID:26402712\") obo:IAO_0000115 obo:CL_4033099 \"A Schlemm's canal endothelial cell that lines the outer wall of the Schlemm's canal. This cell displays a smooth and flat morphology (Dautriche et al., 2015) and it is distinguished by the presence of Weibel-Palade bodies, specialized organelles that produce, store, and release P-Selectin (Hamanaka et al., 1992). This endothelial cell also exhibits stellate (star-shaped) actin arrangements distributed throughout much of the cell (Ethier et al., 2004).\")\n33154:AnnotationAssertion(terms:contributor obo:CL_4033099 <https://orcid.org/0000-0001-6677-8489>)\n33155:AnnotationAssertion(terms:date obo:CL_4033099 \"2025-06-17T13:33:41Z\"^^xsd:dateTime)\n33156:AnnotationAssertion(rdfs:label obo:CL_4033099 \"outer wall Schlemm's canal endothelial cell\")\n33157:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:26402712\") Annotation(rdfs:comment \"Schematic of the conventional outflow pathway, showing the Schlemm's canal (SC, green) and the trabecular meshwork (TM, orange). The left inset shows an expanded view of the Schlemm’s canal’s microanatomy detailing the cell morphology of the inner and outer wall endocrine cells. The outer wall endocrine cells, shown in green, line the side of Schlemm’s canal facing the collector channels and venous system.\") foaf:depiction obo:CL_4033099 \"http://purl.obolibrary.org/obo/cl/images/Schlemms_canal_endo_cell_PMID26402712.png\"^^xsd:anyURI)\n33158:SubClassOf(obo:CL_4033099 obo:CL_4033097)\n33159:SubClassOf(obo:CL_4033099 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0033093))\n33160:SubClassOf(obo:CL_4033099 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PR_000001432))\n33162:# Class: obo:CL_4040000 (glial restricted tripotential precursor cell)\n33164:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10719353\") obo:IAO_0000115 obo:CL_4040000 \"A glial precursor cell that generates oligodendrocytes and type-1 and type-2 astrocytes. It has been shown in some mammals that this cell type may express A2B5, nestin, FGFR-1, FGFR-2, FGFR-3, PLP, and DM-20 antigens. Unlike oligodendrocyte precursor cell, it does not initially express PDGFR-alpha and can differentiate into both type-1 and type-2 astrocytes.\")\n33165:AnnotationAssertion(terms:contributor obo:CL_4040000 <https://orcid.org/0000-0002-0819-0473>)\n33166:AnnotationAssertion(terms:date obo:CL_4040000 \"2023-04-03T14:54:32Z\"^^xsd:dateTime)\n33167:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10719353\") oboInOwl:hasBroadSynonym obo:CL_4040000 \"glial restricted precursor\")\n33168:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11921204\") oboInOwl:hasExactSynonym obo:CL_4040000 \"tripotential glial-restricted precursor cell\")\n33169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11756508\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4040000 \"GRP cell\")\n33170:AnnotationAssertion(rdfs:label obo:CL_4040000 \"glial restricted tripotential precursor cell\")\n33171:SubClassOf(obo:CL_4040000 obo:CL_0000123)\n33172:SubClassOf(obo:CL_4040000 obo:CL_0011115)\n33174:# Class: obo:CL_4040001 (chorionic girdle cell)\n33176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27280409\") Annotation(oboInOwl:hasDbXref \"PMID:35328607\") obo:IAO_0000115 obo:CL_4040001 \"A horse-specific, highly invasive trophoblast cell that invades the endometrium where it forms endometrial cups.\")\n33177:AnnotationAssertion(obo:RO_0002175 obo:CL_4040001 obo:NCBITaxon_9789)\n33178:AnnotationAssertion(terms:contributor obo:CL_4040001 <https://orcid.org/0000-0002-0819-0473>)\n33179:AnnotationAssertion(terms:date obo:CL_4040001 \"2023-04-03T15:08:05Z\"^^xsd:dateTime)\n33180:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35328607\") oboInOwl:hasExactSynonym obo:CL_4040001 \"equine chorionic girdle cell\")\n33181:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27280409\") rdfs:comment obo:CL_4040001 \"Humans, mice and rats have a highly invasive (hemochorial) placentation. Horses have a non-invasive epitheliochorial placenta, except for the transient endometrial cup.\")\n33182:AnnotationAssertion(rdfs:label obo:CL_4040001 \"chorionic girdle cell\")\n33183:SubClassOf(obo:CL_4040001 obo:CL_0000351)\n33184:SubClassOf(obo:CL_4040001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003124))\n33186:# Class: obo:CL_4040002 (enteroglial cell)\n33188:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16336493\") Annotation(oboInOwl:hasDbXref \"PMID:17483847\") Annotation(oboInOwl:hasDbXref \"PMID:25975510\") obo:IAO_0000115 obo:CL_4040002 \"Glial cell that provides support to the enteric nervous system. It is involved in enteric neurotransmission, in maintaining the integrity of the mucosal barrier of the gut and serves as a link between the nervous and immune systems of the gut. In enteric nerve strands, glial processes ensheath multiaxonal bundles which distinguishes enteric glia from all other peripheral glia. Ultrastructurally, the most conspicuous trait of an enteroglial cell is the presence of 10 nm filaments, which criss-cross the cell body, form axial bundles in the processes and appear to firmly anchor the cells to the ganglionic surfaces. Similar to astrocytes, their main constituent is glial fibrillary acidic protein (GFAP).\")\n33189:AnnotationAssertion(terms:contributor obo:CL_4040002 <https://orcid.org/0000-0002-0819-0473>)\n33190:AnnotationAssertion(terms:date obo:CL_4040002 \"2023-04-03T15:15:40Z\"^^xsd:dateTime)\n33191:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11169131\") Annotation(oboInOwl:hasDbXref \"PMID:25170211\") oboInOwl:hasExactSynonym obo:CL_4040002 \"enteric glial cell\")\n33192:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11169131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4040002 \"enteric glia\")\n33193:AnnotationAssertion(rdfs:label obo:CL_4040002 \"enteroglial cell\")\n33194:EquivalentClasses(obo:CL_4040002 ObjectIntersectionOf(obo:CL_0000125 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002005)))\n33195:SubClassOf(obo:CL_4040002 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007939))\n33197:# Class: obo:CL_4040003 (fetal pre-type II pulmonary alveolar epithelial cell)\n33199:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1316350\") obo:IAO_0000115 obo:CL_4040003 \"Precursor of type II pneumocyte. These cells do not have lamellar bodies, which are a marker of type II pneumocyte maturity.\")\n33200:AnnotationAssertion(terms:contributor obo:CL_4040003 <https://orcid.org/0000-0002-0819-0473>)\n33201:AnnotationAssertion(terms:date obo:CL_4040003 \"2023-06-02T09:19:31Z\"^^xsd:dateTime)\n33202:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9624168\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal alveolar pre-type II epithelial cell\")\n33203:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-0819-0473\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type 2 pneumocyte\")\n33204:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12114192\") oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type II alveolar epithelial cell\")\n33205:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4040003 \"fetal pre-type II pneumocyte\")\n33206:AnnotationAssertion(rdfs:comment obo:CL_4040003 \"According to PMID:1316350 this cell type does not yet produce surfactant. According to PMID:9109447 and PMID:12114192 this cell type produces low levels of surfactant that can be increased by administration of very low-density lipoproteins. This cell type is of medical relevance, as a central feature of the fetal respiratory distress syndrome seems to be the presence in the lung of abundant pre-type II alveolar epithelial cells (PMID:1316350).\")\n33207:AnnotationAssertion(rdfs:label obo:CL_4040003 \"fetal pre-type II pulmonary alveolar epithelial cell\")\n33208:SubClassOf(obo:CL_4040003 obo:CL_0000322)\n33210:# Class: obo:CL_4040004 (mesenchymal stem cell of orbital adipose tissue)\n33212:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0819-0473>) obo:IAO_0000115 obo:CL_4040004 \"Any mesenchymal stem cell of adipose tissue that is part of an orbital region.\")\n33213:AnnotationAssertion(terms:contributor obo:CL_4040004 <https://orcid.org/0000-0002-0819-0473>)\n33214:AnnotationAssertion(terms:date obo:CL_4040004 \"2023-09-18T10:43:00Z\"^^xsd:dateTime)\n33215:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31377878\") oboInOwl:hasExactSynonym obo:CL_4040004 \"OAMSC\")\n33216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30210548\") oboInOwl:hasExactSynonym obo:CL_4040004 \"Orbital ASCs\")\n33217:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31377878\") oboInOwl:hasExactSynonym obo:CL_4040004 \"orbital adipose-derived mesenchymal stem cell\")\n33218:AnnotationAssertion(rdfs:label obo:CL_4040004 \"mesenchymal stem cell of orbital adipose tissue\")\n33219:EquivalentClasses(obo:CL_4040004 ObjectIntersectionOf(obo:CL_0002570 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004088)))\n33221:# Class: obo:CL_4040005 (mesenchymal stem cell of apical papilla)\n33223:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasDbXref \"PMID:34026757\") obo:IAO_0000115 obo:CL_4040005 \"A mesenchymal stem cell that is part of the apical papilla tooth root.\")\n33224:AnnotationAssertion(terms:contributor obo:CL_4040005 <https://orcid.org/0000-0002-0819-0473>)\n33225:AnnotationAssertion(terms:date obo:CL_4040005 \"2023-11-02T09:44:47Z\"^^xsd:dateTime)\n33226:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasBroadSynonym obo:CL_4040005 \"stem cells from the apical papilla\")\n33227:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37887345\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4040005 \"SCAP\")\n33228:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_4040005 \"SCAPs\")\n33229:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34026757\") rdfs:comment obo:CL_4040005 \"The mesenchymal stem cells of the apical papilla have high capacity for osteogenic, adipogenic, and chondrogenic differentiation.\")\n33230:AnnotationAssertion(rdfs:label obo:CL_4040005 \"mesenchymal stem cell of apical papilla\")\n33231:SubClassOf(obo:CL_4040005 obo:CL_0000134)\n33232:SubClassOf(obo:CL_4040005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003677))\n33234:# Class: obo:CL_4040006 (dermal chromatophore)\n33236:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28553007\") obo:IAO_0000115 obo:CL_4040006 \"A chromatophore that is part of the dermis.\")\n33237:AnnotationAssertion(terms:contributor obo:CL_4040006 <https://orcid.org/0000-0002-0819-0473>)\n33238:AnnotationAssertion(terms:date obo:CL_4040006 \"2024-03-07T09:37:14Z\"^^xsd:dateTime)\n33239:AnnotationAssertion(rdfs:label obo:CL_4040006 \"dermal chromatophore\")\n33240:SubClassOf(obo:CL_4040006 obo:CL_0000147)\n33241:SubClassOf(obo:CL_4040006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002067))\n33243:# Class: obo:CL_4042001 (TAC3-positive striatal interneuron)\n33245:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4042001 \"A GABAergic interneuron that has its soma located in the striatum and that has an enriched expression of the genes TAC3 and LHX6.\")\n33246:AnnotationAssertion(terms:contributor obo:CL_4042001 <https://orcid.org/0000-0002-0098-8958>)\n33247:AnnotationAssertion(terms:date obo:CL_4042001 \"2024-03-05T14:29:32Z\"^^xsd:dateTime)\n33248:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") oboInOwl:hasExactSynonym obo:CL_4042001 \"TAC3 interneuron\")\n33249:AnnotationAssertion(rdfs:label obo:CL_4042001 \"TAC3-positive striatal interneuron\"@en)\n33250:SubClassOf(obo:CL_4042001 obo:CL_0011005)\n33251:SubClassOf(obo:CL_4042001 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33252:SubClassOf(obo:CL_4042001 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000016004))\n33254:# Class: obo:CL_4042002 (TAC3-positive medium spiny neuron)\n33256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") obo:IAO_0000115 obo:CL_4042002 \"A nucleus accumbens shell and olfactory tubercle D1 medium spiny neuron that co-expresses TAC3 and the DRD1 receptor.\")\n33257:AnnotationAssertion(terms:contributor obo:CL_4042002 <https://orcid.org/0000-0002-0098-8958>)\n33258:AnnotationAssertion(terms:date obo:CL_4042002 \"2024-03-05T13:36:54Z\"^^xsd:dateTime)\n33259:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"D1Sh TAC3 archetype\")\n33260:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"TAC3-positive D1Sh-MSN\")\n33261:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042002 \"TAC3-positive MSN\")\n33262:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") rdfs:comment obo:CL_4042002 \"A TAC3-positive medium spiny neuron has its soma in a cluster in the medial shell region of the nucleus accumbens. In Rhesus Macaque, this medium spiny neuron has an enriched expression of the genes MPPED1, HPCAL1, MEIS3.\")\n33263:AnnotationAssertion(rdfs:label obo:CL_4042002 \"TAC3-positive medium spiny neuron\"@en)\n33264:SubClassOf(obo:CL_4042002 obo:CL_4030051)\n33265:SubClassOf(obo:CL_4042002 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000016004))\n33267:# Class: obo:CL_4042003 (border associated macrophage)\n33269:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasDbXref \"PMID:37626977\") obo:IAO_0000115 obo:CL_4042003 \"A central nervous system macrophage that is part of a choroid plexus, a meninx and a perivascular space. A border associated macrophage interacts with various components of the CNS vasculature and meninges, it participates in immune surveillance and in the regulation of the blood brain barrier.\")\n33270:AnnotationAssertion(terms:contributor obo:CL_4042003 <https://orcid.org/0000-0002-0098-8958>)\n33271:AnnotationAssertion(terms:date obo:CL_4042003 \"2024-03-26T16:39:56Z\"^^xsd:dateTime)\n33272:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36945367\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042003 \"BAM\")\n33273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33556248\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042003 \"CAM\")\n33274:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") oboInOwl:hasRelatedSynonym obo:CL_4042003 \"CNS-associated macrophage\")\n33275:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29426702\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") rdfs:comment obo:CL_4042003 \"In humans, a border associate macrophage expresses CD45 and CD11B. This cell is also known to have the following molecular signature: CD206, CD38, LYVE1, CD163, CD169.\")\n33276:AnnotationAssertion(rdfs:label obo:CL_4042003 \"border associated macrophage\"@en)\n33277:SubClassOf(obo:CL_4042003 obo:CL_0000878)\n33279:# Class: obo:CL_4042004 (choroid epiplexus macrophage)\n33281:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") obo:IAO_0000115 obo:CL_4042004 \"A choroid plexus macrophage that is part of the apical surface of some choroid plexus epithelium. This macrophage has a star-like shaped body.\")\n33282:AnnotationAssertion(terms:contributor obo:CL_4042004 <https://orcid.org/0000-0002-0098-8958>)\n33283:AnnotationAssertion(terms:date obo:CL_4042004 \"2024-03-26T19:14:58Z\"^^xsd:dateTime)\n33284:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31433571\") oboInOwl:hasExactSynonym obo:CL_4042004 \"Kolmer’s cell\")\n33285:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042004 \"cpepiMΦ\")\n33286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042004 \"epiplexus cpMΦ\")\n33287:AnnotationAssertion(rdfs:label obo:CL_4042004 \"choroid epiplexus macrophage\"@en)\n33288:SubClassOf(obo:CL_4042004 obo:CL_0000880)\n33289:SubClassOf(obo:CL_4042004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003911))\n33291:# Class: obo:CL_4042005 (stromal choroid plexus macrophage)\n33293:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") obo:IAO_0000115 obo:CL_4042005 \"A choroid plexus macrophage that is part of a choroid plexus stroma.\")\n33294:AnnotationAssertion(terms:contributor obo:CL_4042005 <https://orcid.org/0000-0002-0098-8958>)\n33295:AnnotationAssertion(terms:date obo:CL_4042005 \"2024-03-26T19:21:51Z\"^^xsd:dateTime)\n33296:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37626977\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042005 \"cpstMΦ\")\n33297:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasDbXref \"PMID:38347231\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042005 \"stromal cpMΦ\")\n33298:AnnotationAssertion(rdfs:label obo:CL_4042005 \"stromal choroid plexus macrophage\"@en)\n33299:SubClassOf(obo:CL_4042005 obo:CL_0000880)\n33300:SubClassOf(obo:CL_4042005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005206))\n33302:# Class: obo:CL_4042006 (dural macrophage)\n33304:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") obo:IAO_0000115 obo:CL_4042006 \"A border associated macrophage which is part of a dura matter. This macrophage phagocytoses intruding pathogens and foreign molecules detected in the bloodstream or in the cerebrospinal fluid. This cell has an amoeboid body with dynamic protrusions in homeostasis.\")\n33305:AnnotationAssertion(terms:contributor obo:CL_4042006 <https://orcid.org/0000-0002-0098-8958>)\n33306:AnnotationAssertion(terms:date obo:CL_4042006 \"2024-03-26T19:27:03Z\"^^xsd:dateTime)\n33307:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042006 \"dmMΦ\")\n33308:AnnotationAssertion(rdfs:label obo:CL_4042006 \"dural macrophage\"@en)\n33309:SubClassOf(obo:CL_4042006 obo:CL_4042003)\n33310:SubClassOf(obo:CL_4042006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002092))\n33312:# Class: obo:CL_4042007 (protoplasmic astrocyte)\n33314:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:25904839\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042007 \"An astrocyte with highly branched protrusions, found in neocortex layers 2-6. It is involved with the formation and elimination of synapses, glutamate clearance, modulation of synaptic functions and regulation of blood flow in response to synaptic activity.\")\n33315:AnnotationAssertion(terms:contributor obo:CL_4042007 <https://orcid.org/0000-0002-0098-8958>)\n33316:AnnotationAssertion(terms:date obo:CL_4042007 \"2024-04-08T16:01:24Z\"^^xsd:dateTime)\n33317:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:20012068\") rdfs:comment obo:CL_4042007 \"This astrocyte extends its branches to several hundred of dendrites to multiple neurons to envelope 100,000 or more synapses. In humans, a protoplasmic astrocyte has an average diameter of 142 µm, and its diameter ranges between 100 and 400 µm. In rodents the average diameter of a protoplasmic astrocites is 56 µm.\")\n33318:AnnotationAssertion(rdfs:label obo:CL_4042007 \"protoplasmic astrocyte\"@en)\n33319:SubClassOf(obo:CL_4042007 obo:CL_0002605)\n33320:SubClassOf(obo:CL_4042007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33322:# Class: obo:CL_4042008 (fibrous astrocyte)\n33324:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:22144298\") Annotation(oboInOwl:hasDbXref \"PMID:28280934\") Annotation(oboInOwl:hasDbXref \"PMID:31435019\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042008 \"A cell type located in the first layer of the neocortex with radial protrusions extending transversely into the deeper cortex layers, herby facilitating communication across neurons, astrocytes, capillaries, meninges and cerebrospinal fluid through contact with neurons, pia mater and capillaries.\")\n33325:AnnotationAssertion(terms:contributor obo:CL_4042008 <https://orcid.org/0000-0002-0098-8958>)\n33326:AnnotationAssertion(terms:date obo:CL_4042008 \"2024-04-08T16:29:28Z\"^^xsd:dateTime)\n33327:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28280934\") rdfs:comment obo:CL_4042008 \"In humans, a fibrous astrocyte diameter is circa 182 µm. In rodents, a fibrous astrocyte diameter is circa 85 µm.\")\n33328:AnnotationAssertion(rdfs:label obo:CL_4042008 \"fibrous astrocyte\"@en)\n33329:SubClassOf(obo:CL_4042008 obo:CL_0000127)\n33330:SubClassOf(obo:CL_4042008 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002316))\n33332:# Class: obo:CL_4042009 (interlaminar astrocyte)\n33334:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:30552685\") Annotation(oboInOwl:hasDbXref \"PMID:31435019\") Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042009 \"An astrocyte type that presents radial protrusions across the layers of a cortex. The soma of this astrocyte is part of the first layer of a neocortex. This astrocyte extents its protrusions transversally to the deeper layers of a cortex and it creates contact with neurons, the pia matter and capillaries. This astrocyte is involved in facilitating the communication across neurons, astrocytes, capillaries, meninges and the cerebrospinal fluid.\")\n33335:AnnotationAssertion(terms:contributor obo:CL_4042009 <https://orcid.org/0000-0002-0098-8958>)\n33336:AnnotationAssertion(terms:date obo:CL_4042009 \"2024-04-08T16:33:45Z\"^^xsd:dateTime)\n33337:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30552685\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042009 \"ILA\")\n33338:AnnotationAssertion(rdfs:label obo:CL_4042009 \"interlaminar astrocyte\"@en)\n33339:SubClassOf(obo:CL_4042009 obo:CL_0002605)\n33340:SubClassOf(obo:CL_4042009 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33342:# Class: obo:CL_4042010 (pial interlaminar astrocyte)\n33344:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042010 \"An interlaminar astrocyte whose soma is part of the first layer of a neocortex and is in contact with a pia surface.\")\n33345:AnnotationAssertion(terms:contributor obo:CL_4042010 <https://orcid.org/0000-0002-0098-8958>)\n33346:AnnotationAssertion(terms:date obo:CL_4042010 \"2024-04-08T16:37:57Z\"^^xsd:dateTime)\n33347:AnnotationAssertion(rdfs:label obo:CL_4042010 \"pial interlaminar astrocyte\"@en)\n33348:SubClassOf(obo:CL_4042010 obo:CL_4042009)\n33350:# Class: obo:CL_4042011 (subpial interlaminar astrocyte)\n33352:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042011 \"An interlaminar astrocyte type whose soma is part of the upper first layer of the neocortex and its processes extend to a pia surface.\")\n33353:AnnotationAssertion(terms:contributor obo:CL_4042011 <https://orcid.org/0000-0002-0098-8958>)\n33354:AnnotationAssertion(terms:date obo:CL_4042011 \"2024-04-08T16:39:09Z\"^^xsd:dateTime)\n33355:AnnotationAssertion(rdfs:label obo:CL_4042011 \"subpial interlaminar astrocyte\"@en)\n33356:SubClassOf(obo:CL_4042011 obo:CL_4042009)\n33357:SubClassOf(obo:CL_4042011 ObjectSomeValuesFrom(obo:RO_0002170 obo:UBERON_0002361))\n33359:# Class: obo:CL_4042012 (L2 marginal neuron)\n33361:AnnotationAssertion(obo:IAO_0000028 obo:CL_4042012 \"L2MN\")\n33362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29311847\") Annotation(oboInOwl:hasDbXref \"PMID:32108571\") obo:IAO_0000115 obo:CL_4042012 \"An L2 intratelencephalic projecting glutamatergic neuron with a soma on the L1-L2 border. This neuron type has small apical dendrites projecting to L1.\")\n33363:AnnotationAssertion(terms:contributor obo:CL_4042012 <https://orcid.org/0000-0002-0098-8958>)\n33364:AnnotationAssertion(terms:date obo:CL_4042012 \"2024-04-23T09:31:39Z\"^^xsd:dateTime)\n33365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32108571\") oboInOwl:hasExactSynonym obo:CL_4042012 \"layer 2 marginal neuron\")\n33366:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29311847\") Annotation(oboInOwl:hasDbXref \"PMID:32108571\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042012 \"L2MN\")\n33367:AnnotationAssertion(rdfs:label obo:CL_4042012 \"L2 marginal neuron\"@en)\n33368:SubClassOf(obo:CL_4042012 obo:CL_4030060)\n33370:# Class: obo:CL_4042013 (Lamp5 Lhx6 neuron)\n33372:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042013 \"A transcriptomically distinct GABAergic interneuron marked by Lamp5 and Lhx6 expression, derived from the Medial Ganglionic Eminence (MGE), and located in the pallium.\")\n33373:AnnotationAssertion(terms:contributor obo:CL_4042013 <https://orcid.org/0000-0002-0098-8958>)\n33374:AnnotationAssertion(terms:date obo:CL_4042013 \"2024-04-23T09:37:55Z\"^^xsd:dateTime)\n33375:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36007006\") oboInOwl:hasExactSynonym obo:CL_4042013 \"Ivy cell\")\n33376:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") oboInOwl:hasExactSynonym obo:CL_4042013 \"Lamp5-Lhx6 type\")\n33377:AnnotationAssertion(rdfs:label obo:CL_4042013 \"Lamp5 Lhx6 neuron\"@en)\n33378:SubClassOf(obo:CL_4042013 obo:CL_4023069)\n33379:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n33380:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n33381:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n33382:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148))\n33383:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032533))\n33385:# Class: obo:CL_4042014 (spiny VIP neuron)\n33387:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") obo:IAO_0000115 obo:CL_4042014 \"A VIP GABAergic cortical interneuron with a soma located in L1-3 of some neocortex in Mmus. This neuron has a multipolar morphology with spiny dendrites concentrating on L1 of the cortex, and has a burst firing electrophysiological signature with highly dynamic dendritic spines.\")\n33388:AnnotationAssertion(terms:contributor obo:CL_4042014 <https://orcid.org/0000-0002-0098-8958>)\n33389:AnnotationAssertion(terms:date obo:CL_4042014 \"2024-07-11T12:09:53Z\"^^xsd:dateTime)\n33390:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") oboInOwl:hasExactSynonym obo:CL_4042014 \"superficial VIP-positive spiny neuron\")\n33391:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35418660\") oboInOwl:hasRelatedSynonym obo:CL_4042014 \"multipolar VIP neuron\")\n33392:AnnotationAssertion(rdfs:label obo:CL_4042014 \"spiny VIP neuron\"@en)\n33393:SubClassOf(obo:CL_4042014 obo:CL_4023016)\n33394:SubClassOf(obo:CL_4042014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33396:# Class: obo:CL_4042015 (VIP-ChAT interneuron)\n33398:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:31754098\") Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasDbXref \"PMID:33301603\") obo:IAO_0000115 obo:CL_4042015 \"A VIP GABAergic cortical interneuron expressing vasoactive intestinal polypeptide and choline acetyltransferase in the Mmus neocortex. This interneuron releases both γ-aminobutyric acid and acetylcholine.\")\n33399:AnnotationAssertion(terms:contributor obo:CL_4042015 <https://orcid.org/0000-0002-0098-8958>)\n33400:AnnotationAssertion(terms:date obo:CL_4042015 \"2024-07-11T12:22:48Z\"^^xsd:dateTime)\n33401:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33301603\") oboInOwl:hasExactSynonym obo:CL_4042015 \"VIP+/ChAT+ interneuron\")\n33402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32027647\") oboInOwl:hasExactSynonym obo:CL_4042015 \"VIP/ChAT interneuron\")\n33403:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042015 \"VChI\")\n33404:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33301603\") oboInOwl:hasRelatedSynonym obo:CL_4042015 \"VIP+/ChAT+ cell\")\n33405:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasDbXref \"PMID:33301603\") rdfs:comment obo:CL_4042015 \"Work in the mouse barrel cortex and somatosensory cortex shows that a VIP-ChAT interneuron is predominantely located in L2/3 and more rarely in the deeper layers of the cortex (Dudai et al., 2021; Dudai et al., 2020). This neuronal type could be transcriptomically distinct as transcriptomic studies have identified VIP neurons expressing ChAT in a whole brain mouse transcriptomic study (Tasic et al., 2018).\")\n33406:AnnotationAssertion(rdfs:label obo:CL_4042015 \"VIP-ChAT interneuron\"@en)\n33407:SubClassOf(obo:CL_4042015 obo:CL_4023016)\n33408:SubClassOf(obo:CL_4042015 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\n33410:# Class: obo:CL_4042016 (nasal serous secreting cell)\n33412:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4042016 \"A serous secreting cell that is part of a submucosal gland in the nasal cavity respiratory epithelium.\")\n33413:AnnotationAssertion(terms:contributor obo:CL_4042016 <https://orcid.org/0000-0002-0098-8958>)\n33414:AnnotationAssertion(terms:date obo:CL_4042016 \"2024-07-12T10:58:06Z\"^^xsd:dateTime)\n33415:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4042016 \"https://cellxgene.cziscience.com/e/9f222629-9e39-47d0-b83f-e08d610c7479.cxg/\")\n33416:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11005715\") oboInOwl:hasRelatedSynonym obo:CL_4042016 \"nasal mucous secretory cell\")\n33417:AnnotationAssertion(rdfs:label obo:CL_4042016 \"nasal serous secreting cell\"@en)\n33418:SubClassOf(obo:CL_4042016 obo:CL_0000313)\n33419:SubClassOf(obo:CL_4042016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005385))\n33420:SubClassOf(obo:CL_4042016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011148))\n33422:# Class: obo:CL_4042017 (alpha1-tanycyte)\n33424:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042017 \"The dorsal-most tanycyte type of the third venticle.  These cells projects into the ventromedial or dorsomedial nucleus of the hypothalamus. This type of tanycyte extends its protrusions close to parenchymal neurons without contacting blood vessels. It expresses the glial marker S-100β.\")\n33425:AnnotationAssertion(terms:contributor obo:CL_4042017 <https://orcid.org/0000-0002-0098-8958>)\n33426:AnnotationAssertion(terms:date obo:CL_4042017 \"2024-08-19T13:06:16Z\"^^xsd:dateTime)\n33427:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042017 \"DMH tanycyte\")\n33428:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042017 \"VMH tanycyte\")\n33429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26578855\") rdfs:comment obo:CL_4042017 \"In rodents, a1 tanycytes are known to express DARPP-32, GPR50, NA Vimentin, Connexin 43, GLT-1, GLUT1(+) (Goodman and Hajihosseini 2015; Prevot et al., 2018).\")\n33430:AnnotationAssertion(rdfs:label obo:CL_4042017 \"alpha1-tanycyte\"@en)\n33431:AnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042017 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\n33432:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042017 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\n33433:SubClassOf(obo:CL_4042017 obo:CL_0002085)\n33434:SubClassOf(obo:CL_4042017 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004642))\n33435:SubClassOf(obo:CL_4042017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000014419))\n33437:# Class: obo:CL_4042018 (alpha2-tanycyte)\n33439:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042018 \"Tanycyte of the third ventricle, located immediately ventral to alpha-1 tanycytes. These cells project to the ventromedial and arcuate nuclei of the hypothalamus and express the glial marker S-100β.\")\n33440:AnnotationAssertion(terms:contributor obo:CL_4042018 <https://orcid.org/0000-0002-0098-8958>)\n33441:AnnotationAssertion(terms:date obo:CL_4042018 \"2024-08-19T13:13:20Z\"^^xsd:dateTime)\n33442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042018 \"dmARH tanycyte\")\n33443:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26578855\") rdfs:comment obo:CL_4042018 \"In rodents, this type of tanycyte is more developmentally advanced than alpha1 tanycytes, shows a high neurogenic competence and expresses the following markers DARPP-32, Vimentin, GPR50, Connexin-43, GLT-1, GLUT1(+) (Goodman and Hajihosseini 2015; Prevot et al., 2018)\")\n33444:AnnotationAssertion(rdfs:label obo:CL_4042018 \"alpha2-tanycyte\"@en)\n33445:AnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042018 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\n33446:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042018 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\n33447:SubClassOf(obo:CL_4042018 obo:CL_0002085)\n33448:SubClassOf(obo:CL_4042018 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0001932))\n33449:SubClassOf(obo:CL_4042018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000014419))\n33451:# Class: obo:CL_4042019 (beta1-tanycyte)\n33453:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042019 \"A type of tanycyte located in ventral part of the lateral wall of the third ventricle and in the lateral infundibular recess of the brain. This tanycyte has an elongated morphology with multiple microvilli extending into the median eminence. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).\")\n33454:AnnotationAssertion(terms:contributor obo:CL_4042019 <https://orcid.org/0000-0002-0098-8958>)\n33455:AnnotationAssertion(terms:date obo:CL_4042019 \"2024-08-19T13:17:32Z\"^^xsd:dateTime)\n33456:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042019 \"vmARH tanycyte\")\n33457:AnnotationAssertion(rdfs:label obo:CL_4042019 \"beta1-tanycyte\"@en)\n33458:AnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042019 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\n33459:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042019 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\n33460:SubClassOf(obo:CL_4042019 obo:CL_0002085)\n33461:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006250))\n33462:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0002197))\n33463:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032274))\n33464:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007479))\n33465:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007489))\n33467:# Class: obo:CL_4042020 (beta2-tanycyte)\n33469:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042020 \"A type of tanycyte located in the floor of third ventricle and the infindibular recess. This tanycyte has an elongated morphology with multiple microvilli extending medially and ventrally to the median eminence, contacting the pial surface and blood vessels. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).\")\n33470:AnnotationAssertion(terms:contributor obo:CL_4042020 <https://orcid.org/0000-0002-0098-8958>)\n33471:AnnotationAssertion(terms:date obo:CL_4042020 \"2024-08-19T13:21:39Z\"^^xsd:dateTime)\n33472:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29351662\") oboInOwl:hasRelatedSynonym obo:CL_4042020 \"ME tanycyte\")\n33473:AnnotationAssertion(rdfs:label obo:CL_4042020 \"beta2-tanycyte\"@en)\n33474:AnnotationAssertion(Annotation(terms:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fendo.2019.00401>) foaf:depiction obo:CL_4042020 <http://purl.obolibrary.org/obo/cl/images/fendo-10-00401-g001.jpg>)\n33475:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref <doi:10.3389/fnins.2022.1129414>) Annotation(rdfs:comment \"α1 tanycytes are the most dorsally located subtype, followed by α2 tanycytes, then β1 tanycytes, and finally β2 tanycytes which occupy the ventricular floor. 3V, third ventricle; Arc, arcuate nucleus; DMH, dorsomedial hypothalamic nucleus; VMH, ventromedial hypothalamic nucleus.\") foaf:depiction obo:CL_4042020 <http://purl.obolibrary.org/obo/cl/images/fnins-16-1129414-g001.jpg>)\n33476:SubClassOf(obo:CL_4042020 obo:CL_0002085)\n33477:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006250))\n33478:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0002197))\n33479:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007479))\n33480:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007489))\n33482:# Class: obo:CL_4042021 (neuronal-restricted precursor)\n33484:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10467245\") obo:IAO_0000115 obo:CL_4042021 \"A progenitor cell of the central nervous system that differentiates exclusively onto neurons. This progenitor cell is found in a hippocampus subventricular zone, developing cortex and spinal cord of the central nervous system.\")\n33485:AnnotationAssertion(terms:contributor obo:CL_4042021 <https://orcid.org/0000-0002-0098-8958>)\n33486:AnnotationAssertion(terms:date obo:CL_4042021 \"2024-09-02T11:42:12Z\"^^xsd:dateTime)\n33487:AnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:12429182\") oboInOwl:hasRelatedSynonym obo:CL_4042021 \"NRP\")\n33488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12429182\") Annotation(oboInOwl:hasDbXref \"PMID:9354325\") rdfs:comment obo:CL_4042021 \"In vitro cultures of embryonic mouse neural tubes show that neuronal-restricted precursors (NRPs) are derived from multipotent neuroepithelial cells to give rise to neurons. This progression suggests a linear relationship between multipotent progenitors and neuronal-restricted differentiation. (Mayer-Proschel et al., 1997). In the spinal cord of rats, neural-restricted precursor cells give rise cholinergic, GABAergic, glutametergic neurons (Cao and Howard et al., 2002).\")\n33489:AnnotationAssertion(rdfs:label obo:CL_4042021 \"neuronal-restricted precursor\"@en)\n33490:SubClassOf(obo:CL_4042021 obo:CL_0000123)\n33491:SubClassOf(obo:CL_4042021 obo:CL_0011026)\n33492:SubClassOf(obo:CL_4042021 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n33494:# Class: obo:CL_4042022 (astrocyte-restricted precursor)\n33496:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15531362\") Annotation(oboInOwl:hasDbXref \"PMID:33052610\") obo:IAO_0000115 obo:CL_4042022 \"A progenitor cell of the central nervous system that differentiates exclusively onto astrocytes. This progenitor cell expresses CD44 and S100 calcium-binding protein B.\")\n33497:AnnotationAssertion(terms:contributor obo:CL_4042022 <https://orcid.org/0000-0002-0098-8958>)\n33498:AnnotationAssertion(terms:date obo:CL_4042022 \"2024-09-02T11:44:45Z\"^^xsd:dateTime)\n33499:AnnotationAssertion(Annotation(oboInOwl:SynonymTypeProperty obo:OMO_0003000) Annotation(oboInOwl:hasDbXref \"PMID:33052610\") oboInOwl:hasRelatedSynonym obo:CL_4042022 \"ARP\")\n33500:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") oboInOwl:hasRelatedSynonym obo:CL_4042022 \"astrocyte precursor cell\")\n33501:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") rdfs:comment obo:CL_4042022 \"In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.\")\n33502:AnnotationAssertion(rdfs:label obo:CL_4042022 \"astrocyte-restricted precursor\"@en)\n33503:SubClassOf(obo:CL_4042022 obo:CL_0000123)\n33504:SubClassOf(obo:CL_4042022 obo:CL_0011026)\n33505:SubClassOf(obo:CL_4042022 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n33506:SubClassOf(obo:CL_4042022 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000127))\n33507:SubClassOf(obo:CL_4042022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001307))\n33509:# Class: obo:CL_4042023 (striatal pthlh-expressing interneuron)\n33511:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30134177\") Annotation(oboInOwl:hasDbXref \"PMID:37292997\") obo:IAO_0000115 obo:CL_4042023 \"A GABAergic interneuron expressing PTHLH and PVALB that has its soma in a striatum. This GABAergic interneuron type presents a spatial expression gradient of PVALB in the mouse striatum.\")\n33512:AnnotationAssertion(terms:contributor obo:CL_4042023 <https://orcid.org/0000-0002-0098-8958>)\n33513:AnnotationAssertion(terms:date obo:CL_4042023 \"2024-09-17T10:20:15Z\"^^xsd:dateTime)\n33514:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") oboInOwl:hasRelatedSynonym obo:CL_4042023 \"PTHLH/PVALB cell\")\n33515:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") oboInOwl:hasRelatedSynonym obo:CL_4042023 \"PTHLH +/PVALB+ interneuron\")\n33516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") rdfs:comment obo:CL_4042023 \"According to spatial transcriptomic data in the human striatum, pthlh-expressing interneurons are one of the most abundant population of interneurons in the striatum (Leonardo D. Garma, et al., 2024).\")\n33517:AnnotationAssertion(rdfs:label obo:CL_4042023 \"striatal pthlh-expressing interneuron\"@en)\n33518:SubClassOf(obo:CL_4042023 obo:CL_0011005)\n33519:SubClassOf(obo:CL_4042023 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33520:SubClassOf(obo:CL_4042023 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013433))\n33521:SubClassOf(obo:CL_4042023 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n33523:# Class: obo:CL_4042024 (striatal PTHLH MOXD1 expressing interneuron)\n33525:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30134177\") obo:IAO_0000115 obo:CL_4042024 \"A pthlh-expressing interneuron that expresses MOXD1 and has its soma in a striatum.\")\n33526:AnnotationAssertion(terms:contributor obo:CL_4042024 <https://orcid.org/0000-0002-0098-8958>)\n33527:AnnotationAssertion(terms:date obo:CL_4042024 \"2024-09-17T10:26:57Z\"^^xsd:dateTime)\n33528:AnnotationAssertion(rdfs:label obo:CL_4042024 \"striatal PTHLH MOXD1 expressing interneuron\"@en)\n33529:SubClassOf(obo:CL_4042024 obo:CL_4042023)\n33530:SubClassOf(obo:CL_4042024 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000010529))\n33532:# Class: obo:CL_4042025 (substantia nigra dopaminergic neuron)\n33534:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32826893\") Annotation(oboInOwl:hasDbXref \"PMID:35308118\") obo:IAO_0000115 obo:CL_4042025 \"A midbrain dopaminergic neuron that has its soma located in a substantia nigra. This dopaminergic neuron type is highly metabolically active and it is involved in the regulation of movement, cognition, motivation and reward. Neurodegeneration of this dopaminergic neuronal type causes loss in fine motor control in Parkinson's Disease.\")\n33535:AnnotationAssertion(terms:contributor obo:CL_4042025 <https://orcid.org/0000-0002-0098-8958>)\n33536:AnnotationAssertion(terms:date obo:CL_4042025 \"2024-09-16T13:09:29Z\"^^xsd:dateTime)\n33537:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35308118\") oboInOwl:hasNarrowSynonym obo:CL_4042025 \"SNpc dopaminergic neuron\")\n33538:AnnotationAssertion(rdfs:label obo:CL_4042025 \"substantia nigra dopaminergic neuron\"@en)\n33539:SubClassOf(obo:CL_4042025 obo:CL_0002614)\n33540:SubClassOf(obo:CL_4042025 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n33542:# Class: obo:CL_4042026 (GABAergic interneuron of the anterior substantia nigra pars reticulata)\n33544:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") obo:IAO_0000115 obo:CL_4042026 \"A GABAergic interneuron that has its soma in the anterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterized by the expression of Six3 and Foxp1 and it develops from Nkx6-2 expressing neuronal progenitors in the ventrolateral midbrain-diencephalon region.\")\n33545:AnnotationAssertion(terms:contributor obo:CL_4042026 <https://orcid.org/0000-0002-0098-8958>)\n33546:AnnotationAssertion(terms:date obo:CL_4042026 \"2024-09-23T13:56:01Z\"^^xsd:dateTime)\n33547:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042026 \"aSNpr\")\n33548:AnnotationAssertion(rdfs:label obo:CL_4042026 \"GABAergic interneuron of the anterior substantia nigra pars reticulata\"@en)\n33549:SubClassOf(obo:CL_4042026 obo:CL_0002614)\n33550:SubClassOf(obo:CL_4042026 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007643))\n33551:SubClassOf(obo:CL_4042026 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013047))\n33552:SubClassOf(obo:CL_4042026 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000014898))\n33554:# Class: obo:CL_4042027 (GABAergic interneuron of the posterior substantia nigra pars reticulata)\n33556:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") obo:IAO_0000115 obo:CL_4042027 \"A GABAergic interneuron that has its soma in the posterior section of the substantia nigra pars reticulata. This GABAergic interneuron is characterised by the expression of the transcription factors Pax5, Ctip2 and Pou6f2 and it develops from the ventrolateral r1 neuroepithelium expresing NKX61.\")\n33557:AnnotationAssertion(terms:contributor obo:CL_4042027 <https://orcid.org/0000-0002-0098-8958>)\n33558:AnnotationAssertion(terms:date obo:CL_4042027 \"2024-09-23T14:49:11Z\"^^xsd:dateTime)\n33559:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36148148\") oboInOwl:hasRelatedSynonym obo:CL_4042027 \"pSNpr\")\n33560:AnnotationAssertion(rdfs:label obo:CL_4042027 \"GABAergic interneuron of the posterior substantia nigra pars reticulata\"@en)\n33561:SubClassOf(obo:CL_4042027 obo:CL_0002614)\n33562:SubClassOf(obo:CL_4042027 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001903))\n33564:# Class: obo:CL_4042028 (immature neuron)\n33566:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31096632\") Annotation(oboInOwl:hasDbXref \"PMID:32116519\") Annotation(oboInOwl:hasDbXref \"PMID:37833544\") obo:IAO_0000115 obo:CL_4042028 \"A neuron in the central nervous system that is not committed to a differentiated fate, has not been newly derived from neurogenesis, and does not integrate into any circuit.\")\n33567:AnnotationAssertion(terms:contributor obo:CL_4042028 <https://orcid.org/0000-0002-0098-8958>)\n33568:AnnotationAssertion(terms:date obo:CL_4042028 \"2024-10-10T09:14:45Z\"^^xsd:dateTime)\n33569:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32116519\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042028 \"IN\")\n33570:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32116519\") rdfs:comment obo:CL_4042028 \"It is hypothesised that immature neurons can be utilised as a neurogenic reserve and that they can be involved in circuit plasticity.\")\n33571:AnnotationAssertion(rdfs:label obo:CL_4042028 \"immature neuron\"@en)\n33572:SubClassOf(obo:CL_4042028 obo:CL_2000029)\n33574:# Class: obo:CL_4042029 (cortical immature neuron)\n33576:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37833544\") obo:IAO_0000115 obo:CL_4042029 \"An immature neuron of a cerebral cortex. This neuron develops prenatally and remains in an immature state throughout the lifespan of the organism.\")\n33577:AnnotationAssertion(terms:contributor obo:CL_4042029 <https://orcid.org/0000-0002-0098-8958>)\n33578:AnnotationAssertion(terms:date obo:CL_4042029 \"2024-10-10T09:14:54Z\"^^xsd:dateTime)\n33579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37833544\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042029 \"cIN\")\n33580:AnnotationAssertion(rdfs:label obo:CL_4042029 \"cortical immature neuron\"@en)\n33581:SubClassOf(obo:CL_4042029 obo:CL_4042028)\n33582:SubClassOf(obo:CL_4042029 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000956))\n33584:# Class: obo:CL_4042030 (candelabrum cell)\n33586:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") obo:IAO_0000115 obo:CL_4042030 \"A GABAergic interneuron located in the Purkinje layer of the cerebellar cortex. This GABAergic interneuron type has a distinct morphology, it presents a small cell soma near the Purkinje cell layer (PCL), dendrites that extend to the surface of the molecular layer, and beaded axons that make local synapses contacts within the molecular layer. A candelabrum cell is excited by mossy fibers and granule cells but inhibited by Purkinje cells, and it inhibits molecular layer interneurons, which leads to the disinhibition of Purkinje cells.\")\n33587:AnnotationAssertion(terms:contributor obo:CL_4042030 <https://orcid.org/0000-0002-0098-8958>)\n33588:AnnotationAssertion(terms:date obo:CL_4042030 \"2024-10-15T11:06:31Z\"^^xsd:dateTime)\n33589:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") oboInOwl:hasExactSynonym obo:CL_4042030 \"candelabrum interneuron\")\n33590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042030 \"CC\")\n33591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35578131\") rdfs:comment obo:CL_4042030 \"Candelabrum cells are the most abundant interneurons in the Purkinje cell layer and are present in all cerebellar lobules.\")\n33592:AnnotationAssertion(rdfs:label obo:CL_4042030 \"candelabrum cell\"@en)\n33593:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_4042030 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n33594:SubClassOf(obo:CL_4042030 obo:CL_0000099)\n33595:SubClassOf(obo:CL_4042030 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n33596:SubClassOf(obo:CL_4042030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n33598:# Class: obo:CL_4042031 (immune oligodendroglia)\n33600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasDbXref \"PMID:35662200\") obo:IAO_0000115 obo:CL_4042031 \"An oligodendrocyte of the central nervous system that exhibits immune properties such as self-presentation and non-self antigen presentation to T cells, phagocytosis of debris, and cytokine and chemokine production. Immune oligodendroglia is immunoreactive during inflammation, neurodegenerative disorders, chronic stress and major depressive disorder.\")\n33601:AnnotationAssertion(terms:contributor obo:CL_4042031 <https://orcid.org/0000-0002-0098-8958>)\n33602:AnnotationAssertion(terms:date obo:CL_4042031 \"2024-10-11T12:51:17Z\"^^xsd:dateTime)\n33603:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35615276\") oboInOwl:hasExactSynonym obo:CL_4042031 \"immune oligodendrocyte\")\n33604:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"Im-OL\")\n33605:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"ImOL\")\n33606:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"ImOLG\")\n33607:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30747918\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042031 \"imOLG\")\n33608:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasDbXref \"PMID:37057892\") rdfs:comment obo:CL_4042031 \"During inflammation, immuno oligodendroglia express MHC II to interact with immune cells in mouse models (Harrington et al., 2023; Madeira et al., 2022). In a mouse model of major depressive disorder and chronic stress, immuno oligodendroglia were associated with prefrontal cortex hypomyelination (Kokkosis et al., 2022).\")\n33609:AnnotationAssertion(rdfs:label obo:CL_4042031 \"immune oligodendroglia\"@en)\n33610:SubClassOf(obo:CL_4042031 obo:CL_0000128)\n33611:SubClassOf(obo:CL_4042031 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002453))\n33612:SubClassOf(obo:CL_4042031 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002504))\n33614:# Class: obo:CL_4042032 (PAX6 GABAergic interneuron)\n33616:AnnotationAssertion(obo:IAO_0000028 obo:CL_4042032 \"Pax6 interneuron\")\n33617:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042032 \"A transcriptomically distinct GABAergic neuron, located in the cerebral cortex and derived from the CGE, that expresses the transcript PAX6.\")\n33618:AnnotationAssertion(terms:contributor obo:CL_4042032 <https://orcid.org/0000-0002-0098-8958>)\n33619:AnnotationAssertion(terms:date obo:CL_4042032 \"2024-10-11T13:25:51Z\"^^xsd:dateTime)\n33620:AnnotationAssertion(rdfs:label obo:CL_4042032 \"PAX6 GABAergic interneuron\"@en)\n33621:SubClassOf(obo:CL_4042032 obo:CL_0000099)\n33622:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n33623:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\n33624:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n33625:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000012318))\n33627:# Class: obo:CL_4042033 (pro-opiomelanocortin neuron)\n33629:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25870542\") Annotation(oboInOwl:hasDbXref \"PMID:28192062\") obo:IAO_0000115 obo:CL_4042033 \"A neuron of the central nervous system that expresses POMC and synthesizes the POMC precursor polypeptide. This neuron type is located in the arcuate nucleus of the hypothalamus and in the nucleus tractus solitarius of the brainstem. The pro-opiomelanocortin neuron is part of the central melanocortin system and it is involved in regulating energy homeostasis, metabolism, and appetite. This neuronal type responds to hormonal signals such as levels of leptin and insulin, and its activation results in the release of α-melanocyte-stimulating hormone (α-MSH), which acts on melanocortin receptors to suppress food intake and increase energy expenditure.\")\n33630:AnnotationAssertion(terms:contributor obo:CL_4042033 <https://orcid.org/0000-0002-0098-8958>)\n33631:AnnotationAssertion(terms:date obo:CL_4042033 \"2024-10-15T10:17:41Z\"^^xsd:dateTime)\n33632:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34002087\") oboInOwl:hasRelatedSynonym obo:CL_4042033 \"POMC neuron\")\n33633:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34002087\") oboInOwl:hasRelatedSynonym obo:CL_4042033 \"POMC-expressing neuron\")\n33634:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192062\") Annotation(oboInOwl:hasDbXref \"PMID:33633406\") rdfs:comment obo:CL_4042033 \"Pro-opiomelanocortin neurons have a diverse projection pattern. The neurons in the rostral arcuate nucleus project to autonomic areas, caudal arcuate POMC neurons project mainly to hypothalamic areas (Toda et al., 2017). Dysregulation of pro-opiomelanocortin neurons is associated with obesity and metabolic disorders (Quarta et al., 2020).\")\n33635:AnnotationAssertion(rdfs:label obo:CL_4042033 \"pro-opiomelanocortin neuron\"@en)\n33636:SubClassOf(obo:CL_4042033 obo:CL_0000165)\n33637:SubClassOf(obo:CL_4042033 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013015))\n33639:# Class: obo:CL_4042034 (CGRP-expressing neuron)\n33641:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") obo:IAO_0000115 obo:CL_4042034 \"An interneuron neuron characterized by the expression of calcitonin gene-related peptide (CGRP), a 37-amino acid neuropeptide. This neuron type is involved in nociception and pain modulation by facilitating the transmission of nociceptive signals from peripheral sensory nerve endings to central nervous system structures. This neuron type is found in the dorsal root ganglia (DRG) and trigeminal ganglion, and the spinal cord dorsal horn.\")\n33642:AnnotationAssertion(terms:contributor obo:CL_4042034 <https://orcid.org/0000-0002-0098-8958>)\n33643:AnnotationAssertion(terms:date obo:CL_4042034 \"2024-10-30T15:35:08Z\"^^xsd:dateTime)\n33644:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasExactSynonym obo:CL_4042034 \"Calcitonin gene-related peptide neuron\")\n33645:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasRelatedSynonym obo:CL_4042034 \"CGRP-expressing interneuron\")\n33646:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34061020\") oboInOwl:hasRelatedSynonym obo:CL_4042034 \"CGRP-positive neuron\")\n33647:AnnotationAssertion(rdfs:label obo:CL_4042034 \"CGRP-expressing neuron\"@en)\n33648:SubClassOf(obo:CL_4042034 obo:CL_0000526)\n33649:SubClassOf(obo:CL_4042034 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n33651:# Class: obo:CL_4042035 (molecular layer interneuron)\n33653:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30742002\") Annotation(oboInOwl:hasDbXref \"PMID:33075461\") Annotation(oboInOwl:hasDbXref \"PMID:34616064\") Annotation(oboInOwl:hasDbXref \"PMID:38692278\") obo:IAO_0000115 obo:CL_4042035 \"A type of cerebellar inhibitory GABAergic interneuron that is located in the molecular layer of the cerebellum. This cell type inhibits Purkinje cells and other molecular layer interneurons. This interneuron plays a crucial role in regulating cerebellar output through feedforward inhibition and is characterized by its fast-spiking properties.\")\n33654:AnnotationAssertion(terms:contributor obo:CL_4042035 <https://orcid.org/0000-0002-0098-8958>)\n33655:AnnotationAssertion(terms:date obo:CL_4042035 \"2024-10-31T15:55:31Z\"^^xsd:dateTime)\n33656:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33075461\") Annotation(oboInOwl:hasRelatedSynonym obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042035 \"MLI\")\n33657:AnnotationAssertion(rdfs:label obo:CL_4042035 \"molecular layer interneuron\"@en)\n33658:EquivalentClasses(obo:CL_4042035 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002974) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n33660:# Class: obo:CL_4042036 (melanin-concentrating hormone neuron)\n33662:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30284033\") Annotation(oboInOwl:hasDbXref \"PMID:38020069\") Annotation(oboInOwl:hasDbXref \"PMID:39035036\") obo:IAO_0000115 obo:CL_4042036 \"A neuron of the central nervous system with its soma primarily located in the lateral hypothalamic area and surrounding regions, including the zona incerta. This neuron type expresses melanin-concentrating hormone and is involved in regulating various physiological processes, including sleep, feeding behavior, and energy homeostasis.\")\n33663:AnnotationAssertion(terms:contributor obo:CL_4042036 <https://orcid.org/0000-0002-0098-8958>)\n33664:AnnotationAssertion(terms:date obo:CL_4042036 \"2024-10-31T16:03:26Z\"^^xsd:dateTime)\n33665:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30284033\") oboInOwl:hasRelatedSynonym obo:CL_4042036 \"MCH neuron\")\n33666:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38020069\") rdfs:comment obo:CL_4042036 \"Nearly all melanin-concentrating hormone neurons express the glutamate transporter VGlut2, however a small subset of them expresses the machinery for GABA release and neurotransmission.\")\n33667:AnnotationAssertion(rdfs:label obo:CL_4042036 \"melanin-concentrating hormone neuron\"@en)\n33668:SubClassOf(obo:CL_4042036 obo:CL_2000029)\n33670:# Class: obo:CL_4042037 (sst GABAergic neuron of the striatum)\n33672:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30131490\") Annotation(oboInOwl:hasDbXref \"PMID:30467465\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") obo:IAO_0000115 obo:CL_4042037 \"A interneuron of the striatum expressing gamma-aminobutyric acid and somatostatin. This interneuron has a fusiform soma with a diameter between 9 - 25 µm, it has a long axon up to the length of 1mm. This neuron type displays a low threshold Ca2+ spike (LTS), a high input resistance, and the expression of long-lasting plateau potentials following depolarization from rest.\")\n33673:AnnotationAssertion(terms:contributor obo:CL_4042037 <https://orcid.org/0000-0002-0098-8958>)\n33674:AnnotationAssertion(terms:date obo:CL_4042037 \"2024-11-27T18:33:46Z\"^^xsd:dateTime)\n33675:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30131490\") oboInOwl:hasBroadSynonym obo:CL_4042037 \"SOM cell\")\n33676:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4042037 \"striatal SST+ IN\")\n33677:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30467465\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") rdfs:comment obo:CL_4042037 \"Some striatal SST GABAergic neurons can co-release glutamate and generate excitation-inhibition responses in postsynaptic neurons. This interneuron type has the least dense dendritic branches in the striatum. In the dorsomedial striatum these neurons regulate the activity of striatal projection neurons.\")\n33678:AnnotationAssertion(rdfs:label obo:CL_4042037 \"sst GABAergic neuron of the striatum\"@en)\n33679:SubClassOf(obo:CL_4042037 obo:CL_0000540)\n33680:SubClassOf(obo:CL_4042037 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33681:SubClassOf(obo:CL_4042037 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n33682:SubClassOf(obo:CL_4042037 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015665))\n33684:# Class: obo:CL_4042038 (rostral primary motorneuron)\n33686:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35431796\") Annotation(oboInOwl:hasDbXref \"PMID:3746410\") obo:IAO_0000115 obo:CL_4042038 \"A type of primary motor neuron situated in the rostral region of the spinal cord. RoP neurons extend their axons to innervate the ventral trunk musculature.\")\n33687:AnnotationAssertion(terms:contributor obo:CL_4042038 <https://orcid.org/0000-0002-0098-8958>)\n33688:AnnotationAssertion(terms:date obo:CL_4042038 \"2024-11-13T13:42:01Z\"^^xsd:dateTime)\n33689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3746410\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042038 \"RoP\")\n33690:AnnotationAssertion(rdfs:label obo:CL_4042038 \"rostral primary motorneuron\"@en)\n33691:SubClassOf(obo:CL_4042038 obo:CL_0000533)\n33693:# Class: obo:CL_4042039 (caudal ganglionic eminence derived neuron)\n33695:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12593982\") Annotation(oboInOwl:hasDbXref \"PMID:12637172\") Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK98190/\") obo:IAO_0000115 obo:CL_4042039 \"A neuron of the central nervous system that develops from a caudal ganglionic eminence.\")\n33696:AnnotationAssertion(terms:contributor obo:CL_4042039 <https://orcid.org/0000-0002-0098-8958>)\n33697:AnnotationAssertion(terms:date obo:CL_4042039 \"2024-11-14T11:27:25Z\"^^xsd:dateTime)\n33698:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12593982\") Annotation(oboInOwl:hasDbXref \"PMID:12637172\") Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK98190/\") rdfs:comment obo:CL_4042039 \"Neurons derived from the caudal ganglionic eminence consist mostly of neurons populating the cortical layers of the brain and some subcortical areas such as the globus pallidus, the striatus and the hippocampus. Amongst neurons derived from the caudal ganglionic eminence there are cortical GABAergic neurons such as Pax6, Lamp5, VIP, sncg, GABAergic; in the hippocampus, mossy fibers, pyramidal neurons, granule neurons and interneurons; in the striatum and globus pallidus, medium spiny projection neurons.\")\n33699:AnnotationAssertion(rdfs:label obo:CL_4042039 \"caudal ganglionic eminence derived neuron\"@en)\n33700:SubClassOf(obo:CL_4042039 obo:CL_2000029)\n33701:SubClassOf(obo:CL_4042039 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\n33703:# Class: obo:CL_4042040 (glutamatergic neuron of the basal ganglia)\n33705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.jocn.2021.05.056\") Annotation(oboInOwl:hasDbXref \"PMID:11307040\") Annotation(oboInOwl:hasDbXref \"PMID:16276355\") obo:IAO_0000115 obo:CL_4042040 \"A glutametergic neuron with its soma located in a basal ganglia. This neuron type is involved in motor control, decision making and learning.\")\n33706:AnnotationAssertion(terms:contributor obo:CL_4042040 <https://orcid.org/0000-0002-0098-8958>)\n33707:AnnotationAssertion(terms:date obo:CL_4042040 \"2024-11-18T13:37:58Z\"^^xsd:dateTime)\n33708:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22498715\") Annotation(oboInOwl:hasDbXref \"PMID:30498197\") Annotation(oboInOwl:hasDbXref \"PMID:33785138\") rdfs:comment obo:CL_4042040 \"The glutametergic neurons in the basal ganglia are part of a series of different circuits such as the corticolstriatal circuit, which is involved in regulating voluntary movements. The subthalamic nucleus circuit, which is involved in modulating the output of the basal ganglia, particularly in controlling movement initiation and inhibition. The thalamocortical loop, which is involved in refining motor movements and integrating sensory information with motor commanding.\")\n33709:AnnotationAssertion(rdfs:label obo:CL_4042040 \"glutamatergic neuron of the basal ganglia\"@en)\n33710:SubClassOf(obo:CL_4042040 obo:CL_0000540)\n33711:SubClassOf(obo:CL_4042040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002420))\n33712:SubClassOf(obo:CL_4042040 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535))\n33714:# Class: obo:CL_4042041 (middle primary motoneuron)\n33716:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35431796\") Annotation(oboInOwl:hasDbXref \"PMID:3746410\") obo:IAO_0000115 obo:CL_4042041 \"A type of primary motor neuron located in the middle region of the spinal cord. This primary motor neuron type is characterized by their distinct axonal pathways that innervate the middle trunk muscles.\")\n33717:AnnotationAssertion(terms:contributor obo:CL_4042041 <https://orcid.org/0000-0002-0098-8958>)\n33718:AnnotationAssertion(terms:date obo:CL_4042041 \"2024-11-13T13:39:28Z\"^^xsd:dateTime)\n33719:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4042041 \"ZFA:0005179\")\n33720:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3746410\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4042041 \"MiP\")\n33721:AnnotationAssertion(rdfs:label obo:CL_4042041 \"middle primary motoneuron\"@en)\n33722:SubClassOf(obo:CL_4042041 obo:CL_0000533)\n33724:# Class: obo:CL_4047006 (fetal artery endothelial cell)\n33726:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047006 \"An endothelial cell that lines an artery in the fetal circulatory system.\")\n33727:AnnotationAssertion(terms:contributor obo:CL_4047006 <https://orcid.org/0009-0005-7919-4905>)\n33728:AnnotationAssertion(terms:date obo:CL_4047006 \"2024-08-16T13:52:25Z\"^^xsd:dateTime)\n33729:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"endothelial cell of fetal artery\")\n33730:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"fetal arterial EC\")\n33731:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34497389\") oboInOwl:hasExactSynonym obo:CL_4047006 \"fetal artery EC\")\n33732:AnnotationAssertion(rdfs:label obo:CL_4047006 \"fetal artery endothelial cell\")\n33733:SubClassOf(obo:CL_4047006 obo:CL_1000413)\n33735:# Class: obo:CL_4047007 (immature pericyte)\n33737:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21839917\") Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasDbXref \"PMID:32466671\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") Annotation(oboInOwl:hasDbXref \"PMID:36685855\") obo:IAO_0000115 obo:CL_4047007 \"A pericyte that is in an early stage of development, found in newly forming or remodeling blood vessels. An immature pericyte is characterized by it's mesenchymal stem cell-like properties and high proliferative capacity, which allows it to differentiate into various types of pericytes and contribute to the structural and functional maturation of the vasculature. Immature pericytes are stellate in new vessels and elongated with less protrusions in remodeling vessels.\")\n33738:AnnotationAssertion(terms:contributor obo:CL_4047007 <https://orcid.org/0009-0005-7919-4905>)\n33739:AnnotationAssertion(terms:date obo:CL_4047007 \"2024-08-19T11:32:32Z\"^^xsd:dateTime)\n33740:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047007 \"imPCs\")\n33741:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28564607\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047007 \"immature PCs\")\n33742:AnnotationAssertion(rdfs:label obo:CL_4047007 \"immature pericyte\")\n33743:SubClassOf(obo:CL_4047007 obo:CL_0000669)\n33745:# Class: obo:CL_4047011 (fetal vein endothelial cell)\n33747:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") obo:IAO_0000115 obo:CL_4047011 \"An endothelial cell that lines the veins in the fetal circulatory system.\")\n33748:AnnotationAssertion(terms:contributor obo:CL_4047011 <https://orcid.org/0009-0005-7919-4905>)\n33749:AnnotationAssertion(terms:date obo:CL_4047011 \"2024-09-05T15:45:32Z\"^^xsd:dateTime)\n33750:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") oboInOwl:hasExactSynonym obo:CL_4047011 \"fetal venous endothelial cell\")\n33751:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047011 \"fetal vein EC\")\n33752:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.04.07.438755\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047011 \"fetal venous EC\")\n33753:AnnotationAssertion(rdfs:label obo:CL_4047011 \"fetal vein endothelial cell\"@en)\n33754:SubClassOf(obo:CL_4047011 obo:CL_0002543)\n33756:# Class: obo:CL_4047012 (angiogenic pericyte)\n33758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24853910\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047012 \"A specialized pericyte that actively participates in the formation of new blood vessels during angiogenesis by undergoing phenotypic changes, increasing proliferation, and interacting closely with endothelial cells.\")\n33759:AnnotationAssertion(terms:contributor obo:CL_4047012 <https://orcid.org/0009-0005-7919-4905>)\n33760:AnnotationAssertion(terms:date obo:CL_4047012 \"2024-09-06T08:41:39Z\"^^xsd:dateTime)\n33761:AnnotationAssertion(rdfs:label obo:CL_4047012 \"angiogenic pericyte\"@en)\n33762:SubClassOf(obo:CL_4047012 obo:CL_0000669)\n33764:# Class: obo:CL_4047017 (transit amplifying cell of gut)\n33766:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") Annotation(oboInOwl:hasDbXref \"PMID:33195268\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047017 \"A transit amplifying cell of the gut epithelium, located in the wall of the intestinal crypt, just above intestinal stem cells from which they derive. These are rapidly dividing cells, capable of multiple rounds of division before differentiating into the various cell types of the gut epithelium (enterocyte, goblet, eneterodendocrine, paneth cells).\")\n33767:AnnotationAssertion(terms:contributor obo:CL_4047017 <https://orcid.org/0009-0005-7919-4905>)\n33768:AnnotationAssertion(terms:date obo:CL_4047017 \"2024-09-24T10:48:47Z\"^^xsd:dateTime)\n33769:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24813615\") oboInOwl:hasBroadSynonym obo:CL_4047017 \"transit-amplifying cell\")\n33770:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") oboInOwl:hasRelatedSynonym obo:CL_4047017 \"TA cell\")\n33771:AnnotationAssertion(rdfs:label obo:CL_4047017 \"transit amplifying cell of gut\"@en)\n33772:EquivalentClasses(obo:CL_4047017 ObjectIntersectionOf(obo:CL_0009010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013740)))\n33773:SubClassOf(obo:CL_4047017 obo:CL_0000066)\n33774:SubClassOf(obo:CL_4047017 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_0002250))\n33776:# Class: obo:CL_4047018 (early colonocyte)\n33778:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28049136\") Annotation(oboInOwl:hasDbXref \"PMID:36060223\") obo:IAO_0000115 obo:CL_4047018 \"An enterocyte that is part of the colon, in the early stages of differentiation, located in the intestinal crypt-villus axis.\")\n33779:AnnotationAssertion(terms:contributor obo:CL_4047018 <https://orcid.org/0009-0005-7919-4905>)\n33780:AnnotationAssertion(terms:date obo:CL_4047018 \"2024-09-24T11:50:13Z\"^^xsd:dateTime)\n33781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2021.01.13.426602\") oboInOwl:hasExactSynonym obo:CL_4047018 \"early enterocyte of colon\")\n33782:AnnotationAssertion(rdfs:label obo:CL_4047018 \"early colonocyte\"@en)\n33783:EquivalentClasses(obo:CL_4047018 ObjectIntersectionOf(obo:CL_4047019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000397)))\n33785:# Class: obo:CL_4047019 (early enterocyte)\n33787:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20683682\") Annotation(oboInOwl:hasDbXref \"PMID:35235783\") obo:IAO_0000115 obo:CL_4047019 \"An enterocyte in the early stages of development, located above the transit-amplifying cell zone in the intestinal crypt-villus axis.\")\n33788:AnnotationAssertion(terms:contributor obo:CL_4047019 <https://orcid.org/0009-0005-7919-4905>)\n33789:AnnotationAssertion(terms:date obo:CL_4047019 \"2024-09-24T12:11:09Z\"^^xsd:dateTime)\n33790:AnnotationAssertion(rdfs:label obo:CL_4047019 \"early enterocyte\"@en)\n33791:EquivalentClasses(obo:CL_4047019 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013740)))\n33793:# Class: obo:CL_4047023 (intestinal lamina propria fibroblast)\n33795:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\n33796:AnnotationAssertion(terms:contributor obo:CL_4047023 <https://orcid.org/0009-0005-7919-4905>)\n33797:AnnotationAssertion(terms:date obo:CL_4047023 \"2024-09-24T15:45:18Z\"^^xsd:dateTime)\n33798:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") oboInOwl:hasRelatedSynonym obo:CL_4047023 \"S1 fibroblast\")\n33799:AnnotationAssertion(rdfs:label obo:CL_4047023 \"intestinal lamina propria fibroblast\"@en)\n33800:EquivalentClasses(obo:CL_4047023 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004780) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278)))\n33802:# Class: obo:CL_4047025 (type G cell of stomach)\n33804:AnnotationAssertion(terms:contributor obo:CL_4047025 <https://orcid.org/0009-0005-7919-4905>)\n33805:AnnotationAssertion(terms:date obo:CL_4047025 \"2024-10-24T10:43:22Z\"^^xsd:dateTime)\n33806:AnnotationAssertion(rdfs:label obo:CL_4047025 \"type G cell of stomach\"@en)\n33807:EquivalentClasses(obo:CL_4047025 ObjectIntersectionOf(obo:CL_0000508 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001276)))\n33809:# Class: obo:CL_4047029 (post-arteriole capillary cell)\n33811:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17893694\") Annotation(oboInOwl:hasDbXref \"PMID:35406678\") obo:IAO_0000115 obo:CL_4047029 \"An endothelial cell forming the walls of capillaries immediately downstream from arterioles, facilitating the exchange of substances between blood and interstitial fluid. This cell is characterized by a small diameter and may be continuous, fenestrated, or sinusoidal, depending on their location and function. This cell plays a crucial role in tissue oxygenation, nutrient delivery, and maintaining homeostasis within the microvascular network.\")\n33812:AnnotationAssertion(terms:contributor obo:CL_4047029 <https://orcid.org/0009-0005-7919-4905>)\n33813:AnnotationAssertion(terms:date obo:CL_4047029 \"2024-11-07T12:50:06Z\"^^xsd:dateTime)\n33814:AnnotationAssertion(rdfs:label obo:CL_4047029 \"post-arteriole capillary cell\"@en)\n33815:SubClassOf(obo:CL_4047029 obo:CL_0002144)\n33817:# Class: obo:CL_4047030 (pre-venule capillary cell)\n33819:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41467-022-33324-7\") Annotation(oboInOwl:hasDbXref \"PMID:23620236\") obo:IAO_0000115 obo:CL_4047030 \"A specialized endothelial cell located in the transition zone between capillaries and small venules in the microvascular system. It exhibits characteristics of both capillary and venous cells, expressing markers from both types. This cell plays a role in regulating blood flow and substance exchange between blood and tissues.\")\n33820:AnnotationAssertion(terms:contributor obo:CL_4047030 <https://orcid.org/0009-0005-7919-4905>)\n33821:AnnotationAssertion(terms:date obo:CL_4047030 \"2024-11-07T13:22:16Z\"^^xsd:dateTime)\n33822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41467-022-33324-7\") oboInOwl:hasExactSynonym obo:CL_4047030 \"Cap-Venous endothelial cell\")\n33823:AnnotationAssertion(rdfs:label obo:CL_4047030 \"pre-venule capillary cell\"@en)\n33824:SubClassOf(obo:CL_4047030 obo:CL_0002144)\n33826:# Class: obo:CL_4047032 (secretory pericyte)\n33828:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2019.00282\") obo:IAO_0000115 obo:CL_4047032 \"A specialized pericyte located within the basement membrane of a blood capillary. This cell is characterized by its ability to produce and release a variety of bioactive molecules, collectively known as the pericyte secretome, including cytokines and regulators of angiogenesis.\")\n33829:AnnotationAssertion(terms:contributor obo:CL_4047032 <https://orcid.org/0009-0005-7919-4905>)\n33830:AnnotationAssertion(terms:date obo:CL_4047032 \"2024-11-07T15:36:16Z\"^^xsd:dateTime)\n33831:AnnotationAssertion(rdfs:label obo:CL_4047032 \"secretory pericyte\"@en)\n33832:SubClassOf(obo:CL_4047032 obo:CL_0000669)\n33833:SubClassOf(obo:CL_4047032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816))\n33834:SubClassOf(obo:CL_4047032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032940))\n33835:SubClassOf(obo:CL_4047032 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045765))\n33837:# Class: obo:CL_4047034 (smooth muscle cell of stomach)\n33839:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21443757\") Annotation(oboInOwl:hasDbXref \"PMID:33630273\") obo:IAO_0000115 obo:CL_4047034 \"A smooth muscle cell that is part of the muscularis externa of the stomach wall. It is characterized by its fusiform shape, involuntary control, and ability to generate slow, sustained contractions. This cell is organized in distinct layers and is essential for gastric motility and digestion.\")\n33840:AnnotationAssertion(terms:contributor obo:CL_4047034 <https://orcid.org/0009-0005-7919-4905>)\n33841:AnnotationAssertion(terms:date obo:CL_4047034 \"2024-12-05T11:10:18Z\"^^xsd:dateTime)\n33842:AnnotationAssertion(rdfs:label obo:CL_4047034 \"smooth muscle cell of stomach\"@en)\n33843:EquivalentClasses(obo:CL_4047034 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008856)))\n33845:# Class: obo:CL_4047035 (stomach smooth muscle outer longitudinal layer cell)\n33847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21443757\") Annotation(oboInOwl:hasDbXref \"PMID:33630273\") obo:IAO_0000115 obo:CL_4047035 \"A specialized smooth muscle cell located in the outermost layer of the muscularis externa of the stomach wall. This cell is arranged longitudinally along the stomach's axis and is responsible for the contractions that facilitate food movement toward the pylorus.\")\n33848:AnnotationAssertion(terms:contributor obo:CL_4047035 <https://orcid.org/0009-0005-7919-4905>)\n33849:AnnotationAssertion(terms:date obo:CL_4047035 \"2024-12-05T16:13:49Z\"^^xsd:dateTime)\n33850:AnnotationAssertion(rdfs:label obo:CL_4047035 \"stomach smooth muscle outer longitudinal layer cell\"@en)\n33851:SubClassOf(obo:CL_4047035 obo:CL_4047034)\n33853:# Class: obo:CL_4047036 (stomach smooth muscle circular layer cell)\n33855:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11146428\") Annotation(oboInOwl:hasDbXref \"PMID:32424507\") obo:IAO_0000115 obo:CL_4047036 \"A smooth muscle cell located in the middle layer of the muscularis externa of the stomach wall. This cell is arranged concentrically with the stomach's longitudinal axis, forming a continuous sheet of contractile tissue. It is fusiform in shape, containing actin and myosin filaments that enable contraction without striations. This cell contributes to the mechanical digestion and movement of food within the stomach through coordinated contractions, and plays a role in forming the pyloric sphincter in the pyloric region.\")\n33856:AnnotationAssertion(terms:contributor obo:CL_4047036 <https://orcid.org/0009-0005-7919-4905>)\n33857:AnnotationAssertion(terms:date obo:CL_4047036 \"2024-12-09T10:40:58Z\"^^xsd:dateTime)\n33858:AnnotationAssertion(rdfs:label obo:CL_4047036 \"stomach smooth muscle circular layer cell\"@en)\n33859:EquivalentClasses(obo:CL_4047036 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008857)))\n33861:# Class: obo:CL_4047037 (stomach smooth muscle inner oblique layer cell)\n33863:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29493959\") obo:IAO_0000115 obo:CL_4047037 \"A smooth muscle cell found in the innermost layer of the muscularis externa of the stomach wall. This cell forms a unique layer of smooth muscle fibers oriented obliquely to the stomach's longitudinal axis. It is responsible for aiding in the mixing and churning of gastric contents, contributing to mechanical digestion within the stomach.\")\n33864:AnnotationAssertion(terms:contributor obo:CL_4047037 <https://orcid.org/0009-0005-7919-4905>)\n33865:AnnotationAssertion(terms:date obo:CL_4047037 \"2024-12-09T10:53:19Z\"^^xsd:dateTime)\n33866:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047037 \"stomach smooth muscle oblique layer cell\")\n33867:AnnotationAssertion(rdfs:label obo:CL_4047037 \"stomach smooth muscle inner oblique layer cell\"@en)\n33868:EquivalentClasses(obo:CL_4047037 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008862)))\n33870:# Class: obo:CL_4047038 (dogiel type I neuron)\n33872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-020-0271-2\") Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-021-00561-y\") Annotation(oboInOwl:hasDbXref \"PMID:32152479\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4047038 \"A multipolar neuron in the myenteric plexus of the gastrointestinal tract, characterized by a small to medium-sized cell body and multiple short dendrites.  This neuron exhibits fast excitatory postsynaptic potentials and can be classified into stubby, spiny and hairy subtypes based on dendritic morphology. (Brehmer, 2021)\")\n33873:AnnotationAssertion(terms:contributor obo:CL_4047038 <https://orcid.org/0009-0005-7919-4905>)\n33874:AnnotationAssertion(terms:date obo:CL_4047038 \"2024-12-16T13:42:04Z\"^^xsd:dateTime)\n33875:AnnotationAssertion(rdfs:label obo:CL_4047038 \"dogiel type I neuron\")\n33876:SubClassOf(obo:CL_4047038 obo:CL_0000104)\n33877:SubClassOf(obo:CL_4047038 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439))\n33879:# Class: obo:CL_4047040 (smooth muscle circular layer cell)\n33881:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18221249\") Annotation(oboInOwl:hasDbXref \"PMID:27445346\") obo:IAO_0000115 obo:CL_4047040 \"A smooth muscle cell that is found in the inner muscular layer of hollow organs. It is characterized by its spiral/helical arrangement around organ lumens. This cell is crucial for peristaltic movements in organs.\")\n33882:AnnotationAssertion(terms:contributor obo:CL_4047040 <https://orcid.org/0009-0005-7919-4905>)\n33883:AnnotationAssertion(terms:date obo:CL_4047040 \"2025-01-06T15:40:21Z\"^^xsd:dateTime)\n33884:AnnotationAssertion(rdfs:label obo:CL_4047040 \"smooth muscle circular layer cell\")\n33885:SubClassOf(obo:CL_4047040 obo:CL_0000192)\n33886:SubClassOf(obo:CL_4047040 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012368))\n33888:# Class: obo:CL_4047042 (type 1 myenteric plexus glia)\n33890:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19906678\") Annotation(oboInOwl:hasDbXref \"PMID:21865647\") Annotation(oboInOwl:hasDbXref \"PMID:26964064\") Annotation(oboInOwl:hasDbXref \"PMID:28066889\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047042 \"An enteric glial cell located within the myenteric ganglia of the gastrointestinal tract. This cell has a small somata and has very short, irregularly branched processes that surround neuron cell bodies, giving it a protoplasmic-like appearance. It plays crucial roles in modulating myenteric neuron activity, regulating oxidative stress, and influencing neuroinflammation and neurogenesis.\")\n33891:AnnotationAssertion(terms:contributor obo:CL_4047042 <https://orcid.org/0009-0005-7919-4905>)\n33892:AnnotationAssertion(terms:date obo:CL_4047042 \"2025-02-10T16:49:55Z\"^^xsd:dateTime)\n33893:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047042 \"type 1 MP\")\n33894:AnnotationAssertion(rdfs:label obo:CL_4047042 \"type 1 myenteric plexus glia\")\n33895:SubClassOf(obo:CL_4047042 obo:CL_4040002)\n33896:SubClassOf(obo:CL_4047042 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002439))\n33898:# Class: obo:CL_4047043 (type 1 submucosal plexus glia)\n33900:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2023.1170309\") Annotation(oboInOwl:hasDbXref \"PMID:28487635\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047043 \"An enteric glial cell that is associated with neuron cell bodies within submucosal ganglia of the gastrointestinal tract. This cell is located in the submucosa, a layer of connective tissue beneath the intestinal mucosa. This cell plays a role in modulating secretomotor neuron activity and contributes to the regulation of digestive fluid secretion and absorption.\")\n33901:AnnotationAssertion(terms:contributor obo:CL_4047043 <https://orcid.org/0009-0005-7919-4905>)\n33902:AnnotationAssertion(terms:date obo:CL_4047043 \"2025-02-10T17:02:28Z\"^^xsd:dateTime)\n33903:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047043 \"type I SMP\")\n33904:AnnotationAssertion(rdfs:label obo:CL_4047043 \"type 1 submucosal plexus glia\")\n33905:SubClassOf(obo:CL_4047043 obo:CL_4040002)\n33906:SubClassOf(obo:CL_4047043 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009566))\n33908:# Class: obo:CL_4047044 (type 2 interganglionic glia)\n33910:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1002/glia.22876\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047044 \"An enteric glial cell that has an elongated, fibrous morphology with long processes that run parallel to nerve fibers connecting enteric myenteric ganglia. This cell is located in the interganglionic fiber tracts of the enteric nervous system.\")\n33911:AnnotationAssertion(terms:contributor obo:CL_4047044 <https://orcid.org/0009-0005-7919-4905>)\n33912:AnnotationAssertion(terms:date obo:CL_4047044 \"2025-02-11T12:28:37Z\"^^xsd:dateTime)\n33913:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35111752\") oboInOwl:hasExactSynonym obo:CL_4047044 \"type II enteric glia\")\n33914:AnnotationAssertion(rdfs:label obo:CL_4047044 \"type 2 interganglionic glia\")\n33915:SubClassOf(obo:CL_4047044 obo:CL_4040002)\n33916:SubClassOf(obo:CL_4047044 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000429))\n33918:# Class: obo:CL_4047045 (type 3 mucosal glia)\n33920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25161129\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:37153631\") Annotation(oboInOwl:hasDbXref \"PMID:38957473\") obo:IAO_0000115 obo:CL_4047045 \"An enteric glial cell located in the lamina propria of the intestinal mucosa. This cell plays important roles in maintaining gut barrier function, regulating intestinal homeostasis, and mediating interactions between the enteric nervous system and the immune system.\")\n33921:AnnotationAssertion(terms:contributor obo:CL_4047045 <https://orcid.org/0009-0005-7919-4905>)\n33922:AnnotationAssertion(terms:date obo:CL_4047045 \"2025-02-11T12:39:11Z\"^^xsd:dateTime)\n33923:AnnotationAssertion(rdfs:label obo:CL_4047045 \"type 3 mucosal glia\")\n33924:SubClassOf(obo:CL_4047045 obo:CL_4040002)\n33925:SubClassOf(obo:CL_4047045 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000030))\n33927:# Class: obo:CL_4047047 (type I enteric glial cell)\n33929:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.celrep.2023.112194\") Annotation(oboInOwl:hasDbXref \"PMID:29927320\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047047 \"An enteric glial cell located within the ganglia of the enteric nervous system. This cell is characterized by it’s small somata and short, irregularly branched processes that surround neuronal cell bodies in the myenteric and submucosal ganglia. This cell plays important roles in modulating neuronal activity and neurogenesis in the gastrointestinal tract.\")\n33930:AnnotationAssertion(terms:contributor obo:CL_4047047 <https://orcid.org/0009-0005-7919-4905>)\n33931:AnnotationAssertion(terms:date obo:CL_4047047 \"2025-02-11T13:35:14Z\"^^xsd:dateTime)\n33932:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") oboInOwl:hasExactSynonym obo:CL_4047047 \"intraganglionic glia\")\n33933:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047047 \"type 1 enteric glia\")\n33934:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35111752\") oboInOwl:hasExactSynonym obo:CL_4047047 \"type I enteric glia\")\n33935:AnnotationAssertion(rdfs:label obo:CL_4047047 \"type I enteric glial cell\")\n33936:SubClassOf(obo:CL_4047047 obo:CL_4040002)\n33937:SubClassOf(obo:CL_4047047 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001809))\n33939:# Class: obo:CL_4047048 (type 4 muscularis propria glia)\n33941:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:34401661\") obo:IAO_0000115 obo:CL_4047048 \"An enteric glial cell characterized by a small central soma that extends long, thin, bipolar projections. This cell is primarily located along small nerve fibers within the muscle layers of the gastrointestinal tract and is known for its unbranching processes that closely follow these nerve fibers in the muscularis.\")\n33942:AnnotationAssertion(terms:contributor obo:CL_4047048 <https://orcid.org/0009-0005-7919-4905>)\n33943:AnnotationAssertion(terms:date obo:CL_4047048 \"2025-02-18T11:14:25Z\"^^xsd:dateTime)\n33944:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34401661\") oboInOwl:hasRelatedSynonym obo:CL_4047048 \"intramuscular glia\")\n33945:AnnotationAssertion(rdfs:label obo:CL_4047048 \"type 4 muscularis propria glia\")\n33946:SubClassOf(obo:CL_4047048 obo:CL_4040002)\n33947:SubClassOf(obo:CL_4047048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006660))\n33949:# Class: obo:CL_4047051 (small intestine BEST4+ enterocyte)\n33951:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047051 \"An enterocyte of the human small intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These enterocytes have a disinctive transcriptomic profile and are scattered through the small intestine epithelium.\")\n33952:AnnotationAssertion(terms:contributor obo:CL_4047051 <https://orcid.org/0009-0005-7919-4905>)\n33953:AnnotationAssertion(terms:date obo:CL_4047051 \"2024-07-25T13:05:50Z\"^^xsd:dateTime)\n33954:AnnotationAssertion(rdfs:label obo:CL_4047051 \"small intestine BEST4+ enterocyte\")\n33955:EquivalentClasses(obo:CL_4047051 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001902) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n33956:SubClassOf(obo:CL_4047051 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001902))\n33958:# Class: obo:CL_4047052 (BEST4+ colonocyte)\n33960:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047052 \"An enterocyte of the human colon expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These cells have a distinct transcriptomic profile compared to other enterocytes and are scattered through the colon epithelium.\")\n33961:AnnotationAssertion(terms:contributor obo:CL_4047052 <https://orcid.org/0009-0005-7919-4905>)\n33962:AnnotationAssertion(terms:date obo:CL_4047052 \"2024-07-25T13:21:19Z\"^^xsd:dateTime)\n33963:AnnotationAssertion(rdfs:label obo:CL_4047052 \"BEST4+ colonocyte\")\n33964:EquivalentClasses(obo:CL_4047052 ObjectIntersectionOf(obo:CL_1000347 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n33966:# Class: obo:CL_4047053 (TREM2-positive macrophage)\n33968:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33033253\") Annotation(oboInOwl:hasDbXref \"PMID:33628208\") Annotation(oboInOwl:hasDbXref \"PMID:35746551\") Annotation(oboInOwl:hasDbXref \"PMID:36750615\") Annotation(oboInOwl:hasDbXref \"PMID:39369473\") obo:IAO_0000115 obo:CL_4047053 \"A macrophage characterized by high expression of Triggering Receptor Expressed on Myeloid cells 2 (TREM2), found in various tissues including the liver, adipose tissue, bone, gut (Colonna, 2023), and tumor microenvironments, where it is associated with immunosuppressive and anti-inflammatory activity (Colmenares, 2024; Khantakova, 2022). This cell exhibits a distinct gene expression profile in the tumor microenvironment, including overexpression of complement system genes (C1QA, C1QB, C1QC, C3), and SPP1 in both mice and humans (Xiong, 2020; Khantakova, 2022). It is involved in phagocytosis, tissue repair, and modulation of immune responses (Coeho, 2021).\")\n33969:AnnotationAssertion(terms:contributor obo:CL_4047053 <https://orcid.org/0009-0005-7919-4905>)\n33970:AnnotationAssertion(terms:date obo:CL_4047053 \"2025-03-17T17:20:08Z\"^^xsd:dateTime)\n33971:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39369473\") oboInOwl:hasNarrowSynonym obo:CL_4047053 \"TREM-2 + resident macrophage\")\n33972:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35746551\") oboInOwl:hasNarrowSynonym obo:CL_4047053 \"TREM2+ macrophage\")\n33973:AnnotationAssertion(rdfs:label obo:CL_4047053 \"TREM2-positive macrophage\")\n33974:EquivalentClasses(obo:CL_4047053 ObjectIntersectionOf(obo:CL_0000235 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000016626)))\n33976:# Class: obo:CL_4047054 (migratory dendritic cell)\n33978:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28845904\") Annotation(oboInOwl:hasDbXref \"PMID:33681216\") Annotation(oboInOwl:hasDbXref \"PMID:34302064\") obo:IAO_0000115 obo:CL_4047054 \"A dendritic cell capable of capturing antigens in peripheral tissues and migrating through blood or lymphatic vessels to secondary lymphoid organs, where it presents processed antigens to T cells. It expresses MHC class II molecules and lacks lineage markers associated with other leukocyte populations, distinguishing it as a member of the dendritic cell lineage. This cell plays a pivotal role in initiating and regulating adaptive immune responses by linking peripheral antigen capture with T cell activation in lymphoid tissues.\")\n33979:AnnotationAssertion(terms:contributor obo:CL_4047054 <https://orcid.org/0009-0005-7919-4905>)\n33980:AnnotationAssertion(terms:date obo:CL_4047054 \"2025-03-17T17:37:37Z\"^^xsd:dateTime)\n33981:AnnotationAssertion(rdfs:label obo:CL_4047054 \"migratory dendritic cell\")\n33982:SubClassOf(obo:CL_4047054 obo:CL_0000451)\n33983:SubClassOf(obo:CL_4047054 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002407))\n33984:SubClassOf(obo:CL_4047054 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002468))\n33986:# Class: obo:CL_4047056 (large mucus secreting cholangiocyte)\n33988:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15579435\") Annotation(oboInOwl:hasDbXref \"PMID:26273695\") Annotation(oboInOwl:hasDbXref \"PMID:28261592\") Annotation(oboInOwl:hasDbXref \"doi:10.1002/hep.25595\") Annotation(oboInOwl:hasDbXref \"doi:10.1152/ajpgi.00227.2012\") obo:IAO_0000115 obo:CL_4047056 \"A columnar, mucin-producing cholangiocyte that lines large bile ducts, including the hilar bile duct, right and left hepatic bile ducts, and large intrahepatic bile ducts. This cell expresses phosphorylated STAT3 and TFF-3 in humans and mice.\")\n33989:AnnotationAssertion(terms:contributor obo:CL_4047056 <https://orcid.org/0009-0005-7919-4905>)\n33990:AnnotationAssertion(terms:date obo:CL_4047056 \"2025-03-20T14:21:41Z\"^^xsd:dateTime)\n33991:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1152/ajpgi.00227.2012\") oboInOwl:hasNarrowSynonym obo:CL_4047056 \"mucin-secreting cholangiocyte\")\n33992:AnnotationAssertion(rdfs:label obo:CL_4047056 \"large mucus secreting cholangiocyte\")\n33993:SubClassOf(obo:CL_4047056 obo:CL_1000488)\n33994:SubClassOf(obo:CL_4047056 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070254))\n33996:# Class: obo:CL_4047060 (BAG3-positive monocyte)\n33998:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20018251\") Annotation(oboInOwl:hasDbXref \"doi:10.21203/rs.3.rs-3229780/v1\") obo:IAO_0000115 obo:CL_4047060 \"A circulating mononuclear phagocyte characterized by the expression of BCL-2-associated athanogene 3 (BAG3) protein, a co-chaperone involved in protein quality control and anti-apoptotic processes. (Fontanella, 2009). It undergoes cellular stress during the differentiation into M2 macrophages and is linked to poor survival rates in multiple cancer types. (Park, 2023)\")\n33999:AnnotationAssertion(terms:contributor obo:CL_4047060 <https://orcid.org/0009-0005-7919-4905>)\n34000:AnnotationAssertion(terms:date obo:CL_4047060 \"2025-05-06T14:41:24Z\"^^xsd:dateTime)\n34001:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.21203/rs.3.rs-3229780/v1\") oboInOwl:hasExactSynonym obo:CL_4047060 \"BAG3+ monocyte\")\n34002:AnnotationAssertion(rdfs:label obo:CL_4047060 \"BAG3-positive monocyte\")\n34003:EquivalentClasses(obo:CL_4047060 ObjectIntersectionOf(obo:CL_0000576 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000004621)))\n34005:# Class: obo:CL_4047101 (liver-resident natural killer cell)\n34007:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26330348\") Annotation(oboInOwl:hasDbXref \"PMID:26639736\") Annotation(oboInOwl:hasDbXref \"PMID:27798170\") Annotation(oboInOwl:hasDbXref \"PMID:31114585\") Annotation(oboInOwl:hasDbXref \"PMID:32351704\") Annotation(oboInOwl:hasDbXref \"PMID:34230995\") Annotation(oboInOwl:hasDbXref \"PMID:35865550\") obo:IAO_0000115 obo:CL_4047101 \"A natural killer cell resident to the liver, located in the hepatic sinusoids. In humans this cell type is distinguished from circulating natural killer cells by CD49a or CD69 gene expression. Liver-resident natural killer cells have also been shown to express CCR5, EOMES, KLRB1, GZMK, and CXCR6 in humans.\")\n34008:AnnotationAssertion(terms:contributor obo:CL_4047101 <https://orcid.org/0009-0005-7919-4905>)\n34009:AnnotationAssertion(terms:contributor obo:CL_4047101 \"https://orcid.org/0000-0001-8134-3037\")\n34010:AnnotationAssertion(terms:date obo:CL_4047101 \"2024-07-29T13:43:11Z\"^^xsd:dateTime)\n34011:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31114585\") oboInOwl:hasExactSynonym obo:CL_4047101 \"he-NK\")\n34012:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fimmu.2019.00946\") oboInOwl:hasExactSynonym obo:CL_4047101 \"hepatic NK\")\n34013:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fimmu.2019.00946\") oboInOwl:hasExactSynonym obo:CL_4047101 \"hepatic natural killer cells\")\n34014:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33828559\") oboInOwl:hasExactSynonym obo:CL_4047101 \"intrahepatic NK\")\n34015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26639736\") oboInOwl:hasExactSynonym obo:CL_4047101 \"liver NK cell\")\n34016:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26330348\") oboInOwl:hasExactSynonym obo:CL_4047101 \"liver resident natural killer cell\")\n34017:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047101 \"liver-specific natural killer cell\")\n34018:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35726345\") oboInOwl:hasExactSynonym obo:CL_4047101 \"lr-NK\")\n34019:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34230995\") rdfs:comment obo:CL_4047101 \"Liver-resident natural killer cells play a crucial role in modulating the immune response during inflammation by balancing cytotoxic activity and cytokine production, thereby contributing to the maintenance of liver homeostasis and protection against excessive tissue damage.\")\n34020:AnnotationAssertion(rdfs:label obo:CL_4047101 \"liver-resident natural killer cell\")\n34021:EquivalentClasses(obo:CL_4047101 ObjectIntersectionOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281)))\n34023:# Class: obo:CL_4052001 (multiciliated ependymal cell)\n34025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") obo:IAO_0000115 obo:CL_4052001 \"An ependymal cell that lines the lateral, third, and fourth ventricles of the brain. The cell is characterized by multiple motile cilia on its apical surface, which beats in a coordinated manner to facilitate the movement of cerebrospinal fluid (CSF), contributing to brain homeostasis.\")\n34026:AnnotationAssertion(terms:contributor obo:CL_4052001 <https://orcid.org/0009-0000-8480-9277>)\n34027:AnnotationAssertion(terms:date obo:CL_4052001 \"2024-08-20T10:06:15Z\"^^xsd:dateTime)\n34028:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") oboInOwl:hasBroadSynonym obo:CL_4052001 \"multiciliated ependymal cells\")\n34029:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28067220\") Annotation(oboInOwl:hasDbXref \"PMID:37008045\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052001 \"E1\")\n34030:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25045600\") Annotation(oboInOwl:hasDbXref \"PMID:27311928\") rdfs:comment obo:CL_4052001 \"multiciliated ependymal cell, with an average of 16 motile cilia per cell, exhibits two types of planar cell polarity (PCP): rotational polarity, with unidirectional cilia orientation, and translational polarity, with asymmetric cilia positioning in the apical area. This location-specific PCP varies across the ventricular wall, aligning with the direction of CSF flow. These cells are interconnected by adherens and gap junctions, which support intercellular communication and maintain the structural integrity of the ependymal layer. Unlike some other cell types, these cells lack tight junctions.\")\n34031:AnnotationAssertion(rdfs:label obo:CL_4052001 \"multiciliated ependymal cell\")\n34032:EquivalentClasses(obo:CL_4052001 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004670) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n34034:# Class: obo:CL_4052002 (syncytial cell)\n34036:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20851884\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Syncytium\") obo:IAO_0000115 obo:CL_4052002 \"A multinucleate cell formed by the fusion of multiple uninuclear cells through plasma membrane fusion. This process leads to a single large cell containing multiple nuclei within a shared cytoplasm.\")\n34037:AnnotationAssertion(terms:contributor obo:CL_4052002 <https://orcid.org/0009-0000-8480-9277>)\n34038:AnnotationAssertion(terms:date obo:CL_4052002 \"2024-08-15T10:38:46Z\"^^xsd:dateTime)\n34039:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WBbt:0008074\") oboInOwl:hasExactSynonym obo:CL_4052002 \"syncytium\")\n34040:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9067520\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052002 \"SC\")\n34041:AnnotationAssertion(rdfs:label obo:CL_4052002 \"syncytial cell\")\n34042:EquivalentClasses(obo:CL_4052002 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001908) ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0000768)))\n34044:# Class: obo:CL_4052003 (intestinal villus capillary endothelial cell)\n34046:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:35810168\") Annotation(oboInOwl:hasDbXref \"PMID:38051275\") obo:IAO_0000115 obo:CL_4052003 \"A capillary endothelial cell that is part of the intestinal villus. This cell is highly fenestrated, with fenestrations most numerous at the villus tips, and plays a vital role in nutrient absorption and maintaining the selective permeability of the intestinal barrier.\")\n34047:AnnotationAssertion(terms:contributor obo:CL_4052003 <https://orcid.org/0009-0000-8480-9277>)\n34048:AnnotationAssertion(terms:date obo:CL_4052003 \"2024-09-17T10:03:25Z\"^^xsd:dateTime)\n34049:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35810168\") oboInOwl:hasBroadSynonym obo:CL_4052003 \"villus blood capillary endothelial cells\")\n34050:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38051275\") oboInOwl:hasRelatedSynonym obo:CL_4052003 \"villus tip endothelial cell\")\n34051:AnnotationAssertion(rdfs:label obo:CL_4052003 \"intestinal villus capillary endothelial cell\")\n34052:EquivalentClasses(obo:CL_4052003 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001213)))\n34053:SubClassOf(obo:CL_4052003 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34055:# Class: obo:CL_4052004 (intestinal fibroblastic reticular cell)\n34057:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\n34058:AnnotationAssertion(terms:contributor obo:CL_4052004 <https://orcid.org/0009-0000-8480-9277>)\n34059:AnnotationAssertion(terms:date obo:CL_4052004 \"2024-09-19T11:22:18Z\"^^xsd:dateTime)\n34060:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\n34061:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\n34062:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\n34063:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\n34064:AnnotationAssertion(rdfs:label obo:CL_4052004 \"intestinal fibroblastic reticular cell\")\n34065:SubClassOf(obo:CL_4052004 obo:CL_0009101)\n34066:SubClassOf(obo:CL_4052004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001962))\n34068:# Class: obo:CL_4052005 (intestinal subserosal fibroblast)\n34070:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\n34071:AnnotationAssertion(terms:contributor obo:CL_4052005 <https://orcid.org/0009-0000-8480-9277>)\n34072:AnnotationAssertion(terms:date obo:CL_4052005 \"2024-09-19T12:58:29Z\"^^xsd:dateTime)\n34073:AnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\n34074:SubClassOf(obo:CL_4052005 obo:CL_0000057)\n34075:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001243))\n34076:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012375))\n34078:# Class: obo:CL_4052006 (intestinal enteroendocrine progenitor)\n34080:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\n34081:AnnotationAssertion(terms:contributor obo:CL_4052006 <https://orcid.org/0009-0000-8480-9277>)\n34082:AnnotationAssertion(terms:date obo:CL_4052006 \"2024-09-20T12:13:26Z\"^^xsd:dateTime)\n34083:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052006 \"EEC Progenitor\")\n34084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25670791\") rdfs:comment obo:CL_4052006 \"The EEC progenitor is also present in other organisms; for example, flies have EEC progenitors but lack intestinal crypts and do not express the same markers. Instead, they are Dl+ and Pros+.\")\n34085:AnnotationAssertion(rdfs:label obo:CL_4052006 \"intestinal enteroendocrine progenitor\")\n34086:SubClassOf(obo:CL_4052006 obo:CL_0002563)\n34087:SubClassOf(obo:CL_4052006 obo:CL_0011026)\n34088:SubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\n34089:SubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\n34091:# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\n34093:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n34094:AnnotationAssertion(terms:contributor obo:CL_4052007 <https://orcid.org/0009-0000-8480-9277>)\n34095:AnnotationAssertion(terms:date obo:CL_4052007 \"2024-09-23T09:59:27Z\"^^xsd:dateTime)\n34096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\n34097:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\n34098:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\n34099:AnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\n34100:SubClassOf(obo:CL_4052007 obo:CL_0000057)\n34101:SubClassOf(obo:CL_4052007 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0001277))\n34103:# Class: obo:CL_4052008 (crypt-bottom fibroblast)\n34105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\n34106:AnnotationAssertion(terms:contributor obo:CL_4052008 <https://orcid.org/0009-0000-8480-9277>)\n34107:AnnotationAssertion(terms:date obo:CL_4052008 \"2024-09-23T10:23:18Z\"^^xsd:dateTime)\n34108:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052008 \"CBFs\")\n34109:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\n34110:AnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\n34111:SubClassOf(obo:CL_4052008 obo:CL_4052007)\n34112:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:CL_0002250))\n34113:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013739))\n34115:# Class: obo:CL_4052009 (crypt-top fibroblast)\n34117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\n34118:AnnotationAssertion(terms:contributor obo:CL_4052009 <https://orcid.org/0009-0000-8480-9277>)\n34119:AnnotationAssertion(terms:date obo:CL_4052009 \"2024-09-23T11:14:04Z\"^^xsd:dateTime)\n34120:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052009 \"CTFs\")\n34121:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\n34122:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\n34123:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\n34124:AnnotationAssertion(rdfs:label obo:CL_4052009 \"crypt-top fibroblast\")\n34125:SubClassOf(obo:CL_4052009 obo:CL_4052007)\n34126:SubClassOf(obo:CL_4052009 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013740))\n34128:# Class: obo:CL_4052010 (pre-theca cell)\n34130:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_4052010 \"A stromal cell that serves as a precursor to the theca cell layers in the ovary growing follicles. This cell is present in the early stages of follicular growth, particularly in smaller follicles. Unlike mature theca cell, a pre-theca cell is initially non-steroidogenic and lacks luteinizing hormone receptors.\")\n34131:AnnotationAssertion(terms:contributor obo:CL_4052010 <https://orcid.org/0009-0000-8480-9277>)\n34132:AnnotationAssertion(terms:date obo:CL_4052010 \"2024-09-25T11:15:57Z\"^^xsd:dateTime)\n34133:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052010 \"early theca cell\")\n34134:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") oboInOwl:hasExactSynonym obo:CL_4052010 \"progenitor theca cell\")\n34135:AnnotationAssertion(rdfs:label obo:CL_4052010 \"pre-theca cell\")\n34136:SubClassOf(obo:CL_4052010 obo:CL_0000499)\n34137:SubClassOf(obo:CL_4052010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012186))\n34138:SubClassOf(obo:CL_4052010 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_0000503))\n34140:# Class: obo:CL_4052011 (follicle associated enterocyte)\n34142:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29339448\") Annotation(oboInOwl:hasDbXref \"PMID:34634036\") Annotation(oboInOwl:hasDbXref \"PMID:7107724\") obo:IAO_0000115 obo:CL_4052011 \"An enterocyte found in the follicle-associated epithelium (FAE) that covers Peyer's patches and other mucosa-associated lymphoid tissues. This cell has reduced absorptive capacity and expresses higher levels of chemokines CCL20 and CXCL16, compared to regular villus enterocytes. It contributes to antigen sampling and immune interactions, supporting the specialized function of the FAE in mucosal immunity.\")\n34143:AnnotationAssertion(terms:contributor obo:CL_4052011 <https://orcid.org/0009-0000-8480-9277>)\n34144:AnnotationAssertion(terms:date obo:CL_4052011 \"2024-09-25T15:28:25Z\"^^xsd:dateTime)\n34145:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasExactSynonym obo:CL_4052011 \"follicle-associated epithelium enterocyte\")\n34146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052011 \"FAE enterocyte\")\n34147:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7107724\") oboInOwl:hasRelatedSynonym obo:CL_4052011 \"follicular enterocyte\")\n34148:AnnotationAssertion(rdfs:label obo:CL_4052011 \"follicle associated enterocyte\")\n34149:SubClassOf(obo:CL_4052011 obo:CL_0000584)\n34150:SubClassOf(obo:CL_4052011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004693))\n34152:# Class: obo:CL_4052012 (interna theca cell)\n34154:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15833266\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_interna\") obo:IAO_0000115 obo:CL_4052012 \"A specialized theca cell that forms the inner, highly vascularized layer of the theca surrounding ovarian follicles. Originating from progenitor theca cells, the theca interna cell is steroidogenic, playing a crucial role in the production of androgens, which serves as a precursor for estrogen synthesis in granulosa cells. This cell expresses luteinizing hormone receptors, enabling it to respond to hormonal signals that regulate steroidogenesis.\")\n34155:AnnotationAssertion(terms:contributor obo:CL_4052012 <https://orcid.org/0009-0000-8480-9277>)\n34156:AnnotationAssertion(terms:date obo:CL_4052012 \"2024-09-30T11:10:15Z\"^^xsd:dateTime)\n34157:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"androgenic theca cell\")\n34158:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"inTC\")\n34159:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052012 \"interna TC\")\n34160:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052012 \"steroidogenic theca interna cell\")\n34161:AnnotationAssertion(rdfs:label obo:CL_4052012 \"interna theca cell\")\n34162:EquivalentClasses(obo:CL_4052012 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000157)))\n34163:SubClassOf(obo:CL_4052012 obo:CL_0000593)\n34164:SubClassOf(obo:CL_4052012 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\n34165:DisjointClasses(obo:CL_4052012 obo:CL_4052013)\n34167:# Class: obo:CL_4052013 (externa theca cell)\n34169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n34170:AnnotationAssertion(terms:contributor obo:CL_4052013 <https://orcid.org/0009-0000-8480-9277>)\n34171:AnnotationAssertion(terms:date obo:CL_4052013 \"2024-09-30T11:10:15Z\"^^xsd:dateTime)\n34172:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"exTC\")\n34173:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052013 \"externa TC\")\n34174:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36599970\") oboInOwl:hasRelatedSynonym obo:CL_4052013 \"structural theca cell\")\n34175:AnnotationAssertion(rdfs:label obo:CL_4052013 \"externa theca cell\")\n34176:EquivalentClasses(obo:CL_4052013 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000156)))\n34177:SubClassOf(obo:CL_4052013 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4052010))\n34179:# Class: obo:CL_4052014 (pancreatic islet capillary endothelial cell)\n34181:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:27124642\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") Annotation(oboInOwl:hasDbXref \"PMID:33200981\") obo:IAO_0000115 obo:CL_4052014 \"A capillary endothelial cell that is part of islet of Langerhans, characterized by a high density of fenestrations —approximately ten times greater than those in exocrine pancreatic capillaries. These fenestrations facilitate efficient hormone exchange, which is essential for maintaining glucose homeostasis. The cell's structure and function are regulated by the local production of vascular endothelial growth factor-A (VEGF-A), which maintains its fenestrated architecture.\")\n34182:AnnotationAssertion(terms:contributor obo:CL_4052014 <https://orcid.org/0009-0000-8480-9277>)\n34183:AnnotationAssertion(terms:date obo:CL_4052014 \"2024-09-30T14:36:12Z\"^^xsd:dateTime)\n34184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"islet endothelial cell\")\n34185:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") oboInOwl:hasBroadSynonym obo:CL_4052014 \"pancreatic islet endothelial cell\")\n34186:AnnotationAssertion(rdfs:label obo:CL_4052014 \"pancreatic islet capillary endothelial cell\")\n34187:EquivalentClasses(obo:CL_4052014 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000006)))\n34188:SubClassOf(obo:CL_4052014 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34190:# Class: obo:CL_4052015 (endocrine gland capillary endothelial cell)\n34192:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") obo:IAO_0000115 obo:CL_4052015 \"Any capillary endothelial cell that is part of an endocrine gland.\")\n34193:AnnotationAssertion(terms:contributor obo:CL_4052015 <https://orcid.org/0009-0000-8480-9277>)\n34194:AnnotationAssertion(terms:date obo:CL_4052015 \"2024-09-30T15:27:49Z\"^^xsd:dateTime)\n34195:AnnotationAssertion(rdfs:label obo:CL_4052015 \"endocrine gland capillary endothelial cell\")\n34196:EquivalentClasses(obo:CL_4052015 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002368)))\n34198:# Class: obo:CL_4052016 (pituitary gland capillary endothelial cell)\n34200:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10810312\") Annotation(oboInOwl:hasDbXref \"PMID:32910242\") obo:IAO_0000115 obo:CL_4052016 \"A capillary endothelial cell that is part of the pituitary gland. This cell is characterized by its fenestrated structure which facilitates the efficient transport of hormones and other signaling molecules, essential for endocrine signalling.\")\n34201:AnnotationAssertion(terms:contributor obo:CL_4052016 <https://orcid.org/0009-0000-8480-9277>)\n34202:AnnotationAssertion(terms:date obo:CL_4052016 \"2024-09-30T15:31:45Z\"^^xsd:dateTime)\n34203:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:4899902\") rdfs:comment obo:CL_4052016 \"In the anterior pituitary gland of rats, capillary endothelial cells are distinguished by numerous fenestrations, which are covered by a single-layered diaphragm. The diaphragm features a dense ring-like structure.\")\n34204:AnnotationAssertion(rdfs:label obo:CL_4052016 \"pituitary gland capillary endothelial cell\")\n34205:EquivalentClasses(obo:CL_4052016 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000007)))\n34206:SubClassOf(obo:CL_4052016 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34208:# Class: obo:CL_4052017 (choroid plexus capillary endothelial cell)\n34210:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:32375819\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK27998/\") obo:IAO_0000115 obo:CL_4052017 \"A capillary endothelial cell that is part of the choroid plexus, characterized by its fenestrated nature with 60 to 80 nm fenestrations and lack of tight junctions. This fenestrated structure allows for the rapid delivery of water and other components, aiding in the production of cerebrospinal fluid (CSF).\")\n34211:AnnotationAssertion(terms:contributor obo:CL_4052017 <https://orcid.org/0009-0000-8480-9277>)\n34212:AnnotationAssertion(terms:date obo:CL_4052017 \"2024-10-01T11:38:22Z\"^^xsd:dateTime)\n34213:AnnotationAssertion(rdfs:label obo:CL_4052017 \"choroid plexus capillary endothelial cell\")\n34214:EquivalentClasses(obo:CL_4052017 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001886)))\n34215:SubClassOf(obo:CL_4052017 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002064))\n34217:# Class: obo:CL_4052018 (fallopian tube epithelial cell)\n34219:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\n34220:AnnotationAssertion(terms:contributor obo:CL_4052018 <https://orcid.org/0009-0000-8480-9277>)\n34221:AnnotationAssertion(terms:date obo:CL_4052018 \"2024-10-01T12:09:12Z\"^^xsd:dateTime)\n34222:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasBroadSynonym obo:CL_4052018 \"oviduct epithelial cell\")\n34223:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") oboInOwl:hasExactSynonym obo:CL_4052018 \"uterine tube epithelial cell\")\n34224:AnnotationAssertion(rdfs:label obo:CL_4052018 \"fallopian tube epithelial cell\")\n34225:EquivalentClasses(obo:CL_4052018 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34227:# Class: obo:CL_4052019 (fallopian tube non-ciliated epithelial cell)\n34229:AnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\n34230:AnnotationAssertion(terms:contributor obo:CL_4052019 <https://orcid.org/0009-0000-8480-9277>)\n34231:AnnotationAssertion(terms:date obo:CL_4052019 \"2024-10-01T12:12:12Z\"^^xsd:dateTime)\n34232:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052019 \"fallopian tube non-ciliated cell\")\n34233:AnnotationAssertion(rdfs:label obo:CL_4052019 \"fallopian tube non-ciliated epithelial cell\")\n34234:SubClassOf(obo:CL_4052019 obo:CL_0000066)\n34235:SubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n34236:SubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:CL_4030045 obo:GO_0005929))\n34238:# Class: obo:CL_4052020 (lung resident granzyme K-associated CD8 T cell)\n34240:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") obo:IAO_0000115 obo:CL_4052020 \"A granzyme K-associated CD8 T cell that resides in the lung, characterized by the expression of granzyme K (GZMK), and tissue residency markers CD103 and CD49a. This cell exhibits cytotoxic potential through its expression of multiple granzymes (GZMA, GZMB, GZMH, GZMM) in addition to GZMK.\")\n34241:AnnotationAssertion(terms:contributor obo:CL_4052020 <https://orcid.org/0000-0002-2336-2552>)\n34242:AnnotationAssertion(terms:contributor obo:CL_4052020 <https://orcid.org/0009-0000-8480-9277>)\n34243:AnnotationAssertion(terms:date obo:CL_4052020 \"2024-10-14T15:42:41Z\"^^xsd:dateTime)\n34244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052020 \"lung resident CD8-GZMK\")\n34245:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28322863\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") rdfs:comment obo:CL_4052020 \"Lung resident granzyme K-associated CD8 T cell represents an intermediate stage of T cell differentiation, with GZMK expression peaking during this phase.\")\n34246:AnnotationAssertion(rdfs:label obo:CL_4052020 \"lung resident granzyme K-associated CD8 T cell\")\n34247:EquivalentClasses(obo:CL_4052020 ObjectIntersectionOf(obo:CL_4033040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34249:# Class: obo:CL_4052021 (granzyme K-associated CD8 T cell)\n34251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasDbXref \"PMID:37449888\") obo:IAO_0000115 obo:CL_4052021 \"A CD8 T cell characterized by high expression of Granzyme K (GZMK). This cell is enriched in both inflamed tissues, such as synovial tissue in rheumatoid arthritis and respiratory tissues during COVID-19, as well as non-inflamed tissues like the gut and kidneys. Unlike highly cytotoxic GZMB+ CD8+ T cell, GZMK+ CD8+ T cell exhibits lower direct cytotoxic potential, and is involved in producing pro-inflammatory cytokines such as IFN-γ and TNF-α.\")\n34252:AnnotationAssertion(terms:contributor obo:CL_4052021 <https://orcid.org/0009-0000-8480-9277>)\n34253:AnnotationAssertion(terms:date obo:CL_4052021 \"2024-10-18T09:51:48Z\"^^xsd:dateTime)\n34254:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"granzyme K+ CD8 T cell\")\n34255:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") oboInOwl:hasExactSynonym obo:CL_4052021 \"tissue-enriched expressing GzmK CD8 cell\")\n34256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36347862\") oboInOwl:hasNarrowSynonym obo:CL_4052021 \"GZMK high CD8+ T effector memory cell\")\n34257:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.06.17.496207\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"CD8-GZMK cell\")\n34258:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35704599\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052021 \"TteK CD8 cell\")\n34259:AnnotationAssertion(rdfs:label obo:CL_4052021 \"granzyme K-associated CD8 T cell\")\n34260:EquivalentClasses(obo:CL_4052021 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34262:# Class: obo:CL_4052022 (fallopian tube smooth muscle cell)\n34264:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31183831\") Annotation(oboInOwl:hasDbXref \"PMID:31613440\") obo:IAO_0000115 obo:CL_4052022 \"A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.\")\n34265:AnnotationAssertion(terms:contributor obo:CL_4052022 <https://orcid.org/0009-0000-8480-9277>)\n34266:AnnotationAssertion(terms:date obo:CL_4052022 \"2024-10-21T12:16:54Z\"^^xsd:dateTime)\n34267:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasBroadSynonym obo:CL_4052022 \"oviduct smooth muscle cell\")\n34268:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31613440\") oboInOwl:hasExactSynonym obo:CL_4052022 \"uterine tube smooth muscle cell\")\n34269:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18621753\") rdfs:comment obo:CL_4052022 \"The fallopian tube smooth muscle cell in the human contracts dynamically in response to hormones and signaling molecules. Prostaglandins, particularly PGF2α and PGE2, have been shown to increase muscular contractions, while progesterone, levonorgestrel, mifepristone, oxytocin, and human chorionic gonadotropin (hCG) decrease them. These contractile responses are crucial for regulating gamete and embryo transport through the fallopian tube.\")\n34270:AnnotationAssertion(rdfs:label obo:CL_4052022 \"fallopian tube smooth muscle cell\")\n34271:EquivalentClasses(obo:CL_4052022 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34273:# Class: obo:CL_4052023 (luminal endometrial unciliated epithelial cell)\n34275:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32929266\") Annotation(oboInOwl:hasDbXref \"PMID:36581776\") Annotation(oboInOwl:hasDbXref \"PMID:38559249\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052023 \"An epithelial cell that is part of the endometrial luminal epithelium, forming a continuous layer lining the uterine cavity. This cell undergoes cyclical changes during the menstrual cycle, proliferating under estrogen in the proliferative phase, and differentiating under progesterone in the secretory phase to prepare for potential implantation. During the window of implantation, this cell changes from a tall columnar shape to a shorter columnar or cuboidal form, loses polarity, and becomes receptive to blastocyst implantation.\")\n34276:AnnotationAssertion(terms:contributor obo:CL_4052023 <https://orcid.org/0009-0000-8480-9277>)\n34277:AnnotationAssertion(terms:date obo:CL_4052023 \"2024-10-22T12:02:23Z\"^^xsd:dateTime)\n34278:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") rdfs:comment obo:CL_4052023 \"The luminal endometrial unciliated epithelial cell expresses WNT7A, and LGR5 during the proliferative phase, transitioning to express VTCN1 and SULT1E1 in the early secretory phase, and LEFTY1, IL6, and PTGS1 in the mid- to late-secretory phases.\")\n34279:AnnotationAssertion(rdfs:label obo:CL_4052023 \"luminal endometrial unciliated epithelial cell\")\n34280:EquivalentClasses(obo:CL_4052023 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032940)))\n34282:# Class: obo:CL_4052024 (myotendinous junction nucleus)\n34284:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasDbXref \"PMID:38398025\") obo:IAO_0000115 obo:CL_4052024 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.\")\n34285:AnnotationAssertion(terms:contributor obo:CL_4052024 <https://orcid.org/0009-0000-8480-9277>)\n34286:AnnotationAssertion(terms:contributor obo:CL_4052024 <https://orcid.org/0009-0001-6947-615X>)\n34287:AnnotationAssertion(terms:date obo:CL_4052024 \"2024-10-30T13:47:39Z\"^^xsd:dateTime)\n34288:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction myonuclei\")\n34289:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052024 \"myotendinous junction nuclei\")\n34290:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052024 \"MTJ nucleus\")\n34291:AnnotationAssertion(rdfs:label obo:CL_4052024 \"myotendinous junction nucleus\")\n34292:EquivalentClasses(obo:CL_4052024 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:BFO_0000050 obo:CL_0008046) ObjectSomeValuesFrom(obo:RO_0002131 obo:GO_0005927)))\n34294:# Class: obo:CL_4052025 (neuromuscular junction nucleus)\n34296:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33037211\") Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") obo:IAO_0000115 obo:CL_4052025 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.\")\n34297:AnnotationAssertion(terms:contributor obo:CL_4052025 <https://orcid.org/0009-0000-8480-9277>)\n34298:AnnotationAssertion(terms:contributor obo:CL_4052025 <https://orcid.org/0009-0001-6947-615X>)\n34299:AnnotationAssertion(terms:date obo:CL_4052025 \"2024-10-31T11:09:04Z\"^^xsd:dateTime)\n34300:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction myonuclei\")\n34301:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasExactSynonym obo:CL_4052025 \"neuromuscular junction nuclei\")\n34302:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052025 \"NMJ nuclues\")\n34303:AnnotationAssertion(rdfs:label obo:CL_4052025 \"neuromuscular junction nucleus\")\n34304:EquivalentClasses(obo:CL_4052025 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:BFO_0000050 obo:CL_0008046) ObjectSomeValuesFrom(obo:RO_0002131 obo:GO_0098522)))\n34306:# Class: obo:CL_4052026 (type IIx muscle cell)\n34308:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") Annotation(oboInOwl:hasDbXref \"PMID:35908794\") Annotation(oboInOwl:hasDbXref \"PMID:36361732\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") obo:IAO_0000115 obo:CL_4052026 \"A fast type II muscle cell that is part of the skeletal muscle tissue. This cell is characterized by its intermediate metabolic profile, utilizing both glycolytic and oxidative pathways for energy production. In humans, it is distinguished by the expression of myosin heavy chain 1 (MYH1).\")\n34309:AnnotationAssertion(terms:contributor obo:CL_4052026 <https://orcid.org/0009-0000-8480-9277>)\n34310:AnnotationAssertion(terms:date obo:CL_4052026 \"2024-11-04T10:26:29Z\"^^xsd:dateTime)\n34311:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x fiber\")\n34312:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle cell\")\n34313:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type 2x muscle fiber\")\n34314:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") oboInOwl:hasExactSynonym obo:CL_4052026 \"type IIx muscle fiber\")\n34315:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199166\") Annotation(oboInOwl:hasDbXref \"PMID:34727990\") rdfs:comment obo:CL_4052026 \"In humans, type IIx fiber contains high levels of MYLK2, enhancing contraction speed and force via myosin phosphorylation, especially under low calcium. This mechanism supports post-activation potentiation, increasing force output in fast-twitch muscles. Additionally, this fiber has abundant ACTN3 (α-actinin-3), linked to muscle power, and exhibits the highest shortening velocity among human muscle fiber types. Notably, type IIx fiber is selectively lost in aging-related sarcopenia, increases in proportion in type 2 diabetes and obesity, and is the first to degenerate in Duchenne Muscular Dystrophy, impacting muscle function across various conditions.\")\n34316:AnnotationAssertion(rdfs:label obo:CL_4052026 \"type IIx muscle cell\")\n34317:SubClassOf(obo:CL_4052026 obo:CL_0002212)\n34318:SubClassOf(obo:CL_4052026 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001134))\n34320:# Class: obo:CL_4052027 (atretic theca cell)\n34322:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:38069168\") obo:IAO_0000115 obo:CL_4052027 \"A theca cell undergoing atresia, characterized by distinct morphological changes including hypertrophy, altered cell shape, and disrupted layered organization. This cell exhibits reduced steroidogenic capacity and changes in surrounding vascularization. The onset of theca cell atresia can vary, occurring at different stages of follicle atresia depending on the phase of folliculogenesis.\")\n34323:AnnotationAssertion(terms:contributor obo:CL_4052027 <https://orcid.org/0009-0000-8480-9277>)\n34324:AnnotationAssertion(terms:date obo:CL_4052027 \"2024-11-06T10:10:51Z\"^^xsd:dateTime)\n34325:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") rdfs:comment obo:CL_4052027 \"During atresia, theca interna and externa cells undergo distinct morphological and functional changes. Theca interna cells round up, expand in cytoplasmic area, and thicken the internal layer as organization degrades, while showing reduced STAR expression, which lowers androgen production. Theca externa cells display decreased ACTA2 expression, weakening structural integrity.\")\n34326:AnnotationAssertion(rdfs:label obo:CL_4052027 \"atretic theca cell\")\n34327:SubClassOf(obo:CL_4052027 obo:CL_4033089)\n34328:SubClassOf(obo:CL_4052027 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000503))\n34330:# Class: obo:CL_4052028 (uterine natural killer cell)\n34332:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Uterine_natural_killer_cells\") obo:IAO_0000115 obo:CL_4052028 \"A natural killer cell that is part of the uterus, specifically within the endometrium during the non-pregnant state and in the decidua during pregnancy. This cell exhibits dynamic changes in frequency throughout the menstrual cycle, with lower levels during menstruation and a significant increase during the mid-secretory phase and early pregnancy.\")\n34333:AnnotationAssertion(terms:contributor obo:CL_4052028 <https://orcid.org/0009-0000-8480-9277>)\n34334:AnnotationAssertion(terms:date obo:CL_4052028 \"2024-11-15T10:12:40Z\"^^xsd:dateTime)\n34335:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") oboInOwl:hasNarrowSynonym obo:CL_4052028 \"endometrial natural killer cell\")\n34336:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052028 \"uNK cell\")\n34337:AnnotationAssertion(rdfs:label obo:CL_4052028 \"uterine natural killer cell\")\n34338:EquivalentClasses(obo:CL_4052028 ObjectIntersectionOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n34340:# Class: obo:CL_4052029 (subpleural fibroblast)\n34342:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\n34343:AnnotationAssertion(terms:contributor obo:CL_4052029 <https://orcid.org/0009-0000-8480-9277>)\n34344:AnnotationAssertion(terms:date obo:CL_4052029 \"2024-11-29T13:54:15Z\"^^xsd:dateTime)\n34345:AnnotationAssertion(rdfs:label obo:CL_4052029 \"subpleural fibroblast\")\n34346:SubClassOf(obo:CL_4052029 obo:CL_0000057)\n34347:SubClassOf(obo:CL_4052029 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048))\n34349:# Class: obo:CL_4052030 (adventitial fibroblast)\n34351:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\n34352:AnnotationAssertion(terms:contributor obo:CL_4052030 <https://orcid.org/0009-0000-8480-9277>)\n34353:AnnotationAssertion(terms:date obo:CL_4052030 \"2024-12-05T11:01:15Z\"^^xsd:dateTime)\n34354:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\n34355:AnnotationAssertion(rdfs:label obo:CL_4052030 \"adventitial fibroblast\")\n34356:EquivalentClasses(obo:CL_4052030 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005734)))\n34357:SubClassOf(obo:CL_4052030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816))\n34358:SubClassOf(obo:CL_4052030 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n34360:# Class: obo:CL_4052031 (respiratory airway secretory cell)\n34362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") obo:IAO_0000115 obo:CL_4052031 \"A secretory epithelial cell of the respiratory and terminal bronchioles.\")\n34363:AnnotationAssertion(terms:contributor obo:CL_4052031 <https://orcid.org/0009-0000-8480-9277>)\n34364:AnnotationAssertion(terms:date obo:CL_4052031 \"2024-11-29T16:14:31Z\"^^xsd:dateTime)\n34365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36796082\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052031 \"RAS cell\")\n34366:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355018\") oboInOwl:hasRelatedSynonym obo:CL_4052031 \"terminal and respiratory bronchioles secretory cell\")\n34367:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35355013\") Annotation(oboInOwl:hasDbXref \"PMID:36796082\") rdfs:comment obo:CL_4052031 \"The respiratory airway secretory cell is cuboidal and has a unique transcriptomic profile compared to other epithelial cells in the same region. In humans, it functions as a multipotent progenitor, capable of regenerating alveolar type 2 (AT2) cells.\")\n34368:AnnotationAssertion(rdfs:label obo:CL_4052031 \"respiratory airway secretory cell\")\n34369:SubClassOf(obo:CL_4052031 obo:CL_1100001)\n34370:SubClassOf(obo:CL_4052031 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002051))\n34372:# Class: obo:CL_4052032 (granzyme H-associated CD8 T cell)\n34374:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") obo:IAO_0000115 obo:CL_4052032 \"A CD8 T cell characterized by high expression of Granzyme H (GZMH). This cell exhibits a restricted TCR repertoire and elevated expression of cytotoxic, exhaustion, and type I interferon-stimulated gene signatures compared to controls.\")\n34375:AnnotationAssertion(terms:contributor obo:CL_4052032 <https://orcid.org/0000-0002-3958-7465>)\n34376:AnnotationAssertion(terms:contributor obo:CL_4052032 <https://orcid.org/0009-0000-8480-9277>)\n34377:AnnotationAssertion(terms:date obo:CL_4052032 \"2025-01-10T10:14:31Z\"^^xsd:dateTime)\n34378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") oboInOwl:hasExactSynonym obo:CL_4052032 \"granzyme H+ CD8 T cell\")\n34379:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052032 \"GZMH+ CD8+ T cell\")\n34380:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35389781\") rdfs:comment obo:CL_4052032 \"This cell type is significantly expanded in systemic lupus erythematosus (SLE) patients. Unlike other CD8 T cell populations, GZMH+ CD8 T cells can comprise up to 50% of all lymphocytes in some SLE patients.\")\n34381:AnnotationAssertion(rdfs:label obo:CL_4052032 \"granzyme H-associated CD8 T cell\")\n34382:EquivalentClasses(obo:CL_4052032 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003490)))\n34384:# Class: obo:CL_4052033 (biliary tuft cell)\n34386:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") Annotation(oboInOwl:hasDbXref \"PMID:37863104\") obo:IAO_0000115 obo:CL_4052033 \"A tuft cell that is part of the extrahepatic biliary tree, including the gallbladder and extrahepatic bile ducts. It shares a core genetic program with intestinal tuft cells but has unique tissue-specific genes. Biliary tuft cell functions as a bile acid-sensitive regulator, suppressing inflammation and modulating microbiome-dependent neutrophil infiltration in biliary tissues. Unlike its intestinal counterparts, this cell decreases in number postnatally as bile acid production matures, with its abundance negatively regulated by bile acids.\")\n34387:AnnotationAssertion(terms:contributor obo:CL_4052033 <https://orcid.org/0009-0000-8480-9277>)\n34388:AnnotationAssertion(terms:date obo:CL_4052033 \"2025-01-20T14:39:06Z\"^^xsd:dateTime)\n34389:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") oboInOwl:hasExactSynonym obo:CL_4052033 \"gallbladder/extrahepatic bile duct tuft cell\")\n34390:AnnotationAssertion(rdfs:label obo:CL_4052033 \"biliary tuft cell\")\n34391:SubClassOf(obo:CL_4052033 obo:CL_0002204)\n34392:SubClassOf(obo:CL_4052033 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050728))\n34394:# Class: obo:CL_4052034 (tuft cell of thymus)\n34396:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:35668088\") Annotation(oboInOwl:hasDbXref \"PMID:36351364\") Annotation(oboInOwl:hasDbXref \"PMID:36961668\") obo:IAO_0000115 obo:CL_4052034 \"A tuft cell that is part of the medullary epithelium of the thymus, characterized by lateral microvilli and specific markers, including L1CAM in both mice (Zhang et al., 2022) and humans (Sun et al., 2023), as well as MHC II in mice (Miller et al., 2018). This cell is pivotal in immune functions such as antigen presentation, central tolerance, and type 2 immunity. A tuft cell in the thymus exhibits characteristics of both a medullary thymic epithelial cell (mTEC) and a peripheral tuft cell. Its development is governed by transcription factors such as POU2F3.\")\n34397:AnnotationAssertion(terms:contributor obo:CL_4052034 <https://orcid.org/0009-0000-8480-9277>)\n34398:AnnotationAssertion(terms:date obo:CL_4052034 \"2025-01-16T11:29:54Z\"^^xsd:dateTime)\n34399:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") oboInOwl:hasExactSynonym obo:CL_4052034 \"thymic tuft cell\")\n34400:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") rdfs:comment obo:CL_4052034 \"A thymic tuft cell is a subset of terminally differentiated medullary thymic epithelial cell comprising 5-10% of total mTECs. Lineage-tracing studies indicate that this cell arises from mature MHCII mTECs, with development occurring through both Aire-dependent and Aire-independent pathways. However, its exact origins remain unclear.\")\n34401:AnnotationAssertion(rdfs:label obo:CL_4052034 \"tuft cell of thymus\")\n34402:EquivalentClasses(obo:CL_4052034 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003846)))\n34403:SubClassOf(obo:CL_4052034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002124))\n34404:SubClassOf(obo:CL_4052034 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002491))\n34406:# Class: obo:CL_4052035 (tuft cell of pancreatic duct)\n34408:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:32717220\") obo:IAO_0000115 obo:CL_4052035 \"A tuft cell that is part of the epithelium of pancreatic duct. Present in humans and rats, this cell is absent in the murine pancreas under normal conditions but emerges during acinar-to-ductal metaplasia triggered by injury, inflammation, or oncogenic mutations. It modulates the immune response and protects against pancreatic ductal adenocarcinoma progression by producing suppressive eicosanoids, such as prostaglandin D2. A tuft cell in the pancreatic duct highly expresses the transcription factor POU2F3, which is essential for its development and presence.\")\n34409:AnnotationAssertion(terms:contributor obo:CL_4052035 <https://orcid.org/0009-0000-8480-9277>)\n34410:AnnotationAssertion(terms:date obo:CL_4052035 \"2025-01-16T11:50:08Z\"^^xsd:dateTime)\n34411:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9749964\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic brush cell\")\n34412:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32717220\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic tuft cell\")\n34413:AnnotationAssertion(rdfs:label obo:CL_4052035 \"tuft cell of pancreatic duct\")\n34414:EquivalentClasses(obo:CL_4052035 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009970)))\n34416:# Class: obo:CL_4052036 (tuft cell of nasal cavity)\n34418:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052036 \"A tuft cell that is part of the nasal cavity epithelium, located in both the respiratory and olfactory epithelia of the nose. This cell plays key roles in chemosensation, lipid mediator production, immune responses, and epithelial homeostasis.\")\n34419:AnnotationAssertion(terms:contributor obo:CL_4052036 <https://orcid.org/0009-0000-8480-9277>)\n34420:AnnotationAssertion(terms:date obo:CL_4052036 \"2025-01-21T09:04:03Z\"^^xsd:dateTime)\n34421:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34692913\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal brush cell\")\n34422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal tuft cell\")\n34423:AnnotationAssertion(rdfs:label obo:CL_4052036 \"tuft cell of nasal cavity\")\n34424:EquivalentClasses(obo:CL_4052036 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005384)))\n34426:# Class: obo:CL_4052037 (tuft cell of olfactory epithelium)\n34428:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") obo:IAO_0000115 obo:CL_4052037 \"A tuft cell that is part of the olfactory epithelium, characterized by a globular body and the expression of neurogranin (Nrgn) in mice. This cell plays a crucial role in allergen recognition and regulating olfactory stem cell proliferation via TRPM5-dependent ATP sensing and cysteinyl leukotriene production. Unlike nasal respiratory tuft cells, it has low to absent expression of taste receptors, including the G protein Gα gustducin, and rarely contacts olfactory sensory neurons directly.\")\n34429:AnnotationAssertion(terms:contributor obo:CL_4052037 <https://orcid.org/0009-0000-8480-9277>)\n34430:AnnotationAssertion(terms:date obo:CL_4052037 \"2025-02-06T15:03:53Z\"^^xsd:dateTime)\n34431:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052037 \"olfactory tuft cell\")\n34432:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TPRM5+ tuft-MVC\")\n34433:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous cell\")\n34434:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous tuft cell\")\n34435:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"tuft-microvillous cell\")\n34436:AnnotationAssertion(rdfs:label obo:CL_4052037 \"tuft cell of olfactory epithelium\")\n34437:EquivalentClasses(obo:CL_4052037 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001997)))\n34438:SubClassOf(obo:CL_4052037 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0072091))\n34440:# Class: obo:CL_4052038 (tuft cell of nasal cavity respiratory epithelium)\n34442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n34443:AnnotationAssertion(terms:contributor obo:CL_4052038 <https://orcid.org/0009-0000-8480-9277>)\n34444:AnnotationAssertion(terms:date obo:CL_4052038 \"2025-02-06T15:28:14Z\"^^xsd:dateTime)\n34445:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"Gɑ-gustducin high respiratory tuft cell\")\n34446:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"nasal respiratory solitary chemosensory cell\")\n34447:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"tuft-solitary chemosensory cell\")\n34448:AnnotationAssertion(rdfs:label obo:CL_4052038 \"tuft cell of nasal cavity respiratory epithelium\")\n34449:EquivalentClasses(obo:CL_4052038 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005385)))\n34451:# Class: obo:CL_4052039 (tuft cell of submandibular gland)\n34453:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\n34454:AnnotationAssertion(terms:contributor obo:CL_4052039 <https://orcid.org/0009-0000-8480-9277>)\n34455:AnnotationAssertion(terms:date obo:CL_4052039 \"2025-02-12T10:38:11Z\"^^xsd:dateTime)\n34456:AnnotationAssertion(rdfs:label obo:CL_4052039 \"tuft cell of submandibular gland\")\n34457:EquivalentClasses(obo:CL_4052039 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003359)))\n34459:# Class: obo:CL_4052040 (tuft cell of stomach)\n34461:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:38117182\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.02.16.480779\") obo:IAO_0000115 obo:CL_4052040 \"A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.\")\n34462:AnnotationAssertion(terms:contributor obo:CL_4052040 <https://orcid.org/0009-0000-8480-9277>)\n34463:AnnotationAssertion(terms:date obo:CL_4052040 \"2025-02-12T11:24:56Z\"^^xsd:dateTime)\n34464:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38117182\") oboInOwl:hasExactSynonym obo:CL_4052040 \"gastric tuft cell\")\n34465:AnnotationAssertion(rdfs:label obo:CL_4052040 \"tuft cell of stomach\")\n34466:EquivalentClasses(obo:CL_4052040 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001276)))\n34468:# Class: obo:CL_4052041 (tuft cell of auditory tube)\n34470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\n34471:AnnotationAssertion(terms:contributor obo:CL_4052041 <https://orcid.org/0009-0000-8480-9277>)\n34472:AnnotationAssertion(terms:date obo:CL_4052041 \"2025-02-12T12:00:10Z\"^^xsd:dateTime)\n34473:AnnotationAssertion(rdfs:label obo:CL_4052041 \"tuft cell of auditory tube\")\n34474:EquivalentClasses(obo:CL_4052041 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010062)))\n34475:SubClassOf(obo:CL_4052041 obo:CL_0002491)\n34477:# Class: obo:CL_4052042 (tuft cell of urethra)\n34479:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\n34480:AnnotationAssertion(terms:contributor obo:CL_4052042 <https://orcid.org/0009-0000-8480-9277>)\n34481:AnnotationAssertion(terms:date obo:CL_4052042 \"2025-02-12T14:39:03Z\"^^xsd:dateTime)\n34482:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral brush cell\")\n34483:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral cholinergic chemosensory cell\")\n34484:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\n34485:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\n34486:AnnotationAssertion(rdfs:label obo:CL_4052042 \"tuft cell of urethra\")\n34487:EquivalentClasses(obo:CL_4052042 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002325)))\n34488:SubClassOf(obo:CL_4052042 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1904320))\n34490:# Class: obo:CL_4052045 (steroidogenic stromal cell of ovary)\n34492:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\n34493:AnnotationAssertion(terms:contributor obo:CL_4052045 <https://orcid.org/0009-0000-8480-9277>)\n34494:AnnotationAssertion(terms:date obo:CL_4052045 \"2025-03-05T13:37:44Z\"^^xsd:dateTime)\n34495:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic interstitial stromal cell\")\n34496:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasBroadSynonym obo:CL_4052045 \"steroidogenic stromal cell\")\n34497:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasRelatedSynonym obo:CL_4052045 \"Enpp2− interstitial cell\")\n34498:AnnotationAssertion(rdfs:label obo:CL_4052045 \"steroidogenic stromal cell of ovary\")\n34499:EquivalentClasses(obo:CL_4052045 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006960) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0120178)))\n34501:# Class: obo:CL_4052046 (early luteal cell)\n34503:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052046 \"A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.\")\n34504:AnnotationAssertion(terms:contributor obo:CL_4052046 <https://orcid.org/0009-0000-8480-9277>)\n34505:AnnotationAssertion(terms:date obo:CL_4052046 \"2025-03-05T16:40:18Z\"^^xsd:dateTime)\n34506:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052046 \"active corpus luteum cell\")\n34507:AnnotationAssertion(rdfs:label obo:CL_4052046 \"early luteal cell\")\n34508:SubClassOf(obo:CL_4052046 obo:CL_0000175)\n34509:SubClassOf(obo:CL_4052046 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006701))\n34511:# Class: obo:CL_4052047 (late luteal cell)\n34513:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31803139\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052047 \"A luteal cell that is part of the older, regressing corpus luteum. This cell exhibits increased expression of genes involved in progesterone metabolism - Akr1c18 in mice (Lan et al., 2024), cell cycle arrest, and apoptosis. A late luteal cell contributes to corpus luteum regression and eventual clearance from the ovary through luteolysis.\")\n34514:AnnotationAssertion(terms:contributor obo:CL_4052047 <https://orcid.org/0009-0000-8480-9277>)\n34515:AnnotationAssertion(terms:date obo:CL_4052047 \"2025-03-05T16:47:20Z\"^^xsd:dateTime)\n34516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") oboInOwl:hasExactSynonym obo:CL_4052047 \"regressing corpus luteum cell\")\n34517:AnnotationAssertion(rdfs:label obo:CL_4052047 \"late luteal cell\")\n34518:SubClassOf(obo:CL_4052047 obo:CL_0000175)\n34519:SubClassOf(obo:CL_4052047 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006709))\n34521:# Class: obo:CL_4052048 (intercalated cell of salivary gland)\n34523:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n34524:AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0000-0003-4389-9821>)\n34525:AnnotationAssertion(terms:contributor obo:CL_4052048 <https://orcid.org/0009-0000-8480-9277>)\n34526:AnnotationAssertion(terms:date obo:CL_4052048 \"2024-09-11T09:55:55Z\"^^xsd:dateTime)\n34527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasBroadSynonym obo:CL_4052048 \"intercalated duct cell\")\n34528:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\n34529:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35799078\") oboInOwl:hasRelatedSynonym obo:CL_4052048 \"Id cell\")\n34530:AnnotationAssertion(rdfs:label obo:CL_4052048 \"intercalated cell of salivary gland\")\n34531:SubClassOf(obo:CL_4052048 obo:CL_1001596)\n34532:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014727))\n34533:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34535:# Class: obo:CL_4052049 (striated cell of salivary gland)\n34537:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n34538:AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0000-0003-4389-9821>)\n34539:AnnotationAssertion(terms:contributor obo:CL_4052049 <https://orcid.org/0009-0000-8480-9277>)\n34540:AnnotationAssertion(terms:date obo:CL_4052049 \"2024-09-11T10:00:25Z\"^^xsd:dateTime)\n34541:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"SD cells\")\n34542:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\n34543:AnnotationAssertion(rdfs:label obo:CL_4052049 \"striated cell of salivary gland\")\n34544:EquivalentClasses(obo:CL_4052049 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014729)))\n34545:SubClassOf(obo:CL_4052049 obo:CL_1001596)\n34546:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34547:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0036376))\n34548:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990573))\n34550:# Class: obo:CL_4052050 (luminal epithelial cell of endometrium)\n34552:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36273006\") obo:IAO_0000115 obo:CL_4052050 \"An epithelial cell that is part of an endometrium luminal epithelium.\")\n34553:AnnotationAssertion(terms:contributor obo:CL_4052050 <https://orcid.org/0009-0000-8480-9277>)\n34554:AnnotationAssertion(terms:date obo:CL_4052050 \"2025-03-13T13:46:13Z\"^^xsd:dateTime)\n34555:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31317179\") oboInOwl:hasExactSynonym obo:CL_4052050 \"endometrial luminal epithelial cell\")\n34556:AnnotationAssertion(rdfs:label obo:CL_4052050 \"luminal epithelial cell of endometrium\")\n34557:EquivalentClasses(obo:CL_4052050 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949)))\n34559:# Class: obo:CL_4052051 (uterine natural killer cell 1, human)\n34561:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34512661\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052051 \"​​A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018). It expresses the uterine resident marker CD49a and is distinguished from uNK2 and uNK3 by CD39 expression and the absence of CD103 (Whettlock et al., 2022) and CD160 (Marečková et al., 2024). It also expresses higher levels of killer-cell immunoglobulin-like receptors (KIRs) and leukocyte immunoglobulin-like receptor B1 (LILRB1), which facilitate interaction with human leukocyte antigens (HLAs) on extravillous trophoblast cells, promoting immune tolerance and implantation. Enriched in the endometrium post-ovulation (Marečková et al., 2024) and prominent in early pregnancy (Whettlock et al., 2022), uNK1 regulates trophoblast invasion and spiral artery remodeling (Zhang & Wei, 2021).\")\n34562:AnnotationAssertion(terms:contributor obo:CL_4052051 <https://orcid.org/0009-0000-8480-9277>)\n34563:AnnotationAssertion(terms:date obo:CL_4052051 \"2025-03-14T10:48:38Z\"^^xsd:dateTime)\n34564:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052051 \"decidual natural killer cell 1\")\n34565:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052051 \"uNK1\")\n34566:AnnotationAssertion(rdfs:label obo:CL_4052051 \"uterine natural killer cell 1, human\")\n34567:EquivalentClasses(obo:CL_4052051 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34569:# Class: obo:CL_4052052 (uterine natural killer cell 2, human)\n34571:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\n34572:AnnotationAssertion(terms:contributor obo:CL_4052052 <https://orcid.org/0009-0000-8480-9277>)\n34573:AnnotationAssertion(terms:date obo:CL_4052052 \"2025-03-14T14:31:03Z\"^^xsd:dateTime)\n34574:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\n34575:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\n34576:AnnotationAssertion(rdfs:label obo:CL_4052052 \"uterine natural killer cell 2, human\")\n34577:EquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34579:# Class: obo:CL_4052053 (uterine natural killer cell 3, human)\n34581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\n34582:AnnotationAssertion(terms:contributor obo:CL_4052053 <https://orcid.org/0009-0000-8480-9277>)\n34583:AnnotationAssertion(terms:date obo:CL_4052053 \"2025-03-14T16:15:39Z\"^^xsd:dateTime)\n34584:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\n34585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\n34586:AnnotationAssertion(rdfs:label obo:CL_4052053 \"uterine natural killer cell 3, human\")\n34587:EquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34589:# Class: obo:CL_4052055 (mature NK T cell, human)\n34591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\n34592:AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0000-0001-5742-4697>)\n34593:AnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0009-0000-8480-9277>)\n34594:AnnotationAssertion(terms:date obo:CL_4052055 \"2025-03-26T11:56:38Z\"^^xsd:dateTime)\n34595:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\n34596:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\n34597:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\n34598:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NKT cell, human\")\n34599:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T cell, human\")\n34600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T lymphocyte, human\")\n34601:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T-lymphocyte, human\")\n34602:AnnotationAssertion(rdfs:label obo:CL_4052055 \"mature NK T cell, human\")\n34603:EquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34605:# Class: obo:CL_4052058 (Merkel cell of epidermis)\n34607:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_4052058 \"A Merkel cell found mainly in the basal layer of the epidermis and the outer root sheath of hair follicles, particularly concentrated in areas with high tactile acuity, such as touch domes, hair follicles, and fingertips.\")\n34608:AnnotationAssertion(terms:contributor obo:CL_4052058 <https://orcid.org/0009-0000-8480-9277>)\n34609:AnnotationAssertion(terms:date obo:CL_4052058 \"2025-06-11T10:01:40Z\"^^xsd:dateTime)\n34610:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6207057\") oboInOwl:hasExactSynonym obo:CL_4052058 \"epdiermal Merkel cell\")\n34611:AnnotationAssertion(rdfs:label obo:CL_4052058 \"Merkel cell of epidermis\")\n34612:EquivalentClasses(obo:CL_4052058 ObjectIntersectionOf(obo:CL_0000242 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34614:# Class: obo:CL_4052060 (spinous cell)\n34616:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34283481\") Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") obo:IAO_0000115 obo:CL_4052060 \"A differentiating keratinocyte found in the epidermis and oral epithelium, located in the stratum spinosum, characterized by a spiny appearance due to abundant intercellular desmosomal junctions.\")\n34617:AnnotationAssertion(terms:contributor obo:CL_4052060 <https://orcid.org/0009-0000-8480-9277>)\n34618:AnnotationAssertion(terms:date obo:CL_4052060 \"2025-07-02T12:21:06Z\"^^xsd:dateTime)\n34619:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_4052060 \"prickle cell\")\n34620:AnnotationAssertion(rdfs:label obo:CL_4052060 \"spinous cell\")\n34621:SubClassOf(obo:CL_4052060 obo:CL_0000312)\n34622:SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030057))\n34623:SubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001365))\n34625:# Class: obo:CL_4052061 (epidermal keratinocyte)\n34627:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\n34628:AnnotationAssertion(terms:contributor obo:CL_4052061 <https://orcid.org/0009-0000-8480-9277>)\n34629:AnnotationAssertion(terms:date obo:CL_4052061 \"2025-07-02T12:32:13Z\"^^xsd:dateTime)\n34630:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4052061 \"keratincyte of epidermis\")\n34631:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39185948\") oboInOwl:hasExactSynonym obo:CL_4052061 \"skin keratinocyte\")\n34632:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") rdfs:comment obo:CL_4052061 \"Keratinocytes are reportedly CDw210a(IL-10RA)-negative , CDw210b(IL-10RB)-positive, IL22Ra1-positive, Human keratinocytes are reportedly capable of secreting BD-2, BD-3, hCAP-18, CXCL1, CXCL5, CXCL8, elafin, MMP-3, NGAL, PDGF-A, S100A7, S100A8, and S100A9. Transcription factors: STAT3-positive.\")\n34633:AnnotationAssertion(rdfs:label obo:CL_4052061 \"epidermal keratinocyte\")\n34634:EquivalentClasses(obo:CL_4052061 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34635:SubClassOf(obo:CL_4052061 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0090023))\n34637:# Class: obo:CL_4052062 (onychofibroblast)\n34639:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\n34640:AnnotationAssertion(terms:contributor obo:CL_4052062 <https://orcid.org/0009-0000-8480-9277>)\n34641:AnnotationAssertion(terms:date obo:CL_4052062 \"2025-07-22T14:35:00Z\"^^xsd:dateTime)\n34642:AnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n34643:SubClassOf(obo:CL_4052062 obo:CL_0000057)\n34644:SubClassOf(obo:CL_4052062 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001705))\n34646:# Class: obo:CL_4052063 (nail bed keratinocyte)\n34648:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10651700\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:33799809\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052063 \"A keratinocyte that resides in the nail bed, responsible for tightly attaching the nail plate to the underlying dermis. Unlike typical epidermal keratinocytes, it exhibits limited proliferation, undergoes modified differentiation that skips the granular layer and conventional cornification, and primarily ensures adhesion and maintenance of the nail plate. In humans, this cell expresses characteristic markers, including the protease inhibitor SPINK6 and the differentiation-associated protein KRT16.\")\n34649:AnnotationAssertion(terms:contributor obo:CL_4052063 <https://orcid.org/0009-0000-8480-9277>)\n34650:AnnotationAssertion(terms:date obo:CL_4052063 \"2024-07-22T15:30:00Z\"^^xsd:dateTime)\n34651:AnnotationAssertion(rdfs:label obo:CL_4052063 \"nail bed keratinocyte\")\n34652:SubClassOf(obo:CL_4052063 obo:CL_0000312)\n34653:SubClassOf(obo:CL_4052063 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005273))\n34655:# Class: obo:CL_4052064 (nail matrix keratinocyte)\n34657:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\n34658:AnnotationAssertion(terms:contributor obo:CL_4052064 <https://orcid.org/0009-0000-8480-9277>)\n34659:AnnotationAssertion(terms:date obo:CL_4052064 \"2025-07-22T15:30:00Z\"^^xsd:dateTime)\n34660:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39044464\") oboInOwl:hasExactSynonym obo:CL_4052064 \"nail matrix epithelial keratinocyte\")\n34661:AnnotationAssertion(rdfs:label obo:CL_4052064 \"nail matrix keratinocyte\")\n34662:EquivalentClasses(obo:CL_4052064 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002283)))\n34664:# Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n34666:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n34667:AnnotationAssertion(terms:contributor obo:CL_4052065 <https://orcid.org/0009-0000-8480-9277>)\n34668:AnnotationAssertion(terms:date obo:CL_4052065 \"2025-08-05T15:24:46Z\"^^xsd:dateTime)\n34669:AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n34670:EquivalentClasses(obo:CL_4052065 ObjectIntersectionOf(obo:CL_0000313 obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013232)))\n34671:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0042588))\n34672:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0005983))\n34674:# Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n34676:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n34677:AnnotationAssertion(terms:contributor obo:CL_4052066 <https://orcid.org/0009-0000-8480-9277>)\n34678:AnnotationAssertion(terms:date obo:CL_4052066 \"2025-08-05T15:33:46Z\"^^xsd:dateTime)\n34679:AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n34680:EquivalentClasses(obo:CL_4052066 ObjectIntersectionOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014717)))\n34681:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0098594))\n34682:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070254))\n34684:# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n34686:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n34687:AnnotationAssertion(terms:contributor obo:CL_4052067 <https://orcid.org/0009-0000-8480-9277>)\n34688:AnnotationAssertion(terms:date obo:CL_4052067 \"2025-08-06T11:26:37Z\"^^xsd:dateTime)\n34689:AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n34690:SubClassOf(obo:CL_4052067 obo:CL_0000159)\n34691:SubClassOf(obo:CL_4052067 obo:CL_0002623)\n34693:# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n34695:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n34696:AnnotationAssertion(terms:contributor obo:CL_4052069 <https://orcid.org/0009-0000-8480-9277>)\n34697:AnnotationAssertion(terms:date obo:CL_4052069 \"2025-08-08T11:20:00Z\"^^xsd:dateTime)\n34698:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n34699:AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n34700:SubClassOf(obo:CL_4052069 obo:CL_1001596)\n34701:SubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n34703:# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n34705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n34706:AnnotationAssertion(terms:contributor obo:CL_4052070 <https://orcid.org/0009-0000-8480-9277>)\n34707:AnnotationAssertion(terms:date obo:CL_4052070 \"2025-08-12T16:05:47Z\"^^xsd:dateTime)\n34708:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_4052070 \"unclassified fallopian tube progenitor\")\n34709:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\n34710:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\n34711:AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n34712:SubClassOf(obo:CL_4052070 obo:CL_0011026)\n34713:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600124))\n34714:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n34716:# Class: obo:CL_4052071 (quiescent fibroblast)\n34718:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\n34719:AnnotationAssertion(terms:contributor obo:CL_4052071 <https://orcid.org/0009-0000-8480-9277>)\n34720:AnnotationAssertion(terms:date obo:CL_4052071 \"2025-08-13T15:42:37Z\"^^xsd:dateTime)\n34721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\n34722:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\n34723:AnnotationAssertion(rdfs:label obo:CL_4052071 \"quiescent fibroblast\")\n34724:SubClassOf(obo:CL_4052071 obo:CL_0000057)\n34726:# Class: obo:CL_4052108 (IgD-negative class switched memory B cell)\n34728:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20839340\") Annotation(oboInOwl:hasDbXref \"PMID:32741082\") Annotation(oboInOwl:hasDbXref \"PMID:36617261\") Annotation(oboInOwl:hasDbXref \"PMID:37254600\") obo:IAO_0000115 obo:CL_4052108 \"A class switched memory B cell that lacks IgD on the cell surface.\")\n34729:AnnotationAssertion(terms:contributor obo:CL_4052108 <https://orcid.org/0009-0000-8480-9277>)\n34730:AnnotationAssertion(terms:date obo:CL_4052108 \"2025-12-08T10:33:49Z\"^^xsd:dateTime)\n34731:AnnotationAssertion(rdfs:label obo:CL_4052108 \"IgD-negative class switched memory B cell\")\n34732:EquivalentClasses(obo:CL_4052108 ObjectIntersectionOf(obo:CL_0000972 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738)))\n34734:# Class: obo:CL_4070010 (gastric mill neuron)\n34736:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070010 \"A motor neuron that moves the medial tooth forward\")\n34737:AnnotationAssertion(obo:RO_0002175 obo:CL_4070010 obo:NCBITaxon_6712)\n34738:AnnotationAssertion(obo:RO_0002175 obo:CL_4070010 obo:NCBITaxon_6752)\n34739:AnnotationAssertion(terms:contributor obo:CL_4070010 <https://orcid.org/0000-0002-1909-7004>)\n34740:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070010 \"GM\")\n34741:AnnotationAssertion(rdfs:label obo:CL_4070010 \"gastric mill neuron\")\n34742:SubClassOf(obo:CL_4070010 obo:CL_0000100)\n34743:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34744:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34746:# Class: obo:CL_4070011 (lateral gastric neuron)\n34748:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070011 \"A motor neuron that closes the lateral teeth.\")\n34749:AnnotationAssertion(obo:RO_0002175 obo:CL_4070011 obo:NCBITaxon_6712)\n34750:AnnotationAssertion(obo:RO_0002175 obo:CL_4070011 obo:NCBITaxon_6752)\n34751:AnnotationAssertion(terms:contributor obo:CL_4070011 <https://orcid.org/0000-0002-1909-7004>)\n34752:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070011 \"LG\")\n34753:AnnotationAssertion(rdfs:label obo:CL_4070011 \"lateral gastric neuron\")\n34754:SubClassOf(obo:CL_4070011 obo:CL_0000100)\n34755:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34756:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34758:# Class: obo:CL_4070012 (inferior cardiac neuron)\n34760:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-642-71516-7_2\") obo:IAO_0000115 obo:CL_4070012 \"A motor neuron that controls ventral stomach grooves leading to pyloric filter.\")\n34761:AnnotationAssertion(obo:RO_0002175 obo:CL_4070012 obo