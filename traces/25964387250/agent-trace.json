")\n7405:SubClassOf(obo:CL_0000424 obo:CL_0000000)\n7407:# Class: obo:CL_0000425 (pore cell)\n7409:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000425 \"Forms the terminal part of the cuticle-lined excretory duct of C. elegans.\")\n7410:AnnotationAssertion(rdfs:label obo:CL_0000425 \"pore cell\")\n7411:SubClassOf(obo:CL_0000425 obo:CL_0000658)\n7413:# Class: obo:CL_0000426 (obsolete scaffold cell)\n7415:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000426 <https://github.com/obophenotype/cell-ontology/issues/708>)\n7416:AnnotationAssertion(rdfs:comment obo:CL_0000426 \"This is a cell used in tissue engineering and is out of scope for CL.\")\n7417:AnnotationAssertion(rdfs:label obo:CL_0000426 \"obsolete scaffold cell\")\n7418:AnnotationAssertion(owl:deprecated obo:CL_0000426 \"true\"^^xsd:boolean)\n7420:# Class: obo:CL_0000427 (GLR cell)\n7422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://wormatlas.psc.edu/hermaphrodite/muscleGLR/mainframe.htm\") obo:IAO_0000115 obo:CL_0000427 \"A scaffolding cell type found in C. elegans, this cell plays a supportive role to the muscle arms. May also have an endocrine role.\")\n7423:AnnotationAssertion(rdfs:label obo:CL_0000427 \"GLR cell\")\n7424:SubClassOf(obo:CL_0000427 obo:CL_0002320)\n7426:# Class: obo:CL_0000428 (yolk cell)\n7428:AnnotationAssertion(rdfs:label obo:CL_0000428 \"yolk cell\")\n7429:SubClassOf(obo:CL_0000428 obo:CL_0000325)\n7430:SubClassOf(obo:CL_0000428 obo:CL_0000349)\n7432:# Class: obo:CL_0000429 (imaginal disc cell)\n7434:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00412-016-0595-4\") obo:IAO_0000115 obo:CL_0000429 \"A columnar epithelial cell that is part of an insect imaginal disc.\")\n7435:AnnotationAssertion(rdfs:comment obo:CL_0000429 \"This term does not encompass all the cell types that may be found in an epithelial disc (such as the peripodial or adepithelial cells), only the cells that form the disc epithelium proper.\")\n7436:AnnotationAssertion(rdfs:label obo:CL_0000429 \"imaginal disc cell\")\n7437:SubClassOf(obo:CL_0000429 obo:CL_0000146)\n7438:SubClassOf(obo:CL_0000429 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000939))\n7439:SubClassOf(obo:CL_0000429 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7441:# Class: obo:CL_0000430 (xanthophore cell)\n7443:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000430 \"A pigment cell derived from the neural crest. Contains cartenoid pigments in structures called pterinosomes or xanthosomes. This gives an appearance ranging from a golden yellow to orange and red.\")\n7444:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000430 \"xanthophore\")\n7445:AnnotationAssertion(rdfs:label obo:CL_0000430 \"xanthophore cell\")\n7446:SubClassOf(obo:CL_0000430 obo:CL_0000147)\n7447:SubClassOf(obo:CL_0000430 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0005002))\n7449:# Class: obo:CL_0000431 (iridophore)\n7451:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000431 \"A pigment cell derived from the neural crest. The cell contains flat light-reflecting platelets, probably of guanine, in stacks called reflecting platelets or iridisomes. The color-generating components produce a silver, gold, or iridescent color.\")\n7452:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000431 \"guanophore\")\n7453:AnnotationAssertion(rdfs:label obo:CL_0000431 \"iridophore\")\n7454:SubClassOf(obo:CL_0000431 obo:CL_0000147)\n7455:SubClassOf(obo:CL_0000431 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0005001))\n7457:# Class: obo:CL_0000432 (reticular cell)\n7459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\n7460:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000432 \"FMA:62877\")\n7461:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000432 \"reticulum cell\")\n7462:AnnotationAssertion(rdfs:label obo:CL_0000432 \"reticular cell\")\n7463:AnnotationAssertion(rdfs:seeAlso obo:CL_0000432 \"https://github.com/obophenotype/cell-ontology/issues/1472\")\n7464:SubClassOf(obo:CL_0000432 obo:CL_0000057)\n7466:# Class: obo:CL_0000433 (obsolete functional megaspore)\n7468:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000433 \"Obsolete. Use PO:0000244 from Plant Ontology instead. In monosporic and bisporic megasporogenesis: the megaspore(s) that will undergo megagametogenesis.\")\n7469:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000433 obo:PO_0000244)\n7470:AnnotationAssertion(rdfs:label obo:CL_0000433 \"obsolete functional megaspore\")\n7471:AnnotationAssertion(owl:deprecated obo:CL_0000433 \"true\"^^xsd:boolean)\n7473:# Class: obo:CL_0000434 (eccrine cell)\n7475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0198547684\") obo:IAO_0000115 obo:CL_0000434 \"A secretory cell that discharges its product without loss of cytoplasm.\")\n7476:AnnotationAssertion(rdfs:label obo:CL_0000434 \"eccrine cell\")\n7477:SubClassOf(obo:CL_0000434 obo:CL_0000066)\n7478:SubClassOf(obo:CL_0000434 obo:CL_0000151)\n7480:# Class: obo:CL_0000435 (alkali secreting cell)\n7482:AnnotationAssertion(rdfs:label obo:CL_0000435 \"alkali secreting cell\")\n7483:SubClassOf(obo:CL_0000435 obo:CL_0000151)\n7485:#