valentClasses(obo:CL_0000438 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032275)))\n7513:# Class: obo:CL_0000439 (prolactin secreting cell)\n7515:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000439 \"A peptide hormone cell that secretes prolactin.\")\n7516:AnnotationAssertion(rdfs:label obo:CL_0000439 \"prolactin secreting cell\")\n7517:EquivalentClasses(obo:CL_0000439 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070459)))\n7519:# Class: obo:CL_0000440 (melanocyte stimulating hormone secreting cell)\n7521:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000440 \"A cell of the intermediate pituitary that produces melanocyte stimulating hormone.\")\n7522:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000440 \"BTO:0002277\")\n7523:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000440 \"melanotrope\")\n7524:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000440 \"melanotroph\")\n7525:AnnotationAssertion(rdfs:label obo:CL_0000440 \"melanocyte stimulating hormone secreting cell\")\n7526:EquivalentClasses(obo:CL_0000440 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0036160)))\n7528:# Class: obo:CL_0000441 (follicle stem cell (sensu Arthropoda))\n7530:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012369493-5.50005-5\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-020-19361-0\") Annotation(oboInOwl:hasDbXref \"doi:10.1242/dev.121.11.3797\") obo:IAO_0000115 obo:CL_0000441 \"A stem cell that gives rise to the follicle cells that surround the oocyte in female arthropods.\")\n7531:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.devcel.2005.08.012\") oboInOwl:hasBroadSynonym obo:CL_0000441 \"somatic stem cell\")\n7532:AnnotationAssertion(rdfs:label obo:CL_0000441 \"follicle stem cell (sensu Arthropoda)\")\n7533:SubClassOf(obo:CL_0000441 obo:CL_0000036)\n7534:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/issues/1943\") obo:CL_0000441 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7536:# Class: obo:CL_0000442 (follicular dendritic cell)\n7538:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:127520252\") obo:IAO_0000115 obo:CL_0000442 \"A cell with extensive dendritic processes found in the B cell areas (primary follicles and germinal centers) of lymphoid tissue. They are unrelated to the dendritic cell associated with T cells. Follicular dendritic cells have Fc receptors and C3b receptors, but unlike other dendritic cells, they do not process or present antigen in a way that allows recognition by T cells. Instead, they hold antigen in the form of immune complexes on their surfaces for long periods and can present antigen to B cells during an immune response.\")\n7539:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"BTO:0004267\")\n7540:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"FMA:83037\")\n7541:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000442 \"MESH:D020566\")\n7542:AnnotationAssertion(rdfs:comment obo:CL_0000442 \"Due to its unique lineage and distinct function, this is not a type of dendritic cell; CL:0000451.\")\n7543:AnnotationAssertion(rdfs:label obo:CL_0000442 \"follicular dendritic cell\")\n7544:SubClassOf(obo:CL_0000442 obo:CL_0000451)\n7546:# Class: obo:CL_0000443 (calcitonin secreting cell)\n7548:AnnotationAssertion(rdfs:label obo:CL_0000443 \"calcitonin secreting cell\")\n7549:EquivalentClasses(obo:CL_0000443 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0036161)))\n7551:# Class: obo:CL_0000444 (obliquely striated muscle cell)\n7553:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:DOS\") Annotation(oboInOwl:hasDbXref \"PMID:8720463\") obo:IAO_0000115 obo:CL_0000444 \"A muscle cell in which the fibers are organised into sarcomeres but in which adjacent myofibrils are offset from each other, producing an oblique banding pattern.\")\n7554:AnnotationAssertion(rdfs:comment obo:CL_0000444 \"Examples include the somatic muscles of nemotodes and cephalopods.\")\n7555:AnnotationAssertion(rdfs:label obo:CL_0000444 \"obliquely striated muscle cell\")\n7556:EquivalentClasses(obo:CL_0000444 ObjectIntersectionOf(obo:CL_0000187 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030017) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002479)))\n7558:# Class: obo:CL_0000445 (apoptosis fated cell)\n7560:AnnotationAssertion(rdfs:label obo:CL_0000445 \"apoptosis fated cell\")\n7561:SubClassOf(obo:CL_0000445 obo:CL_0000000)\n7563:# Class: obo:CL_0000446 (chief cell of parathyroid gland)\n7565:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69078\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000446 \"An epithelial cell of the parathyroid gland that is arranged in wide, irregular interconnecting columns; responsible for the synthesis and secretion of parathyroid hormone.\")\n7566:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"BTO:0004712\")\n7567:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"CALOHA:TS-2140\")\n7568:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000446 \"FMA:69078\")\n7569:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid chief cell\")\n7570:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid gland chief cell\")\n7571:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"parathyroid hormone secreting cell\")\n7572:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000446 \"principal cell of parathyroid gland\")\n7573:AnnotationAssertion(rdfs:label obo:CL_0000446 \"chief cell of parathyroid gland\")\n7574:SubClassOf(obo:CL_0000446 obo:CL_0000066)\n7575:SubClassOf(obo:CL_0000446 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011197))\n7576:SubCl