000101 \"Any neuron having a sensory function; an afferent neuron conveying sensory impulses.\")\n4775:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000101 \"BTO:0001037\")\n4776:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000101 \"FMA:84649\")\n4777:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000101 \"MESH:D011984\")\n4778:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000101 \"WBbt:0005759\")\n4779:AnnotationAssertion(rdfs:label obo:CL_0000101 \"sensory neuron\")\n4780:EquivalentClasses(obo:CL_0000101 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050906)))\n4781:SubClassOf(obo:CL_0000101 obo:CL_0000526)\n4783:# Class: obo:CL_0000102 (polymodal neuron)\n4785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23749412\") Annotation(oboInOwl:hasDbXref \"PMID:36381588\") obo:IAO_0000115 obo:CL_0000102 \"A neuron type that respond to multiple stimuli such as mechanical, thermal and chemical. This neuron type is responsible for integrating different types of sensory inputs, allowing organisms to respond appropriately to diverse environmental challenges.\")\n4786:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23749412\") oboInOwl:hasRelatedSynonym obo:CL_0000102 \"polymodal sensory neuron\")\n4787:AnnotationAssertion(rdfs:label obo:CL_0000102 \"polymodal neuron\")\n4788:SubClassOf(obo:CL_0000102 obo:CL_2000032)\n4790:# Class: obo:CL_0000103 (bipolar neuron)\n4792:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0444009442\") obo:IAO_0000115 obo:CL_0000103 \"A type of interneuron that has two neurites, usually an axon and a dendrite, extending from opposite poles of an ovoid cell body.\")\n4793:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000103 \"FMA:67282\")\n4794:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000103 cl:BDS_subset)\n4795:AnnotationAssertion(rdfs:label obo:CL_0000103 \"bipolar neuron\")\n4796:EquivalentClasses(obo:CL_0000103 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070006)))\n4798:# Class: obo:CL_0000104 (multipolar neuron)\n4800:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:67287\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000104 \"A neuron with three or more neurites, usually an axon and multiple dendrites.\")\n4801:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000104 \"FMA:67287\")\n4802:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000104 cl:BDS_subset)\n4803:AnnotationAssertion(rdfs:label obo:CL_0000104 \"multipolar neuron\")\n4804:SubClassOf(obo:CL_0000104 obo:CL_0000540)\n4805:SubClassOf(obo:CL_0000104 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070026))\n4806:SubClassOf(obo:CL_0000104 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n4808:# Class: obo:CL_0000105 (pseudounipolar neuron)\n4810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:67305\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000105 \"Neuron with two neurites that are fused grossly when they protrude from the soma and bifurcate a short distance from the soma.\")\n4811:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000105 \"FMA:67305\")\n4812:AnnotationAssertion(rdfs:label obo:CL_0000105 \"pseudounipolar neuron\")\n4813:SubClassOf(obo:CL_0000105 obo:CL_2000032)\n4815:# Class: obo:CL_0000106 (unipolar neuron)\n4817:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:67278\") Annotation(oboInOwl:hasDbXref \"GOC:nv\") obo:IAO_0000115 obo:CL_0000106 \"Neuron with one neurite that extends from the cell body.\")\n4818:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000106 \"FMA:67278\")\n4819:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000106 cl:BDS_subset)\n4820:AnnotationAssertion(rdfs:label obo:CL_0000106 \"unipolar neuron\")\n4821:SubClassOf(obo:CL_0000106 obo:CL_2000032)\n4823:# Class: obo:CL_0000107 (autonomic neuron)\n4825:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000107 \"A neuron whose cell body is within an autonomic ganglion.\")\n4826:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000107 \"FMA:80121\")\n4827:AnnotationAssertion(rdfs:label obo:CL_0000107 \"autonomic neuron\")\n4828:EquivalentClasses(obo:CL_0000107 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002410)))\n4829:SubClassOf(obo:CL_0000107 obo:CL_0000540)\n4831:# Class: obo:CL_0000108 (cholinergic neuron)\n4833:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000108 \"A neuron that uses acetylcholine as a vesicular neurotransmitter.\")\n4834:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000108 \"BTO:0004902\")\n4835:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000108 \"FMA:84796\")\n4836:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000108 \"MESH:D059329\")\n4837:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000108 \"WBbt:0006840\")\n4838:AnnotationAssertion(rdfs:label obo:CL_0000108 \"cholinergic neuron\")\n4839:EquivalentClasses(obo:CL_0000108 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055)))\n4841:# Class: obo:CL_0000109 (adrenergic neuron)\n4843:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000109 \"MESH:D059331\")\n4844:AnnotationAssertion(rdfs:label obo:CL_0000109 \"adrenergic neuron\")\n4845:SubClassOf(obo:CL_0000109 obo:CL_0000540)\n4846:SubClassOf(obo:CL_0000109 obo:CL_4033050)\n4848:# Class: obo:CL_0000110 (peptidergic neuron)\n4850:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23040809\") Annotation(oboInOwl:hasDbXref \"doi:10.1016/B978-012589762-4/50021-9\") obo:IAO_0000115 obo:CL_0000110 \"A neuron that uses neuropeptides as transmitters.\")\n4851:AnnotationAssertion(rdfs:label obo:CL_0000110 \"peptidergic neuron\")\n4852:SubClassOf(obo:CL_0000110 obo:CL_0000540)\n4853:SubClassOf(obo:CL_0000110 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002790))\n4855:# Class: obo:CL_0000111 (obsolete peripheral neuron)\n4857:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000111 \"OBSOLETE A neuron that is part of nerve found outside the central nervous system.\")\n4858:AnnotationAssertion(obo:IAO_0000231 obo:CL_0000111 obo:IAO_0000227)\n4859:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000111 <https://github.com/obophenotype/cell-ontology/issues/1069>)\n4860:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000111 obo:CL_2000032)\n4861:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000111 \"FMA:84664\")\n4862:AnnotationAssertion(rdfs:comment obo:CL_0000111 \"Merging into CL:2000032.\")\n4863:AnnotationAssertion(rdfs:label obo:CL_0000111 \"obsolete peripheral neuron\")\n4864:AnnotationAssertion(owl:deprecated obo:CL_0000111 \"true\"^^xsd:boolean)\n4866:# Class: obo:CL_0000112 (columnar neuron)\n4868:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34696823\") Annotation(oboInOwl:hasDbXref \"PMID:37608556\") obo:IAO_0000115 obo:CL_0000112 \"A neuron of the invertebrate central nervous system. This neuron innervates the central complex (CX) of an invertebrate brain and it forms columnar patterns with its dendrites. It is involved in navigation and spatial processing.\")\n4869:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18837039\") Annotation(oboInOwl:hasDbXref \"PMID:32374034\") Annotation(oboInOwl:hasDbXref \"PMID:34696823\") Annotation(oboInOwl:hasDbXref \"PMID:37608556\") Annotation(oboInOwl:hasDbXref \"PMID:9153131\") rdfs:comment obo:CL_0000112 \"Columnar neurons have been widely studied in Diptera, locusts, honey bees and other insects. In the mammalian brain, a \\\"columnar organisation\\\" is referred to neurons of the neocortex, however these differ from columnar neurons which are found in the insects central nervous system.\")\n4870:AnnotationAssertion(rdfs:label obo:CL_0000112 \"columnar neuron\")\n4871:SubClassOf(obo:CL_0000112 obo:CL_0000028)\n4872:SubClassOf(obo:CL_0000112 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n4873:SubClassOf(obo:CL_0000112 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000338))\n4874:SubClassOf(obo:CL_0000112 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0007601))\n4876:# Class: obo:CL_0000113 (mononuclear phagocyte)\n4878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000113 \"A vertebrate phagocyte with a single nucleus.\")\n4879:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000113 \"BTO:0001433\")\n4880:AnnotationAssertion(rdfs:label obo:CL_0000113 \"mononuclear phagocyte\")\n4881:EquivalentClasses(obo:CL_0000113 ObjectIntersectionOf(obo:CL_0000518 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001407)))\n4882:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000113 obo:CL_0000518)\n4883:SubClassOf(obo:CL_0000113 obo:CL_0000842)\n4885:# Class: obo:CL_0000114 (surface ectodermal cell)\n4887:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:7892198\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Surface_ectoderm\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.07.02.601324\") obo:IAO_0000115 obo:CL_0000114 \"An ectodermal cell that is part of the external ectoderm, forming the outermost layer of the developing embryo. It is characterized by its polarized nature, with distinct apical and basal surfaces (Ferrante Jr., Reinke, & Stanley, 1995). Surface ectodermal cell gives rise to the epidermis, hair follicles, nails, sensory organs, and specialized structures like the apical ectodermal ridge crucial for limb development (Skoufa et al., 2024).\")\n4888:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000114 \"FMA:72552\")\n4889:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000114 \"cell of surface ectoderm\")\n4890:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.07.02.601324\") oboInOwl:hasExactSynonym obo:CL_0000114 \"surface ectoderm cell\")\n4891:AnnotationAssertion(rdfs:label obo:CL_0000114 \"surface ectodermal cell\")\n4892:EquivalentClasses(obo:CL_0000114 ObjectIntersectionOf(obo:CL_0000221 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000076)))\n4894:# Class: obo:CL_0000115 (endothelial cell)\n4896:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D042783\") Annotation(oboInOwl:hasDbXref \"PMID:21275341\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Endothelial_cell\") Annotation(oboInOwl:hasDbXref \"https://sourceforge.net/tracker/?func=detail&atid=440764&aid=3364936&group_id=36855\") obo:IAO_0000115 obo:CL_0000115 \"An endothelial cell comprises the outermost layer or lining of anatomical structures and can be squamous or cuboidal. In mammals, endothelial cell has vimentin filaments and is derived from the mesoderm.\")\n4897:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000115 \"BTO:0001176\")\n4898:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000115 \"CALOHA:TS-0278\")\n4899:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000115 \"FMA:66772\")\n4900:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000115 \"endotheliocyte\")\n4901:AnnotationAssertion(rdfs:comment obo:CL_0000115 \"From FMA: 9.07.2001: Endothelial cell has always been classified as a kind of epithelial cell, specifically a squamous cell but that is not true. First, endothelial cell can either be squamous or cuboidal (e.g. high-endothelial cell) and secondly, it has different embryological derivation (mesodermal) than a true epithelial cell (ectodermal and endodermal). The basis for present classification is the fact that it comprises the outermost layer or lining of anatomical structures (location-based) but a better structural basis for the differentia is the cytoskeleton of the cell. Endothelial cell has vimentin filaments while an epithelial cell has keratin filaments. [Onard].\")\n4902:AnnotationAssertion(rdfs:label obo:CL_0000115 \"endothelial cell\")\n4903:SubClassOf(obo:CL_0000115 obo:CL_0000000)\n4904:SubClassOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000222))\n4906:# Class: obo:CL_0000116 (pioneer neuron)\n4908:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cvs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000116 \"Pioneer neurons establish a pathway in the developing central nervous system and then undergo programmed cell death once the adult axons, which follow them, have made connections with the target site. Thus, they are a transient cell type involved in axon guidance.\")\n4909:AnnotationAssertion(rdfs:label obo:CL_0000116 \"pioneer neuron\")\n4910:SubClassOf(obo:CL_0000116 obo:CL_0000540)\n4912:# Class: obo:CL_0000117 (CNS neuron (sensu Vertebrata))\n4914:AnnotationAssertion(rdfs:label obo:CL_0000117 \"CNS neuron (sensu Vertebrata)\")\n4915:SubClassOf(obo:CL_0000117 obo:CL_2000029)\n4916:SubClassOf(obo:CL_0000117 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n4918:# Class: obo:CL_0000118 (basket cell)\n4920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Basket_cell&oldid=951703880\") obo:IAO_0000115 obo:CL_0000118 \"Basket cells are inhibitory GABAergic interneurons of the brain. In general, dendrites of basket cells are free branching and contain smooth spines. Axons are highly branched. The branched axonal arborizations give rise to basket-like structures that surround the soma of the target cell. Basket cells form axo-somatic synapses, meaning their synapses target somas of other cells.\")\n4921:AnnotationAssertion(terms:contributor obo:CL_0000118 <https://orcid.org/0000-0002-2825-0621>)\n4922:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000118 cl:BDS_subset)\n4923:AnnotationAssertion(rdfs:label obo:CL_0000118 \"basket cell\")\n4924:EquivalentClasses(obo:CL_0000118 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070002) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n4926:# Class: obo:CL_0000119 (cerebellar Golgi cell)\n4928:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NIFSTD:sao1415726815\") obo:IAO_0000115 obo:CL_0000119 \"Large intrinsic neuron located in the granule layer of the cerebellar cortex that extends its dendrites into the molecular layer where they receive contact from parallel fibers. The axon of the Golgi cell ramifies densely in the granule layer and enters into a complex arrangement with mossy fiber terminals and granule cell dendrites to form the cerebellar glomerulus. Llinas, Walton and Lang. In The Synaptic Organization of the Brain. 5th ed. 2004.\")\n4929:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000119 \"MESH:D000080906\")\n4930:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"Golgi cell\")\n4931:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"Golgi neuron\")\n4932:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"cerebellar Golgi neuron\")\n4933:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000119 \"cerebellum Golgi cell\")\n4934:AnnotationAssertion(rdfs:label obo:CL_0000119 \"cerebellar Golgi cell\")\n4935:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_0000119 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\n4936:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0000119 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.png>)\n4937:SubClassOf(obo:CL_0000119 obo:CL_0011005)\n4938:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002956))\n4939:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002113 obo:UBERON_0002956))\n4940:SubClassOf(obo:CL_0000119 ObjectSomeValuesFrom(obo:RO_0002360 obo:UBERON_0002974))\n4942:# Class: obo:CL_0000120 (granule cell)\n4944:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://medical-dictionary.thefreedictionary.com/granule+cell>) obo:IAO_0000115 obo:CL_0000120 \"A neuron of the vertebrate central nervous system that is small in size. This general class includes small neurons in the granular layer of the cerebellar cortex, cerebral cortex neurons that are not pyramidal cells and small neurons without axons found in the olfactory bulb.\")\n4945:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000120 \"BTO:0003393\")\n4946:AnnotationAssertion(rdfs:label obo:CL_0000120 \"granule cell\")\n4947:SubClassOf(obo:CL_0000120 obo:CL_0000540)\n4948:SubClassOf(obo:CL_0000120 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n4950:# Class: obo:CL_0000121 (Purkinje cell)\n4952:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D011689\") Annotation(oboInOwl:hasDbXref \"PMID:12907269\") Annotation(oboInOwl:hasDbXref \"PMID:14568361\") Annotation(oboInOwl:hasDbXref \"PMID:31424738\") Annotation(oboInOwl:hasDbXref \"PMID:33288911\") Annotation(oboInOwl:hasDbXref \"PMID:38168772\") obo:IAO_0000115 obo:CL_0000121 \"An inhibitory neuron and the sole output neuron of the cerebellar cortex, the Purkinje cell's soma is located between the granular and molecular layers of the cerebellum. It is one of the largest neural cells in the mammalian brain, ranging from 50 to 80 micrometres in diameter. Purkinje cells have planar, fan-shaped dendrites that branch extensively with little overlap. This cell type receives synaptic input from parallel fibres, which modulate high-frequency spike activity known as \\\"simple spikes,\\\" and climbing fibres, which modulate infrequent calcium spike activity known as \\\"complex spikes\\\". Purkinje cells are involved in motor coordination, particularly in correcting movements in progress.\")\n4953:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"BTO:0001011\")\n4954:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"CALOHA:TS-0845\")\n4955:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000121 \"FMA:67969\")\n4956:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28821816\") oboInOwl:hasExactSynonym obo:CL_0000121 \"Purkinje neuron\")\n4957:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.proghi.2004.07.002\") oboInOwl:hasExactSynonym obo:CL_0000121 \"cerebellar Purkinje cell\")\n4958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38168772\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000121 \"PC\")\n4959:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28821816\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000121 \"PN\")\n4960:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17535929\") Annotation(oboInOwl:hasDbXref \"PMID:27215193\") Annotation(oboInOwl:hasDbXref \"PMID:37426070\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1016/j.stem.2023.11.013\") rdfs:comment obo:CL_0000121 \"Neurodegenerative disorders affecting Purkinje cells disrupt motor functions. Some of the neurodegenerative disorders that causes loss and degeration of Purkinje cells are Spinocerebellar ataxias (SCAs) (Josef P Kapfhammer and Etsuko Shimobayashi 2023), Friedreich's ataxia (FRDA) (Kevin C Kemp et al., 2016), Fetal alcohol syndrome (Laurent Servais et al., 2016), Dandy-Walker malformation (Alexander Atamian et al., 2024).\")\n4961:AnnotationAssertion(rdfs:label obo:CL_0000121 \"Purkinje cell\")\n4962:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_0000121 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\n4963:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0000121 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n4964:SubClassOf(obo:CL_0000121 obo:CL_0000540)\n4965:SubClassOf(obo:CL_0000121 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n4966:SubClassOf(obo:CL_0000121 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n4968:# Class: obo:CL_0000122 (stellate neuron)\n4970:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:9780123973481\") obo:IAO_0000115 obo:CL_0000122 \"A neuron that has dendritic processes radiating from the cell body forming a star-like shape.\")\n4971:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000122 \"BTO:0002316\")\n4972:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000122 cl:BDS_subset)\n4973:AnnotationAssertion(rdfs:label obo:CL_0000122 \"stellate neuron\")\n4974:EquivalentClasses(obo:CL_0000122 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070010)))\n4975:SubClassOf(obo:CL_0000122 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n4977:# Class: obo:CL_0000123 (neuron associated cell (sensu Vertebrata))\n4979:AnnotationAssertion(rdfs:label obo:CL_0000123 \"neuron associated cell (sensu Vertebrata)\")\n4980:SubClassOf(obo:CL_0000123 obo:CL_0000095)\n4981:SubClassOf(obo:CL_0000123 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n4983:# Class: obo:CL_0000124 (obsolete glial cell (sensu Nematoda and Protostomia))\n4985:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000124 <https://github.com/obophenotype/cell-ontology/issues/715>)\n4986:AnnotationAssertion(rdfs:comment obo:CL_0000124 \"This is a grouping class that is no longer needed or wanted.\")\n4987:AnnotationAssertion(rdfs:label obo:CL_0000124 \"obsolete glial cell (sensu Nematoda and Protostomia)\")\n4988:AnnotationAssertion(owl:deprecated obo:CL_0000124 \"true\"^^xsd:boolean)\n4990:# Class: obo:CL_0000125 (glial cell)\n4992:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009457\") obo:IAO_0000115 obo:CL_0000125 \"A non-neuronal cell of the nervous system. They not only provide physical support, but also respond to injury, regulate the ionic and chemical composition of the extracellular milieu. Guide neuronal migration during development, and exchange metabolites with neurons.\")\n4993:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000125 \"BTO:0002606\")\n4994:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000125 \"CALOHA:TS-0415\")\n4995:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000125 \"FMA:54536\")\n4996:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000125 \"neuroglial cell\")\n4997:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000125 \"neuroglia\")\n4998:AnnotationAssertion(rdfs:comment obo:CL_0000125 \"Not all glial cells develop from glioblasts, with microglia developing from the mesoderm instead. See https://github.com/obophenotype/cell-ontology/issues/1571\")\n4999:AnnotationAssertion(rdfs:label obo:CL_0000125 \"glial cell\")\n5000:SubClassOf(obo:CL_0000125 obo:CL_0000095)\n5002:# Class: obo:CL_0000126 (macroglial cell)\n5004:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000126 \"A neuroglial cell of ectodermal origin, i.e., the astrocytes and oligodendrocytes considered together.\")\n5005:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000126 \"BTO:0000771\")\n5006:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000126 \"CALOHA:TS-2027\")\n5007:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000126 \"FMA:54538\")\n5008:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000126 \"macrogliocyte\")\n5009:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1152/physrev.2001.81.2.871\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000126 \"macroglia\")\n5010:AnnotationAssertion(rdfs:label obo:CL_0000126 \"macroglial cell\")\n5011:SubClassOf(obo:CL_0000126 obo:CL_0000125)\n5012:SubClassOf(obo:CL_0000126 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000339))\n5014:# Class: obo:CL_0000127 (astrocyte)\n5016:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D001253\") Annotation(oboInOwl:hasDbXref \"PMID:11746784\") Annotation(oboInOwl:hasDbXref \"PMID:12162730\") Annotation(oboInOwl:hasDbXref \"PMID:12898703\") Annotation(oboInOwl:hasDbXref \"PMID:20942978\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Astrocyte\") obo:IAO_0000115 obo:CL_0000127 \"A class of large neuroglial (macroglial) cells in the central nervous system - the largest and most numerous neuroglial cells in the brain and spinal cord. Astrocytes (from 'star' cells) are irregularly shaped with many long processes, including those with 'end feet' which form the glial (limiting) membrane and directly and indirectly contribute to the blood-brain barrier. They regulate the extracellular ionic and chemical environment, and 'reactive astrocytes' (along with microglia) respond to injury.\")\n5017:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000127 \"BTO:0000099\")\n5018:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000127 \"CALOHA:TS-0060\")\n5019:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000127 \"FMA:54537\")\n5020:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000127 \"astrocytic glia\")\n5021:AnnotationAssertion(rdfs:comment obo:CL_0000127 \"Astrocytes are reportedly CD68-negative, CD121a-positive, CD184-positive, CD192-positive, CRF-positive, EGFR-positive, GFAP-positive, GLUT1-positive, MBP-negative, and NGFR-positive.\")\n5022:AnnotationAssertion(rdfs:label obo:CL_0000127 \"astrocyte\")\n5023:SubClassOf(obo:CL_0000127 obo:CL_0000126)\n5025:# Class: obo:CL_0000128 (oligodendrocyte)\n5027:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009836\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Oligodendrocyte\") obo:IAO_0000115 obo:CL_0000128 \"A class of large neuroglial (macroglial) cells in the central nervous system. Form the insulating myelin sheath of axons in the central nervous system.\")\n5028:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000128 \"BTO:0000962\")\n5029:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000128 \"CALOHA:TS-0709\")\n5030:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000128 \"FMA:54540\")\n5031:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:8734446\") oboInOwl:hasExactSynonym obo:CL_0000128 \"OLs\")\n5032:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000128 \"oligodendroglia\")\n5033:AnnotationAssertion(rdfs:comment obo:CL_0000128 \"Oligodendrocytes are reportedly MDP-positive and CD4-negative.\")\n5034:AnnotationAssertion(rdfs:label obo:CL_0000128 \"oligodendrocyte\")\n5035:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000128 obo:CL_0000126)\n5036:SubClassOf(obo:CL_0000128 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n5037:SubClassOf(obo:CL_0000128 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n5038:SubClassOf(obo:CL_0000128 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002453))\n5040:# Class: obo:CL_0000129 (microglial cell)\n5042:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D017628\") Annotation(oboInOwl:hasDbXref \"PMID:11517395\") Annotation(oboInOwl:hasDbXref \"PMID:12430718\") Annotation(oboInOwl:hasDbXref \"PMID:14561199\") Annotation(oboInOwl:hasDbXref \"PMID:14612429\") Annotation(oboInOwl:hasDbXref \"PMID:16177057\") Annotation(oboInOwl:hasDbXref \"PMID:19461673\") Annotation(oboInOwl:hasDbXref \"PMID:2089275\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Microglia\") obo:IAO_0000115 obo:CL_0000129 \"A transcriptomically distinct central nervous system macrophage found in the parenchyma of the central nervous system. Marker include CD11b-positive, F4/80-positive, and CD68-positive.\")\n5043:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000129 \"brain macrophage\")\n5044:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000129 \"BTO:0000078\")\n5045:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000129 \"BTO:0000962\")\n5046:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000129 \"FMA:54539\")\n5047:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000129 \"brain-resident macrophage\")\n5048:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de/\") oboInOwl:hasExactSynonym obo:CL_0000129 \"hortega cells\")\n5049:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de/\") oboInOwl:hasExactSynonym obo:CL_0000129 \"microgliocyte\")\n5050:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000129 \"MF.microglia.CNS\")\n5051:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000129 \"microglia\")\n5052:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23616747\") rdfs:comment obo:CL_0000129 \"Unlike macroglial cells, microglial cells  arise from hematopoietic stem cells in the yolk sac during early embryogenesis that populate the central nervous system. They derive from embryonic mesoderm and are not from neuroectoderm where glioblast develops from. Markers: Mouse: CD11b+, F4/80+, CD68+. They represent ~12% of the cells in the CNS, but they are not uniformly distributed within the CNS. A normal adult mouse brain has approximately 3.5x10e6 microglia. Microglia are also reportedly CD3-negative, CD4-positive, CD8-negative, CD11b-positive, CD11c-high, CD14-negative, CD19-negative, CD45-low, CD56-negative, CD163-negative, CD200R-positive, CD281-positive, CD282-positive, CD283-positive, CD284-positive, CD285-positive, CD286-positive, CD287-positive, CD288-positive, CD289-positive, Gr1-negative, nestin-positive, and PU.1-positive.\")\n5053:AnnotationAssertion(rdfs:label obo:CL_0000129 \"microglial cell\")\n5054:EquivalentClasses(obo:CL_0000129 ObjectIntersectionOf(obo:CL_0000125 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001012) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001813) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002064) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045087)))\n5055:SubClassOf(obo:CL_0000129 obo:CL_0000878)\n5056:SubClassOf(obo:CL_0000129 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000222))\n5057:SubClassOf(obo:CL_0000129 ObjectSomeValuesFrom(obo:RO_0002202 ObjectIntersectionOf(obo:CL_0000034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001040))))\n5059:# Class: obo:CL_0000130 (neuron associated cell (sensu Nematoda and Protostomia))\n5061:AnnotationAssertion(rdfs:label obo:CL_0000130 \"neuron associated cell (sensu Nematoda and Protostomia)\")\n5062:SubClassOf(obo:CL_0000130 obo:CL_0000095)\n5063:SubClassOf(obo:CL_0000130 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33317))\n5065:# Class: obo:CL_0000131 (gut endothelial cell)\n5067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26564856\") obo:IAO_0000115 obo:CL_0000131 \"An endothelial cell that lines the blood and lymphatic vessels of the digestive tract. This cell forms the gut–vascular barrier (GVB) through tight junctions and crosstalk with pericytes and enteric glial cells, regulating the passage of nutrients and immune cells while restricting microbial translocation into the bloodstream.\")\n5068:AnnotationAssertion(rdfs:label obo:CL_0000131 \"gut endothelial cell\")\n5069:EquivalentClasses(obo:CL_0000131 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001555)))\n5070:SubClassOf(obo:CL_0000131 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000223))\n5072:# Class: obo:CL_0000132 (corneal endothelial cell)\n5074:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:21976958\") Annotation(oboInOwl:hasDbXref \"PMID:23284695\") Annotation(oboInOwl:hasDbXref \"PMID:34741068\") Annotation(oboInOwl:hasDbXref \"PMID:36769303\") obo:IAO_0000115 obo:CL_0000132 \"An hexagonal, flattened, mitochondria-rich endothelial cell that forms a monolayer on the posterior surface of the cornea (the corneal endothelium). Corneal endothelial cells are derived from the neural crest and are responsible for keeping the cornea transparent by maintaining the tissue in a semi-dry state through the action of their ionic pumps and tight junction barrier.\")\n5075:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000132 \"CALOHA:TS-0172\")\n5076:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000132 \"FMA:70614\")\n5077:AnnotationAssertion(rdfs:label obo:CL_0000132 \"corneal endothelial cell\")\n5078:SubClassOf(obo:CL_0000132 obo:CL_0000115)\n5079:SubClassOf(obo:CL_0000132 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001985))\n5080:SubClassOf(obo:CL_0000132 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000008))\n5082:# Class: obo:CL_0000133 (neurectodermal cell)\n5084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0000133 \"Ectoderm destined to be nervous tissue.\")\n5085:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000133 \"neurectoderm cell\")\n5086:AnnotationAssertion(rdfs:label obo:CL_0000133 \"neurectodermal cell\")\n5087:SubClassOf(obo:CL_0000133 obo:CL_0000221)\n5089:# Class: obo:CL_0000134 (mesenchymal stem cell)\n5091:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2613570\") Annotation(oboInOwl:hasDbXref \"PMID:10102814\") Annotation(oboInOwl:hasDbXref \"PMID:16923606\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:19960544\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Mesenchymal_stem_cell\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de/cope.cgi?key=mesenchymal%20stem%20cells\") obo:IAO_0000115 obo:CL_0000134 \"A connective tissue cell that normally gives rise to other cells that are organized as three-dimensional masses. In humans, this cell type is CD73-positive, CD90-positive, CD105-positive, CD45-negative, CD34-negative, and MHCII-negative. They may further differentiate into osteoblasts, adipocytes, myocytes, neurons, or chondroblasts in vitro. Originally described as residing in the bone marrow, this cell type is now known to reside in many, if not all, adult organs.\")\n5092:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"BTO:0002625\")\n5093:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"BTO:0003298\")\n5094:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"FMA:70546\")\n5095:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"bone marrow stromal cells\")\n5096:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5097:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11378515\") oboInOwl:hasNarrowSynonym obo:CL_0000134 \"marrow stromal cells\")\n5098:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"BMSC\")\n5099:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"CFU-F\")\n5100:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11378515\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"MSC\")\n5101:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal precursor cell\")\n5102:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D044982\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal progenitor cells\")\n5103:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stem cell\")\n5104:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stromal cell\")\n5105:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stromal cells\")\n5106:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D044982\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"stem cells, mesenchymal\")\n5107:AnnotationAssertion(rdfs:comment obo:CL_0000134 \"Many but not all mesenchymal cells derive from the mesoderm. MSCs are reportedly CD3-negative, CD4-negative, CD5-negative, CD8-negative, CD11a-negative, CD11b-negative, CD14-negative, CD19-negative, CD29-positive, CD31-negative, CD34-negative, CD38-negative, CD40-negative, CD44-positive, CD45-negative, CD49-positive, CD54-positive, CD66b-negative, CD79a-negative, CD80-negative, CD102-positive, CD106-positive, CD117-positive, CD121a-positive, CD121b-positive, CD123-positive, CD124-positive, CD133-negative, CD146-positive, CD166-positive, CD271-positive, B220-negative, Gr1-negative, MHCI-positive, MHCII-negative, SSEA4-negative, sca1-positive, Ter119-negative, and glycophorin A-negative. Cultured MSCs are capable of producing stem cell factor, IL7, IL8, IL11, TGF-beta, cofilin, galectin-1, laminin-receptor 1, cyclophilin A, and MMP-2.\")\n5108:AnnotationAssertion(rdfs:label obo:CL_0000134 \"mesenchymal stem cell\")\n5109:AnnotationAssertion(rdfs:seeAlso obo:CL_0000134 \"https://github.com/obophenotype/cell-ontology/issues/474\")\n5110:SubClassOf(obo:CL_0000134 obo:CL_0000048)\n5111:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000134 obo:CL_0002320)\n5113:# Class: obo:CL_0000135 (circulating fibrocyte)\n5115:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20303382\") Annotation(oboInOwl:hasDbXref \"PMID:20305780\") Annotation(oboInOwl:hasDbXref \"PMID:29286323\") Annotation(oboInOwl:hasDbXref \"PMID:31473260\") Annotation(oboInOwl:hasDbXref \"PMID:32084275\") Annotation(oboInOwl:hasDbXref \"PMID:9177213\") Annotation(oboInOwl:hasDbXref \"doi:/10.1186/1755-1536-5-S1-S6\") obo:IAO_0000115 obo:CL_0000135 \"A bone marrow-derived cell that predominantly develops from myeloid lineage-restricted progenitor cells and circulates in peripheral blood, characterized by co-expression of hematopoietic markers CD45 and CD34 along with stromal markers including collagen type I in both humans and mice (Chesney et al., 1997; Blakaj and Bucala, 2012). This spindle-shaped cell exhibits a unique dual identity, functionally bridging immune and stromal compartments with characteristics of both monocytes and fibroblasts. Predominantly arising from circulating monocytes, it migrates to injury sites via chemokine receptors and participates in wound repair through extracellular matrix deposition, cytokine secretion, and antigen presentation via MHC class II. As mesenchymal progenitors, fibrocytes can differentiate into fibroblasts, myofibroblasts, and adipocytes, contributing to both physiological repair and pathological fibrosis (Blakaj and Bucala, 2012).\")\n5116:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000135 \"FMA:63879\")\n5117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30826294\") oboInOwl:hasNarrowSynonym obo:CL_0000135 \"monocyte-derived fibrocyte\")\n5118:AnnotationAssertion(rdfs:comment obo:CL_0000135 \"Cultured human fibrocytes are MHCI-positive, MHCII-positive, CD1a-negative, CD3-negative, CD4-negative, CD8-negative, CD10-negative, CD11b-positive, CD13-positive, CD14-negative, CD16-negative, CD18-positive, CD19-negative, CD25-negative, CD29-positive, CD32-positive, CD33-negative, CD34-positive, CD38-negative, CD40-positive, CD44-negative, CD45RO-positive, CD49a-positive, CD49b-positive, CD49c-negative, CD49d-negative, CD49e-positive, CD49f-negative, CD56-negative, CD58-positive, CD61-positive, CD64-positive, CD70-negative, CD71-positive, CD80-positive, CD83-negative, CD86-positive, CD103-negative, CD105-positive, CD181-positive, CD182-negative, CD183-positive, CD184-positive, CD185-negative, CD186-negative, CD191-positive, CD192-negative, CD193-positive, CD194-positive, CD195-positive, CD196-negative, CD197-positive, CD199-positive, desmin-negative, F4/80-positive, Gr1-positive, LSP-1-positive, MHCI-positive, MHCII-positive, alpha-SMA-negative, TCRab-negative, TCRgd-negative, and vimentin-positive. Fibrocytes are also capable of secreting angiogenin, bFGF, CCL2, CCL3, CCL4, CCL8, CXCL1, type I collagen, type III collagen, CTGF, fibronectin, GM-CSF, IL-1a, IL-6, IL-8, IL-10, M-CSF, MMP-9, PDGF-A, TGF-alpha, TGF-beta1, TNF-alpha, and VEGF-A.\")\n5119:AnnotationAssertion(rdfs:label obo:CL_0000135 \"circulating fibrocyte\")\n5120:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000135 obo:CL_0000499)\n5121:SubClassOf(obo:CL_0000135 obo:CL_0011026)\n5122:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000839))\n5123:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002495))\n5124:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042060))\n5125:SubClassOf(obo:CL_0000135 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045766))\n5127:# Class: obo:CL_0000136 (adipocyte)\n5129:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017667\") obo:IAO_0000115 obo:CL_0000136 \"A fat-storing cell found mostly in the abdominal cavity and subcutaneous tissue of mammals. Fat is usually stored in the form of triglycerides.\")\n5130:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000136 \"BTO:0000443\")\n5131:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000136 \"CALOHA:TS-0012\")\n5132:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000136 \"FMA:63880\")\n5133:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000136 \"adipose cell\")\n5134:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000136 \"fat cell\")\n5135:AnnotationAssertion(rdfs:label obo:CL_0000136 \"adipocyte\")\n5136:SubClassOf(obo:CL_0000136 obo:CL_0000325)\n5137:SubClassOf(obo:CL_0000136 obo:CL_0002320)\n5138:SubClassOf(obo:CL_0000136 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000134))\n5140:# Class: obo:CL_0000137 (osteocyte)\n5142:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D010011\") obo:IAO_0000115 obo:CL_0000137 \"A mature osteoblast that has become embedded in the bone matrix. They occupy a small cavity, called lacuna, in the matrix and are connected to adjacent osteocytes via protoplasmic projections called canaliculi.\")\n5143:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000137 \"bone cell\")\n5144:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000137 \"BTO:0002038\")\n5145:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000137 \"CALOHA:TS-1167\")\n5146:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000137 \"FMA:66779\")\n5147:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000137 \"VSAO:0000124\")\n5148:AnnotationAssertion(rdfs:comment obo:CL_0000137 \"VSAO relationship simplified OBO_REL:integral_part_of VSAO:0000118\")\n5149:AnnotationAssertion(rdfs:label obo:CL_0000137 \"osteocyte\")\n5150:SubClassOf(obo:CL_0000137 obo:CL_0001035)\n5151:SubClassOf(obo:CL_0000137 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002481))\n5152:SubClassOf(obo:CL_0000137 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0001040))\n5154:# Class: obo:CL_0000138 (chondrocyte)\n5156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") Annotation(oboInOwl:hasDbXref \"MESH:D019902\") Annotation(oboInOwl:hasDbXref \"PMID:32491508\") obo:IAO_0000115 obo:CL_0000138 \"A skeletogenic cell that secretes a specialized, avascular, GAG-rich matrix, is embedded in cartilage tissue matrix, retains the ability to divide, and develops from a chondroblast cell.\")\n5157:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000138 \"BTO:0000249\")\n5158:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000138 \"CAL