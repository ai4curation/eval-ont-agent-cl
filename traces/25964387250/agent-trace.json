wn adipose cell\")\n7601:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000449 \"brown fat cell\")\n7602:AnnotationAssertion(rdfs:label obo:CL_0000449 \"brown adipocyte\")\n7603:SubClassOf(obo:CL_0000449 obo:CL_0000136)\n7604:SubClassOf(obo:CL_0000449 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001348))\n7605:SubClassOf(obo:CL_0000449 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002335))\n7607:# Class: obo:CL_0000450 (obo:CL_0000450)\n7609:AnnotationAssertion(obo:IAO_0000231 obo:CL_0000450 obo:IAO_0000227)\n7610:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000450 obo:CL_0000136)\n7611:AnnotationAssertion(owl:deprecated obo:CL_0000450 \"true\"^^xsd:boolean)\n7613:# Class: obo:CL_0000451 (dendritic cell)\n7615:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000451 \"A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative).\")\n7616:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"BTO:0002042\")\n7617:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"CALOHA:TS-0194\")\n7618:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"FMA:83036\")\n7619:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000451 \"MESH:D003713\")\n7620:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000451 \"interdigitating cell\")\n7621:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000451 \"veiled cell\")\n7622:AnnotationAssertion(rdfs:label obo:CL_0000451 \"dendritic cell\")\n7623:EquivalentClasses(obo:CL_0000451 ObjectIntersectionOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0042613) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001002) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001003) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001020) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001024) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001289) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001407) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002504) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0019882) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045580)))\n7624:SubClassOf(obo:CL_0000451 obo:CL_0000113)\n7625:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000451 obo:CL_0000738)\n7626:DisjointClasses(obo:CL_0000451 obo:CL_0000542)\n7628:# Class: obo:CL_0000452 (obsolete thyroid hormone secreting cell)\n7630:AnnotationAssertion(obo:IAO_0000233 obo:CL_0000452 <https://github.com/obophenotype/cell-ontology/issues/3161>)\n7631:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000452 obo:CL_0002258)\n7632:AnnotationAssertion(rdfs:comment obo:CL_0000452 \"This term is redundant and has been merged with thyroid follicular cell\")\n7633:AnnotationAssertion(rdfs:label obo:CL_0000452 \"obsolete thyroid hormone secreting cell\")\n7634:AnnotationAssertion(owl:deprecated obo:CL_0000452 \"true\"^^xsd:boolean)\n7636:# Class: obo:CL_0000453 (Langerhans cell)\n7638:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2346585\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") obo:IAO_0000115 obo:CL_0000453 \"Langerhans cell is a conventional dendritic cell that has plasma membrane part CD207. A Langerhans cell is a stellate dendritic cell of myeloid origin, that appears clear on light microscopy and has a dark-staining, indented nucleus and characteristic inclusions (Birbeck granules) in the cytoplasm; Langerhans cells are found principally in the stratum spinosum of the epidermis, but they also occur in other stratified epithelia and have been identified in the lung, lymph nodes, spleen, and thymus.\")\n7639:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"BTO:0000705\")\n7640:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"CALOHA:TS-2375\")\n7641:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"FMA:63072\")\n7642:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000453 \"MESH:D007801\")\n7643:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000453 \"LC\")\n7644:AnnotationAssertion(rdfs:comment obo:CL_0000453 \"Originally described in the dendritic cell ontology (DC_CL:0000021 )(PMID:19243617). These cells are also CD1a-high, CD14-negative, CD207-positive (langerin), CD324-positive (E-cadherin), and DCIR-positive. They reside in the epidermis.\")\n7645:AnnotationAssertion(rdfs:label obo:CL_0000453 \"Langerhans cell\")\n7646:EquivalentClasses(obo:CL_0000453 ObjectIntersectionOf(obo:CL_0000990 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001293) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002828)))\n7647:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000453 obo:CL_0000990)\n7648:SubClassOf(obo:CL_0000453 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000763))\n7650:# Class: obo:CL_0000454 (epinephrine secreting cell)\n7652:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12438093\") obo:IAO_0000115 obo:CL_0000454 \"A cell capable of producing epinephrine. Epiniphrine is synthesized from norepiniphrine by the actions of the phenylethanolamine N-methyltransferase enzyme, which is expressed in the adrenal glands, androgenic neurons, and in other cell types.\")\n7653:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0048242\") oboInOwl:hasExactSynonym obo:CL_0000454 \"adrenaline secreting cell\")\n7654:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000454 \"epinephrin secreting cell\")\n7655:AnnotationAssertion(rdfs:label obo:CL_0000454 \"epinephrine secreting cell\")\n7656:EquivalentClasses(obo:CL_0000454 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0048242)))\n7657:SubClassOf(obo:CL_0000454 obo:CL_0000457)\n7659:# Class: obo:CL_0000455 (obsolete starch sheath cell)\n7661:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:044174520\") obo:IAO_0000115 obo:CL_0000455 \"Obsolete. Use PO:0004531 from Plant Ontology instead. A cell characterized by conspicuous and rather stable accumulation of starch.\")\n7662:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000455 obo:PO_0004531)\n7663:AnnotationAssertion(rdfs:label obo:CL_0000455 \"obsolete starch sheath cell\")\n7664:AnnotationAssertion(owl:deprecated obo:CL_0000455 \"true\"^^xsd:boolean)\n7666:# Class: obo:CL_0000456 (mineralocorticoid secreting cell)\n7668:AnnotationAssertion(rdfs:label obo:CL_0000456 \"mineralocorticoid secreting cell\")\n7669:EquivalentClasses(obo:CL_0000456 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0035931)))\n7671:# Class: obo:CL_0000457 (biogenic amine secreting cell)\n7673:AnnotationAssertion(rdfs:label obo:CL_0000457 \"biogenic amine secreting cell\")\n7674:SubClassOf(obo:CL_0000457 obo:CL_0000151)\n7676:# Class: obo:CL_0000458 (serotonin secreting cell)\n7678:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19630576\") obo:IAO_0000115 obo:CL_0000458 \"A cell type that secretes 5-Hydroxytryptamine (serotonin).\")\n7679:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000458 \"5-HT secreting cell\")\n7680:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000458 \"5-Hydroxytryptamine secreting cell\")\n7681:AnnotationAssertion(rdfs:label obo:CL_0000458 \"serotonin secreting cell\")\n7682:EquivalentClasses(obo:CL_0000458 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001820)))\n7683:SubClassOf(obo:CL_0000458 obo:CL_0000457)\n7685:# Class: obo:CL_0000459 (noradrenergic cell)\n7687:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0000459 \"A cell capable of producting norepiniphrine. Norepiniphrine is a catecholamine with multiple roles including as a hormone and a neurotransmitter. In addition, epiniphrine is synthesized from norepiniphrine by the actions of the phenylethanolamine N-methyltransferase enzyme.\")\n7688:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"noradrenaline secreting cell\")\n7689:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"norepinephrin secreting cell\")\n7690:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000459 \"norepinephrine secreting cell\")\n7691:AnnotationAssertion(rdfs:label obo:CL_0000459 \"noradrenergic cell\")\n7692:EquivalentClasses(obo:CL_0000459 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0048243)))\n7693:SubClassOf(obo:CL_0000459 obo:CL_0000457)\n7695:# Class: obo:CL_0000460 (glucocorticoid secreting cell)\n7697:AnnotationAssertion(rdfs:label obo:CL_0000460 \"glucocorticoid secreting cell\")\n7698:EquivalentClasses(obo:CL_0000460 ObjectIntersectionOf(obo:CL_0000151 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0035933)))\n7700:# Class: obo:CL_0000461 (obo:CL_0000461)\n7702:AnnotationAssertion(obo:IAO_0000231 obo:CL_0000461 obo:IAO_0000227)\n7703:AnnotationAssertion(obo:IAO_0100001 obo:CL_0000461 obo:CL_0000648)\n7704:AnnotationAssertion(owl:deprecated obo:CL_0000461 \"true\"^^xsd:boolean)\n7706:# Class: obo:CL_0000462 (adepithelial cell)\n7708:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/S0925-4773(97)00654-0\") obo:IAO_0000115 obo:CL_0000462 \"A cell of mesodermal origin that is closely associated with the epithelium of an imaginal disc. It is a precursor of some of the insect's adult muscles.\")\n7709:AnnotationAssertion(rdfs:label obo:CL_0000462 \"adepithelial cell\")\n7710:SubClassOf(obo:CL_0000462 obo:CL_0000680)\n7711:SubClassOf(obo:CL_0000462 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7713:# Class: obo:CL_0000463 (epidermal cell (sensu Arthropoda))\n7715:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FlyBase:ds\") Annotation(oboInOwl:hasDbXref \"ISBN:ISBN:978-0801481253\") obo:IAO_0000115 obo:CL_0000463 \"An epidermal cell that secretes chitinous cuticle from its apical side.\")\n7716:AnnotationAssertion(rdfs:comment obo:CL_0000463 \"While insect epidermis is generally columnar/cuboidal, there are certainly well studied cases where it is not (e.g.- Rhodnius prolixus when starved). So it would be safer to add this as a differentium for particular species where this is known. -DSJ.\")\n7717:AnnotationAssertion(rdfs:label obo:CL_0000463 \"epidermal cell (sensu Arthropoda)\")\n7718:SubClassOf(obo:CL_0000463 obo:CL_0000362)\n7719:SubClassOf(obo:CL_0000463 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7720:SubClassOf(obo:CL_0000463 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000464))\n7722:# Class: obo:CL_0000464 (epidermoblast)\n7724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:7576311\") obo:IAO_0000115 obo:CL_0000464 \"An epidermal progenitor cell that arises from neuroectoderm and in turn gives rise to the epidermal sheath of ventral and cephalic regions.\")\n7725:AnnotationAssertion(rdfs:label obo:CL_0000464 \"epidermoblast\")\n7726:SubClassOf(obo:CL_0000464 obo:CL_0000710)\n7727:SubClassOf(obo:CL_0000464 obo:CL_0011026)\n7728:SubClassOf(obo:CL_0000464 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000114))\n7730:# Class: obo:CL_0000465 (cardioblast (sensu Arthropoda))\n7732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/BF00360522\") obo:IAO_0000115 obo:CL_0000465 \"A precursor of the cells that form the dorsal vessel of arthropods.\")\n7733:AnnotationAssertion(rdfs:label obo:CL_0000465 \"cardioblast (sensu Arthropoda)\")\n7734:SubClassOf(obo:CL_0000465 obo:CL_0010021)\n7735