hils are CD15-positive, CD16-positive, CD32-positive, CD43-positive, CD181-positive, and CD182-positive.\")\n4706:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000096 \"poly\")\n4707:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000096 \"polymorphonuclear leucocyte\")\n4708:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000096 \"polymorphonuclear leukocyte\")\n4709:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000096 \"BTO:0003473\")\n4710:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"PMN\")\n4711:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"mature neutrocyte\")\n4712:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"mature neutrophil leucocyte\")\n4713:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"mature neutrophil leukocyte\")\n4714:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"mature neutrophilic leucocyte\")\n4715:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"mature neutrophilic leukocyte\")\n4716:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"polymorphonuclear neutrophil\")\n4717:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"polynuclear neutrophilic leucocyte\")\n4718:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000096 \"polynuclear neutrophilic leukocyte\")\n4719:AnnotationAssertion(rdfs:comment obo:CL_0000096 \"Neutrophils are also capable of secreting GRO-alpha, IL-1beta, IL-1ra, IL-3, IL-12, IP-10, MIG, MIP-1alpha, MIP-1beta, TGF-beta, TNF-alpha, VEGF, and anti-microbial peptides. They can positively influence the chemotaxis of basophils, T-cells, monocytes, macrophages, dendritic cells, and other neutrophils. Neutrophils are also CD35-positive, CD64-positive, CD89-positive, CD184-positive, and fMLP receptor-positive Ly-6G-positive (mouse), TLR2-low, TLR4-low, and lineage-negative (CD2, CD3, CD5, CD9, CD19, CD36, CD49d, CD56, CD61, CD235a (glycophorin-A)).\")\n4720:AnnotationAssertion(rdfs:label obo:CL_0000096 \"mature neutrophil\")\n4721:EquivalentClasses(obo:CL_0000096 ObjectIntersectionOf(obo:CL_0000775 ObjectSomeValuesFrom(obo:BFO_0000051 obo:CL_0017500) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0070820) ObjectSomeValuesFrom(obo:BFO_0000051 ObjectIntersectionOf(obo:GO_0005634 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001979))) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000009978) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000010543) ObjectSomeValuesFrom(obo:CL_4030045 obo:PR_000010799) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001256) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001257) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001456) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001483) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001879) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001944) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000007597) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002536) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002690) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006909) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032637)))\n4722:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000096 obo:CL_0000775)\n4724:# Class: obo:CL_0000097 (mast cell)\n4726:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") Annotation(oboInOwl:hasDbXref \"MESH:D008407\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2855166\") Annotation(oboInOwl:hasDbXref \"PMID:15153310\") Annotation(oboInOwl:hasDbXref \"PMID:16455980\") Annotation(oboInOwl:hasDbXref \"PMID:19671378\") Annotation(oboInOwl:hasDbXref \"PMID:212366338\") Annotation(oboInOwl:hasDbXref \"PMID:9354811\") obo:IAO_0000115 obo:CL_0000097 \"A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation. Progenitors leave bone marrow and mature in connective and mucosal tissue. Mature mast cells are found in all tissues, except the bloodstream. Their phenotype is CD117-high, CD123-negative, CD193-positive, CD200R3-positive, and FceRI-high. Stem-cell factor (KIT-ligand; SCF) is the main controlling signal of their survival and development.\")\n4727:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000097 \"BTO:0000830\")\n4728:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000097 \"CALOHA:TS-0603\")\n4729:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000097 \"FMA:66784\")\n4730:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000097 \"histaminocyte\")\n4731:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000097 \"labrocyte\")\n4732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000097 \"mastocyte\")\n4733:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") oboInOwl:hasRelatedSynonym obo:CL_0000097 \"tissue basophil\")\n4734:AnnotationAssertion(rdfs:comment obo:CL_0000097 \"Mast cells are generally integrin beta-7-negative and positive for TLR2, TLR3, TLR4, TLR5, TLR7, TLR9, C3aR, C5aR, CR3, CR4, VEGF, FGF2, and renin. They can express MHC Class I and II on their surface. Activated murine mast cells (IgE+Antigen) were capable of expressing the following co-stimulatory molecules: CD95 (Fas), CD120b, CD137 (4-1BB), CD153 (CD30L), CD154 (CD40L), GITR, ICOSL, OX40L, PD-L1, and PD-L2. Note that there was some mouse strain variation. Mast cells have also been demonstrated to produce bFGF, CCL2, CCL4, CCL5, CCL11, CCL20, CXCL2, CXCL8, CXCL10, GM-CSF, IFN-gamma, IL-1, IL-2, IL-3, IL-8, IL-10, IL-11, IL-12, IL-13, IL-16, IL-25, IL-18, MIP-1, prostaglandin D2, SCF, TGF-beta, TNF-alpha, TSLP, VEGF, and XCL1. They express the transcription factors Transcription factors AP-1, GATA1, MITF, Notch2, PIAS3, PU.1, and STAT5.\")\n4735:AnnotationAssertion(rdfs:label obo:CL_0000097 \"mast cell\")\n4736:EquivalentClasses(obo:CL_0000097 ObjectIntersectionOf(obo:CL_0000766 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030141) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001865) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001255) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000006169) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002349) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002539) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002660) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002690) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002830) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030210) ObjectSomeValuesFrom(obo:RO_0015015 obo:PR_000002065) ObjectSomeValuesFrom(obo:RO_0015015 obo:PR_000007431)))\n4737:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000097 obo:CL_0000766)\n4738:SubClassOf(obo:CL_0000097 obo:CL_0002274)\n4739:SubClassOf(obo:CL_0000097 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000831))\n4741:# Class: obo:CL_0000098 (sensory epithelial cell)\n4743:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000098 \"A specialized epithelial cell involved in sensory perception. Restricted to special sense organs of the olfactory, gustatory, and vestibulocochlear receptor systems; contain sensory cells surrounded by supportive, non-receptive cells.\")\n4744:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000098 \"neuroepithelial cell\")\n4745:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000098 \"BTO:0004301\")\n4746:AnnotationAssertion(rdfs:comment obo:CL_0000098 \"The term \\\"neuroepithelial cell\\\" is used to describe both this cell type and neurecto-epithelial cell (CL:0000710).\")\n4747:AnnotationAssertion(rdfs:label obo:CL_0000098 \"sensory epithelial cell\")\n4748:EquivalentClasses(obo:CL_0000098 ObjectIntersectionOf(obo:CL_0000066 Ob