6: AnnotationAssertion(rdfs:label oboInOwl:hasSynonymType \"has_synonym_type\")\n3717: \n3718: # Annotation Property: oboInOwl:inSubset (in_subset)\n3719: \n3720: AnnotationAssertion(rdfs:label oboInOwl:inSubset \"in_subset\")\n3721: \n3722: # Annotation Property: rdfs:seeAlso (see also)\n3723: \n3724: AnnotationAssertion(oboInOwl:hasDbXref rdfs:seeAlso \"http://www.w3.org/2000/01/rdf-schema#seeAlso\")\n3725: AnnotationAssertion(oboInOwl:shorthand rdfs:seeAlso \"seeAlso\")\n3726: AnnotationAssertion(rdfs:label rdfs:seeAlso \"see also\")\n3727: \n3728: \n3729: ############################\n\n(Showing lines 3680-3729 of 35841. Use offset=3730 to continue.)\n</content>","metadata":{"preview":"\n# Annotation Property: ubprop:_upper_level (ubprop:_upper_level)\n\nAnnotationAssertion(rdfs:comment ubprop:_upper_level \"abstract upper-level terms not directly useful for analysis\")\nSubAnnotationPropertyOf(ubprop:_upper_level oboInOwl:SubsetProperty)\n\n# Annotation Property: oboInOwl:SubsetProperty (subset_property)\n\nAnnotationAssertion(rdfs:label oboInOwl:SubsetProperty \"subset_property\")\n\n# Annotation Property: oboInOwl:consider (consider)\n\nAnnotationAssertion(rdfs:label oboInOwl:consider \"consider\")\n\n# Annotation Property: oboInOwl:hasBroadSynonym (has_broad_synonym)\n\nAnnotationAssertion(rdfs:label oboInOwl:hasBroadSynonym \"has_broad_synonym\")\n\n# Annotation Property: oboInOwl:hasDbXref (database_cross_reference)\n","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778543977607,"end":1778543977651}},"id":"prt_e197b58fb0013bTotMi2nDchpH","sessionID":"ses_1e68c71dcffeNqJwmNMee1uYLT","messageID":"msg_e197aefc2001QJENjjkfhcHWir"}}
