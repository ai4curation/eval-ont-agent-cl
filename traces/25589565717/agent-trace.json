nAnnotationAssertion(rdfs:label obo:CL_4072029 \"pvalb GABAergic interneuron (Homo sapiens)\")\nEquivalentClasses(obo:CL_4072029 ObjectIntersectionOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nSubClassOf(obo:CL_4072029 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000080))\n\n# Class: obo:CL_4072031 (sst chodl GABAergic interneuron (Homo sapiens))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072031 \"sst chodl interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072031 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072031 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072031 \"2025-09-04T10:20:07Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4072031 \"long-range GABAergic interneuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072031 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072031 \"The marker set NPY can identify the Human cell type sst chodl GABAergic interneuron in the neocortex with a confidence of 0.894026187 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072031 \"sst chodl GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072031 obo:CL_4023121)\nSubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000083))\n\n# Class: obo:CL_4072032 (VIP GABAergic interneuron (Homo sapiens))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072032 \"VIP interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072032 \"A transcriptomically distinct GABAergic neuron that expresses the vasoactive intestinal polypeptide and that has its soma located in the forebrain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Vip.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072032 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072032 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072032 \"2025-09-04T10:52:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:31210267\") Annotation(oboInOwl:hasDbXref \"PMID:33794534\") Annotation(oboInOwl:hasDbXref \"PMID:35221922\") terms:description obo:CL_4072032 \"This neuronal type is distinguished by its heterogeneous morphology and electrophysiological characteristics  (Pronneke et al., 2015,2020; Apicella and Marchionni, 2022). Variations in morphology and firing patterns are observed in human VIP interneurons. In a study by Lee et al., 2023, four distinct subtypes of VIP neurons were identified, each exhibiting unique morphologies, soma locations, and electrophysiological properties. These subtypes are defined according to their transcriptomic markers: LBH-VIP and CCD184-VIP, both of which display a bipolar morphology with axons and dendrites extending across cortical layers; and SY16-VIP and ADAMTSL1-VIP, characterized by a dendritic arbor that spreads horizontally within the same layer as the soma (Lee et al., 2023). Disruption or malfunction of VIP interneuron is implicated in neurodevelopmental disorders such as Rett Syndrome and Dravet Syndrome (Goff and Goldberg 2021).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072032 \"ILX:0770151\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP type (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP-IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"Vip (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072032 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072032 \"The marker set VIP can identify the Human cell type VIP GABAergic interneuron in the neocortex with a confidence of 0.855531344 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072032 \"VIP GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072032 obo:CL_4023016)\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P01282))\n","exit_code":0,"status":"completed"}}
