{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '32810,32845p' src/ontology/cl-edit.owl\"","aggregated_output":"\n# Class: obo:CL_4033050 (catecholaminergic neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0521442516\") Annotation(oboInOwl:hasDbXref \"PMID:12094209\") obo:IAO_0000115 obo:CL_4033050 \"A neuron that releases catecholamine as a neurotransmitter.\")\nAnnotationAssertion(terms:contributor obo:CL_4033050 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033050 \"2023-05-18T12:07:45Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10191060\") Annotation(oboInOwl:hasDbXref \"PMID:12128258\") Annotation(oboInOwl:hasDbXref \"PMID:34880760\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-2244-7917\") rdfs:comment obo:CL_4033050 \"Frequently used when describing the developing nervous system in zebrafish. A catecholaminergic neuron expresses tyrosine hydroxylase (TH), tyrosine hydroxylase 2 (TH2), aromatic amino acid decarboxylase (AADC), dopamine b-hydroxylase (DBH), and phenylethanolamine-N-methyl transferase (PEMT), which are enzymes necessary for catecholamine synthesis.\")\nAnnotationAssertion(rdfs:label obo:CL_4033050 \"catecholaminergic neuron\")\nEquivalentClasses(obo:CL_4033050 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0160043)))\n\n# Class: obo:CL_4033051 (OFF parasol ganglion cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033051 \"A parasol ganglion cell that depolarizes in response to decreased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB3a bipolar cells.\")\nAnnotationAssertion(terms:contributor obo:CL_4033051 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033051 \"2023-08-08T12:34:57Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033051 \"OFF-parasol retinal ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033051 \"outer parasol cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033051 \"OFF parasol ganglion cell\")\nEquivalentClasses(obo:CL_4033051 ObjectIntersectionOf(obo:CL_4023033 obo:CL_4023189))\n\n# Class: obo:CL_4033052 (ON parasol ganglion cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033052 \"A parasol ganglion cell that depolarizes in response to increased light intensity in the center of its receptive field. The majority of input that this cell receives comes from DB4 bipolar cells.\")\nAnnotationAssertion(terms:contributor obo:CL_4033052 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033052 \"2023-08-08T12:39:35Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol RGC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34093409\") oboInOwl:hasExactSynonym obo:CL_4033052 \"ON-parasol retinal ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") oboInOwl:hasExactSynonym obo:CL_4033052 \"inner parasol cell\")\nAnnotationAssertion(rdfs:label obo:CL_4033052 \"ON parasol ganglion cell\")\nEquivalentClasses(obo:CL_4033052 ObjectIntersectionOf(obo:CL_4023032 obo:CL_4023189))\n\n# Class: obo:CL_4033053 (small bistratified retinal ganglion cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033053 \"A bistratfied retinal ganglion cell with a small dendritic field that has dendrites in the ON and OFF sublamina of the retinal inner plexiform layer and carries blue-ON/yellow-OFF signals. This cell receives bipolar and amacrine input to both the OFF and ON dendritic tree.\")\nAnnotationAssertion(terms:contributor obo:CL_4033053 <https://orcid.org/0000-0001-6677-8489>)\n","exit_code":0,"status":"completed"}}
