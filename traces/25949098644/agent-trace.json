{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"rg -n 'CL_99[0-9]{5}|CL_40520[0-9]{2}|CL_4072104|CL_7770006' src/ontology/cl-edit.owl | tail -n 80\"","aggregated_output":"34841:SubClassOf(obo:CL_4052063 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005273))\n34843:# Class: obo:CL_4052064 (nail matrix keratinocyte)\n34845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\n34846:AnnotationAssertion(terms:contributor obo:CL_4052064 <https://orcid.org/0009-0000-8480-9277>)\n34847:AnnotationAssertion(terms:date obo:CL_4052064 \"2025-07-22T15:30:00Z\"^^xsd:dateTime)\n34848:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39044464\") oboInOwl:hasExactSynonym obo:CL_4052064 \"nail matrix epithelial keratinocyte\")\n34849:AnnotationAssertion(rdfs:label obo:CL_4052064 \"nail matrix keratinocyte\")\n34850:EquivalentClasses(obo:CL_4052064 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002283)))\n34852:# Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n34854:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n34855:AnnotationAssertion(terms:contributor obo:CL_4052065 <https://orcid.org/0009-0000-8480-9277>)\n34856:AnnotationAssertion(terms:date obo:CL_4052065 \"2025-08-05T15:24:46Z\"^^xsd:dateTime)\n34857:AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n34858:EquivalentClasses(obo:CL_4052065 ObjectIntersectionOf(obo:CL_0000313 obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013232)))\n34859:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0042588))\n34860:SubClassOf(obo:CL_4052065 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0005983))\n34862:# Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n34864:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n34865:AnnotationAssertion(terms:contributor obo:CL_4052066 <https://orcid.org/0009-0000-8480-9277>)\n34866:AnnotationAssertion(terms:date obo:CL_4052066 \"2025-08-05T15:33:46Z\"^^xsd:dateTime)\n34867:AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n34868:EquivalentClasses(obo:CL_4052066 ObjectIntersectionOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014717)))\n34869:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0098594))\n34870:SubClassOf(obo:CL_4052066 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070254))\n34872:# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n34874:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n34875:AnnotationAssertion(terms:contributor obo:CL_4052067 <https://orcid.org/0009-0000-8480-9277>)\n34876:AnnotationAssertion(terms:date obo:CL_4052067 \"2025-08-06T11:26:37Z\"^^xsd:dateTime)\n34877:AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n34878:SubClassOf(obo:CL_4052067 obo:CL_0000159)\n34879:SubClassOf(obo:CL_4052067 obo:CL_0002623)\n34881:# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n34883:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n34884:AnnotationAssertion(terms:contributor obo:CL_4052069 <https://orcid.org/0009-0000-8480-9277>)\n34885:AnnotationAssertion(terms:date obo:CL_4052069 \"2025-08-08T11:20:00Z\"^^xsd:dateTime)\n34886:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n34887:AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n34888:SubClassOf(obo:CL_4052069 obo:CL_1001596)\n34889:SubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n34891:# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n34893:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n34894:AnnotationAssertion(terms:contributor obo:CL_4052070 <https://orcid.org/0009-0000-8480-9277>)\n34895:AnnotationAssertion(terms:date obo:CL_4052070 \"2025-08-12T16:05:47Z\"^^xsd:dateTime)\n34896:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") oboInOwl:hasExactSynonym obo:CL_4052070 \"unclassified fallopian tube progenitor\")\n34897:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-1 (NCSE2-1 cells)\")\n34898:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35320732\") oboInOwl:hasNarrowSynonym obo:CL_4052070 \"non-ciliated secretory epithelial cell 2-2 (NCSE2-2 cells)\")\n34899:AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n34900:SubClassOf(obo:CL_4052070 obo:CL_0011026)\n34901:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600124))\n34902:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n34904:# Class: obo:CL_4052071 (quiescent fibroblast)\n34906:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\n34907:AnnotationAssertion(terms:contributor obo:CL_4052071 <https://orcid.org/0009-0000-8480-9277>)\n34908:AnnotationAssertion(terms:date obo:CL_4052071 \"2025-08-13T15:42:37Z\"^^xsd:dateTime)\n34909:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\n34910:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\n34911:AnnotationAssertion(rdfs:label obo:CL_4052071 \"quiescent fibroblast\")\n34912:SubClassOf(obo:CL_4052071 obo:CL_0000057)\n35524:# Class: obo:CL_4072104 (fibrochondrocyte)\n35526:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35527:AnnotationAssertion(terms:contributor obo:CL_4072104 <https://orcid.org/0009-0000-8480-9277>)\n35528:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35529:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35530:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\n35531:AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n35532:EquivalentClasses(obo:CL_4072104 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995)))\n35533:SubClassOf(obo:CL_4072104 obo:CL_0002320)\n35534:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0020021))\n35535:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n35536:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003328))\n35537:SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003353))\n35579:# Class: obo:CL_7770006 (beam B cell, human)\n35581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770006 \"A trabecular meshwork cell within the eye's trabecular meshwork. This cell is molecularly distinguished by TMEFF2 expression in humans. A beam B cell is spatially intermingled with beam A cells throughout the uveal and corneoscleral meshwork regions, but demonstrates a tendency to localise closer to the juxtacanalicular tissue.\")\n35582:AnnotationAssertion(terms:contributor obo:CL_7770006 <https://orcid.org/0009-0000-8480-9277>)\n35583:AnnotationAssertion(terms:date obo:CL_7770006 \"2025-09-15T08:48:01Z\"^^xsd:dateTime)\n35584:AnnotationAssertion(rdfs:label obo:CL_7770006 \"beam B cell, human\")\n35585:AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35586:SubClassOf(obo:CL_7770006 obo:CL_0002367)\n35587:SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35588:SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9UIK5))\n","exit_code":0,"status":"completed"}}
