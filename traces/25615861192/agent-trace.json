{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'rg \"CL_4023036|CL_4023083|CL_4072029|CL_407203[0-6]\" src/ontology/cl-edit.owl'","aggregated_output":"Declaration(Class(obo:CL_4023036))\nDeclaration(Class(obo:CL_4023083))\nDeclaration(Class(obo:CL_4072029))\nDeclaration(Class(obo:CL_4072031))\nDeclaration(Class(obo:CL_4072032))\nDeclaration(Class(obo:CL_4072034))\nDeclaration(Class(obo:CL_4072035))\nDeclaration(Class(obo:CL_4072036))\n# Class: obo:CL_4023036 (chandelier pvalb GABAergic cortical interneuron)\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023036 \"chandelier PV interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023036 \"A transcriptomically distinct pvalb GABAergic cortical interneuron that is recognizable by the straight terminal axonal 'cartridges' of vertically oriented strings of synaptic boutons. Chandelier PV cells' boutons target exclusively the axon initial segment (AIS) of pyramidal cells, with a single cell innervating hundreds of pyramidal cells in a clustered manner. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Chandelier.\")\nAnnotationAssertion(terms:contributor obo:CL_4023036 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0107356\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"Chandelier PV\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023036 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") rdfs:comment obo:CL_4023036 \"In mice, Chandelier PV cells have soma found in in upper L2/3, with some in deep L5 and exhibit fast-spiking but lower firing rate compared to basket cells, and have practically absent hyperpolarization sag.\")\nAnnotationAssertion(rdfs:label obo:CL_4023036 \"chandelier pvalb GABAergic cortical interneuron\")\nSubClassOf(obo:CL_4023036 obo:CL_0000099)\nSubClassOf(obo:CL_4023036 obo:CL_4023018)\nSubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070011))\nSubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023036 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n# Class: obo:CL_4023083 (chandelier cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4023083 \"A GABAergic interneuron that selectively innervates the axon initial segment of pyramidal cells. Their local axonal clusters are formed by high-frequency branching at shallow angles, often ramifying around, above or below their somata with a high bouton density. The characteristic terminal portions of the axon form short vertical rows of boutons, resembling the candlesticks and candles of a chandelier. Chandelier cells can be multipolar or bitufted.\")\nAnnotationAssertion(terms:contributor obo:CL_4023083 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:33862423\") oboInOwl:hasBroadSynonym obo:CL_4023083 \"axo-axonic cell\")\nAnnotationAssertion(Annotation(obo:IAO_0000116 \"Interlex cross reference refers specifically to Markram 2015 rat chandelier cell.\") oboInOwl:hasDbXref obo:CL_4023083 \"ILX:0777213\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023083 \"ChC\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023083 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023083 \"chandelier cell\")\nEquivalentClasses(obo:CL_4023083 ObjectIntersectionOf(obo:CL_0011005 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070011)))\n# Class: obo:CL_4072029 (pvalb GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072029 \"pvalb interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072029 \"A transcriptomically distinct GABAergic interneuron with a soma located in a cerebral cortex and it expresses Parvalbumin. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Pvalb.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072029 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072029 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072029 \"2025-08-12T14:31:10Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:cellxgene_subset)\nAnnotationAssertion(rdfs:label obo:CL_4072029 \"pvalb GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072029 obo:CL_4023018)\nSubClassOf(obo:CL_4072029 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072029 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000080))\n# Class: obo:CL_4072031 (sst chodl GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072031 \"sst chodl interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072031 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072031 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072031 \"2025-09-04T10:20:07Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4072031 \"long-range GABAergic interneuron (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072031 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072031 \"The marker set NPY can identify the Human cell type sst chodl GABAergic interneuron in the neocortex with a confidence of 0.894026187 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072031 \"sst chodl GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072031 obo:CL_4023121)\nSubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000083))\n# Class: obo:CL_4072032 (VIP GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072032 \"VIP interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072032 \"A transcriptomically distinct GABAergic neuron that expresses the vasoactive intestinal polypeptide and that has its soma located in the forebrain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Vip.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072032 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072032 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072032 \"2025-09-04T10:52:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:31210267\") Annotation(oboInOwl:hasDbXref \"PMID:33794534\") Annotation(oboInOwl:hasDbXref \"PMID:35221922\") terms:description obo:CL_4072032 \"This neuronal type is distinguished by its heterogeneous morphology and electrophysiological characteristics  (Pronneke et al., 2015,2020; Apicella and Marchionni, 2022). Variations in morphology and firing patterns are observed in human VIP interneurons. In a study by Lee et al., 2023, four distinct subtypes of VIP neurons were identified, each exhibiting unique morphologies, soma locations, and electrophysiological properties. These subtypes are defined according to their transcriptomic markers: LBH-VIP and CCD184-VIP, both of which display a bipolar morphology with axons and dendrites extending across cortical layers; and SY16-VIP and ADAMTSL1-VIP, characterized by a dendritic arbor that spreads horizontally within the same layer as the soma (Lee et al., 2023). Disruption or malfunction of VIP interneuron is implicated in neurodevelopmental disorders such as Rett Syndrome and Dravet Syndrome (Goff and Goldberg 2021).\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072032 \"ILX:0770151\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP type (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP-IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"Vip (Homo sapiens)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072032 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072032 \"The marker set VIP can identify the Human cell type VIP GABAergic interneuron in the neocortex with a confidence of 0.855531344 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072032 \"VIP GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072032 obo:CL_4023016)\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P01282))\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000085))\n# Class: obo:CL_4072034 (lamp5 GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072034 \"Lamp5 interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072034 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Lamp5.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072034 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072034 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072034 \"2025-09-04T14:48:07Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072034 \"ILX:0770149\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072034 cl:BDS_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072034 \"The marker set LINC00298, KIT can identify the Human cell type lamp5 GABAergic interneuron in the neocortex with a confidence of 0.814687838 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072034 \"lamp5 GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072034 obo:CL_4023011)\nSubClassOf(obo:CL_4072034 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072034 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000074))\n# Class: obo:CL_4072035 (sncg GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072035 \"sncg interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072035 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sncg.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072035 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072035 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072035 \"2025-09-05T10:49:37Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072035 \"ILX:0770150\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:BDS_subset)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4072035 cl:cellxgene_subset)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072035 \"The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072035 \"sncg GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072035 obo:CL_4023015)\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_O76070))\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000081))\n# Class: obo:CL_4072036 (PAX6 GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072036 \"Pax6 interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072036 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses the transcript PAX6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters PAX\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072036 obo:NCBITaxon_9606)\nAnnotationAssertion(terms:contributor obo:CL_4072036 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(terms:date obo:CL_4072036 \"2025-09-10T08:47:34Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072036 \"The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072036 \"PAX6 GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072036 obo:CL_4042032)\nSubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000079))\n","exit_code":0,"status":"completed"}}
