tionOf(obo:CL_0000823 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001003) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001024) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001381) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001874) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002065) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22118931\") Annotation(oboInOwl:hasDbXref \"PMID:23959957\") Annotation(oboInOwl:hasDbXref \"PMID:25729351\") Annotation(oboInOwl:hasDbXref \"PMID:26378583\") rdfs:comment obo:CL_0005012 \"While the term 'multi-ciliated epithelial cell' refers to cells with multiple motile cilia, there are exceptions where epithelial cells may have multiple non-motile cilia. Examples include olfactory sensory neurons, which have non-motile cilia for sensory detection, and choroid plexus epithelial cells, which possess multiple non-motile cilia with transient motility during development. Multiciliated cells are essential for human health, and their dysfunction can lead to various diseases known as ciliopathies, such as primary ciliary dyskinesia. This condition affects the respiratory system, brain ventricles, and reproductive system, leading to chronic respiratory infections, hydrocephalus, and infertility\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41593-018-0205-2\") obo:IAO_0000115 obo:CL_0008032 \"A GABAergic interneuron in human cortical layer 1 that has large rosehip-shaped axonal boutons and compact arborization.\")\nSubClassOf(obo:CL_0008032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Betz_cell&oldid=977472330\") obo:IAO_0000115 obo:CL_0008049 \"A giant pyramidal neuron with a soma in layer Vb of the primary motor cortex that sends its axons down the spinal cord via the corticospinal tract, either synapsing directly with alpha motor neurons, or targeting interneurons in the spinal cord. In humans, Betz cells are the largest known in the central nervous system.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009068 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009069 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009070 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009071 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009072 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009073 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009074 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009075 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009076 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009077 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009078 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009079 obo:NCBITaxon_9606)\n# Class: obo:CL_0009081 (specified double negative thymocyte (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_0009081 \"specified double negative thymocyte (Homo sapiens)\")\nSubClassOf(obo:CL_0009081 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_0009082 (committed double negative thymocyte (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_0009082 \"committed double negative thymocyte (Homo sapiens)\")\nSubClassOf(obo:CL_0009082 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_0009083 (rearranging double negative thymocyte (Homo sapiens))\nAnnotationAssertion(rdfs:label obo:CL_0009083 \"rearranging double negative thymocyte (Homo sapiens)\")\nSubClassOf(obo:CL_0009083 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009096 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009102 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009103 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009104 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009105 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009106 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009107 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009108 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009109 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009110 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009111 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009112 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009113 obo:NCBITaxon_9606)\nAnnotationAssertion(obo:RO_0002175 obo:CL_0009114 obo:NCBITaxon_9606)\nSubClassOf(obo:CL_0017009 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023036 \"A transcriptomically distinct pvalb GABAergic cortical interneuron that is recognizable by the straight terminal axonal 'cartridges' of vertically oriented strings of synaptic boutons. Chandelier PV cells' boutons target exclusively the axon initial segment (AIS) of pyramidal cells, with a single cell innervating hundreds of pyramidal cells in a clustered manner. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Chandelier.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023043 \"A transcriptomically distinct near-projecting glutamatergic neuron with a soma found in layer 5/6 of the primary motor cortex. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', cluster L5/6 NP.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4023052 obo:NCBITaxon_9606)\n# Class: obo:CL_4023098 (obsolete L2/3 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023098 \"OBSOLETE An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 2/3 of the human primary motor cortex.\")\nAnnotationAssertion(rdfs:label obo:CL_4023098 \"obsolete L2/3 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023099 (obsolete L5 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023099 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 5 of the human primary motor cortex.\")\nAnnotationAssertion(rdfs:label obo:CL_4023099 \"obsolete L5 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023100 (obsolete L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023100 \"OBSOLETE. An intratelencephalic-projecting glutamatergic neuron with a soma found in layer 6 of the human primary motor cortex.\")\nAnnotationAssertion(rdfs:label obo:CL_4023100 \"obsolete L6 intratelencephalic projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\n# Class: obo:CL_4023101 (obsolete L5/6 near-projecting glutamatergic neuron of the primary motor cortex (Homo sapiens))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023101 \"OBSOLETE. A near-projecting glutamatergic neuron with a soma found in layer 5/6 of the human primary motor cortex.\")\nAnnotationAssertion(rdfs:label obo:CL_4023101 \"obsolete L5/6 near-projecting glutamatergic neuron of the primary motor cortex (Homo sapiens)\")\nSubClassOf(obo:CL_4030026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32127543\") rdfs:comment obo:CL_4030039 \"In humans, a von Economo neuron is restricted to layer 5 of the anterior cingulate, frontoinsular, and medial frontopolar regions of cerebral cortex, while in some other species it is also found in the frontal and occipital poles and may not be restricted to layer 5.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cub.2021.10.015\") rdfs:comment obo:CL_4030050 \"It has been noted in non-human primate species that the D1/D2-hybrid medium spiny neuron (D1/2) cell type shows the same amount of DRD1 expression as nearby D1 medium spiny neurons but far less DRD2 expression compared to nearby D2 medium spiny neurons. In Rhesus macaques, RXFP1 has been noted as a highly specific marker gene for the D1/2 cell type. The D1/2 cell type has also been described as having characteristics similar to a novel medium spiny neuron described in rodents (D1H or eccentric spiny projection neuron). Although an extrastriosomal cell type, the D1/2 cell type had been noted to express many of the genes associated with striosome, suggesting a possible homology to ‘‘exo-patch’’ cells.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cell.2018.07.028\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4030057 \"The term “eccentric” is used in the name eccentric medium spiny neuron (MSN) due to the exhibited transcriptional divergence from canonical spiny projection neurons. It has been noted in at least one study that an eccentric MSN differs in expression from direct and indirect MSNs by 110 genes (more than the 68 that distinguished direct and indirect spiny projection neurons from each other) and expresses many genes that have little expression in the rest of the striatum. It also has been noted in at least one human study that most eccentric MSNs expressed only DRD1, but many in the basal ganglia co-expressed DRD1 and DRD2, suggesting regional specialization of a more broadly distributed cell type.\")\nSubClassOf(obo:CL_4033095 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_4033096 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:20012068\") rdfs:comment obo:CL_4042007 \"This astrocyte extends its branches to several hundred of dendrites to multiple neurons to envelope 100,000 or more synapses. In humans, a protoplasmic astrocyte has an average diameter of 142 µm, and its diameter ranges between 100 and 400 µm. In rodents the average diameter of a protoplasmic astrocites is 56 µm.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042013 \"A transcriptomically distinct lamp5 GABAergic interneuron located in the cerebral cortex that expresses Lamp5 and Lhx6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', Lamp5 Lhx6.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292997\") rdfs:comment obo:CL_4042023 \"According to spatial transcriptomic data in the human striatum, pthlh-expressing interneurons are one of the most abundant population of interneurons in the striatum (Leonardo D. Garma, et al., 2024).\")\nEquivalentClasses(obo:CL_4052051 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nEquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nEquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nEquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\nSubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072027 (sst GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072027 \"sst interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072027 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst). The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Sst.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072027 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SOM+ inhibitory interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SST+ IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"somatostatin-expressing inhibitory interneuron (Homo sapiens)\")\nAnnotationAssertion(rdfs:label obo:CL_4072027 \"sst GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072029 (pvalb GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072029 \"pvalb interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072029 \"A transcriptomically distinct GABAergic interneuron with a soma located in a cerebral cortex and it expresses Parvalbumin. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Pvalb.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072029 obo:NCBITaxon_9606)\nAnnotationAssertion(rdfs:label obo:CL_4072029 \"pvalb GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072029 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072031 (sst chodl GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072031 \"sst chodl interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072031 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4072031 \"long-range GABAergic interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072031 \"The marker set NPY can identify the Human cell type sst chodl GABAergic interneuron in the neocortex with a confidence of 0.894026187 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072031 \"sst chodl GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072032 (VIP GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072032 \"VIP interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072032 \"A transcriptomically distinct GABAergic neuron that expresses the vasoactive intestinal polypeptide and that has its soma located in the forebrain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Vip.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072032 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:31210267\") Annotation(oboInOwl:hasDbXref \"PMID:33794534\") Annotation(oboInOwl:hasDbXref \"PMID:35221922\") terms:description obo:CL_4072032 \"This neuronal type is distinguished by its heterogeneous morphology and electrophysiological characteristics  (Pronneke et al., 2015,2020; Apicella and Marchionni, 2022). Variations in morphology and firing patterns are observed in human VIP interneurons. In a study by Lee et al., 2023, four distinct subtypes of VIP neurons were identified, each exhibiting unique morphologies, soma locations, and electrophysiological properties. These subtypes are defined according to their transcriptomic markers: LBH-VIP and CCD184-VIP, both of which display a bipolar morphology with axons and dendrites extending across cortical layers; and SY16-VIP and ADAMTSL1-VIP, characterized by a dendritic arbor that spreads horizontally within the same layer as the soma (Lee et al., 2023). Disruption or malfunction of VIP interneuron is implicated in neurodevelopmental disorders such as Rett Syndrome and Dravet Syndrome (Goff and Goldberg 2021).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP type (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP-IN (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"Vip (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072032 \"The marker set VIP can identify the Human cell type VIP GABAergic interneuron in the neocortex with a confidence of 0.855531344 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072032 \"VIP GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072034 (lamp5 GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072034 \"Lamp5 interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072034 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Lamp5.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072034 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072034 \"The marker set LINC00298, KIT can identify the Human cell type lamp5 GABAergic interneuron in the neocortex with a confidence of 0.814687838 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072034 \"lamp5 GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072034 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072035 (sncg GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072035 \"sncg interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072035 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sncg.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072035 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072035 \"The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072035 \"sncg GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072036 (PAX6 GABAergic interneuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072036 \"Pax6 interneuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072036 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses the transcript PAX6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters PAX\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072036 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072036 \"The marker set RELN, HCRTR2 can identify the Human cell type PAX6 GABAergic interneuron in the neocortex with a confidence of 0.724125093 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072036 \"PAX6 GABAergic interneuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072037 (L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25622573\") Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072037 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found between cortical layer 2-4. This intratelencephalic-projecting glutamatergic neuron has thin-tufted apical dendrites and extends its axonal projection into L5 in the neocortex. This neuronal type has a hyperpolarised resting membrane potential. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L2/3 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072037 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072037 \"L2/3 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072037 \"The marker set ONECUT2, COL5A2 can identify the Human cell type L2/3 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.670149932 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072037 \"L2/3 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072038 (L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072038 \"L5 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072038 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 5. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L5 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072038 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072038 \"L5 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072038 \"The marker set ARSJ, RORB, KCNK2 can identify the Human cell type L5 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.764261336 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072038 \"L5 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072039 (L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072039 \"L4 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072039 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 3-4. This neuron type can have a pyramidal, star-pyramidal or spiny stellate morphology and projects its output to L2/3 and L5A/B. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L4 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072039 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072039 \"L4 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072039 \"The marker set RORB, ST8SIA4 can identify the Human cell type L4 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.720108696 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072039 \"L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072040 (L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072040 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_cluster', L6 IT Car3.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072040 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4072040 \"L6 IT Car3 glutamatergic neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 cell (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072040 \"The marker set SMYD1, THEMIS can identify the Human cell type L6 intratelencephalic projecting Car3 glutamatergic neuron in the neocortex with a confidence of 0.877752028 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072040 \"L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072041 (L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072041 \"L6 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072041 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.  The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L6 IT.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072041 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072041 \"L6 IT (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072041 \"L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072042 (L5/6 near-projecting glutamatergic neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072042 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072042 \"L5/6 near-projecting glutamatergic neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072043 (L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072043 \"L5 ET glut (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4072043 obo:NCBITaxon_9606)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\nAnnotationAssertion(rdfs:label obo:CL_4072043 \"L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens)\")\nSubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n# Class: obo:CL_4072044 (L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens))\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4072044 \"L6 CT glut (Homo sapiens)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non