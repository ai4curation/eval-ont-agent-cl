{"type":"tool_use","timestamp":1778596676510,"sessionID":"ses_1e365a6ebffeXBLBvytnigkSyM","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-86591da176379df6","state":{"status":"completed","input":{"command":"grep -i \"tendon cell\" src/ontology/cl-edit.owl","description":"Search for \"tendon cell\" in the ontology file."},"output":"# Class: obo:CL_0000388 (tendon cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibrocyte that is part of a tendon. The cytoplasm is stretched between the collagen fibres of the tendon. They have a central cell nucleus with a prominent nucleolus. Tendon cells have a well-developed rough endoplasmic reticulum and they are responsible for synthesis and turnover of tendon fibres and ground substance.\")\nAnnotationAssertion(rdfs:label obo:CL_0000388 \"tendon cell\")\n","metadata":{"output":"# Class: obo:CL_0000388 (tendon cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibrocyte that is part of a tendon. The cytoplasm is stretched between the collagen fibres of the tendon. They have a central cell nucleus with a prominent nucleolus. Tendon cells have a well-developed rough endoplasmic reticulum and they are responsible for synthesis and turnover of tendon fibres and ground substance.\")\nAnnotationAssertion(rdfs:label obo:CL_0000388 \"tendon cell\")\n","exit":0,"description":"Search for \"tendon cell\" in the ontology file.","truncated":false},"title":"Search for \"tendon cell\" in the ontology file.","time":{"start":1778596676504,"end":1778596676509}},"id":"prt_e1c9f76bc001YI9K6hOd4T0Nal","sessionID":"ses_1e365a6ebffeXBLBvytnigkSyM","messageID":"msg_e1c9f0628001RcghV6RhNHJTev"}}
{"type":"tool_use","timestamp":1778596680064,"sessionID":"ses_1e365a6ebffeXBLBvytnigkSyM","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-94f5d939fc39990c","state":{"status":"completed","input":{"command":"grep -i \"fibroblast\" src/ontology/cl-edit.owl","description":"Search for \"fibroblast\" in the ontology file."},"output":"# Class: obo:CL_0000005 (neural crest derived fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\nAnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n# Class: obo:CL_0000057 (fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D005347\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Fibroblast\") obo:IAO_0000115 obo:CL_0000057 \"A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped.\")\nAnnotationAssertion(rdfs:label obo:CL_0000057 \"fibroblast\")\nAnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:11641248\") Annotation(oboInOwl:hasDbXref \"PMID:15010326\") Annotation(oboInOwl:hasDbXref \"PMID:17607298\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:8790603\") Annotation(oboInOwl:hasDbXref \"PMID:9551999\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Fibrocyte\") obo:IAO_0000115 obo:CL_0000135 \"An inactive fibroblast; cytoplasm is sparse, endoplasmic reticulum is scanty with flattened nucleus. Term used by some histologists; when fibroblasts become relatively inactive in fiber formation. However, this cell has the potential for fibrogenesis in quiescent connective tissue of the adult, as well as during development, other histologists prefer to use the term fibroblast in all circumstances. These cells represent ~0.5% of peripheral blood leukocytes.\")\n# Class: obo:CL_0000186 (myofibroblast cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D058628\") Annotation(oboInOwl:hasDbXref \"PMID:19800625\") Annotation(oboInOwl:hasDbXref \"PMID:20630469\") Annotation(oboInOwl:hasDbXref \"PMID:22387320\") obo:IAO_0000115 obo:CL_0000186 \"An animal cell that has characteristics of both a fibroblast cell and a smooth muscle cell.\")\nAnnotationAssertion(rdfs:comment obo:CL_0000186 \"Myofibroblasts are alpha-SMA-positive, CD34-negative, CD45-negative. They are reportedly capable of secreting IL-1beta, IL-6, and TNF-alpha.\")\nAnnotationAssertion(rdfs:label obo:CL_0000186 \"myofibroblast cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n# Class: obo:CL_0000688 (perijunctional fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\nAnnotationAssertion(rdfs:label obo:CL_0000688 \"perijunctional fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0002092 \"A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.\")\n# Class: obo:CL_0002240 (marrow fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002240 \"A fibroblast in the bone marrow.\")\nAnnotationAssertion(rdfs:label obo:CL_0002240 \"marrow fibroblast\")\n# Class: obo:CL_0002241 (pulmonary interstitial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002241 \"A fibroblasts found in interstitial spaces in the pulmonary tract. Greater numbers of these cells are found in idiopathic pulmonary fibrosis.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002241 \"pulmonary myofibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0002241 \"pulmonary interstitial fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30309298\") oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002301 \"fibroblast-like synoviocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23147896\") oboInOwl:hasExactSynonym obo:CL_0002301 \"synovial fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34433485\") Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Fibroblast-like_synoviocyte\") rdfs:comment obo:CL_0002301 \"Type B synovial cells play a key role in the pathogenesis of chronic inflammatory diseases, such as rheumatoid arthritis, and are essential for the maintenance of normal joint functions. Fibroblast-like synoviocytes from different joints have different properties, which may contribute to the characteristic pattern of joint involvement in different types of arthritis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18793119\") obo:IAO_0000115 obo:CL_0002334 \"An undifferentiated fibroblast that can be stimulated to form a fat cell.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002363 \"corneal fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17200706\") obo:IAO_0000115 obo:CL_0002410 \"A cell that is found in the periacinar space of the exocrine pancreas and in perivascular and periductal regions of the pancreas, and has long cytoplasmic processes that encircle the base of the acinus. Expresses several intermediate filament proteins including vimentin and nestin. Shares many of the characteristics of hepatatic stellate cells, but not stellate cells of the central nervous system. Upon activation, this cell type undergoes morphological and gene expression changes that make the cell suggestive of being a type of myofibroblast.\")\n# Class: obo:CL_0002547 (fibroblast of the aortic adventitia)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002547 \"A fibroblast of the aortic adventitia.\")\nAnnotationAssertion(rdfs:label obo:CL_0002547 \"fibroblast of the aortic adventitia\")\n# Class: obo:CL_0002548 (fibroblast of cardiac tissue)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002548 \"A fibroblast that is part of the heart.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002548 \"cardiac fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0002548 \"fibroblast of cardiac tissue\")\n# Class: obo:CL_0002549 (fibroblast of choroid plexus)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002549 \"A fibroblast that is part of the choroid plexus.\")\nAnnotationAssertion(rdfs:label obo:CL_0002549 \"fibroblast of choroid plexus\")\n# Class: obo:CL_0002550 (fibroblast of the conjunctiva)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002550 \"A fibroblast that is part of the conjuctiva of the eye.\")\nAnnotationAssertion(rdfs:label obo:CL_0002550 \"fibroblast of the conjunctiva\")\n# Class: obo:CL_0002551 (fibroblast of dermis)\nAnnotationAssertion(rdfs:label obo:CL_0002551 \"fibroblast of dermis\")\n# Class: obo:CL_0002552 (fibroblast of gingiva)\nAnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n# Class: obo:CL_0002553 (fibroblast of lung)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002553 \"A fibroblast that is part of lung.\")\nAnnotationAssertion(rdfs:label obo:CL_0002553 \"fibroblast of lung\")\n# Class: obo:CL_0002554 (fibroblast of lymphatic vessel)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002554 \"A fibroblast of the lymphatic system.\")\nAnnotationAssertion(rdfs:label obo:CL_0002554 \"fibroblast of lymphatic vessel\")\n# Class: obo:CL_0002555 (fibroblast of mammary gland)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002555 \"A fibroblast that is part of the mammary gland.\")\nAnnotationAssertion(rdfs:label obo:CL_0002555 \"fibroblast of mammary gland\")\n# Class: obo:CL_0002556 (fibroblast of periodontium)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002556 \"A fibroblast of the periodontium.\")\nAnnotationAssertion(rdfs:label obo:CL_0002556 \"fibroblast of periodontium\")\n# Class: obo:CL_0002557 (fibroblast of pulmonary artery)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002557 \"A fibroblast of pulmonary artery.\")\nAnnotationAssertion(rdfs:label obo:CL_0002557 \"fibroblast of pulmonary artery\")\n# Class: obo:CL_0002558 (fibroblast of villous mesenchyme)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002558 \"A fibroblast that is part of villous mesenchyme.\")\nAnnotationAssertion(rdfs:label obo:CL_0002558 \"fibroblast of villous mesenchyme\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"NCIT:C41442\") Annotation(oboInOwl:hasDbXref \"PMID:25818566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Perineurium\") obo:IAO_0000115 obo:CL_0002576 \"A glial cell that is part of the perineurium. This cell type has thin long bipolar cytoplasmic processes, pinocytotic vesicles, fragments of external lamina and/or external lamina-like material, attachment plaques, and desmosome-like junctions. Perineurial cells historically have been referred to as fibroblasts because of shape; however, unlike fibroblasts, a perineurial cell: does not have a compact nucleus and large endoplasmic reticulum; does have a double basement membrane opposed to a single basal lamina; is carefully joined to other perineurial cells by tight junctions into a single sheet as opposed to arranged in a large mass; and finally, can surround a small axon bundle at a nerve terminal whereas a fibroblast cannot.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36244793\") rdfs:comment obo:CL_0002576 \"There are studies that largely accept the idea that the perineurial cell is a modified fibroblast with myofibroblastic features.\")\n# Class: obo:CL_0002620 (skin fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002620 \"A fibroblast of skin.\")\nAnnotationAssertion(rdfs:label obo:CL_0002620 \"skin fibroblast\")\n# Class: obo:CL_0008023 (obsolete cardiac fibroblast)\nAnnotationAssertion(rdfs:label obo:CL_0008023 \"obsolete cardiac fibroblast\")\n# Class: obo:CL_0009078 (thymic fibroblast type 1)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009078 \"A fibroblast located in the thymic capsule.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009078 \"thymic capsular fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0009078 \"thymic fibroblast type 1\")\n# Class: obo:CL_0009079 (thymic fibroblast type 2)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009079 \"A fibroblast located between thymic lobules.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009079 \"thymic interlobular fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0009079 \"thymic fibroblast type 2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n# Class: obo:CL_0009100 (hepatic portal fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20209607\") Annotation(oboInOwl:hasDbXref \"PMID:24814904\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009100 \"A fibroblast located in the portal triad. Hepatic portal fibroblast are a non-parenchymal cell population located adjacent to bile duct epithelia in liver and are distinct from stellate cells. They differentiate into fibrogenic myofibroblasts during chronic injury states producing high levels of collagen.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009100 \"portal fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0009100 \"hepatic portal fibroblast\")\n# Class: obo:CL_0009101 (fibroblastic reticular cell)\nAnnotationAssertion(rdfs:label obo:CL_0009101 \"fibroblastic reticular cell\")\n# Class: obo:CL_0009102 (lymph node fibroblastic reticular cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009102 \"A specialized, fibroblastic reticular cell of mesenchymal origin found in lymph nodes. In human, it expresses several markers common to myofibroblasts (desmin, vimentin, CD73, CD90, α-smooth muscle actin (αSMA)), and can be differentiated from endothelial cells by its lack of CD31 expression. These cells are critical for the overall organization and function of the lymph node. Lymph node fibroblastic reticular cells (FRCs) can be further classified based on their location, function, and unique marker expression.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009102 \"fibroblastic reticular cell\")\nAnnotationAssertion(rdfs:label obo:CL_0009102 \"lymph node fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009103 \"A fibroblastic reticular cell found in the lymph node subcapsular sinus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009104 \"A fibroblastic reticular cell found in the lymph node germinal center dark zone (B cell zone).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009104 \"lymph node germinal center dark zone fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009105 \"A fibroblastic reticular cell found in the lymph node T cell domain.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009105 \"lymph node T cell domain fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:33981032\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009106 \"A specialized fibroblast found in the medulla of lymph node.\")\n# Class: obo:CL_0011021 (fibroblast of upper back skin)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0011021 \"A fibroblast that is part of upper back skin.\")\nAnnotationAssertion(rdfs:label obo:CL_0011021 \"fibroblast of upper back skin\")\n# Class: obo:CL_0011022 (fibroblast of skin of back)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0011022 \"A fibroblast that is part of skin of back.\")\nAnnotationAssertion(rdfs:label obo:CL_0011022 \"fibroblast of skin of back\")\n# Class: obo:CL_0011027 (skeletal muscle fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28369879\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6164-0667\") obo:IAO_0000115 obo:CL_0011027 \"Any fibroblast that is part of skeletal muscle tissue.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0011027 \"skeleton muscle fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0011027 \"skeletal muscle fibroblast\")\n# Class: obo:CL_1000299 (fibroblast of connective tissue of prostate)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000299 \"A fibroblast that is part of the connective tissue of prostate.\")\nAnnotationAssertion(rdfs:label obo:CL_1000299 \"fibroblast of connective tissue of prostate\")\n# Class: obo:CL_1000300 (fibroblast of outer membrane of prostatic capsule)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000300 \"A fibroblast that is part of the outer membrane of prostatic capsule.\")\nAnnotationAssertion(rdfs:label obo:CL_1000300 \"fibroblast of outer membrane of prostatic capsule\")\n# Class: obo:CL_1000301 (fibroblast of subepithelial connective tissue of prostatic gland)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000301 \"A fibroblast that is part of the subepithelial connective tissue of prostatic gland.\")\nAnnotationAssertion(rdfs:label obo:CL_1000301 \"fibroblast of subepithelial connective tissue of prostatic gland\")\n# Class: obo:CL_1000302 (fibroblast of papillary layer of dermis)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000302 \"A fibroblast that is part of the papillary layer of dermis.\")\nAnnotationAssertion(rdfs:label obo:CL_1000302 \"fibroblast of papillary layer of dermis\")\n# Class: obo:CL_1000303 (fibroblast of areolar connective tissue)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000303 \"A fibroblast that is part of the areolar connective tissue.\")\nAnnotationAssertion(rdfs:label obo:CL_1000303 \"fibroblast of areolar connective tissue\")\n# Class: obo:CL_1000304 (fibroblast of connective tissue of nonglandular part of prostate)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000304 \"A fibroblast that is part of the connective tissue of nonglandular part of prostate.\")\nAnnotationAssertion(rdfs:label obo:CL_1000304 \"fibroblast of connective tissue of nonglandular part of prostate\")\n# Class: obo:CL_1000305 (fibroblast of connective tissue of glandular part of prostate)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000305 \"A fibroblast that is part of the connective tissue of glandular part of prostate.\")\nAnnotationAssertion(rdfs:label obo:CL_1000305 \"fibroblast of connective tissue of glandular part of prostate\")\n# Class: obo:CL_1000306 (fibroblast of tunica adventitia of artery)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000306 \"A fibroblast that is part of the tunica adventitia of artery.\")\nAnnotationAssertion(rdfs:label obo:CL_1000306 \"fibroblast of tunica adventitia of artery\")\n# Class: obo:CL_1000307 (fibroblast of dense regular elastic tissue)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000307 \"A fibroblast that is part of the dense regular elastic tissue.\")\nAnnotationAssertion(rdfs:label obo:CL_1000307 \"fibroblast of dense regular elastic tissue\")\n# Class: obo:CL_1000691 (kidney interstitial myofibroblast)\nAnnotationAssertion(rdfs:label obo:CL_1000691 \"kidney interstitial myofibroblast\")\n# Class: obo:CL_1000692 (kidney interstitial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_1000692 \"A fibroblast that is part of an interstitial compartment of a kidney.\")\nAnnotationAssertion(rdfs:label obo:CL_1000692 \"kidney interstitial fibroblast\")\n# Class: obo:CL_1001608 (foreskin fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001608 \"Fibroblast from foreskin.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1001608 \"BJ fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_1001608 \"foreskin fibroblast\")\n# Class: obo:CL_1001609 (muscle fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001609 \"Fibroblast from muscle organ.\")\nAnnotationAssertion(rdfs:label obo:CL_1001609 \"muscle fibroblast\")\n# Class: obo:CL_2000012 (fibroblast of pedal digit skin)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000012 \"Any skin fibroblast that is part of a pedal digit skin.\")\nAnnotationAssertion(rdfs:label obo:CL_2000012 \"fibroblast of pedal digit skin\")\n# Class: obo:CL_2000013 (fibroblast of skin of abdomen)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000013 \"Any skin fibroblast that is part of a skin of abdomen.\")\nAnnotationAssertion(rdfs:label obo:CL_2000013 \"fibroblast of skin of abdomen\")\n# Class: obo:CL_2000014 (fibroblast of upper leg skin)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000014 \"Any skin fibroblast that is part of a upper leg skin.\")\nAnnotationAssertion(rdfs:label obo:CL_2000014 \"fibroblast of upper leg skin\")\n# Class: obo:CL_2000015 (fibroblast of arm)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000015 \"Any skin fibroblast that is part of a arm.\")\nAnnotationAssertion(rdfs:label obo:CL_2000015 \"fibroblast of arm\")\n# Class: obo:CL_2000017 (fibroblast of peridontal ligament)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000017 \"Any fibroblast that is part of a periodontal ligament.\")\nAnnotationAssertion(rdfs:label obo:CL_2000017 \"fibroblast of peridontal ligament\")\n# Class: obo:CL_2000042 (embryonic fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000042 \"Any fibroblast that is part of a embryo.\")\nAnnotationAssertion(rdfs:label obo:CL_2000042 \"embryonic fibroblast\")\n# Class: obo:CL_2000051 (splenic fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000051 \"Any fibroblast that is part of a spleen.\")\nAnnotationAssertion(rdfs:label obo:CL_2000051 \"splenic fibroblast\")\n# Class: obo:CL_2000063 (ovarian fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000063 \"Any fibroblast that is part of a female gonad.\")\nAnnotationAssertion(rdfs:label obo:CL_2000063 \"ovarian fibroblast\")\n# Class: obo:CL_2000066 (cardiac ventricle fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000066 \"Any fibroblast that is part of a cardiac ventricle.\")\nAnnotationAssertion(rdfs:label obo:CL_2000066 \"cardiac ventricle fibroblast\")\n# Class: obo:CL_2000067 (cardiac atrium fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000067 \"Any fibroblast that is part of a cardiac atrium.\")\nAnnotationAssertion(rdfs:label obo:CL_2000067 \"cardiac atrium fibroblast\")\n# Class: obo:CL_2000068 (pericardium fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000068 \"Any fibroblast that is part of a pericardium.\")\nAnnotationAssertion(rdfs:label obo:CL_2000068 \"pericardium fibroblast\")\n# Class: obo:CL_2000069 (gallbladder fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000069 \"Any fibroblast that is part of a gallbladder.\")\nAnnotationAssertion(rdfs:label obo:CL_2000069 \"gallbladder fibroblast\")\n# Class: obo:CL_2000070 (optic choroid fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000070 \"Any fibroblast that is part of a optic choroid.\")\nAnnotationAssertion(rdfs:label obo:CL_2000070 \"optic choroid fibroblast\")\n# Class: obo:CL_2000093 (bronchus fibroblast of lung)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000093 \"Any fibroblast of lung that is part of a bronchus.\")\nAnnotationAssertion(rdfs:label obo:CL_2000093 \"bronchus fibroblast of lung\")\n# Class: obo:CL_2000096 (fibroblast of the reticular layer of dermis)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000096 \"Any fibroblast that is part of a reticular layer of dermis.\")\nAnnotationAssertion(rdfs:label obo:CL_2000096 \"fibroblast of the reticular layer of dermis\")\n# Class: obo:CL_4006000 (fibroblast of breast)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4006000 \"A fibroblast that is part of the breast.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006000 \"breast fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4006000 \"fibroblast of breast\")\n# Class: obo:CL_4006001 (fibroblast of skin of scalp)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4006001 \"A fibroblast that is part of the skin of scalp.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006001 \"skin of scalp fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4006001 \"fibroblast of skin of scalp\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\n# Class: obo:CL_4023054 (mesothelial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_4023054 \"A mesothelial cell that has undergone mesothelial-to-mesenchymal transition (MMT) to become a fibroblast cell.\")\nAnnotationAssertion(rdfs:label obo:CL_4023054 \"mesothelial fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain.\")\n# Class: obo:CL_4023058 (mesothelial fibroblast of the leptomeninx)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4023058 \"A mesothelial fibroblast found in the leptomeninx.\")\nAnnotationAssertion(rdfs:label obo:CL_4023058 \"mesothelial fibroblast of the leptomeninx\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23298861\") obo:IAO_0000115 obo:CL_4023097 \"A mesothelial fibroblast of the arachnoid barrier layer. Arachnoid barrier cells make up the tight-junctioned layer in the leptomeninx that functions as the physiologic barrier between the cerebrospinal fluid in the subarachnoid space and the fenestrated capillaries in the dura.\")\n# Class: obo:CL_4028004 (alveolar type 1 fibroblast cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22268140\") Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29489752\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasDbXref \"PMID:33707239\") Annotation(oboInOwl:hasDbXref \"PMID:9074756\") obo:IAO_0000115 obo:CL_4028004 \"A pulmonary interstitial fibroblast that is part of the alveolus and contains lipid droplets.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast 1\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"lipofibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"matrix fibroblast 1\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"pulmonary lipofibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4028004 \"alveolar type 1 fibroblast cell\")\n# Class: obo:CL_4028006 (alveolar adventitial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29752282\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4028006 \"A pulmonary interstitial fibroblast that is part of the alveolus and localizes to vascular adventitia.\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"adventitial fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"alveolar fibroblast\")\nAnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"matrix fibroblast 2\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028006 \"alveolar type 2 fibroblast cell\")\nAnnotationAssertion(rdfs:label obo:CL_4028006 \"alveolar adventitial fibroblast\")\n# Class: obo:CL_4030022 (renal medullary fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1101/2021.07.28.454201>) Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030022 \"A fibroblast that is located in the renal medulla interstitium.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030022 \"kidney medullary fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") rdfs:comment obo:CL_4030022 \"It has been noted that inner medullary fibroblasts are involved in the regulation of water and electrolyte homeostasis.\")\nAnnotationAssertion(rdfs:label obo:CL_4030022 \"renal medullary fibroblast\")\n# Class: obo:CL_4030025 (renal cortical fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\nAnnotationAssertion(rdfs:label obo:CL_4030025 \"renal cortical fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030033 \"At least in some mammalian species, a valve endothelial cell expresses CD31. Valve endothelial cells can undergo an endothelial to mesenchymal transition to acquire a fibroblast or myofibroblast phenotype that leads to changes in the microenvironmental signals and facilitates tissue regeneration.\")\n# Class: obo:CL_4033016 (secondary crest myofibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasExactSynonym obo:CL_4033016 \"secondary-crest myofibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasRelatedSynonym obo:CL_4033016 \"alveolar myofibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4033016 \"secondary crest myofibroblast\")\n# Class: obo:CL_4033025 (perichondrial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Perichondrium\") obo:IAO_0000115 obo:CL_4033025 \"A fibroblast that is part of the fibrous layer of the perichondrium. This cell is responsible for collagen fiber production.\")\nAnnotationAssertion(rdfs:label obo:CL_4033025 \"perichondrial fibroblast\")\n# Class: obo:CL_4033026 (lung perichondrial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") obo:IAO_0000115 obo:CL_4033026 \"A perichondrial fibroblast that is part of the lung.\")\nAnnotationAssertion(rdfs:label obo:CL_4033026 \"lung perichondrial fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033062 \"A trophoblast cell that invades the uterine wall to anchor the placenta to the uterus. An interstitial extravillous trophoblast cell differentiates from an extravillous trophoblast cell, becoming hyperchromatic and changing its morphology to a fibroblast-like spindle-shaped cell. In humans, this cell can be distinguished by the expression of placental-specific protein 8, which stimulates migration.\")\n# Class: obo:CL_4047023 (intestinal lamina propria fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") oboInOwl:hasRelatedSynonym obo:CL_4047023 \"S1 fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_4047023 \"intestinal lamina propria fibroblast\"@en)\n# Class: obo:CL_4052004 (intestinal fibroblastic reticular cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052004 \"intestinal fibroblastic reticular cell\")\n# Class: obo:CL_4052005 (intestinal subserosal fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\nAnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\n# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\nAnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\n# Class: obo:CL_4052008 (crypt-bottom fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\nAnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\n# Class: obo:CL_4052009 (crypt-top fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\nAnnotationAssertion(rdfs:label obo:CL_4052009 \"crypt-top fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n# Class: obo:CL_4052029 (subpleural fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\nAnnotationAssertion(rdfs:label obo:CL_4052029 \"subpleural fibroblast\")\n# Class: obo:CL_4052030 (adventitial fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\nAnnotationAssertion(rdfs:label obo:CL_4052030 \"adventitial fibroblast\")\n# Class: obo:CL_4052062 (onychofibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\nAnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n","metadata":{"output":"...\n\n:IAO_0000115 obo:CL_0009103 \"A fibroblastic reticular cell found in the lymph node subcapsular sinus.\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009104 \"A fibroblastic reticular cell found in the lymph node germinal center dark zone (B cell zone).\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009104 \"lymph node germinal center dark zone fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009105 \"A fibroblastic reticular cell found in the lymph node T cell domain.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009105 \"lymph node T cell domain fibroblastic reticular cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:33981032\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009106 \"A specialized fibroblast found in the medulla of lymph node.\")\n# Class: obo:CL_0011021 (fibroblast of upper back skin)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0011021 \"A fibroblast that is part of upper back skin.\")\nAnnotationAssertion(rdfs:label obo:CL_0011021 \"fibroblast of upper back skin\")\n# Class: obo:CL_0011022 (fibroblast of skin of back)\nAnnotationAssertion(obo:IAO_0000115 obo:CL_0011022 \"A fibroblast that is part of skin of back.\")\nAnnotationAssertion(rdfs:label obo:CL_0011022 \"fibroblast of skin of back\")\n# Class: obo:CL_0011027 (skeletal muscle fibroblast)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28369879\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6164-0667\") obo:IAO_0000115 obo:CL_0011027 \"Any fibroblast that is part of skeletal muscle tissue.\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0011027 \"skeleton muscle fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0011027 \"skeletal muscle fibroblast\")\n# Class: obo:CL_1000299 (fibroblast of connective tissue of prostate)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000299 \"A fibroblast that is part of the connective tissue of prostate.\")\nAnnotationAssertion(rdfs:label obo:CL_1000299 \"fibroblast of connective tissue of prostate\")\n# Class: obo:CL_1000300 (fibroblast of outer membrane of prostatic capsule)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000300 \"A fibroblast that is part of the outer membrane of prostatic capsule.\")\nAnnotationAssertion(rdfs:label obo:CL_1000300 \"fibroblast of outer membrane of prostatic capsule\")\n# Class: obo:CL_1000301 (fibroblast of subepithelial connective tissue of prostatic gland)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000301 \