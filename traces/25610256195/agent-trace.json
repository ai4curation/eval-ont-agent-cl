{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"rg -n 'quiescent fibroblast|inactive fibroblast|fibroblast' src/ontology/cl-edit.owl\"","aggregated_output":"3743:# Class: obo:CL_0000005 (neural crest derived fibroblast)\n3745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\n3746:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\n3747:AnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n4279:# Class: obo:CL_0000057 (fibroblast)\n4288:AnnotationAssertion(rdfs:label obo:CL_0000057 \"fibroblast\")\n5048:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20303382\") Annotation(oboInOwl:hasDbXref \"PMID:20305780\") Annotation(oboInOwl:hasDbXref \"PMID:29286323\") Annotation(oboInOwl:hasDbXref \"PMID:31473260\") Annotation(oboInOwl:hasDbXref \"PMID:32084275\") Annotation(oboInOwl:hasDbXref \"PMID:9177213\") Annotation(oboInOwl:hasDbXref \"doi:/10.1186/1755-1536-5-S1-S6\") obo:IAO_0000115 obo:CL_0000135 \"A bone marrow-derived cell that predominantly develops from myeloid lineage-restricted progenitor cells and circulates in peripheral blood, characterized by co-expression of hematopoietic markers CD45 and CD34 along with stromal markers including collagen type I in both humans and mice (Chesney et al., 1997; Blakaj and Bucala, 2012). This spindle-shaped cell exhibits a unique dual identity, functionally bridging immune and stromal compartments with characteristics of both monocytes and fibroblasts. Predominantly arising from circulating monocytes, it migrates to injury sites via chemokine receptors and participates in wound repair through extracellular matrix deposition, cytokine secretion, and antigen presentation via MHC class II. As mesenchymal progenitors, fibrocytes can differentiate into fibroblasts, myofibroblasts, and adipocytes, contributing to both physiological repair and pathological fibrosis (Blakaj and Bucala, 2012).\")\n5558:# Class: obo:CL_0000186 (myofibroblast cell)\n5560:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D058628\") Annotation(oboInOwl:hasDbXref \"PMID:19800625\") Annotation(oboInOwl:hasDbXref \"PMID:20630469\") Annotation(oboInOwl:hasDbXref \"PMID:22387320\") obo:IAO_0000115 obo:CL_0000186 \"An animal cell that has characteristics of both a fibroblast cell and a smooth muscle cell.\")\n5562:AnnotationAssertion(rdfs:comment obo:CL_0000186 \"Myofibroblasts are alpha-SMA-positive, CD34-negative, CD45-negative. They are reportedly capable of secreting IL-1beta, IL-6, and TNF-alpha.\")\n5563:AnnotationAssertion(rdfs:label obo:CL_0000186 \"myofibroblast cell\")\n7099:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:37894875\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibroblast that is part of a tendon. Its cytoplasm is stretched between the collagen fibres of the tendon, and it possesses a central nucleus with a prominent nucleolus. Tendon cell has a well-developed rough endoplasmic reticulum, and it is responsible for the synthesis and turnover of tendon fibres and ground substance.\")\n7408:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\n9184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\n9539:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n9701:# Class: obo:CL_0000688 (perijunctional fibroblast)\n9703:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\n9704:AnnotationAssertion(rdfs:label obo:CL_0000688 \"perijunctional fibroblast\")\n14916:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0002092 \"A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.\")\n16506:# Class: obo:CL_0002240 (marrow fibroblast)\n16508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002240 \"A fibroblast in the bone marrow.\")\n16512:AnnotationAssertion(rdfs:label obo:CL_0002240 \"marrow fibroblast\")\n16516:# Class: obo:CL_0002241 (pulmonary interstitial fibroblast)\n16518:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002241 \"A fibroblasts found in interstitial spaces in the pulmonary tract. Greater numbers of these cells are found in idiopathic pulmonary fibrosis.\")\n16522:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002241 \"pulmonary myofibroblast\")\n16524:AnnotationAssertion(rdfs:label obo:CL_0002241 \"pulmonary interstitial fibroblast\")\n16667:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\n16674:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30309298\") oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal fibroblast\")\n17098:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n17194:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002301 \"fibroblast-like synoviocyte\")\n17195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23147896\") oboInOwl:hasExactSynonym obo:CL_0002301 \"synovial fibroblast\")\n17581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18793119\") obo:IAO_0000115 obo:CL_0002334 \"An undifferentiated fibroblast that can be stimulated to form a fat cell.\")\n17867:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\n17870:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002363 \"corneal fibroblast\")\n18334:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17200706\") obo:IAO_0000115 obo:CL_0002410 \"A cell that is found in the periacinar space of the exocrine pancreas and in perivascular and periductal regions of the pancreas, and has long cytoplasmic processes that encircle the base of the acinus. Expresses several intermediate filament proteins including vimentin and nestin. Shares many of the characteristics of hepatatic stellate cells, but not stellate cells of the central nervous system. Upon activation, this cell type undergoes morphological and gene expression changes that make the cell suggestive of being a type of myofibroblast.\")\n19682:# Class: obo:CL_0002547 (fibroblast of the aortic adventitia)\n19684:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002547 \"A fibroblast of the aortic adventitia.\")\n19687:AnnotationAssertion(rdfs:label obo:CL_0002547 \"fibroblast of the aortic adventitia\")\n19691:# Class: obo:CL_0002548 (fibroblast of cardiac tissue)\n19693:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002548 \"A fibroblast that is part of the heart.\")\n19696:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002548 \"cardiac fibroblast\")\n19697:AnnotationAssertion(rdfs:label obo:CL_0002548 \"fibroblast of cardiac tissue\")\n19702:# Class: obo:CL_0002549 (fibroblast of choroid plexus)\n19704:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002549 \"A fibroblast that is part of the choroid plexus.\")\n19707:AnnotationAssertion(rdfs:label obo:CL_0002549 \"fibroblast of choroid plexus\")\n19711:# Class: obo:CL_0002550 (fibroblast of the conjunctiva)\n19713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002550 \"A fibroblast that is part of the conjuctiva of the eye.\")\n19716:AnnotationAssertion(rdfs:label obo:CL_0002550 \"fibroblast of the conjunctiva\")\n19720:# Class: obo:CL_0002551 (fibroblast of dermis)\n19724:AnnotationAssertion(rdfs:label obo:CL_0002551 \"fibroblast of dermis\")\n19728:# Class: obo:CL_0002552 (fibroblast of gingiva)\n19732:AnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n19736:# Class: obo:CL_0002553 (fibroblast of lung)\n19738:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002553 \"A fibroblast that is part of lung.\")\n19743:AnnotationAssertion(rdfs:label obo:CL_0002553 \"fibroblast of lung\")\n19747:# Class: obo:CL_0002554 (fibroblast of lymphatic vessel)\n19749:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002554 \"A fibroblast of the lymphatic system.\")\n19752:AnnotationAssertion(rdfs:label obo:CL_0002554 \"fibroblast of lymphatic vessel\")\n19756:# Class: obo:CL_0002555 (fibroblast of mammary gland)\n19758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002555 \"A fibroblast that is part of the mammary gland.\")\n19761:AnnotationAssertion(rdfs:label obo:CL_0002555 \"fibroblast of mammary gland\")\n19765:# Class: obo:CL_0002556 (fibroblast of periodontium)\n19767:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002556 \"A fibroblast of the periodontium.\")\n19770:AnnotationAssertion(rdfs:label obo:CL_0002556 \"fibroblast of periodontium\")\n19774:# Class: obo:CL_0002557 (fibroblast of pulmonary artery)\n19776:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002557 \"A fibroblast of pulmonary artery.\")\n19779:AnnotationAssertion(rdfs:label obo:CL_0002557 \"fibroblast of pulmonary artery\")\n19783:# Class: obo:CL_0002558 (fibroblast of villous mesenchyme)\n19785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002558 \"A fibroblast that is part of villous mesenchyme.\")\n19788:AnnotationAssertion(rdfs:label obo:CL_0002558 \"fibroblast of villous mesenchyme\")\n19953:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"NCIT:C41442\") Annotation(oboInOwl:hasDbXref \"PMID:25818566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Perineurium\") obo:IAO_0000115 obo:CL_0002576 \"A glial cell that is part of the perineurium. This cell type has thin long bipolar cytoplasmic processes, pinocytotic vesicles, fragments of external lamina and/or external lamina-like material, attachment plaques, and desmosome-like junctions. Perineurial cells historically have been referred to as fibroblasts because of shape; however, unlike fibroblasts, a perineurial cell: does not have a compact nucleus and large endoplasmic reticulum; does have a double basement membrane opposed to a single basal lamina; is carefully joined to other perineurial cells by tight junctions into a single sheet as opposed to arranged in a large mass; and finally, can surround a small axon bundle at a nerve terminal whereas a fibroblast cannot.\")\n19958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36244793\") rdfs:comment obo:CL_0002576 \"There are studies that largely accept the idea that the perineurial cell is a modified fibroblast with myofibroblastic features.\")\n20362:# Class: obo:CL_0002620 (skin fibroblast)\n20364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002620 \"A fibroblast of skin.\")\n20369:AnnotationAssertion(rdfs:label obo:CL_0002620 \"skin fibroblast\")\n22850:# Class: obo:CL_0008023 (obsolete cardiac fibroblast)\n22854:AnnotationAssertion(rdfs:label obo:CL_0008023 \"obsolete cardiac fibroblast\")\n23942:# Class: obo:CL_0009078 (thymic fibroblast type 1)\n23944:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009078 \"A fibroblast located in the thymic capsule.\")\n23947:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009078 \"thymic capsular fibroblast\")\n23948:AnnotationAssertion(rdfs:label obo:CL_0009078 \"thymic fibroblast type 1\")\n23952:# Class: obo:CL_0009079 (thymic fibroblast type 2)\n23954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009079 \"A fibroblast located between thymic lobules.\")\n23957:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009079 \"thymic interlobular fibroblast\")\n23958:AnnotationAssertion(rdfs:label obo:CL_0009079 \"thymic fibroblast type 2\")\n24169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n24177:# Class: obo:CL_0009100 (hepatic portal fibroblast)\n24179:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20209607\") Annotation(oboInOwl:hasDbXref \"PMID:24814904\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009100 \"A fibroblast located in the portal triad. Hepatic portal fibroblast are a non-parenchymal cell population located adjacent to bile duct epithelia in liver and are distinct from stellate cells. They differentiate into fibrogenic myofibroblasts during chronic injury states producing high levels of collagen.\")\n24182:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009100 \"portal fibroblast\")\n24183:AnnotationAssertion(rdfs:label obo:CL_0009100 \"hepatic portal fibroblast\")\n24186:# Class: obo:CL_0009101 (fibroblastic reticular cell)\n24192:AnnotationAssertion(rdfs:label obo:CL_0009101 \"fibroblastic reticular cell\")\n24197:# Class: obo:CL_0009102 (lymph node fibroblastic reticular cell)\n24199:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009102 \"A specialized, fibroblastic reticular cell of mesenchymal origin found in lymph nodes. In human, it expresses several markers common to myofibroblasts (desmin, vimentin, CD73, CD90, α-smooth muscle actin (αSMA)), and can be differentiated from endothelial cells by its lack of CD31 expression. These cells are critical for the overall organization and function of the lymph node. Lymph node fibroblastic reticular cells (FRCs) can be further classified based on their location, function, and unique marker expression.\")\n24203:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009102 \"fibroblastic reticular cell\")\n24204:AnnotationAssertion(rdfs:label obo:CL_0009102 \"lymph node fibroblastic reticular cell\")\n24210:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009103 \"A fibroblastic reticular cell found in the lymph node subcapsular 