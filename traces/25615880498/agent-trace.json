36 obo:CL_0000681)\n# Class: obo:CL_0000681 (radial glial cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dph\") obo:IAO_0000115 obo:CL_0000681 \"A cell present in the developing CNS. Functions as both a precursor cell and as a scaffold to support neuronal migration.\")\nAnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000681 \"forebrain radial glial cell\")\nAnnotationAssertion(rdfs:comment obo:CL_0000681 \"Unlike that of mammals, the brain of adult teleost fish exhibits an intense and widespread neurogenic activity as a result of the persistence of\nAnnotationAssertion(rdfs:label obo:CL_0000681 \"radial glial cell\")\nSubClassOf(obo:CL_0000681 obo:CL_0000125)\nSubClassOf(obo:CL_0000681 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000710))\nSubClassOf(obo:CL_0000683 obo:CL_0000065)\nEquivalentClasses(obo:CL_0000706 ObjectIntersectionOf(obo:CL_0000065 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003911)))\n# Class: obo:CL_0001031 (cerebellar granule cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"doi:10.12688/f1000research.15021.1\") Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") obo:IAO_0000115 obo:CL_0001031 \"An excitatory granule cell with a soma located in the granular layer of cerebellar cortex. A mature cerebellar granule cell has short dendrites with a characteristic claw-like appearance and a long axon that ascends to the molecular layer where it bifurcates (except in non-teleost fish, where it does not bifurcate) and extends mediolaterally to form parallel fibers.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0001031 \"BTO:0004278\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") oboInOwl:hasExactSynonym obo:CL_0001031 \"granule cell of the cerebellum\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") rdfs:comment obo:CL_0001031 \"It has been noted in at least some mammalian species that granule cells are the most numerous cell type in the cerebellum and in the brain, with at least 99% of all cerebellar neurons being granule cells.\")\nAnnotationAssertion(rdfs:label obo:CL_0001031 \"cerebellar granule cell\")\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.cnp.2022.11.002\") foaf:depiction obo:CL_0001031 <http://purl.obolibrary.org/obo/cl/images/CB_circuits_PMID3650468_f2.png>)\nAnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0001031 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\nEquivalentClasses(obo:CL_0001031 ObjectIntersectionOf(obo:CL_0000120 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002037)))\nSubClassOf(obo:CL_0001031 obo:CL_0000679)\nSubClassOf(obo:CL_0001031 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_0002362))\nSubClassOf(obo:CL_0002085 obo:CL_0000065)\n# Class: obo:CL_0002362 (cerebellar granule cell precursor)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:14745007\") obo:IAO_0000115 obo:CL_0002362 \"A cell located in the outermost proliferative zone of the external germinal layer that can differentiate into astroglial cells and granule cells. This cell type is glial fibrillary acidic protein-positive and HNK1-positive.\")\nAnnotationAssertion(terms:contributor obo:CL_0002362 <https://orcid.org/0000-0003-1980-3228>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0002362 \"2010-09-22T01:40:44Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") oboInOwl:hasBroadSynonym obo:CL_0002362 \"granule cell precursor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") oboInOwl:hasBroadSynonym obo:CL_0002362 \"granule cell progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.3389/fncir.2020.611841\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0002362 \"GCP\")\nAnnotationAssertion(rdfs:label obo:CL_0002362 \"cerebellar granule cell precursor\")\nSubClassOf(obo:CL_0002362 obo:CL_0000031)\nSubClassOf(obo:CL_0002362 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009841))\nSubClassOf(obo:CL_0002453 ObjectSomeValuesFrom(obo:RO_0002203 obo:CL_4023059))\nEquivalentClasses(obo:CL_0009030 ObjectIntersectionOf(obo:CL_1001516 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001154)))\nEquivalentClasses(obo:CL_0013000 ObjectIntersectionOf(obo:CL_0000681 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001890)))\nSubClassOf(obo:CL_0013000 obo:CL_0000681)\nEquivalentClasses(obo:CL_1000073 ObjectIntersectionOf(obo:CL_0000681 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002240)))\n# Class: obo:CL_1001516 (intestinal enteroendocrine cell)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0010802\") obo:IAO_0000115 obo:CL_1001516 \"The various hormone- or neurotransmitter-secreting cells present throughout the mucosa of the intestinal tract.\")\nAnnotationAssertion(rdfs:label obo:CL_1001516 \"intestinal enteroendocrine cell\")\nEquivalentClasses(obo:CL_1001516 ObjectIntersectionOf(obo:CL_0000164 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001277)))\nSubClassOf(obo:CL_1001516 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001277))\nSubClassOf(obo:CL_1001516 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4052006))\n# Class: obo:CL_4023059 (committed oligodendrocyte precursor)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32066987\") obo:IAO_0000115 obo:CL_4023059 \"An oligodendrocyte precursor cell that is committed to differentiate.\")\nAnnotationAssertion(terms:contributor obo:CL_4023059 <http://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023059 \"COP\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023059 \"differentiation-committed oligodendrocyte precursor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") rdfs:comment obo:CL_4023059 \"COPs are distinct from OPCs in that the lack expression of Pdgfra and Cspg4 and come out as distinct clusters in transcriptomic profiling. This is the reason that this term is not modelled as a subclassOf OPC but instead linked using develops_from.\")\nAnnotationAssertion(rdfs:label obo:CL_4023059 \"committed oligodendrocyte precursor\")\nSubClassOf(obo:CL_4023059 obo:CL_0000123)\nSubClassOf(obo:CL_4023059 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002453))\n# Class: obo:CL_4052006 (intestinal enteroendocrine progenitor)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\nAnnotationAssertion(terms:contributor obo:CL_4052006 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052006 \"2024-09-20T12:13:26Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052006 \"EEC Progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25670791\") rdfs:comment obo:CL_4052006 \"The EEC progenitor is also present in other organisms; for example, flies have EEC progenitors but lack intestinal crypts and do not express the same markers. Instead, they are Dl+ and Pros+.\")\nAnnotationAssertion(rdfs:label obo:CL_4052006 \"intestinal enteroendocrine progenitor\")\nSubClassOf(obo:CL_4052006 obo:CL_0002563)\nSubClassOf(obo:CL_4052006 obo:CL_0011026)\nSubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\nSubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\n# Class: obo:CL_4072001 (newly formed oligodendrocyte)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\nAnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\nAnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\nSubClassOf(obo:CL_4072001 obo:CL_0000123)\nSubClassOf(obo:CL_4072001 obo:CL_0000128)\nSubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\nSubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\nSubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n","exit_code":0,"status":"completed"}}
