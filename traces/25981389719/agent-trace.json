ses(obo:CL_4023068 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0010225) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535)))\n30820: \n30821: # Class: obo:CL_4023069 (medial ganglionic eminence derived GABAergic interneuron)\n30822: \n30823: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023069 \"MGE gaba interneuron\")\n30824: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12637172\") obo:IAO_0000115 obo:CL_4023069 \"A GABAergic interneuron that develops from the medial ganglionic eminence and has migrated to the cerebral cortex.\")\n30825: AnnotationAssertion(terms:contributor obo:CL_4023069 <https://orcid.org/0000-0001-7258-9596>)\n30826: AnnotationAssertion(rdfs:label obo:CL_4023069 \"medial ganglionic eminence derived GABAergic interneuron\")\n30827: EquivalentClasses(obo:CL_4023069 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n30828: SubClassOf(obo:CL_4023069 obo:CL_4023063)\n30829: \n30830: # Class: obo:CL_4023070 (obsolete caudal ganglionic eminence derived GABAergic cortical interneuron)\n30831: \n30832: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023070 \"CGE gaba cortical interneuron\")\n30833: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") obo:IAO_0000115 obo:CL_4023070 \"OBSOLETE. A GABAergic cortical interneuron that develops from the caudal ganglionic eminence and has migrated to the cerebral cortex.\")\n30834: AnnotationAssertion(obo:IAO_0000233 obo:CL_4023070 <https://github.com/obophenotype/cell-ontology/pull/2374>)\n30835: AnnotationAssertion(obo:IAO_0100001 obo:CL_4023070 obo:CL_4023064)\n30836: AnnotationAssertion(terms:contributor obo:CL_4023070 <https://orcid.org/0000-0001-7258-9596>)\n30837: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023070 \"CGE cortical interneuron\")\n30838: AnnotationAssertion(rdfs:comment obo:CL_4023070 \"caudal ganglionic eminence derived GABAergic interneuron\n30839: and caudal ganglionic eminence derived interneuron are the same cell type. \n\n(Showing lines 30750-30839 of 35547. Use offset=30840 to continue.)\n</content>","metadata":{"preview":"# Class: obo:CL_4023062 (dentate gyrus neuron)\n\nAnnotationAssertion(obo:IAO_0000115 obo:CL_4023062 \"A neuron with its soma located in the dentate gyrus of the hippocampus.\")\nAnnotationAssertion(terms:contributor obo:CL_4023062 <http://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(rdfs:label obo:CL_4023062 \"dentate gyrus neuron\")\nEquivalentClasses(obo:CL_4023062 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001885)))\n\n# Class: obo:CL_4023063 (medial ganglionic eminence derived interneuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023063 \"MGE interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023063 \"An interneuron that is derived from the medial ganglionic eminence.\")\nAnnotationAssertion(terms:contributor obo:CL_4023063 <http://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023063 \"MGE interneuron\")\nAnnotationAssertion(rdfs:label obo:CL_4023063 \"medial ganglionic eminence derived interneuron\")\nEquivalentClasses(obo:CL_4023063 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024)))\n\n# Class: obo:CL_4023064 (caudal ganglionic eminence derived interneuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023064 \"CGE interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824663\") obo:IAO_0000115 obo:CL_4023064 \"An interneuron that is derived from the caudal ganglionic eminence.\")","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778992465389