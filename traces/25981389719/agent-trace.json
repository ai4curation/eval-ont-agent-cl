783: # Class: obo:CL_4023065 (meis2 expressing cortical GABAergic cell)\n30784: \n30785: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023065 \"meis2 GABA\")\n30786: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") obo:IAO_0000115 obo:CL_4023065 \"A GABAergic cell located in the cerebral cortex that expresses meis2.\")\n30787: AnnotationAssertion(terms:contributor obo:CL_4023065 <https://orcid.org/0000-0001-7258-9596>)\n30788: AnnotationAssertion(oboInOwl:inSubset obo:CL_4023065 cl:BDS_subset)\n30789: AnnotationAssertion(rdfs:label obo:CL_4023065 \"meis2 expressing cortical GABAergic cell\")\n30790: SubClassOf(obo:CL_4023065 obo:CL_0000617)\n30791: SubClassOf(obo:CL_4023065 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30792: SubClassOf(obo:CL_4023065 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000010317))\n30793: \n30794: # Class: obo:CL_4023066 (horizontal pyramidal neuron)\n30795: \n30796: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023066 \"A pyramidal neuron which has an apical tree which is oriented parallel to the pia. This is unlike typical pyramidal neurons which have its apical dendrite aligned vertically.\")\n30797: AnnotationAssertion(terms:contributor obo:CL_4023066 <https://orcid.org/0000-0001-7258-9596>)\n30798: AnnotationAssertion(oboInOwl:inSubset obo:CL_4023066 cl:BDS_subset)\n30799: AnnotationAssertion(rdfs:label obo:CL_4023066 \"horizontal pyramidal neuron\")\n30800: EquivalentClasses(obo:CL_4023066 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070016)))\n30801: \n30802: # Class: obo:CL_4023067 (obsolete Martinotti morphology L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus))\n30803: \n30804: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023067 \"OBSOLETE A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has Martinotti morphology.\")\n30805: Annotati