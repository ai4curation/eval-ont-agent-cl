otation(oboInOwl:hasDbXref \"PMID:17303398\") obo:IAO_0000115 obo:CL_0000928 \"A type I NK T cell that has been recently activated, secretes interferon-gamma and interleukin-4, and has phenotype CD4-negative, CD8-negative, CD69-positive, and downregulated NK markers.\")\n12238:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000928 \"activated CD4-negative, CD8-negative type I NK T lymphocyte\")\n12239:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000928 \"activated CD4-negative, CD8-negative type I NK T-cell\")\n12240:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000928 \"activated CD4-negative, CD8-negative type I NK T-lymphocyte\")\n12241:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000928 \"activated CD4-negative, CD8-negative type I NKT cell\")\n12242:AnnotationAssertion(rdfs:label obo:CL_0000928 \"activated CD4-negative, CD8-negative type I NK T cell\")\n12273:# Class: obo:CL_0000931 (activated type II NK T cell)\n12275:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17964217\") obo:IAO_0000115 obo:CL_0000931 \"A type II NK T cell that has been recently activated, secretes interferon-gamma and interleukin-4, and has the phenotype CD69-positive and downregulated NK markers.\")\n12276:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000931 \"activated type II NK T lymphocyte\")\n12277:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000931 \"activated type II NK T-cell\")\n12278:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000931 \"activated type II NK T-lymphocyte\")\n12279:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000931 \"activated type II NKT cell\")\n12280:AnnotationAssertion(rdfs:label obo:CL_0000931 \"activated type II NK T cell\")\n12286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17964217\") obo:IAO_0000115 obo:CL_0000932 \"A type II NK T cell that has been recently activated, secretes interferon-gamma, and has the phenotype CD69-positive and downregulated NK markers.\")\n12299:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17964217\") obo:IAO_0000115 obo:CL_0000933 \"A type II NK T cell that has been recently activated, secretes interleukin-4, and has the phenotype CD69-positive and downregulated NK markers.\")\n12580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:msz\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17992590\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"PMID:8006591\") obo:IAO_0000115 obo:CL_0000961 \"A follicular B cell that is IgD-positive, CD23-negative, and CD38-negative. This naive cell type is activated in the extrafollicular areas through interaction with interdigitating dendritic cells and antigen-specific CD4-positive T cells.\")\n12592:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:msz\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:17992590\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"PMID:8006591\") obo:IAO_0000115 obo:CL_0000962 \"A follicular B cell that is IgD-positive and CD23-positive and CD38-positive. This naive cell type is activated in the extrafollicular areas via interaction with dendritic cells and antigen specific T cells.\")\n12800:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:msz\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2673126\") obo:IAO_0000115 obo:CL_0000980 \"An activated mature (naive or memory) B cell that is secreting immunoglobulin, typified by being CD27-positive, CD38-positive, CD138-negative.\")\n13115:AnnotationAssertion(rdfs:comment obo:CL_0001014 \"These markers are associated with human cells. Originally described in the dendritic cell ontology (DC_CL:0000026)(PMID:19243617). These cells are also CD281-positive (TLR1), CD282-positive (TLR2), CD284-positive (TLR4), CD286-positive (TLR6), CD287-positive (TLR7), and CD290-positive (TLR10). When activated, these cells are capable of producing IL-6, IL-8, and IL-15.\")\n13139:AnnotationAssertion(rdfs:comment obo:CL_0001017 \"Originally described in the dendritic cell ontology (DC_CL:0000029)(PMID:19243617). When activated, these cells produce IL-6, IL-8, and IL-15.\")\n13367:# Class: obo:CL_0001043 (activated CD4-positive, alpha-beta T cell, human)\n13369:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001043 \"A recently activated CD4-positive, alpha-beta T cell with the phenotype HLA-DRA-positive, CD38-positive, CD69-positive, CD62L-negative, CD127-negative, and CD25-positive.\")\n13370:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22343568\") oboInOwl:hasBroadSynonym obo:CL_0001043 \"activated CD4+ T cell\")\n13371:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001043 \"activated CD4-positive, alpha-beta T lymphocyte, human\")\n13372:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001043 \"activated CD4-positive, alpha-beta T-cell, human\")\n13373:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001043 \"activated CD4-positive, alpha-beta T-lymphocyte, human\")\n13374:AnnotationAssertion(rdfs:comment obo:CL_0001043 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD4+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD4+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13375:AnnotationAssertion(rdfs:label obo:CL_0001043 \"activated CD4-positive, alpha-beta T cell, human\")\n13427:# Class: obo:CL_0001048 (activated CD4-positive, CD25-positive, CCR4-positive, alpha-beta regulatory T cell, human)\n13430:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22343568\") oboInOwl:hasExactSynonym obo:CL_0001048 \"activated CCR4+ Treg\")\n13431:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001048 \"activated CD4-positive, CD25-positive, CCR4-positive, alpha-beta regulatory T lymphocyte\")\n13432:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001048 \"activated CD4-positive, CD25-positive, CCR4-positive, alpha-beta regulatory T-cell\")\n13433:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001048 \"activated CD4-positive, CD25-positive, CCR4-positive, alpha-beta regulatory T-lymphocyte\")\n13434:AnnotationAssertion(rdfs:comment obo:CL_0001048 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CCR4+ Treg'.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13435:AnnotationAssertion(rdfs:label obo:CL_0001048 \"activated CD4-positive, CD25-positive, CCR4-positive, alpha-beta regulatory T cell, human\")\n13439:# Class: obo:CL_0001049 (activated CD8-positive, alpha-beta T cell, human)\n13441:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001049 \"A recently activated CD8-positive, alpha-beta T cell with the phenotype HLA-DRA-positive, CD38-positive, CD69-positive, CD62L-negative, CD127-negative, CCR7-negative, and CD25-positive.\")\n13442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22343568\") oboInOwl:hasBroadSynonym obo:CL_0001049 \"activated CD8+ T cell\")\n13443:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001049 \"activated CD8-positive, alpha-beta T lymphocyte, human\")\n13444:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001049 \"activated CD8-positive, alpha-beta T-cell, human\")\n13445:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0001049 \"activated CD8-positive, alpha-beta T-lymphocyte, human\")\n13446:AnnotationAssertion(rdfs:comment obo:CL_0001049 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD8+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD8+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD8+ T cells, as activated mouse T cells do not express MHC class II.\")\n13447:AnnotationAssertion(rdfs:label obo:CL_0001049 \"activated CD8-positive, alpha-beta T cell, human\")\n15019:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002101 \"A CD38-positive naive B cell is a mature B cell that has the phenotype CD38-positive, surface IgD-positive, surface IgM-positive, and CD27-negative, and that has not yet been activated by antigen in the periphery.\")\n15033:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002102 \"A CD38-negative naive B cell is a mature B cell that has the phenotype CD38-negative, surface IgD-positive, surface IgM-positive, and CD27-negative, that has not yet been activated by antigen in the periphery.\")\n15126:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002109 \"A B220-positive CD38-positive naive B cell is a CD38-positive naive B cell that has the phenotype B220-positive, CD38-positive, surface IgD-positive, surface IgM-positive, and CD27-negative, and that has not yet been activated by antigen in the periphery.\")\n15144:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002110 \"A B220-low CD38-positive naive B cell is a CD38-positive naive B cell that has the phenotype B220-low, CD38-positive, surface IgD-positive, surface IgM-positive, and CD27-negative, that has not yet been activated by antigen in the periphery.\")\n15550:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015622\") Annotation(oboInOwl:hasDbXref \"PMID:12673090\") obo:IAO_0000115 obo:CL_0002150 \"Epithelioid macrophage is an activated macrophage that resembles an epithelial cell with finely granular, pale eosinophilic cytoplasm and central, ovoid nucleus (oval or elongate). This cell type is able to merge into one another to form aggregates. The presence of such aggregates may characterize some pathologic conditions, mainly granulomatous inflammation.\")\n17590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18719589\") obo:IAO_0000115 obo:CL_0002335 \"A preadipocyte that is capable of differentiating into a brown adipocyte. This cell type expresses uncoupling protein-1, PPAR-gamma, PR-domain-containing 16; and PGC-1alpha (peroxisome proliferator-activated receptor-gamma (PPARgamma) coactivator-1alpha).\")\n17606:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15339667\") Annotation(oboInOwl:hasDbXref \"PMID:20568222\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") obo:IAO_0000115 obo:CL_0002337 \"A stem cell found in the basal layer of the epidermis, hair follicle, and sebaceous gland, characterised by its quiescent nature, high proliferative potential, and capacity for long-term self-renewal. This cell maintains epidermal homeostasis by producing transit-amplifying cells that differentiate to replenish the stratified squamous epithelium.\")\n18518:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002428 \"activated double-positive thymocyte\")\n18520:EquivalentClasses(obo:CL_0002428 ObjectIntersectionOf(obo:CL_0000809 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0000586) ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0008283)))\n19516:AnnotationAssertion(rdfs:comment obo:CL_0002529 \"Reside in the dermis. They are also CD11c-positive, CD40-positive, CD207-negative (langerin), CD209-negative (DC-SIGN), and CD324-negative (E-cadherin). When activated, they are capable of producing CXCL8 (IL-8) and IL-15. Possibly a precursor of Langerhans cells or equivalent of langerin-positive dermal DCs in the mouse.\")\n20434:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002627 \"activated astrocyte\")\n20444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18396103\") oboInOwl:hasExactSynonym obo:CL_0002628 \"quiescent microglia\")\n20453:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18396103\") oboInOwl:hasExactSynonym obo:CL_0002629 \"activated microglia\")\n22606:Covers cells actively being cultured or stored in a quiescent state for future use.\")\n22620:Covers cells actively being cultured or stored in a quiescent state for future use.\")\n22774:# Class: obo:CL_0008012 (quiescent skeletal muscle satellite cell)\n22776:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21849021\") Annotation(oboInOwl:hasDbXref \"PMID:23303905\") obo:IAO_0000115 obo:CL_0008012 \"A skeletal muscle satellite cell that is mitotically quiescent.  These cells are wedge shaped and have a large nuclear to cytoplasmic ratio with few organelles, a small nucleus and condensed interphase chromatin. Satellite cells typically remain in this state until activated following muscle damage.\")\n22777:AnnotationAssertion(rdfs:label obo:CL_0008012 \"quiescent skeletal muscle satellite cell\")\n22802:# Class: obo:CL_0008016 (activated skeletal muscle satellite cell)\n22805:AnnotationAssertion(rdfs:label obo:CL_0008016 \"activated skeletal muscle satellite cell\")\n23539:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:8011279\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865/\") Annotation(oboInOwl:hasDbXref \"https://www.arppress.org/v/vspfiles/assets/images/Chapter1T25LymphNodes.pdf\") obo:IAO_0000115 obo:CL_0009037 \"A B lymphocyte that resides in the mantle zone of the lymph node germinal center. These are generally IgM and IgD positive activated B cells that form a 'corona' around the germinal center and are part of the establishment of a secondary lymphatic follicule.\")\n23807:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009064 \"A T cell located in the lymph node paracortex, where macrophages and dendritic cells present antigenic peptides to these naïve T cells, stimulating them to become activated helper T cells or cytotoxic T lymphocytes.\")\n27393:# Class: obo:CL_1000695 (kidney interstitial alternatively activated macrophage)\n27396:AnnotationAssertion(rdfs:label obo:CL_1000695 \"kidney interstitial alternatively activated macrophage\")\n27545:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9127003\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1152/physrev.1998.78.3.723\") rdfs:comment obo:CL_1000742 \"Like smooth muscle, a glomerular mesangial cell is contractile and possesses the filaments actin and myosin. The contractile mechanism is also similar to that of smooth muscle, with Ca2+/calmodulin-activated myosin light-chain kinase instigating myosin-actin cross-bridge cycling. Mesangial cell phagocytosis of apoptotic neutrophils involves a novel CD36-independent, alpha(v)beta3/TSP-mediated mechanism that is uncoupled from chemokine secretion, emphasizing the injury-limiting potential of mesangial cell phagocytosis of apoptotic cells.\")\n31416:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-7431-4139>) Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:35176508\") obo:IAO_0000115 obo:CL_4030026 \"An enterocyte of the human intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.\")\n31469:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\n32597:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") rdfs:comment obo:CL_4033083 \"Often in literature squamous granulosa cell and pre-granulosa cell are used as synonyms. However, this term only makes reference to the quiescent granulosa cells that surround the primordial ovarian follicle, while a pre-granulosa cell proliferates to form the primordial follicle (and thus cells become the squamous granulosa cells).\")\n33570:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047051 \"An enterocyte of the human small intestine expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These enterocytes have a disinctive transcriptomic profile and are scattered through the small intestine epithelium.\")\n33579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24223998\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_4047052 \"An enterocyte of the human colon expressing bestrophin-4 (BEST4) calcium-activated ion channels.  These cells have a distinct transcriptomic profile compared to other enterocytes and are scattered through the colon epithelium.\")\n33967:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\n34585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34469623\") Annotation(oboInOwl:hasDbXref \"PMID:37957320\") Annotation(oboInOwl:hasDbXref \"PMID:39719709\") obo:IAO_0000115 obo:CL_4072017 \"A GABAergic neuron located in the arcuate nucleus of the hypothalamus that expresses agouti-related protein (AgRP). This neuron can coexpress AgRP, GABA, and neuropeptide Y (NPY) in mice, and plays a key role in integrating metabolic signals. It is activated by hunger-related hormones such as ghrelin and inhibited by satiety signals like leptin.\")\n","exit_code":0,"status":"completed"}}
