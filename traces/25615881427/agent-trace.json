:UBERON_0002048)))\n32661:SubClassOf(obo:CL_4033036 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001786))\n32669:EquivalentClasses(obo:CL_4033037 ObjectIntersectionOf(obo:CL_0000319 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007196) ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8410077)))\n32682:SubClassOf(obo:CL_4033038 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048))\n32694:SubClassOf(obo:CL_4033039 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048))\n32732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33382972\") Annotation(oboInOwl:hasDbXref \"PMID:35017701\") Annotation(oboInOwl:hasDbXref \"PMID:36211428\") obo:IAO_0000115 obo:CL_4033043 \"A macrophage that is part of the lung connective tissue (pulmonary interstitium). This cell performs tissue remodeling and contributes to barrier immunity through antigen presentation.\")\n32739:SubClassOf(obo:CL_4033043 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000114))\n32743:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31558434\") Annotation(oboInOwl:hasDbXref \"PMID:331922198\") Annotation(oboInOwl:hasDbXref \"PMID:36883528\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4033044 \"An epithelial cell part of respiratory tract epithelium that is a precursor of a multi-ciliated cell. This cell actively amplifies centrioles, a required step for multiciliogenesis.\")\n32750:SubClassOf(obo:CL_4033044 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802))\n32799:SubClassOf(obo:CL_4033048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004802))\n32804:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1111/j.1096-3642.1981.tb01137.x\") Annotation(oboInOwl:hasDbXref \"PMID:10052456\") Annotation(oboInOwl:hasDbXref \"PMID:28655883\") Annotation(oboInOwl:hasDbXref \"http://www.nejohnston.org/Birds/documents/AvianTongues_Johnston.pdf\") obo:IAO_0000115 obo:CL_4033049 \"A taste receptor cell that is part of a taste bud of a tongue.\")\n32809:EquivalentClasses(obo:CL_4033049 ObjectIntersectionOf(obo:CL_0000209 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014451)))\n32854:SubClassOf(obo:CL_4033053 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001792))\n32858:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24928499\") Annotation(oboInOwl:hasDbXref \"PMID:27889329\") obo:IAO_0000115 obo:CL_4033054 \"A cell that is adjacent to a vessel. A perivascular cell plays a crucial role in maintaining vascular function and tissue homeostasis. This cell type regulates vessel integrity and flow dynamics.\")\n32862:EquivalentClasses(obo:CL_4033054 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0002049)))\n32872:EquivalentClasses(obo:CL_4033055 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8410077) ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600014) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n32881:SubClassOf(obo:CL_4033056 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008198))\n32951:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28287163\") obo:IAO_0000115 obo:CL_4033061 \"An endothelial cell that is part of a central vein of liver.\")\n32955:EquivalentClasses(obo:CL_4033061 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006841)))\n32985:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36113384\") obo:IAO_0000115 obo:CL_4033064 \"A tissue-resident macrophage that is part of the uterus.\")\n32991:EquivalentClasses(obo:CL_4033064 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n33009:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17639032\") Annotation(oboInOwl:hasDbXref \"PMID:32759216\") Annotation(oboInOwl:hasDbXref \"PMID:33970370\") Annotation(oboInOwl:hasDbXref \"PMID:38178246\") obo:IAO_0000115 obo:CL_4033066 \"A supporting cell that is part of the ovary and differentiates into a granulosa cell. A pre-granulosa cell develops from an early supporting gonadal cell by repressing testis determination, which can then proliferate to form primordial follicles.\")\n33018:SubClassOf(obo:CL_4033066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\n33032:SubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000992))\n33046:SubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003981))\n33061:SubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001305))\n33089:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033087 \"A tissue-resident macrophage that is part of the placenta. This cell helps preventing immunological rejection of the fetus by modulating the immune environment. A placental resident macrophage has high plasticity to adapt to the changing needs of each phase of pregnancy.\")\n33095:EquivalentClasses(obo:CL_4033087 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001987)))\n33099:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") obo:IAO_0000115 obo:CL_4033088 \"A resident macrophage that is part of the decidua. Some decidual macrophages are derived from maternal blood monocytes that are recruited to the uterus shortly after conception. The main functions of a decidual macrophage are implantation, placental development, immune regulation and vascular remodeling.\")\n33107:SubClassOf(obo:CL_4033088 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002450))\n33138:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468586\") obo:IAO_0000115 obo:CL_4033092 \"An enterocyte that is part of a duodenal epithelium and expresses beta-1,3-glucuronyltransferase 1 (B3GAT1), also known as CD57 or HNK-1.\")\n33146:EquivalentClasses(obo:CL_4033092 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008346) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001440)))\n33150:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20614614\") Annotation(oboInOwl:hasDbXref \"PMID:29105366\") Annotation(oboInOwl:hasDbXref \"PMID:36983561\") Annotation(oboInOwl:hasDbXref \"PMID:37768272\") obo:IAO_0000115 obo:CL_4033093 \"A stem cell that is part of the corneo-scleral limbus. This cell type resides at the basal layer of the epithelium and has a small size and high nuclear to cytoplasmatic ratio (Secker and Daniels, 2009). A limbal stem cell is responsible for corneal epithelial renewal and repair (Li et al., 2023), and to help maintain a clear corneal surface by preventing conjunctival epithelial cells from migrating onto the cornea (Wang et al., 2023).\")\n33159:EquivalentClasses(obo:CL_4033093 ObjectIntersectionOf(obo:CL_0000034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006761)))\n33161:SubClassOf(obo:CL_4033093 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000482))\n33196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25051267\") Annotation(oboInOwl:hasDbXref \"PMID:25223880\") obo:IAO_0000115 obo:CL_4033097 \"A specialised endothelial cell that is part of the canal of Schlemm. This cell type shares characteristics and expresses markers of both blood and lymphatic endothelial cells (Kizhatil et al., 2014) and regulates aqueous humor outflow resistance by modulating pore formation and responding to mechanical strain (Stamer et al., 2015).\")\n33203:EquivalentClasses(obo:CL_4033097 ObjectIntersectionOf(obo:CL_0000115 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004029)))\n33250:SubClassOf(obo:CL_4040001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003124))\n33260:EquivalentClasses(obo:CL_4040002 ObjectIntersectionOf(obo:CL_0000125 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002005)))\n33278:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0819-0473>) obo:IAO_0000115 obo:CL_4040004 \"Any mesenchymal stem cell of adipose tissue that is part of an orbital region.\")\n33285:EquivalentClasses(obo:CL_4040004 ObjectIntersectionOf(obo:CL_0002570 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004088)))\n33289:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30834270\") Annotation(oboInOwl:hasDbXref \"PMID:34026757\") obo:IAO_0000115 obo:CL_4040005 \"A mesenchymal stem cell that is part of the apical papilla tooth root.\")\n33298:SubClassOf(obo:CL_4040005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003677))\n33302:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28553007\") obo:IAO_0000115 obo:CL_4040006 \"A chromatophore that is part of the dermis.\")\n33307:SubClassOf(obo:CL_4040006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002067))\n33317:SubClassOf(obo:CL_4042001 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33335:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37232741\") Annotation(oboInOwl:hasDbXref \"PMID:37626977\") obo:IAO_0000115 obo:CL_4042003 \"A central nervous system macrophage that is part of a choroid plexus, a meninx and a perivascular space. A border associated macrophage interacts with various components of the CNS vasculature and meninges, it participates in immune surveillance and in the regulation of the blood brain barrier.\")\n33347:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") Annotation(oboInOwl:hasDbXref \"PMID:37232741\") obo:IAO_0000115 obo:CL_4042004 \"A choroid plexus macrophage that is part of the apical surface of some choroid plexus epithelium. This macrophage has a star-like shaped body.\")\n33355:SubClassOf(obo:CL_4042004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003911))\n33359:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38347231\") obo:IAO_0000115 obo:CL_4042005 \"A choroid plexus macrophage that is part of a choroid plexus stroma.\")\n33366:SubClassOf(obo:CL_4042005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005206))\n33370:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31061494\") obo:IAO_0000115 obo:CL_4042006 \"A border associated macrophage which is part of a dura matter. This macrophage phagocytoses intruding pathogens and foreign molecules detected in the bloodstream or in the cerebrospinal fluid. This cell has an amoeboid body with dynamic protrusions in homeostasis.\")\n33376:SubClassOf(obo:CL_4042006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002092))\n33386:SubClassOf(obo:CL_4042007 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33396:SubClassOf(obo:CL_4042008 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002316))\n33400:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19279265\") Annotation(oboInOwl:hasDbXref \"PMID:30552685\") Annotation(oboInOwl:hasDbXref \"PMID:31435019\") Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:34616062\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4042009 \"An astrocyte type that presents radial protrusions across the layers of a cortex. The soma of this astrocyte is part of the first layer of a neocortex. This astrocyte extents its protrusions transversally to the deeper layers of a cortex and it creates contact with neurons, the pia matter and capillaries. This astrocyte is involved in facilitating the communication across neurons, astrocytes, capillaries, meninges and the cerebrospinal fluid.\")\n33406:SubClassOf(obo:CL_4042009 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33410:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042010 \"An interlaminar astrocyte whose soma is part of the first layer of a neocortex and is in contact with a pia surface.\")\n33418:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32930323\") Annotation(oboInOwl:hasDbXref \"PMID:37139179\") obo:IAO_0000115 obo:CL_4042011 \"An interlaminar astrocyte type whose soma is part of the upper first layer of the neocortex and its processes extend to a pia surface.\")\n33423:SubClassOf(obo:CL_4042011 ObjectSomeValuesFrom(obo:RO_0002170 obo:UBERON_0002361))\n33445:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n33446:SubClassOf(obo:CL_4042013 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n33460:SubClassOf(obo:CL_4042014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001950))\n33478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4042016 \"A serous secreting cell that is part of a submucosal gland in the nasal cavity respiratory epithelium.\")\n33485:SubClassOf(obo:CL_4042016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005385))\n33486:SubClassOf(obo:CL_4042016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011148))\n33500:SubClassOf(obo:CL_4042017 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004642))\n33514:SubClassOf(obo:CL_4042018 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0001932))\n33519:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16344112\") Annotation(oboInOwl:hasDbXref \"PMID:26578855\") Annotation(oboInOwl:hasDbXref \"PMID:29351662\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Tanycyte\") obo:IAO_0000115 obo:CL_4042019 \"A type of tanycyte located in ventral part of the lateral wall of the third ventricle and in the lateral infundibular recess of the brain. This tanycyte has an elongated morphology with multiple microvilli extending into the median eminence. This type of tanycyte expresses FGF receptors 1 and 2, is in contact with GnRH neurons, and is involved in the release of gonadotropin-releasing hormone (GnRH).\")\n33527:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006250))\n33528:SubClassOf(obo:CL_4042019 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0002197))\n33543:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006250))\n33544:SubClassOf(obo:CL_4042020 ObjectSomeValuesFrom(obo:RO_0002131 obo:UBERON_0002197))\n33558:SubClassOf(obo:CL_4042021 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n33571:SubClassOf(obo:CL_4042022 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n33585:SubClassOf(obo:CL_4042023 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33648:SubClassOf(obo:CL_4042029 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000956))\n33661:SubClassOf(obo:CL_4042030 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n33688:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n33689:SubClassOf(obo:CL_4042032 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\n33695:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25870542\") Annotation(oboInOwl:hasDbXref \"PMID:28192062\") obo:IAO_0000115 obo:CL_4042033 \"A neuron of the central nervous system that expresses POMC and synthesizes the POMC precursor polypeptide. This neuron type is located in the arcuate nucleus of the hypothalamus and in the nucleus tractus solitarius of the brainstem. The pro-opiomelanocortin neuron is part of the central melanocortin system and it is involved in regulating energy homeostasis, metabolism, and appetite. This neuronal type responds to hormonal signals such as levels of leptin and insulin, and its activation results in the release of α-melanocyte-stimulating hormone (α-MSH), which acts on melanocortin receptors to suppress food intake and increase energy expenditure.\")\n33715:SubClassOf(obo:CL_4042034 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001017))\n33724:EquivalentClasses(obo:CL_4042035 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002974) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n33746:SubClassOf(obo:CL_4042037 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n33767:SubClassOf(obo:CL_4042039 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026))\n33774:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22498715\") Annotation(oboInOwl:hasDbXref \"PMID:30498197\") Annotation(oboInOwl:hasDbXref \"PMID:33785138\") rdfs:comment obo:CL_4042040 \"The glutametergic neurons in the basal ganglia are part of a series of different circuits such as the corticolstriatal circuit, which is involved in regulating voluntary movements. The subthalamic nucleus circuit, which is involved in modulating the output of the basal ganglia, particularly in controlling movement initiation and inhibition. The thalamocortical loop, which is involved in refining motor movements and integrating sensory information with motor commanding.\")\n33777:SubClassOf(obo:CL_4042040 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002420))\n33838:EquivalentClasses(obo:CL_4047017 ObjectIntersectionOf(obo:CL_0009010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013740)))\n33844:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28049136\") Annotation(oboInOwl:hasDbXref \"PMID:36060223\") obo:IAO_0000115 obo:CL_4047018 \"An enterocyte that is part of the colon, in the early stages of differentiation, located in the intestinal crypt-villus axis.\")\n33849:EquivalentClasses(obo:CL_4047018 ObjectIntersectionOf(obo:CL_4047019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000397)))\n33857:EquivalentClasses(obo:CL_4047019 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013740)))\n33861:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\n33866:EquivalentClasses(obo:CL_4047023 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004780) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278)))\n33873:EquivalentClasses(obo:CL_4047025 ObjectIntersectionOf(obo:CL_0000508 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001276)))\n33905:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21443757\") Annotation(oboInOwl:hasDbXref \"PMID:33630273\") obo:IAO_0000115 obo:CL_4047034 \"A smooth muscle cell that is part of the muscularis externa of the stomach wall. It is characterized by its fusiform shape, involuntary control, and ability to generate slow, sustained contractions. This cell is organized in distinct layers and is essential for gastric motility and digestion.\")\n33909:EquivalentClasses(obo:CL_4047034 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008856)))\n33925:EquivalentClasses(obo:CL_4047036 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008857)))\n33934:EquivalentClasses(obo:CL_4047037 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008862)))\n33943:SubClassOf(obo:CL_4047038 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439))\n33952:SubClassOf(obo:CL_4047040 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012368))\n33962:SubClassOf(obo:CL_4047042 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002439))\n33972:SubClassOf(obo:CL_4047043 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009566))\n33982:SubClassOf(obo:CL_4047044 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000429))\n33991:SubClassOf(obo:CL_4047045 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000030))\n34003:SubClassOf(obo:CL_4047047 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001809))\n34013:SubClassOf(obo:CL_4047048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006660))\n34021:EquivalentClasses(obo:CL_4047051 ObjectIntersectionOf(obo:CL_0000584 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001902) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n34022:SubClassOf(obo:CL_4047051 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001902))\n34087:EquivalentClasses(obo:CL_4047101 ObjectIntersectionOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281)))\n34098:EquivalentClasses(obo:CL_4052001 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004670) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0031514) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0010007)))\n34112:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:35810168\") Annotation(oboInOwl:hasDbXref \"PMID:38051275\") obo:IAO_0000115 obo:CL_4052003 \"A capillary endothelial cell that is part of the intestinal villus. This cell is highly fenestrated, with fenestrations most numerous at the villus tips, and plays a vital role in nutrient absorption and maintaining the selective permeability of the intestinal barrier.\")\n34118:EquivalentClasses(obo:CL_4052003 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001213)))\n34123:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\n34132:SubClassOf(obo:CL_4052004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001962))\n34136:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\n34141:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001243))\n34142:SubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012375))\n34146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\n34154:SubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\n34159:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n34167:SubClassOf(obo:CL_4052007 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0001277))\n34171:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\n34178:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:CL_0002250))\n34179:SubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013739))\n34183:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\n34192:SubClassOf(obo:CL_4052009 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013740))\n34203:SubClassOf(obo:CL_4052010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012186))\n34216:SubClassOf(obo:CL_4052011 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004693))\n34228:EquivalentClasses(obo:CL_4052012 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000157)))\n34242:EquivalentClasses(obo:CL_4052013 ObjectIntersectionOf(obo:CL_0000503 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000156)))\n34247:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16607697\") Annotation(oboInOwl:hasDbXref \"PMID:27124642\") Annotation(oboInOwl:hasDbXref \"PMID:28396983\") Annotation(oboInOwl:hasDbXref \"PMID:33200981\") obo:IAO_0000115 obo:CL_4052014 \"A capillary endothelial cell that is part of islet of Langerhans, characterized by a high density of fenestrations —approximately ten times greater than those in exocrine pancreatic capillaries. These fenestrations facilitate efficient hormone exchange, which is essential for maintaining glucose homeostasis. The cell's structure and function are regulated by the local production of vascular endothelial growth factor-A (VEGF-A), which maintains its fenestrated architecture.\")\n34253:EquivalentClasses(obo:CL_4052014 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000006)))\n34258:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") obo:IAO_0000115 obo:CL_4052015 \"Any capillary endothelial cell that is part of an endocrine gland.\")\n34262:EquivalentClasses(obo:CL_4052015 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002368)))\n34266:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10810312\") Annotation(oboInOwl:hasDbXref \"PMID:32910242\") obo:IAO_0000115 obo:CL_4052016 \"A capillary endothelial cell that is part of the pituitary gland. This cell is characterized by its fenestrated structure which facilitates the efficient transport of hormones and other signaling molecules, essential for endocrine signalling.\")\n34271:EquivalentClasses(obo:CL_4052016 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000007)))\n34276:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18480313\") Annotation(oboInOwl:hasDbXref \"PMID:32375819\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK27998/\") obo:IAO_0000115 obo:CL_4052017 \"A capillary endothelial cell that is part of the choroid plexus, characterized by its fenestrated nature with 60 to 80 nm fenestrations and lack of tight junctions. This fenestrated structure allows for the rapid delivery of water and other components, aiding in the production of cerebrospinal fluid (CSF).\")\n34280:EquivalentClasses(obo:CL_4052017 ObjectIntersectionOf(obo:CL_0002144 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001886)))\n34285:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Fallopian_tube\") obo:IAO_0000115 obo:CL_4052018 \"Any epithelial cell that is part of the fallopian tube.\")\n34291:EquivalentClasses(obo:CL_4052018 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34295:AnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\n34301:SubClassOf(obo:CL_4052019 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889))\n34330:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31183831\") Annotation(oboInOwl:hasDbXref \"PMID:31613440\") obo:IAO_0000115 obo:CL_4052022 \"A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.\")\n34337:EquivalentClasses(obo:CL_4052022 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003889)))\n34341:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32929266\") Annotation(oboInOwl:hasDbXref \"PMID:36581776\") Annotation(oboInOwl:hasDbXref \"PMID:38559249\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052023 \"An epithelial cell that is part of the endometrial luminal epithelium, forming a continuous layer lining the uterine cavity. This cell undergoes cyclical changes during the menstrual cycle, proliferating under estrogen in the proliferative phase, and differentiating under progesterone in the secretory phase to prepare for potential implantation. During the window of implantation, this cell changes from a tall columnar shape to a shorter columnar or cuboidal form, loses polarity, and becomes receptive to blastocyst implantation.\")\n34346:EquivalentClasses(obo:CL_4052023 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032940)))\n34350:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasDbXref \"PMID:38398025\") obo:IAO_0000115 obo:CL_4052024 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.\")\n34362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33037211\") Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") obo:IAO_0000115 obo:CL_4052025 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.\")\n34374:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727990\") Annotation(oboInOwl:hasDbXref \"PMID:35908794\") Annotation(oboInOwl:hasDbXref \"PMID:36361732\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2024.05.15.594276\") obo:IAO_0000115 obo:CL_4052026 \"A fast type II muscle cell that is part of the skeletal muscle tissue. This cell is characterized by its intermediate metabolic profile, utilizing both glycolytic and oxidative pathways for energy production. In humans, it is distinguished by the expression of myosin heavy chain 1 (MYH1).\")\n34384:SubClassOf(obo:CL_4052026 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001134))\n34398:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Uterine_natural_killer_cells\") obo:IAO_0000115 obo:CL_4052028 \"A natural killer cell that is part of the uterus, specifically within the endometrium during the non-pregnant state and in the decidua during pregnancy. This cell exhibits dynamic changes in frequency throughout the menstrual cycle, with lower levels during menstruation and a significant increase during the mid-secretory phase and early pregnancy.\")\n34404:EquivalentClasses(obo:CL_4052028 ObjectIntersectionOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000995)))\n34413:SubClassOf(obo:CL_4052029 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002048))\n34422:EquivalentClasses(obo:CL_4052030 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005734)))\n34436:SubClassOf(obo:CL_4052031 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002051))\n34452:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") Annotation(oboInOwl:hasDbXref \"PMID:37863104\") obo:IAO_0000115 obo:CL_4052033 \"A tuft cell that is part of the extrahepatic biliary tree, including the gallbladder and extrahepatic bile ducts. It shares a core genetic program with intestinal tuft cells but has unique tissue-specific genes. Biliary tuft cell functions as a bile acid-sensitive regulator, suppressing inflammation and modulating microbiome-dependent neutrophil infiltration in biliary tissues. Unlike its intestinal counterparts, this cell decreases in number postnatally as bile acid production matures, with its abundance negatively regulated by bile acids.\")\n34462:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:35668088\") Annotation(oboInOwl:hasDbXref \"PMID:36351364\") Annotation(oboInOwl:hasDbXref \"PMID:36961668\") obo:IAO_0000115 obo:CL_4052034 \"A tuft cell that is part of the medullary epithelium of the thymus, characterized by lateral microvilli and specific markers, including L1CAM in both mice (Zhang et al., 2022) and humans (Sun et al., 2023), as well as MHC II in mice (Miller et al., 2018). This cell is pivotal in immune functions such as antigen presentation, central tolerance, and type 2 immunity. A tuft cell in the thymus exhibits characteristics of both a medullary thymic epithelial cell (mTEC) and a peripheral tuft cell. Its development is governed by transcription factors such as POU2F3.\")\n34468:EquivalentClasses(obo:CL_4052034 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003846)))\n34469:SubClassOf(obo:CL_4052034 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002124))\n34474:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:32717220\") obo:IAO_0000115 obo:CL_4052035 \"A tuft cell that is part of the epithelium of pancreatic duct. Present in humans and rats, this cell is absent in the murine pancreas under normal conditions but emerges during acinar-to-ductal metaplasia triggered by injury, inflammation, or oncogenic mutations. It modulates the immune response and protects against pancreatic ductal adenocarcinoma progression by producing suppressive eicosanoids, such as prostaglandin D2. A tuft cell in the pancreatic duct highly expresses the transcription factor POU2F3, which is essential for its development and presence.\")\n34480:EquivalentClasses(obo:CL_4052035 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009970)))\n34484:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052036 \"A tuft cell that is part of the nasal cavity epithelium, located in both the respiratory and olfactory epithelia of the nose. This cell plays key roles in chemosensation, lipid mediator production, immune responses, and epithelial homeostasis.\")\n34490:EquivalentClasses(obo:CL_4052036 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005384)))\n34494:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") obo:IAO_0000115 obo:CL_4052037 \"A tuft cell that is part of the olfactory epithelium, characterized by a globular body and the expression of neurogranin (Nrgn) in mice. This cell plays a crucial role in allergen recognition and regulating olfactory stem cell proliferation via TRPM5-dependent ATP sensing and cysteinyl leukotriene production. Unlike nasal respiratory tuft cells, it has low to absent expression of taste receptors, including the G protein Gα gustducin, and rarely contacts olfactory sensory neurons directly.\")\n34503:EquivalentClasses(obo:CL_4052037 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001997)))\n34508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n34515:EquivalentClasses(obo:CL_4052038 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005385)))\n34519:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\n34523:EquivalentClasses(obo:CL_4052039 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003359)))\n34527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:38117182\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.02.16.480779\") obo:IAO_0000115 obo:CL_4052040 \"A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.\")\n34532:EquivalentClasses(obo:CL_4052040 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001276)))\n34536:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\n34540:EquivalentClasses(obo:CL_4052041 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010062)))\n34545:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\n34553:EquivalentClasses(obo:CL_4052042 ObjectIntersectionOf(obo:CL_0002204 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002325)))\n34558:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052045 \"A stromal cell that is part of the ovarian stroma, characterized by its ability to synthesize steroid hormones.\")\n34565:EquivalentClasses(obo:CL_4052045 ObjectIntersectionOf(obo:CL_0000499 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006960) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0120178)))\n34569:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052046 \"A luteal cell that is part of the young, developing corpus luteum. This cell promotes progesterone synthesis, marked by high Parm1 expression in mice (Lan et al., 2024). An early luteal cell is associated with steroidogenesis and cell growth, contributing to early corpus luteum function and maturation.\")\n34579:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31803139\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2024.12.15.628550\") obo:IAO_0000115 obo:CL_4052047 \"A luteal cell that is part of the older, regressing corpus luteum. This cell exhibits increased expression of genes involved in progesterone metabolism - Akr1c18 in mice (Lan et al., 2024), cell cycle arrest, and apoptosis. A late luteal cell contributes to corpus luteum regression and eventual clearance from the ovary through luteolysis.\")\n34589:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n34598:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014727))\n34599:SubClassOf(obo:CL_4052048 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34603:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n34610:EquivalentClasses(obo:CL_4052049 ObjectIntersectionOf(obo:CL_0000075 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014729)))\n34612:SubClassOf(obo:CL_4052049 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0015766))\n34618:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36273006\") obo:IAO_0000115 obo:CL_4052050 \"An epithelial cell that is part of an endometrium luminal epithelium.\")\n34623:EquivalentClasses(obo:CL_4052050 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011949)))\n34678:EquivalentClasses(obo:CL_4052058 ObjectIntersectionOf(obo:CL_0000242 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34700:EquivalentClasses(obo:CL_4052061 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n34710:SubClassOf(obo:CL_4052062 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001705))\n34719:SubClassOf(obo:CL_4052063 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005273))\n34723:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28098391\") Annotation(oboInOwl:hasDbXref \"PMID:30969555\") Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") Annotation(oboInOwl:hasDbXref \"PMID:7679137\") obo:IAO_0000115 obo:CL_4052064 \"A keratinocyte that is part of the nail matrix epithelium, distinguished by its high proliferative capacity and its role in nail plate formation via onychokeratinization, a differentiation process that uniquely bypasses the formation of a granular layer, resulting in the production of hard, compact keratin. Unlike skin epidermal keratinocytes, this cell expresses a distinctive mix of hard (hair-type) and select epidermal keratins (Kitahara and Ogawa, 1993). In humans, LGR6 and WNT6 are enriched in the basal compartment, with LGR6 marking nail stem cells in both mice and humans, and exhibiting strong expression in the human proximal nail matrix (Kim et al., 2021).\")\n34728:EquivalentClasses(obo:CL_4052064 ObjectIntersectionOf(obo:CL_0000312 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002283)))\n34736:EquivalentClasses(obo:CL_4052065 ObjectIntersectionOf(obo:CL_0000313 obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0013232)))\n34746:EquivalentClasses(obo:CL_4052066 ObjectIntersectionOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0014717)))\n34761:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n34767:SubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n34779:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_8600124))\n34809:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34821:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34833:SubClassOf(obo:CL_4070012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34845:SubClassOf(obo:CL_4070013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34857:SubClassOf(obo:CL_4070014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34869:SubClassOf(obo:CL_4070015 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34881:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34893:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34904:SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34914:SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34936:SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n34947:SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))\n34959:SubClassOf(obo:CL_4072007 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002691))\n34968:SubClassOf(obo:CL_4072008 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002770))\n34978:SubClassOf(obo:CL_4072009 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932))\n34983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33318433\") Annotation(oboInOwl:hasDbXref \"PMID:37816347\") obo:IAO_0000115 obo:CL_4072010 \"A type of dopaminergic neuron located in the rostro-medial part of the zona incerta. It is involved in nociception and prehensile movement.\")\n34987:SubClassOf(obo:CL_4072010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0036007))\n34996:SubClassOf(obo:CL_4072011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002322))\n35005:SubClassOf(obo:CL_4072012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002622))\n35015:SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005377))\n35028:SubClassOf(obo:CL_4072014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002689))\n35037:SubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281))\n35058:SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932))\n35077:SubClassOf(obo:CL_4072019 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002034))\n35099:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n35388:EquivalentClasses(obo:CL_4072102 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979)))\n35399:EquivalentClasses(obo:CL_4072103 ObjectIntersectionOf(obo:CL_0000134 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\n35410:EquivalentClasses(obo:CL_4072104 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995)))\n35419:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\n35448:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:27443500\") obo:IAO_0000115 obo:CL_7770005 \"A trabecular meshwork cell that is part of the eye's trabecular meshwork, residing in the uveal and corneoscleral meshwork regions and serving as the primary biological filter in the aqueous humor drainage cascade. This cell exhibits endothelial-like properties, including production of antithrombogenic substances such as tissue plasminogen activator, while also demonstrating phagocytic activity to remove cellular debris from aqueous humour before the fluid moves deeper into the less porous juxtacanalicular tissue.\")\n35454:SubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005969))\n35543:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000160)) obo:CL_0000164)\n35544:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000945)) obo:CL_0000164)\n35545:SubClassOf(ObjectIntersectionOf(obo:CL_0000163 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001264)) obo:CL_