L_0000702 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000971))\n9875:SubClassOf(obo:CL_0000705 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000971))\n9879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:15561411\") Annotation(oboInOwl:hasDbXref \"PMID:9550134\") obo:IAO_0000115 obo:CL_0000706 \"A specialized ependymal cell that is part of the choroid plexus epithelium, responsible for producing cerebrospinal fluid (CSF) by selectively filtering and modifying blood plasma components before secreting it into the brain and spinal cord. This cell is characterized by a brush border on its apical surface, which enhances the secretion of CSF.\")\n9886:EquivalentClasses(obo:CL_0000706 ObjectIntersectionOf(obo:CL_0000065 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003911)))\n9895:SubClassOf(obo:CL_0000707 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000971))\n9902:EquivalentClasses(obo:CL_0000708 ObjectIntersectionOf(obo:CL_0000327 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003210)))\n9911:SubClassOf(obo:CL_0000709 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000971))\n9938:EquivalentClasses(obo:CL_0000712 ObjectIntersectionOf(obo:CL_0000362 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002069)))\n9940:SubClassOf(obo:CL_0000712 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003))\n9984:SubClassOf(obo:CL_0000718 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000971))\n10030:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:085199377X\") obo:IAO_0000115 obo:CL_0000726 \"An asexual 1-celled spore (primarily for perennation, not dissemination). Originates endogenously and singly within part of a pre-existing cell by the contraction of the protoplast. Possesses an inner secondary and often thickened hyaline or brown wall, usually impregnated with hydrophobic material.\")\n10068:EquivalentClasses(obo:CL_0000731 ObjectIntersectionOf(obo:CL_0000244 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000365)))\n10127:SubClassOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002405))\n10149:SubClassOf(obo:CL_0000740 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\n10163:SubClassOf(obo:CL_0000742 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010996))\n10167:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") Annotation(oboInOwl:hasDbXref \"PMID:15951842\") Annotation(oboInOwl:hasDbXref \"PMID:25321476\") Annotation(oboInOwl:hasDbXref \"PMID:35179487\") obo:IAO_0000115 obo:CL_0000743 \"A chondrocyte that is part of the hypertrophic cartilage zone. This cell is significantly enlarged and characterised by high expression of type X collagen (COL10A1) in both humans and mice. It actively coordinates endochondral ossification by mineralising the extracellular matrix, attracting blood vessels via angiogenic signalling, and mediating the transition from cartilage to bone - often by transdifferentiating into an osteoblast rather than undergoing apoptosis.\")\n10170:EquivalentClasses(obo:CL_0000743 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008187)))\n10189:SubClassOf(obo:CL_0000745 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0003902))\n10205:EquivalentClasses(obo:CL_0000746 ObjectIntersectionOf(obo:CL_0000187 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007100) ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030017) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002478) ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0060047)))\n10223:EquivalentClasses(obo:CL_0000748 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001791)))\n10247:SubClassOf(obo:CL_0000751 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008925))\n10248:SubClassOf(obo:CL_0000751 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008926))\n10264:SubClassOf(obo:CL_0000753 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008922))\n10269:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") Annotation(oboInOwl:hasDbXref \"PMID:27565351\") obo:IAO_0000115 obo:CL_0000754 \"An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The dendritic tree is not well filled and the dendrites are more delicate than in type 1 cells. The axon terminal is bushier and exhibits a dense plexus of varicosities in the inner part of sublamina 1 (Ghosh et al., 2004).  It can be differentiated from other retinal bipolar neurons by its expression of marker genes: Neto1, Lhx3 and Irx-6 (Shekhar, 2016).\")\n10274:SubClassOf(obo:CL_0000754 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008922))\n10283:SubClassOf(obo:CL_0000755 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008923))\n10293:SubClassOf(obo:CL_0000756 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008923))\n10294:SubClassOf(obo:CL_0000756 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008924))\n10304:SubClassOf(obo:CL_0000757 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008924))\n10313:SubClassOf(obo:CL_0000758 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008925))\n10322:SubClassOf(obo:CL_0000759 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008925))\n10331:SubClassOf(obo:CL_0000760 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008925))\n10332:SubClassOf(obo:CL_0000760 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008926))\n10341:SubClassOf(obo:CL_0000761 ObjectSomeValuesFrom(obo:RO_0002102 obo:UBERON_0008926))\n10524:EquivalentClasses(obo:CL_0000777 ObjectIntersectionOf(obo:CL_0000864 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0002320) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0019882) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0048771)))\n10716:EquivalentClasses(obo:CL_0000793 ObjectIntersectionOf(obo:CL_0000624 ObjectSomeValuesFrom(obo:RO_0001025 o