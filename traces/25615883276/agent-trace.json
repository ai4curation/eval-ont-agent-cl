ertion(oboInOwl:creation_date obo:CL_0002320 \"2010-09-15T03:01:54Z\"^^xsd:dateTime)\n17466:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002320 \"CALOHA:TS-2096\")\n17467:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002320 \"FMA:63875\")\n17468:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002320 \"MESH:D003239\")\n17469:AnnotationAssertion(rdfs:label obo:CL_0002320 \"connective tissue cell\")\n17470:EquivalentClasses(obo:CL_0002320 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002384)))\n17914:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\n17963:EquivalentClasses(obo:CL_0002367 ObjectIntersectionOf(obo:CL_0002320 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005969)))\n17964:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0002367 obo:CL_0002320)\n19327:EquivalentClasses(obo:CL_0002503 ObjectIntersectionOf(obo:CL_0002320 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005742)))\n19329:SubClassOf(obo:CL_0002503 obo:CL_0002320)\n19894:EquivalentClasses(obo:CL_0002564 ObjectIntersectionOf(obo:CL_0002320 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002242)))\n19895:SubClassOf(obo:CL_0002564 obo:CL_0002320)\n20246:EquivalentClasses(obo:CL_0002602 ObjectIntersectionOf(obo:CL_0002320 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004715)))\n20247:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0002602 obo:CL_0002320)\n24261:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20209607\") Annotation(oboInOwl:hasDbXref \"PMID:24814904\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009100 \"A fibroblast located in the portal triad. Hepatic portal fibroblast are a non-parenchymal cell population located adjacent to bile duct epithelia in liver and are distinct from stellate cells. They differentiate into fibrogenic myofibroblasts during chronic injury states producing high levels of collagen.\")\n25082:SubClassOf(obo:CL_0017004 obo:CL_0002320)\n25243:EquivalentClasses(obo:CL_0019002 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0007196)))\n25429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10675641\") Annotation(oboInOwl:hasDbXref \"PMID:33193034\") obo:IAO_0000115 obo:CL_0020005 \"An otic fibrocyte that is part of the spiral ligament. This cell is crucial in maintaining the endocochlear potential, regulating blood flow, participating in immune responses by secreting chemokines including MCP-1 and MIP-2, and producing extracellular matrix proteins such as collagen and cochlin.\")\n25522:SubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003675))\n25658:EquivalentClasses(obo:CL_1000217 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004129)))\n26772:AnnotationAssertion(obo:IAO_0100001 obo:CL_1000406 obo:CL_0002320)\n27655:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23486523\") Annotation(oboInOwl:hasDbXref \"PMID:27262400\") Annotation(oboInOwl:hasDbXref \"PMID:35703942\") obo:IAO_0000115 obo:CL_1000693 \"A stromal cell that infiltrates and resides in the kidney interstitium following injury, characterized by the co-expression of CD45 with mesenchymal markers including α-SMA, and collagen I in humans (Kim et al., 2023). This cell originates from circulating monocyte-derived fibrocytes. It produces extracellular matrix components, contributing to renal fibrosis by potentially differentiating into myofibroblasts upon infiltration into injured kidneys (Sun et al., 2016). Migration into the kidney is dependent on chemokine receptor signaling, particularly CCR2 in mice (Reich et al., 2013).\")\n28842:EquivalentClasses(obo:CL_1001607 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010996)))\n29803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:29266210\") Annotation(oboInOwl:hasDbXref \"PMID:35212000\") Annotation(oboInOwl:hasDbXref \"PMID:36232952\") Annotation(oboInOwl:hasDbXref \"PMID:37646029\") obo:IAO_0000115 obo:CL_2000096 \"A fibroblast of dermis that resides in the deep reticular layer, characterised by robust extracellular matrix production with high type I collagen deposition forming densely packed, organised fibrillar networks (Ghetti et al., 2018). This cell exhibits pro-fibrotic properties during wound healing, entering wounds early where it proliferates and deposits collagen to restore dermal architecture (Knoedler et al., 2023; McAndrews et al., 2022). It is distinguished from papillary dermal fibroblasts by expression of COL11A1, POSTN, and SPP1 in humans (Wu et al., 2022).\")\n32387:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Perichondrium\") obo:IAO_0000115 obo:CL_4033025 \"A fibroblast that is part of the fibrous layer of the perichondrium. This cell is responsible for collagen fiber production.\")\n33702:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\n34000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n34076:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n34154:EquivalentClasses(obo:CL_4052020 ObjectIntersectionOf(obo:CL_4033040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34167:EquivalentClasses(obo:CL_4052021 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34289:EquivalentClasses(obo:CL_4052032 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003490)))\n34892:SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003846))\n","exit_code":0,"status":"completed"}}
