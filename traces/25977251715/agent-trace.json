oboInOwl:hasDbXref \"PMID:20130169\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023064 \"CGE-derived interneuron\")\n30777: AnnotationAssertion(rdfs:label obo:CL_4023064 \"caudal ganglionic eminence derived interneuron\")\n30778: EquivalentClasses(obo:CL_4023064 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004026)))\n30779: SubClassOf(obo:CL_4023064 obo:CL_4042039)\n30780: SubClassOf(obo:CL_4023064 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30781: SubClassOf(obo:CL_4023064 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n30782: \n30783: # Class: obo:CL_4023065 (meis2 expressing cortical GABAergic cell)\n30784: \n30785: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023065 \"meis2 GABA\")\n30786: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") obo:IAO_0000115 obo:CL_4023065 \"A GABAergic cell located in the cerebral cortex that expresses meis2.\")\n30787: AnnotationAssertion(terms:contributor obo:CL_4023065 <https://orcid.org/0000-0001-7258-9596>)\n30788: AnnotationAssertion(oboInOwl:inSubset obo:CL_4023065 cl:BDS_subset)\n30789: AnnotationAssertion(rdfs:label obo:CL_4023065 \"meis2 expressing cortical GABAergic cell\")\n30790: SubClassOf(obo:CL_4023065 obo:CL_0000617)\n30791: SubClassOf(obo:CL_4023065 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\n30792: SubClassOf(obo:CL_4023065 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000010317))\n30793: \n30794: # Class: obo:CL_4023066 (horizontal pyramidal neuron)\n30795: \n30796: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30715238\") obo:IAO_0000115 obo:CL_4023066 \"A pyramidal neuron which has an apical tree which is oriented parallel to the pia. This is unlike typical pyramidal neurons which have its apical dendrite aligned vertically.\")\n30797: AnnotationAssertion(terms:contributor obo:CL_4023066 <https://orcid.org/0000-0001-7258-9596>)\n30798: AnnotationAssertion(oboInOwl:inSubset obo:CL_4023066 cl:BDS_subset)\n30799: AnnotationAssertion(rdfs:label obo:CL_4023066 \"horizontal pyramidal neuron\")\n30800: EquivalentClasses(obo:CL_4023066 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070016)))\n30801: \n30802: # Class: obo:CL_4023067 (obsolete Martinotti morphology L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus))\n30803: \n30804: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023067 \"OBSOLETE A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has Martinotti morphology.\")\n30805: AnnotationAssertion(obo:IAO_0000233 obo:CL_4023067 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n30806: AnnotationAssertion(obo:IAO_0100001 obo:CL_4023067 obo:PCL_1000004)\n30807: AnnotationAssertion(terms:contributor obo:CL_4023067 <https://orcid.org/0000-0001-7258-9596>)\n30808: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023067 \"Martinotti L2/3 PV-like SST (Mus)\")\n30809: AnnotationAssertion(rdfs:comment obo:CL_4023067 \"Moved to PCL. Use PCL:1000004 instead.\")\n30810: AnnotationAssertion(rdfs:label obo:CL_4023067 \"obsolete Martinotti morphology L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus)\")\n30811: AnnotationAssertion(owl:deprecated obo:CL_4023067 \"true\"^^xsd:boolean)\n30812: \n30813: # Class: obo:CL_4023068 (thalamic excitatory neuron)\n30814: \n30815: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30083593\") Annotation(oboInOwl:hasDbXref \"PMID:31196673\") Annotation(oboInOwl:hasDbXref \"PMID:35278647\") Annotation(oboInOwl:hasDbXref \"PMID:37163009\") Annotation(oboInOwl:hasDbXref \"PMID:37824663\") Annotation(oboInOwl:hasDbXref \"PMID:38739251\") obo:IAO_0000115 obo:CL_4023068 \"An excitatory neuron that has its soma located in the thalamic complex. This neuron type can be involved in a series of circuits related to sensory integration, motor integration, pain processing, social behaviour and reward response.\")\n30816: AnnotationAssertion(terms:contributor obo:CL_4023068 <http://orcid.org/0000-0001-7258-9596>)\n30817: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11532718\") Annotation(oboInOwl:hasDbXref \"PMID:30083593\") Annotation(oboInOwl:hasDbXref \"PMID:38739251\") rdfs:comment obo:CL_4023068 \"Abnormalities in glutametergic neurons of the thalamic complex are associated with pathologies such as schizophrenia, colorectal visceral pain and Parkinson's disease.\")\n30818: AnnotationAssertion(rdfs:label obo:CL_4023068 \"thalamic excitatory neuron\")\n30819: EquivalentClasses(obo:CL_4023068 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0010225) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061535)))\n30820: \n30821: # Class: obo:CL_4023069 (medial ganglionic eminence derived GABAergic interneuron)\n30822: \n30823: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023069 \"MGE gaba interneuron\")\n30824: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12637172\") obo:IAO_0000115 obo:CL_4023069 \"A GABAergic interneuron that develops from the medial ganglionic eminence and has migrated to the cerebral cortex.\")\n30825: AnnotationAssertion(terms:contributor obo:CL_4023069 <https://orcid.org/0000-0001-7258-9596>)\n30826: AnnotationAssertion(rdfs:label obo:CL_4023069 \"medial ganglionic eminence derived GABAergic interneuron\")\n30827: EquivalentClasses(obo:CL_4023069 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n30828: SubClassOf(obo:CL_4023069 obo:CL_4023063)\n30829: \n30830: # Class: obo:CL_4023070 (obsolete caudal ganglionic eminence derived GABAergic cortical interneuron)\n30831: \n30832: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023070 \"CGE gaba cortical interneuron\")\n30833: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20130169\") obo:IAO_0000115 obo:CL_4023070 \"OBSOLETE. A GABAergic cortical interneuron that develops from the caudal ganglionic eminence and has migrated to the cerebral cortex.\")\n30834: AnnotationAssertion(obo:IAO_0000233 obo:CL_4023070 <https://github.com/obophenotype/cell-ontology/pull/2374>)\n30835: AnnotationAssertion(obo:IAO_0100001 obo:CL_4023070 obo:CL_4023064)\n30836: AnnotationAssertion(terms:contributor obo:CL_4023070 <https://orcid.org/0000-0001-7258-9596>)\n30837: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023070 \"CGE cortical interneuron\")\n30838: AnnotationAssertion(rdfs:comment obo:CL_4023070 \"caudal ganglionic eminence derived GABAergic interneuron\n30839: and caudal ganglionic eminence derived interneuron are the same cell type. \n30840: The two must be merged and one needs to be defined as obsolete. \n30841: We decided to deprecate the entity with the more specific term and redundant qualities \n30842: in the label. See comments in issue 2357.\")\n30843: AnnotationAssertion(rdfs:label obo:CL_4023070 \"obsolete caudal ganglionic eminence derived GABAergic cortical interneuron\")\n30844: AnnotationAssertion(owl:deprecated obo:CL_4023070 \"true\"^^xsd:boolean)\n30845: \n30846: # Class: obo:CL_4023071 (L5/6 cck GABAergic interneuron (Mmus))\n30847: \n30848: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023071 \"L5/6 cck interneuron (Mus)\")\n30849: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023071 \"A GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\n\n(Showing lines 30740-30849 of 35547. Use offset=30850 to continue.)\n</content>","metadata":{"preview":"SubClassOf(obo:CL_4023060 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001954))\n\n# Class: obo:CL_4023061 (hippocampal CA4 neuron)\n\nAnnotationAssertion(Annotation(oboI