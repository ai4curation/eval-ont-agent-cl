{"type":"tool_use","timestamp":1778554456486,"sessionID":"ses_1e5ea6106ffeWHVb8VWlV1NJcd","part":{"type":"tool","tool":"grep","callID":"chatcmpl-tool-b3b2a0459166a2e6","state":{"status":"completed","input":{"include":"src/ontology/cl-edit.owl","pattern":"epithelial cell"},"output":"Found 834 matches (showing first 100)\n/home/runner/work/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl:\n  Line 4452: # Class: obo:CL_0000066 (epithelial cell)\n\n  Line 4461: AnnotationAssertion(rdfs:label obo:CL_0000066 \"epithelial cell\")\n\n  Line 4467: # Class: obo:CL_0000067 (ciliated epithelial cell)\n\n  Line 4469: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000067 \"An epithelial cell that has a cilia.\")\n\n  Line 4471: AnnotationAssertion(rdfs:label obo:CL_0000067 \"ciliated epithelial cell\")\n\n  Line 4474: # Class: obo:CL_0000068 (duct epithelial cell)\n\n  Line 4476: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000068 \"An epithelial cell that is part of a duct.\")\n\n  Line 4477: AnnotationAssertion(rdfs:label obo:CL_0000068 \"duct epithelial cell\")\n\n  Line 4481: # Class: obo:CL_0000069 (branched duct epithelial cell)\n\n  Line 4483: AnnotationAssertion(rdfs:label obo:CL_0000069 \"branched duct epithelial cell\")\n\n  Line 4486: # Class: obo:CL_0000070 (obsolete epithelial cell of gland)\n\n  Line 4488: AnnotationAssertion(rdfs:label obo:CL_0000070 \"obsolete epithelial cell of gland\")\n\n  Line 4499: # Class: obo:CL_0000072 (non-branched duct epithelial cell)\n\n  Line 4501: AnnotationAssertion(rdfs:label obo:CL_0000072 \"non-branched duct epithelial cell\")\n\n  Line 4505: # Class: obo:CL_0000073 (obsolete barrier epithelial cell)\n\n  Line 4509: AnnotationAssertion(rdfs:label obo:CL_0000073 \"obsolete barrier epithelial cell\")\n\n  Line 4519: # Class: obo:CL_0000075 (columnar/cuboidal epithelial cell)\n\n  Line 4521: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0002065\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000075 \"A columnar/cuboidal epithelial cell is a cell usually found in a two dimensional sheet with a free surface. Columnar/cuboidal epithelial cells take on the shape of a column or cube.\")\n\n  Line 4522: AnnotationAssertion(rdfs:label obo:CL_0000075 \"columnar/cuboidal epithelial cell\")\n\n  Line 4525: # Class: obo:CL_0000076 (squamous epithelial cell)\n\n  Line 4528: AnnotationAssertion(rdfs:label obo:CL_0000076 \"squamous epithelial cell\")\n\n  Line 4533: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_0000077 \"A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement.\")\n\n  Line 4536: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\n\n  Line 4547: # Class: obo:CL_0000079 (stratified epithelial cell)\n\n  Line 4549: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/B978-0-12-410424-2.00003-2\") Annotation(oboInOwl:hasDbXref \"https://www.biologyonline.com/dictionary/stratified-epithelium\") obo:IAO_0000115 obo:CL_0000079 \"An epithelial cell, organized into multiple layers, with only the basal layer being in contact with the basement membrane.\")\n\n  Line 4550: AnnotationAssertion(rdfs:label obo:CL_0000079 \"stratified epithelial cell\")\n\n  Line 4569: # Class: obo:CL_0000082 (epithelial cell of lung)\n\n  Line 4571: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000082 \"An epithelial cell of the lung.\")\n\n  Line 4573: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000082 \"lung epithelial cell\")\n\n  Line 4574: AnnotationAssertion(rdfs:label obo:CL_0000082 \"epithelial cell of lung\")\n\n  Line 4577: # Class: obo:CL_0000083 (epithelial cell of pancreas)\n\n  Line 4579: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000083 \"An epithelial cell of the pancreas.\")\n\n  Line 4581: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000083 \"pancreas epithelial cell\")\n\n  Line 4582: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000083 \"pancreatic epithelial cell\")\n\n  Line 4583: AnnotationAssertion(rdfs:label obo:CL_0000083 \"epithelial cell of pancreas\")\n\n  Line 4751: # Class: obo:CL_0000098 (sensory epithelial cell)\n\n  Line 4753: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000098 \"A specialized epithelial cell involved in sensory perception. Restricted to special sense organs of the olfactory, gustatory, and vestibulocochlear receptor systems; contain sensory cells surrounded by supportive, non-receptive cells.\")\n\n  Line 4754: AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000098 \"neuroepithelial cell\")\n\n  Line 4756: AnnotationAssertion(rdfs:comment obo:CL_0000098 \"The term \\\"neuroepithelial cell\\\" is used to describe both this cell type and neurecto-epithelial cell (CL:0000710).\")\n\n  Line 4757: AnnotationAssertion(rdfs:label obo:CL_0000098 \"sensory epithelial cell\")\n\n  Line 4911: AnnotationAssertion(rdfs:comment obo:CL_0000115 \"From FMA: 9.07.2001: Endothelial cell has always been classified as a kind of epithelial cell, specifically a squamous cell but that is not true. First, endothelial cell can either be squamous or cuboidal (e.g. high-endothelial cell) and secondly, it has different embryological derivation (mesodermal) than a true epithelial cell (ectodermal and endodermal). The basis for present classification is the fact that it comprises the outermost layer or lining of anatomical structures (location-based) but a better structural basis for the differentia is the cytoskeleton of the cell. Endothelial cell has vimentin filaments while an epithelial cell has keratin filaments. [Onard].\")\n\n  Line 5237: # Class: obo:CL_0000146 (simple columnar epithelial cell)\n\n  Line 5239: AnnotationAssertion(rdfs:label obo:CL_0000146 \"simple columnar epithelial cell\")\n\n  Line 5269: # Class: obo:CL_0000150 (glandular secretory epithelial cell)\n\n  Line 5271: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ORCID:0000-0002-7073-9172\") obo:IAO_0000115 obo:CL_0000150 \"An epithelial cell, located in a gland, that is specialised for the synthesis and secretion of specific biomolecules, such as hormones, or mucous.\")\n\n  Line 5274: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000150 \"glandular epithelial cell\")\n\n  Line 5275: AnnotationAssertion(rdfs:label obo:CL_0000150 \"glandular secretory epithelial cell\")\n\n  Line 5310: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:21907708\") Annotation(oboInOwl:hasDbXref \"PMID:30571046\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Gastric_chief_cell\") obo:IAO_0000115 obo:CL_0000155 \"An epithelial cell of the stomach that is part of the fundic gastric gland. This cell is characterized by a basally located nucleus, abundant rough endoplasmic reticulum, and large apical secretory granules. It produces and secretes pepsinogen, the inactive precursor of the digestive enzyme pepsin.\")\n\n  Line 5356: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D020397\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Goblet_cell\") obo:IAO_0000115 obo:CL_0000160 \"A specialized, columnar, mucus secreting epithelial cell shaped like a flask or goblet. A narrow basal end contains the nucleus while the apical end is swollen by the accumulation of mucus laden secretory granules.  Short microvilli project from the apical plasma membrane.\")\n\n  Line 5377: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31613538\") Annotation(oboInOwl:hasDbXref \"PMID:31670611\") obo:IAO_0000115 obo:CL_0000162 \"An epithelial cell of the stomach that is part of the fundic gastric gland. This cell is characterized by its pyramidal shape, abundant mitochondria, and a complex network of secretory canaliculi lined with microvilli. It secretes hydrochloric acid into the stomach lumen and produces intrinsic factor, essential for vitamin B12 absorption.\")\n\n  Line 5580: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"MESH:D022781\") Annotation(oboInOwl:hasDbXref \"PMID:19717280\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatocyte\") obo:IAO_0000115 obo:CL_0000182 \"The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated.\")\n\n  Line 5605: # Class: obo:CL_0000185 (myoepithelial cell)\n\n  Line 5611: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000185 \"basket epithelial cell\")\n\n  Line 5613: AnnotationAssertion(rdfs:label obo:CL_0000185 \"myoepithelial cell\")\n\n  Line 5837: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000213 \"OBSOLETE. A cell within an epithelial cell sheet whose main function is to act as an internal or external covering for a tissue or an organism.\")\n\n  Line 6071: # Class: obo:CL_0000237 (keratinizing barrier epithelial cell)\n\n  Line 6073: AnnotationAssertion(rdfs:label obo:CL_0000237 \"keratinizing barrier epithelial cell\")\n\n  Line 6078: # Class: obo:CL_0000238 (non keratinizing barrier epithelial cell)\n\n  Line 6080: AnnotationAssertion(rdfs:label obo:CL_0000238 \"non keratinizing barrier epithelial cell\")\n\n  Line 6083: # Class: obo:CL_0000239 (brush border epithelial cell)\n\n  Line 6085: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000239 \"An epithelial cell characterized by the presence of a brush border on its apical surface, which increases the surface area for absorption.\")\n\n  Line 6088: AnnotationAssertion(rdfs:comment obo:CL_0000239 \"All brush border cells are columnar-cuboidal.  The formal logical definition of this term asserts this. Brush border epithelial cells are predominantly found lining the small intestine and the proximal tubules of the kidneys.\")\n\n  Line 6089: AnnotationAssertion(rdfs:label obo:CL_0000239 \"brush border epithelial cell\")\n\n  Line 6093: # Class: obo:CL_0000240 (stratified squamous epithelial cell)\n\n  Line 6095: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_squamous_epithelium\") obo:IAO_0000115 obo:CL_0000240 \"A stratified epithelial cell that is part of squamous epithelium, characterized by multiple layers of cells. The basal layer is directly attached to the basement membrane and the apical layer consists of flattened squamous cells. This provides a protective barrier, commonly found in areas subject to abrasion, such as the skin, oral cavity, and esophagus.\")\n\n  Line 6096: AnnotationAssertion(rdfs:label obo:CL_0000240 \"stratified squamous epithelial cell\")\n\n  Line 6100: # Class: obo:CL_0000241 (stratified cuboidal epithelial cell)\n\n  Line 6102: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_cuboidal_epithelium\") obo:IAO_0000115 obo:CL_0000241 \"A stratified epithelial cell that is part of cuboidal epithelium, characterized by multiple layers of cuboidal cells forming the apical layer. This provides a protective lining for ducts in large glands, such as sweat glands.\")\n\n  Line 6103: AnnotationAssertion(rdfs:label obo:CL_0000241 \"stratified cuboidal epithelial cell\")\n\n  Line 6109: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018862\") Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:24862916\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_0000242 \"A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.\")\n\n  Line 6127: # Class: obo:CL_0000244 (transitional epithelial cell)\n\n  Line 6131: AnnotationAssertion(rdfs:label obo:CL_0000244 \"transitional epithelial cell\")\n\n  Line 6555: # Class: obo:CL_0000307 (tracheal epithelial cell)\n\n  Line 6557: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000307 \"An epithelial cell found in the trachea.\")\n\n  Line 6560: AnnotationAssertion(rdfs:comment obo:CL_0000307 \"This class is for the vertebrate tracheal structure. For the analagous insect cell type, see 'respiratory tube epithelial cell'\")\n\n  Line 6561: AnnotationAssertion(rdfs:label obo:CL_0000307 \"tracheal epithelial cell\")\n\n  Line 6589: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19256306\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:29713660\") Annotation(oboInOwl:hasDbXref \"PMID:37873034\") obo:IAO_0000115 obo:CL_0000312 \"An epithelial cell of stratified squamous tissues, including skin, oral mucosa (Hiroshima et al., 2011), and esophagus (Whelan et al., 2018), that produces keratin proteins and secretes antimicrobial peptides to form a resilient barrier against environmental damage, dehydration, pathogens, and microbial invasion. It undergoes successive stages of differentiation marked by changes in keratin expression, supporting tissue integrity, wound repair, and contributing to immune defense.\")\n\n  Line 6630: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D012629\") Annotation(oboInOwl:hasDbXref \"PMID:19944183\") obo:IAO_0000115 obo:CL_0000317 \"An epithelial cell that is part of a sebaceous gland. This cell produces and secretes sebum, an oily, lipid-rich substance, through holocrine secretion where the entire cell ruptures to release its contents.\")\n\n  Line 6668: # Class: obo:CL_0000322 (pulmonary alveolar epithelial cell)\n\n  Line 6670: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") obo:IAO_0000115 obo:CL_0000322 \"An epithelial cell that lines the peripheral gas exchange region of the lungs of air-breathing vertebrates.\")\n\n  Line 6677: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolar epithelial cell\")\n\n  Line 6678: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"alveolus of lung epithelial cell\")\n\n  Line 6679: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000322 \"epithelial cell of alveolus of lung\")\n\n  Line 6682: AnnotationAssertion(rdfs:label obo:CL_0000322 \"pulmonary alveolar epithelial cell\")\n\n  Line 6969: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Flybase:dsj\") Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000362 \"An epithelial cell of the integument (the outer layer of an organism).\")\n\n  Line 6975: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:62411\") oboInOwl:hasNarrowSynonym obo:CL_0000362 \"epithelial cell of skin\")\n\n  Line 7317: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/hermaphrodite/hypodermis/mainframe.htm\") obo:IAO_0000115 obo:CL_0000411 \"An epithelial cell of the hypodermis of Caenorhabditis.\")\n\n  Line 7368: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/ver1/handbook/hypodermis/hypsupportother.htm#arcadecells\") obo:IAO_0000115 obo:CL_0000418 \"An epithelial cell found in C. elegans that firmly hold the outer body wall and the lips to the inner cylinder of the pharynx in a manner that keeps these organs from breaking apart, while still giving each organ freedom of movement during feeding.\")\n\n  Line 7381: # Class: obo:CL_0000420 (syncytial epithelial cell)\n\n  Line 7383: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000420 \"An epithelial cell that forms a syncytium, which is a multinucleated cell resulting from the fusion of multiple cells.\")\n\n  Line 7385: AnnotationAssertion(rdfs:label obo:CL_0000420 \"syncytial epithelial cell\")\n\n  Line 7444: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00412-016-0595-4\") obo:IAO_0000115 obo:CL_0000429 \"A columnar epithelial cell that is part of an insect imaginal disc.\")\n\n  Line 7445: AnnotationAssertion(rdfs:comment obo:CL_0000429 \"This term does not encompass all the cell types that may be found in an epithelial disc (such as the peripodial or adepithelial cells), only the cells that form the disc epithelium proper.\")\n\n  Line 7575: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69078\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000446 \"An epithelial cell of the parathyroid gland that is arranged in wide, irregular interconnecting columns; responsible for the synthesis and secretion of parathyroid hormone.\")\n\n  Line 7716: # Class: obo:CL_0000462 (adepithelial cell)\n\n  Line 7719: AnnotationAssertion(rdfs:label obo:CL_0000462 \"adepithelial cell\")\n\n  Line 7775: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000469 \"A neural progenitor cell that is the daughter of a neuroblast (sensu arthopoda).  The progeny of ganglion mother cells develop into neurons, glia and (occasionally) epithelial cells.\")\n\n  Line 7835: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000477 \"A somatic epithelial cell of the insect egg chamber.\")\n\n  Line 8007: # Class: obo:CL_0000500 (follicular epithelial cell)\n\n  Line 8010: AnnotationAssertion(rdfs:label obo:CL_0000500 \"follicular epithelial cell\")\n\n\n(Results truncated: showing 100 of 834 matches (734 hidden). Consider using a more specific path or pattern.)","metadata":{"matches":834,"truncated":true},"title":"epithelial cell","time":{"start":1778554456418,"end":1778554456485}},"id":"prt_e1a1b3b88001FQVfF11k0xjt8U","sessionID":"ses_1e5ea6106ffeWHVb8VWlV1NJcd","messageID":"msg_e1a1a25a2001upYLUCjaAq2FBC"}}
