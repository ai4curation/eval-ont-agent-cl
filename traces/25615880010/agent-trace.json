hasDbXref \"PMCID:PMC2613570\") Annotation(oboInOwl:hasDbXref \"PMID:10102814\") Annotation(oboInOwl:hasDbXref \"PMID:16923606\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:19960544\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Mesenchymal_stem_cell\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de/cope.cgi?key=mesenchymal%20stem%20cells\") obo:IAO_0000115 obo:CL_0000134 \"A connective tissue cell that normally gives rise to other cells that are organized as three-dimensional masses. In humans, this cell type is CD73-positive, CD90-positive, CD105-positive, CD45-negative, CD34-negative, and MHCII-negative. They may further differentiate into osteoblasts, adipocytes, myocytes, neurons, or chondroblasts in vitro. Originally described as residing in the bone marrow, this cell type is now known to reside in many, if not all, adult organs.\")\n5091:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"BTO:0002625\")\n5092:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"BTO:0003298\")\n5093:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000134 \"FMA:70546\")\n5094:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"bone marrow stromal cells\")\n5095:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11378515\") oboInOwl:hasNarrowSynonym obo:CL_0000134 \"marrow stromal cells\")\n5097:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"BMSC\")\n5098:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"CFU-F\")\n5099:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11378515\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"MSC\")\n5100:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal precursor cell\")\n5101:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D044982\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal progenitor cells\")\n5102:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stem cell\")\n5103:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stromal cell\")\n5104:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"mesenchymal stromal cells\")\n5105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D044982\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000134 \"stem cells, mesenchymal\")\n5106:AnnotationAssertion(rdfs:comment obo:CL_0000134 \"Many but not all mesenchymal cells derive from the mesoderm. MSCs are reportedly CD3-negative, CD4-negative, CD5-negative, CD8-negative, CD11a-negative, CD11b-negative, CD14-negative, CD19-negative, CD29-positive, CD31-negative, CD34-negative, CD38-negative, CD40-negative, CD44-positive, CD45-negative, CD49-positive, CD54-positive, CD66b-negative, CD79a-negative, CD80-negative, CD102-positive, CD106-positive, CD117-positive, CD121a-positive, CD121b-positive, CD123-positive, CD124-positive, CD133-negative, CD146-positive, CD166-positive, CD271-positive, B220-negative, Gr1-negative, MHCI-positive, MHCII-negative, SSEA4-negative, sca1-positive, Ter119-negative, and glycophorin A-negative. Cultured MSCs are capable of producing stem cell factor, IL7, IL8, IL11, TGF-beta, cofilin, galectin-1, laminin-receptor 1, cyclophilin A, and MMP-2.\")\n5107:AnnotationAssertion(rdfs:label obo:CL_0000134 \"mesenchymal stem cell\")\n5108:AnnotationAssertion(rdfs:seeAlso obo:CL_0000134 \"https://github.com/obophenotype/cell-ontology/issues/474\")\n5109:SubClassOf(obo:CL_0000134 obo:CL_0000048)\n5110:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_00001