ValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n34080:EquivalentClasses(obo:CL_4047052 ObjectIntersectionOf(obo:CL_1000347 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8NFU0)))\n34090:EquivalentClasses(obo:CL_4047053 ObjectIntersectionOf(obo:CL_0000235 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000016626)))\n34094:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28845904\") Annotation(oboInOwl:hasDbXref \"PMID:33681216\") Annotation(oboInOwl:hasDbXref \"PMID:34302064\") obo:IAO_0000115 obo:CL_4047054 \"A dendritic cell capable of capturing antigens in peripheral tissues and migrating through blood or lymphatic vessels to secondary lymphoid organs, where it presents processed antigens to T cells. It expresses MHC class II molecules and lacks lineage markers associated with other leukocyte populations, distinguishing it as a member of the dendritic cell lineage. This cell plays a pivotal role in initiating and regulating adaptive immune responses by linking peripheral antigen capture with T cell activation in lymphoid tissues.\")\n34119:EquivalentClasses(obo:CL_4047060 ObjectIntersectionOf(obo:CL_0000576 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000004621)))\n34246:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20628033\") Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_4052010 \"A stromal cell that serves as a precursor to the theca cell layers in the ovary growing follicles. This cell is present in the early stages of follicular growth, particularly in smaller follicles. Unlike mature theca cell, a pre-theca cell is initially non-steroidogenic and lacks luteinizing hormone receptors.\")\n34345:AnnotationAssertion(obo:IAO_0000115 obo:CL_4052019 \"Any epithelial cell that is part of the fallopian tube and lacks cilia.\")\n34363:EquivalentClasses(obo:CL_4052020 ObjectIntersectionOf(obo:CL_4033040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003472)))\n34376:EquivalentClasses(obo:CL_