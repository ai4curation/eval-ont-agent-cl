{"type":"tool_use","timestamp":1778979498995,"sessionID":"ses_1cc8fcfc1ffeVdeevBdyN2FfAy","part":{"type":"tool","tool":"read","callID":"call_9l3uLaIjHtAjois08ydbq0Dg","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":35380,"limit":260},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n35380: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072039 \"The marker set RORB, ST8SIA4 can identify the Human cell type L4 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.720108696 (NS-Forest FBeta value).\")\n35381: AnnotationAssertion(rdfs:label obo:CL_4072039 \"L4 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35382: SubClassOf(obo:CL_4072039 obo:CL_4030063)\n35383: SubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35384: SubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000066))\n35385: \n35386: # Class: obo:CL_4072040 (L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens))\n35387: \n35388: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\n35389: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00424-024-02923-2\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072040 \"A transcriptomically distinct intratelencepalic-projecting glutamatergic neuron that expresses Car3 with a soma found in L6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_cluster', L6 IT Car3.\")\n35390: AnnotationAssertion(obo:RO_0002175 obo:CL_4072040 obo:NCBITaxon_9606)\n35391: AnnotationAssertion(terms:contributor obo:CL_4072040 \"https://orcid.org/0000-0002-5507-2103\")\n35392: AnnotationAssertion(terms:date obo:CL_4072040 \"2025-09-10T10:23:11Z\"^^xsd:dateTime)\n35393: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4072040 \"L6 IT Car3 glutamatergic neuron (Homo sapiens)\")\n35394: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.06.515349\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 (Homo sapiens)\")\n35395: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6 IT Car3 neuron (Homo sapiens)\")\n35396: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.11.30.518285\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 (Homo sapiens)\")\n35397: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072040 \"L6-IT-Car3 cell (Homo sapiens)\")\n35398: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072040 \"The marker set SMYD1, THEMIS can identify the Human cell type L6 intratelencephalic projecting Car3 glutamatergic neuron in the neocortex with a confidence of 0.877752028 (NS-Forest FBeta value).\")\n35399: AnnotationAssertion(rdfs:label obo:CL_4072040 \"L6 intratelencephalic projecting Car3 glutamatergic neuron (Homo sapiens)\")\n35400: SubClassOf(obo:CL_4072040 obo:CL_4030068)\n35401: SubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35402: SubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000072))\n35403: \n35404: # Class: obo:CL_4072041 (L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens))\n35405: \n35406: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35407: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37609206\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4072041 \"A transcriptomically distinct intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.  The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: IT-projecting excitatory neurons', Author Categories: 'CrossArea_subclass', L6 IT.\")\n35408: AnnotationAssertion(obo:RO_0002175 obo:CL_4072041 obo:NCBITaxon_9606)\n35409: AnnotationAssertion(terms:contributor obo:CL_4072041 \"https://orcid.org/0000-0002-5507-2103\")\n35410: AnnotationAssertion(terms:date obo:CL_4072041 \"2025-09-11T14:38:02Z\"^^xsd:dateTime)\n35411: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072041 \"ILX:0770158\")\n35412: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072041 \"L6 IT (Homo sapiens)\")\n35413: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072041 cl:cellxgene_subset)\n35414: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\n35415: AnnotationAssertion(rdfs:label obo:CL_4072041 \"L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35416: SubClassOf(obo:CL_4072041 obo:CL_4030065)\n35417: SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35418: SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000071))\n35419: \n35420: # Class: obo:CL_4072042 (L5/6 near-projecting glutamatergic neuron (Homo sapiens))\n35421: \n35422: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35423: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\n35424: AnnotationAssertion(obo:RO_0002175 obo:CL_4072042 obo:NCBITaxon_9606)\n35425: AnnotationAssertion(terms:contributor obo:CL_4072042 \"https://orcid.org/0000-0002-5507-2103\")\n35426: AnnotationAssertion(terms:date obo:CL_4072042 \"2025-09-16T08:55:09Z\"^^xsd:dateTime)\n35427: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35428: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072042 cl:cellxgene_subset)\n35429: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\n35430: AnnotationAssertion(rdfs:label obo:CL_4072042 \"L5/6 near-projecting glutamatergic neuron (Homo sapiens)\")\n35431: SubClassOf(obo:CL_4072042 obo:CL_4030067)\n35432: SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35433: SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000069))\n35434: \n35435: # Class: obo:CL_4072043 (L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens))\n35436: \n35437: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072043 \"L5 ET glut (Homo sapiens)\")\n35438: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\n35439: AnnotationAssertion(obo:RO_0002175 obo:CL_4072043 obo:NCBITaxon_9606)\n35440: AnnotationAssertion(terms:contributor obo:CL_4072043 \"https://orcid.org/0000-0002-5507-2103\")\n35441: AnnotationAssertion(terms:date obo:CL_4072043 \"2025-09-16T09:26:37Z\"^^xsd:dateTime)\n35442: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\n35443: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\n35444: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\n35445: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\n35446: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\n35447: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\n35448: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:BDS_subset)\n35449: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:cellxgene_subset)\n35450: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\n35451: AnnotationAssertion(rdfs:label obo:CL_4072043 \"L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens)\")\n35452: SubClassOf(obo:CL_4072043 obo:CL_4023041)\n35453: SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35454: SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000067))\n35455: \n35456: # Class: obo:CL_4072044 (L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens))\n35457: \n35458: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072044 \"L6 CT glut (Homo sapiens)\")\n35459: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L6 CT.\")\n35460: AnnotationAssertion(obo:RO_0002175 obo:CL_4072044 obo:NCBITaxon_9606)\n35461: AnnotationAssertion(terms:contributor obo:CL_4072044 \"https://orcid.org/0000-0002-5507-2103\")\n35462: AnnotationAssertion(terms:date obo:CL_4072044 \"2025-09-16T09:42:20Z\"^^xsd:dateTime)\n35463: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4072044 \"L6 CT (Homo sapiens)\")\n35464: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:BDS_subset)\n35465: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:cellxgene_subset)\n35466: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072044 \"The marker set SEMA5B, ADAMTSL1, SULF1 can identify the Human cell type L6 corticothalamic-projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.631898455 (NS-Forest FBeta value).\")\n35467: AnnotationAssertion(rdfs:label obo:CL_4072044 \"L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens)\")\n35468: SubClassOf(obo:CL_4072044 obo:CL_4023042)\n35469: SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35470: SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000070))\n35471: \n35472: # Class: obo:CL_4072045 (L6b glutamatergic cortical neuron (Homo sapiens))\n35473: \n35474: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072045 \"L6b glut (Homo sapiens)\")\n35475: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072045 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neuron', Author Categories: 'CrossArea_subclass', cluster L6b.\")\n35476: AnnotationAssertion(obo:RO_0002175 obo:CL_4072045 obo:NCBITaxon_9606)\n35477: AnnotationAssertion(terms:contributor obo:CL_4072045 \"https://orcid.org/0000-0002-5507-2103\")\n35478: AnnotationAssertion(terms:date obo:CL_4072045 \"2025-09-16T10:30:38Z\"^^xsd:dateTime)\n35479: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072045 \"ILX:0770163\")\n35480: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:BDS_subset)\n35481: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072045 cl:cellxgene_subset)\n35482: AnnotationAssertion(rdfs:label obo:CL_4072045 \"L6b glutamatergic cortical neuron (Homo sapiens)\")\n35483: SubClassOf(obo:CL_4072045 obo:CL_4023038)\n35484: SubClassOf(obo:CL_4072045 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35485: \n35486: # Class: obo:CL_4072046 (pvalb chandelier GABAergic interneuron (Homo sapiens))\n35487: \n35488: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072046 \"chandelier PV interneuron (Homo sapiens)\")\n35489: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072046 \"A transcriptomically definined GABAergic interneuron of the human pallium.  These cells correspond to the classically defined pvalb chandelier neuron type. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Chandelier.\")\n35490: AnnotationAssertion(obo:RO_0002175 obo:CL_4072046 obo:NCBITaxon_9606)\n35491: AnnotationAssertion(terms:contributor obo:CL_4072046 \"https://orcid.org/0000-0002-5507-2103\")\n35492: AnnotationAssertion(terms:date obo:CL_4072046 \"2025-09-29T10:07:47Z\"^^xsd:dateTime)\n35493: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072046 \"ILX:0107356\")\n35494: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"Chandelier PV (Homo sapiens)\")\n35495: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4072046 \"chandelier pvalb GABAergic interneuron (Homo sapiens)\")\n35496: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:BDS_subset)\n35497: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072046 cl:cellxgene_subset)\n35498: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072046 \"The marker set GPR149, CA8 can identify the Human cell type chandelier pvalb GABAergic cortical interneuron in the neocortex with a confidence of 0.799748111 (NS-Forest FBeta value).\")\n35499: AnnotationAssertion(rdfs:label obo:CL_4072046 \"pvalb chandelier GABAergic interneuron (Homo sapiens)\")\n35500: SubClassOf(obo:CL_4072046 obo:CL_4023036)\n35501: SubClassOf(obo:CL_4072046 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35502: SubClassOf(obo:CL_4072046 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000063))\n35503: \n35504: # Class: obo:CL_4072102 (Purkinje layer interneuron)\n35505: \n35506: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") obo:IAO_0000115 obo:CL_4072102 \"A type of GABAergic interneuron residing in the Purkinje cell layer of the cerebellar cortex.\")\n35507: AnnotationAssertion(terms:date obo:CL_4072102 \"2025-04-29T13:06:36Z\"^^xsd:dateTime)\n35508: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35803588\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072102 \"PLI\")\n35509: AnnotationAssertion(rdfs:label obo:CL_4072102 \"Purkinje layer interneuron\")\n35510: EquivalentClasses(obo:CL_4072102 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979)))\n35511: SubClassOf(obo:CL_4072102 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35512: \n35513: # Class: obo:CL_4072103 (hair follicle dermal stem cell)\n35514: \n35515: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasDbXref \"PMID:29691589\") Annotation(oboInOwl:hasDbXref \"PMID:35036581\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_4072103 \"A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle's mesenchymal compartments.\")\n35516: AnnotationAssertion(terms:contributor obo:CL_4072103 <https://orcid.org/0009-0000-8480-9277>)\n35517: AnnotationAssertion(oboInOwl:creation_date obo:CL_4072103 \"2025-11-05T11:49:53Z\"^^xsd:dateTime)\n35518: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38016881\") oboInOwl:hasNarrowSynonym obo:CL_4072103 \"dermal sheath cup cell\")\n35519: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25465495\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072103 \"hfDSC\")\n35520: AnnotationAssertion(rdfs:label obo:CL_4072103 \"hair follicle dermal stem cell\")\n35521: EquivalentClasses(obo:CL_4072103 ObjectIntersectionOf(obo:CL_0000134 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\n35522: SubClassOf(obo:CL_4072103 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042634))\n35523: \n35524: # Class: obo:CL_4072104 (fibrochondrocyte)\n35525: \n35526: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35527: AnnotationAssertion(terms:contributor obo:CL_4072104 <https://orcid.org/0009-0000-8480-9277>)\n35528: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35529: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35530: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\n35531: AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n35532: EquivalentClasses(obo:CL_4072104 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995)))\n35533: SubClassOf(obo:CL_4072104 obo:CL_0002320)\n35534: SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0020021))\n35535: SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n35536: SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003328))\n35537: SubClassOf(obo:CL_4072104 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003353))\n35538: \n35539: # Class: obo:CL_7770002 (juxtacanalicular tissue cell)\n35540: \n35541: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\n35542: AnnotationAssertion(obo:IAO_0000233 obo:CL_7770002 \"https://github.com/obophenotype/cell-ontology/issues/3275\")\n35543: AnnotationAssertion(terms:contributor obo:CL_7770002 <https://orcid.org/0009-0000-8480-9277>)\n35544: AnnotationAssertion(oboInOwl:creation_date obo:CL_7770002 \"2025-01-29T08:52:00Z\"^^xsd:dateTime)\n35545: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_7770002 \"JCT cell\")\n35546: AnnotationAssertion(rdfs:label obo:CL_7770002 \"juxtacanalicular tissue cell\")\n35547: SubClassOf(obo:CL_7770002 obo:CL_0000327)\n35548: SubClassOf(obo:CL_7770002 obo:CL_0002367)\n35549: SubClassOf(obo:CL_7770002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n35550: \n35551: # Class: obo:CL_7770003 (beam A cell)\n35552: \n35553: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27443500\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770003 \"A beam cell within the eye's trabecular meshwork, molecularly distinguished by FABP4 expression in humans and spatially intermingled with Beam B cells throughout the uveal and corneoscleral meshwork regions. In mice, a transcriptionally analogous Beam A–like cluster (mC14) exists, sharing core TM markers (Myoc, Mgp, Pdpn, Chil1) and functional attributes.\")\n35554: AnnotationAssertion(terms:contributor obo:CL_7770003 <https://orcid.org/0009-0000-8480-9277>)\n35555: AnnotationAssertion(oboInOwl:creation_date obo:CL_7770003 \"2025-08-29T08:53:47Z\"^^xsd:dateTime)\n35556: AnnotationAssertion(rdfs:label obo:CL_7770003 \"beam A cell\")\n35557: AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770003 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35558: SubClassOf(obo:CL_7770003 obo:CL_7770005)\n35559: \n35560: # Class: obo:CL_7770004 (suprabasal cell)\n35561: \n35562: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17020902\") Annotation(oboInOwl:hasDbXref \"PMID:30837987\") Annotation(oboInOwl:hasDbXref \"PMID:32187560\") Annotation(oboInOwl:hasDbXref \"PMID:32726565\") Annotation(oboInOwl:hasDbXref \"PMID:37672481\") obo:IAO_0000115 obo:CL_7770004 \"An epithelial cell that resides in the layer(s) immediately above the basal layer in stratified or pseudostratified epithelia. This cell mainly originates from basal cells and is found across various tissues, including skin, esophagus, oral mucosa, airway, and cornea.\")\n35563: AnnotationAssertion(terms:contributor obo:CL_7770004 <https://orcid.org/0009-0000-8480-9277>)\n35564: AnnotationAssertion(terms:date obo:CL_7770004 \"2025-09-05T07:59:28Z\"^^xsd:dateTime)\n35565: AnnotationAssertion(rdfs:label obo:CL_7770004 \"suprabasal cell\")\n35566: SubClassOf(obo:CL_7770004 obo:CL_0000066)\n35567: \n35568: # Class: obo:CL_7770005 (beam cell)\n35569: \n35570: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:27443500\") obo:IAO_0000115 obo:CL_7770005 \"A trabecular meshwork cell that is part of the eye's trabecular meshwork, residing in the uveal and corneoscleral meshwork regions and serving as the primary biological filter in the aqueous humor drainage cascade. This cell exhibits endothelial-like properties, including production of antithrombogenic substances such as tissue plasminogen activator, while also demonstrating phagocytic activity to remove cellular debris from aqueous humour before the fluid moves deeper into the less porous juxtacanalicular tissue.\")\n35571: AnnotationAssertion(terms:contributor obo:CL_7770005 <https://orcid.org/0009-0000-8480-9277>)\n35572: AnnotationAssertion(oboInOwl:creation_date obo:CL_7770005 \"2025-09-12T11:19:45Z\"^^xsd:dateTime)\n35573: AnnotationAssertion(rdfs:label obo:CL_7770005 \"beam cell\")\n35574: AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770005 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35575: SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_7770005 obo:CL_0002367)\n35576: SubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005969))\n35577: SubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006909))\n35578: \n35579: # Class: obo:CL_7770006 (beam B cell, human)\n35580: \n35581: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770006 \"A trabecular meshwork cell within the eye's trabecular meshwork. This cell is molecularly distinguished by TMEFF2 expression in humans. A beam B cell is spatially intermingled with beam A cells throughout the uveal and corneoscleral meshwork regions, but demonstrates a tendency to localise closer to the juxtacanalicular tissue.\")\n35582: AnnotationAssertion(terms:contributor obo:CL_7770006 <https://orcid.org/0009-0000-8480-9277>)\n35583: AnnotationAssertion(terms:date obo:CL_7770006 \"2025-09-15T08:48:01Z\"^^xsd:dateTime)\n35584: AnnotationAssertion(rdfs:label obo:CL_7770006 \"beam B cell, human\")\n35585: AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35586: SubClassOf(obo:CL_7770006 obo:CL_0002367)\n35587: SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35588: SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9UIK5))\n35589: \n35590: # Class: obo:CP_0000000 (obsolete CP:0000000)\n35591: \n35592: AnnotationAssertion(obo:IAO_0100001 obo:CP_0000000 obo:CL_0017500)\n35593: AnnotationAssertion(rdfs:comment obo:CP_0000000 \"ID was moved to the CL namespace. Use CL:0017500.\")\n35594: AnnotationAssertion(rdfs:label obo:CP_0000000 \"obsolete CP:0000000\")\n35595: AnnotationAssertion(owl:deprecated obo:CP_0000000 \"true\"^^xsd:boolean)\n35596: \n35597: # Class: obo:CP_0000025 (obsolete CP:0000025)\n35598: \n35599: AnnotationAssertion(obo:IAO_0100001 obo:CP_0000025 obo:CL_0017501)\n35600: AnnotationAssertion(rdfs:comment obo:CP_0000025 \"ID was moved to the CL namespace. Use CL:0017501.\")\n35601: AnnotationAssertion(rdfs:label obo:CP_0000025 \"obsolete CP:0000025\")\n35602: AnnotationAssertion(owl:deprecated obo:CP_0000025 \"true\"^^xsd:boolean)\n35603: \n35604