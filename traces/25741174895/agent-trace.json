                 tmp\n37: MIRRORDIR=                  mirror\n38: IMPORTDIR=                  imports\n39: SUBSETDIR=                  subsets\n40: SCRIPTSDIR=                 ../scripts\n41: UPDATEREPODIR=              target\n42: SPARQLDIR =                 ../sparql\n43: EXTENDED_PREFIX_MAP=        $(TMPDIR)/obo.epm.json\n44: COMPONENTSDIR =             components\n45: REPORT_FAIL_ON =            ERROR\n46: REPORT_LABEL =              \n47: REPORT_PROFILE_OPTS =       \n48: OBO_FORMAT_OPTIONS =        --clean-obo 'simple merge-comments'\n49: SPARQL_VALIDATION_CHECKS =  equivalent-classes owldef-self-reference nolabels pmid-not-dbxref obsolete-replaced_by obsolete-alt-id orcid-contributor illegal-annotation-property label-synonym-polysemy illegal-date def-not-only-xref id-format \n50: SPARQL_EXPORTS =            cl_terms cl-edges cl-synonyms cl-xrefs cl-def-xrefs \n51: ODK_VERSION_MAKEFILE =      v1.6\n52: RELAX_OPTIONS =             --include-subclass-of true\n53: REDUCE_OPTIONS =            --include-subproperties true\n54: \n55: TODAY ?=                    $(shell date +%Y-%m-%d)\n56: OBODATE ?=                  $(shell date +'%d:%m:%Y %H:%M')\n57: VERSION=                    $(TODAY)\n58: ANNOTATE_ONTOLOGY_VERSION = annotate -V $(ONTBASE)/releases/$(VERSION)/$@ --annotation owl:versionInfo $(VERSION)\n59: ANNOTATE_CONVERT_FILE =     annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) convert -f ofn --output $@.tmp.owl && mv $@.tmp.owl $@\n60: OTHER_SRC =                 $(PATTERNDIR)/definitions.owl $(COMPONENTSDIR)/hra_subset.owl $(COMPONENTSDIR)/mappings.owl $(COMPONENTSDIR)/blood_and_immune_upper_slim.owl $(COMPONENTSDIR)/eye_upper_slim.owl $(COMPONENTSDIR)/general_cell_types_upper_slim.owl $(COMPONENTSDIR)/kidney_upper_slim.owl $(COMPONENTSDIR)/cellxgene_subset.owl $(COMPONENTSDIR)/PNS_neurons.owl $(COMPONENTSDIR)/clm-cl.owl $(COMPONENTSDIR)/2DFTU_HRA_illustrations.owl $(COMPONENTSDIR)/wmbo-cl-comp.owl \n61: ONTOLOGYTERMS =             $(TMPDIR)/ontologyterms.txt\n62: EDIT_PREPROCESSED =         $(TMPDIR)/$(ONT)-preprocess.owl\n63: \n64: PATTERNDIR=                 ../patterns\n65: PATTERN_TESTER=             dosdp validate -i\n66: DOSDPT=                     dosdp-tools\n67: PATTERN_RELEASE_FILES=      $(PATTERNDIR)/definitions.owl $(PATTERNDIR)/pattern.owl\n68: \n69: MAPPINGDIR=                 ../mappings\n70: MAPPING_TESTER=             sssom validate\n71: SSSOMPY=                    sssom\n72: MAPPINGS=                   cl-local cl fbbt zfa \n73: MAPPING_RELEASE_FILES=      $(foreach n,$(MAPPINGS), $(MAPPINGDIR)/$(n).sssom.tsv)\n74: \n75: \n76: FORMATS = $(sort  owl obo json owl)\n77: FORMATS_INCL_TSV = $(sort $(FORMATS) tsv)\n78: RELEASE_ARTEFACTS = $(sort $(ONT)-base $(ONT)-full $(ONT)-simple $(ONT)-basic $(ONT)-non-classified cl-plus )\n79: \n80: ifeq ($(ODK_DEBUG),yes)\n81: ODK_DEBUG_FILE = debug.log\n82: SHELL = $(SCRIPTSDIR)/run-command.sh\n83: endif\n84: \n85: # ----------------------------------------\n86: # Workflow control\n87: # ----------------------------------------\n88: # Set any of the following variables to false to completely disable the\n89: # corresponding workflows.\n90: \n91: # Refresh of mirrors (and all remote resources more generally)\n92: MIR = true\n93: \n94: # Re-generation of import modules\n95: IMP = true\n96: \n97: # Re-generation of \"large\" import modules\n98: # Note that IMP=false takes precedence over IMP_LARGE=true, that is,\n99: # IMP=false disables the generation of all import modules, large or not.\n100: IMP_LARGE = true\n101: \n102: # Re-generation of component modules\n103: COMP = true\n104: \n105: # Re-generation of pattern-derived files\n106: PAT = true\n107: \n108: # ----------------------------------------\n109: # Top-level targets\n110: # ----------------------------------------\n111: \n112: .PHONY: .FORCE\n113: \n114: .PHONY: all\n115: all: all_odk\n116: \n117: .PHONY: all_odk\n118: all_odk: odkversion config_check test custom_reports all_assets release_diff\n119: \n120: .PHONY: test\n121: test: odkversion validate_idranges dosdp_validation reason_test sparql_test robot_reports $(REPORTDIR)/validate_profile_owl2dl_$(ONT).owl.txt\n122: \techo \"Finished running all tests successfully.\"\n123: \n124: .PHONY: test\n125: test_fast:\n126: \t$(MAKE_FAST) test\n127: \n128: .PHONY: release_diff\n129: release_diff: $(REPORTDIR)/release-diff.md\n130: \n131: .PHONY: reason_test\n132: reason_test: $(EDIT_PREPROCESSED)\n133: \t$(ROBOT) reason --input $< --reasoner $(REASONER) --equivalent-classes-allowed asserted-only \\\n134: \t\t--exclude-tautologies structural --output test.owl && rm test.owl\n135: \n136: .PHONY: odkversion\n137: odkversion:\n138: \t@echo \"ODK Makefile $(ODK_VERSION_MAKEFILE)\"\n139: \t@odk-info --tools\n140: .PHONY: config_check\n141: config_check:\n142: \t@if [ \"$$(tr -d '\\r' < $(ONT)-odk.yaml | sha256sum | cut -c1-64)\" = \"$(CONFIG_HASH)\" ]; then \\\n143: \t\techo \"Repository is up-to-date.\" ; else \\\n144: \t\techo \"Your ODK configuration has changed since this Makefile was generated. You may need to run 'make update_repo'.\" ; fi\n145: \n146: \n147: $(TMPDIR) $(REPORTDIR) $(MIRRORDIR) $(IMPORTDIR) $(COMPONENTSDIR) $(SUBSETDIR):\n148: \tmkdir -p $@\n149: \n150: # ----------------------------------------\n151: # ODK-managed ROBOT plugins\n152: # ----------------------------------------\n153: \n154: # Make sure ROBOT knows where to find plugins\n155: export ROBOT_PLUGINS_DIRECTORY=$(TMPDIR)/plugins\n156: \n157: # Override this rule in cl.Makefile to install custom plugins\n158: .PHONY: custom_robot_plugins\n159: custom_robot_plugins:\n160: \n161: \n162: .PHONY: extra_robot_plugins\n163: extra_robot_plugins:  $(ROBOT_PLUGINS_DIRECTORY)/flybase.jar  $(ROBOT_PLUGINS_DIRECTORY)/uberon.jar \n164: \n165: \n166: # Install all ROBOT plugins to the runtime plugins directory\n167: .PHONY: all_robot_plugins\n168: all_robot_plugins: $(foreach plugin,$(notdir $(wildcard /tools/robot-plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \\\n169: \t\t   $(foreach plugin,$(notdir $(wildcard ../../plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \\\n170: \t\t   custom_robot_plugins extra_robot_plugins  \\\n171: \n172: # Default rule to install plugins\n173: $(ROBOT_PLUGINS_DIRECTORY)/%.jar:\n174: \t@mkdir -p $(ROBOT_PLUGINS_DIRECTORY)\n175: \t@if [ -f ../../plugins/$*.jar ]; then        \\\n176: \t\tln ../../plugins/$*.jar $@ ;         \\\n177: \telif [ -f /tools/robot-plugins/$*.jar ]; then \\\n178: \t\tcp /tools/robot-plugins/$*.jar $@ ;  \\\n179: \tfi\n180: \n181: # Specific rules for supplementary plugins defined in configuration\n182: \n183: $(ROBOT_PLUGINS_DIRECTORY)/flybase.jar:\n184: \tcurl -L -o $@ https://github.com/FlyBase/flybase-robot-plugin/releases/download/flybase-robot-plugin-0.2.2/flybase.jar\n185: \n186: $(ROBOT_PLUGINS_DIRECTORY)/uberon.jar:\n187: \tcurl -L -o $@ https://github.com/obophenotype/uberon-robot-plugin/releases/download/uberon-robot-plugin-0.4.0/uberon.jar\n188: \n189: \n190: # ----------------------------------------\n191: # Release assets\n192: # ----------------------------------------\n193: \n194: MAIN_PRODUCTS = $(sort $(foreach r,$(RELEASE_ARTEFACTS), $(r)) $(ONT))\n195: MAIN_GZIPPED  = \n196: MAIN_FILES    = $(foreach n,$(MAIN_PRODUCTS), $(foreach f,$(FORMATS), $(n).$(f))) $(MAIN_GZIPPED)\n197: SRCMERGED     = $(TMPDIR)/merged-$(ONT)-edit.ofn\n198: \n199: .PHONY: all_main\n200: all_main: $(MAIN_FILES)\n201: \n202: # ----------------------------------------\n203: # Import assets\n204: # ----------------------------------------\n205: \n206: \n207: IMPORTS =  pr go uberon ro pato ncbitaxon ncbitaxondisjoints omo mbao stato\n208: \n209: IMPORT_ROOTS =  $(IMPORTDIR)/merged_import\n210: IMPORT_OWL_FILES = $(foreach n,$(IMPORT_ROOTS), $(n).owl)\n211: IMPORT_FILES = $(IMPORT_OWL_FILES)\n212: \n213: \n214: .PHONY: all_imports\n215: all_imports: $(IMPORT_FILES)\n216: \n217: # ----------------------------------------\n218: # Subset assets\n219: # ----------------------------------------\n220: \n221: \n222: SUBSETS =  BDS_subset blood_and_immune_upper_slim eye_upper_slim general_cell_types_upper_slim kidney_upper_slim human-view mouse-view\n223: \n224: SUBSET_ROOTS = $(patsubst %, $(SUBSETDIR)/%, $(SUBSETS))\n225: SUBSET_FILES = $(foreach n,$(SUBSET_ROOTS), $(foreach f,$(FORMATS_INCL_TSV), $(n).$(f)))\n226: \n227: .PHONY: all_subsets\n228: all_subsets: $(SUBSET_FILES)\n229: \n230: # ----------------------------------------\n231: # Mapping assets\n232: # ----------------------------------------\n233: \n234: \n235: MAPPINGS =  cl-local cl fbbt zfa\n236: \n237: RELEASED_MAPPINGS =  cl\n238: \n239: MAPPING_FILES = $(foreach p, $(MAPPINGS), $(MAPPINGDIR)/$(p).sssom.tsv)\n240: RELEASED_MAPPING_FILES = $(foreach p, $(RELEASED_MAPPINGS), $(MAPPINGDIR)/$(p).sssom.tsv)\n241: \n242: .PHONY: all_mappings\n243: all_mappings: $(MAPPING_FILES)\n244: \n245: \n246: # ----------------------------------------\n247: # QC Reports & Utilities\n248: # ----------------------------------------\n249: \n250: OBO_REPORT =  $(SRC)-obo-report\n251: ALIGNMENT_REPORT =  $(SRC)-align-report\n252: REPORTS = $(OBO_REPORT)\n253: REPORT_FILES = $(patsubst %, $(REPORTDIR)/%.tsv, $(REPORTS))\n254: \n255: .PHONY: robot_reports\n256: robot_reports: $(REPORT_FILES)\n257: \n258: .PHONY: all_reports\n259: all_reports: custom_reports robot_reports\n260: \n261: # ----------------------------------------\n262: # ROBOT OWL Profile checking\n263: # ----------------------------------------\n264: \n265: # The merge step is necessary to avoid undeclared entity violations.\n266: $(REPORTDIR)/validate_profile_owl2dl_%.txt: % | $(REPORTDIR) $(TMPDIR)\n267: \t$(ROBOT) merge -i $< convert -f ofn -o $(TMPDIR)/validate.ofn\n268: \t$(ROBOT) validate-profile --profile DL -i $(TMPDIR)/validate.ofn -o $@ || { cat $@ && exit 1; }\n269: .PRECIOUS: $(REPORTDIR)/validate_profile_owl2dl_%.txt\n270: \n271: validate_profile_%: $(REPORTDIR)/validate_profile_owl2dl_%.txt\n272: \techo \"$* profile validation completed.\"\n273: \n274: # ----------------------------------------\n275: # Sparql queries: Q/C\n276: # ----------------------------------------\n277: \n278: # these live in the ../sparql directory, and have suffix -violation.sparql\n279: # adding the name here will make the violation check live.\n280: \n281: SPARQL_VALIDATION_QUERIES = $(foreach V,$(SPARQL_VALIDATION_CHECKS),$(SPARQLDIR)/$(V)-violation.sparql)\n282: \n283: sparql_test:  $(SRCMERGED) | $(REPORTDIR)\n284: ifneq ($(SPARQL_VALIDATION_QUERIES),)\n285:   \n286: \t$(ROBOT) verify -i $(SRCMERGED) --queries $(SPARQL_VALIDATION_QUERIES) -O $(REPORTDIR)\n287: endif\n288: \n289: # ----------------------------------------\n290: # ROBOT report\n291: # ----------------------------------------\n292: \n293: $(REPORTDIR)/$(SRC)-obo-report.tsv: $(SRCMERGED) | $(REPORTDIR)\n294: \t$(ROBOT) report -i $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) --fail-on $(REPORT_FAIL_ON) --print 5 -o $@\n295: \n296: $(REPORTDIR)/%-obo-report.tsv: % | $(REPORTDIR)\n297: \t$(ROBOT) report -i $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) --fail-on $(REPORT_FAIL_ON) --print 5 -o $@\n298: \n299: check_for_robot_updates:\n300: \techo \"You are not using a custom profile, so you are getting the joy of the latest ROBOT report!\"\n301: \n302: \n303: # ----------------------------------------\n304: # Release assets\n305: # ----------------------------------------\n306: \n307: ASSETS = \\\n308:   $(IMPORT_FILES) \\\n309:   $(MAIN_FILES) \\\n310:   $(PATTERN_RELEASE_FILES) \\\n311:   $(REPORT_FILES) \\\n312:   $(SUBSET_FILES) \\\n313:   $(MAPPING_FILES)\n314: \n315: RELEASE_ASSETS = \\\n316:   $(MAIN_FILES) \\\n317:   $(SUBSET_FILES)\n318: \n319: .PHONY: all_assets\n320: all_assets: $(ASSETS) check_rdfxml_assets\n321: \n322: .PHONY: show_assets\n323: show_assets:\n324: \techo $(ASSETS)\n325: \tdu -sh $(ASSETS)\n326: \n327: check_rdfxml_%: %\n328: \t@check-rdfxml  $<\n329: \n330: .PHONY: check_rdfxml_assets\n331: check_rdfxml_assets: $(foreach product,$(MAIN_PRODUCTS),check_rdfxml_$(product).owl)\n332: \n333: # ----------------------------------------\n334: # Release Management\n335: # ----------------------------------------\n336: \n337: KEEPRELATIONS=keeprelations.txt\n338: CLEANFILES=$(MAIN_FILES) $(SRCMERGED) $(EDIT_PREPROCESSED)\n339: \n340: # This should be executed by the release manager whenever time comes to make a release.\n341: # It will ensure that all assets/files are fresh, and will copy to release folder\n342: .PHONY: prepare_release\n343: prepare_release: all_odk\n344: \t$(MAKE) copy_release_files\n345: \trm -f $(CLEANFILES)\n346: \t@echo \"Release files are now in $(RELEASEDIR) - now you should commit, push and make a release \\\n347:         on your git hosting site such as GitHub or GitLab\"\n348: \n349: .PHONY: prepare_release_fast\n350: prepare_release_fast:\n351: \t$(MAKE) prepare_release IMP=false PAT=false MIR=false COMP=false\n352: \n353: # This rule does the bulk of the work for prepare_release, copying all\n354: # files to the release directory. It is mostly intended for internal\n355: # use, by the prepare_release rule itself or by other ODK scripts.\n356: .PHONY: copy_release_files\n357: copy_release_files:\n358: \trsync -R $(RELEASE_ASSETS) $(RELEASEDIR)\n359: \tmkdir -p $(RELEASEDIR)/mappings\n360: \tcp -rf $(RELEASED_MAPPING_FILES) $(RELEASEDIR)/mappings\n361: \n362: # All released assets, in their final location within the release\n363: RELEASE_ASSETS_AFTER_RELEASE=$(foreach n,$(RELEASE_ASSETS), $(RELEASEDIR)/$(n)) \\\n364: \t\t\t     $(foreach n,$(RELEASED_MAPPINGS), $(RELEASEDIR)/mappings/$(n).sssom.tsv)\n365: \n366: .PHONY: show_release_assets\n367: show_release_assets:\n368: \t@echo $(RELEASE_ASSETS_AFTER_RELEASE)\n369: \n370: CURRENT_RELEASE=$(ONTBASE).owl\n371: \n372: $(TMPDIR)/current-release.owl:\n373: \twget $(CURRENT_RELEASE) -O $@\n374: \n375: $(REPORTDIR)/release-diff.md: $(ONT).owl $(TMPDIR)/current-release.owl\n376: \t$(ROBOT) diff --labels true --left $(TMPDIR)/current-release.owl --right $(ONT).owl -f markdown -o $@\n377: \n378: # ------------------------\n379: # Imports: Seeding system \n380: # ------------------------\n381: \n382: # pre_seed.txt contains all entities referenced from the -edit file\n383: # and its components\n384: PRESEED=$(TMPDIR)/pre_seed.txt\n385: $(PRESEED): $(SRCMERGED)\n386: \t$(ROBOT) query --input $< --format --csv \\\n387: \t\t       --query $(SPARQLDIR)/terms.sparql $@\n388: \n389: $(SRCMERGED): $(EDIT_PREPROCESSED) $(OTHER_SRC)\n390: \t$(ROBOT) remove --input $< --select imports --trim false \\\n391: \t\t merge $(foreach src, $(OTHER_SRC), --input $(src)) \\\n392: \t\t       --output $@\n393: \n394: $(EDIT_PREPROCESSED): $(SRC)\n395: \t$(ROBOT) convert --input $< --format ofn --output $@\n396: \n397: SIMPLESEED=$(TMPDIR)/simple_seed.txt\n398: \n399: $(SIMPLESEED): $(SRCMERGED) $(ONTOLOGYTERMS)\n400: \t$(ROBOT) query -f csv -i $< --query ../sparql/simple-seed.sparql $@.tmp &&\\\n401: \tcat $@.tmp $(ONTOLOGYTERMS) | sort | uniq >  $@ &&\\\n402: \techo \"http://www.geneontology.org/formats/oboInOwl#SubsetProperty\" >> $@ &&\\\n403: \techo \"http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty\" >> $@\n404: \n405: # seed.txt contains all entities to import in addition to those defined\n406: # in the individual _terms.txt files.\n407: IMPORTSEED = $(TMPDIR)/seed.txt\n408: $(IMPORTSEED): $(PRESEED) $(TMPDIR)/all_pattern_terms.txt | $(TMPDIR)\n409: \tcat $^ | sort | uniq > $@\n410: \n411: T_IMPORTSEED = --term-file $(IMPORTSEED)\n412: \n413: ANNOTATION_PROPERTIES=rdfs:label IAO:0000115 oboInOwl:is_metadata_tag OMO:0002000 \n414: \n415: # ----------------------------------------\n416: # Import modules\n417: # ----------------------------------------\n418: # Most ontologies are modularly constructed using portions of other ontologies\n419: # These live in the imports/ folder\n420: # This pattern uses ROBOT to generate an import module\n421: \n422: ifeq ($(IMP),true)\n423: \n424: ALL_TERMS = $(foreach imp, $(IMPORTS), $(IMPORTDIR)/$(imp)_terms.txt)\n425: \n426: $(IMPORTDIR)/merged_import.owl: $(MIRRORDIR)/merged.owl $(ALL_TERMS) \\\n427: \t\t\t\t$(IMPORTSEED) | all_robot_plugins\n428: \t$(ROBOT) merge --input $< \\\n429: \t\t remove --select \"<http://www.informatics.jax.org/marker/MGI:*>\" \\\n430: \t\t remove --select \"<http://purl.obolibrary.org/obo/OBA_*>\" \\\n431: \t\t remove --select \"<http://purl.obolibrary.org/obo/ENVO_*>\" \\\n432: \t\t remove --select \"<http://purl.obolibrary.org/obo/OBI_*>\" \\\n433: \t\t remove --select \"<http://purl.obolibrary.org/obo/NBO_*>\" \\\n434: \t\t remove --select \"<http://purl.obolibrary.org/obo/PO_*>\" \\\n435: \t\t remove --select \"<http://purl.obolibrary.org/obo/SO_*>\" \\\n436: \t\t remove --select \"<http://purl.obolibrary.org/obo/DDANAT_*>\" \\\n437: \t\t remove --select \"<http://purl.obolibrary.org/obo/NCBITaxon_Union_*>\" \\\n438: \t\t remove --select \"<http://purl.obolibrary.org/obo/GOCHE_*>\" \\\n439: \t\t remove --select \"<http://purl.obolibrary.org/obo/CLO_*>\" \\\n440: \t\t remove --select \"<http://www.genenames.org/cgi-bin/gene_symbol_report*>\" \\\n441: \t\t extract $(foreach f, $(ALL_TERMS), --term-file $(f)) $(T_IMPORTSEED) \\\n442: \t\t         --force true --copy-ontology-annotations false \\\n443: \t\t         --individuals exclude \\\n444: \t\t         --method BOT \\\n445: \t\t remove $(foreach p, $(ANNOTATION_PROPERTIES), --term $(p)) \\\n446: \t\t        $(foreach f, $(ALL_TERMS), --term-file $(f)) $(T_IMPORTSEED) \\\n447: \t\t        --select complement --select annotation-properties \\\n448: \t\t odk:normalize --base-iri http://purl.obolibrary.org/obo \\\n449: \t\t               --subset-decls true --synonym-decls true \\\n450: \t\t repair --merge-axiom-annotations true \\\n451: \t\t $(ANNOTATE_CONVERT_FILE)\n452: \n453: endif # IMP=true\n454: \n455: .PHONY: refresh-imports\n456: refresh-imports:\n457: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=true clean all_imports\n458: \n459: .PHONY: no-mirror-refresh-imports\n460: no-mirror-refresh-imports:\n461: \t$(MAKE) --assume-new=$(SRC) \\\n462: \t\t$(foreach imp,$(IMPORTS),--assume-new=$(IMPORTDIR)/$(imp)_terms.txt) \\\n463: \t\tIMP=true MIR=false PAT=false IMP_LARGE=true all_imports\n464: \n465: .PHONY: refresh-imports-excluding-large\n466: refresh-imports-excluding-large:\n467: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=false clean all_imports\n468: \n469: .PHONY: refresh-%\n470: refresh-%:\n471: \t$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \\\n472: \t\tIMP=true IMP_LARGE=true MIR=true PAT=false $(IMPORTDIR)/$*_import.owl\n473: \n474: .PHONY: no-mirror-refresh-%\n475: no-mirror-refresh-%:\n476: \t$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \\\n477: \t\tIMP=true IMP_LARGE=true MIR=false PAT=false $(IMPORTDIR)/$*_import.owl\n478: \n479: # ----------------------------------------\n480: # Components\n481: # ----------------------------------------\n482: # Some ontologies contain external and internal components. A component is included in the ontology in its entirety.\n483: \n484: ifeq ($(COMP),true)\n485: .PHONY: all_components\n486: all_components: $(OTHER_SRC)\n487: \n488: .PHONY: recreate-components\n489: recreate-components:\n490: \t$(MAKE) --assume-new=$(TMPDIR)/stamp-component-hra_subset.owl \\\n491: \t\t--assume-new=$(TMPDIR)/stamp-component-mappings.owl \\\n492: \t\t--assume-new=$(TMPDIR)/stamp-component-blood_and_immune_upper_slim.owl \\\n493: \t\t--assume-new=$(TMPDIR)/stamp-component-eye_upper_slim.owl \\\n494: \t\t--assume-new=$(TMPDIR)/stamp-component-general_cell_types_upper_slim.owl \\\n495: \t\t--assume-new=$(TMPDIR)/stamp-component-kidney_upper_slim.owl \\\n496: \t\t--assume-new=$(TMPDIR)/stamp-component-cellxgene_subset.owl \\\n497: \t\t--assume-new=$(TMPDIR)/stamp-component-PNS_neurons.owl \\\n498: \t\t--assume-new=$(TMPDIR)/stamp-component-clm-cl.owl \\\n499: \t\t--assume-new=$(TMPDIR)/stamp-component-2DFTU_HRA_illustrations.owl \\\n500: \t\t--assume-new=$(TMPDIR)/stamp-component-wmbo-cl-comp.owl \\\n501: \t\tCOMP=true IMP=false MIR=true PAT=true all_components\n502: \n503: .PHONY: no-mirror-recreate-components\n504: no-mirror-recreate-components:\n505: \t$(MAKE) --assume-new=$(TMPDIR)/stamp-component-hra_subset.owl \\\n506: \t\t--assume-new=$(TMPDIR)/stamp-component-mappings.owl \\\n507: \t\t--assume-new=$(TMPDIR)/stamp-component-blood_and_immune_upper_slim.owl \\\n508: \t\t--assume-new=$(TMPDIR)/stamp-component-eye_upper_slim.owl \\\n509: \t\t--assume-new=$(TMPDIR)/stamp-component-general_cell_types_upper_slim.owl \\\n510: \t\t--assume-new=$(TMPDIR)/stamp-component-kidney_upper_slim.owl \\\n511: \t\t--assume-new=$(TMPDIR)/stamp-component-cellxgene_subset.owl \\\n512: \t\t--assume-new=$(TMPDIR)/stamp-component-PNS_neurons.owl \\\n513: \t\t--assume-new=$(TMPDIR)/stamp-component-clm-cl.owl \\\n514: \t\t--assume-new=$(TMPDIR)/stamp-component-2DFTU_HRA_illustrations.owl \\\n515: \t\t--assume-new=$(TMPDIR)/stamp-component-wmbo-cl-comp.owl \\\n516: \t\tCOMP=true IMP=false MIR=false PAT=true all_components\n517: \n518: .PHONY: recreate-%\n519: recreate-%:\n520: \t$(MAKE) --assume-new=$(TMPDIR)/stamp-component-$*.owl \\\n521: \t\tCOMP=true IMP=false MIR=true PAT=true $(COMPONENTSDIR)/$*.owl\n522: \n523: .PHONY: no-mirror-recreate-%\n524: no-mirror-recreate-%:\n525: \t$(MAKE) --assume-new=$(TMPDIR)/stamp-component-$*.owl \\\n526: \t\tCOMP=true IMP=false MIR=false PAT=true $(COMPONENTSDIR)/$*.owl\n527: \n528: $(COMPONENTSDIR)/%.owl: $(TMPDIR)/stamp-component-%.owl | $(COMPONENTSDIR)\n529: \ttest -f $@ || touch $@\n530: .PRECIOUS: $(COMPONENTSDIR)/%.owl\n531: \n532: $(TMPDIR)/stamp-component-%.owl: | $(TMPDIR)\n533: \ttouch $@\n534: .PRECIOUS: $(TMPDIR)/stamp-component-%.owl\n535: \n536: ifeq ($(MIR),true)\n537: .PHONY: component-download-hra_subset.owl\n538: component-download-hra_subset.owl: | $(TMPDIR)\n539: \t$(ROBOT) merge -I https://raw.githubusercontent.com/hubmapconsortium/ccf-validation-tools/master/owl/CL_ASCTB_subset.owl \\\n540: \t\t annotate --annotation owl:versionInfo $(VERSION) --output $(TMPDIR)/$@.owl\n541: \n542: $(COMPONENTSDIR)/hra_subset.owl: component-download-hra_subset.owl $(TMPDIR)/stamp-component-hra_subset.owl\n543: \t@if cmp -s $(TMPDIR)/component-download-hra_subset.owl.owl $(TMPDIR)/component-download-hra_subset.owl.tmp.owl ; then \\\n544: \t        echo \"Component identical.\" ; \\\n545: \telse \\\n546: \t        echo \"Component different, updating.\" && \\\n547: \t        cp $(TMPDIR)/component-download-hra_subset.owl.owl $(TMPDIR)/component-download-hra_subset.owl.tmp.owl && \\\n548: \t        $(ROBOT) annotate --input $(TMPDIR)/component-download-hra_subset.owl.owl \\\n549: \t                          --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n550: \t                          --output $@ ; \\\n551: \tfi\n552: .PRECIOUS: $(COMPONENTSDIR)/hra_subset.owl\n553: endif # MIR=true\n554: \n555: $(COMPONENTSDIR)/blood_and_immune_upper_slim.owl: $(TEMPLATEDIR)/blood_and_immune_upper_slim.csv $(TMPDIR)/stamp-component-blood_and_immune_upper_slim.owl\n556: \t$(ROBOT) template  \\\n557: \t\t --template $(TEMPLATEDIR)/blood_and_immune_upper_slim.csv \\\n558: \t\t $(ANNOTATE_CONVERT_FILE)\n559: .PRECIOUS: $(COMPONENTSDIR)/blood_and_immune_upper_slim.owl\n560: \n561: $(COMPONENTSDIR)/eye_upper_slim.owl: $(TEMPLATEDIR)/eye_upper_slim.csv $(TMPDIR)/stamp-component-eye_upper_slim.owl\n562: \t$(ROBOT) template  \\\n563: \t\t --template $(TEMPLATEDIR)/eye_upper_slim.csv \\\n564: \t\t $(ANNOTATE_CONVERT_FILE)\n565: .PRECIOUS: $(COMPONENTSDIR)/eye_upper_slim.owl\n566: \n567: $(COMPONENTSDIR)/general_cell_types_upper_slim.owl: $(TEMPLATEDIR)/general_cell_types_upper_slim.csv $(TMPDIR)/stamp-component-general_cell_types_upper_slim.owl\n568: \t$(ROBOT) template  \\\n569: \t\t --template $(TEMPLATEDIR)/general_cell_types_upper_slim.csv \\\n570: \t\t $(ANNOTATE_CONVERT_FILE)\n571: .PRECIOUS: $(COMPONENTSDIR)/general_cell_types_upper_slim.owl\n572: \n573: $(COMPONENTSDIR)/kidney_upper_slim.owl: $(TEMPLATEDIR)/kidney_upper_slim.csv $(TMPDIR)/stamp-component-kidney_upper_slim.owl\n574: \t$(ROBOT) template  \\\n575: \t\t --template $(TEMPLATEDIR)/kidney_upper_slim.csv \\\n576: \t\t $(ANNOTATE_CONVERT_FILE)\n577: .PRECIOUS: $(COMPONENTSDIR)/kidney_upper_slim.owl\n578: \n579: $(COMPONENTSDIR)/cellxgene_subset.owl: $(TEMPLATEDIR)/cellxgene_subset.tsv $(TMPDIR)/stamp-component-cellxgene_subset.owl\n580: \t$(ROBOT) template  \\\n581: \t\t --template $(TEMPLATEDIR)/cellxgene_subset.tsv \\\n582: \t\t $(ANNOTATE_CONVERT_FILE)\n583: .PRECIOUS: $(COMPONENTSDIR)/cellxgene_subset.owl\n584: \n585: $(COMPONENTSDIR)/PNS_neurons.owl: $(TEMPLATEDIR)/PNS_neurons.csv $(TMPDIR)/stamp-component-PNS_neurons.owl\n586: \t$(ROBOT) template  \\\n587: \t\t --template $(TEMPLATEDIR)/PNS_neurons.csv \\\n588: \t\t $(ANNOTATE_CONVERT_FILE)\n589: .PRECIOUS: $(COMPONENTSDIR)/PNS_neurons.owl\n590: \n591: ifeq ($(MIR),true)\n592: .PHONY: component-download-clm-cl.owl\n593: component-download-clm-cl.owl: | $(TMPDIR)\n594: \t$(ROBOT) merge -I https://raw.githubusercontent.com/Cellular-Semantics/CellMark/main/clm-cl.owl \\\n595: \t\t annotate --annotation owl:versionInfo $(VERSION) --output $(TMPDIR)/$@.owl\n596: \n597: $(COMPONENTSDIR)/clm-cl.owl: component-download-clm-cl.owl $(TMPDIR)/stamp-component-clm-cl.owl\n598: \t@if cmp -s $(TMPDIR)/component-download-clm-cl.owl.owl $(TMPDIR)/component-download-clm-cl.owl.tmp.owl ; then \\\n599: \t        echo \"Component identical.\" ; \\\n600: \telse \\\n601: \t        echo \"Component different, updating.\" && \\\n602: \t        cp $(TMPDIR)/component-download-clm-cl.owl.owl $(TMPDIR)/component-download-clm-cl.owl.tmp.owl && \\\n603: \t        $(ROBOT) annotate --input $(TMPDIR)/component-download-clm-cl.owl.owl \\\n604: \t                          --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n605: \t                          --output $@ ; \\\n606: \tfi\n607: .PRECIOUS: $(COMPONENTSDIR)/clm-cl.owl\n608: endif # MIR=true\n609: \n610: $(COMPONENTSDIR)/2DFTU_HRA_illustrations.owl: $(TEMPLATEDIR)/2DFTU_HRA_illustrations.csv $(TMPDIR)/stamp-component-2DFTU_HRA_illustrations.owl\n611: \t$(ROBOT) template  \\\n612: \t\t --template $(TEMPLATEDIR)/2DFTU_HRA_illustrations.csv \\\n613: \t\t $(ANNOTATE_CONVERT_FILE)\n614: .PRECIOUS: $(COMPONENTSDIR)/2DFTU_HRA_illustrations.owl\n615: \n616: ifeq ($(MIR),true)\n617: .PHONY: component-download-wmbo-cl-comp.owl\n618: component-download-wmbo-cl-comp.owl: | $(TMPDIR)\n619: \t$(ROBOT) merge -I https://raw.githubusercontent.com/Cellular-Semantics/whole_mouse_brain_ontology/main/wmbo-cl-comp.owl \\\n620: \t\t annotate --annotation owl:versionInfo $(VERSION) --output $(TMPDIR)/$@.owl\n621: \n622: $(COMPONENTSDIR)/wmbo-cl-comp.owl: component-download-wmbo-cl-comp.owl $(TMPDIR)/stamp-component-wmbo-cl-comp.owl\n623: \t@if cmp -s $(TMPDIR)/component-download-wmbo-cl-comp.owl.owl $(TMPDIR)/component-download-wmbo-cl-comp.owl.tmp.owl ; then \\\n624: \t        echo \"Component identical.\" ; \\\n625: \telse \\\n626: \t        echo \"Component different, updating.\" && \\\n627: \t        cp $(TMPDIR)/component-download-wmbo-cl-comp.owl.owl $(TMPDIR)/component-download-wmbo-cl-comp.owl.tmp.owl && \\\n628: \t        $(ROBOT) annotate --input $(TMPDIR)/component-download-wmbo-cl-comp.owl.owl \\\n629: \t                          --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n630: \t                          --output $@ ; \\\n631: \tfi\n632: .PRECIOUS: $(COMPONENTSDIR)/wmbo-cl-comp.owl\n633: endif # MIR=true\n634: \n635: endif # COMP=true\n636: # ----------------------------------------\n637: # Mirroring upstream ontologies\n638: # ----------------------------------------\n639: \n640: ifeq ($(MIR),true)\n641: \n642: \n643: ## ONTOLOGY: pr\n644: .PHONY: mirror-pr\n645: .PRECIOUS: $(MIRRORDIR)/pr.owl\n646: ifeq ($(IMP_LARGE),true)\n647: mirror-pr: | $(TMPDIR)\n648: \t$(ROBOT) remove -I https://raw.githubusercontent.com/obophenotype/pro_obo_slim/master/pr_slim.owl --base-iri http://purl.obolibrary.org/obo/PR  --axioms external --preserve-structure false --trim false -o $(TMPDIR)/$@.owl\n649: endif\n650: \n651: \n652: ## ONTOLOGY: go\n653: .PHONY: mirror-go\n654: .PRECIOUS: $(MIRRORDIR)/go.owl\n655: mirror-go: | $(TMPDIR)\n656: \tcurl -L $(OBOBASE)/go/go-base.owl --create-dirs -o $(TMPDIR)/go-download.owl --retry 4 --max-time 200 && \\\n657: \t$(ROBOT) convert -i $(TMPDIR)/go-download.owl -o $(TMPDIR)/$@.owl\n658: \n659: \n660: ## ONTOLOGY: uberon\n661: .PHONY: mirror-uberon\n662: .PRECIOUS: $(MIRRORDIR)/uberon.owl\n663: mirror-uberon: | $(TMPDIR)\n664: \tcurl -L $(OBOBASE)/uberon/uberon-base.owl --create-dirs -o $(TMPDIR)/uberon-download.owl --retry 4 --max-time 200 && \\\n665: \t$(ROBOT) convert -i $(TMPDIR)/uberon-download.owl -o $(TMPDIR)/$@.owl\n666: \n667: \n668: ## ONTOLOGY: ro\n669: .PHONY: mirror-ro\n670: .PRECIOUS: $(MIRRORDIR)/ro.owl\n671: mirror-ro: | $(TMPDIR)\n672: \tcurl -L $(OBOBASE)/ro/ro-base.owl --create-dirs -o $(TMPDIR)/ro-download.owl --retry 4 --max-time 200 && \\\n673: \t$(ROBOT) convert -i $(TMPDIR)/ro-download.owl -o $(TMPDIR)/$@.owl\n674: \n675: \n676: ## ONTOLOGY: pato\n677: .PHONY: mirror-pato\n678: .PRECIOUS: $(MIRRORDIR)/pato.owl\n679: mirror-pato: | $(TMPDIR)\n680: \tcurl -L $(OBOBASE)/pato/pato-base.owl --create-dirs -o $(TMPDIR)/pato-download.owl --retry 4 --max-time 200 && \\\n681: \t$(ROBOT) convert -i $(TMPDIR)/pato-download.owl -o $(TMPDIR)/$@.owl\n682: \n683: \n684: ## ONTOLOGY: ncbitaxon\n685: .PHONY: mirror-ncbitaxon\n686: .PRECIOUS: $(MIRRORDIR)/ncbitaxon.owl\n687: mirror-ncbitaxon: | $(TMPDIR)\n688: \t$(ROBOT) convert -I http://purl.obolibrary.org/obo/ncbitaxon/subsets/taxslim.owl -o $(TMPDIR)/$@.owl\n689: \n690: \n691: ## ONTOLOGY: ncbitaxondisjoints\n692: .PHONY: mirror-ncbitaxondisjoints\n693: .PRECIOUS: $(MIRRORDIR)/ncbitaxondisjoints.owl\n694: mirror-ncbitaxondisjoints: | $(TMPDIR)\n695: \t$(ROBOT) convert -I http://purl.obolibrary.org/obo/ncbitaxon/subsets/taxslim-disjoint-over-in-taxon.owl -o $(TMPDIR)/$@.owl\n696: \n697: \n698: ## ONTOLOGY: omo\n699: .PHONY: mirror-omo\n700: .PRECIOUS: $(MIRRORDIR)/omo.owl\n701: mirror-omo: | $(TMPDIR)\n702: \tcurl -L $(OBOBASE)/omo.owl --create-dirs -o $(TMPDIR)/omo-download.owl --retry 4 --max-time 200 && \\\n703: \t$(ROBOT) convert -i $(TMPDIR)/omo-download.owl -o $(TMPDIR)/$@.owl\n704: \n705: \n706: ## ONTOLOGY: mbao\n707: .PHONY: mirror-mbao\n708: .PRECIOUS: $(MIRRORDIR)/mbao.owl\n709: mirror-mbao: | $(TMPDIR)\n710: \t$(ROBOT) convert -I https://raw.githubusercontent.com/brain-bican/mouse_brain_atlas_ontology/main/mbao-base.owl -o $(TMPDIR)/$@.owl\n711: \n712: \n713: ## ONTOLOGY: stato\n714: .PHONY: mirror-stato\n715: .PRECIOUS: $(MIRRORDIR)/stato.owl\n716: mirror-stato: | $(TMPDIR)\n717: \tcurl -L $(OBOBASE)/stato.owl --create-dirs -o $(TMPDIR)/stato-download.owl --retry 4 --max-time 200 && \\\n718: \t$(ROBOT) remove -i $(TMPDIR)/stato-download.owl --base-iri http://purl.obolibrary.org/obo/STATO --axioms external --preserve-structure false --trim false -o $(TMPDIR)/$@.owl\n719: \n720: ALL_MIRRORS = $(patsubst %, $(MIRRORDIR)/%.owl, $(IMPORTS))\n721: MERGE_MIRRORS = true\n722: \n723: ifeq ($(MERGE_MIRRORS),true)\n724: $(MIRRORDIR)/merged.owl: $(ALL_MIRRORS)\n725: \t$(ROBOT) merge $(patsubst %, -i %, $^)  -o $@\n726: .PRECIOUS: $(MIRRORDIR)/merged.owl\n727: endif\n728: \n729: \n730: $(MIRRORDIR)/%.owl: mirror-% | $(MIRRORDIR)\n731: \tif [ -f $(TMPDIR)/mirror-$*.owl ]; then if cmp -s $(TMPDIR)/mirror-$*.owl $@ ; then echo \"Mirror identical, ignoring.\"; else echo \"Mirrors different, updating.\" &&\\\n732: \t\tcp $(TMPDIR)/mirror-$*.owl $@; fi; fi\n733: \n734: endif # MIR=true\n735: \n736: \n737: \n738: # ----------------------------------------\n739: # Subsets\n740: # ----------------------------------------\n741: $(SUBSETDIR)/%.tsv: $(SUBSETDIR)/%.owl\n742: \t$(ROBOT) export -i $< --include classes \\\n743: \t\t        --header \"ID [IRI]|LABEL\" --format tsv --export $@\n744: .PRECIOUS: $(SUBSETDIR)/%.tsv\n745: \n746: $(SUBSETDIR)/%.owl: $(ONT).owl | $(SUBSETDIR) all_robot_plugins\n747: \t$(ROBOT) odk:subset -i $< --subset $* --fill-gaps true \\\n748: \t\t annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) -o $@\n749: .PRECIOUS: $(SUBSETDIR)/%.owl\n750: \n751: \n752: $(SUBSETDIR)/%.obo: $(SUBSETDIR)/%.owl\n753: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n754: \n755: $(SUBSETDIR)/%.json: $(SUBSETDIR)/%.owl\n756: \t$(ROBOT) convert --input $< --check false -f json -o $@.tmp.json &&\\\n757: \tmv $@.tmp.json $@\n758: \n759: \n760: # ---------------------------------------------\n761: # Sparql queries: Table exports / Query Reports\n762: # ---------------------------------------------\n763: \n764: SPARQL_EXPORTS_ARGS = $(foreach V,$(SPARQL_EXPORTS),-s $(SPARQLDIR)/$(V).sparql $(REPORTDIR)/$(V).tsv)\n765: # This combines all into one single command\n766: \n767: .PHONY: custom_reports\n768: custom_reports: $(EDIT_PREPROCESSED) | $(REPORTDIR)\n769: ifneq ($(SPARQL_EXPORTS_ARGS),)\n770: \t$(ROBOT) query -f tsv --use-graphs true -i $< $(SPARQL_EXPORTS_ARGS)\n771: endif\n772: \n773: # ----------------------------------------\n774: # DOSDP Templates/Patterns\n775: # ----------------------------------------\n776: \n777: ALL_PATTERN_FILES=$(wildcard $(PATTERNDIR)/dosdp-patterns/*.yaml)\n778: ALL_PATTERN_NAMES=$(strip $(patsubst %.yaml,%, $(notdir $(wildcard $(PATTERNDIR)/dosdp-patterns/*.yaml))))\n779: \n780: PATTERN_CLEAN_FILES=../patterns/all_pattern_terms.txt \\\n781: \t$(DOSDP_OWL_FILES_DEFAULT) $(DOSDP_TERM_FILES_DEFAULT) \\\n782: \t$(DOSDP_OWL_FILES_CLUSTERING) $(DOSDP_TERM_FILES_CLUSTERING)\n783: \n784: .PHONY: pattern_clean\n785: pattern_clean:\n786: \trm -f $(PATTERN_CLEAN_FILES)\n787: \n788: ifeq ($(PAT),true)\n789: \n790: .PHONY: patterns\n791: patterns dosdp:\n792: \techo \"Validating all DOSDP templates\"\n793: \t$(MAKE) dosdp_validation\n794: \techo \"Building $(PATTERNDIR)/definitions.owl\"\n795: \t$(MAKE) $(PATTERNDIR)/pattern.owl $(PATTERNDIR)/definitions.owl\n796: \n797: # DOSDP Template Validation\n798: \n799: $(TMPDIR)/pattern_schema_checks: $(ALL_PATTERN_FILES) | $(TMPDIR)\n800: \t$(PATTERN_TESTER) $(PATTERNDIR)/dosdp-patterns/ && touch $@\n801: \n802: .PHONY: pattern_schema_checks\n803: pattern_schema_checks dosdp_validation: $(TMPDIR)/pattern_schema_checks\n804: \n805: .PHONY: update_patterns\n806: update_patterns: download_patterns\n807: \tif [ -n \"$$(find $(TMPDIR) -type f -path '$(TMPDIR)/dosdp/*.yaml')\" ]; then cp -r $(TMPDIR)/dosdp/*.yaml $(PATTERNDIR)/dosdp-patterns; fi\n808: \n809: # This command is a workaround for the absence of -N and -i in wget of alpine (the one ODK depend on now).\n810: # It downloads all patterns specified in external.txt\n811: .PHONY: download_patterns\n812: download_patterns:\n813: \trm -f $(TMPDIR)/dosdp/*.yaml.1 || true\n814: \tif [ -s $(PATTERNDIR)/dosdp-patterns/external.txt ]; then wget -i $(PATTERNDIR)/dosdp-patterns/external.txt --backups=1 -P $(TMPDIR)/dosdp; fi\n815: \trm -f $(TMPDIR)/dosdp/*.yaml.1 || true\n816: \n817: $(PATTERNDIR)/dospd-patterns/%.yml: download_patterns\n818: \tif cmp -s $(TMPDIR)/dosdp-$*.yml $@ ; then echo \"DOSDP templates identical.\"; else echo \"DOSDP templates different, updating.\" &&\\\n819: \t\tcp $(TMPDIR)/dosdp-$*.yml $@; fi\n820: \n821: \n822: # DOSDP Template: Pipelines\n823: # Each pipeline gets its own directory structure\n824: \n825: # DOSDP default pipeline\n826: \n827: DOSDP_TSV_FILES_DEFAULT = $(wildcard $(PATTERNDIR)/data/default/*.tsv)\n828: DOSDP_PATTERN_NAMES_DEFAULT = $(strip $(patsubst %.tsv, %, $(notdir $(DOSDP_TSV_FILES_DEFAULT))))\n829: DOSDP_OWL_FILES_DEFAULT = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/data/default/$(name).ofn)\n830: DOSDP_TERM_FILES_DEFAULT = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/data/default/$(name).txt)\n831: DOSDP_YAML_FILES_DEFAULT = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/dosdp-patterns/$(name).yaml)\n832: \n833: $(DOSDP_OWL_FILES_DEFAULT): $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_DEFAULT) $(ALL_PATTERN_FILES)\n834: \tif [ \"${DOSDP_PATTERN_NAMES_DEFAULT}\" ]; then $(DOSDPT) generate --catalog=$(CATALOG) \\\n835:     --infile=$(PATTERNDIR)/data/default/ --template=$(PATTERNDIR)/dosdp-patterns --batch-patterns=\"$(DOSDP_PATTERN_NAMES_DEFAULT)\" \\\n836:     --ontology=$< --obo-prefixes=true --outfile=$(PATTERNDIR)/data/default; fi\n837: \n838: .PHONY: dosdp-docs-default\n839: dosdp-docs-default: $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_DEFAULT) $(DOSDP_YAML_FILES_DEFAULT)\n840: \tmkdir -p $(DOCSDIR)/patterns/default\n841: \t$(DOSDPT) docs --obo-prefixes=true --catalog=$(CATALOG) \\\n842: \t\t       --ontology=$< \\\n843: \t\t       --infile=$(PATTERNDIR)/data/default \\\n844: \t\t       --template=$(PATTERNDIR)/dosdp-patterns \\\n845: \t\t       --batch-patterns=\"$(DOSDP_PATTERN_NAMES_DEFAULT)\" \\\n846: \t\t       --outfile=$(DOCSDIR)/patterns/default \\\n847: \t\t       --data-location-prefix=https://github.com/obophenotype/cell-ontology/tree/master/src/patterns/data/default\n848: \n849: \n850: \n851: # DOSDP clustering pipeline\n852: \n853: DOSDP_TSV_FILES_CLUSTERING = $(wildcard $(PATTERNDIR)/data/clustering/*.tsv)\n854: DOSDP_PATTERN_NAMES_CLUSTERING = $(strip $(patsubst %.tsv, %, $(notdir $(DOSDP_TSV_FILES_CLUSTERING))))\n855: DOSDP_OWL_FILES_CLUSTERING = $(foreach name, $(DOSDP_PATTERN_NAMES_CLUSTERING), $(PATTERNDIR)/data/clustering/$(name).ofn)\n856: DOSDP_TERM_FILES_CLUSTERING = $(foreach name, $(DOSDP_PATTERN_NAMES_CLUSTERING), $(PATTERNDIR)/data/clustering/$(name).txt)\n857: DOSDP_YAML_FILES_CLUSTERING = $(foreach name, $(DOSDP_PATTERN_NAMES_CLUSTERING), $(PATTERNDIR)/dosdp-patterns/$(name).yaml)\n858: \n859: $(DOSDP_OWL_FILES_CLUSTERING): $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_CLUSTERING) $(ALL_PATTERN_FILES)\n860: \tif [ \"${DOSDP_PATTERN_NAMES_CLUSTERING}\" ]; then $(DOSDPT) generate --catalog=$(CATALOG) \\\n861:     --infile=$(PATTERNDIR)/data/clustering --template=$(PATTERNDIR)/dosdp-patterns/ --batch-patterns=\"$(DOSDP_PATTERN_NAMES_CLUSTERING)\" \\\n862:     --ontology=$< --obo-prefixes=true --outfile=$(PATTERNDIR)/data/clustering; fi\n863: \n864: .PHONY: dosdp-docs-clustering\n865: dosdp-docs-clustering: $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_CLUSTERING) $(DOSDP_YAML_FILES_CLUSTERING)\n866: \tmkdir -p $(DOCSDIR)/patterns/clustering\n867: \t$(DOSDPT) docs --obo-prefixes=true --catalog=$(CATALOG) \\\n868: \t\t       --ontology=$< \\\n869: \t\t       --infile=$(PATTERNDIR)/data/clustering \\\n870: \t\t       --template=$(PATTERNDIR)/dosdp-patterns \\\n871: \t\t       --batch-patterns=\"$(DOSDP_PATTERN_NAMES_CLUSTERING)\" \\\n872: \t\t       --outfile=$(DOCSDIR)/patterns/clustering \\\n873: \t\t       --data-location-prefix=https://github.com/obophenotype/cell-ontology/tree/master/src/patterns/data/clustering\n874: # Generate template file seeds\n875: \n876: ## Generate template file seeds\n877: $(PATTERNDIR)/data/default/%.txt: $(PATTERNDIR)/dosdp-patterns/%.yaml $(PATTERNDIR)/data/default/%.tsv\n878: \t$(DOSDPT) terms --infile=$(word 2, $^) --template=$< --obo-prefixes=true --outfile=$@\n879: \n880: \n881: $(PATTERNDIR)/data/clustering/%.txt: $(PATTERNDIR)/dosdp-patterns/%.yaml $(PATTERNDIR)/data/clustering/%.tsv\n882: \t$(DOSDPT) terms --infile=$(word 2, $^) --template=$< --obo-prefixes=true --outfile=$@\n883: \n884: \n885: dosdp-matches-matches: $(SRC) $(ALL_PATTERN_FILES)\n886: \t$(DOSDPT) query --ontology=$< --catalog=$(CATALOG) --reasoner=elk --obo-prefixes=true \\\n887:     --batch-patterns=\"$(ALL_PATTERN_NAMES)\" --template=\"$(PATTERNDIR)/dosdp-patterns\" --outfile=\"$(PATTERNDIR)/data/matches/\"\n888: # Generating the seed file from all the TSVs.\n889: $(TMPDIR)/all_pattern_terms.txt: $(DOSDP_TERM_FILES_DEFAULT)   $(DOSDP_TERM_FILES_CLUSTERING) $(TMPDIR)/pattern_owl_seed.txt\n890: \tcat $^ | sort | uniq > $@\n891: \n892: $(TMPDIR)/pattern_owl_seed.txt: $(PATTERNDIR)/pattern.owl\n893: \t$(ROBOT) query --use-graphs true -f csv -i $< --query ../sparql/terms.sparql $@\n894: \n895: # Pattern pipeline main targets: the generated OWL files\n896: \n897: # Create pattern.owl, an ontology of all DOSDP patterns\n898: $(PATTERNDIR)/pattern.owl: $(ALL_PATTERN_FILES)\n899: \t$(DOSDPT) prototype --obo-prefixes true --template=$(PATTERNDIR)/dosdp-patterns --outfile=$@\n900: \n901: # Generating the individual pattern modules and merging them into definitions.owl\n902: $(PATTERNDIR)/definitions.owl: $(DOSDP_OWL_FILES_DEFAULT)   $(DOSDP_OWL_FILES_CLUSTERING)\n903: \tif [ \"${DOSDP_PATTERN_NAMES_DEFAULT}\" ]   || [ \"${DOSDP_PATTERN_NAMES_CLUSTERING}\" ] && [ $(PAT) = true ]; then $(ROBOT) merge $(addprefix -i , $^) \\\n904: \t\tannotate --ontology-iri $(ONTBASE)/patterns/definitions.owl  --version-iri $(ONTBASE)/releases/$(TODAY)/patterns/definitions.owl \\\n905:       --annotation owl:versionInfo $(VERSION) -o definitions.ofn && mv definitions.ofn $@; fi\n906: \n907: else # PAT=false\n908: # Even if pattern generation is disabled, we still extract a seed from definitions.owl\n909: $(TMPDIR)/all_pattern_terms.txt: $(PATTERNDIR)/definitions.owl\n910: \t$(ROBOT) query --use-graphs true -f csv -i $< --query $(SPARQLDIR)/terms.sparql $@\n911: \n912: dosdp_validation:\n913: endif\n914: \n915: # ----------------------------------------\n916: # SSSOM Mapping Files\n917: # ----------------------------------------\n918: \n919: validate-sssom-%:\n920: \ttsvalid $(MAPPINGDIR)/$*.sssom.tsv --comment \"#\"\n921: \tsssom validate $(MAPPINGDIR)/$*.sssom.tsv\n922: \n923: validate_mappings:\n924: \t$(MAKE_FAST) $(foreach n,$(MAPPINGS),validate-sssom-$(n))\n925: \n926: normalize-sssom-%:\n927: \tsssom-cli --output $(MAPPINGDIR)/$*.sssom.tsv $(MAPPINGDIR)/$*.sssom.tsv\n928: \n929: normalize_mappings:\n930: \t$(MAKE_FAST) $(foreach n,$(MAPPINGS),normalize-sssom-$(n))\n931: \n932: # This mappingset is manually curated, so we only check that the file actually exists.\n933: $(MAPPINGDIR)/cl-local.sssom.tsv:\n934: \ttest -f $@\n935: \n936: # This mappingset is manually curated, so we only check that the file actually exists.\n937: $(MAPPINGDIR)/cl.sssom.tsv:\n938: \ttest -f $@\n939: \n940: # This mappingset is manually curated, so we only check that the file actually exists.\n941: $(MAPPINGDIR)/fbbt.sssom.tsv:\n942: \ttest -f $@\n943: \n944: # This mappingset is manually curated, so we only check that the file actually exists.\n945: $(MAPPINGDIR)/zfa.sssom.tsv:\n946: \ttest -f $@\n947: \n948: # ----------------------------------------\n949: # Release artefacts: export formats\n950: # ----------------------------------------\n951: \n952: \n953: $(ONT)-base.obo: $(ONT)-base.owl\n954: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n955: $(ONT)-base.json: $(ONT)-base.owl\n956: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n957: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n958: \t\tmv $@.tmp.json $@\n959: $(ONT)-full.obo: $(ONT)-full.owl\n960: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n961: $(ONT)-full.json: $(ONT)-full.owl\n962: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n963: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n964: \t\tmv $@.tmp.json $@\n965: $(ONT)-simple.obo: $(ONT)-simple.owl\n966: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n967: $(ONT)-simple.json: $(ONT)-simple.owl\n968: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n969: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n970: \t\tmv $@.tmp.json $@\n971: $(ONT)-basic.obo: $(ONT)-basic.owl\n972: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n973: $(ONT)-basic.json: $(ONT)-basic.owl\n974: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n975: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n976: \t\tmv $@.tmp.json $@\n977: $(ONT)-non-classified.obo: $(ONT)-non-classified.owl\n978: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n979: $(ONT)-non-classified.json: $(ONT)-non-classified.owl\n980: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n981: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n982: \t\tmv $@.tmp.json $@\n983: cl-plus.obo: cl-plus.owl\n984: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n985: cl-plus.json: cl-plus.owl\n986: \t$(ROBOT) annotate --input $< --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n987: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n988: \t\tmv $@.tmp.json $@\n989: # ----------------------------------------\n990: # Release artefacts: main release artefacts\n991: # ----------------------------------------\n992: \n993: $(ONT).owl: $(ONT)-full.owl\n994: \t$(ROBOT) annotate --input $< --ontology-iri $(URIBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n995: \t\tconvert -o $@.tmp.owl && mv $@.tmp.owl $@\n996: \n997: $(ONT).obo: $(ONT).owl\n998: \t$(ROBOT) convert --input $< --check false -f obo $(OBO_FORMAT_OPTIONS) -o $@\n999: $(ONT).json: $(ONT).owl\n1000: \t$(ROBOT) annotate --input $< --ontology-iri $(URIBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n1001: \t\tconvert --check false -f json -o $@.tmp.json &&\\\n1002: \t\tmv $@.tmp.json $@\n1003: # -----------------------------------------------------\n1004: # Release artefacts: variants (base, full, simple, etc)\n1005: # -----------------------------------------------------\n1006: SHARED_ROBOT_COMMANDS = \n1007: \n1008: $(ONTOLOGYTERMS): $(SRCMERGED)\n1009: \t$(ROBOT) query -f csv -i $< --query ../sparql/cl_terms.sparql $@\n1010: \n1011: # ROBOT pipeline that merges imports, including components.\n1012: ROBOT_RELEASE_IMPORT_MODE=$(ROBOT) remove --input $< --select imports --trim false merge $(patsubst %, -i %, $(OTHER_SRC)) merge $(patsubst %, -i %, $(IMPORT_FILES))\n1013: \n1014: # ROBOT pipeline that removes imports, then merges components. This is for release artefacts that start from \"base\"\n1015: ROBOT_RELEASE_IMPORT_MODE_BASE=$(ROBOT) remove --input $< --select imports --trim false merge $(patsubst %, -i %, $(OTHER_SRC)) \n1016: \n1017: # base: A version of the ontology that does not include any externally imported axioms.\n1018: $(ONT)-base.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)\n1019: \t$(ROBOT_RELEASE_IMPORT_MODE) \\\n1020: \treason --reasoner $(REASONER) --equivalent-classes-allowed asserted-only --exclude-tautologies structural --annotate-inferred-axioms false \\\n1021: \trelax $(RELAX_OPTIONS) \\\n1022: \treduce -r $(REASONER) $(REDUCE_OPTIONS) \\\n1023: \tremove --base-iri http://purl.obolibrary.org/obo/CP_ --base-iri http://purl.obolibrary.org/obo/CL_ --base-iri http://purl.obolibrary.org/obo/cl# --axioms external --preserve-structure false --trim false \\\n1024: \t$(SHARED_ROBOT_COMMANDS) \\\n1025: \tannotate --link-annotation http://purl.org/dc/elements/1.1/type http://purl.obolibrary.org/obo/IAO_8000001 \\\n1026: \t\t--ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) \\\n1027: \t\t--output $@.tmp.owl && mv $@.tmp.owl $@\n1028: # Full: The full artefacts with imports merged, reasoned.\n1029: $(ONT)-full.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)\n1030: \t$(ROBOT_RELEASE_IMPORT_MODE) \\\n1031: \t\treason --reasoner $(REASONER) --equivalent-classes-allowed asserted-only --exclude-tautologies structural \\\n1032: \t\trelax $(RELAX_OPTIONS) \\\n1033: \t\treduce -r $(REASONER) $(REDUCE_OPTIONS) \\\n1034: \t\t$(SHARED_ROBOT_COMMANDS) annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) --output $@.tmp.owl && mv $@.tmp.owl $@\n1035: # foo-non-classified: (edit->imports-merged)\n1036: $(ONT)-non-classified.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)\n1037: \t$(ROBOT_RELEASE_IMPORT_MODE) \\\n1038: \t\t$(SHARED_ROBOT_COMMANDS) annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) --output $@.tmp.owl && mv $@.tmp.owl $@\n1039: # foo-simple: (edit->reason,relax,reduce,drop imports, drop every axiom which contains an entity outside the \"namespaces of interest\")\n1040: # drop every axiom: filter --term-file keep_terms.txt --trim true\n1041: #\tremove --select imports --trim false\n1042: $(ONT)-simple.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(SIMPLESEED) $(IMPORT_FILES) | all_robot_plugins\n1043: \t$(ROBOT_RELEASE_IMPORT_MODE) \\\n1044: \t\treason --reasoner $(REASONER) --equivalent-classes-allowed asserted-only --exclude-tautologies structural --annotate-inferred-axioms false \\\n1045: \t\trelax $(RELAX_OPTIONS) \\\n1046: \t\tremove --axioms equivalent \\\n1047: \t\tfilter --term-file $(SIMPLESEED) --select \"annotations ontology anonymous self\" --trim true --signature true \\\n1048: \t\treduce -r $(REASONER) $(REDUCE_OPTIONS) \\\n1049: \t\todk:normalize --base-iri http://purl.obolibrary.org/obo --subset-decls true --synonym-decls true \\\n1050: \t\trepair --merge-axiom-annotations true \\\n1051: \t\t$(SHARED_ROBOT_COMMANDS) annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) --output $@.tmp.owl && mv $@.tmp.owl $@\n1052: \n1053: # foo-basic: A version of -simple containing only relationships using relations on a configurable whitelist (default = BFO:0000050 (?)). \n1054: # See above (David comment) for explanation.\n1055: # removes any axioms that contains one of the ops that not in the whitelist file\n1056: $(ONT)-basic.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(SIMPLESEED) $(KEEPRELATIONS) $(IMPORT_FILES)\n1057: \t$(ROBOT_RELEASE_IMPORT_MODE) \\\n1058: \t\treason --reasoner $(REASONER) --equivalent-classes-allowed asserted-only --exclude-tautologies structural --annotate-inferred-axioms false \\\n1059: \t\trelax $(RELAX_OPTIONS) \\\n1060: \t\tremove --axioms equivalent \\\n1061: \t\tremove --axioms disjoint \\\n1062: \t\tremove --term-file $(KEEPRELATIONS) --select complement --select object-properties --trim true \\\n1063: \t\tfilter --term-file $(SIMPLESEED) --select \"annotations ontology anonymous self\" --trim true --signature true \\\n1064: \t\treduce -r $(REASONER) $(REDUCE_OPTIONS) \\\n1065: \t\t$(SHARED_ROBOT_COMMANDS) annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) --output $@.tmp.owl && mv $@.tmp.owl $@\n1066: \n1067: cl-plus.owl:\n1068: \techo \"ERROR: You have configured a custom release artefact ($@); this release artefact needs to be define in cl.Makefile!\" && false\n1069: # ----------------------------------------\n1070: # Debugging Tools\n1071: # ----------------------------------------\n1072: \n1073: explain_unsat: $(EDIT_PREPROCESSED) \n1074: \t$(ROBOT) explain -i $< -M unsatisfiability --unsatisfiable random:10 --explanation $(TMPDIR)/$@.md\n1075: \n1076: \n1077: \n1078: GHVERSION=v$(VERSION)\n1079: \n1080: .PHONY: public_release\n1081: public_release:\n1082: \t@test $(GHVERSION)\n1083: \tls -alt $(RELEASE_ASSETS_AFTER_RELEASE)\n1084: \tgh release create $(GHVERSION) --title \"$(VERSION) Release\" --draft $(RELEASE_ASSETS_AFTER_RELEASE) --generate-notes\n1085: \n1086: # ----------------------------------------\n1087: # General Validation\n1088: # ----------------------------------------\n1089: TSV=\n1090: ALL_TSV_FILES=$(DOSDP_TSV_FILES_CLUSTERING) $(DOSDP_TSV_FILES_DEFAULT)\n1091: \n1092: validate-tsv: $(TSV) | $(TMPDIR)\n1093: \tfor FILE in $< ; do \\\n1094: \t\ttsvalid $$FILE > $(TMPDIR)/validate.txt; \\\n1095: \t\tif [ -s $(TMPDIR)/validate.txt ]; then cat $(TMPDIR)/validate.txt && exit 1; fi ; \\\n1096: \tdone\n1097: \n1098: validate-all-tsv: $(ALL_TSV_FILES)\n1099: \t$(MAKE) validate-tsv TSV=\"$^\"\n1100: \n1101: # ----------------------------------------\n1102: # Editors Utilities\n1103: # ----------------------------------------\n1104: \n1105: # This is an experimental target people that want to use ODK Extended Prefix Map (EPM)\n1106: # can use to pull the (currently inofficial) OBO EPM into the workspace.\n1107: # Users are instructed to refer to the EPM only through the variable $(EXTENDED_PREFIX_MAP) as \n1108: # its location might change in a feature version of ODK.\n1109: $(EXTENDED_PREFIX_MAP): /tools/obo.epm.json\n1110: \tcp $< $@\n1111: \n1112: \n1113: \n1114: .PHONY: normalize_src\n1115: normalize_src: $(SRC)\n1116: \t$(ROBOT) convert -i $< -f ofn -o $(TMPDIR)/normalise && mv $(TMPDIR)/normalise $<\n1117: \n1118: .PHONY: validate_idranges\n1119: validate_idranges:\n1120: \tif [ -f cl-idranges.owl ]; then \\\n1121: \t\tdicer-cli policy --assume-manchester --show-owlapi-error cl-idranges.owl ; \\\n1122: \tfi\n1123: \n1124: # Deprecated: Use 'sh run.sh odk.py update' without using the Makefile.\n1125: .PHONY: update_repo\n1126: update_repo:\n1127: \todk.py update\n1128: \t\n1129: \n1130: update_docs:\n1131: \tmkdocs gh-deploy --config-file ../../mkdocs.yaml\n1132: \n1133: # Note to future generations: computing the real path relative to the\n1134: # current directory is a way to ensure we only clean up directories that\n1135: # are located below the current directory, regardless of the contents of\n1136: # the *DIR variables.\n1137: .PHONY: clean\n1138: clean:\n1139: \t$(MAKE) pattern_clean\n1140: \tfor dir in $(MIRRORDIR) $(TMPDIR) $(UPDATEREPODIR) ; do      \\\n1141: \t\treldir=$$(realpath --relative-to=$$(pwd) $$dir) ;    \\\n1142: \t\tcase $$reldir in .*|\"\") ;; *) rm -rf $$reldir/* ;; esac \\\n1143: \tdone\n1144: \trm -f $(CLEANFILES)\n1145: \n1146: .PHONY: help\n1147: help:\n1148: \t@echo \"$$data\"\n1149: \n1150: define data\n1151: Usage: [IMAGE=(odklite|odkfull)] [ODK_DEBUG=yes] sh run.sh make [(IMP|MIR|IMP_LARGE|PAT)=(false|true)] command\n1152: \n1153: ----------------------------------------\n1154: \tCommand reference\n1155: ----------------------------------------\n1156: \n1157: Core commands:\n1158: * prepare_release:\tRun the entire release pipeline. Use make IMP=false prepare_release to avoid rerunning the imports\n1159: * prepare_release_fast:\tRun the entire release pipeline without refreshing imports, recreating components or recompiling patterns.\n1160: * update_repo:\t\tUpdate the ODK repository setup using the config file cl-odk.yaml (DEPRECATED)\n1161: * test:\t\t\tRunning all validation tests\n1162: * test_fast:\t\tRuns the test suite, but without updating imports or components\n1163: * odkversion:\t\tShow the current version of the ODK Makefile and ROBOT.\n1164: * clean:\t\tDelete all temporary files\n1165: * help:\t\t\tPrint ODK Usage information\n1166: * public_release:\tUploads the release file to a release management system, such as GitHub releases. Must be configured.\n1167: \n1168: \n1169: Imports management:\n1170: * refresh-imports:\t\t\tRefresh all imports and mirrors.\n1171: * recreate-components:\t\t\tRecreate all components.\n1172: * no-mirror-refresh-imports:\t\tRefresh all imports without downloading mirrors.\n1173: * refresh-imports-excluding-large:\tRefresh all imports and mirrors, but skipping the ones labelled as 'is_large'.\n1174: * refresh-%:\t\t\t\tRefresh a single import, i.e. refresh-go will refresh 'imports/go_import.owl'.\n1175: * no-mirror-refresh-%:\t\t\tRefresh a single import without updating the mirror, i.e. refresh-go will refresh 'imports/go_import.owl'.\n1176: * mirror-%:\t\t\t\tRefresh a single mirror.\n1177: \n1178: DOSDP templates\n1179: * dosdp:\t\t\tRun the DOSDP patterns pipeline: Run tests, then build OWL files from the tables.\n1180: * patterns:\t\t\tAlias of the 'dosdp' command\n1181: * pattern_clean:\t\tDelete all temporary pattern files\n1182: * dosdp_validation:\t\tRun all validation checks on DOSDP template files and tables\n1183: * pattern_schema_checks:\tAlias of the 'dosdp_validation' command\n1184: * update_patterns:\t\tPull updated patterns listed in dosdp-patterns/external.txt\n1185: * dosdp-matches-%:\t\tRun the DOSDP matches/query pipeline as configured in your cl-odk.yaml file.\n1186: * dosdp-docs-%:                 Generate the documentation for a given DOSDP pipeline.\n1187: \n1188: Editor utilities:\n1189: * validate_idranges:\tMake sure your ID ranges file is formatted correctly\n1190: * normalize_src:\tLoad and save your cl-edit file after you to make sure its serialised correctly\n1191: * explain_unsat:\tIf you have unsatisfiable classes, this command will create a markdown file (tmp/explain_unsat.md) which will explain all your unsatisfiable classes\n1192: * validate-all-tsv:\tCheck all your tsv files for possible problems in syntax. Use ALL_TSV_FILES variable to list files\n1193: * validate-tsv:\t\tCheck a tsv file for syntactic problems with tsvalid. Use TSV variable to pass filepath, e.g. make TSV=../my.tsv validate-tsv.\n1194: * release_diff:\tCreate a diff between the current release and the new release\n1195: \n1196: Additional build commands (advanced users)\n1197: * all:\t\t\tRun the entire pipeline (like prepare_release), but without copying the release files to the release directory.\n1198: * all_subsets:\t\tBuild all subsets\n1199: * custom_reports:\tGenerate all custom sparql reports you have configured in your cl-odk.yaml file.\n1200: * all_assets:\t\tBuild all assets\n1201: * show_assets:\t\tPrint a list of all assets that would be build by the release pipeline\n1202: * all_mappings:\t\tUpdate all SSSOM mapping sets\n1203: \n1204: Additional QC commands (advanced users)\n1205: * robot_reports:\tRun all configured ROBOT reports\n1206: * validate_profile_%:\tRun an OWL2 DL profile validation check, for example validate_profile_cl-edit.owl.\n1207: * reason_test: Run a basic reasoning test\n1208: \n1209: Examples: \n\n(Output capped at 50 KB. Showing lines 1-1209. Use offset=1210 to continue.)\n</content>","metadata":{"preview":"# ----------------------------------------\n# Makefile for cl\n# Generated using onto