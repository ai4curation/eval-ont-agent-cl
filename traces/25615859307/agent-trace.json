ion_author=C Fathke, L Wilson, J Hutter, V Kapoor, A Smith, A Hocking, F Isik; citation_volume=22; citation_publication_date=2004; citation_pages=812-822; citation_doi=10.1634/stemcells.22-5-812; citation_id=CR10\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Leukoc Biol; citation_title=Pivotal Advance: Th-1 cytokines inhibit, and Th-2 cytokines promote fibrocyte differentiation; citation_author=DD Shao, R Suresh, V Vakil, RH Gomer, D Pilling; citation_volume=83; citation_publication_date=2008; citation_pages=1323-1333; citation_doi=10.1189/jlb.1107782; citation_id=CR11\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Immunol; citation_title=Inhibition of fibrocyte differentiation by serum amyloid P; citation_author=D Pilling, CD Buckley, M Salmon, RH Gomer; citation_volume=171; citation_publication_date=2003; citation_pages=5537-5546; citation_doi=10.4049/jimmunol.171.10.5537; citation_id=CR12\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Leukoc Biol; citation_title=Aggregated IgG inhibits the differentiation of human fibrocytes; citation_author=D Pilling, NM Tucker, RH Gomer; citation_volume=79; citation_publication_date=2006; citation_pages=1242-1251; citation_doi=10.1189/jlb.0805456; citation_id=CR13\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Immunol; citation_title=Identification of circulating fibrocytes as precursors of bronchial myofibroblasts in asthma; citation_author=M Schmidt, G Sun, MA Stacey, L Mori, S Mattoli; citation_volume=171; citation_publication_date=2003; citation_pages=380-389; citation_doi=10.4049/jimmunol.171.1.380; citation_id=CR14\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=Faseb J; citation_title=Characterization of human fibrocytes as circulating adipocyte progenitors and the formation of human adipose tissue in SCID mice; citation_author=KM Hong, MD Burdick, RJ Phillips, D Heber, RM Strieter; citation_volume=19; citation_publication_date=2005; citation_pages=2029-2031; citation_id=CR15\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=Wound Repair Regen; citation_title=Identification of fibrocytes in postburn hypertrophic scar; citation_author=L Yang, PG Scott, C Dodd, A Medina, H Jiao, HA Shankowsky, A Ghahary, EE Tredget; citation_volume=13; citation_publication_date=2005; citation_pages=398-404; citation_doi=10.1111/j.1067-1927.2005.130407.x; citation_id=CR16\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Leukoc Biol; citation_title=Accelerated wound healing in leukocyte-specific, protein 1-deficient mouse is associated with increased infiltration of leukocytes and fibrocytes; citation_author=J Wang, H Jiao, TL Stewart, MV Lyons, HA Shankowsky, PG Scott, EE Tredget; citation_volume=82; citation_publication_date=2007; citation_pages=1554-1563; citation_doi=10.1189/jlb.0507306; citation_id=CR17\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Invest Dermatol; citation_title=Increased severity of bleomycin-induced skin fibrosis in mice with leukocyte-specific protein 1 deficiency; citation_author=J Wang, H Jiao, TL Stewart, HA Shankowsky, PG Scott, EE Tredget; citation_volume=128; citation_publication_date=2008; citation_pages=2767-2776; citation_doi=10.1038/jid.2008.164; citation_id=CR18\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=J Exp Med; citation_title=Wound healing is accelerated by agonists of adenosine A2 (G alpha s-linked) receptors; citation_author=MC Montesinos, P Gadangi, M Longaker, J Sung, J Levine, D Nilsen, J Reibman, M Li, CK Jiang, R Hirschhorn; citation_volume=186; citation_publication_date=1997; citation_pages=1615-1620; citation_doi=10.1084/jem.186.9.1615; citation_id=CR19\"/>\n    <meta name=\"citation_reference\" content=\"citation_title=Adenosine A2A receptors play an active role in mouse bone marrow-derived mesenchymal stem cell development; citation_inbook_title=J Leukoc Biol; citation_publication_date=2008; citation_id=CR20; citation_author=M Katebi; citation_author=M Soleimani; citation_author=BN Cronstein\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=Inflammation; citation_title=Adenosine A2A receptor blockade or deletion diminishes fibrocyte accumulation in the skin in a murine model of scleroderma, bleomycin-induced fibrosis; citation_author=M Katebi, P Fernandez, ES Chan, BN Cronstein; citation_volume=31; citation_publication_date=2008; citation_pages=299-303; citation_doi=10.1007/s10753-008-9078-y; citation_id=CR21\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=Wound Repair Regen; citation_title=Serum amyloid P inhibits dermal wound healing; citation_author=B Naik-Mathuria, D Pilling, JR Crawford, AN Gay, CW Smith, RH Gomer, OO Olutoye; citation_volume=16; citation_publication_date=2008; citation_pages=266-273; citation_doi=10.1111/j.1524-475X.2008.00366.x; citation_id=CR22\"/>\n    <meta name=\"citation_reference\" content=\"citation_journal_title=Wound Repair Regen; citation_title=Fibrocytes from burn patients regulate the activities of fibroblasts; citation_author=JF Wang, H Jiao, TL Stewart, HA Shankowsky, PG Scott, EE Tredget; citation_volume=15; citation_publication_date=2007; citation_pages=113-121; citation_doi=10.1111/j.1524-475X.2006.00192.x; citation_id=CR23\"/>\n    <meta name=\"citation_author\" content=\"Blakaj, Adriana\"/>\n    <meta name=\"citation_author_institution\" content=\"Department of Medicine, Pathology, Epidemiology and Public Health, Yale University School of Medicine, The Anlyan Center, S525, New Haven, USA\"/>\n    <meta name=\"citation_author\" content=\"Bucala, Richard\"/>\n    <meta name=\"citation_author_email\" content=\"Richard.Bucala@Yale.edu\"/>\n    <meta name=\"citation_author_institution\" content=\"Department of Medicine, Pathology, Epidemiology and Public Health, Yale University School of Medicine, The Anlyan Center, S525, New Haven, USA\"/>\n    <meta name=\"format-detection\" content=\"telephone=no\"/>\n    <meta name=\"citation_cover_date\" content=\"2012/12/01\"/>\n    \n\n            \n    \n    <meta property=\"og:url\" content=\"https://link.springer.com/article/10.1186/1755-1536-5-S1-S6\"/>\n    <meta property=\"og:type\" content=\"article\"/>\n    <meta property=\"og:site_name\" content=\"SpringerLink\"/>\n    <meta property=\"og:title\" content=\"Fibrocytes in health and disease - Fibrogenesis &amp; Tissue Repair\"/>\n    <meta property=\"og:description\" content=\"Fibrocytes, a group of bone marrow-derived mesenchymal progenitor cells, were first described in 1994 as fibroblast-like, peripheral blood cells that migrate to regions of tissue injury. These cells are unique in their expression of extracellular matrix proteins concomitantly with markers of hematopoietic and monocyte lineage. The involvement of fibrocytes and the specific role they play in the process of wound repair has been a focus of study since their initial description. Fibrocytes contribute to the healing repertoire via several mechanisms; they produce a combination of cytokines, chemokines, and growth factors to create a milieu favorable for repair to occur; they serve as antigen presenting cells (APCs); they contribute to wound closure; and, they promote angiogenesis. Furthermore, regulatory pathways involving serum amyloid P, leukocyte-specific protein 1, and adenosine A2A receptors have emphasized the significant role that fibrocytes have in wound healing and fibrosis. The therapeutic targeting of fibrocytes holds promise for the augmentation of wound repair and the treatment of different fibrosing disorders.\"/>\n    <meta property=\"og:image\" content=\"https://media.springernature.com/full/springer-static/cover-hires/journal/13069\"/>\n    \n\n        \n\n        <meta name=\"format-detection\" content=\"telephone=no\">\n\n        