672: AnnotationAssertion(terms:creator obo:CL_0020021 \"GitHub Copilot\")\n\n  Line 25693: AnnotationAssertion(terms:creator obo:CL_0020023 \"GitHub Copilot\")\n\n  Line 25704: AnnotationAssertion(terms:creator obo:CL_0020024 \"GitHub Copilot\")\n\n  Line 25719: AnnotationAssertion(terms:creator obo:CL_0020025 \"GitHub Copilot\")\n\n  Line 25734: AnnotationAssertion(terms:creator obo:CL_0020026 \"GitHub Copilot\")\n\n  Line 25748: AnnotationAssertion(terms:creator obo:CL_0020027 \"GitHub Copilot\")\n\n  Line 25749: AnnotationAssertion(terms:date obo:CL_0020027 \"2025-12-05T00:00:00Z\"^^xsd:dateTime)\n\n\n(Results truncated: showing 100 of 424 matches (324 hidden). Consider using a more specific path or pattern.)","metadata":{"matches":424,"truncated":true},"title":"AnnotationAssertion\\(terms:creator obo:CL_|AnnotationAssertion\\(dc:creator obo:CL_|AnnotationAssertion\\(terms:date obo:CL_","time":{"start":1778979540708,"end":1778979540742}},"id":"prt_e33718edf001hpRihhzHFBuIUL","sessionID":"ses_1cc8f4f7fffeGdNCtRJTOfYiA5","messageID":"msg_e33716f42001SSknlZEr4y3wjO"}}
