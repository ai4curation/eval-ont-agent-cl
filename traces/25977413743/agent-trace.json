ons to odors.\")\n9202: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") oboInOwl:hasExactSynonym obo:CL_0000626 \"olfactory bulb granule cell\")\n9203: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") rdfs:comment obo:CL_0000626 \"Granule cells are the most abundant neuronal population in the olfactory bulb and are continuously renewed throughout life.\")\n9204: AnnotationAssertion(rdfs:label obo:CL_0000626 \"olfactory granule cell\")\n9205: EquivalentClasses(obo:CL_0000626 ObjectIntersectionOf(obo:CL_0000120 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005378)))\n9206: SubClassOf(obo:CL_0000626 obo:CL_0000099)\n9207: SubClassOf(obo:CL_0000626 ObjectSomeValuesFrom(obo:RO_0002103 obo:CL_1001502))\n9208: SubClassOf(obo:CL_0000626 ObjectSomeValuesFrom(obo:RO_0002103 obo:CL_1001503))\n9209: SubClassOf(obo:CL_0000626 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_1001502))\n\n(Showing lines 9170-9209 of 35625. Use offset=9210 to continue.)\n</content>","metadata":{"preview":"AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"FMA:83601\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"MESH:D007694\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"VHOG:0001697\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000623 \"NK cell\")\nAnnotationAssertion(rdfs:label obo:CL_0000623 \"natural killer cell\")\nEquivalentClasses(obo:CL_0000623 ObjectIntersectionOf(obo:CL_0001067 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001002) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001020) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001289) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001889) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002228) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050776)))\nSubClassOf(obo:CL_0000623 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000825))\n\n# Class: obo:CL_0000624 (CD4-positive, alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasD