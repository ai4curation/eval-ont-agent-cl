{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"rg -n -i 'quiescent fibroblast|inactive fibroblast|fibrocyte|fibroblast|quiescen' src/ontology/cl-edit.owl\"","aggregated_output":"3706:AnnotationAssertion(rdfs:comment obo:CL_0000001 \"Covers cells actively being cultured or stored in a quiescent state for future use.\")\n3718:Covers cells actively being cultured or stored in a quiescent state for future use.\")\n3743:# Class: obo:CL_0000005 (neural crest derived fibroblast)\n3745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\n3746:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\n3747:AnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n3784:AnnotationAssertion(rdfs:comment obo:CL_0000010 \"Note that this class was re-labeled to 'cultured cell' instead of 'cell line cell', as it intent was clarified to cover any cultured cells of multicellular and unicellular organisms. This includes cells actively being cultured, or cells that have been cultured but are stored in a quiescent state for future use. In having been cultured, cells must establish homeostasis and often replicate in a foreign environment. Accomodation of this stress initiates a selection of cells fit for such challenges, wherein necessary adaptive biochemical and.or genetic changes can occur. These changes can set them apart from the in vivo cells from which they derive, and such changes will typically accumulate and change over increasing time in culture.\")\n4279:# Class: obo:CL_0000057 (fibroblast)\n4281:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D005347\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Fibroblast\") obo:IAO_0000115 obo:CL_0000057 \"A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped.\")\n4288:AnnotationAssertion(rdfs:label obo:CL_0000057 \"fibroblast\")\n5048:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5065:# Class: obo:CL_0000135 (circulating fibrocyte)\n5067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20303382\") Annotation(oboInOwl:hasDbXref \"PMID:20305780\") Annotation(oboInOwl:hasDbXref \"PMID:29286323\") Annotation(oboInOwl:hasDbXref \"PMID:31473260\") Annotation(oboInOwl:hasDbXref \"PMID:32084275\") Annotation(oboInOwl:hasDbXref \"PMID:9177213\") Annotation(oboInOwl:hasDbXref \"doi:/10.1186/1755-1536-5-S1-S6\") obo:IAO_0000115 obo:CL_0000135 \"A bone marrow-derived cell that predominantly develops from myeloid lineage-restricted progenitor cells and circulates in peripheral blood, characterized by co-expression of hematopoietic markers CD45 and CD34 along with stromal markers including collagen type I in both humans and mice (Chesney et al., 1997; Blakaj and Bucala, 2012). This spindle-shaped cell exhibits a unique dual identity, functionally bridging immune and stromal compartments with characteristics of both monocytes and fibroblasts. Predominantly arising from circulating monocytes, it migrates to injury sites via chemokine receptors and participates in wound repair through extracellular matrix deposition, cytokine secretion, and antigen presentation via MHC class II. As mesenchymal progenitors, fibrocytes can differentiate into fibroblasts, myofibroblasts, and adipocytes, contributing to both physiological repair and pathological fibrosis (Blakaj and Bucala, 2012).\")\n5069:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30826294\") oboInOwl:hasNarrowSynonym obo:CL_0000135 \"monocyte-derived fibrocyte\")\n5070:AnnotationAssertion(rdfs:comment obo:CL_0000135 \"Cultured human fibrocytes are MHCI-positive, MHCII-positive, CD1a-negative, CD3-negative, CD4-negative, CD8-negative, CD10-negative, CD11b-positive, CD13-positive, CD14-negative, CD16-negative, CD18-positive, CD19-negative, CD25-negative, CD29-positive, CD32-positive, CD33-negative, CD34-positive, CD38-negative, CD40-positive, CD44-negative, CD45RO-positive, CD49a-positive, CD49b-positive, CD49c-negative, CD49d-negative, CD49e-positive, CD49f-negative, CD56-negative, CD58-positive, CD61-positive, CD64-positive, CD70-negative, CD71-positive, CD80-positive, CD83-negative, CD86-positive, CD103-negative, CD105-positive, CD181-positive, CD182-negative, CD183-positive, CD184-positive, CD185-negative, CD186-negative, CD191-positive, CD192-negative, CD193-positive, CD194-positive, CD195-positive, CD196-negative, CD197-positive, CD199-positive, desmin-negative, F4/80-positive, Gr1-positive, LSP-1-positive, MHCI-positive, MHCII-positive, alpha-SMA-negative, TCRab-negative, TCRgd-negative, and vimentin-positive. Fibrocytes are also capable of secreting angiogenin, bFGF, CCL2, CCL3, CCL4, CCL8, CXCL1, type I collagen, type III collagen, CTGF, fibronectin, GM-CSF, IL-1a, IL-6, IL-8, IL-10, M-CSF, MMP-9, PDGF-A, TGF-alpha, TGF-beta1, TNF-alpha, and VEGF-A.\")\n5071:AnnotationAssertion(rdfs:label obo:CL_0000135 \"circulating fibrocyte\")\n5558:# Class: obo:CL_0000186 (myofibroblast cell)\n5560:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D058628\") Annotation(oboInOwl:hasDbXref \"PMID:19800625\") Annotation(oboInOwl:hasDbXref \"PMID:20630469\") Annotation(oboInOwl:hasDbXref \"PMID:22387320\") obo:IAO_0000115 obo:CL_0000186 \"An animal cell that has characteristics of both a fibroblast cell and a smooth muscle cell.\")\n5562:AnnotationAssertion(rdfs:comment obo:CL_0000186 \"Myofibroblasts are alpha-SMA-positive, CD34-negative, CD45-negative. They are reportedly capable of secreting IL-1beta, IL-6, and TNF-alpha.\")\n5563:AnnotationAssertion(rdfs:label obo:CL_0000186 \"myofibroblast cell\")\n7099:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:37894875\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibroblast that is part of a tendon. Its cytoplasm is stretched between the collagen fibres of the tendon, and it possesses a central nucleus with a prominent nucleolus. Tendon cell has a well-developed rough endoplasmic reticulum, and it is responsible for the synthesis and turnover of tendon fibres and ground substance.\")\n7408:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\n8852:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D032496\") Annotation(oboInOwl:hasDbXref \"PMID:21849021\") Annotation(oboInOwl:hasDbXref \"PMID:23303905\") obo:IAO_0000115 obo:CL_0000594 \"An elongated, spindle-shaped, cell that is located between the basal lamina and the plasmalemma of a muscle fiber. These cells are mostly quiescent, but upon activation they divide to produce cells that generate new muscle fibers.\")\n9184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\n9539:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n9701:# Class: obo:CL_0000688 (perijunctional fibroblast)\n9703:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\n9704:AnnotationAssertion(rdfs:label obo:CL_0000688 \"perijunctional fibroblast\")\n14916:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0002092 \"A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.\")\n16506:# Class: obo:CL_0002240 (marrow fibroblast)\n16508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002240 \"A fibroblast in the bone marrow.\")\n16512:AnnotationAssertion(rdfs:label obo:CL_0002240 \"marrow fibroblast\")\n16516:# Class: obo:CL_0002241 (pulmonary interstitial fibroblast)\n16518:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002241 \"A fibroblasts found in interstitial spaces in the pulmonary tract. Greater numbers of these cells are found in idiopathic pulmonary fibrosis.\")\n16522:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002241 \"pulmonary myofibroblast\")\n16524:AnnotationAssertion(rdfs:label obo:CL_0002241 \"pulmonary interstitial fibroblast\")\n16667:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\n16674:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30309298\") oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal fibroblast\")\n17098:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n17194:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002301 \"fibroblast-like synoviocyte\")\n17195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23147896\") oboInOwl:hasExactSynonym obo:CL_0002301 \"synovial fibroblast\")\n17196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34433485\") Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Fibroblast-like_synoviocyte\") rdfs:comment obo:CL_0002301 \"Type B synovial cells play a key role in the pathogenesis of chronic inflammatory diseases, such as rheumatoid arthritis, and are essential for the maintenance of normal joint functions. Fibroblast-like synoviocytes from different joints have different properties, which may contribute to the characteristic pattern of joint involvement in different types of arthritis.\")\n17581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18793119\") obo:IAO_0000115 obo:CL_0002334 \"An undifferentiated fibroblast that can be stimulated to form a fat cell.\")\n17606:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15339667\") Annotation(oboInOwl:hasDbXref \"PMID:20568222\") Annotation(oboInOwl:hasDbXref \"PMID:9520465\") obo:IAO_0000115 obo:CL_0002337 \"A stem cell found in the basal layer of the epidermis, hair follicle, and sebaceous gland, characterised by its quiescent nature, high proliferative potential, and capacity for long-term self-renewal. This cell maintains epidermal homeostasis by producing transit-amplifying cells that differentiate to replenish the stratified squamous epithelium.\")\n17867:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\n17870:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002363 \"corneal fibroblast\")\n18334:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17200706\") obo:IAO_0000115 obo:CL_0002410 \"A cell that is found in the periacinar space of the exocrine pancreas and in perivascular and periductal regions of the pancreas, and has long cytoplasmic processes that encircle the base of the acinus. Expresses several intermediate filament proteins including vimentin and nestin. Shares many of the characteristics of hepatatic stellate cells, but not stellate cells of the central nervous system. Upon activation, this cell type undergoes morphological and gene expression changes that make the cell suggestive of being a type of myofibroblast.\")\n19167:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0004365\") obo:IAO_0000115 obo:CL_0002493 \"A polarized cell that is juxtaposed to fibrocytes in the underlying spiral ligament. This cell type secretes potassium ions derived from fibrocytes through gap junctions.\")\n19682:# Class: obo:CL_0002547 (fibroblast of the aortic adventitia)\n19684:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002547 \"A fibroblast of the aortic adventitia.\")\n19687:AnnotationAssertion(rdfs:label obo:CL_0002547 \"fibroblast of the aortic adventitia\")\n19691:# Class: obo:CL_0002548 (fibroblast of cardiac tissue)\n19693:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002548 \"A fibroblast that is part of the heart.\")\n19696:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002548 \"cardiac fibroblast\")\n19697:AnnotationAssertion(rdfs:label obo:CL_0002548 \"fibroblast of cardiac tissue\")\n19702:# Class: obo:CL_0002549 (fibroblast of choroid plexus)\n19704:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002549 \"A fibroblast that is part of the choroid plexus.\")\n19707:AnnotationAssertion(rdfs:label obo:CL_0002549 \"fibroblast of choroid plexus\")\n19711:# Class: obo:CL_0002550 (fibroblast of the conjunctiva)\n19713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002550 \"A fibroblast that is part of the conjuctiva of the eye.\")\n19716:AnnotationAssertion(rdfs:label obo:CL_0002550 \"fibroblast of the conjunctiva\")\n19720:# Class: obo:CL_0002551 (fibroblast of dermis)\n19724:AnnotationAssertion(rdfs:label obo:CL_0002551 \"fibroblast of dermis\")\n19728:# Class: obo:CL_0002552 (fibroblast of gingiva)\n19732:AnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n19736:# Class: obo:CL_0002553 (fibroblast of lung)\n19738:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002553 \"A fibroblast that is part of lung.\")\n19743:AnnotationAssertion(rdfs:label obo:CL_0002553 \"fibroblast of lung\")\n19747:# Class: obo:CL_0002554 (fibroblast of lymphatic vessel)\n19749:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002554 \"A fibroblast of the lymphatic system.\")\n19752:AnnotationAssertion(rdfs:label obo:CL_0002554 \"fibroblast of lymphatic vessel\")\n19756:# Class: obo:CL_0002555 (fibroblast of mammary gland)\n19758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002555 \"A fibroblast that is part of the mammary gland.\")\n19761:AnnotationAssertion(rdfs:label obo:CL_0002555 \"fibroblast of mammary gland\")\n19765:# Class: obo:CL_0002556 (fibroblast of periodontium)\n19767:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002556 \"A fibroblast of the periodontium.\")\n19770:AnnotationAssertion(rdfs:label obo:CL_0002556 \"fibroblast of periodontium\")\n19774:# Class: obo:CL_0002557 (fibroblast of pulmonary artery)\n19776:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002557 \"A fibroblast of pulmonary artery.\")\n19779:AnnotationAssertion(rdfs:label obo:CL_0002557 \"fibroblast of pulmonary artery\")\n19783:# Class: obo:CL_0002558 (fibroblast of villous mesenchyme)\n19785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002558 \"A fibroblast that is part of villous mesenchyme.\")\n19788:AnnotationAssertion(rdfs:label obo:CL_0002558 \"fibroblast of villous mesenchyme\")\n19953:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"NCIT:C41442\") Annotation(oboInOwl:hasDbXref \"PMID:25818566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Perineurium\") obo:IAO_0000115 obo:CL_0002576 \"A glial cell that is part of the perineurium. This cell type has thin long bipolar cytoplasmic processes, pinocytotic vesicles, fragments of external lamina and/or external lamina-like material, attachment plaques, and desmosome-like junctions. Perineurial cells historically have been referred to as fibroblasts because of shape; however, unlike fibroblasts, a perineurial cell: does not have a compact nucleus and large endoplasmic reticulum; does have a double basement membrane opposed to a single basal lamina; is carefully joined to other perineurial cells by tight junctions into a single sheet as opposed to arranged in a large mass; and finally, can surround a small axon bundle at a nerve terminal whereas a fibroblast cannot.\")\n19958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36244793\") rdfs:comment obo:CL_0002576 \"There are studies that largely accept the idea that the perineurial cell is a modified fibroblast with myofibroblastic features.\")\n20362:# Class: obo:CL_0002620 (skin fibroblast)\n20364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002620 \"A fibroblast of skin.\")\n20369:AnnotationAssertion(rdfs:label obo:CL_0002620 \"skin fibroblast\")\n20444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18396103\") oboInOwl:hasExactSynonym obo:CL_0002628 \"quiescent microglia\")\n20795:# Class: obo:CL_0002665 (otic fibrocyte)\n20800:AnnotationAssertion(rdfs:label obo:CL_0002665 \"otic fibrocyte\")\n20804:# Class: obo:CL_0002666 (type 2 otic fibrocyte)\n20806:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002666 \"An otic fibrocyte that underlies the spiral prominence and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20809:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002666 \"type II otic fibrocyte\")\n20810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004488\") oboInOwl:hasExactSynonym obo:CL_0002666 \"type II spiral ligament fibrocyte\")\n20811:AnnotationAssertion(rdfs:label obo:CL