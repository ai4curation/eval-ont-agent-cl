{"type":"tool_use","timestamp":1778976710750,"sessionID":"ses_1ccba0f2dffeVPd0wy4yf6tXOs","part":{"type":"tool","tool":"read","callID":"call_GdaZlBO0yzMlGHxlvKLPglMU","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/Makefile","offset":40,"limit":270},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/Makefile</path>\n<type>file</type>\n<content>\n40: SCRIPTSDIR=                 ../scripts\n41: UPDATEREPODIR=              target\n42: SPARQLDIR =                 ../sparql\n43: EXTENDED_PREFIX_MAP=        $(TMPDIR)/obo.epm.json\n44: COMPONENTSDIR =             components\n45: REPORT_FAIL_ON =            ERROR\n46: REPORT_LABEL =              \n47: REPORT_PROFILE_OPTS =       \n48: OBO_FORMAT_OPTIONS =        --clean-obo 'simple merge-comments'\n49: SPARQL_VALIDATION_CHECKS =  equivalent-classes owldef-self-reference nolabels pmid-not-dbxref obsolete-replaced_by obsolete-alt-id orcid-contributor illegal-annotation-property label-synonym-polysemy illegal-date def-not-only-xref id-format \n50: SPARQL_EXPORTS =            cl_terms cl-edges cl-synonyms cl-xrefs cl-def-xrefs \n51: ODK_VERSION_MAKEFILE =      v1.6\n52: RELAX_OPTIONS =             --include-subclass-of true\n53: REDUCE_OPTIONS =            --include-subproperties true\n54: \n55: TODAY ?=                    $(shell date +%Y-%m-%d)\n56: OBODATE ?=                  $(shell date +'%d:%m:%Y %H:%M')\n57: VERSION=                    $(TODAY)\n58: ANNOTATE_ONTOLOGY_VERSION = annotate -V $(ONTBASE)/releases/$(VERSION)/$@ --annotation owl:versionInfo $(VERSION)\n59: ANNOTATE_CONVERT_FILE =     annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) convert -f ofn --output $@.tmp.owl && mv $@.tmp.owl $@\n60: OTHER_SRC =                 $(PATTERNDIR)/definitions.owl $(COMPONENTSDIR)/hra_subset.owl $(COMPONENTSDIR)/mappings.owl $(COMPONENTSDIR)/blood_and_immune_upper_slim.owl $(COMPONENTSDIR)/eye_upper_slim.owl $(COMPONENTSDIR)/general_cell_types_upper_slim.owl $(COMPONENTSDIR)/kidney_upper_slim.owl $(COMPONENTSDIR)/cellxgene_subset.owl $(COMPONENTSDIR)/PNS_neurons.owl $(COMPONENTSDIR)/clm-cl.owl $(COMPONENTSDIR)/2DFTU_HRA_illustrations.owl $(COMPONENTSDIR)/wmbo-cl-comp.owl $(COMPONENTSDIR)/bgo-cl-comp.owl \n61: ONTOLOGYTERMS =             $(TMPDIR)/ontologyterms.txt\n62: EDIT_PREPROCESSED =         $(TMPDIR)/$(ONT)-preprocess.owl\n63: \n64: PATTERNDIR=                 ../patterns\n65: PATTERN_TESTER=             dosdp validate -i\n66: DOSDPT=                     dosdp-tools\n67: PATTERN_RELEASE_FILES=      $(PATTERNDIR)/definitions.owl $(PATTERNDIR)/pattern.owl\n68: \n69: MAPPINGDIR=                 ../mappings\n70: MAPPING_TESTER=             sssom validate\n71: SSSOMPY=                    sssom\n72: MAPPINGS=                   cl-local cl fbbt zfa \n73: MAPPING_RELEASE_FILES=      $(foreach n,$(MAPPINGS), $(MAPPINGDIR)/$(n).sssom.tsv)\n74: \n75: \n76: FORMATS = $(sort  owl obo json owl)\n77: FORMATS_INCL_TSV = $(sort $(FORMATS) tsv)\n78: RELEASE_ARTEFACTS = $(sort $(ONT)-base $(ONT)-full $(ONT)-simple $(ONT)-basic $(ONT)-non-classified cl-plus )\n79: \n80: ifeq ($(ODK_DEBUG),yes)\n81: ODK_DEBUG_FILE = debug.log\n82: SHELL = $(SCRIPTSDIR)/run-command.sh\n83: endif\n84: \n85: # ----------------------------------------\n86: # Workflow control\n87: # ----------------------------------------\n88: # Set any of the following variables to false to completely disable the\n89: # corresponding workflows.\n90: \n91: # Refresh of mirrors (and all remote resources more generally)\n92: MIR = true\n93: \n94: # Re-generation of import modules\n95: IMP = true\n96: \n97: # Re-generation of \"large\" import modules\n98: # Note that IMP=false takes precedence over IMP_LARGE=true, that is,\n99: # IMP=false disables the generation of all import modules, large or not.\n100: IMP_LARGE = true\n101: \n102: # Re-generation of component modules\n103: COMP = true\n104: \n105: # Re-generation of pattern-derived files\n106: PAT = true\n107: \n108: # ----------------------------------------\n109: # Top-level targets\n110: # ----------------------------------------\n111: \n112: .PHONY: .FORCE\n113: \n114: .PHONY: all\n115: all: all_odk\n116: \n117: .PHONY: all_odk\n118: all_odk: odkversion config_check test custom_reports all_assets release_diff\n119: \n120: .PHONY: test\n121: test: odkversion validate_idranges dosdp_validation reason_test sparql_test robot_reports $(REPORTDIR)/validate_profile_owl2dl_$(ONT).owl.txt\n122: \techo \"Finished running all tests successfully.\"\n123: \n124: .PHONY: test\n125: test_fast:\n126: \t$(MAKE_FAST) test\n127: \n128: .PHONY: release_diff\n129: release_diff: $(REPORTDIR)/release-diff.md\n130: \n131: .PHONY: reason_test\n132: reason_test: $(EDIT_PREPROCESSED)\n133: \t$(ROBOT) reason --input $< --reasoner $(REASONER) --equivalent-classes-allowed asserted-only \\\n134: \t\t--exclude-tautologies structural --output test.owl && rm test.owl\n135: \n136: .PHONY: odkversion\n137: odkversion:\n138: \t@echo \"ODK Makefile $(ODK_VERSION_MAKEFILE)\"\n139: \t@odk-info --tools\n140: .PHONY: config_check\n141: config_check:\n142: \t@if [ \"$$(tr -d '\\r' < $(ONT)-odk.yaml | sha256sum | cut -c1-64)\" = \"$(CONFIG_HASH)\" ]; then \\\n143: \t\techo \"Repository is up-to-date.\" ; else \\\n144: \t\techo \"Your ODK configuration has changed since this Makefile was generated. You may need to run 'make update_repo'.\" ; fi\n145: \n146: \n147: $(TMPDIR) $(REPORTDIR) $(MIRRORDIR) $(IMPORTDIR) $(COMPONENTSDIR) $(SUBSETDIR):\n148: \tmkdir -p $@\n149: \n150: # ----------------------------------------\n151: # ODK-managed ROBOT plugins\n152: # ----------------------------------------\n153: \n154: # Make sure ROBOT knows where to find plugins\n155: export ROBOT_PLUGINS_DIRECTORY=$(TMPDIR)/plugins\n156: \n157: # Override this rule in cl.Makefile to install custom plugins\n158: .PHONY: custom_robot_plugins\n159: custom_robot_plugins:\n160: \n161: \n162: .PHONY: extra_robot_plugins\n163: extra_robot_plugins:  $(ROBOT_PLUGINS_DIRECTORY)/flybase.jar  $(ROBOT_PLUGINS_DIRECTORY)/uberon.jar \n164: \n165: \n166: # Install all ROBOT plugins to the runtime plugins directory\n167: .PHONY: all_robot_plugins\n168: all_robot_plugins: $(foreach plugin,$(notdir $(wildcard /tools/robot-plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \\\n169: \t\t   $(foreach plugin,$(notdir $(wildcard ../../plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \\\n170: \t\t   custom_robot_plugins extra_robot_plugins  \\\n171: \n172: # Default rule to install plugins\n173: $(ROBOT_PLUGINS_DIRECTORY)/%.jar:\n174: \t@mkdir -p $(ROBOT_PLUGINS_DIRECTORY)\n175: \t@if [ -f ../../plugins/$*.jar ]; then        \\\n176: \t\tln ../../plugins/$*.jar $@ ;         \\\n177: \telif [ -f /tools/robot-plugins/$*.jar ]; then \\\n178: \t\tcp /tools/robot-plugins/$*.jar $@ ;  \\\n179: \tfi\n180: \n181: # Specific rules for supplementary plugins defined in configuration\n182: \n183: $(ROBOT_PLUGINS_DIRECTORY)/flybase.jar:\n184: \tcurl -L -o $@ https://github.com/FlyBase/flybase-robot-plugin/releases/download/flybase-robot-plugin-0.2.2/flybase.jar\n185: \n186: $(ROBOT_PLUGINS_DIRECTORY)/uberon.jar:\n187: \tcurl -L -o $@ https://github.com/obophenotype/uberon-robot-plugin/releases/download/uberon-robot-plugin-0.4.0/uberon.jar\n188: \n189: \n190: # ----------------------------------------\n191: # Release assets\n192: # ----------------------------------------\n193: \n194: MAIN_PRODUCTS = $(sort $(foreach r,$(RELEASE_ARTEFACTS), $(r)) $(ONT))\n195: MAIN_GZIPPED  = \n196: MAIN_FILES    = $(foreach n,$(MAIN_PRODUCTS), $(foreach f,$(FORMATS), $(n).$(f))) $(MAIN_GZIPPED)\n197: SRCMERGED     = $(TMPDIR)/merged-$(ONT)-edit.ofn\n198: \n199: .PHONY: all_main\n200: all_main: $(MAIN_FILES)\n201: \n202: # ----------------------------------------\n203: # Import assets\n204: # ----------------------------------------\n205: \n206: \n207: IMPORTS =  pr go uberon ro pato ncbitaxon ncbitaxondisjoints omo mbao dhbao stato\n208: \n209: IMPORT_ROOTS =  $(IMPORTDIR)/merged_import\n210: IMPORT_OWL_FILES = $(foreach n,$(IMPORT_ROOTS), $(n).owl)\n211: IMPORT_FILES = $(IMPORT_OWL_FILES)\n212: \n213: \n214: .PHONY: all_imports\n215: all_imports: $(IMPORT_FILES)\n216: \n217: # ----------------------------------------\n218: # Subset assets\n219: # ----------------------------------------\n220: \n221: \n222: SUBSETS =  BDS_subset blood_and_immune_upper_slim eye_upper_slim general_cell_types_upper_slim kidney_upper_slim human-view mouse-view\n223: \n224: SUBSET_ROOTS = $(patsubst %, $(SUBSETDIR)/%, $(SUBSETS))\n225: SUBSET_FILES = $(foreach n,$(SUBSET_ROOTS), $(foreach f,$(FORMATS_INCL_TSV), $(n).$(f)))\n226: \n227: .PHONY: all_subsets\n228: all_subsets: $(SUBSET_FILES)\n229: \n230: # ----------------------------------------\n231: # Mapping assets\n232: # ----------------------------------------\n233: \n234: \n235: MAPPINGS =  cl-local cl fbbt zfa\n236: \n237: RELEASED_MAPPINGS =  cl\n238: \n239: MAPPING_FILES = $(foreach p, $(MAPPINGS), $(MAPPINGDIR)/$(p).sssom.tsv)\n240: RELEASED_MAPPING_FILES = $(foreach p, $(RELEASED_MAPPINGS), $(MAPPINGDIR)/$(p).sssom.tsv)\n241: \n242: .PHONY: all_mappings\n243: all_mappings: $(MAPPING_FILES)\n244: \n245: \n246: # ----------------------------------------\n247: # QC Reports & Utilities\n248: # ----------------------------------------\n249: \n250: OBO_REPORT =  $(SRC)-obo-report cl-full.owl-obo-report\n251: ALIGNMENT_REPORT =  $(SRC)-align-report cl-full.owl-align-report\n252: REPORTS = $(OBO_REPORT)\n253: REPORT_FILES = $(patsubst %, $(REPORTDIR)/%.tsv, $(REPORTS))\n254: \n255: .PHONY: robot_reports\n256: robot_reports: $(REPORT_FILES)\n257: \n258: .PHONY: all_reports\n259: all_reports: custom_reports robot_reports\n260: \n261: # ----------------------------------------\n262: # ROBOT OWL Profile checking\n263: # ----------------------------------------\n264: \n265: # The merge step is necessary to avoid undeclared entity violations.\n266: $(REPORTDIR)/validate_profile_owl2dl_%.txt: % | $(REPORTDIR) $(TMPDIR)\n267: \t$(ROBOT) merge -i $< convert -f ofn -o $(TMPDIR)/validate.ofn\n268: \t$(ROBOT) validate-profile --profile DL -i $(TMPDIR)/validate.ofn -o $@ || { cat $@ && exit 1; }\n269: .PRECIOUS: $(REPORTDIR)/validate_profile_owl2dl_%.txt\n270: \n271: validate_profile_%: $(REPORTDIR)/validate_profile_owl2dl_%.txt\n272: \techo \"$* profile validation completed.\"\n273: \n274: # ----------------------------------------\n275: # Sparql queries: Q/C\n276: # ----------------------------------------\n277: \n278: # these live in the ../sparql directory, and have suffix -violation.sparql\n279: # adding the name here will make the violation check live.\n280: \n281: SPARQL_VALIDATION_QUERIES = $(foreach V,$(SPARQL_VALIDATION_CHECKS),$(SPARQLDIR)/$(V)-violation.sparql)\n282: \n283: sparql_test:  $(SRCMERGED) cl-full.owl | $(REPORTDIR)\n284: ifneq ($(SPARQL_VALIDATION_QUERIES),)\n285:   \n286: \t$(ROBOT) verify -i $(SRCMERGED) --queries $(SPARQL_VALIDATION_QUERIES) -O $(REPORTDIR)\n287:   \n288: \t$(ROBOT) verify -i cl-full.owl --queries $(SPARQL_VALIDATION_QUERIES) -O $(REPORTDIR)\n289: endif\n290: \n291: # ----------------------------------------\n292: # ROBOT report\n293: # ----------------------------------------\n294: \n295: $(REPORTDIR)/$(SRC)-obo-report.tsv: $(SRCMERGED) | $(REPORTDIR)\n296: \t$(ROBOT) report -i $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) --fail-on $(REPORT_FAIL_ON) --base-iri http://purl.obolibrary.org/obo/CP_ --base-iri http://purl.obolibrary.org/obo/CL_ --base-iri http://purl.obolibrary.org/obo/cl# --print 5 -o $@\n297: \n298: $(REPORTDIR)/%-obo-report.tsv: % | $(REPORTDIR)\n299: \t$(ROBOT) report -i $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) --fail-on $(REPORT_FAIL_ON) --base-iri http://purl.obolibrary.org/obo/CP_ --base-iri http://purl.obolibrary.org/obo/CL_ --base-iri http://purl.obolibrary.org/obo/cl# --print 5 -o $@\n300: \n301: check_for_robot_updates:\n302: \techo \"You are not using a custom profile, so you are getting the joy of the latest ROBOT report!\"\n303: \n304: \n305: # ----------------------------------------\n306: # Release assets\n307: # ----------------------------------------\n308: \n309: ASSETS = \\\n\n(Showing lines 40-309 of 1257. Use offset=310 to continue.)\n</content>","metadata":{"preview":"SCRIPTSDIR=                 ../scripts\nUPDATEREPODIR=              target\nSPARQLDIR =                 ../sparql\nEXTENDED_PREFIX_MAP=        $(TMPDIR)/obo.epm.json\nCOMPONENTSDIR =             components\nREPORT_FAIL_ON =            ERROR\nREPORT_LABEL =              \nREPORT_PROFILE_OPTS =       \nOBO_FORMAT_OPTIONS =        --clean-obo 'simple merge-comments'\nSPARQL_VALIDATION_CHECKS =  equivalent-classes owldef-self-reference nolabels pmid-not-dbxref obsolete-replaced_by obsolete-alt-id orcid-contributor illegal-annotation-property label-synonym-polysemy illegal-date def-not-only-xref id-format \nSPARQL_EXPORTS =            cl_terms cl-edges cl-synonyms cl-xrefs cl-def-xrefs \nODK_VERSION_MAKEFILE =      v1.6\nRELAX_OPTIONS =             --include-subclass-of true\nREDUCE_OPTIONS =            --include-subproperties true\n\nTODAY ?=                    $(shell date +%Y-%m-%d)\nOBODATE ?=                  $(shell date +'%d:%m:%Y %H:%M')\nVERSION=                    $(TODAY)\nANNOTATE_ONTOLOGY_VERSION = annotate -V $(ONTBASE)/releases/$(VERSION)/$@ --annotation owl:versionInfo $(VERSION)\nANNOTATE_CONVERT_FILE =     annotate --ontology-iri $(ONTBASE)/$@ $(ANNOTATE_ONTOLOGY_VERSION) convert -f ofn --output $@.tmp.owl && mv $@.tmp.owl $@","truncated":true,"loaded":[]},"title":"src/ontology/Makefile","time":{"start":1778976710734,"end":1778976710748}},"id":"prt_e33465ee8001SgsXrFw6Bl3RFs","sessionID":"ses_1ccba0f2dffeVPd0wy4yf6tXOs","messageID":"msg_e33463fb4001CxY0AyTZmcuBWj"}}
