n18280:# Class: obo:CL_0002397 (CD14-positive, CD16-positive monocyte)\n18282:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20628149\") Annotation(oboInOwl:hasDbXref \"PMID:21937707\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0002397 \"A CD14-positive monocyte that is also CD16-positive and CCR2-negative.\")\n18286:AnnotationAssertion(rdfs:comment obo:CL_0002397 \"This cell type is compatible with the HIPC Lyoplate markers for 'CD16+ monocyte'. Markers are associated with human cells. Note that this cell type encompasses both human intermediate monocytes (CD14+, CD16-low), and human non-classical monocytes (CD14-low, CD16+).\")\n18287:AnnotationAssertion(rdfs:label obo:CL_0002397 \"CD14-positive, CD16-positive monocyte\")\n19045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002471 \"Gr1-low non-classical monocyte that lacks expression of a MHC-II complex.\")\n19216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0002407\") obo:IAO_0000115 obo:CL_0002489 \"A thymocyte that lacks expression of CD4 and CD8.\")\n19574:# Class: obo:CL_0002526 (CD14-positive dermal dendritic cell)\n19576:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMID:19236899\") Annotation(oboInOwl:hasDbXref \"PMID:20309010\") obo:IAO_0000115 obo:CL_0002526 \"A dermal dendritic cell that is CD1a-negative and CD14-positive.\")\n19577:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002526 \"CD14+ dermal DC\")\n19579:AnnotationAssertion(rdfs:label obo:CL_0002526 \"CD14-positive dermal dendritic cell\")\n19583:# Class: obo:CL_0002527 (immature CD14-positive dermal dendritic cell)\n19585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") obo:IAO_0000115 obo:CL_0002527 \"An immature CD14-positive dermal dendritic cell is CD80-low, CD86-low, and MHCII-low.\")\n19586:AnnotationAssertion(rdfs:label obo:CL_0002527 \"immature CD14-positive dermal dendritic cell\")\n19590:# Class: obo:CL_0002528 (mature CD14-positive dermal dendritic cell)\n19592:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") obo:IAO_0000115 obo:CL_0002528 \"A mature CD14-positive dermal dendritic cell is CD80-high, CD86-high, MHCII-high and is CD83-positive.\")\n19593:AnnotationAssertion(rdfs:label obo:CL_0002528 \"mature CD14-positive dermal dendritic cell\")\n19600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMID:20309010\") obo:IAO_0000115 obo:CL_0002529 \"A dermal dendritic cell that is CD1a-positive and CD14-negative.\")\n20542:AnnotationAssertion(rdfs:comment obo:CL_0002629 \"Mature microglia are reportedly CCR2-positive, CD4-positive, CD9-positive, CD11a-positive, CD11b-positive, CD11c-positive, CD13-positive, CD16-positive, CDw17-positive, CD18-positive, CD21-positive, CD26-negative, CD32-positive, CD35-positive, CD36-positive, CD40-positive, CD44-positive, CD45-positive, CD53-positive, CD54-positive, CD56-negative, CD58-positive, CD63-positive, CD64-positive, CD66-positive, CD80-positive, CD86-positive, CD87-positive, CD92-positive, CD106-positive, CD107a-positive, CD147-positive, CD155-positive, CD162-positive, CD163-positive, CD171-negative, CD200R-positive, CXCR3-positive, CX3CR1-positive, fibronectin-positive, GD3-positive, GLUT1-positive, GLUT3-negative, GLUT5-positive, MHCI-positive, MHCII-positive, P2X4-positive, RFD7-negative, RGS5-negative, alpha-SMA-negative, vimentin-positive, and vwf-negative. Mature microglia are capable of producing BDNF, CCL3, CCL5, CCL7, CCL8, CCL9, CCL19, CCL20,CD40L, CSF, CXCL1, CXCL2, CXCL4, CXCL5, CXCL8, CXCL9, CXCL10, glutamate, IL-1beta, IL-1ra, IL-3, IL-6, IL-10, IL-12, LT, MMP-2, MMP-9, NGF, nitric oxide, ROS, TGF-beta, TNF-alpha.\")\n25162:SubClassOf(obo:CL_0017009 obo:CL_0001056)\n25534:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:27194328\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") obo:IAO_0000115 obo:CL_0020010 \"A GABAergic projection neuron located in the external segment of the globus pallidus (GPe) and defined by its exclusive projection to the dorsal striatum rather than to the subthalamic nucleus or basal ganglia output nuclei. In rodents and primates, it is characterized molecularly by expression of FOXP2, MEIS2, and NPAS1, and lacks expression of canonical pallidal markers NKX2-1 and LHX6 (Dodson et al., 2015; Abdi et al., 2015; Courtney et al., 2023). This neuron is GABAergic (GAD1/2⁺, SLC32A1/VGAT⁺) and typically PV⁻, forming the transcriptionally and developmentally LGE-derived subclass of GPe neurons (Dodson et al., 2015; Mallet et al., 2012).\")\n25658:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:36338137\") obo:IAO_0000115 obo:CL_0020021 \"A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.\")\n32935:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19648928\") Annotation(oboInOwl:hasDbXref \"PMID:35617956\") Annotation(oboInOwl:hasDbXref \"https://nrs.harvard.edu/URN-3:HUL.INSTREPOS:37368328\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") obo:IAO_0000115 obo:CL_4033057 \"A luminal epithelial cell of the mammary gland that can proliferate and has the potential to differentiate into a lactocyte during pregnancy. In humans, a luminal adaptive secretory precursor cell can be identified by high levels of the markers EpCAM and CD49f, and in mice it can be identified by low levels of CD29 and high levels of CD14, Kit, CD61, and Tspan8.\")\n33045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21918187\") Annotation(oboInOwl:hasDbXref \"PMID:30755708\") Annotation(oboInOwl:hasDbXref \"PMID:33150420\") obo:IAO_0000115 obo:CL_4033065 \"A mature B cell that serves as an intermediate stage in the differentiation of naive B cells into a plasmablast. A preplasmablast expresses CD30 and IL-6R and lacks expression of CD20, CD23, CD38 and CD138.\")\n","exit_code":0,"status":"completed"}}
