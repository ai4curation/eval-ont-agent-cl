0838 (lymphoid lineage restricted progenitor cell)\n11311:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000838 \"A progenitor cell restricted to the lymphoid lineage.\")\n11312:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000838 \"lymphoid progenitor cell\")\n11317:AnnotationAssertion(rdfs:label obo:CL_0000838 \"lymphoid lineage restricted progenitor cell\")\n11322:# Class: obo:CL_0000839 (myeloid lineage restricted progenitor cell)\n11324:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0000839 \"A progenitor cell restricted to the myeloid lineage.\")\n11325:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000839 \"myeloid progenitor cell\")\n11330:AnnotationAssertion(rdfs:label obo:CL_0000839 \"myeloid lineage restricted progenitor cell\")\n12388:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0000936 \"A lymphoid progenitor cell that is found in bone marrow, gives rise to B cells, T cells, natural killer cells and dendritic cells, and has the phenotype Lin-negative, Kit-positive, Sca-1-positive, FLT3-positive, CD34-positive, CD150 negative, and GlyA-negative.\")\n13300:# Class: obo:CL_0001027 (CD7-negative lymphoid progenitor cell)\n13302:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") obo:IAO_0000115 obo:CL_0001027 \"CD7-negative lymphoid progenitor cell is a lymphoid progenitor cell that is CD34-positive, CD7-negative and CD45RA-negative.\")\n13305:AnnotationAssertion(rdfs:label obo:CL_0001027 \"CD7-negative lymphoid progenitor cell\")\n13310:# Class: obo:CL_0001028 (CD7-positive lymphoid progenitor cell)\n13312:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:19491395\") obo:IAO_0000115 obo:CL_0001028 \"CD7-positive lymphoid progenitor cell is a lymphoid progenitor cell that is CD34-positive, CD7-positive and is CD45RA-negative.\")\n13315:AnnotationAssertion(rdfs:label obo:CL_0001028 \"CD7-positive lymphoid progenitor cell\")\n13322:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:17922016\") Annotation(oboInOwl:hasDbXref \"PMID:19286519\") obo:IAO_0000115 obo:CL_0001029 \"Common dendritic precursor is a hematopoietic progenitor cell that is CD117-low, CD135-positive, CD115-positive and lacks plasma membrane parts for hematopoietic lineage markers.\")\n13608:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0878932437\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2212039\") Annotation(oboInOwl:hasDbXref \"PMID:10724173\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:16647566\") obo:IAO_0000115 obo:CL_0001059 \"A progenitor cell committed to myeloid lineage, including the megakaryocyte and erythroid lineages. These cells are CD34-positive, and express Gata1, Gata2, C/EBPa, and Pu.1.\")\n13622:# Class: obo:CL_0001060 (hematopoietic oligopotent progenitor cell, lineage-negative)\n13624:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001060 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities. Cell lacks hematopoeitic lineage markers.\")\n13627:AnnotationAssertion(rdfs:label obo:CL_0001060 \"hematopoietic oligopotent progenitor cell, lineage-negative\")\n13690:# Class: obo:CL_0001066 (erythroid progenitor cell, mammalian)\n13692:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0001066 \"A progenitor cell committed to the erythroid lineage. This cell is ter119-positive but lacks expression of other hematopoietic lineage markers (lin-negative).\")\n13700:AnnotationAssertion(rdfs:label obo:CL_0001066 \"erythroid progenitor cell, mammalian\")\n13909:# Class: obo:CL_0002000 (Kit-positive erythroid progenitor cell)\n13911:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19805084\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002000 \"An erythroid progenitor cell is Kit-positive, Ly6A-negative, CD41-negative, CD127-negative, and CD123-negative. This cell type is also described as being lin-negative, Kit-positive, CD150-negative, CD41-negative, CD105-positive, and FcgR-negative.\")\n13914:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002000 \"c- Kit-positive erythroid progenitor cell\")\n13916:AnnotationAssertion(rdfs:label obo:CL_0002000 \"Kit-positive erythroid progenitor cell\")\n13943:# Class: obo:CL_0002003 (CD34-positive, GlyA-negative erythroid progenitor cell)\n13945:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19621348\") obo:IAO_0000115 obo:CL_0002003 \"An erythroid progenitor cell that is CD34-positive and is GlyA-negative.\")\n13950:AnnotationAssertion(rdfs:label obo:CL_0002003 \"CD34-positive, GlyA-negative erythroid progenitor cell\")\n13966:# Class: obo:CL_0002005 (CD34-positive, CD38-positive megakaryocyte erythroid progenitor cell)\n13968:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:190227700\") obo:IAO_0000115 obo:CL_0002005 \"A megakaryocyte erythroid progenitor cell is CD34-positive, CD38-positive and is IL3-receptor alpha-negative and CD45RA-negative.\")\n13972:AnnotationAssertion(rdfs:label obo:CL_0002005 \"CD34-positive, CD38-positive megakaryocyte erythroid progenitor cell\")\n13976:# Class: obo:CL_0002006 (Kit-positive, CD34-negative megakaryocyte erythroid progenitor cell)\n13978:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12615892\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002006 \"A megakaryocyte erythroid progenitor cell that is Kit-positive and is Sca1-negative, CD34-negative, CD90-negative, IL7r-alpha-negative and Fcgr II/III-low.\")\n13982:AnnotationAssertion(rdfs:label obo:CL_0002006 \"Kit-positive, CD34-negative megakaryocyte erythroid progenitor cell\")\n13986:# Class: obo:CL_0002007 (Kit-low, CD34-positive eosinophil progenitor cell)\n13988:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17582345\") obo:IAO_0000115 obo:CL_0002007 \"A lineage marker-negative, CD34-positive, IL5r-alpha-positive, and Sca1-negative eosinophil progenitor cell.\")\n13992:AnnotationAssertion(rdfs:label obo:CL_0002007 \"Kit-low, CD34-positive eosinophil progenitor cell\")\n13997:# Class: obo:CL_0002008 (CD34-positive, CD38-positive eosinophil progenitor cell)\n13999:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") obo:IAO_0000115 obo:CL_0002008 \"A lineage marker-negative, CD34-positive, CD38-positive, IL3r-alpha-positive, IL5r-alpha-positive, and CD45RA-negative eosinophil progenitor cell.\")\n14003:AnnotationAssertion(rdfs:label obo:CL_0002008 \"CD34-positive, CD38-positive eosinophil progenitor cell\")\n14010:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19273628\") obo:IAO_0000115 obo:CL_0002009 \"A progenitor cell that can give rise to plasmacytoid and myeloid dendritic cells, and to monocytes and macrophages.\")\n14030:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19273628\") obo:IAO_0000115 obo:CL_0002011 \"A progenitor cell that can give rise to plasmacytoid and myeloid dendritic cells, and to monocytes and macrophages. Marker for this cell is Kit-high, CD115-positive, CD135-positive, Cx3cr1-positive, and is Il7ra-negative.\")\n14161:# Class: obo:CL_0002023 (CD34-positive, CD41-positive, CD42-positive megakaryocyte progenitor cell)\n14163:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002023 \"A megakaroycotye progenitor cell that is CD34-positive, CD41-positive and CD42-positive on the cell surface.\")\n14167:AnnotationAssertion(rdfs:label obo:CL_0002023 \"CD34-positive, CD41-positive, CD42-positive megakaryocyte progenitor cell\")\n14172:# Class: obo:CL_0002024 (Kit-positive megakaryocyte progenitor cell)\n14174:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:16951553\") obo:IAO_0000115 obo:CL_0002024 \"A megakaryocyte progenitor cell that is Kit-positive, CD41-positive, CD9-positive, Sca-1-negative, IL7ralpha-negative, CD150-negative, and Fcgamma receptor II/III-low.\")\n14178:AnnotationAssertion(rdfs:label obo:CL_0002024 \"Kit-positive megakaryocyte progenitor cell\")\n14183:# Class: obo:CL_0002025 (CD34-positive, CD41-positive, CD42-negative megakaryocyte progenitor cell)\n14185:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002025 \"A megakaryocyte progenitor cell that is CD34-positive, CD41-positive, and CD42-negative.\")\n14189:AnnotationAssertion(rdfs:label obo:CL_0002025 \"CD34-positive, CD41-positive, CD42-negative megakaryocyte progenitor cell\")\n14196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15232614\") obo:IAO_0000115 obo:CL_0002026 \"A megakaryocyte progenitor cell that is CD34-negative, CD41-positive and CD42-positive.\")\n14216:# Class: obo:CL_0002028 (basophil mast progenitor cell)\n14223:AnnotationAssertion(rdfs:label obo:CL_0002028 \"basophil mast progenitor cell\")\n14238:# Class: obo:CL_0002030 (Fc-epsilon RIalpha-high basophil progenitor cell)\n14240:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") obo:IAO_0000115 obo:CL_0002030 \"A lineage negative, Sca1-negative basophil progenitor cell that is Fc epsilon RIalpha-high.\")\n14244:AnnotationAssertion(rdfs:label obo:CL_0002030 \"Fc-epsilon RIalpha-high basophil progenitor cell\")\n14249:# Class: obo:CL_0002031 (hematopoietic lineage restricted progenitor cell)\n14251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002031 \"A hematopoietic progenitor cell that is capable of developing into only one lineage of hematopoietic cells.\")\n14254:AnnotationAssertion(rdfs:label obo:CL_0002031 \"hematopoietic lineage restricted progenitor cell\")\n14261:# Class: obo:CL_0002032 (hematopoietic oligopotent progenitor cell)\n14263:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0002032 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities.\")\n14266:AnnotationAssertion(rdfs:comment obo:CL_0002032 \"This cell type is intended to be compatible with any vertebrate hematopoietic oligopotent progenitor cell.  For mammalian hematopoietic oligopotent progenitor cells known to be lineage-negative, please use the term 'hematopoietic oligopotent progenitor cell' (CL_0001060).\")\n14267:AnnotationAssertion(rdfs:label obo:CL_0002032 \"hematopoietic oligopotent progenitor cell\")\n14298:# Class: obo:CL_0002035 (Slamf1-negative multipotent progenitor cell)\n14304:AnnotationAssertion(rdfs:label obo:CL_0002035 \"Slamf1-negative multipotent progenitor cell\")\n14309:# Class: obo:CL_0002036 (Slamf1-positive multipotent progenitor cell)\n14316:AnnotationAssertion(rdfs:label obo:CL_0002036 \"Slamf1-positive multipotent progenitor cell\")\n14397:# Class: obo:CL_0002043 (CD34-positive, CD38-negative multipotent progenitor cell)\n14399:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18371405\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0002043 \"A hematopoietic multipotent progenitor cell that is CD34-positive, CD38-negative, CD45RA-negative, and CD90-negative.\")\n14402:AnnotationAssertion(rdfs:comment obo:CL_0002043 \"Cell markers are associated with human hematopoietic multipotent progenitor cells.\")\n14403:AnnotationAssertion(rdfs:label obo:CL_0002043 \"CD34-positive, CD38-negative multipotent progenitor cell\")\n14408:# Class: obo:CL_0002044 (Kit-positive, integrin beta7-high basophil mast progenitor cell)\n14410:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ak\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002044 \"A basophil mast progenitor cell that is Beta-7 integrin-high, Kit-positive FcRgammaII/III-positive and Sca1-negative.\")\n14414:AnnotationAssertion(rdfs:label obo:CL_0002044 \"Kit-positive, integrin beta7-high basophil mast progenitor cell\")\n14825:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002078 \"epithelial mesenchymal cell\")\n16098:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) Annotation(oboInOwl:hasDbXref <https://doi.org/10.3389/fcell.2021.644088>) obo:RO_0004050 obo:CL_0002196 \"Liver progenitor cells have been variously named in rodent and human studies as oval cells, hepatic progenitor cells, liver stem cells, ductular reactions, or atypical ductular cells. They were first described as oval cells in rats due to their large nuclear-to-cytoplasm ratio and oval-shaped nuclei. On the difference between 'hepatic liver stem cells' (HLSC) and 'oval cells':  \\\"... unlike a well-known hepatic progenitor cell population, known as oval cells in rodents, HLSCs do not express CK-7, CK-19, c-kit, CD133 and alpha-smooth muscle actin (α-SMA) (Gaudio et al., 2009)\\\".\")\n16104:AnnotationAssertion(Annotation(terms:contributor <http://orcid.org/0000-0003-1940-6740>) Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) oboInOwl:hasExactSynonym obo:CL_0002196 \"hepatic progenitor cell\")\n16105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1038/s12276-020-0483-0>) oboInOwl:hasExactSynonym obo:CL_0002196 \"liver progenitor cell\")\n17810:# Class: obo:CL_0002351 (progenitor cell of endocrine pancreas)\n17812:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20025937\") Annotation(oboInOwl:hasDbXref \"PMID:20217494\") Annotation(oboInOwl:hasDbXref \"PMID:22728667\") obo:IAO_0000115 obo:CL_0002351 \"A progenitor cell that is able to differentiate into the pancreas alpha, beta and delta endocrine cells. This cell type expresses neurogenin-3 and Isl-1.\")\n17816:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002351 \"pancreatic islet progenitor cell\")\n17817:AnnotationAssertion(rdfs:label obo:CL_0002351 \"progenitor cell of endocrine pancreas\")\n17829:# Class: obo:CL_0002353 (fetal liver hematopoietic progenitor cell)\n17834:AnnotationAssertion(rdfs:label obo:CL_0002353 \"fetal liver hematopoietic progenitor cell\")\n17912:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0813817986\") Annotation(oboInOwl:hasDbXref \"PMID:20711979\") obo:IAO_0000115 obo:CL_0002361 \"A progenitor cell that is capable of forming colonies of primitive erythrocytes in the blood island of the yolk sac. First arrive at E7.5 in mouse and expresses CD41.\")\n18066:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15580626\") Annotation(oboInOwl:hasDbXref \"PMID:30971890\") Annotation(oboInOwl:hasDbXref \"PMID:35815410\") obo:IAO_0000115 obo:CL_0002375 \"A multipotent progenitor cell that develops from a migratory neural crest cell. The schwann cell precursor is embedded among axons, with minimal extracellular space separating them from nerve cell membranes. This cell lacks a basal lamina, which distinguishes it from more mature Schwann cells. In rodents, cadherin-19 (Cdh19) serves as a specific marker for this developmental stage.\")\n18071:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35815410\") rdfs:comment obo:CL_0002375 \"Schwann cell precursor are capable of differentiating into Schwann cells and other cell types such as melanocytes, neurons, and mesenchymal cells.\")\n18479:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0813817986\") Annotation(oboInOwl:hasDbXref \"PMID:11495698\") obo:IAO_0000115 obo:CL_0002418 \"A pluripotent cell in the yolk sac that can give rise to mesenchymal cells including erythrocytes and endothelial cells.\")\n18841:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:16367798\") Annotation(oboInOwl:hasDbXref \"PMID:20142420\") Annotation(oboInOwl:hasDbXref \"PMID:31583586\") Annotation(oboInOwl:hasDbXref \"PMID:31726662\") Annotation(oboInOwl:hasDbXref \"PMID:37653126\") obo:IAO_0000115 obo:CL_0002453 \"A proliferative and migratory glial progenitor cell that derives from a neural stem cell and resides within the central nervous system. It possesses the capacity to differentiate into a committed oligodendrocyte progenitor (COP) through a well-defined series of maturation steps, ultimately giving rise to a myelinating oligodendrocyte (MOL). In mice and humans, it is characterized by the expression of specific molecular markers, including Pdgfra, Cspg4 (also known as NG2) and Olig2.\")\n18843:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:9780702028991\") Annotation(oboInOwl:hasDbXref \"PMID:10704434\") Annotation(oboInOwl:hasDbXref \"PMID:2182078\") terms:description obo:CL_0002453 \"This cell type can be purified from optic nerves and other regions of the embryonic, postnatal and adult rat CNS and can be differentiated in vitro to oligodendrocytes and type-2 astrocytes. Some references use the terms 'oligodendrocyte precursor cell' and 'oligodendrocyte type-2 astrocyte (O-2A) progenitor' to refer to the same entity (e.g., PMID:10704434), while others describe an oligodendrocyte type-2 astrocyte (O-2A) progenitor cell as the precurosr to oligodendrocyte- and type-2 astrocyte- progenitor cells (e.g, ISBN:9780702028991).\")\n19746:# Class: obo:CL_0002546 (embryonic blood vessel endothelial progenitor cell)\n19748:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002546 \"An endothelial progenitor cell that participates in angiogenesis during development.\")\n19752:AnnotationAssertion(rdfs:label obo:CL_0002546 \"embryonic blood vessel endothelial progenitor cell\")\n20423:# Class: obo:CL_0002619 (adult endothelial progenitor cell)\n20429:AnnotationAssertion(rdfs:comment obo:CL_0002619 \"The existence of adult endothelial progenitor cells has been controversial in the past.\")\n20430:AnnotationAssertion(rdfs:label obo:CL_0002619 \"adult endothelial progenitor cell\")\n20862:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17519333\") Annotation(oboInOwl:hasDbXref \"PMID:19745164\") oboInOwl:hasExactSynonym obo:CL_0002664 \"cardiovascular progenitor cell\")\n20870:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") Annotation(oboInOwl:hasDbXref \"PMID:37720106\") obo:IAO_0000115 obo:CL_0002665 \"A mesenchymal cell within the inner ear, specifically localised to supportive connective tissues such as the spiral ligament and spiral limbus. This cell has specialised structural and molecular adaptations, and it contributes to the homeostasis of the cochlear environment by participating in ionic regulation crucial for auditory function.\")\n20936:# Class: obo:CL_0002672 (retinal progenitor cell)\n20941:AnnotationAssertion(rdfs:label obo:CL_0002672 \"retinal progenitor cell\")\n22507:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005020 \"Lymphatic progenitor cells.\")\n22517:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15624319\") Annotation(oboInOwl:hasDbXref \"PMID:18430230\") obo:IAO_0000115 obo:CL_0005021 \"Mesenchymal derived lymphatic progenitor cells that give rise to the superficial lymphatics.\")\n22526:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:CVS\") obo:IAO_0000115 obo:CL_0005022 \"Lymphatic progenitor cells, derived from the veins, that give rise to lymphatic endothelial cells.\")\n22585:AnnotationAssertion(rdfs:comment obo:CL_0007001 \"Needs logical definition. Should be capable_of skeletal system morphogenesis? or skeletal tissue development? needs to be added to GO. NOTES:a cell type of the early embryo (see also: mesenchymal cells) that will give rise to mineralized connective tissue. Scleroblasts can differentiate into osteoblasts (bone-forming cells), chondroblasts (cartilage-forming cells), odontoblasts (dentin-forming cells), ameloblasts (enamel-forming cells). The mesenchymal cells developing into osteoblasts and chondroblasts are derived from the mesoderm. Those developing into odontoblasts are neural crest cells. Those developing into ameloblasts are derived from the ectoderm. (http://www.copewithcytokines.de/cope.cgi?key=scleroblasts)\")\n22670:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0007010 \"osteoprogenitor cell\")\n22927:# Class: obo:CL_0008019 (mesenchymal cell)\n22931:AnnotationAssertion(rdfs:label obo:CL_0008019 \"mesenchymal cell\")\n22950:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0008022 \"A mesenchymal cell of the endocardial cushion.   These cells develop via an epithelial to mesenchymal transition when endocardial cells break cell-to-cell contacts and migrate into the cardiac jelly. Cells from this population form the heart septa and valves.\")\n23342:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30827895\") oboInOwl:hasExactSynonym obo:CL_0009010 \"transit amplifying progenitor cell\")\n23383:# Class: obo:CL_0009013 (fetal hepatobiliary progenitor cell)\n23385:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31350390\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-3163-0115\") obo:IAO_0000115 obo:CL_0009013 \"A progenitor cell with hepatic and biliary lineage potential, identified in mouse and human, and anatomically restricted to the ductal plate of fetal liver.\")\n23388:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009013 \"fetal hepatobiliary hybrid progenitor cell\")\n23390:AnnotationAssertion(rdfs:label obo:CL_0009013 \"fetal hepatobiliary progenitor cell\")\n24126:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Colony_forming_unit_–_Hill\") obo:IAO_0000115 obo:CL_0009085 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. They may form discrete colonies.\")\n24156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_progenitor_cell&oldid=1069930016#Circulating_angiogenic_cell\") obo:IAO_0000115 obo:CL_0009088 \"An adult endothelial progenitor cell characterised in vivo by homing to ischemic sites and paracrine support of angiogenesis. These cells do not form colonies.\")\n24176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33419165\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Endothelial_colony_forming_cell&oldid=1068242094\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0002-0819-0473\") obo:IAO_0000115 obo:CL_0009090 \"An adult endothelial progenitor cell that is resident of adult vasculature and capable of differentiating to regenerate endothelial cell populations. Endothelial colony forming cells are characterised in vivo by clonal proliferative status, de novo vessel formation, homing to ischemic sites and paracrine support of angiogenesis. These cells are phenotypically similar to endothelial cells.\")\n24271:# Class: obo:CL_0009099 (fibro/adipogenic progenitor cell)\n24273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n24277:AnnotationAssertion(rdfs:label obo:CL_0009099 \"fibro/adipogenic progenitor cell\")\n24463:# Class: obo:CL_0009116 (progenitor cell of mammary luminal epithelium)\n24465:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19063729\") Annotation(oboInOwl:hasDbXref \"PMID:20346151\") Annotation(oboInOwl:hasDbXref \"PMID:21930782\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4412-7970\") obo:IAO_0000115 obo:CL_0009116 \"A progenitor cell with the potential to differentiate into luminal epithelial cells of mammary glands. In mouse, CD61 and c-kit were found to be coexpressed by the majority of, but not all, committed luminal progenitor cells.\")\n24467:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009116 \"luminal progenitor cell\")\n24468:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009116 \"progenitor cell of luminal mammary epithelium\")\n24469:AnnotationAssertion(rdfs:label obo:CL_0009116 \"progenitor cell of mammary luminal epithelium\")\n24475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/417>) Annotation(oboInOwl:hasDbXref \"PMID:2478566\") Annotation(oboInOwl:hasDbXref \"PMID:28445731\") Annotation(oboInOwl:hasDbXref \"PMID:30420661\") obo:IAO_0000115 obo:CL_0010000 \"A differentiating matrix keratinocyte that has initiated terminal differentiation and keratin synthesis. This cell undergoes a characteristic change while migrating upward from the hair follicle bulb, representing a committed progenitor cell destined to form the hair medulla, cortex and hair root sheath.\")\n24770:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:19029905\") Annotation(oboInOwl:hasDbXref \"PMID:21601793\") Annotation(oboInOwl:hasDbXref \"PMID:27935637\") Annotation(oboInOwl:hasDbXref \"PMID:29454785\") Annotation(oboInOwl:hasDbXref \"PMID:9354470\") obo:IAO_0000115 obo:CL_0011018 \"A group 3 innate lymphoid cell that express ROR gamma t and IL-7R alpha in the absence of lineage markers (e.g. CD3, CD19, B220, CD11c, Gr-1), with the functional ability to interact with mesenchymal cells through lymphotoxin and tumor necrosis factor. Lymphoid tissue-inducer cells are key to the development of lymph nodes and Peyer’s patches.\")\n24786:# Class: obo:CL_0011020 (neural progenitor cell)\n24790:AnnotationAssertion(rdfs:label obo:CL_0011020 \"neural progenitor cell\")\n24839:# Class: obo:CL_0011026 (progenitor cell)\n24843:AnnotationAssertion(rdfs:label obo:CL_0011026 \"progenitor cell\")\n25598:# Class: obo:CL_0020018 (proliferative fibrochondrocyte)\n25600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:39759119\") obo:IAO_0000115 obo:CL_0020018 \"A fibrochondrocyte located in fibrocartilage that exhibits active proliferation capacity and is in S phase of the cell cycle. It functions as a progenitor cell positioned at the root of developmental trajectories alongside fibrochondrocyte progenitors (FCP), with the capacity to diverge toward one of two developmental fates: (1) fibrochondrocytes and prehypertrophic chondrocytes, or (2) regulatory chondrocytes and prehypertrophic chondrocytes. It is characterised by co-expression of COL1A1, the growth factors FGF7 and CTGF, and the cell-cycle genes STMN1, KIAA0101, and MCM3 in humans. During early progenitor differentiation, FGF7 and COL1A1 expression increases and then declines as the cell commits to terminal fates.\")\n25606:AnnotationAssertion(rdfs:label obo:CL_0020018 \"proliferative fibrochondrocyte\")\n31895:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23124355\") rdfs:comment obo:CL_4030038 \"After acute tubular injury, this cell type becomes more numerous. In healthy rat kidneys, this cell is not detectable, whereas after unilateral ureteral obstruction (renal injury), it may appear de novo, arguing against the notion that this cell type represents a pre-existing progenitor cell population. In at least one study, data indicate that this cell type represents transiently dedifferentiated tubular cells involved in regeneration.\")\n32186:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17133361\") Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:IAO_0000115 obo:CL_4030066 \"An epithelial cell that is part of a ureteric bud. A ureteric bud cell has the potential to induce metanephric mesenchymal cells to proliferate and convert to epithelia that form renal tubules via: (1) the secretion of multiple diffusible growth factors that rescue renal progenitors from apoptosis and stimulate them to proliferate and (2) contact-dependent mechanisms that induce mesenchymal-epithelial conversion.\")\n32709:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\n32715:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25658372\") oboInOwl:hasExactSynonym obo:CL_4033048 \"respiratory suprabasal progenitor cell\")\n32813:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20346151\") oboInOwl:hasBroadSynonym obo:CL_4033057 \"luminal progenitor cell\")\n33471:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10467245\") obo:IAO_0000115 obo:CL_4042021 \"A progenitor cell of the central nervous system that differentiates exclusively onto neurons. This progenitor cell is found in a hippocampus subventricular zone, developing cortex and spinal cord of the central nervous system.\")\n33483:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15531362\") Annotation(oboInOwl:hasDbXref \"PMID:33052610\") obo:IAO_0000115 obo:CL_4042022 \"A progenitor cell of the central nervous system that differentiates exclusively onto astrocytes. This progenitor cell expresses CD44 and S100 calcium-binding protein B.\")\n33488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33052610\") rdfs:comment obo:CL_4042022 \"In vitro, this progenitor cell can differentiate from glial-restricted precursor cells.\")\n34084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\n34302:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199166\") Annotation(oboInOwl:hasDbXref \"PMID:34727990\") rdfs:comment obo:CL_4052026 \"In humans, type IIx fiber contains high levels of MYLK2, enhancing contraction speed and force via myosin phosphorylation, especially under low calcium. This mechanism supports post-activation potentiation, increasing force output in fast-twitch muscles. Additionally, this fiber has abundant ACTN3 (α-actinin-3), linked to muscle power, and exhibits the highest shortening velocity among human muscle fiber types. Notably, type IIx fiber is selectively lost in aging-related sarcopenia, increases in proportion in type 2 diabetes and obesity, and is the first to degenerate in Duchenne Muscular Dystrophy, impacting muscle function across various conditions.\")\n34690:# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)\n34692:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40475517\") obo:IAO_0000115 obo:CL_4052070 \"A bipotent progenitor cell within the human fallopian tube epithelium, characterized by the concurrent expression of epithelial (e.g., EpCAM/CD326) and endothelial (e.g., PECAM1/CD31) markers at both the cell surface and transcript levels. This cell has the capacity to differentiate into ciliated and secretory epithelial cells, as well as potentially endothelial/stromal lineages. Positioned at the apex of lineage bifurcation, the cell exhibits stem-like and endothelial features, representing an intermediate developmental state between undifferentiated progenitors and lineage-committed epithelial cells.\")\n34698:AnnotationAssertion(rdfs:label obo:CL_4052070 \"dual-feature fallopian tube progenitor cell\")\n34830:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n35323:# Class: obo:CL_4072104 (fibrochondrocyte)\n35325:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35327:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35330:AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n","exit_code":0,"status":"completed"}}
