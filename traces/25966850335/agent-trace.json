o:PR_000015665)))\nSubClassOf(obo:CL_4023017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\nSubClassOf(obo:CL_4023017 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\n\n# Class: obo:CL_4023018 (pvalb GABAergic interneuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023018 \"pvalb interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023018 \"A transcriptomically distinct GABAergic interneuron with a soma located in the pallium. These neurons express Parvalbumin.\")\nAnnotationAssertion(terms:contributor obo:CL_4023018 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023018 \"ILX:0770154\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023018 cl:BDS_subset)\nAnnotationAssertion(rdfs:comment obo:CL_4023018 \"Historically this term was used to refer to all Pvalb expressing GABAergic interneurons, but transcriptomic classification separates out some Pvalb expressing GABAergic interneurons as sibling classes (e.g. Pvalb chandelier).  We follow the transcriptomic classifications.\")\nAnnotationAssertion(rdfs:label obo:CL_4023018 \"pvalb GABAergic interneuron\")\nSubClassOf(obo:CL_4023018 obo:CL_0000099)\nSubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\nSubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\nSubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n\n# Class: obo:CL_4023019 (L5/6 cck, VIP GABAergic interneuron (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023019 \"A VIP GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\nAnnotationAssertion(terms:contributor obo:CL_4023019 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023019 \"L5/6 CCK Vip (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023019 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023019 \"L5/6 cck, VIP GABAergic interneuron (Mmus)\")\nEquivalentClasses(obo:CL_4023019 ObjectIntersectionOf(obo:CL_4023071 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648)))\n\n# Class: obo:CL_4023020 (dynamic gamma motor neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023020 \"A gamma motor neuron that innervates dynamic nuclear bag fibers (bag1 fibers) and enhances the sensitivities of Ia sensory neurons. They alter muscle spindle sensitivity and increases its discharge in response to velocity of muscle length (rather than just magnitude).\")\nAnnotationAssertion(terms:contributor obo:CL_4023020 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(rdfs:label obo:CL_4023020 \"dynamic gamma motor neuron\")\nSubClassOf(obo:CL_4023020 obo:CL_0008037)\nSubClassOf(obo:CL_4023020 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_4023005))\n\n# Class: obo:CL_4023021 (static gamma motor neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023021 \"A gamma motor neuron that innervates static nuclear bag fibers (bag2 fibers) and increases their firing, in response to an increase in the magnitude of change in length, and controls the static sensitivity of the stretch reflex.\")\nAnnotationAssertion(terms:contributor obo:CL_4023021 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(rdfs:label obo:CL_4023021 \"static gamma motor neuron\")\nSubClassOf(obo:CL_4023021 obo:CL_0008037)\nSubClassOf(obo:CL_4023021 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_4023006))\n\n# Class: obo:CL_4023022 (canopy lamp5 GABAergic cortical interneuron (Mmus))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023022 \"canopy lamp5 interneuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") obo:IAO_0000115 obo:CL_4023022 \"A Lamp5 GABAergic cortical interneuron that has extended axons in the surface of L1. Canopy Lamp5 cells resemble neurogliaform cells in having elongated horizontal axonal arbors largely confined to L1; but the dendritic arbors are wider and have fewer branches, while the axon is less tortuous and extends further from the soma\")\nAnnotationAssertion(terms:contributor obo:CL_4023022 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023022 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023022 \"canopy lamp5 GABAergic cortical interneuron (Mmus)\")\nSubClassOf(obo:CL_4023022 obo:CL_0000099)\nSubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n\n# Class: obo:CL_4023023 (L5,6 neurogliaform lamp5 GABAergic interneuron (Mmus))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023023 \"L5,6 NGC Lamp5 interneuron (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023023 \"A lamp 5 GABAergic cortical interneuron with neurogliaform morphology with a soma found in L5,6. L5,6 NGC lamp5 have deep afterhyperpolarization (AHP) but narrow action potentials (APs). Unlike other deep neurogliaform cells (which are caudal ganglionic eminence (CGE) derived), L5,6 NGC lamp5 cells are medial ganglionic eminence (MGE)-derived\")\nAnnotationAssertion(terms:contributor obo:CL_4023023 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023023 \"L5,6 NGC Lamp5 (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023023 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023023 \"L5,6 neurogliaform lamp5 GABAergic interneuron (Mmus)\")\nSubClassOf(obo:CL_4023023 obo:CL_0000099)\nSubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070001))\nSubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n\n# Class: obo:CL_4023024 (neurogliaform lamp5 GABAergic cortical interneuron (Mmus))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023024 \"NGC Lamp5 interneuron (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") obo:IAO_0000115 obo:CL_4023024 \"A lamp5 GABAergic cortical interneuron with layer-adapting morphology. NGC lamp5 cells have a small round soma, short dendrites, and a wide dense axonal arbor that tends to establish a dense axonal mesh with high connection probability both to themselves and L2 pyramidal cells. NGC lamp5 cells have unique synaptic properties that distinguish them from other GABAergic interneurons, including the release of GABA to the extracellular space via volume transmission, and the ability to produce GABA-B responses in connected postsynaptic targets.\")\nAnnotationAssertion(terms:contributor obo:CL_4023024 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023024 \"NGC Lamp5 (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023024 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023024 \"neurogliaform lamp5 GABAergic cortical interneuron (Mmus)\")\nSubClassOf(obo:CL_4023024 obo:CL_0000099)\nSubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070001))\nSubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9D387))\n\n# Class: obo:CL_4023025 (long-range projecting sst GABAergic cortical interneuron (Mmus))\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023025 \"A sst GABAergic cortical interneuron that is both an interneuron and a projecting neuron. They are found in all layers from upper L2/3 down to the bottom of L6. They have long-range projections, some with axons fading into white matter. These cells have low rebound potential, low hyperpolarization sag, and high variability in membrane time constant.\")\nAnnotationAssertion(terms:contributor obo:CL_4023025 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023025 \"LP SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023025 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023025 \"long-range projecting sst GABAergic cortical interneuron (Mmus)\")\nSubClassOf(obo:CL_4023025 obo:CL_4023121)\nSubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n\n# Class: obo:CL_4023026 (direct pathway medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023026 \"A medium spiny neuron that expresses dopamine type 1 receptors and projects to the globus pallidus internus or the substantia nigra pars reticulata.\")\nAnnotationAssertion(terms:contributor obo:CL_4023026 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023026 \"D1-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023026 \"dSPN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023026 \"dopamine 1 medium spiny neuron\")\nAnnotationAssertion(rdfs:label obo:CL_4023026 \"direct pathway medium spiny neuron\")\nSubClassOf(obo:CL_4023026 obo:CL_1001474)\nSubClassOf(obo:CL_4023026 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001175))\n\n# Class: obo:CL_4023027 (L5 sst T-Martinotti interneuron (Mmus))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023027 \"L5 T Martinotti sst interneuron (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023027 \"A sst GABAergic cortical interneuron with a soma found in L5 and possesses 'T-shaped' Martinotti morphologies with local axonal plexus in L5a and translaminar axons restricted to the uppermost part of L1. They show low-threshold spiking patterns with strong rebound firing, and inhibit the L1 apical tuft of nearby pyramidal cells.\")\nAnnotationAssertion(terms:contributor obo:CL_4023027 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023027 \"L5 T Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023027 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023027 \"L5 sst T-Martinotti interneuron (Mmus)\")\nSubClassOf(obo:CL_4023027 obo:CL_0000099)\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0070008))\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956))\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394))\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n\n# Class: obo:CL_4023028 (L5 non-Martinotti sst GABAergic interneuron (Mmus))\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_4023028 \"L5 non-Martinotti sst interneuron (Mus)\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023028 \"A sst GABAergic cortical interneuron with a soma found in lower L5 with mostly local axonal arborization but with some sparse ascending axons. L5 non-Martinotti sst cells show somatic localization and local axon plexus in L5b and L5b/6 and substantial innervation of L3 and L4, and receive thalamic input from the ventral posteromedial nucleus and specifically target L4 neurons, avoiding L5 pyramidal cells. L5 non-Martinotti sst cells tend to show a higher input resistance and seem to be less stuttering.\")\nAnnotationAssertion(terms:contributor obo:CL_4023028 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023028 \"L5 non-Martinotti SST (Mus musculus)\")\nAnnotationAssertion(oboInOwl:inSubset obo:CL_4023028 cl:BDS_subset)\nAnnotationAssertion(rdfs:label obo:CL_4023028 \"L5 non-Martinotti sst GABAergic interneuron (Mmus)\")\nSubClassOf(obo:CL_4023028 obo:CL_0000099)\nSubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005394))\nSubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\nSubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\nSubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P60041))\n\n# Class: obo:CL_4023029 (indirect pathway medium spiny neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023029 \"A medium spiny neuron that expresses dopamine type 2 receptors and projects to the external globus pallidus.\")\nAnnotationAssertion(terms:contributor obo:CL_4023029 <https://orcid.org/0000-0001-7258-9596>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"D2-MSN\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023029 \"dopamine 2 medium spiny neuron\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"iSPN\")\nAnnotationAssertion(rdfs:label obo:CL_4023029 \"indirect pathway medium spiny neuron\")\nSubClassOf(obo:CL_4023029 obo:CL_1001474)\n","exit_code":0,"status":"completed"}}
