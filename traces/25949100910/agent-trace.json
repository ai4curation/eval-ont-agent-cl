{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"rg -n 'salivary gland|parotid gland|sublingual gland|junctional epithelium|ionocyte|tuft cell|myoepithelial cell|fibroblast|duct cell|serous demilune|submandibular gland|basal duct' src/ontology/cl-edit.owl\"","aggregated_output":"3826:# Class: obo:CL_0000005 (neural crest derived fibroblast)\n3828:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\n3829:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\n3830:AnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n4360:# Class: obo:CL_0000057 (fibroblast)\n4369:AnnotationAssertion(rdfs:label obo:CL_0000057 \"fibroblast\")\n5131:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5150:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20303382\") Annotation(oboInOwl:hasDbXref \"PMID:20305780\") Annotation(oboInOwl:hasDbXref \"PMID:29286323\") Annotation(oboInOwl:hasDbXref \"PMID:31473260\") Annotation(oboInOwl:hasDbXref \"PMID:32084275\") Annotation(oboInOwl:hasDbXref \"PMID:9177213\") Annotation(oboInOwl:hasDbXref \"doi:/10.1186/1755-1536-5-S1-S6\") obo:IAO_0000115 obo:CL_0000135 \"A bone marrow-derived cell that predominantly develops from myeloid lineage-restricted progenitor cells and circulates in peripheral blood, characterized by co-expression of hematopoietic markers CD45 and CD34 along with stromal markers including collagen type I in both humans and mice (Chesney et al., 1997; Blakaj and Bucala, 2012). This spindle-shaped cell exhibits a unique dual identity, functionally bridging immune and stromal compartments with characteristics of both monocytes and fibroblasts. Predominantly arising from circulating monocytes, it migrates to injury sites via chemokine receptors and participates in wound repair through extracellular matrix deposition, cytokine secretion, and antigen presentation via MHC class II. As mesenchymal progenitors, fibrocytes can differentiate into fibroblasts, myofibroblasts, and adipocytes, contributing to both physiological repair and pathological fibrosis (Blakaj and Bucala, 2012).\")\n5630:# Class: obo:CL_0000185 (myoepithelial cell)\n5638:AnnotationAssertion(rdfs:label obo:CL_0000185 \"myoepithelial cell\")\n5642:# Class: obo:CL_0000186 (myofibroblast cell)\n5644:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D058628\") Annotation(oboInOwl:hasDbXref \"PMID:19800625\") Annotation(oboInOwl:hasDbXref \"PMID:20630469\") Annotation(oboInOwl:hasDbXref \"PMID:22387320\") obo:IAO_0000115 obo:CL_0000186 \"An animal cell that has characteristics of both a fibroblast cell and a smooth muscle cell.\")\n5646:AnnotationAssertion(rdfs:comment obo:CL_0000186 \"Myofibroblasts are alpha-SMA-positive, CD34-negative, CD45-negative. They are reportedly capable of secreting IL-1beta, IL-6, and TNF-alpha.\")\n5647:AnnotationAssertion(rdfs:label obo:CL_0000186 \"myofibroblast cell\")\n6878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28418596\") Annotation(oboInOwl:hasDbXref \"PMID:39798934\") Annotation(oboInOwl:hasDbXref \"PMID:40867641\") obo:IAO_0000115 obo:CL_0000346 \"A specialized fibroblast that resides in the dermal papilla located at the bottom of hair follicles. This cell orchestrates reciprocal epithelial-mesenchymal signaling essential for hair follicle morphogenesis and cycling, regulating matrix cell proliferation and differentiation to control hair shaft size, shape, and growth. The dermal papilla cell is replenished each hair cycle from bipotent hair follicle dermal stem cells in the dermal sheath that simultaneously self-renew and contribute progeny to the papilla, particularly during anagen.\")\n7185:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:37894875\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibroblast that is part of a tendon. Its cytoplasm is stretched between the collagen fibres of the tendon, and it possesses a central nucleus with a prominent nucleolus. Tendon cell has a well-developed rough endoplasmic reticulum, and it is responsible for the synthesis and turnover of tendon fibres and ground substance.\")\n7494:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\n9270:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\n9627:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n9789:# Class: obo:CL_0000688 (perijunctional fibroblast)\n9791:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\n9792:AnnotationAssertion(rdfs:label obo:CL_0000688 \"perijunctional fibroblast\")\n15024:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0002092 \"A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.\")\n16138:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17901986\") obo:IAO_0000115 obo:CL_0002196 \"A transient hepatic stem cell observed after liver injury with a high nuclear to cytoplasm ratio that can differentiate into mature hepatocytes and bile duct cells. Arises from more than one tissue.\")\n16210:# Class: obo:CL_0002203 (tuft cell of large intestine)\n16212:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:35271673\") obo:IAO_0000115 obo:CL_0002203 \"A tuft cell that is part of the epithelium of large intestine.\")\n16218:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") oboInOwl:hasExactSynonym obo:CL_0002203 \"tuft cell of epithelium of large intestine\")\n16220:AnnotationAssertion(rdfs:label obo:CL_0002203 \"tuft cell of large intestine\")\n16223:# Class: obo:CL_0002204 (tuft cell)\n16234:AnnotationAssertion(rdfs:label obo:CL_0002204 \"tuft cell\")\n16618:# Class: obo:CL_0002240 (marrow fibroblast)\n16620:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002240 \"A fibroblast in the bone marrow.\")\n16624:AnnotationAssertion(rdfs:label obo:CL_0002240 \"marrow fibroblast\")\n16628:# Class: obo:CL_0002241 (pulmonary interstitial fibroblast)\n16630:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002241 \"A fibroblasts found in interstitial spaces in the pulmonary tract. Greater numbers of these cells are found in idiopathic pulmonary fibrosis.\")\n16634:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002241 \"pulmonary myofibroblast\")\n16636:AnnotationAssertion(rdfs:label obo:CL_0002241 \"pulmonary interstitial fibroblast\")\n16779:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\n16786:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30309298\") oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal fibroblast\")\n17210:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n17306:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002301 \"fibroblast-like synoviocyte\")\n17307:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23147896\") oboInOwl:hasExactSynonym obo:CL_0002301 \"synovial fibroblast\")\n17573:# Class: obo:CL_0002324 (basal-myoepithelial cell of mammary gland)\n17575:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11250738\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") Annotation(oboInOwl:hasDbXref \"PMID:38059556\") obo:IAO_0000115 obo:CL_0002324 \"A myoepithelial cell that is part of a mammary gland and is located in the basal layer. During lactation, a basal-myoepithelial cell of mammary gland contracts under the stimulation of oxytocin. In humans, a basal-myoepithelial cell of mammary gland can be identified by high levels of CD49f and low levels of EpCAM.\")\n17580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37694522\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal myoepithelial cell\")\n17581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal-myoepithelial cell\")\n17584:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11250738\") oboInOwl:hasExactSynonym obo:CL_0002324 \"myoepithelial cell of mammary gland\")\n17586:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0002324 \"myoepithelial cell of lactiferous gland\")\n17590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38059556\") rdfs:comment obo:CL_0002324 \"Due inconsistencies in naming this and other mammary gland epithelial cell types, several mammary gland experts gathered for a breast atlas annotation jamboree organized by Chan-Zuckerberg initiative. They agreed to label this cell type as basal-myoepithelial cell (and abbreviated: B-Myo cell).\")\n17591:AnnotationAssertion(rdfs:label obo:CL_0002324 \"basal-myoepithelial cell of mammary gland\")\n17693:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18793119\") obo:IAO_0000115 obo:CL_0002334 \"An undifferentiated fibroblast that can be stimulated to form a fat cell.\")\n17979:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\n17982:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002363 \"corneal fibroblast\")\n18446:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17200706\") obo:IAO_0000115 obo:CL_0002410 \"A cell that is found in the periacinar space of the exocrine pancreas and in perivascular and periductal regions of the pancreas, and has long cytoplasmic processes that encircle the base of the acinus. Expresses several intermediate filament proteins including vimentin and nestin. Shares many of the characteristics of hepatatic stellate cells, but not stellate cells of the central nervous system. Upon activation, this cell type undergoes morphological and gene expression changes that make the cell suggestive of being a type of myofibroblast.\")\n18872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:hjd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15987436\") Annotation(oboInOwl:hasDbXref \"PMID:16397499\") Annotation(oboInOwl:hasDbXref \"PMID:17851544\") obo:IAO_0000115 obo:CL_0002451 \"A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.\")\n19176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cjm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0006420\") obo:IAO_0000115 obo:CL_0002481 \"The flattened smooth myoepithelial cells of mesodermal origin that lie just outside the basal lamina of the seminiferous tubule.\")\n19801:# Class: obo:CL_0002547 (fibroblast of the aortic adventitia)\n19803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002547 \"A fibroblast of the aortic adventitia.\")\n19806:AnnotationAssertion(rdfs:label obo:CL_0002547 \"fibroblast of the aortic adventitia\")\n19810:# Class: obo:CL_0002548 (fibroblast of cardiac tissue)\n19812:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002548 \"A fibroblast that is part of the heart.\")\n19815:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002548 \"cardiac fibroblast\")\n19816:AnnotationAssertion(rdfs:label obo:CL_0002548 \"fibroblast of cardiac tissue\")\n19821:# Class: obo:CL_0002549 (fibroblast of choroid plexus)\n19823:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002549 \"A fibroblast that is part of the choroid plexus.\")\n19826:AnnotationAssertion(rdfs:label obo:CL_0002549 \"fibroblast of choroid plexus\")\n19830:# Class: obo:CL_0002550 (fibroblast of the conjunctiva)\n19832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002550 \"A fibroblast that is part of the conjuctiva of the eye.\")\n19835:AnnotationAssertion(rdfs:label obo:CL_0002550 \"fibroblast of the conjunctiva\")\n19839:# Class: obo:CL_0002551 (fibroblast of dermis)\n19843:AnnotationAssertion(rdfs:label obo:CL_0002551 \"fibroblast of dermis\")\n19847:# Class: obo:CL_0002552 (fibroblast of gingiva)\n19851:AnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n19855:# Class: obo:CL_0002553 (fibroblast of lung)\n19857:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002553 \"A fibroblast that is part of lung.\")\n19862:AnnotationAssertion(rdfs:label obo:CL_0002553 \"fibroblast of lung\")\n19866:# Class: obo:CL_0002554 (fibroblast of lymphatic vessel)\n19868:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002554 \"A fibroblast of the lymphatic system.\")\n19871:AnnotationAssertion(rdfs:label obo:CL_0002554 \"fibroblast of lymphatic vessel\")\n19875:# Class: obo:CL_0002555 (fibroblast of mammary gland)\n19877:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002555 \"A fibroblast that is part of the mammary gland.\")\n19880:AnnotationAssertion(rdfs:label obo:CL_0002555 \"fibroblast of mammary gland\")\n19884:# Class: obo:CL_0002556 (fibroblast of periodontium)\n19886:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002556 \"A fibroblast of the periodontium.\")\n19889:AnnotationAssertion(rdfs:label obo:CL_0002556 \"fibroblast of periodontium\")\n19893:# Class: obo:CL_0002557 (fibroblast of pulmonary artery)\n19895:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002557 \"A fibroblast of pulmonary artery.\")\n19898:AnnotationAssertion(rdfs:label obo:CL_0002557 \"fibroblast of pulmonary artery\")\n19902:# Class: obo:CL_0002558 (fibroblast of villous mesenchyme)\n19904:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002558 \"A fibroblast that is part of villous mesenchyme.\")\n19907:AnnotationAssertion(rdfs:label obo:CL_0002558 \"fibroblast of villous mesenchyme\")\n20072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"NCIT:C41442\") Annotation(oboInOwl:hasDbXref \"PMID:25818566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Perineurium\") obo:IAO_0000115 obo:CL_0002576 \"A glial cell that is part of the perineurium. This cell type has thin long bipolar cytoplasmic processes, pinocytotic vesicles, fragments of external lamina and/or external lamina-like material, attachment plaques, and desmosome-like junctions. Perineurial cells historically have been referred to as fibroblasts because of shape; however, unlike fibroblasts, a perineurial cell: does not have a compact nucleus and large endoplasmic reticulum; does have a double basement membrane opposed to a single basal lamina; is carefully joined to other perineurial cells by tight junctions into a single sheet as opposed to arranged in a large mass; and finally, can surround a small axon bundle at a nerve terminal whereas a fibroblast cannot.\")\n20077:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36244793\") rdfs:comment obo:CL_0002576 \"There are studies that largely accept the idea that the perineurial cell is a modified fibroblast with myofibroblastic features.\")\n20482:# Class: obo:CL_0002620 (skin fibroblast)\n20484:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002620 \"A fibroblast of skin.\")\n20489:AnnotationAssertion(rdfs:label obo:CL_0002620 \"skin fibroblast\")\n20510:# Class: obo:CL_0002623 (acinar cell of salivary gland)\n20512:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:24646566\") Annotation(oboInOwl:hasDbXref \"PMID:25843887\") Annotation(oboInOwl:hasDbXref \"PMID:28623666\") Annotation(oboInOwl:hasDbXref \"PMID:34989394\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_0002623 \"An acinar cell that is part of the salivary gland epithelium, responsible for synthesizing and secreting the primary saliva essential for oral digestion, antimicrobial defense, and mucosal immunity. It features apical-basal polarity with apical secretory granules, and tight junctions that maintain polarity and regulate calcium-dependent saliva exocytosis triggered by parasympathetic and sympathetic signals (Ambudkar, 2015). This cell functions in coordination with contractile myoepithelial cells, which aid saliva flow through the ducts into the oral cavity (Khan et al., 2022). In mice and humans, acinar cell development relies on the transcription factor SOX2 (Emmerson et al., 2017), with self-renewal achieved primarily through acinar cell self-duplication and supported by progenitor populations during injury and regeneration (Aure et al., 2016).\")\n20516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24646566\") oboInOwl:hasExactSynonym obo:CL_0002623 \"salivary gland acinar cell\")\n20517:AnnotationAssertion(rdfs:label obo:CL_0002623 \"acinar cell of salivary gland\")\n20969:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33193034\") oboInOwl:hasExactSynonym obo:CL_0002669 \"tension fibroblast\")\n22450:# Class: obo:CL_0005006 (ionocyte)\n22452:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17555741\") Annotation(oboInOwl:hasDbXref \"PMID:19268451\") obo:IAO_0000115 obo:CL_0005006 \"Specialized epithelial cells involved in the maintenance of osmotic homeostasis. They are characterized by abundant mitochondria and ion transporters. In amniotes, they are present in the renal system. In freshwater fish, ionocytes in the skin and gills help maintain osmotic homeostasis by absorbing salt from the external environment.\")\n22453:AnnotationAssertion(rdfs:label obo:CL_0005006 \"ionocyte\")\n23016:# Class: obo:CL_0008023 (obsolete cardiac fibroblast)\n23020:AnnotationAssertion(rdfs:label obo:CL_0008023 \"obsolete cardiac fibroblast\")\n23344:# Class: obo:CL_0009005 (salivary gland cell)\n23346:AnnotationAssertion(obo:IAO_0000115 obo:CL_0009005 \"Any cell in a salivary gland.\")\n23349:AnnotationAssertion(rdfs:label obo:CL_0009005 \"salivary gland cell\")\n23519:# Class: obo:CL_0009020 (tuft cell of appendix)\n23521:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009020 \"An intestinal tuft cell that is a part of a vermiform appendix.\")\n23523:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009020 \"appendix tuft cell\")\n23524:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009020 \"tuft cell of appendix vermiformis\")\n23525:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009020 \"tuft cell of vermiform appendix\")\n23527:AnnotationAssertion(rdfs:label obo:CL_0009020 \"tuft cell of appendix\")\n23742:# Class: obo:CL_0009041 (tuft cell of colon)\n23744:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33079783\") Annotation(oboInOwl:hasDbXref \"PMID:35271673\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009041 \"A tuft cell that is part of the colonic epithelium, primarily adapted for microbial sensing in the dense colonic microbiota. Unlike its small intestinal counterpart, it does not participate in parasite-driven tuft cell–ILC2 circuits. Instead, it detects bacterial metabolites via taste-signaling pathways (Strine and Craig, 2022). The colonic tuft cell plays a key role in epithelial repair, modulates inflammatory responses through IL-25 secretion, and contributes to intestinal homeostasis by balancing microbiome interactions (Sebastian et al., 2021).\")\n23746:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009041 \"colon tuft cell\")\n23748:AnnotationAssertion(rdfs:label obo:CL_0009041 \"tuft cell of colon\")\n23982:# Class: obo:CL_0009065 (tuft cell of anorectum)\n23984:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") obo:IAO_0000115 obo:CL_0009065 \"An intestinal tuft cell that is located in the anorectum.\")\n23986:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009065 \"anorectum tuft cell\")\n23988:AnnotationAssertion(rdfs:label obo:CL_0009065 \"tuft cell of anorectum\")\n24073:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009074 \"A thymic medullary epithelial cell that expresses typical tuft cell markers instead of classical mTEC or cTEC markers. This population has a bulbous-like structure.\")\n24076:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009074 \"thymic tuft cell\")\n24108:# Class: obo:CL_0009078 (thymic fibroblast type 1)\n24110:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009078 \"A fibroblast located in the thymic capsule.\")\n24113:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009078 \"thymic capsular fibroblast\")\n24114:AnnotationAssertion(rdfs:label obo:CL_0009078 \"thymic fibroblast type 1\")\n24118:# Class: obo:CL_0009079 (thymic fibroblast type 2)\n24120:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009079 \"A fibroblast located between thymic lobules.\")\n24123:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009079 \"thymic interlobular fibroblast\")\n24124:AnnotationAssertion(rdfs:label obo:CL_0009079 \"thymic fibroblast type 2\")\n24128:# Class: obo:CL_0009080 (tuft cell of small intestine)\n24130:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-3440-1876\") Annotation(oboInOwl:hasDbXref \"http://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009080 \"A tuft cell located in the small intestine.\")\n24135:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009080 \"tuft cell of epithelium of small intestine\")\n24136:AnnotationAssertion(rdfs:label obo:CL_0009080 \"tuft cell of small intestine\")\n24335:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n24343:# Class: obo:CL_0009100 (hepatic portal fibroblast)\n24345:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20209607\") Annotation(oboInOwl:hasDbXref \"PMID:24814904\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009100 \"A fibroblast located in the portal triad. Hepatic portal fibroblast are a non-parenchymal cell population located adjacent to bile duct epithelia in liver and are distinct from stellate cells. They differentiate into fibrogenic myofibroblasts during chronic injury states producing high levels of collagen.\")\n24348:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009100 \"portal fibroblast\")\n24349:AnnotationAssertion(rdfs:label obo:CL_0009100 \"hepatic portal fibroblast\")\n24352:# Class: obo:CL_0009101 (fibroblastic reticular cell)\n24358:AnnotationAssertion(rdfs:label obo:CL_0009101 \"fibroblastic reticular cell\")\n24363:# Class: obo:CL_0009102 (lymph node fibroblastic reticular cell)\n24365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009102 \"A specialized, fibroblastic reticular cell of mesenchymal origin found in lymph nodes. In human, it expresses several markers common to myofibroblasts (desmin, vimentin, CD73, CD90, α-smooth muscle actin (αSMA)), and can be differentiated from endothelial cells by its lack of CD31 expression. These cells are critical for the overall organization and function of the lymph node. Lymph node fibroblastic reticular cells (FRCs) can be further classified based on their location, function, and unique marker expression.\")\n24369:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009102 \"fibroblastic reticular cell\")\n24370:AnnotationAssertion(rdfs:label obo:CL_0009102 \"lymph node fibroblastic reticular cell\")\n24376:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009103 \"A fibroblastic reticular cell found in the lymph node subcapsular sinus.\")\n24388:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009104 \"A fibroblastic reticular cell found in the lymph node germinal center dark zone (B cell zone).\")\n24392:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009104 \"lymph node germinal center dark zone fibroblastic reticular cell\")\n24402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009105 \"A fibroblastic reticular cell found in the lymph node T cell domain.\")\n24406:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009105 \"lymph node T cell domain fibroblastic reticular cell\")\n24415:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:33981032\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009106 \"A specialized fibroblast found in the medulla of lymph node.\")\n24856:# Class: obo:CL_0011021 (fibroblast of upper back skin)\n24858:AnnotationAssertion(obo:IAO_0000115 obo:CL_0011021 \"A fibroblast that is part of upper back skin.\")\n24860:AnnotationAssertion(rdfs:label obo:CL_0011021 \"fibroblast of upper back skin\")\n24864:# Class: obo:CL_0011022 (fibroblast of skin of back)\n24866:AnnotationAssertion(obo:IAO_0000115 obo:CL_0011022 \"A fibroblast that is part of skin of back.\")\n24868:AnnotationAssertion(rdfs:label obo:CL_0011022 \"fibroblast of skin of back\")\n24909:# Class: obo:CL_0011027 (skeletal muscle fibroblast)\n24911:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28369879\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6164-0667\") obo:IAO_0000115 obo:CL_0011027 \"Any fibroblast that is part of skeletal muscle tissue.\")\n24913:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0011027 \"skeleton muscle fibroblast\")\n24914:AnnotationAssertion(rdfs:label obo:CL_0011027 \"skeletal muscle fibroblast\")\n25124:# Class: obo:CL_0017000 (pulmonary ionocyte)\n25126:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30069044\") Annotation(oboInOwl:hasDbXref \"PMID:30069046\") obo:IAO_0000115 obo:CL_0017000 \"An ionocyte that is part of the lung epithelium. The cells from this type are major sources of the CFTR protein in human and mice.\")\n25128:AnnotationAssertion(rdfs:label obo:CL_0017000 \"pulmonary ionocyte\")\n25444:# Class: obo:CL_0019032 (intestinal tuft cell)\n25446:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:29714721\") Annotation(oboInOwl:hasDbXref \"PMID:35237268\") Annotation(oboInOwl:hasDbXref \"PMID:39358509\") obo:IAO_0000115 obo:CL_0019032 \"A tuft cell that is part of the intestinal epithelium, characterized by a distinctive apical tuft and lateral cytospinules connecting to neighbouring cells. This cell senses luminal stimuli via taste receptors and succinate signalling, initiating type 2 immune responses through the secretion of interleukin-25 while modulating epithelial regeneration through prostaglandin synthesis. It expresses key molecular markers such as doublecortin-like kinase 1 (DCLK1) in mice (Hendel et al., 2022), and KIT proto-oncogene in humans (Huang et al., 2024). Developed from intestinal crypt stem cells, this cell requires transcription factor POU2F3 for its development.\")\n25450:AnnotationAssertion(rdfs:label obo:CL_0019032 \"intestinal tuft cell\"@en)\n25456:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31324739\") Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:34046914\") Annotation(oboInOwl:hasDbXref \"PMID:34497389\") obo:IAO_0000115 obo:CL_0020000 \"A mesenchymal stromal cell found in the gut during development, and interacts with lymphoid tissue inducer (LTi) cells to drive secondary lymphoid organ formation (Prados et al., 2021). It expresses LTβR, PDGFRα, and VCAM, and upon activation secretes chemokines(e.g. CXCL13) and cytokines to organise lymphoid tissue architecture and recruit immune cells in both mice and humans (Denton el al., 2019; Elmentaite et al., 2021). As a multipotent progenitor, an mLTo cell differentiates into adult stromal subsets, including fibroblastic reticular cells (FRCs) (Prados et al., 2021), and its descendants persist in the adult gut-associated lymphoid tissues to maintain immune homeostasis(Denton el al., 2019; Lütge et al., 2021).\")\n25580:# Class: obo:CL_0020011 (hair follicle associated fibroblast)\n25582:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20022473\") Annotation(oboInOwl:hasDbXref \"PMID:34297930\") obo:IAO_0000115 obo:CL_0020011 \"A specialized dermal fibroblast within the hair follicle mesenchymal compartment that participates in epithelial-mesenchymal signaling to regulate hair morphogenesis, cycling, and homeostasis through production of inductive signals and extracellular matrix maintenance.\")\n25585:AnnotationAssertion(rdfs:label obo:CL_0020011 \"hair follicle associated fibroblast\")\n25589:# Class: obo:CL_0020012 (hair follicle isthmus-associated fibroblast)\n25591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:40993240\") obo:IAO_0000115 obo:CL_0020012 \"A fibroblast that is part of the hair follicle isthmus (mid-hair shaft). In humans, this cell expresses CRABP1/COCH/RSPO4 and tendon-associated genes (MKX, TNMD).\")\n25593:AnnotationAssertion(rdfs:label obo:CL_0020012 \"hair follicle isthmus-associated fibroblast\")\n25596:# Class: obo:CL_0020013 (dermal sheath fibroblast)\n25598:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31857493\") Annotation(oboInOwl:hasDbXref \"PMID:35069694\") obo:IAO_0000115 obo:CL_0020013 \"A fibroblast forming the connective tissue sheath that encloses the hair follicle epithelium from the level of the bulge downward to the hair bulb. This cell expresses characteristic markers, including DPEP1 in humans and COL11A1 and ACTA2 (alpha-smooth muscle actin) in mice and humans. Dermal sheath fibroblast possesses contractile properties mediated by calcium-calmodulin-myosin light chain kinase signalling, generating centripetal force during hair follicle catagen that relocates the dermal papilla to the stem cell niche.\")\n25600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34297930\") oboInOwl:hasRelatedSynonym obo:CL_0020013 \"DS fibroblast\")\n25601:AnnotationAssertion(rdfs:label obo:CL_0020013 \"dermal sheath fibroblast\")\n25967:AnnotationAssertion(rdfs:comment obo:CL_0020043 \"Stecco et al. demonstrate that fasciacytes differ from classical fascial fibroblasts in morphology, location (small clusters at the interface between fibrous and loose fascial layers), marker profile (S-100A4 expression), and ECM output (HA-rich rather than collagen-rich).\")\n26515:# Class: obo:CL_1000299 (fibroblast of connective tissue of prostate)\n26517:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000299 \"A fibroblast that is part of the connective tissue of prostate.\")\n26519:AnnotationAssertion(rdfs:label obo:CL_1000299 \"fibroblast of connective tissue of prostate\")\n26523:# Class: obo:CL_1000300 (fibroblast of outer membrane of prostatic capsule)\n26525:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000300 \"A fibroblast that is part of the outer membrane of prostatic capsule.\")\n26527:AnnotationAssertion(rdfs:label obo:CL_1000300 \"fibroblast of outer membrane of prostatic capsule\")\n26531:# Class: obo:CL_1000301 (fibroblast of subepithelial connective tissue of prostatic gland)\n26533:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000301 \"A fibroblast that is part of the subepithelial connective tissue of prostatic gland.\")\n26535:AnnotationAssertion(rdfs:label obo:CL_1000301 \"fibroblast of subepithelial connective tissue of prostatic gland\")\n26539:# Class: obo:CL_1000302 (fibroblast of papillary layer of dermis)\n26541:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000302 \"A fibroblast that is part of the papillary layer of dermis.\")\n26543:AnnotationAssertion(rdfs:label obo:CL_1000302 \"fibroblast of papillary layer of dermis\")\n26547:# Class: obo:CL_1000303 (fibroblast of areolar connective tissue)\n26549:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000303 \"A fibroblast that is part of the areolar connective tissue.\")\n26551:AnnotationAssertion(rdfs:label obo:CL_1000303 \"fibroblast of areolar connective tissue\")\n26556:# Class: obo:CL_1000304 (fibroblast of connective tissue of nonglandular part of prostate)\n26558:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000304 \"A fibroblast that is part of the connective tissue of nonglandular part of prostate.\")\n26560:AnnotationAssertion(rdfs:label obo:CL_1000304 \"fibroblast of connective tissue of nonglandular part of prostate\")\n26564:# Class: obo:CL_1000305 (fibroblast of connective tissue of glandular part of prostate)\n26566:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000305 \"A fibroblast that is part of the connective tissue of glandular part of prostate.\")\n26568:AnnotationAssertion(rdfs:label obo:CL_1000305 \"fibroblast of connective tissue of glandular part of prostate\")\n26572:# Class: obo:CL_1000306 (fibroblast of tunica adventitia of artery)\n26574:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000306 \"A fibroblast that is part of the tunica adventitia of artery.\")\n26576:AnnotationAssertion(rdfs:label obo:CL_1000306 \"fibroblast of tunica adventitia of artery\")\n26580:# Class: obo:CL_1000307 (fibroblast of dense regular elastic tissue)\n26582:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000307 \"A fibroblast that is part of the dense regular elastic tissue.\")\n26584:AnnotationAssertion(rdfs:label obo:CL_1000307 \"fibroblast of dense regular elastic tissue\")\n27284:# Class: obo:CL_1000394 (myoepithelial cell of intralobular lactiferous duct)\n27286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000394 \"A myoepithelial cell that is part of the intralobular part of terminal lactiferous duct.\")\n27288:AnnotationAssertion(rdfs:label obo:CL_1000394 \"myoepithelial cell of intralobular lactiferous duct\")\n27457:# Class: obo:CL_1000416 (obsolete myoepithelial cell of lactiferous gland)\n27459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000416 \"OBSOLETE. A myoepithelial cell that is part of the mammary gland.\")\n27461:AnnotationAssertion(rdfs:comment obo:CL_1000416 \"Term merged into CL:0002324 (myoepithelial cell of mammary gland)\")\n27462:AnnotationAssertion(rdfs:label obo:CL_1000416 \"obsolete myoepithelial cell of lactiferous gland\")\n27465:# Class: obo:CL_1000417 (myoepithelial cell of sweat gland)\n27467:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000417 \"A myoepithelial cell that is part of the sweat gland.\")\n27469:AnnotationAssertion(rdfs:label obo:CL_1000417 \"myoepithelial cell of sweat gland\")\n27473:# Class: obo:CL_1000418 (myoepithelial cell of lactiferous alveolus)\n27475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000418 \"A myoepithelial cell that is part of the mammary gland alveolus.\")\n27478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:67802\") oboInOwl:hasExactSynonym obo:CL_1000418 \"myoepithelial cell of mammary alveolus\")\n27479:AnnotationAssertion(rdfs:label obo:CL_1000418 \"myoepithelial cell of lactiferous alveolus\")\n27483:# Class: obo:CL_1000419 (myoepithelial cell of lactiferous duct)\n27485:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000419 \"A myoepithelial cell that is part of the lactiferous duct.\")\n27487:AnnotationAssertion(rdfs:label obo:CL_1000419 \"myoepithelial cell of lactiferous duct\")\n27491:# Class: obo:CL_1000420 (myoepithelial cell of terminal lactiferous duct)\n27493:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000420 \"A myoepithelial cell that is part of the terminal lactiferous duct.\")\n27495:AnnotationAssertion(rdfs:label obo:CL_1000420 \"myoepithelial cell of terminal lactiferous duct\")\n27678:# Class: obo:CL_1000445 (myoepithelial cell of dilator pupillae)\n27680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000445 \"A myoepithelial cell that is part of the dilatator pupillae.\")\n27682:AnnotationAssertion(rdfs:label obo:CL_1000445 \"myoepithelial cell of dilator pupillae\")\n27840:# Class: obo:CL_1000468 (myoepithelial cell of acinus of lactiferous gland)\n27842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000468 \"A myoepithelial cell that is part of the acinus of lactiferous gland.\")\n27845:AnnotationAssertion(rdfs:label obo:CL_1000468 \"myoepithelial cell of acinus of lactiferous gland\")\n27849:# Class: obo:CL_1000469 (myoepithelial cell of main lactiferous duct)\n27851:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000469 \"A myoepithelial cell that is part of the main lactiferous duct.\")\n27853:AnnotationAssertion(rdfs:label obo:CL_1000469 \"myoepithelial cell of main lactiferous duct\")\n27856:# Class: obo:CL_1000470 (myoepithelial cell of primary lactiferous duct)\n27858:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000470 \"A myoepithelial cell that is part of the primary lactiferous duct.\")\n27860:AnnotationAssertion(rdfs:label obo:CL_1000470 \"myoepithelial cell of primary lactiferous duct\")\n27863:# Class: obo:CL_1000471 (myoepithelial cell of secondary lactiferous duct)\n27865:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000471 \"A myoepithelial cell that is part of the secondary lactiferous duct.\")\n27867:AnnotationAssertion(rdfs:label obo:CL_1000471 \"myoepithelial cell of secondary lactiferous duct\")\n27870:# Class: obo:CL_1000472 (myoepithelial cell of tertiary lactiferous duct)\n27872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000472 \"A myoepithelial cell that is part of the tertiary lactiferous duct.\")\n27874:AnnotationAssertion(rdfs:label obo:CL_1000472 \"myoepithelial cell of tertiary lactiferous duct\")\n27877:# Class: obo:CL_1000473 (myoepithelial cell of quarternary lactiferous duct)\n27879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000473 \"A myoepithelial cell that is part of the quarternary lactiferous duct.\")\n27881:AnnotationAssertion(rdfs:label obo:CL_1000473 \"myoepithelial cell of quarternary lactiferous duct\")\n28239:# Class: obo:CL_1000691 (kidney interstitial myofibroblast)\n28242:AnnotationAssertion(rdfs:label obo:CL_1000691 \"kidney interstitial myofibroblast\")\n28246:# Class: obo:CL_1000692 (kidney interstitial fibroblast)\n28248:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_1000692 \"A fibroblast that is part of an interstitial compartment of a kidney.\")\n28250:AnnotationAssertion(rdfs:label obo:CL_1000692 \"kidney interstitial fibroblast\")\n28255:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23486523\") Annotation(oboInOwl:hasDbXref \"PMID:27262400\") Annotation(oboInOwl:hasDbXref \"PMID:35703942\") obo:IAO_0000115 obo:CL_1000693 \"A stromal cell that infiltrates and resides in the kidney interstitium following injury, characterized by the co-expression of CD45 with mesenchymal markers including α-SMA, and collagen I in humans (Kim et al., 2023). This cell originates from circulating monocyte-derived fibrocytes. It produces extracellular matrix components, contributing to renal fibrosis by potentially differentiating into myofibroblasts upon infiltration into injured kidneys (Sun et al., 2016). Migration into the kidney is dependent on chemokine receptor signaling, particularly CCR2 in mice (Reich et al., 2013).\")\n28886:# Class: obo:CL_1001225 (kidney collecting duct cell)\n28891:AnnotationAssertion(rdfs:label obo:CL_1001225 \"kidney collecting duct cell\")\n29360:# Class: obo:CL_1001596 (salivary gland glandular cell)\n29362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"HPA:HPA\") Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001596 \"Glandular cell of salivary gland. Example: Serous cells, mucous cells, cuboidal epithelial cells of the intercalated ducts, simple cuboidal epithelium of the striated ducts, epithelial cells of excretory ducts.\")\n29364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1282\") oboInOwl:hasRelatedSynonym obo:CL_1001596 \"salivary gland glandular cells\")\n29365:AnnotationAssertion(rdfs:label obo:CL_1001596 \"salivary gland glandular cell\")\n29444:# Class: obo:CL_1001608 (foreskin fibroblast)\n29448:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1001608 \"BJ fibroblast\")\n29449:AnnotationAssertion(rdfs:label obo:CL_1001608 \"foreskin fibroblast\")\n29452:# Class: obo:CL_1001609 (muscle fibroblast)\n29456:AnnotationAssertion(rdfs:label obo:CL_1001609 \"muscle fibroblast\")\n29595:# Class: obo:CL_2000012 (fibroblast of pedal digit skin)\n29597:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000012 \"Any skin fibroblast that is part of a pedal digit skin.\")\n29601:AnnotationAssertion(rdfs:label obo:CL_2000012 \"fibroblast of pedal digit skin\")\n29604:# Class: obo:CL_2000013 (fibroblast of skin of abdomen)\n29606:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000013 \"Any skin fibroblast that is part of a skin of abdomen.\")\n29610:AnnotationAssertion(rdfs:label obo:CL_2000013 \"fibroblast of skin of abdomen\")\n29613:# Class: obo:CL_2000014 (fibroblast of upper leg skin)\n29615:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000014 \"Any skin fibroblast that is part of a upper leg skin.\")\n29619:AnnotationAssertion(rdfs:label obo:CL_2000014 \"fibroblast of upper leg skin\")\n29622:# Class: obo:CL_2000015 (fibroblast of arm)\n29624:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000015 \"Any skin fibroblast that is part of a arm.\")\n29628:AnnotationAssertion(rdfs:label obo:CL_2000015 \"fibroblast of arm\")\n29641:# Class: obo:CL_2000017 (fibroblast of peridontal ligament)\n29643:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000017 \"Any fibroblast that is part of a periodontal ligament.\")\n29647:AnnotationAssertion(rdfs:label obo:CL_2000017 \"fibroblast of peridontal ligament\")\n29876:# Class: obo:CL_2000042 (embryonic fibroblast)\n29878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000042 \"Any fibroblast that is part of a embryo.\")\n29882:AnnotationAssertion(rdfs:label obo:CL_2000042 \"embryonic fibroblast\")\n29966:# Class: obo:CL_2000051 (splenic fibroblast)\n29968:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000051 \"Any fibroblast that is part of a spleen.\")\n29972:AnnotationAssertion(rdfs:label obo:CL_2000051 \"splenic fibroblast\")\n30088:# Class: obo:CL_2000063 (ovarian fibroblast)\n30090:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000063 \"Any fibroblast that is part of a female gonad.\")\n30095:AnnotationAssertion(rdfs:label obo:CL_2000063 \"ovarian fibroblast\")\n30117:# Class: obo:CL_2000066 (cardiac ventricle fibroblast)\n30119:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000066 \"Any fibroblast that is part of a cardiac ventricle.\")\n30124:AnnotationAssertion(rdfs:label obo:CL_2000066 \"cardiac ventricle fibroblast\")\n30127:# Class: obo:CL_2000067 (cardiac atrium fibroblast)\n30129:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000067 \"Any fibroblast that is part of a cardiac atrium.\")\n30134:AnnotationAssertion(rdfs:label obo:CL_2000067 \"cardiac atrium fibroblast\")\n30137:# Class: obo:CL_2000068 (pericardium fibroblast)\n30139:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000068 \"Any fibroblast that is part of a pericardium.\")\n30144:AnnotationAssertion(rdfs:label obo:CL_2000068 \"pericardium fibroblast\")\n30147:# Class: obo:CL_2000069 (gallbladder fibroblast)\n30149:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000069 \"Any fibroblast that is part of a gallbladder.\")\n30154:AnnotationAssertion(rdfs:label obo:CL_2000069 \"gallbladder fibroblast\")\n30157:# Class: obo:CL_2000070 (optic choroid fibroblast)\n30159:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000070 \"Any fibroblast that is part of a optic choroid.\")\n30164:AnnotationAssertion(rdfs:label obo:CL_2000070 \"optic choroid fibroblast\")\n30375:# Class: obo:CL_2000093 (bronchus fibroblast of lung)\n30377:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000093 \"Any fibroblast of lung that is part of a bronchus.\")\n30381:AnnotationAssertion(rdfs:label obo:CL_2000093 \"bronchus fibroblast of lung\")\n30402:# Class: obo:CL_2000096 (fibroblast of the reticular layer of dermis)\n30404:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:29266210\") Annotation(oboInOwl:hasDbXref \"PMID:35212000\") Annotation(oboInOwl:hasDbXref \"PMID:36232952\") Annotation(oboInOwl:hasDbXref \"PMID:37646029\") obo:IAO_0000115 obo:CL_2000096 \"A fibroblast of dermis that resides in the deep reticular layer, characterised by robust extracellular matrix production with high type I collagen deposition forming densely packed, organised fibrillar networks (Ghetti et al., 2018). This cell exhibits pro-fibrotic properties during wound healing, entering wounds early where it proliferates and deposits collagen to restore dermal architecture (Knoedler et al., 2023; McAndrews et al., 2022). It is distinguished from papillary dermal fibroblasts by expression of COL11A1, POSTN, and SPP1 in humans (Wu et al., 2022).\")\n30408:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29266210\") oboInOwl:hasRelatedSynonym obo:CL_2000096 \"reticular fibroblast\")\n30410:AnnotationAssertion(rdfs:label obo:CL_2000096 \"fibroblast of the reticular layer of dermis\")\n30476:# Class: obo:CL_4006000 (fibroblast of breast)\n30478:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006000 \"A fibroblast that is part of the breast.\")\n30480:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006000 \"breast fibroblast\")\n30481:AnnotationAssertion(rdfs:label obo:CL_4006000 \"fibroblast of breast\")\n30485:# Class: obo:CL_4006001 (fibroblast of skin of scalp)\n30487:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006001 \"A fibroblast that is part of the skin of scalp.\")\n30489:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006001 \"skin of scalp fibroblast\")\n30490:AnnotationAssertion(rdfs:label obo:CL_4006001 \"fibroblast of skin of scalp\")\n31088:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\n31117:# Class: obo:CL_4023054 (mesothelial fibroblast)\n31119:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_4023054 \"A mesothelial cell that has undergone mesothelial-to-mesenchymal transition (MMT) to become a fibroblast cell.\")\n31121:AnnotationAssertion(rdfs:label obo:CL_4023054 \"mesothelial fibroblast\")\n31141:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain.\")\n31159:# Class: obo:CL_4023058 (mesothelial fibroblast of the leptomeninx)\n31161:AnnotationAssertion(obo:IAO_0000115 obo:CL_4023058 \"A mesothelial fibroblast found in the leptomeninx.\")\n31163:AnnotationAssertion(rdfs:label obo:CL_4023058 \"mesothelial fibroblast of the leptomeninx\")\n31488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23298861\") obo:IAO_0000115 obo:CL_4023097 \"A mesothelial fibroblast of the arachnoid barrier layer. Arachnoid barrier cells make up the tight-junctioned layer in the leptomeninx that functions as the physiologic barrier between the cerebrospinal fluid in the subarachnoid space and the fenestrated capillaries in the dura.\")\n31992:# Class: obo:CL_4028004 (alveolar type 1 fibroblast cell)\n31994:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22268140\") Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29489752\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasDbXref \"PMID:33707239\") Annotation(oboInOwl:hasDbXref \"PMID:9074756\") obo:IAO_0000115 obo:CL_4028004 \"A pulmonary interstitial fibroblast that is part of the alveolus and contains lipid droplets.\")\n32000:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast\")\n32001:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast 1\")\n32003:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"lipofibroblast\")\n32004:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"matrix fibroblast 1\")\n32005:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"pulmonary lipofibroblast\")\n32007:AnnotationAssertion(rdfs:label obo:CL_4028004 \"alveolar type 1 fibroblast cell\")\n32011:# Class: obo:CL_4028006 (alveolar adventitial fibroblast)\n32013:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29752282\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4028006 \"A pulmonary interstitial fibroblast that is part of the alveolus and localizes to vascular adventitia.\")\n32016:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"adventitial fibroblast\")\n32017:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"alveolar fibroblast\")\n32018:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"matrix fibroblast 2\")\n32021:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028006 \"alveolar type 2 fibroblast cell\")\n32025:AnnotationAssertion(rdfs:label obo:CL_4028006 \"alveolar adventitial fibroblast\")\n32268:# Class: obo:CL_4030022 (renal medullary fibroblast)\n32270:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1101/2021.07.28.454201>) Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030022 \"A fibroblast that is located in the renal medulla interstitium.\")\n32272:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030022 \"kidney medullary fibroblast\")\n32273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") rdfs:comment obo:CL_4030022 \"It has been noted that inner medullary fibroblasts are involved in the regulation of water and electrolyte homeostasis.\")\n32274:AnnotationAssertion(rdfs:label obo:CL_4030022 \"renal medullary fibroblast\")\n32293:# Class: obo:CL_4030025 (renal cortical fibroblast)\n32295:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\n32297:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\n32298:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\n32299:AnnotationAssertion(rdfs:label obo:CL_4030025 \"renal cortical fibroblast\")\n32357:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\n32368:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030033 \"At least in some mammalian species, a valve endothelial cell expresses CD31. Valve endothelial cells can undergo an endothelial to mesenchymal transition to acquire a fibroblast or myofibroblast phenotype that leads to changes in the microenvironmental signals and facilitates tissue regeneration.\")\n32786:# Class: obo:CL_4033003 (myoepithelial cell of bronchus submucosal gland)\n32788:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19996346\") Annotation(oboInOwl:hasDbXref \"PMID:5487122\") obo:IAO_0000115 obo:CL_4033003 \"A(n) myoepithelial cell that is part of a(n) bronchus submucosal gland.\")\n32790:AnnotationAssertion(rdfs:label obo:CL_4033003 \"myoepithelial cell of bronchus submucosal gland\")\n32892:# Class: obo:CL_4033016 (secondary crest myofibroblast)\n32894:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\n32898:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasExactSynonym obo:CL_4033016 \"secondary-crest myofibroblast\")\n32901:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasRelatedSynonym obo:CL_4033016 \"alveolar myofibroblast\")\n32902:AnnotationAssertion(rdfs:label obo:CL_4033016 \"secondary crest myofibroblast\")\n32952:# Class: obo:CL_4033021 (myoepithelial cell of trachea gland)\n32954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29656943\") obo:IAO_0000115 obo:CL_4033021 \"A myoepithelial cell that is part of a submucosal gland of the trachea.\")\n32958:AnnotationAssertion(rdfs:label obo:CL_4033021 \"myoepithelial cell of trachea gland\")\n32991:# Class: obo:CL_4033025 (perichondrial fibroblast)\n32993:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Perichondrium\") obo:IAO_0000115 obo:CL_4033025 \"A fibroblast that is part of the fibrous layer of the perichondrium. This cell is responsible for collagen fiber production.\")\n32997:AnnotationAssertion(rdfs:label obo:CL_4033025 \"perichondrial fibroblast\")\n33000:# Class: obo:CL_4033026 (lung perichondrial fibroblast)\n33002:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") obo:IAO_0000115 obo:CL_4033026 \"A perichondrial fibroblast that is part of the lung.\")\n33007:AnnotationAssertion(rdfs:label obo:CL_4033026 \"lung perichondrial fibroblast\")\n33245:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25564622\") Annotation(oboInOwl:hasDbXref \"PMID:34044844\") Annotation(oboInOwl:hasDbXref \"PMID:35387001\") Annotation(oboInOwl:hasDbXref \"PMID:37834236\") obo:IAO_0000115 obo:CL_4033048 \"A respiratory epithelial cell derived from a basal cell, with a topographic nuclear position between the basal and luminal cells of the airway epithelium. This non-basal, intermediate progenitor cell has limited proliferative capacity and can differentiate into multiciliated, secretory, or rare airway cells (ionocytes, tuft cells, neuroendocrine cells). It shares some ultrastructural features with basal cells but lacks the defined characteristics of fully differentiated cellular phenotypes.\")\n33417:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033062 \"A trophoblast cell that invades the uterine wall to anchor the placenta to the uterus. An interstitial extravillous trophoblast cell differentiates from an extravillous trophoblast cell, becoming hyperchromatic and changing its morphology to a fibroblast-like spindle-shaped cell. In humans, this cell can be distinguished by the expression of placental-specific protein 8, which stimulates migration.\")\n34323:# Class: obo:CL_4047023 (intestinal lamina propria fibroblast)\n34325:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\n34328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") oboInOwl:hasRelatedSynonym obo:CL_4047023 \"S1 fibroblast\")\n34329:AnnotationAssertion(rdfs:label obo:CL_4047023 \"intestinal lamina propria fibroblast\"@en)\n34585:# Class: obo:CL_4052004 (intestinal fibroblastic reticular cell)\n34587:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\n34590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\n34591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\n34592:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\n34593:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\n34594:AnnotationAssertion(rdfs:label obo:CL_4052004 \"intestinal fibroblastic reticular cell\")\n34598:# Class: obo:CL_4052005 (intestinal subserosal fibroblast)\n34600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\n34603:AnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\n34621:# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\n34623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n34626:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\n34628:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\n34629:AnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\n34633:# Class: obo:CL_4052008 (crypt-bottom fibroblast)\n34635:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\n34639:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\n34640:AnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\n34645:# Class: obo:CL_4052009 (crypt-top fibroblast)\n34647:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\n34651:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\n34652:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\n34653:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\n34654:AnnotationAssertion(rdfs:label obo:CL_4052009 \"crypt-top fibroblast\")\n34699:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n34870:# Class: obo:CL_4052029 (subpleural fibroblast)\n34872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\n34875:AnnotationAssertion(rdfs:label obo:CL_4052029 \"subpleural fibroblast\")\n34879:# Class: obo:CL_4052030 (adventitial fibroblast)\n34881:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\n34884:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\n34885:AnnotationAssertion(rdfs:label obo:CL_4052030 \"adventitial fibroblast\")\n34914:# Class: obo:CL_4052033 (biliary tuft cell)\n34916:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") Annotation(oboInOwl:hasDbXref \"PMID:37863104\") obo:IAO_0000115 obo:CL_4052033 \"A tuft cell that is part of the extrahepatic biliary tree, including the gallbladder and extrahepatic bile ducts. It shares a core genetic program with intestinal tuft cells but has unique tissue-specific genes. Biliary tuft cell functions as a bile acid-sensitive regulator, suppressing inflammation and modulating microbiome-dependent neutrophil infiltration in biliary tissues. Unlike its intestinal counterparts, this cell decreases in number postnatally as bile acid production matures, with its abundance negatively regulated by bile acids.\")\n34919:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35245089\") oboInOwl:hasExactSynonym obo:CL_4052033 \"gallbladder/extrahepatic bile duct tuft cell\")\n34920:AnnotationAssertion(rdfs:label obo:CL_4052033 \"biliary tuft cell\")\n34924:# Class: obo:CL_4052034 (tuft cell of thymus)\n34926:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30022164\") Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:35668088\") Annotation(oboInOwl:hasDbXref \"PMID:36351364\") Annotation(oboInOwl:hasDbXref \"PMID:36961668\") obo:IAO_0000115 obo:CL_4052034 \"A tuft cell that is part of the medullary epithelium of the thymus, characterized by lateral microvilli and specific markers, including L1CAM in both mice (Zhang et al., 2022) and humans (Sun et al., 2023), as well as MHC II in mice (Miller et al., 2018). This cell is pivotal in immune functions such as antigen presentation, central tolerance, and type 2 immunity. A tuft cell in the thymus exhibits characteristics of both a medullary thymic epithelial cell (mTEC) and a peripheral tuft cell. Its development is governed by transcription factors such as POU2F3.\")\n34929:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") oboInOwl:hasExactSynonym obo:CL_4052034 \"thymic tuft cell\")\n34930:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") rdfs:comment obo:CL_4052034 \"A thymic tuft cell is a subset of terminally differentiated medullary thymic epithelial cell comprising 5-10% of total mTECs. Lineage-tracing studies indicate that this cell arises from mature MHCII mTECs, with development occurring through both Aire-dependent and Aire-independent pathways. However, its exact origins remain unclear.\")\n34931:AnnotationAssertion(rdfs:label obo:CL_4052034 \"tuft cell of thymus\")\n34936:# Class: obo:CL_4052035 (tuft cell of pancreatic duct)\n34938:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30904566\") Annotation(oboInOwl:hasDbXref \"PMID:32717220\") obo:IAO_0000115 obo:CL_4052035 \"A tuft cell that is part of the epithelium of pancreatic duct. Present in humans and rats, this cell is absent in the murine pancreas under normal conditions but emerges during acinar-to-ductal metaplasia triggered by injury, inflammation, or oncogenic mutations. It modulates the immune response and protects against pancreatic ductal adenocarcinoma progression by producing suppressive eicosanoids, such as prostaglandin D2. A tuft cell in the pancreatic duct highly expresses the transcription factor POU2F3, which is essential for its development and presence.\")\n34942:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32717220\") oboInOwl:hasExactSynonym obo:CL_4052035 \"pancreatic tuft cell\")\n34943:AnnotationAssertion(rdfs:label obo:CL_4052035 \"tuft cell of pancreatic duct\")\n34946:# Class: obo:CL_4052036 (tuft cell of nasal cavity)\n34948:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052036 \"A tuft cell that is part of the nasal cavity epithelium, located in both the respiratory and olfactory epithelia of the nose. This cell plays key roles in chemosensation, lipid mediator production, immune responses, and epithelial homeostasis.\")\n34952:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052036 \"nasal tuft cell\")\n34953:AnnotationAssertion(rdfs:label obo:CL_4052036 \"tuft cell of nasal cavity\")\n34956:# Class: obo:CL_4052037 (tuft cell of olfactory epithelium)\n34958:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") obo:IAO_0000115 obo:CL_4052037 \"A tuft cell that is part of the olfactory epithelium, characterized by a globular body and the expression of neurogranin (Nrgn) in mice. This cell plays a crucial role in allergen recognition and regulating olfactory stem cell proliferation via TRPM5-dependent ATP sensing and cysteinyl leukotriene production. Unlike nasal respiratory tuft cells, it has low to absent expression of taste receptors, including the G protein Gα gustducin, and rarely contacts olfactory sensory neurons directly.\")\n34961:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasExactSynonym obo:CL_4052037 \"olfactory tuft cell\")\n34964:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.09.26.509561\") oboInOwl:hasRelatedSynonym obo:CL_4052037 \"TRPM5+ microvillous tuft cell\")\n34966:AnnotationAssertion(rdfs:label obo:CL_4052037 \"tuft cell of olfactory epithelium\")\n34970:# Class: obo:CL_4052038 (tuft cell of nasal cavity respiratory epithelium)\n34972:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:34932383\") Annotation(oboInOwl:hasDbXref \"PMID:38306414\") obo:IAO_0000115 obo:CL_4052038 \"A tuft cell that is part of the nasal cavity respiratory epithelium. Acting as a chemosensor, it detects bitter taste ligands and bacterial signals via taste receptors, maintaining epithelial-microbial homeostasis by stimulating antimicrobial peptide secretion from adjacent epithelial cells. This cell is a major source of IL-25, promoting type 2 immune responses and potentially contributing to chronic rhinosinusitis (O'Leary et al., 2019).\")\n34975:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38306414\") oboInOwl:hasRelatedSynonym obo:CL_4052038 \"Gɑ-gustducin high respiratory tuft cell\")\n34978:AnnotationAssertion(rdfs:label obo:CL_4052038 \"tuft cell of nasal cavity respiratory epithelium\")\n34981:# Class: obo:CL_4052039 (tuft cell of submandibular gland)\n34983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\n34986:AnnotationAssertion(rdfs:label obo:CL_4052039 \"tuft cell of submandibular gland\")\n34989:# Class: obo:CL_4052040 (tuft cell of stomach)\n34991:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22527717\") Annotation(oboInOwl:hasDbXref \"PMID:38117182\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2022.02.16.480779\") obo:IAO_0000115 obo:CL_4052040 \"A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.\")\n34994:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38117182\") oboInOwl:hasExactSynonym obo:CL_4052040 \"gastric tuft cell\")\n34995:AnnotationAssertion(rdfs:label obo:CL_4052040 \"tuft cell of stomach\")\n34998:# Class: obo:CL_4052041 (tuft cell of auditory tube)\n35000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:32733896\") obo:IAO_0000115 obo:CL_4052041 \"A tuft cell that is part of the epithelium of the pharyngotympanic (auditory) tube. This chemosensory cell is often positioned near cholinoreceptive sensory nerve fibers, suggesting a role in neuroimmune communication. It detects chemical signals and releases neuropeptides, such as acetylcholine (ACh) and CGRP, which contribute to inflammatory responses that help protect deeper tissues from harmful substances.\")\n35003:AnnotationAssertion(rdfs:label obo:CL_4052041 \"tuft cell of auditory tube\")\n35007:# Class: obo:CL_4052042 (tuft cell of urethra)\n35009:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36993541\") Annotation(oboInOwl:hasDbXref \"PMID:38548667\") obo:IAO_0000115 obo:CL_4052042 \"A tuft cell that is part of the epithelium of the urethra. This cell monitors urethral contents by detecting chemical stimuli, such as bitter compounds and sugars. Upon activation, it stimulates sensory nerve fibres and triggers detrusor muscle contraction, likely aiding in pathogen clearance by promoting bladder emptying.\")\n35014:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38548667\") oboInOwl:hasExactSynonym obo:CL_4052042 \"urethral tuft cell\")\n35015:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27680547\") rdfs:comment obo:CL_4052042 \"Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.\")\n35016:AnnotationAssertion(rdfs:label obo:CL_4052042 \"tuft cell of urethra\")\n35051:# Class: obo:CL_4052048 (intercalated cell of salivary gland)\n35053:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n35057:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasBroadSynonym obo:CL_4052048 \"intercalated duct cell\")\n35058:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\n35060:AnnotationAssertion(rdfs:label obo:CL_4052048 \"intercalated cell of salivary gland\")\n35065:# Class: obo:CL_4052049 (striated cell of salivary gland)\n35067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n35072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\n35073:AnnotationAssertion(rdfs:label obo:CL_4052049 \"striated cell of salivary gland\")\n35167:# Class: obo:CL_4052062 (onychofibroblast)\n35169:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\n35172:AnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n35194:# Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n35196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n35199:AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n35204:# Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n35206:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n35209:AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n35214:# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n35216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n35219:AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n35223:# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n35225:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n35228:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n35229:AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n35246:# Class: obo:CL_4052071 (quiescent fibroblast)\n35248:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21049082\") Annotation(oboInOwl:hasDbXref \"PMID:35701396\") Annotation(oboInOwl:hasDbXref \"PMID:40538750\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Fibroblast\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41427-020-0226-7\") obo:IAO_0000115 obo:CL_4052071 \"A fibroblast in a quiescent state, characterized by a smaller, spindle-shaped morphology with a relatively small cytoplasm, modest rough endoplasmic reticulum and condensed chromatin. Despite low proliferation and contractility, it maintains high metabolic activity for extracellular-matrix homeostasis through continuous matrix protein turnover and mechanosensitive signaling. This cell can rapidly differentiate into contractile myofibroblasts under injury or inflammatory cues to drive tissue repair.\")\n35251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22529592\") oboInOwl:hasExactSynonym obo:CL_4052071 \"inactive fibroblast\")\n35252:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID: 35701396\") rdfs:comment obo:CL_4052071 \"Historically, quiescent fibroblasts in uninjured tissues were often called “fibrocytes”, but this distinction faded over time, and the term “fibroblast” came to be used universally, regardless of activation state. Fibrocyte has been repurposed to describe a distinct population of bone marrow–derived, circulating cells that home to sites of injury and contribute to tissue repair and fibrosis.\")\n35253:AnnotationAssertion(rdfs:label obo:CL_4052071 \"quiescent fibroblast\")\n35868:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35883:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\n","exit_code":0,"status":"completed"}}
