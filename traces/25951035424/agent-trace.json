{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"rg -n 'NCBITaxon_10090|RO_0002162 obo:NCBITaxon|only in taxon|mouse' src/ontology/cl-edit.owl\"","aggregated_output":"3342:Declaration(Class(obo:NCBITaxon_10090))\n3757:SubClassOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_131567))\n3977:SubClassOf(obo:CL_0000023 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33208))\n4052:SubClassOf(obo:CL_0000031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n4728:AnnotationAssertion(rdfs:comment obo:CL_0000096 \"Neutrophils are also capable of secreting GRO-alpha, IL-1beta, IL-1ra, IL-3, IL-12, IP-10, MIG, MIP-1alpha, MIP-1beta, TGF-beta, TNF-alpha, VEGF, and anti-microbial peptides. They can positively influence the chemotaxis of basophils, T-cells, monocytes, macrophages, dendritic cells, and other neutrophils. Neutrophils are also CD35-positive, CD64-positive, CD89-positive, CD184-positive, and fMLP receptor-positive Ly-6G-positive (mouse), TLR2-low, TLR4-low, and lineage-negative (CD2, CD3, CD5, CD9, CD19, CD36, CD49d, CD56, CD61, CD235a (glycophorin-A)).\")\n4743:AnnotationAssertion(rdfs:comment obo:CL_0000097 \"Mast cells are generally integrin beta-7-negative and positive for TLR2, TLR3, TLR4, TLR5, TLR7, TLR9, C3aR, C5aR, CR3, CR4, VEGF, FGF2, and renin. They can express MHC Class I and II on their surface. Activated murine mast cells (IgE+Antigen) were capable of expressing the following co-stimulatory molecules: CD95 (Fas), CD120b, CD137 (4-1BB), CD153 (CD30L), CD154 (CD40L), GITR, ICOSL, OX40L, PD-L1, and PD-L2. Note that there was some mouse strain variation. Mast cells have also been demonstrated to produce bFGF, CCL2, CCL4, CCL5, CCL11, CCL20, CXCL2, CXCL8, CXCL10, GM-CSF, IFN-gamma, IL-1, IL-2, IL-3, IL-8, IL-10, IL-11, IL-12, IL-13, IL-16, IL-25, IL-18, MIP-1, prostaglandin D2, SCF, TGF-beta, TNF-alpha, TSLP, VEGF, and XCL1. They express the transcription factors Transcription factors AP-1, GATA1, MITF, Notch2, PIAS3, PU.1, and STAT5.\")\n4990:SubClassOf(obo:CL_0000123 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n5061:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23616747\") rdfs:comment obo:CL_0000129 \"Unlike macroglial cells, microglial cells  arise from hematopoietic stem cells in the yolk sac during early embryogenesis that populate the central nervous system. They derive from embryonic mesoderm and are not from neuroectoderm where glioblast develops from. Markers: Mouse: CD11b+, F4/80+, CD68+. They represent ~12% of the cells in the CNS, but they are not uniformly distributed within the CNS. A normal adult mouse brain has approximately 3.5x10e6 microglia. Microglia are also reportedly CD3-negative, CD4-positive, CD8-negative, CD11b-positive, CD11c-high, CD14-negative, CD19-negative, CD45-low, CD56-negative, CD163-negative, CD200R-positive, CD281-positive, CD282-positive, CD283-positive, CD284-positive, CD285-positive, CD286-positive, CD287-positive, CD288-positive, CD289-positive, Gr1-negative, nestin-positive, and PU.1-positive.\")\n5072:SubClassOf(obo:CL_0000130 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33317))\n6208:EquivalentClasses(obo:CL_0000255 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_2759)))\n6219:EquivalentClasses(obo:CL_0000257 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_142796)))\n6795:SubClassOf(obo:CL_0000338 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33317))\n6805:SubClassOf(obo:CL_0000339 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n6825:SubClassOf(obo:CL_0000342 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n7000:EquivalentClasses(obo:CL_0000365 ObjectIntersectionOf(obo:CL_0010017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33208)))\n7061:SubClassOf(obo:CL_0000373 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7154:SubClassOf(obo:CL_0000387 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7323:SubClassOf(obo:CL_0000411 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6237))\n7371:SubClassOf(obo:CL_0000418 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6237))\n7448:SubClassOf(obo:CL_0000429 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7543:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/issues/1943\") obo:CL_0000441 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7720:SubClassOf(obo:CL_0000462 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7728:SubClassOf(obo:CL_0000463 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7744:SubClassOf(obo:CL_0000465 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n7770:SubClassOf(obo:CL_0000468 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33317))\n7840:SubClassOf(Annotation(oboInOwl:source <https://github.com/obophenotype/cell-ontology/issues/589>) obo:CL_0000477 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n7885:AnnotationAssertion(rdfs:comment obo:CL_0000484 \"They are CD88-positive. The cytoplasmic granules contain high levels of histamine and heparin (mouse) or major neutral proteases, tryptase, chymase, carboxypeptidase A, and cathepsin G (humans). Reportedly, they cannot produce leukotrienes (LTC4) and IL-4. They are reportedly very heterogeneous depending upon location and can convert to the MC(T) phenotype.\")\n7896:AnnotationAssertion(rdfs:comment obo:CL_0000485 \"They are CD88-negative. The cytoplasmic granules contain low levels of histamine and high levels of chondroitin sulfate (mouse) or major neutral proteases and tryptase (humans). Additionally, they can produce leukotrienes (LTC4), IL-5, IL-6, and low levels of IL-4. They are reportedly very heterogeneous depending upon location and can convert to the MC(T) phenotype.\")\n7917:SubClassOf(obo:CL_0000487 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n8166:SubClassOf(obo:CL_0000518 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n8185:EquivalentClasses(obo:CL_0000521 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4751)))\n8255:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/pull/1950\") obo:CL_0000530 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n8292:SubClassOf(Annotation(obo:IAO_0000233 \"https://github.com/obophenotype/cell-ontology/pull/1950\") obo:CL_0000535 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n8600:SubClassOf(obo:CL_0000561 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n8735:AnnotationAssertion(rdfs:comment obo:CL_0000576 \"Morphology: Mononuclear cell, diameter, 14 to 20 _M, N/C ratio 2:1-1:1. Nucleus may appear in variety of shapes: round, kidney, lobulated, or convoluted. Fine azurophilic granules present; markers: CD11b (shared with other myeloid cells), human: CD14, mouse: F4/80-mid,GR1-low; location: Blood, but can be recruited into tissues; role or process: immune & tissue remodelling; lineage: hematopoietic, myeloid.\")\n10031:SubClassOf(obo:CL_0000722 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6656))\n10154:SubClassOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n10728:AnnotationAssertion(rdfs:comment obo:CL_0000792 \"This cell type is compatible with the HIPC Lyoplate markers for 'Treg'.  The inclusion of CD127lo in the logical definition is compatible with both human and mouse T cells of this subtype.\")\n10915:AnnotationAssertion(rdfs:comment obo:CL_0000806 \"Note that this type of thymocyte is at the earliest stage of T cell receptor rearrangement of the beta, gamma, and delta T cell receptor chains. Also, there is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in mouse versus human thymus. If in doubt, please consider using CL:0002489 'double negative thymocyte'.\")\n10933:AnnotationAssertion(rdfs:comment obo:CL_0000807 \"There is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in mouse versus human thymus. If in doubt, please consider using CL:0002489 'double negative thymocyte'.\")\n10949:AnnotationAssertion(rdfs:comment obo:CL_0000808 \"Note that this type of thymocyte has passed the beta-selection checkpoint and is rapidly proliferating and beginning to rearrange the T cell receptor alpha chain. There is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in mouse versus human thymus. If in doubt, please consider using CL:0002489 'double negative thymocyte'.\")\n11157:AnnotationAssertion(rdfs:comment obo:CL_0000823 \"In mouse the NKR are Ly49 molecules and in human these cells express KIR molecules.\")\n11313:AnnotationAssertion(rdfs:comment obo:CL_0000837 \"Markers differ between mouse and human.\")\n11542:AnnotationAssertion(rdfs:comment obo:CL_0000860 \"Markers: CCR2+CXCCR1<low> (human, mouse, rat).\")\n11674:AnnotationAssertion(rdfs:comment obo:CL_0000875 \"Markers: CCR2-CX3CCR1+ (human, mouse, rat); human: CD16+, CCR5+, CD32/FcgRII-high, MHCII+, CD86+; mouse: CD62L-Ly6C-.\")\n12224:AnnotationAssertion(rdfs:comment obo:CL_0000921 \"In mouse the canonical TCR is V-alpha-14, and in humans it is V-alpha 24.\")\n12405:AnnotationAssertion(rdfs:comment obo:CL_0000936 \"Markers are associated with mouse cells. ELP transcription factors include E2A-positive, Ikaros-positive, EBF-negative, Pax5-negative, PU.1-negative.\")\n12428:EquivalentClasses(obo:CL_0000938 ObjectIntersectionOf(obo:CL_0000824 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001483) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001319) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032609) ObjectSomeValuesFrom(obo:RO_0015015 obo:PR_000001024)))\n12443:EquivalentClasses(obo:CL_0000939 ObjectIntersectionOf(obo:CL_0000824 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001483) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001816) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042267) ObjectSomeValuesFrom(obo:RO_0015016 obo:PR_000001024)))\n12464:AnnotationAssertion(rdfs:comment obo:CL_0000941 \"In the mouse this cell expresses CD8-alpha-alpha.\")\n12595:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"PMID:20839338\") Annotation(oboInOwl:hasDbXref \"PMID:9785673\") obo:IAO_0000115 obo:CL_0000956 \"A pre-B-I cell is a precursor B cell that expresses CD34 and surrogate immunoglobulin light chain (VpreB , Lambda 5 (mouse)/14.1 (human)) on the cell surface, and TdT, Rag1,and Rag2 intracellularly. Cell type carries a D-JH DNA rearrangement, and lacks expression of immunglobulin heavy chain protein.\")\n12660:EquivalentClasses(obo:CL_0000961 ObjectIntersectionOf(obo:CL_0000843 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001408) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001880) ObjectSomeValuesFrom(obo:RO_0002104 obo:GO_0071738) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n12672:EquivalentClasses(obo:CL_0000962 ObjectIntersectionOf(obo:CL_0000843 ObjectSomeValuesFrom(obo:RO_0002104 obo:GO_0071738) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001880) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n12697:EquivalentClasses(obo:CL_0000964 ObjectIntersectionOf(obo:CL_0000844 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001880) ObjectSomeValuesFrom(obo:RO_0002104 obo:GO_0071738) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002634)))\n12710:EquivalentClasses(obo:CL_0000965 ObjectIntersectionOf(obo:CL_0000844 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000003516) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0016446)))\n12723:EquivalentClasses(obo:CL_0000966 ObjectIntersectionOf(obo:CL_0000844 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000003516) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0016446)))\n12735:EquivalentClasses(obo:CL_0000967 ObjectIntersectionOf(obo:CL_0000787 ObjectSomeValuesFrom(obo:CL_4030046 obo:GO_0071738) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606) ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0002314) ObjectSomeValuesFrom(obo:RO_0002353 obo:GO_0016446)))\n12961:SubClassOf(obo:CL_0000989 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n12986:SubClassOf(obo:CL_0000991 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n13046:AnnotationAssertion(rdfs:comment obo:CL_0000998 \"These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000011)(PMID:19243617).\")\n13056:AnnotationAssertion(rdfs:comment obo:CL_0000999 \"Defined as having a disposition to secreting anti-inflammatory cytokines. These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000012)(PMID:19243617).\")\n13075:AnnotationAssertion(rdfs:comment obo:CL_0001001 \"These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000014)(PMID:19243617).\")\n13084:AnnotationAssertion(rdfs:comment obo:CL_0001002 \"These markers are associated with mouse cells. Defined as having a disposition to secretion of anti-inflammatory cytokines. Originally described in the dendritic cell ontology (DC_CL:0000015)(PMID:19243617).\")\n13139:AnnotationAssertion(rdfs:comment obo:CL_0001008 \"Cell markers are associated with mouse hematopoietic stem cell. Originally described in the dendritic cell ontology (DC_CL:0000043)(PMID:19243617).\")\n13200:AnnotationAssertion(rdfs:comment obo:CL_0001015 \"These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000027)(PMID:19243617). They are also CD205-high, CD281-positive (TLR1), CD282-positive (TLR2), CD283-positive (TLR3), CD285-positive (TLR5), CD286-positive (TLR6), and CD289-positive (TLR9).\")\n13225:AnnotationAssertion(rdfs:comment obo:CL_0001018 \"These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000030)(PMID:19243617).\")\n13241:AnnotationAssertion(rdfs:comment obo:CL_0001020 \"These markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000031)(PMID:19243617).\")\n13273:AnnotationAssertion(rdfs:comment obo:CL_0001023 \"Markers are associated with mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000034)(PMID:19243617).\")\n13296:AnnotationAssertion(rdfs:comment obo:CL_0001025 \"Markers are associated with mouse cells.\")\n13338:AnnotationAssertion(rdfs:comment obo:CL_0001029 \"Surface markers are for mouse cells. Originally described in the dendritic cell ontology (DC_CL:0000041) CDP are reportedly CD2-negative, CD3-negative, CD4-negative, CD5-negative, CD8a-negative, CD11c-positive, CD14-negative, CD19-negative, CD20-negative, CD56-negative, B220-negative, Ly6g-negative, MHCII-positive, and Ter119-negative. (PMID:19243617).\")\n13451:AnnotationAssertion(rdfs:comment obo:CL_0001043 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD4+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD4+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13453:EquivalentClasses(obo:CL_0001043 ObjectIntersectionOf(obo:CL_0000896 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13475:AnnotationAssertion(rdfs:comment obo:CL_0001045 \"This cell type is compatible with the HIPC Lyoplate markers for 'naive CCR4+ Treg'.  The definition is valid for human; its applicability for mouse and other species is unknown.\")\n13487:AnnotationAssertion(rdfs:comment obo:CL_0001046 \"This cell type is compatible with the HIPC Lyoplate markers for 'memory CCR4+ Treg'.  The definition is valid for human; its applicability for mouse and other species is unknown.\")\n13489:EquivalentClasses(obo:CL_0001046 ObjectIntersectionOf(obo:CL_0002678 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001017) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001200) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13499:AnnotationAssertion(rdfs:comment obo:CL_0001047 \"This cell type is compatible with the HIPC Lyoplate markers for 'CCR4+ Treg'.  The definition is valid for human; its applicability for mouse and other species is unknown.\")\n13511:AnnotationAssertion(rdfs:comment obo:CL_0001048 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CCR4+ Treg'.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD4+ T cells, as activated mouse T cells do not express MHC class II.\")\n13513:EquivalentClasses(obo:CL_0001048 ObjectIntersectionOf(obo:CL_0001047 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13523:AnnotationAssertion(rdfs:comment obo:CL_0001049 \"This cell type is compatible with the HIPC Lyoplate markers for 'activated CD8+ T cell', but includes via logical inference from its parent additional markers known to be expressed on activated CD8+ T cells.  The inclusion of HLA-DRA in the definition restricts this definition to human activated CD8+ T cells, as activated mouse T cells do not express MHC class II.\")\n13525:EquivalentClasses(obo:CL_0001049 ObjectIntersectionOf(obo:CL_0000906 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001408) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13577:AnnotationAssertion(rdfs:comment obo:CL_0001054 \"This cell type is compatible with the HIPC Lyoplate markers for 'monocyte'. Note that while CD14 is considered a reliable marker for human monocytes, it is only expressed on approximately 85% of mouse monocytes.\")\n13597:EquivalentClasses(obo:CL_0001056 ObjectIntersectionOf(obo:CL_0000451 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13606:EquivalentClasses(obo:CL_0001057 ObjectIntersectionOf(obo:CL_0000782 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13615:EquivalentClasses(obo:CL_0001058 ObjectIntersectionOf(obo:CL_0000784 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001013) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001865) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000002015) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n13662:AnnotationAssertion(rdfs:comment obo:CL_0001062 \"This cell type is seen in human but not found in the mouse.\")\n13664:EquivalentClasses(obo:CL_0001062 ObjectIntersectionOf(obo:CL_0000909 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001017) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_000001203) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_0000010