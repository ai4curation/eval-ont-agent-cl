o:NCBITaxon_4896))\n20994:SubClassOf(obo:CL_0002675 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_4896))\n21075:SubClassOf(obo:CL_0003002 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21088:SubClassOf(obo:CL_0003003 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21102:SubClassOf(obo:CL_0003004 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21118:SubClassOf(obo:CL_0003005 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21157:SubClassOf(obo:CL_0003008 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21170:SubClassOf(obo:CL_0003009 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21185:SubClassOf(obo:CL_0003010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21199:SubClassOf(obo:CL_0003011 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21212:SubClassOf(obo:CL_0003012 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21227:SubClassOf(obo:CL_0003013 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21241:SubClassOf(obo:CL_0003014 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9986))\n21363:SubClassOf(obo:CL_0003026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21379:SubClassOf(obo:CL_0003027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21393:SubClassOf(obo:CL_0003028 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21406:SubClassOf(obo:CL_0003029 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21420:SubClassOf(obo:CL_0003030 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21456:SubClassOf(obo:CL_0003033 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21469:SubClassOf(obo:CL_0003034 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21482:SubClassOf(obo:CL_0003035 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21495:SubClassOf(obo:CL_0003036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21531:SubClassOf(obo:CL_0003039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21543:SubClassOf(obo:CL_0003040 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21579:SubClassOf(obo:CL_0003043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21591:SubClassOf(obo:CL_0003044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21605:SubClassOf(obo:CL_0003045 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21619:SubClassOf(obo:CL_0003046 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21633:SubClassOf(obo:CL_0003047 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21714:SubClassOf(obo:CL_0004115 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21726:SubClassOf(obo:CL_0004116 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n21741:SubClassOf(obo:CL_0004117 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n23047:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41593-018-0205-2\") rdfs:comment obo:CL_0008032 \"A rosehip cell has been shown to have an immunohistochemical profile GAD1+CCK+, CNR1–SST–CALB2–PVALB– that matches a single transcriptomically defined cell type whose specific molecular marker signature is not seen in mouse cortex.\")\n23051:SubClassOf(obo:CL_0008032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n23126:SubClassOf(obo:CL_0008039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742))\n23203:SubClassOf(obo:CL_0008048 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_33208))\n23296:SubClassOf(obo:CL_0009003 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_50557))\n23409:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31350390\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0002-3163-0115\") obo:IAO_0000115 obo:CL_0009013 \"A progenitor cell with hepatic and biliary lineage potential, identified in mouse and human, and anatomically restricted to the ductal plate of fetal liver.\")\n23417:SubClassOf(obo:CL_0009013 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_40674))\n23973:SubClassOf(obo:CL_0009067 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_40674))\n24111:AnnotationAssertion(rdfs:comment obo:CL_0009081 \"There is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in human versus mouse thymus. This term is restricted for use with human data.\")\n24114:SubClassOf(obo:CL_0009081 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n24121:AnnotationAssertion(rdfs:comment obo:CL_0009082 \"There is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in human versus mouse thymus. This term is restricted for use with human data.\")\n24124:SubClassOf(obo:CL_0009082 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n24131:AnnotationAssertion(rdfs:comment obo:CL_0009083 \"There is growing evidence that molecular markers characterizing double negative thymocytes are different across species, especially in human versus mouse thymus. This term is restricted for use with human data.\")\n24134:SubClassOf(obo:CL_0009083 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n24356:AnnotationAssertion(rdfs:comment obo:CL_0009104 \"B cell zone reticular cells share similarities with Ch25h-expresssing Ccl19lo T reticular cells found at the B cell follicle T zone interface of mouse lymph nodes.\")\n24489:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19063729\") Annotation(oboInOwl:hasDbXref \"PMID:20346151\") Annotation(oboInOwl:hasDbXref \"PMID:21930782\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4412-7970\") obo:IAO_0000115 obo:CL_0009116 \"A progenitor cell with the potential to differentiate into luminal epithelial cells of mammary glands. In mouse, CD61 and c-kit were found to be coexpressed by the majority of, but not all, committed luminal progenitor cells.\")\n24898:SubClassOf(obo:CL_0011029 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6073))\n25162:SubClassOf(obo:CL_0017009 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n25303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27548519\") obo:IAO_0000115 obo:CL_0019015 \"An eosinophil with a ring-shaped nucleus that is resident in the lung parenchyma. In mouse, lung parenchyma resident eosinophils are IL-5-independent Siglec-F(intermediate) CD62L+ CD101(low). In human, they are Siglec-8+ CD62L+ IL-3R(low).\")\n25447:EquivalentClasses(obo:CL_0020002 ObjectIntersectionOf(obo:CL_0000940 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_Q12918) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_A0A0B4J238) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n25688:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020024 \"A mouse retinal ganglion cell type defined by a large soma and a wide, monostratified dendritic arbor that stratifies just distal to the outer ChAT band of the inner plexiform layer (Krieger et al., 2017). It corresponds to the G5 physiological type (Baden et al., 2016; Goetz et al., 2022) and the C42 transcriptomic cluster (Tran et al., 2019), and is considered the evolutionary ortholog of the primate OFF midget RGC (Hahn et al., 2023). The cell projects a thick, fast-conducting axon to the dorsal lateral geniculate nucleus and superior colliculus. It shows a sustained increase in firing to light decrements with a slow decay time constant of roughly 250 ms and a large receptive field center with weak surround antagonism (Krieger et al., 2017). Its molecular profile includes expression of Spp1 and Neurofilament (Smi32) together with Brn3a (Pou4f1) and Brn3b (Pou4f2), absence of Brn3c (Pou4f3) and Calbindin (Calb1), and strong enrichment of Fes (Krieger et al., 2017; Tran et al., 2019).\")\n25689:AnnotationAssertion(obo:RO_0002175 obo:CL_0020024 obo:NCBITaxon_10090)\n25695:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020024 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25699:SubClassOf(obo:CL_0020024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n25703:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:38092908\") obo:IAO_0000115 obo:CL_0020025 \"A retinal ganglion cell type that has a large soma and a wide, monostratified dendritic arbor that stratifies in the inner sublamina of the inner plexiform layer, with dendrites located just proximal to the inner ChAT band (Krieger et al., 2017). It shows a sustained increase in firing rate to ON stimuli (Krieger et al., 2017). It corresponds to the G24 functional type (Baden et al., 2016; Goetz et al., 2022), the C43 transcriptomic cluster (Tran et al., 2019), and is considered the mouse ortholog of the primate ON midget retinal ganglion cell (Hahn et al., 2023). It is molecularly defined by expression of Spp1, Smi32, Brn3b, Calbindin, and Tbr2 (Krieger et al., 2017; Tran et al., 2019).\")\n25704:AnnotationAssertion(obo:RO_0002175 obo:CL_0020025 obo:NCBITaxon_10090)\n25710:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020025 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25714:SubClassOf(obo:CL_0020025 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n25718:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020026 \"An alpha retinal ganglion cell subtype found in the mouse retina that responds selectively and transiently to decreases in light intensity. It is characterized by a large soma, a broad dendritic arbor that stratifies within sublamina a of the inner plexiform layer, and rapid OFF-transient firing kinetics that decay even during sustained stimulation (Krieger et al., 2017). Functionally, it corresponds to G8 in the Baden functional classification (Baden et al., 2016; Goetz et al., 2022) and C45 in the Tran transcriptomic atlas (Tran et al., 2019), and it is considered the evolutionary ortholog of the primate OFF Parasol RGC (Hahn et al., 2023). This cell type acts as a detector of rapidly approaching dark objects and contributes to innate defensive responses by encoding looming stimuli (Münch et al., 2009). It exhibits a distinctive molecular signature by its expression of Brn3c (Krieger et al., 2017).\")\n25724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020026 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25728:SubClassOf(obo:CL_0020026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n25732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020027 \"An alpha retinal ganglion cell subtype in the mouse retina that responds selectively and transiently to increases in light intensity. It possesses the large soma and expansive dendritic field characteristic of alpha RGCs (Krieger et al., 2017). This cell exhibits a brief, fast-decaying burst of firing at the onset of light increments and contributes to motion detection for luminance increases, forming the ON-branch of the transient magnocellular-like pathway (Krieger et al., 2017; Hahn et al., 2023). Functionally, it corresponds to cluster G19 and aligns transcriptomically with cluster C41 (Krieger et al., 2017; Tran et al., 2019). It is orthologous to the primate ON Parasol RGC (Hahn et al., 2023). Molecularly, it expresses Spp1, Smi32, and Brn3b, but lacks Brn3a, Brn3c, and Calbindin (Krieger et al., 2017).\")\n25733:AnnotationAssertion(obo:RO_0002175 obo:CL_0020027 obo:NCBITaxon_10090)\n25740:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020027 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25744:SubClassOf(obo:CL_0020027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n29372:SubClassOf(obo:CL_2000031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_32443))\n30154:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30191:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30238:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30340:SubClassOf(obo:CL_4023022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30355:SubClassOf(obo:CL_4023023 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30370:SubClassOf(obo:CL_4023024 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30383:SubClassOf(obo:CL_4023025 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30411:SubClassOf(obo:CL_4023027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30425:SubClassOf(obo:CL_4023028 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30453:SubClassOf(obo:CL_4023030 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30468:SubClassOf(obo:CL_4023031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30734:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain.\")\n30740:SubClassOf(obo:CL_4023056 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30893:SubClassOf(obo:CL_4023071 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n30931:SubClassOf(obo:CL_4023075 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n31176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") obo:IAO_0000115 obo:CL_4023106 \"OBSOLETE. A mouse GABAergic cell located in the marmoset cerebral cortex that expresses meis2.\")\n31278:SubClassOf(obo:CL_4023118 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_10090))\n31320:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") obo:RO_0002175 obo:CL_4023122 obo:NCBITaxon_10090)\n31323:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25303526\") rdfs:comment obo:CL_4023122 \"These cells were first identified in mouse.\")\n31899:SubClassOf(obo:CL_4030026 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n33219:SubClassOf(obo:CL_4033095 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n33229:SubClassOf(obo:CL_4033096 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n33508:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:32027647\") Annotation(oboInOwl:hasDbXref \"PMID:33301603\") rdfs:comment obo:CL_4042015 \"Work in the mouse barrel cortex and somatosensory cortex shows that a VIP-ChAT interneuron is predominantely located in L2/3 and more rarely in the deeper layers of the cortex (Dudai et al., 2021; Dudai et al., 2020). This neuronal type could be transcriptomically distinct as transcriptomic studies have identified VIP neurons expressing ChAT in a whole brain mouse transcriptomic study (Tasic et al., 2018).\")\n33591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12429182\") Annotation(oboInOwl:hasDbXref \"PMID:9354325\") rdfs:comment obo:CL_4042021 \"In vitro cultures of embryonic mouse neural tubes show that neuronal-restricted precursors (NRPs) are derived from multipotent neuroepithelial cells to give rise to neurons. This progression suggests a linear relationship between multipotent progenitors and neuronal-restricted differentiation. (Mayer-Proschel et al., 1997). In the spinal cord of rats, neural-restricted precursor cells give rise cholinergic, GABAergic, glutametergic neurons (Cao and Howard et al., 2002).\")\n33614:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30134177\") Annotation(oboInOwl:hasDbXref \"PMID:37292997\") obo:IAO_0000115 obo:CL_4042023 \"A GABAergic interneuron expressing PTHLH and PVALB that has its soma in a striatum. This GABAergic interneuron type presents a spatial expression gradient of PVALB in the mouse striatum.\")\n33711:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35301426\") Annotation(oboInOwl:hasDbXref \"PMID:35615276\") Annotation(oboInOwl:hasDbXref \"PMID:37057892\") rdfs:comment obo:CL_4042031 \"During inflammation, immuno oligodendroglia express MHC II to interact with immune cells in mouse models (Harrington et al., 2023; Madeira et al., 2022). In a mouse model of major depressive disorder and chronic stress, immuno oligodendroglia were associated with prefrontal cortex hypomyelination (Kokkosis et al., 2022).\")\n34183:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\n34670:EquivalentClasses(obo:CL_4052051 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34680:EquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34690:EquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34706:EquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n34817:SubClassOf(obo:CL_4052070 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n34847:SubClassOf(obo:CL_4070010 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34859:SubClassOf(obo:CL_4070011 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34871:SubClassOf(obo:CL_4070012 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34883:SubClassOf(obo:CL_4070013 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34895:SubClassOf(obo:CL_4070014 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34907:SubClassOf(obo:CL_4070015 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34919:SubClassOf(obo:CL_4070016 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34931:SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n35132:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") rdfs:comment obo:CL_4072022 \"Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.\")\n35137:SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35158:SubClassOf(obo:CL_4072027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35171:EquivalentClasses(obo:CL_4072029 ObjectIntersectionOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35186:SubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35206:SubClassOf(obo:CL_4072032 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35222:SubClassOf(obo:CL_4072034 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35238:SubClassOf(obo:CL_4072035 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35252:SubClassOf(obo:CL_4072036 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35268:SubClassOf(obo:CL_4072037 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35284:SubClassOf(obo:CL_4072038 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35298:SubClassOf(obo:CL_4072039 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35316:SubClassOf(obo:CL_4072040 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35332:SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35347:SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35368:SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35384:SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35399:SubClassOf(obo:CL_4072045 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35416:SubClassOf(obo:CL_4072046 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35456:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770002 \"A trabecular meshwork cell of the juxtacanalicular tissue (JCT), characterized by a spindle-shaped, fibroblast-like morphology within a loose extracellular matrix immediately adjacent to Schlemm's canal. It expresses CHI3L1 (human and mouse) and ANGPTL7 (human), as well as smooth muscle actin for contractility. Unlike other trabecular meshwork cells, it does not form monolayers but exists in a loose network, regulating aqueous humor outflow resistance through continuous ECM remodelling, mechanotransduction, and formation of intracellular pores historically called giant vacuoles.\")\n35502:SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35583:SubClassOf(Annotation(oboInOwl:hasDbXref <https://github.com/obophenotype/cell-ontology/issues/757>) ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_7742)) ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000031))\n","exit_code":0,"status":"completed"}}
