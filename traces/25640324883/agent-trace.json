{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '34060,34100p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\nSubClassOf(obo:CL_4052005 obo:CL_0000057)\nSubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001243))\nSubClassOf(obo:CL_4052005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012375))\n\n# Class: obo:CL_4052006 (intestinal enteroendocrine progenitor)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasDbXref \"PMID:32531023\") Annotation(oboInOwl:hasDbXref \"PMID:35913117\") Annotation(oboInOwl:hasDbXref \"PMID:38260422\") Annotation(oboInOwl:hasDbXref \"doi:/10.1038/s41467-021-27901-5\") obo:IAO_0000115 obo:CL_4052006 \"An epithelial cell that is part of the crypt of Lieberkuhn, originating from intestinal stem cells and giving rise to enteroendocrine cells (EECs). In mouse and human, this cell can be characterized by the expression of Neurog3, and has the ability to proliferate and differentiate into multiple EEC subtypes. Its proliferative potential contributes to crypt growth, distinguishing it from fully differentiated EECs.\")\nAnnotationAssertion(terms:contributor obo:CL_4052006 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052006 \"2024-09-20T12:13:26Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31756561\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052006 \"EEC Progenitor\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25670791\") rdfs:comment obo:CL_4052006 \"The EEC progenitor is also present in other organisms; for example, flies have EEC progenitors but lack intestinal crypts and do not express the same markers. Instead, they are Dl+ and Pros+.\")\nAnnotationAssertion(rdfs:label obo:CL_4052006 \"intestinal enteroendocrine progenitor\")\nSubClassOf(obo:CL_4052006 obo:CL_0002563)\nSubClassOf(obo:CL_4052006 obo:CL_0011026)\nSubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0011184))\nSubClassOf(obo:CL_4052006 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002250))\n\n# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\nAnnotationAssertion(terms:contributor obo:CL_4052007 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052007 \"2024-09-23T09:59:27Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\nAnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\nSubClassOf(obo:CL_4052007 obo:CL_0000057)\nSubClassOf(obo:CL_4052007 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0001277))\n\n# Class: obo:CL_4052008 (crypt-bottom fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\nAnnotationAssertion(terms:contributor obo:CL_4052008 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052008 \"2024-09-23T10:23:18Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052008 \"CBFs\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\nAnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\nSubClassOf(obo:CL_4052008 obo:CL_4052007)\nSubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:CL_0002250))\nSubClassOf(obo:CL_4052008 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0013739))\n","exit_code":0,"status":"completed"}}
