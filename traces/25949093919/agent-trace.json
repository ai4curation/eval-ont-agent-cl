vicon-192.png\" />\n\n  <!-- 57x57 (precomposed) for iPhone 3GS, pre-2011 iPod Touch and older Android devices -->\n  <link rel=\"apple-touch-icon-precomposed\" href=\"https://cdn.ncbi.nlm.nih.gov/coreutils/nwds/img/favicons/favicon-57.png\">\n  <!-- 72x72 (precomposed) for 1st generation iPad, iPad 2 and iPad mini -->\n  <link rel=\"apple-touch-icon-precomposed\" sizes=\"72x72\" href=\"https://cdn.ncbi.nlm.nih.gov/coreutils/nwds/img/favicons/favicon-72.png\">\n  <!-- 114x114 (precomposed) for iPhone 4, 4S, 5 and post-2011 iPod Touch -->\n  <link rel=\"apple-touch-icon-precomposed\" sizes=\"114x114\" href=\"https://cdn.ncbi.nlm.nih.gov/coreutils/nwds/img/favicons/favicon-114.png\">\n  <!-- 144x144 (precomposed) for iPad 3rd and 4th generation -->\n  <link rel=\"apple-touch-icon-precomposed\" sizes=\"144x144\" href=\"https://cdn.ncbi.nlm.nih.gov/coreutils/nwds/img/favicons/favicon-144.png\">\n\n\n  <!-- For Pinger + Google Optimize integration (NS-820) -->\n  <meta name=\"ncbi_sg_optimize_id\" content=\"\">\n\n  <!-- Mobile browser address bar color -->\n  <meta name=\"theme-color\" content=\"#20558a\">\n\n  <!-- Preserve the Referrer when going from HTTPS to HTTP -->\n  <meta name=\"referrer\" content=\"origin-when-cross-origin\">\n\n  <meta name=\"ncbi_pinger_gtm_track\" content=\"true\"/>\n<!-- Logging params: Pinger defaults -->\n\n  \n    <meta name=\"ncbi_app\" content=\"pubmed\" />\n  \n\n  \n    <meta name=\"ncbi_db\" content=\"pubmed\" />\n  \n\n  \n\n  \n    <meta name=\"ncbi_phid\" content=\"98BA0001DA2F509500002BA52687F13A.1.m_2\" />\n  \n\n  \n    <meta name=\"ncbi_pinger_stat_url\" content=\"https://pubmed.ncbi.nlm.nih.gov/stat\" />\n  \n\n  \n    <meta name=\"log_category\" content=\"literature\" />\n  \n\n  \n    <meta name=\"ncbi_cost_center\" content=\"pubmed\" />\n  \n\n\n\n  <!-- Logging params: Pinger custom -->\n  \n    <meta name=\"ncbi_pdid\" content=\"pubmed\" />\n  \n    <meta name=\"log_op\" content=\"retrieve\" />\n  \n    <meta name=\"uid\" content=\"41207902\" />\n  \n    <meta name=\"ncbi_uid\" content=\"41207902\" />\n  \n\n\n\n  <!-- Social meta tags for unfurling urls -->\n  \n<meta name=\"description\" content=\"41207902\"><meta name=\"robots\" content=\"index,nofollow,noarchive\"><meta property=\"og:title\" content=\"41207902\"><meta property=\"og:url\" content=\"https://pubmed.ncbi.nlm.nih.gov/41207902/?format=pubmed\"><meta property=\"og:description\" content=\"41207902\"><meta property=\"og:image\" content=\"https://cdn.ncbi.nlm.nih.gov/pubmed/persistent/pubmed-meta-image-v2.jpg\"><meta property=\"og:image:secure_url\" content=\"https://cdn.ncbi.nlm.nih.gov/pubmed/persistent/pubmed-meta-image-v2.jpg\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:site_name\" content=\"PubMed\"><meta name=\"twitter:domain\" content=\"pubmed.ncbi.nlm.nih.gov\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"41207902\"><meta name=\"twitter:url\" content=\"https://pubmed.ncbi.nlm.nih.gov/41207902/?format=pubmed\"><meta name=\"twitter:description\" content=\"41207902\"><meta name=\"twitter:image\" content=\"https://cdn.ncbi.nlm.nih.gov/pubmed/persistent/pubmed-meta-image-v2.jpg\">\n\n\n  <!-- OpenSearch XML -->\n  <link rel=\"search\" type=\"application/opensearchdescription+xml\" href=\"https://cdn.ncbi.nlm.nih.gov/pubmed/persistent/opensearch.xml\" title=\"PubMed search\">\n\n  <!-- Disables severely broken elements when no JS -->\n  <noscript>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.ncbi.nlm.nih.gov/pubmed/a2ffdabe-e220-486a-83d1-09afbe4369a3/core/no-script.css\">\n  </noscript>\n\n  \n    <link rel=\"canonical\" href=\"https://pubmed.ncbi.nlm.nih.gov/41207902/?format=pubmed\" />\n  \n\n\n</head>\n<body >\n\n  \n  <div class=\"article-page\" id=\"article-page\">\n    \n      <pre class=\"article-details\" id=\"article-details\">PMID- 41207902\r\nOWN - NLM\r\nSTAT- MEDLINE\r\nDCOM- 20251112\r\nLR  - 20251112\r\nIS  - 2095-4700 (Print)\r\nIS  - 2095-6231 (Electronic)\r\nIS  - 2095-4700 (Linking)\r\nVI  - 13\r\nIP  - 1\r\nDP  - 2025 Nov 10\r\nTI  - Descendants of hypertrophic chondrocytes promote angiogenesis by secreting THBS4 \r\n      during bone growth and injury repair.\r\nPG  - 92\r\nLID - 10.1038/s41413-025-00469-2 [doi]\r\nLID - 92\r\nAB  - Hypertrophic chondrocytes (HCs) could transform into osteoblastic lineage cells \r\n      while the pathophysiological implications of HC transformation remain largely \r\n      unknown. Here, we generated a mouse line utilizing Col10a1-Cre to induce DTA \r\n      expression to genetically ablate HCs and their descendants. Col10a1-Cre; \r\n      R26(DTA/+) mice displayed dwarf phenotype, abnormal spongy bone, and \r\n      significantly delayed drill-hole injuries healing, suggesting an indispensable \r\n      role of HC lineage extension in bone growth and injury repair. Intriguingly, \r\n      single-cell RNA sequencing analysis revealed the most significant loss of a cell \r\n      cluster expressing multiple angiogenic factors (Pro-Angiogenic Descendants of \r\n      HCs, PADs) among cells derived from Col10a1-Cre; R26(DTA/+) and control femurs. \r\n      In silico analysis of cell-cell communication supported Thrombospondin 4 (THBS4) \r\n      as a specific angiogenic factor mediating the crosstalk between PADs and vascular \r\n      endothelial cells. Concordantly, analyses using immunostaining combined with \r\n      tissue clearing revealed that PADs physically contacted with endothelial cells, \r\n      whereas Col10a1-Cre; R26(DTA/+) mice showed defective metaphyseal and cortical \r\n      vessel formation and post-injury angiogenesis along with a significant loss of \r\n      THBS4. Moreover, in vitro assays showed that supplying THBS4 was sufficient to \r\n      promote proliferation and tube formation of endothelial cells and rescue \r\n      defective angiogenesis of Col10a1-Cre; R26(DTA/+) metatarsal explants. \r\n      Collectively, these findings demonstrate a critical role of PADs in bone growth \r\n      and injury repair by secreting THBS4 to regulate angiogenesis.\r\nCI  - © 2025. The Author(s).\r\nFAU - Song, Shiju\r\nAU  - Song S\r\nAUID- ORCID: 0000-0002-1852-0173\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Fan, Jing\r\nAU  - Fan J\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Ding, Guangyu\r\nAU  - Ding G\r\nAUID- ORCID: 0000-0003-3745-1588\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Yin, Jinhua\r\nAU  - Yin J\r\nAD  - Institute of Medical Research, Northwestern Polytechnical University, Xi&#x27;an, \r\n      China.\r\nFAU - Lu, Weiguang\r\nAU  - Lu W\r\nAUID- ORCID: 0000-0002-3920-9667\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Huang, Liangjie\r\nAU  - Huang L\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Hu, Jingyan\r\nAU  - Hu J\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Gong, Xueqin\r\nAU  - Gong X\r\nAD  - School of Medicine, Northwest University, Xi&#x27;an, China.\r\nFAU - Gao, Bo\r\nAU  - Gao B\r\nAUID- ORCID: 0000-0001-5213-0286\r\nAD  - Institute of Orthopedic Surgery, Xijing Hospital, Fourth Military Medical \r\n      University, Xi&#x27;an, China.\r\nFAU - Jie, Qiang\r\nAU  - Jie Q\r\nAUID- ORCID: 0000-0003-3215-2343\r\nAD  - Pediatric Hospital, Honghui Hospital, Xi&#x27;an Jiaotong University, Xi&#x27;an, China.\r\nAD  - Xi&#x27;an Key Laboratory of Skeletal Developmental Deformity and Injury Repair, \r\n","exit_code":0,"status":"completed"}}
