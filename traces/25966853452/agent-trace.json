nnotationAssertion(rdfs:label obo:CL_0000240 \"stratified squamous epithelial cell\")\nEquivalentClasses(obo:CL_0000240 ObjectIntersectionOf(obo:CL_0000079 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0006915)))\n","exit_code":0,"status":"completed"}}
