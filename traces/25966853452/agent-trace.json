{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"curl -L -s http://purl.obolibrary.org/obo/pato.owl | sed -n '227210,227228p'\"","aggregated_output":"            <owl:Restriction>\n                <owl:onProperty rdf:resource=\"http://purl.obolibrary.org/obo/RO_0015011\"/>\n                <owl:someValuesFrom rdf:resource=\"http://purl.obolibrary.org/obo/PATO_0000413\"/>\n            </owl:Restriction>\n        </rdfs:subClassOf>\n        <obo:IAO_0000115>A convex 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s resemblance to a cube (a 3-D shape with a square cross section).</obo:IAO_0000115>\n        <oboInOwl:hasExactSynonym>cuboidal</oboInOwl:hasExactSynonym>\n        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>\n        <oboInOwl:hasRelatedSynonym>block-like</oboInOwl:hasRelatedSynonym>\n        <oboInOwl:id>PATO:0001872</oboInOwl:id>\n        <oboInOwl:inSubset rdf:resource=\"http://purl.obolibrary.org/obo/pato#cell_quality\"/>\n        <oboInOwl:inSubset rdf:resource=\"http://purl.obolibrary.org/obo/pato#value_slim\"/>\n        <rdfs:label>cuboid</rdfs:label>\n    </owl:Class>\n    <owl:Axiom>\n        <owl:annotatedSource rdf:resource=\"http://purl.obolibrary.org/obo/PATO_0001872\"/>\n        <owl:annotatedProperty rdf:resource=\"http://purl.obolibrary.org/obo/IAO_0000115\"/>\n        <owl:annotatedTarget>A convex 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s resemblance to a cube (a 3-D shape with a square cross section).</owl:annotatedTarget>\n        <oboInOwl:hasDbXref>PATOC:MAH</oboInOwl:hasDbXref>\n","exit_code":0,"status":"completed"}}
