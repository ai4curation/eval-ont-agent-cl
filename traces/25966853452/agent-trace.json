{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '4516,4542p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(rdfs:label obo:CL_0000074 \"obsolete epithem cell\")\nAnnotationAssertion(owl:deprecated obo:CL_0000074 \"true\"^^xsd:boolean)\n\n# Class: obo:CL_0000075 (columnar/cuboidal epithelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0002065\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000075 \"A columnar/cuboidal epithelial cell is a cell usually found in a two dimensional sheet with a free surface. Columnar/cuboidal epithelial cells take on the shape of a column or cube.\")\nAnnotationAssertion(rdfs:label obo:CL_0000075 \"columnar/cuboidal epithelial cell\")\nSubClassOf(obo:CL_0000075 obo:CL_0000066)\n\n# Class: obo:CL_0000076 (squamous epithelial cell)\n\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000076 \"CALOHA:TS-1249\")\nAnnotationAssertion(rdfs:label obo:CL_0000076 \"squamous epithelial cell\")\nSubClassOf(obo:CL_0000076 obo:CL_0000066)\n\n# Class: obo:CL_0000077 (mesothelial cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_0000077 \"A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement.\")\nAnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000077 \"FMA:66773\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000077 \"mesotheliocyte\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\nAnnotationAssertion(rdfs:label obo:CL_0000077 \"mesothelial cell\")\nSubClassOf(obo:CL_0000077 obo:CL_0000076)\nSubClassOf(obo:CL_0000077 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001136))\nSubClassOf(obo:CL_0000077 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000222))\n\n# Class: obo:CL_0000078 (peridermal cell)\n","exit_code":0,"status":"completed"}}
