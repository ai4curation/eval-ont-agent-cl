rtion(rdfs:label rdfs:seeAlso \"see also\")\n3717: \n3718: \n3719: ############################\n3720: #   Object Properties\n3721: ############################\n3722: \n3723: # Object Property: obo:CL_4030044 (has_not_completed)\n3724: \n3725: AnnotationAssertion(rdfs:label obo:CL_4030044 \"has_not_completed\")\n3726: \n3727: # Object Property: obo:CL_4030045 (lacks_part)\n3728: \n3729: AnnotationAssertion(obo:IAO_0000424 obo:CL_4030045 \"http://purl.obolibrary.org/obo/BFO_0000051 exactly 0 ?Y\")\n3730: AnnotationAssertion(rdfs:label obo:CL_4030045 \"lacks_part\")\n3731: \n3732: # Object Property: obo:CL_4030046 (lacks_plasma_membrane_part)\n3733: \n3734: AnnotationAssertion(obo:IAO_0000424 obo:CL_4030046 \"http://purl.obolibrary.org/obo/BFO_0000051 exactly 0 (http://purl.obolibrary.org/obo/GO_0005886 and http://purl.obolibrary.org/obo/BFO_0000051 some ?Y)\")\n3735: AnnotationAssertion(rdfs:label obo:CL_4030046 \"lacks_plasma_membrane_part\")\n3736: \n3737: # Object Property: cl:has_high_plasma_membrane_amount (obsolete has_high_plasma_membrane_amount)\n3738: \n3739: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19243617\") obo:IAO_0000115 cl:has_high_plasma_membrane_amount \"OBSOLETE A relation between a cell and molecule or complex such that every instance of the cell has a high number of instances of that molecule expressed on the cell surface. For the formal definition, see Masci et al (PMID:19243617).\")\n3740: AnnotationAssertion(obo:IAO_0000233 cl:has_high_plasma_membrane_amount <https://github.com/obophenotype/cell-ontology/issues/1481>)\n3741: AnnotationAssertion(obo:IAO_0100001 cl:has_high_plasma_membrane_amount obo:RO_0015015)\n3742: AnnotationAssertion(rdfs:label cl:has_high_plasma_membrane_amount \"obsolete has_high_plasma_membrane_amount\")\n3743: AnnotationAssertion(owl:deprecated cl:has_high_plasma_membrane_amount \"true\"^^xsd:boolean)\n3744: \n3745: # Object Property: cl:has_low_plasma_membrane_amount (obsolete has_low_plasma_membrane_amount)\n3746: \n3747: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19243617\") obo:IAO_0000115 cl:has_low_plasma_membrane_amount \"OBSOLETE A relation between a cell and molecule or complex such that every instance of the cell has a low number of instances of that molecule expressed on the cell surface. For the formal definition, see Masci et al (PMID:19243617).\")\n3748: AnnotationAssertion(obo:IAO_0000233 cl:has_low_plasma_membrane_amount <https://github.com/obophenotype/cell-ontology/issues/1481>)\n3749: AnnotationAssertion(obo:IAO_0100001 cl:has_low_plasma_membrane_amount obo:RO_0015016)\n3750: AnnotationAssertion(rdfs:label cl:has_low_plasma_membrane_amount \"obsolete has_low_plasma_membrane_amount\")\n3751: AnnotationAssertion(owl:deprecated cl:has_low_plasma_membrane_amount \"true\"^^xsd:boolean)\n3752: \n3753: \n3754: \n3755: ############################\n3756: #   Classes\n3757: ############################\n3758: \n3759: # Class: obo:CL_0000000 (cell)\n3760: \n3761: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CARO:mah\") obo:IAO_0000115 obo:CL_0000000 \"A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.\")\n3762: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"CALOHA:TS-2035\")\n3763: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"FMA:68646\")\n3764: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"GO:0005623\")\n3765: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"KUPO:0000002\")\n3766: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"MESH:D002477\")\n3767: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"VHOG:0001533\")\n3768: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"WBbt:0004017\")\n3769: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000000 \"XAO:0003012\")\n3770: AnnotationAssertion(oboInOwl:inSubset obo:CL_0000000 ubprop:_upper_level)\n3771: Annotatio