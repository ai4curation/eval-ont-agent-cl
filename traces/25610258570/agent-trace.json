{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '34180,34240p' src/ontology/cl-edit.owl\"","aggregated_output":"# Class: obo:CL_4052052 (uterine natural killer cell 2, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052052 \"A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), peaking in the first trimester. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK3 by the absence of CD39, CD103 (Whettlock et al., 2022), and CD160 (Marečková et al., 2024), with ITGB2 serving as a defining marker (Vento-Tormo et al., 2018). Functionally, it produces more cytokines upon stimulation than uNK1, suggesting a role in immune defense, and secretes XCL1 chemokines, facilitating interactions with maternal dendritic cells and fetal extravillous trophoblasts (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(terms:contributor obo:CL_4052052 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052052 \"2025-03-14T14:31:03Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052052 \"decidual natural killer cell 2\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052052 \"uNK2\")\nAnnotationAssertion(rdfs:label obo:CL_4052052 \"uterine natural killer cell 2, human\")\nEquivalentClasses(obo:CL_4052052 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_O95971) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P38570) ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n\n# Class: obo:CL_4052053 (uterine natural killer cell 3, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:31959757\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052053 \"A uterine natural killer subset found in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018), becoming the dominant uNK subset late in pregnancy. It expresses the uterine resident marker CD49a and is distinguished from uNK1 and uNK2 by CD160 (Marečková et al., 2024) and CD103 expression, the absence of CD39, and low KIR levels (Whettlock et al., 2022). Resembling intraepithelial ILC1 cells, uNK3 primarily supports uterine immune defense (Huhn et al., 2020) and indirectly influences trophoblast behavior through chemokine secretion, such as CCL5 (Vento-Tormo et al., 2018).\")\nAnnotationAssertion(terms:contributor obo:CL_4052053 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052053 \"2025-03-14T16:15:39Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") oboInOwl:hasNarrowSynonym obo:CL_4052053 \"decidual natural killer cell 3\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052053 \"uNK3\")\nAnnotationAssertion(rdfs:label obo:CL_4052053 \"uterine natural killer cell 3, human\")\nEquivalentClasses(obo:CL_4052053 ObjectIntersectionOf(obo:CL_4052028 ObjectSomeValuesFrom(obo:CL_4030046 obo:PR_P49961) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_O95971) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P38570) ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P56199) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n\n# Class: obo:CL_4052055 (mature NK T cell, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30714682\") Annotation(oboInOwl:hasDbXref \"PMID:30875134\") obo:IAO_0000115 obo:CL_4052055 \"A mature NK T cell that can be identified by the expression of CD56 in humans.\")\nAnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_4052055 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052055 \"2025-03-26T11:56:38Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NK T-lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature NKT cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T cell, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T lymphocyte, human\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0009-0000-8480-9277\") oboInOwl:hasExactSynonym obo:CL_4052055 \"mature natural killer T-lymphocyte, human\")\nAnnotationAssertion(rdfs:label obo:CL_4052055 \"mature NK T cell, human\")\nEquivalentClasses(obo:CL_4052055 ObjectIntersectionOf(obo:CL_0000814 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_P13591) ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n\n# Class: obo:CL_4052058 (Merkel cell of epidermis)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_4052058 \"A Merkel cell found mainly in the basal layer of the epidermis and the outer root sheath of hair follicles, particularly concentrated in areas with high tactile acuity, such as touch domes, hair follicles, and fingertips.\")\nAnnotationAssertion(terms:contributor obo:CL_4052058 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052058 \"2025-06-11T10:01:40Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:6207057\") oboInOwl:hasExactSynonym obo:CL_4052058 \"epdiermal Merkel cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052058 \"Merkel cell of epidermis\")\nEquivalentClasses(obo:CL_4052058 ObjectIntersectionOf(obo:CL_0000242 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001003)))\n\n# Class: obo:CL_4052060 (spinous cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34283481\") Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") obo:IAO_0000115 obo:CL_4052060 \"A differentiating keratinocyte found in the epidermis and oral epithelium, located in the stratum spinosum, characterized by a spiny appearance due to abundant intercellular desmosomal junctions.\")\nAnnotationAssertion(terms:contributor obo:CL_4052060 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052060 \"2025-07-02T12:21:06Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_4052060 \"prickle cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052060 \"spinous cell\")\nSubClassOf(obo:CL_4052060 obo:CL_0000312)\nSubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030057))\nSubClassOf(obo:CL_4052060 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001365))\n\n# Class: obo:CL_4052061 (epidermal keratinocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D015603\") Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:38473275\") Annotation(oboInOwl:hasDbXref \"PMID:39115524\") Annotation(oboInOwl:hasDbXref \"wikipedia:Keratinocyte\") obo:IAO_0000115 obo:CL_4052061 \"A keratinocyte of the skin epidermis that synthesizes keratin and undergoes successive stages of differentiation as it migrates from the basal layer to the cornified (stratum corneum) layer. These differentiation stages include the basal, spinous (prickle), and granular cell layers. This cell is central to epidermal homeostasis, mediating wound healing, immune modulation, including the secretion of cytokines and chemokines that recruit neutrophils (Simmons and Gallo, 2024), and intercellular communication with adjacent melanocytes (Marrapodi and Bellei, 2024).\")\nAnnotationAssertion(terms:contributor obo:CL_4052061 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052061 \"2025-07-02T12:32:13Z\"^^xsd:dateTime)\n","exit_code":0,"status":"completed"}}
