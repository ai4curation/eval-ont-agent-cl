{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"sed -n '33088,33124p' src/ontology/cl-edit.owl\"","aggregated_output":"SubClassOf(obo:CL_4033067 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_4033084))\n\n# Class: obo:CL_4033083 (squamous granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033083 \"A granulosa cell that has a squamous morphology and form a single layer around the oocyte in primordial follicles. This cell develops directly into a cuboidal granulosa cell during the primordial-to-primary follicle transition.\")\nAnnotationAssertion(terms:contributor obo:CL_4033083 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033083 \"2024-09-24T13:13:24Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22402964\") oboInOwl:hasExactSynonym obo:CL_4033083 \"flattened granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") oboInOwl:hasRelatedSynonym obo:CL_4033083 \"pre-granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033083 \"squamous GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-6677-8489\") rdfs:comment obo:CL_4033083 \"Often in literature squamous granulosa cell and pre-granulosa cell are used as synonyms. However, this term only makes reference to the quiescent granulosa cells that surround the primordial ovarian follicle, while a pre-granulosa cell proliferates to form the primordial follicle (and thus cells become the squamous granulosa cells).\")\nAnnotationAssertion(rdfs:label obo:CL_4033083 \"squamous granulosa cell\")\nSubClassOf(obo:CL_4033083 obo:CL_0000501)\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003981))\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033066))\nSubClassOf(obo:CL_4033083 ObjectSomeValuesFrom(obo:RO_0002210 obo:CL_4033084))\n\n# Class: obo:CL_4033084 (cuboidal granulosa cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28892263\") obo:IAO_0000115 obo:CL_4033084 \"A granulosa cell that has a cuboidal morphology and develops from squamous granulosa cell during the transition between primordial follicle to primary follicle. Cuboidal granulosa cells proliferate to form a second layer within secondary follicles.\")\nAnnotationAssertion(terms:contributor obo:CL_4033084 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033084 \"2024-09-24T13:14:57Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") oboInOwl:hasExactSynonym obo:CL_4033084 \"columnar granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31849844\") oboInOwl:hasExactSynonym obo:CL_4033084 \"cuboidal epithelial granulosa cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19001500\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"columnar GC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33914868\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033084 \"cuboidal GC\")\nAnnotationAssertion(rdfs:label obo:CL_4033084 \"cuboidal granulosa cell\")\nSubClassOf(obo:CL_4033084 obo:CL_0000501)\nSubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001305))\nSubClassOf(obo:CL_4033084 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4033083))\n\n# Class: obo:CL_4033085 (diffuse bipolar 5 cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") obo:IAO_0000115 obo:CL_4033085 \"An ON diffuse bipolar cell that stratifies in the stratum 3 of the inner plexiform layer to make synapses with ON parasol ganglion cells. A diffuse bipolar 5 cell has high expression of MYO16 compared with other bipolar cells.\")\nAnnotationAssertion(obo:RO_0002175 obo:CL_4033085 obo:NCBITaxon_9443)\nAnnotationAssertion(terms:contributor obo:CL_4033085 <https://orcid.org/0000-0001-6677-8489>)\nAnnotationAssertion(terms:date obo:CL_4033085 \"2024-10-16T12:46:53Z\"^^xsd:dateTime)\n","exit_code":0,"status":"completed"}}
