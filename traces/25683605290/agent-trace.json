{"type":"tool_use","timestamp":1778520404708,"sessionID":"ses_1e7fa0cd6ffep0w9olQuQmvvYB","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-94e949fb23f09984","state":{"status":"completed","input":{"filePath":"/home/runner/work/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":35000},"output":"<path>/home/runner/work/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n35000: \n35001: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26132331\") Annotation(oboInOwl:hasDbXref \"PMID:36209152\") obo:IAO_0000115 obo:CL_4072012 \"A type of dopaminergic neuron located in the preoptic periventricular nucleus of the hypothalamus and implicated in neuroendocrine modulation.\")\n35002: AnnotationAssertion(terms:date obo:CL_4072012 \"2025-05-06T13:00:54Z\"^^xsd:dateTime)\n35003: AnnotationAssertion(rdfs:label obo:CL_4072012 \"A15 dopaminergic neuron\")\n35004: SubClassOf(obo:CL_4072012 obo:CL_0000700)\n35005: SubClassOf(obo:CL_4072012 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002622))\n35006: SubClassOf(obo:CL_4072012 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n35007: \n35008: # Class: obo:CL_4072013 (A16 dopaminergic neuron)\n35009: \n35010: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28261065\") Annotation(oboInOwl:hasDbXref \"doi:/10.1101/2023.08.29.554772\") obo:IAO_0000115 obo:CL_4072013 \"A type of dopaminergic interneuron located in the glomerular layer of the main olfactory bulb, characterized by the co-release of dopamine and GABA, and involved in modulating sensory input within olfactory circuits.\")\n35011: AnnotationAssertion(terms:date obo:CL_4072013 \"2025-05-06T13:12:14Z\"^^xsd:dateTime)\n35012: AnnotationAssertion(rdfs:label obo:CL_4072013 \"A16 dopaminergic neuron\")\n35013: SubClassOf(obo:CL_4072013 obo:CL_0000099)\n35014: SubClassOf(obo:CL_4072013 obo:CL_0000700)\n35015: SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0005377))\n35016: SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n35017: SubClassOf(obo:CL_4072013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35018: \n35019: # Class: obo:CL_4072014 (tanycyte of vascular organ of lamina terminalis)\n35020: \n35021: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") Annotation(oboInOwl:hasDbXref \"PMID:26017494\") obo:IAO_0000115 obo:CL_4072014 \"A specialized, non-ciliated ependymal glial cell located in the ventricular wall of the organum vasculosum of the lamina terminalis (OVLT) and characterized by elongated basal processes extending into the parenchyma to contact fenestrated capillaries. In mice, it is characterised by the expression of tight junction proteins (claudin 1, occludin, ZO-1) forming a continuous honeycomb junctional pattern. This cell contributes to a functional blood–cerebrospinal fluid (CSF) barrier at the ventricular interface of the OVLT.\")\n35022: AnnotationAssertion(terms:date obo:CL_4072014 \"2025-06-04T10:27:59Z\"^^xsd:dateTime)\n35023: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23649873\") oboInOwl:hasBroadSynonym obo:CL_4072014 \"Tanycyte-like cells in CVOs\")\n35024: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like cell of OVLT\")\n35025: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32071335\") oboInOwl:hasExactSynonym obo:CL_4072014 \"tanycyte-like ependymal cell of OVLT\")\n35026: AnnotationAssertion(rdfs:label obo:CL_4072014 \"tanycyte of vascular organ of lamina terminalis\")\n35027: SubClassOf(obo:CL_4072014 obo:CL_0002085)\n35028: SubClassOf(obo:CL_4072014 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002689))\n35029: \n35030: # Class: obo:CL_4072015 (monocyte-derived Kupffer cell)\n35031: \n35032: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26813785\") Annotation(oboInOwl:hasDbXref \"PMID:31561945\") Annotation(oboInOwl:hasDbXref \"PMID:37740916\") obo:IAO_0000115 obo:CL_4072015 \"A Kupffer cell located within the hepatic sinusoids, derived from circulating bone marrow monocytes that acquire the phenotypic markers and functional properties of resident Kupffer cells through niche-dependent imprinting, typically following depletion of the embryonically derived Kupffer cell population. During liver injury, MoKCs become the dominant Kupffer cell subset, exhibiting enhanced proliferation, resistance to apoptosis, and key roles in tissue repair and fibrosis attenuation.\")\n35033: AnnotationAssertion(terms:date obo:CL_4072015 \"2025-07-11T00:00:00Z\"^^xsd:dateTime)\n35034: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37740916\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072015 \"MoKC\")\n35035: AnnotationAssertion(rdfs:label obo:CL_4072015 \"monocyte-derived Kupffer cell\")\n35036: SubClassOf(obo:CL_4072015 obo:CL_0000091)\n35037: SubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001281))\n35038: SubClassOf(obo:CL_4072015 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000860))\n35039: \n35040: # Class: obo:CL_4072016 (NPY interneuron)\n35041: \n35042: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") Annotation(oboInOwl:hasDbXref \"PMID:32376782\") obo:IAO_0000115 obo:CL_4072016 \"An interneuron that expresses neuropeptide Y (NPY) and is mainly located in cortical layers II–III and VI, as well as in various brain regions such as the medial geniculate and inferior colliculus. The NPY cell population is physiologically diverse, displaying a range of firing behaviors, including adapting, fast-spiking, and accelerating patterns.\")\n35043: AnnotationAssertion(terms:date obo:CL_4072016 \"2025-07-07T09:04:45Z\"^^xsd:dateTime)\n35044: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32376782\") oboInOwl:hasExactSynonym obo:CL_4072016 \"NPY-expressing neuron\")\n35045: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19295167\") oboInOwl:hasRelatedSynonym obo:CL_4072016 \"NPY-expressing neocortical interneuron\")\n35046: AnnotationAssertion(rdfs:label obo:CL_4072016 \"NPY interneuron\")\n35047: SubClassOf(obo:CL_4072016 obo:CL_0000099)\n35048: SubClassOf(obo:CL_4072016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35049: SubClassOf(obo:CL_4072016 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011387))\n35050: \n35051: # Class: obo:CL_4072017 (agouti-related protein expressing neuron)\n35052: \n35053: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34469623\") Annotation(oboInOwl:hasDbXref \"PMID:37957320\") Annotation(oboInOwl:hasDbXref \"PMID:39719709\") obo:IAO_0000115 obo:CL_4072017 \"A GABAergic neuron located in the arcuate nucleus of the hypothalamus that expresses agouti-related protein (AgRP). This neuron can coexpress AgRP, GABA, and neuropeptide Y (NPY) in mice, and plays a key role in integrating metabolic signals. It is activated by hunger-related hormones such as ghrelin and inhibited by satiety signals like leptin.\")\n35054: AnnotationAssertion(terms:date obo:CL_4072017 \"2025-07-07T09:55:43Z\"^^xsd:dateTime)\n35055: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39719709\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072017 \"AgRP neuron\")\n35056: AnnotationAssertion(rdfs:label obo:CL_4072017 \"agouti-related protein expressing neuron\")\n35057: SubClassOf(obo:CL_4072017 obo:CL_0000617)\n35058: SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001932))\n35059: SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003846))\n35060: SubClassOf(obo:CL_4072017 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011387))\n35061: \n35062: # Class: obo:CL_4072018 (pacemaker neuron)\n35063: \n35064: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31982322\") Annotation(oboInOwl:hasDbXref \"PMID:39303139\") obo:IAO_0000115 obo:CL_4072018 \"A neuron that generates rhythmic bursts of action potentials independently of synaptic input. This intrinsic property enables it to maintain oscillatory activity even when isolated from other neurons. It populates the brainstem, hypothalamus, basal ganglia, spinal cord, and cerebellum. It plays a crucial role in regulating circadian rhythms in the suprachiasmatic nucleus, generating respiratory rhythms in the preBötzinger complex, and synchronizing neural networks.\")\n35065: AnnotationAssertion(terms:date obo:CL_4072018 \"2025-07-07T12:37:16Z\"^^xsd:dateTime)\n35066: AnnotationAssertion(rdfs:label obo:CL_4072018 \"pacemaker neuron\")\n35067: SubClassOf(obo:CL_4072018 obo:CL_0000540)\n35068: SubClassOf(obo:CL_4072018 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0019226))\n35069: \n35070: # Class: obo:CL_4072019 (SCN pacemaker neuron)\n35071: \n35072: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") Annotation(oboInOwl:hasDbXref \"PMID:32066983\") obo:IAO_0000115 obo:CL_4072019 \"A type of neuron located in the suprachiasmatic nucleus (SCN) that possesses intrinsic circadian rhythmicity, characterized by strong and rhythmic expression of core clock genes and the ability to independently generate and sustain circadian oscillations. In mice, the specific subtypes Avp+/Nms+, Vip+/Nms+, and Cck+/C1ql3+ neurons have the most robust circadian gene expression and contribute to synchronizing and maintaining rhythmicity within the SCN network (Wen et al., 2020).\")\n35073: AnnotationAssertion(terms:date obo:CL_4072019 \"2025-07-14T10:10:28Z\"^^xsd:dateTime)\n35074: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20148688\") oboInOwl:hasExactSynonym obo:CL_4072019 \"pacemaker neuron of the suprachiasmatic nucleus\")\n35075: AnnotationAssertion(rdfs:label obo:CL_4072019 \"SCN pacemaker neuron\")\n35076: SubClassOf(obo:CL_4072019 obo:CL_0000540)\n35077: SubClassOf(obo:CL_4072019 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002034))\n35078: \n35079: # Class: obo:CL_4072021 (corticotropin-releasing neuron)\n35080: \n35081: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasDbXref \"PMID:2785663\") Annotation(oboInOwl:hasDbXref \"PMID:28790896\") Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasDbXref \"PMID:9662138\") obo:IAO_0000115 obo:CL_4072021 \"A specialised type of interneuron defined by the secretion of corticotropin-releasing hormone (CRH), a key peptide in activating the hypothalamic–pituitary–adrenal (HPA) axis during stress. It is primarily located in the paraventricular nucleus (PVN) of the hypothalamus, with additional presence in the hippocampus, piriform area, central amygdalar nucleus, Barrington’s nucleus, and inferior olivary complex (Peng et al., 2017).\")\n35082: AnnotationAssertion(terms:date obo:CL_4072021 \"2025-07-14T12:17:35Z\"^^xsd:dateTime)\n35083: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33158870\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRF neuron\")\n35084: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21871477\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072021 \"CRH neuron\")\n35085: AnnotationAssertion(rdfs:label obo:CL_4072021 \"corticotropin-releasing neuron\")\n35086: SubClassOf(obo:CL_4072021 obo:CL_0000099)\n35087: SubClassOf(obo:CL_4072021 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051458))\n35088: \n35089: # Class: obo:CL_4072022 (Lamp5 Lhx6 GABAergic interneuron (Homo sapiens))\n35090: \n35091: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"PMID:38712198\") obo:IAO_0000115 obo:CL_4072022 \"A Lamp5 Lhx6 GABAergic interneuron of Homo sapiens. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', Lamp5 Lhx6\")\n35092: AnnotationAssertion(obo:RO_0002175 obo:CL_4072022 obo:NCBITaxon_9606)\n35093: AnnotationAssertion(terms:date obo:CL_4072022 \"2025-07-31T14:01:52Z\"^^xsd:dateTime)\n35094: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072022 \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\")\n35095: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") rdfs:comment obo:CL_4072022 \"Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.\")\n35096: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://zenodo.org/records/11165918\") rdfs:comment obo:CL_4072022 \"The marker set CHST9, LAMP5 can identify the Human cell type Lamp5 Lhx6 neuron in the neocortex with a confidence of 0.821678322 (NS-Forest FBeta value).\")\n35097: AnnotationAssertion(rdfs:label obo:CL_4072022 \"Lamp5 Lhx6 GABAergic interneuron (Homo sapiens)\")\n35098: SubClassOf(obo:CL_4072022 obo:CL_4042013)\n35099: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000203))\n35100: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35101: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n35102: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148))\n35103: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032533))\n35104: SubClassOf(obo:CL_4072022 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000075))\n35105: \n35106: # Class: obo:CL_4072027 (sst GABAergic interneuron (Homo sapiens))\n35107: \n35108: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072027 \"sst interneuron (Homo sapiens)\")\n35109: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072027 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst). The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Sst.\")\n35110: AnnotationAssertion(obo:RO_0002175 obo:CL_4072027 obo:NCBITaxon_9606)\n35111: AnnotationAssertion(terms:contributor obo:CL_4072027 \"https://orcid.org/0000-0002-5507-2103\")\n35112: AnnotationAssertion(terms:date obo:CL_4072027 \"2025-08-12T10:45:41Z\"^^xsd:dateTime)\n35113: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072027 \"ILX:0770152\")\n35114: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SOM+ inhibitory interneuron (Homo sapiens)\")\n35115: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"SST+ IN (Homo sapiens)\")\n35116: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4072027 \"somatostatin-expressing inhibitory interneuron (Homo sapiens)\")\n35117: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072027 cl:BDS_subset)\n35118: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072027 cl:cellxgene_subset)\n35119: AnnotationAssertion(rdfs:label obo:CL_4072027 \"sst GABAergic interneuron (Homo sapiens)\")\n35120: SubClassOf(obo:CL_4072027 obo:CL_4023017)\n35121: SubClassOf(obo:CL_4072027 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35122: SubClassOf(obo:CL_4072027 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000082))\n35123: \n35124: # Class: obo:CL_4072029 (pvalb GABAergic interneuron (Homo sapiens))\n35125: \n35126: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072029 \"pvalb interneuron (Homo sapiens)\")\n35127: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072029 \"A transcriptomically distinct GABAergic interneuron with a soma located in a cerebral cortex and it expresses Parvalbumin. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Pvalb.\")\n35128: AnnotationAssertion(obo:RO_0002175 obo:CL_4072029 obo:NCBITaxon_9606)\n35129: AnnotationAssertion(terms:contributor obo:CL_4072029 \"https://orcid.org/0000-0002-5507-2103\")\n35130: AnnotationAssertion(terms:date obo:CL_4072029 \"2025-08-12T14:31:10Z\"^^xsd:dateTime)\n35131: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:BDS_subset)\n35132: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072029 cl:cellxgene_subset)\n35133: AnnotationAssertion(rdfs:label obo:CL_4072029 \"pvalb GABAergic interneuron (Homo sapiens)\")\n35134: EquivalentClasses(obo:CL_4072029 ObjectIntersectionOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606)))\n35135: SubClassOf(obo:CL_4072029 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000080))\n35136: \n35137: # Class: obo:CL_4072031 (sst chodl GABAergic interneuron (Homo sapiens))\n35138: \n35139: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072031 \"sst chodl interneuron (Homo sapiens)\")\n35140: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\n35141: AnnotationAssertion(obo:RO_0002175 obo:CL_4072031 obo:NCBITaxon_9606)\n35142: AnnotationAssertion(terms:contributor obo:CL_4072031 \"https://orcid.org/0000-0002-5507-2103\")\n35143: AnnotationAssertion(terms:date obo:CL_4072031 \"2025-09-04T10:20:07Z\"^^xsd:dateTime)\n35144: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33372656\") oboInOwl:hasBroadSynonym obo:CL_4072031 \"long-range GABAergic interneuron (Homo sapiens)\")\n35145: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072031 cl:cellxgene_subset)\n35146: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072031 \"The marker set NPY can identify the Human cell type sst chodl GABAergic interneuron in the neocortex with a confidence of 0.894026187 (NS-Forest FBeta value).\")\n35147: AnnotationAssertion(rdfs:label obo:CL_4072031 \"sst chodl GABAergic interneuron (Homo sapiens)\")\n35148: SubClassOf(obo:CL_4072031 obo:CL_4023121)\n35149: SubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35150: SubClassOf(obo:CL_4072031 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000083))\n35151: \n35152: # Class: obo:CL_4072032 (VIP GABAergic interneuron (Homo sapiens))\n35153: \n35154: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072032 \"VIP interneuron (Homo sapiens)\")\n35155: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4072032 \"A transcriptomically distinct GABAergic neuron that expresses the vasoactive intestinal polypeptide and that has its soma located in the forebrain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Vip.\")\n35156: AnnotationAssertion(obo:RO_0002175 obo:CL_4072032 obo:NCBITaxon_9606)\n35157: AnnotationAssertion(terms:contributor obo:CL_4072032 \"https://orcid.org/0000-0002-5507-2103\")\n35158: AnnotationAssertion(terms:date obo:CL_4072032 \"2025-09-04T10:52:00Z\"^^xsd:dateTime)\n35159: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:31210267\") Annotation(oboInOwl:hasDbXref \"PMID:33794534\") Annotation(oboInOwl:hasDbXref \"PMID:35221922\") terms:description obo:CL_4072032 \"This neuronal type is distinguished by its heterogeneous morphology and electrophysiological characteristics  (Pronneke et al., 2015,2020; Apicella and Marchionni, 2022). Variations in morphology and firing patterns are observed in human VIP interneurons. In a study by Lee et al., 2023, four distinct subtypes of VIP neurons were identified, each exhibiting unique morphologies, soma locations, and electrophysiological properties. These subtypes are defined according to their transcriptomic markers: LBH-VIP and CCD184-VIP, both of which display a bipolar morphology with axons and dendrites extending across cortical layers; and SY16-VIP and ADAMTSL1-VIP, characterized by a dendritic arbor that spreads horizontally within the same layer as the soma (Lee et al., 2023). Disruption or malfunction of VIP interneuron is implicated in neurodevelopmental disorders such as Rett Syndrome and Dravet Syndrome (Goff and Goldberg 2021).\")\n35160: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4072032 \"ILX:0770151\")\n35161: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP neuron (Homo sapiens)\")\n35162: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP type (Homo sapiens)\")\n35163: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"VIP-IN (Homo sapiens)\")\n35164: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4072032 \"Vip (Homo sapiens)\")\n35165: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072032 cl:BDS_subset)\n35166: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072032 \"The marker set VIP can identify the Human cell type VIP GABAergic interneuron in the neocortex with a confidence of 0.855531344 (NS-Forest FBeta value).\")\n35167: AnnotationAssertion(rdfs:label obo:CL_4072032 \"VIP GABAergic interneuron (Homo sapiens)\")\n35168: SubClassOf(obo:CL_4072032 obo:CL_4023016)\n35169: