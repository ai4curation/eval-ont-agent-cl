rdfs:comment obo:CL_4072041 \"The marker set LINC00507, THEMIS can identify the Human cell type L6 intratelencephalic projecting glutamatergic neuron in the neocortex with a confidence of 0.641695703 (NS-Forest FBeta value).\")\n35293: AnnotationAssertion(rdfs:label obo:CL_4072041 \"L6 intratelencephalic projecting glutamatergic neuron (Homo sapiens)\")\n35294: SubClassOf(obo:CL_4072041 obo:CL_4030065)\n35295: SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35296: SubClassOf(obo:CL_4072041 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000071))\n35297: \n35298: # Class: obo:CL_4072042 (L5/6 near-projecting glutamatergic neuron (Homo sapiens))\n35299: \n35300: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35301: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:37292694\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072042 \"A transcriptomically defined near-projecting glutamatergic neuron with a soma found in cortical layer 5/6 in humans.\")\n35302: AnnotationAssertion(obo:RO_0002175 obo:CL_4072042 obo:NCBITaxon_9606)\n35303: AnnotationAssertion(terms:contributor obo:CL_4072042 \"https://orcid.org/0000-0002-5507-2103\")\n35304: AnnotationAssertion(terms:date obo:CL_4072042 \"2025-09-16T08:55:09Z\"^^xsd:dateTime)\n35305: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072042 \"L5/6 NP (Homo sapiens)\")\n35306: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072042 cl:cellxgene_subset)\n35307: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072042 \"The marker set NPSR1-AS1, TLL1 can identify the Human cell type L5/6 near-projecting glutamatergic neuron in the neocortex with a confidence of 0.899288218 (NS-Forest FBeta value).\")\n35308: AnnotationAssertion(rdfs:label obo:CL_4072042 \"L5/6 near-projecting glutamatergic neuron (Homo sapiens)\")\n35309: SubClassOf(obo:CL_4072042 obo:CL_4030067)\n35310: SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35311: SubClassOf(obo:CL_4072042 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000069))\n35312: \n35313: # Class: obo:CL_4072043 (L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens))\n35314: \n35315: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072043 \"L5 ET glut (Homo sapiens)\")\n35316: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072043 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons ', Author Categories: 'CrossArea_subclass', clusters L5 ET.\")\n35317: AnnotationAssertion(obo:RO_0002175 obo:CL_4072043 obo:NCBITaxon_9606)\n35318: AnnotationAssertion(terms:contributor obo:CL_4072043 \"https://orcid.org/0000-0002-5507-2103\")\n35319: AnnotationAssertion(terms:date obo:CL_4072043 \"2025-09-16T09:26:37Z\"^^xsd:dateTime)\n35320: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4072043 \"subcerebral projection (SCPN) neuron (Homo sapiens)\")\n35321: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4072043 \"Pyramidal tract-like (PT-l) (Homo sapiens)\")\n35322: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4072043 \"burst-firing layer 5 neuron (Homo sapiens)\")\n35323: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4072043 \"thick-tufted layer 5 (TTL5) pyramidal neuron (Homo sapiens)\")\n35324: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4072043 \"pyramidal tract (PT) neuron (Homo sapiens)\")\n35325: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072043 \"L5b neuron (Homo sapiens)\")\n35326: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:BDS_subset)\n35327: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072043 cl:cellxgene_subset)\n35328: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072043 \"The marker set CHST8, POU3F1 can identify the Human cell type L5 extratelencephalic projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.815891473 (NS-Forest FBeta value).\")\n35329: AnnotationAssertion(rdfs:label obo:CL_4072043 \"L5 extratelencephalic projecting glutamatergic cortical neuron (Homo sapiens)\")\n35330: SubClassOf(obo:CL_4072043 obo:CL_4023041)\n35331: SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35332: SubClassOf(obo:CL_4072043 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000067))\n35333: \n35334: # Class: obo:CL_4072044 (L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens))\n35335: \n35336: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072044 \"L6 CT glut (Homo sapiens)\")\n35337: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072044 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', clusters L6 CT.\")\n35338: AnnotationAssertion(obo:RO_0002175 obo:CL_4072044 obo:NCBITaxon_9606)\n35339: AnnotationAssertion(terms:contributor obo:CL_4072044 \"https://orcid.org/0000-0002-5507-2103\")\n35340: AnnotationAssertion(terms:date obo:CL_4072044 \"2025-09-16T09:42:20Z\"^^xsd:dateTime)\n35341: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4072044 \"L6 CT (Homo sapiens)\")\n35342: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:BDS_subset)\n35343: AnnotationAssertion(oboInOwl:inSubset obo:CL_4072044 cl:cellxgene_subset)\n35344: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://doi.org/10.5281/zenodo.11165918\") rdfs:comment obo:CL_4072044 \"The marker set SEMA5B, ADAMTSL1, SULF1 can identify the Human cell type L6 corticothalamic-projecting glutamatergic cortical neuron in the neocortex with a confidence of 0.631898455 (NS-Forest FBeta value).\")\n35345: AnnotationAssertion(rdfs:label obo:CL_4072044 \"L6 corticothalamic-projecting glutamatergic cortical neuron (Homo sapiens)\")\n35346: SubClassOf(obo:CL_4072044 obo:CL_4023042)\n35347: SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35348: SubClassOf(obo:CL_4072044 ObjectSomeValuesFrom(obo:RO_0015004 obo:CLM_1000070))\n35349: \n35350: # Class: obo:CL_4072045 (L6b glutamatergic cortical neuron (Homo sapiens))\n35351: \n35352: AnnotationAssertion(obo:IAO_0000028 obo:CL_4072045 \"L6b glut (Homo sapiens)\")\n35353: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4072045 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neuron', Author Categories: 'CrossArea_subclass', cluster L6b.\")\n35354: AnnotationAssertion(obo:RO_0002175 obo:CL_4072045 obo:NCBITaxon_9606)\n35355: AnnotationAssertion(terms:contributor obo:CL_4072045 \"https://orcid.org/0000-0002-5507-2103\")\n35356: AnnotationAssertion(terms:date obo:CL_4072045 \"2025-09-16T10:30:38Z\"^^xsd:dateTime)\n35357: AnnotationAssertion(