{"type":"tool_use","timestamp":1779070414883,"sessionID":"ses_1c7248ba4ffehv2wEvBI10NUTW","part":{"type":"tool","tool":"grep","callID":"call_UfXSzqTA4LAoC6fX7aQft3VC","state":{"status":"completed","input":{"pattern":"medial ganglionic eminence|MGE","path":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology","include":"cl-edit.owl"},"output":"Found 18 matches\n/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl:\n  Line 25470: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:21925242\") Annotation(oboInOwl:hasDbXref \"PMID:2329464\") Annotation(oboInOwl:hasDbXref \"PMID:25374536\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") obo:IAO_0000115 obo:CL_0020008 \"A large aspiny interneuron of the striatum that serves as the principal intrinsic source of acetylcholine while simultaneously releasing GABA. It is defined by coexpression of cholinergic markers (ChAT and VAChT/Slc18a3) and GABAergic markers (GAD65/Gad2 and VGAT/Slc32a1) (Lozovaya et al., 2018). This MGE-derived neuron maintains Lhx6 expression associated with dual-transmitter identity (Fragkouli et al., 2009; Marin et al., 2000). Morphologically, it possesses a large soma (20–50 μm diameter), 2–4 thick aspiny dendrites extending radially ~1 mm, and locally ramified axons with hundreds of thousands of varicosities (Wilson et al., 1990; Lim et al., 2014).\")\n\n  Line 25483: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:27194328\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.03.16.484460\") obo:IAO_0000115 obo:CL_0020009 \"A GABAergic neuron located in the external globus pallidus (GPe) that constitutes approximately two-thirds of all GPe neurons (Mallet et al., 2012, Dodson et al., 2015). Derived from the medial ganglionic eminence, this cell selectively expresses Nkx2-1, with roughly two-thirds co-expressing parvalbumin (PV) and one-third lacking it in mice (Mallet et al., 2012; Dodson et al., 2015).\")\n\n  Line 30242: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023017 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst) and derived from the MGE.\")\n\n  Line 30310: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023023 \"A lamp 5 GABAergic cortical interneuron with neurogliaform morphology with a soma found in L5,6. L5,6 NGC lamp5 have deep afterhyperpolarization (AHP) but narrow action potentials (APs). Unlike other deep neurogliaform cells (which are caudal ganglionic eminence (CGE) derived), L5,6 NGC lamp5 cells are medial ganglionic eminence (MGE)-derived\")\n\n  Line 30757: # Class: obo:CL_4023063 (medial ganglionic eminence derived interneuron)\n\n  Line 30759: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023063 \"MGE interneuron\")\n\n  Line 30760: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") obo:IAO_0000115 obo:CL_4023063 \"An interneuron that is derived from the medial ganglionic eminence.\")\n\n  Line 30762: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023063 \"MGE interneuron\")\n\n  Line 30763: AnnotationAssertion(rdfs:label obo:CL_4023063 \"medial ganglionic eminence derived interneuron\")\n\n  Line 30821: # Class: obo:CL_4023069 (medial ganglionic eminence derived GABAergic interneuron)\n\n  Line 30823: AnnotationAssertion(obo:IAO_0000028 obo:CL_4023069 \"MGE gaba interneuron\")\n\n  Line 30824: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12637172\") obo:IAO_0000115 obo:CL_4023069 \"A GABAergic interneuron that develops from the medial ganglionic eminence and has migrated to the cerebral cortex.\")\n\n  Line 30826: AnnotationAssertion(rdfs:label obo:CL_4023069 \"medial ganglionic eminence derived GABAergic interneuron\")\n\n  Line 33438: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34004146\") Annotation(oboInOwl:hasDbXref \"PMID:36007006\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"PMID:37824669\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4042013 \"A transcriptomically distinct GABAergic interneuron marked by Lamp5 and Lhx6 expression, derived from the Medial Ganglionic Eminence (MGE), and located in the pallium.\")\n\n  Line 35095: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32999462\") rdfs:comment obo:CL_4072022 \"Despite being clustered as CGE in this dataset, other studies suggest that the cell is of MGE origin because it expresses transcription factors such as LHX6 and NKX2-1, which are hallmark indicators of MGE-derived interneurons. Fate mapping experiments in mice have demonstrated that Lamp5+/Lhx6+ interneurons in both the hippocampus and neocortex arise from the MGE, and single-cell transcriptomic comparisons further show that primate neocortical Lamp5+/Lhx6+ cells closely resemble mouse hippocampal MGE-derived interneurons rather than classic CGE-derived types.\")\n\n  Line 35109: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072027 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst). The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Sst.\")\n\n  Line 35127: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072029 \"A transcriptomically distinct GABAergic interneuron with a soma located in a cerebral cortex and it expresses Parvalbumin. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', cluster Pvalb.\")\n\n  Line 35140: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15845086\") Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:33372656\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4072031 \"A transcriptomically distinct sst GABAergic interneuron that also expresses Chodl. These neurons are rare and correspond to the only known interneurons with long-range projection. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: MGE-derived interneurons', Author Categories: 'CrossArea_subclass', clusters Sst Chodl.\")\n","metadata":{"matches":18,"truncated":false},"title":"medial ganglionic eminence|MGE","time":{"start":1779070414833,"end":1779070414878}},"id":"prt_e38dc2fed001VUKrGaA7X59huv","sessionID":"ses_1c7248ba4ffehv2wEvBI10NUTW","messageID":"msg_e38dc18e1001GHqOQd8fmgAmDX"}}
