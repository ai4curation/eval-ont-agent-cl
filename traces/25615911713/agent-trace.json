nnotationAssertion(terms:contributor obo:CL_4070017 <https://orcid.org/0000-0002-1909-7004>)\n34422: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4070017 \"LP\")\n34423: AnnotationAssertion(rdfs:label obo:CL_4070017 \"lateral pyloric motor neuron\")\n34424: SubClassOf(obo:CL_4070017 obo:CL_0000100)\n34425: SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_8910001))\n34426: SubClassOf(obo:CL_4070017 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_6657))\n34427: \n34428: # Class: obo:CL_4072001 (newly formed oligodendrocyte)\n34429: \n34430: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") obo:IAO_0000115 obo:CL_4072001 \"A post-mitotic oligodendrocyte that has exited the cell cycle and begun early stage differentiation. The cell begins to acquire oligodendrocyte-like characteristics but has not yet initiated myelination. In mice, NFOL is marked by the expression of Tcf7l2 and Cemip2 (also known as Tmem2), among other early myelin-related genes. These markers highlight cells transitioning from a precursor to a more differentiated, pre-myelinating state.\")\n34431: AnnotationAssertion(terms:contributor obo:CL_4072001 <https://orcid.org/0000-0002-5507-2103>)\n34432: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072001 \"NFOL\")\n34433: AnnotationAssertion(rdfs:label obo:CL_4072001 \"newly formed oligodendrocyte\"@en)\n34434: SubClassOf(obo:CL_4072001 obo:CL_0000123)\n34435: SubClassOf(obo:CL_4072001 obo:CL_0000128)\n34436: SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34437: SubClassOf(obo:CL_4072001 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4023059))\n34438: \n34439: # Class: obo:CL_4072002 (myelin-forming oligodendrocyte)\n34440: \n34441: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:30837646\") Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasDbXref \"PMID:9473608\") obo:IAO_0000115 obo:CL_4072002 \"A postmitotic and differentiated oligodendrocyte derived from a oligodendrocyte progenitor cell. A myelin-forming oligodendrocyte begins the expression of myelin genes and actively engages in the myelination process. In mice and humans, it is characterized by the upregulation of the key myelin-associated markers Mbp and Opalin. Additionally, Ctps (CTP synthase) shows peak expression at this stage, suggesting a heightened demand for nucleotide biosynthesis during membrane expansion and myelin production.\")\n34442: AnnotationAssertion(terms:contributor obo:CL_4072002 <https://orcid.org/0000-0002-5507-2103>)\n34443: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39233334\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072002 \"MFOL\")\n34444: AnnotationAssertion(rdfs:label obo:CL_4072002 \"myelin-forming oligodendrocyte\"@en)\n34445: SubClassOf(obo:CL_4072002 obo:CL_0000128)\n34446: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001017))\n34447: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072001))\n34448: SubClassOf(obo:CL_4072002 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34449: \n34450: # Class: obo:CL_4072003 (mature myelinating oligodendrocyte)\n34451: \n34452: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:33203872\") obo:IAO_0000115 obo:CL_4072003 \"A post-mitotic oligodendrocyte derived from a myelin-forming oligodendrocyte (MFOL). A mature Myelinating Oligodendrocyte is a fully differentiated cell that is actively engaged in myelination. In addition to high expression of canonical myelin genes (e.g., Mbp, Plp1, Mog), a MOL can be distinguished by the expression of stage-enriched genes Grm3, Klk6, Ptgds, Anxa5, and Hopx in mice. These markers reflect the functional specialization of a mature oligodendrocyte, including roles in signalling, lipid metabolism, and myelin maintenance.\")\n34453: AnnotationAssertion(terms:contributor obo:CL_4072003 <https://orcid.org/0000-0002-5507-2103>)\n34454: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072003 \"MOL\")\n34455: AnnotationAssertion(rdfs:label obo:CL_4072003 \"mature myelinating oligodendrocyte\")\n34456: SubClassOf(obo:CL_4072003 obo:CL_0000128)\n34457: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0043209))\n34458: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002207 obo:CL_4072002))\n34459: SubClassOf(obo:CL_4072003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0032289))\n34460: \n34461: # Class: obo:CL_4072005 (A8 dopaminergic neuron)\n34462: \n34463: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:33756109\") Annotation(oboInOwl:hasDbXref \"PMID:34532720\") Annotation(oboInOwl:hasDbXref \"PMID:8514911\") obo:IAO_0000115 obo:CL_4072005 \"A type of midbrain dopaminergic neuron localized in the retrorubral field which projects to limbic and cortical regions involved in emotion, motivation, and reward.\")\n34464: AnnotationAssertion(terms:date obo:CL_4072005 \"2025-05-02T08:37:36Z\"^^xsd:dateTime)\n34465: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33756109\") oboInOwl:hasExactSynonym obo:CL_4072005 \"A8 dopamine neuron\")\n34466: AnnotationAssertion(rdfs:label obo:CL_4072005 \"A8 dopaminergic neuron\")\n34467: SubClassOf(obo:CL_4072005 obo:CL_2000097)\n34468: SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0011172))\n34469: SubClassOf(obo:CL_4072005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n34470: \n34471: # Class: obo:CL_4072006 (A9 dopaminergic neuron)\n34472: \n34473: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23603197\") Annotation(oboInOwl:hasDbXref \"PMID:24843012\") Annotation(oboInOwl:hasDbXref \"PMID:26430123\") Annotation(oboInOwl:hasDbXref \"PMID:32869307\") Annotation(oboInOwl:hasDbXref \"PMID:38092916\") Annotation(oboInOwl:hasDbXref \"PMID:39961377\") obo:IAO_0000115 obo:CL_4072006 \"A type of dopaminergic neuron in the substantia nigra involved in motor control and particularly vulnerable in Parkinson’s disease. In mice, it is notable for its heterogeneous co-release of dopamine with either glutamate or GABA. It releases GABA through alternative synthesis pathways or reuptake mechanisms independent of GAD expression.\")\n34474: AnnotationAssertion(terms:date obo:CL_4072006 \"2025-05-02T09:59:34Z\"^^xsd:dateTime)\n34475: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20049900\") oboInOwl:hasExactSynonym obo:CL_4072006 \"A9 nigral dopamine neuron\")\n34476: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31704946\") oboInOwl:hasExactSynonym obo:CL_4072006 \"substantia nigra dopaminergic neuron\")\n34477: AnnotationAssertion(rdfs:label obo:CL_4072006 \"A9 dopaminergic neuron\")\n34478: SubClassOf(obo:CL_4072006 obo:CL_4042025)\n34479: SubClassOf(obo:CL_4072006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002038))\n\n(Showing lines 34300-34479 of 34709. Use offset=34480 to continue.)\n</content>","metadata":{"preview":"# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\nAnnotationAssertion(terms:contributor obo:CL_4052067 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052067 \"2025-08-06T11:26:37Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\nSubClassOf(obo:CL_4052067 obo:CL_0000159)\nSubClassOf(obo:CL_4052067 obo:CL_0002623)\n\n# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\nAnnotationAssertion(terms:contributor obo:CL_4052069 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052069 \"2025-08-08T11:20:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\nAnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\nSubClassOf(obo:CL_4052069 obo:CL_1001596)\nSubClassOf(obo:CL_4052069 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0035049))\n\n# Class: obo:CL_4052070 (dual-feature fallopian tube progenitor cell)","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778376052498,"end":177