00743 \"is hypertrophic pathological or normal? and can it be described using a pato term?\")\n10186: AnnotationAssertion(rdfs:label obo:CL_0000743 \"hypertrophic chondrocyte\")\n10187: SubClassOf(obo:CL_0000743 obo:CL_0000138)\n10188: \n10189: # Class: obo:CL_0000744 (columnar chondrocyte)\n10190: \n10191: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15951842\") obo:IAO_0000115 obo:CL_0000744 \"A columnar chondrocyte that differentiates in the late embryonic growth plate of bone. Columnar chondrocytes vigorously proliferate and form columns in the growth plate.\")\n10192: AnnotationAssertion(rdfs:label obo:CL_0000744 \"columnar chondrocyte\")\n10193: SubClassOf(obo:CL_0000744 obo:CL_0000138)\n10194: \n10195: # Class: obo:CL_0000745 (retina horizontal cell)\n10196: \n10197: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0195088433\") obo:IAO_0000115 obo:CL_0000745 \"A neuron that laterally connects other neurons in the inner nuclear layer of the retina.\")\n10198: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000745 \"BTO:0004120\")\n10199: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000745 \"horizontal cell\")\n10200: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000745 \"HC\")\n10201: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000745 \"HCs\")\n10202: AnnotationAssertion(rdfs:label obo:CL_0000745 \"retina horizontal cell\")\n10203: SubClassOf(obo:CL_0000745 obo:CL_0000099)\n10204: SubClassOf(obo:CL_0000745 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0003902))\n10205: \n10206: # Class: obo:CL_0000746 (cardiac muscle cell)\n10207: \n10208: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mtg_cardiacconduct_nov11\") Annotat