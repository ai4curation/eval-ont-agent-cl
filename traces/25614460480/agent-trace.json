iliation\":\"Howard Hughes Medical Institute, Chevy Chase, MD, USA.\"}]}},{\"fullName\":\"Watts TH\",\"firstName\":\"Tania H\",\"lastName\":\"Watts\",\"initials\":\"TH\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0001-7897-4890\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Immunology, University of Toronto, Toronto, Ontario, Canada.\"}]}},{\"fullName\":\"Weaver CT\",\"firstName\":\"Casey T\",\"lastName\":\"Weaver\",\"initials\":\"CT\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-2180-1793\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"The University of Alabama at Birmingham, Birmingham, AL, USA.\"}]}},{\"fullName\":\"Wherry EJ\",\"firstName\":\"E John\",\"lastName\":\"Wherry\",\"initials\":\"EJ\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0003-0477-1956\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Systems Pharmacology and Translational Therapeutics and Institute for Immunology and Immune Health, University of Pennsylvania Perelman School of Medicine, Philadelphia, PA, USA.\"}]}},{\"fullName\":\"Xue HH\",\"firstName\":\"Hai-Hui\",\"lastName\":\"Xue\",\"initials\":\"HH\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-9163-7669\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Center for Discovery and Innovation, Hackensack University Medical Center, Nutley, NJ, USA.\"},{\"affiliation\":\"New Jersey Veterans Affairs Health Care System, East Orange, NJ, USA.\"}]}},{\"fullName\":\"Youngblood B\",\"firstName\":\"Ben\",\"lastName\":\"Youngblood\",\"initials\":\"B\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-1261-9957\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Immunology, St Jude Children's Research Hospital, Memphis, TN, USA.\"}]}},{\"fullName\":\"Ahmed R\",\"firstName\":\"Rafi\",\"lastName\":\"Ahmed\",\"initials\":\"R\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Microbiology and Immunology, Emory Vaccine Center, Atlanta, GA, USA.\"}]}}]},\"authorIdList\":{\"authorId\":[{\"type\":\"ORCID\",\"value\":\"0000-0001-6122-9245\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-7278-0147\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-7448-7040\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-7889-2393\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-7897-4890\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-8236-9183\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-9137-1146\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-9679-7912\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-0084-9130\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-0698-3146\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-1261-9957\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-1964-7678\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-2079-2354\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-2180-1793\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-2563-1971\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-2923-8245\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-3041-7240\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-3768-9468\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-3838-3989\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-5900-508X\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-6308-9503\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-6312-6968\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-7045-7837\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-7431-2854\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-7622-5754\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9163-7669\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9230-9501\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9370-2671\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9440-3884\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9495-5793\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9792-4271\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-0477-1956\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-0517-8804\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-0633-1719\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-2276-7117\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-2915-9317\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-3750-2752\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-3812-647X\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-4307-9161\"}]},\"dataLinksTagsList\":{\"dataLinkstag\":[\"altmetrics\"]},\"journalInfo\":{\"issue\":\"4\",\"volume\":\"26\",\"journalIssueId\":4168024,\"dateOfPublication\":\"2026 Apr\",\"monthOfPublication\":4,\"yearOfPublication\":2026,\"printPublicationDate\":\"2026-04-01\",\"journal\":{\"title\":\"Nature reviews. Immunology\",\"medlineAbbreviation\":\"Nat Rev Immunol\",\"nlmid\":\"101124169\",\"isoabbreviation\":\"Nat Rev Immunol\",\"issn\":\"1474-1733\",\"essn\":\"1474-1741\"}},\"pubYear\":\"2026\",\"pageInfo\":\"298-313\",\"abstractText\":\"Advances in T cell biology have revealed heterogeneity among T cell populations that is not captured by existing general nomenclature. This issue has caused an ad hoc broadening of core T cell subset definitions and the invention of new subset designations that have not been uniformly delineated. To address this issue, in this Consensus \r100 27278    0 27278    0     0  53723      0 --:--:-- --:--:-- --:--:-- 53802\nStatement, we propose guidelines that serve three goals. First, they advocate that primary research reports define the experimental basis by which relevant subsets are designated in the methods section of each study. Second, they provide standardized definitions for existing subset designations in popular use, and common experimental criteria for defining each subset are noted. Last, they present an alternative 'modular nomenclature' paradigm. The newly proposed modular nomenclature eschews conceptualization of antigen-experienced T cells as belonging to a few idealized subsets, and the nomenclature instead simply indicates individual biological properties present in a T cell population with brief descriptors. Collectively, these guidelines intend to enhance transparency in the literature while facilitating clearer communication of findings and concepts to researchers, students and clinicians.\",\"affiliation\":\"Department of Microbiology & Immunology, Center for Immunology, University of Minnesota Medical School, Minneapolis, MN, USA. masopust@umn.edu.\",\"publicationStatus\":\"ppublish\",\"language\":\"eng\",\"pubModel\":\"Print-Electronic\",\"pubTypeList\":{\"pubType\":[\"Review\",\"Journal Article\"]},\"meshHeadingList\":{\"meshHeading\":[{\"majorTopic_YN\":\"Y\",\"descriptorName\":\"T-Lymphocyte Subsets\",\"meshQualifierList\":{\"meshQualifier\":[{\"abbreviation\":\"CL\",\"qualifierName\":\"classification\",\"majorTopic_YN\":\"N\"},{\"abbreviation\":\"IM\",\"qualifierName\":\"immunology\",\"majorTopic_YN\":\"N\"}]}},{\"majorTopic_YN\":\"Y\",\"descriptorName\":\"T-Lymphocytes\",\"meshQualifierList\":{\"meshQualifier\":[{\"abbreviation\":\"CL\",\"qualifierName\":\"classification\",\"majorTopic_YN\":\"N\"},{\"abbreviation\":\"IM\",\"qualifierName\":\"immunology\",\"majorTopic_YN\":\"N\"}]}},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Animals\"},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Humans\"},{\"majorTopic_YN\":\"Y\",\"descriptorName\":\"Terminology as Topic\"},{\"majorTopic_YN\":\"Y\",\"descriptorName\":\"Guidelines as Topic\"}]},\"subsetList\":{\"subset\":[{\"code\":\"IM\",\"name\":\"Index Medicus\"}]},\"fullTextUrlList\":{\"fullTextUrl\":[{\"availability\":\"Subscription required\",\"availabilityCode\":\"S\",\"documentStyle\":\"doi\",\"site\":\"DOI\",\"url\":\"https://doi.org/10.1038/s41577-025-01238-2\"}]},\"isOpenAccess\":\"N\",\"inEPMC\":\"N\",\"inPMC\":\"N\",\"hasPDF\":\"N\",\"hasBook\":\"N\",\"hasSuppl\":\"N\",\"citedByCount\":9,\"hasData\":\"N\",\"hasReferences\":\"Y\",\"hasTextMinedTerms\":\"N\",\"hasDbCrossReferences\":\"N\",\"hasLabsLinks\":\"Y\",\"hasEvaluations\":\"N\",\"authMan\":\"N\",\"epmcAuthMan\":\"N\",\"nihAuthMan\":\"N\",\"hasTMAccessionNumbers\":\"N\",\"dateOfCompletion\":\"2026-04-01\",\"dateOfCreation\":\"2025-11-18\",\"firstIndexDate\":\"2025-11-19\",\"dateOfRevision\":\"2026-04-01\",\"electronicPublicationDate\":\"2025-11-18\",\"firstPublicationDate\":\"2025-11-18\"}]}}","exit_code":0,"status":"completed"}}
