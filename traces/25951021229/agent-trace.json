{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"rg -n 'salivar|saliva|parotid|sublingual|submandibular|junctional epithelium|gingiva|gingival|duct.*salivary|striated duct|demilune|myoepithelial' src/ontology/cl-edit.owl\"","aggregated_output":"5630:# Class: obo:CL_0000185 (myoepithelial cell)\n5638:AnnotationAssertion(rdfs:label obo:CL_0000185 \"myoepithelial cell\")\n15853:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12014572\") obo:IAO_0000115 obo:CL_0002170 \"A keratinized cell located in the hard palate or gingiva.\")\n16161:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:20013317\") obo:IAO_0000115 obo:CL_0002198 \"A large epithelial cell with an extremely acidophilic and granular cytoplasm, containing vast numbers of mitochondria; such cells may undergo neoplastic transformation. From the Greek word onkos meaning swelling, this cell type is found in parathyroid, salivary and thyroid glands.\")\n17573:# Class: obo:CL_0002324 (basal-myoepithelial cell of mammary gland)\n17575:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11250738\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") Annotation(oboInOwl:hasDbXref \"PMID:38059556\") obo:IAO_0000115 obo:CL_0002324 \"A myoepithelial cell that is part of a mammary gland and is located in the basal layer. During lactation, a basal-myoepithelial cell of mammary gland contracts under the stimulation of oxytocin. In humans, a basal-myoepithelial cell of mammary gland can be identified by high levels of CD49f and low levels of EpCAM.\")\n17580:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37694522\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal myoepithelial cell\")\n17581:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37380767\") oboInOwl:hasBroadSynonym obo:CL_0002324 \"basal-myoepithelial cell\")\n17584:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11250738\") oboInOwl:hasExactSynonym obo:CL_0002324 \"myoepithelial cell of mammary gland\")\n17586:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0002324 \"myoepithelial cell of lactiferous gland\")\n17590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38059556\") rdfs:comment obo:CL_0002324 \"Due inconsistencies in naming this and other mammary gland epithelial cell types, several mammary gland experts gathered for a breast atlas annotation jamboree organized by Chan-Zuckerberg initiative. They agreed to label this cell type as basal-myoepithelial cell (and abbreviated: B-Myo cell).\")\n17591:AnnotationAssertion(rdfs:label obo:CL_0002324 \"basal-myoepithelial cell of mammary gland\")\n18872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:hjd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15987436\") Annotation(oboInOwl:hasDbXref \"PMID:16397499\") Annotation(oboInOwl:hasDbXref \"PMID:17851544\") obo:IAO_0000115 obo:CL_0002451 \"A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.\")\n19176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cjm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0006420\") obo:IAO_0000115 obo:CL_0002481 \"The flattened smooth myoepithelial cells of mesodermal origin that lie just outside the basal lamina of the seminiferous tubule.\")\n19847:# Class: obo:CL_0002552 (fibroblast of gingiva)\n19851:AnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n20493:# Class: obo:CL_0002621 (gingival epithelial cell)\n20497:AnnotationAssertion(rdfs:label obo:CL_0002621 \"gingival epithelial cell\")\n20510:# Class: obo:CL_0002623 (acinar cell of salivary gland)\n20512:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:24646566\") Annotation(oboInOwl:hasDbXref \"PMID:25843887\") Annotation(oboInOwl:hasDbXref \"PMID:28623666\") Annotation(oboInOwl:hasDbXref \"PMID:34989394\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_0002623 \"An acinar cell that is part of the salivary gland epithelium, responsible for synthesizing and secreting the primary saliva essential for oral digestion, antimicrobial defense, and mucosal immunity. It features apical-basal polarity with apical secretory granules, and tight junctions that maintain polarity and regulate calcium-dependent saliva exocytosis triggered by parasympathetic and sympathetic signals (Ambudkar, 2015). This cell functions in coordination with contractile myoepithelial cells, which aid saliva flow through the ducts into the oral cavity (Khan et al., 2022). In mice and humans, acinar cell development relies on the transcription factor SOX2 (Emmerson et al., 2017), with self-renewal achieved primarily through acinar cell self-duplication and supported by progenitor populations during injury and regeneration (Aure et al., 2016).\")\n20515:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24646566\") oboInOwl:hasExactSynonym obo:CL_0002623 \"salivary acinar cell\")\n20516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24646566\") oboInOwl:hasExactSynonym obo:CL_0002623 \"salivary gland acinar cell\")\n20517:AnnotationAssertion(rdfs:label obo:CL_0002623 \"acinar cell of salivary gland\")\n20757:# Class: obo:CL_0002649 (obsolete epithelial cell of gingival part of viscerocranial mucosa)\n20759:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002649 \"An ecto-epithelial cell of the gingival region of the viscerocranial mucosa.\")\n20763:AnnotationAssertion(rdfs:label obo:CL_0002649 \"obsolete epithelial cell of gingival part of viscerocranial mucosa\")\n23344:# Class: obo:CL_0009005 (salivary gland cell)\n23346:AnnotationAssertion(obo:IAO_0000115 obo:CL_0009005 \"Any cell in a salivary gland.\")\n23349:AnnotationAssertion(rdfs:label obo:CL_0009005 \"salivary gland cell\")\n27284:# Class: obo:CL_1000394 (myoepithelial cell of intralobular lactiferous duct)\n27286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000394 \"A myoepithelial cell that is part of the intralobular part of terminal lactiferous duct.\")\n27288:AnnotationAssertion(rdfs:label obo:CL_1000394 \"myoepithelial cell of intralobular lactiferous duct\")\n27457:# Class: obo:CL_1000416 (obsolete myoepithelial cell of lactiferous gland)\n27459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000416 \"OBSOLETE. A myoepithelial cell that is part of the mammary gland.\")\n27461:AnnotationAssertion(rdfs:comment obo:CL_1000416 \"Term merged into CL:0002324 (myoepithelial cell of mammary gland)\")\n27462:AnnotationAssertion(rdfs:label obo:CL_1000416 \"obsolete myoepithelial cell of lactiferous gland\")\n27465:# Class: obo:CL_1000417 (myoepithelial cell of sweat gland)\n27467:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000417 \"A myoepithelial cell that is part of the sweat gland.\")\n27469:AnnotationAssertion(rdfs:label obo:CL_1000417 \"myoepithelial cell of sweat gland\")\n27473:# Class: obo:CL_1000418 (myoepithelial cell of lactiferous alveolus)\n27475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000418 \"A myoepithelial cell that is part of the mammary gland alveolus.\")\n27478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:67802\") oboInOwl:hasExactSynonym obo:CL_1000418 \"myoepithelial cell of mammary alveolus\")\n27479:AnnotationAssertion(rdfs:label obo:CL_1000418 \"myoepithelial cell of lactiferous alveolus\")\n27483:# Class: obo:CL_1000419 (myoepithelial cell of lactiferous duct)\n27485:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000419 \"A myoepithelial cell that is part of the lactiferous duct.\")\n27487:AnnotationAssertion(rdfs:label obo:CL_1000419 \"myoepithelial cell of lactiferous duct\")\n27491:# Class: obo:CL_1000420 (myoepithelial cell of terminal lactiferous duct)\n27493:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000420 \"A myoepithelial cell that is part of the terminal lactiferous duct.\")\n27495:AnnotationAssertion(rdfs:label obo:CL_1000420 \"myoepithelial cell of terminal lactiferous duct\")\n27678:# Class: obo:CL_1000445 (myoepithelial cell of dilator pupillae)\n27680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000445 \"A myoepithelial cell that is part of the dilatator pupillae.\")\n27682:AnnotationAssertion(rdfs:label obo:CL_1000445 \"myoepithelial cell of dilator pupillae\")\n27840:# Class: obo:CL_1000468 (myoepithelial cell of acinus of lactiferous gland)\n27842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000468 \"A myoepithelial cell that is part of the acinus of lactiferous gland.\")\n27845:AnnotationAssertion(rdfs:label obo:CL_1000468 \"myoepithelial cell of acinus of lactiferous gland\")\n27849:# Class: obo:CL_1000469 (myoepithelial cell of main lactiferous duct)\n27851:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000469 \"A myoepithelial cell that is part of the main lactiferous duct.\")\n27853:AnnotationAssertion(rdfs:label obo:CL_1000469 \"myoepithelial cell of main lactiferous duct\")\n27856:# Class: obo:CL_1000470 (myoepithelial cell of primary lactiferous duct)\n27858:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000470 \"A myoepithelial cell that is part of the primary lactiferous duct.\")\n27860:AnnotationAssertion(rdfs:label obo:CL_1000470 \"myoepithelial cell of primary lactiferous duct\")\n27863:# Class: obo:CL_1000471 (myoepithelial cell of secondary lactiferous duct)\n27865:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000471 \"A myoepithelial cell that is part of the secondary lactiferous duct.\")\n27867:AnnotationAssertion(rdfs:label obo:CL_1000471 \"myoepithelial cell of secondary lactiferous duct\")\n27870:# Class: obo:CL_1000472 (myoepithelial cell of tertiary lactiferous duct)\n27872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000472 \"A myoepithelial cell that is part of the tertiary lactiferous duct.\")\n27874:AnnotationAssertion(rdfs:label obo:CL_1000472 \"myoepithelial cell of tertiary lactiferous duct\")\n27877:# Class: obo:CL_1000473 (myoepithelial cell of quarternary lactiferous duct)\n27879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_1000473 \"A myoepithelial cell that is part of the quarternary lactiferous duct.\")\n27881:AnnotationAssertion(rdfs:label obo:CL_1000473 \"myoepithelial cell of quarternary lactiferous duct\")\n29360:# Class: obo:CL_1001596 (salivary gland glandular cell)\n29362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"HPA:HPA\") Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001596 \"Glandular cell of salivary gland. Example: Serous cells, mucous cells, cuboidal epithelial cells of the intercalated ducts, simple cuboidal epithelium of the striated ducts, epithelial cells of excretory ducts.\")\n29364:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-1282\") oboInOwl:hasRelatedSynonym obo:CL_1001596 \"salivary gland glandular cells\")\n29365:AnnotationAssertion(rdfs:label obo:CL_1001596 \"salivary gland glandular cell\")\n32786:# Class: obo:CL_4033003 (myoepithelial cell of bronchus submucosal gland)\n32788:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19996346\") Annotation(oboInOwl:hasDbXref \"PMID:5487122\") obo:IAO_0000115 obo:CL_4033003 \"A(n) myoepithelial cell that is part of a(n) bronchus submucosal gland.\")\n32790:AnnotationAssertion(rdfs:label obo:CL_4033003 \"myoepithelial cell of bronchus submucosal gland\")\n32952:# Class: obo:CL_4033021 (myoepithelial cell of trachea gland)\n32954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29656943\") obo:IAO_0000115 obo:CL_4033021 \"A myoepithelial cell that is part of a submucosal gland of the trachea.\")\n32958:AnnotationAssertion(rdfs:label obo:CL_4033021 \"myoepithelial cell of trachea gland\")\n34981:# Class: obo:CL_4052039 (tuft cell of submandibular gland)\n34983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35993302\") Annotation(oboInOwl:hasDbXref \"PMID:38098741\") Annotation(oboInOwl:hasDbXref \"PMID:8874101\") obo:IAO_0000115 obo:CL_4052039 \"A tuft cell that is part of the epithelium of the submandibular gland, localized to the striated ducts in mice, pigs, and humans, and to the main excretory ducts in rats. This cell is characterized by chemosensory functions, potential roles in immune regulation, and possible involvement in salivary secretion via acetylcholine release.\")\n34986:AnnotationAssertion(rdfs:label obo:CL_4052039 \"tuft cell of submandibular gland\")\n35051:# Class: obo:CL_4052048 (intercalated cell of salivary gland)\n35053:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:35799078\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") Annotation(oboInOwl:hasDbXref \"PMID:37724716\") obo:IAO_0000115 obo:CL_4052048 \"A cuboidal epithelial cell that is part of the intercalated duct of salivary gland. This cell expresses proteins commonly associated with acinar cells and displays calcium signaling characteristics similar to secretory cells, indicating an active role in the secretory process rather than ion reabsorption.\")\n35058:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37724716\") oboInOwl:hasExactSynonym obo:CL_4052048 \"salivary intercalated duct cells\")\n35060:AnnotationAssertion(rdfs:label obo:CL_4052048 \"intercalated cell of salivary gland\")\n35065:# Class: obo:CL_4052049 (striated cell of salivary gland)\n35067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30855909\") Annotation(oboInOwl:hasDbXref \"PMID:34147989\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052049 \"An columnar/cuboidal epithelial cell that is part of the striated duct of salivary gland, characterized by basal striations formed by infoldings of the plasma membrane. This cell play a crucial role in modifying the electrolyte composition and concentration of saliva through active ion transport, particularly the absorption of sodium and secretion of potassium.\")\n35072:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11590591\") oboInOwl:hasBroadSynonym obo:CL_4052049 \"striated duct cells\")\n35073:AnnotationAssertion(rdfs:label obo:CL_4052049 \"striated cell of salivary gland\")\n35194:# Class: obo:CL_4052065 (serous acinar cell of salivary gland)\n35196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052065 \"An acinar cell of the salivary gland, characterized by a pyramidal or triangular shape with a spherical nucleus and abundant eosinophilic zymogen granules. This cell secretes watery, enzyme‐rich fluid containing α-amylase, proline-rich proteins, and secretory immunoglobulins for starch digestion and antimicrobial defence. In humans and mice, serous acinar cell predominates in the parotid gland and to a lesser extent in the submandibular gland, where it exists alongside mucous acinar cells (Maruyama et al., 2019).\")\n35199:AnnotationAssertion(rdfs:label obo:CL_4052065 \"serous acinar cell of salivary gland\")\n35204:# Class: obo:CL_4052066 (mucous acinar cell of salivary gland)\n35206:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:32829674\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") obo:IAO_0000115 obo:CL_4052066 \"An acinar cell of the salivary gland, responsible for producing a viscous, mucin‐rich solution, thereby facilitating lubrication and protection of the oral mucosa. This cell is characterized by an elongated shape, clear cytoplasm filled with mucin granules, and a basally compressed nucleus (Barrows et al., 2020). In humans and mice, the mucous acinar cell predominates in the sublingual gland and minor salivary glands, while also being present in mixed glands such as the submandibular gland, where it coexists with serous acinar cells (Maruyama et al., 2019).\")\n35209:AnnotationAssertion(rdfs:label obo:CL_4052066 \"mucous acinar cell of salivary gland\")\n35214:# Class: obo:CL_4052067 (seromucous acinar cell of salivary gland)\n35216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29383862\") Annotation(oboInOwl:hasDbXref \"PMID:35343828\") Annotation(oboInOwl:hasDbXref \"PMID:36726292\") obo:IAO_0000115 obo:CL_4052067 \"An acinar cell of the salivary gland, with a hybrid seromucous phenotype, co-expressing serous and mucous markers and producing a mixed secretion of enzymes-containing serous fluid and mucins essential for lubrication, digestion, and antimicrobial defense. Predominant in the submandibular glands of humans and mice, its differentiation and secretory gene expression are regulated by FGFR2b–MAPK signaling, driven by paracrine FGF7 from adjacent myoepithelial cells, which provides a key niche signal for seromucous identity.\")\n35219:AnnotationAssertion(rdfs:label obo:CL_4052067 \"seromucous acinar cell of salivary gland\")\n35223:# Class: obo:CL_4052069 (excretory duct cell of salivary gland)\n35225:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28192873\") Annotation(oboInOwl:hasDbXref \"PMID:31194408\") Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") Annotation(oboInOwl:hasDbXref \"doi:10.5772/intechopen.75538\") obo:IAO_0000115 obo:CL_4052069 \"A duct epithelial cell that is part of the excretory duct of the salivary gland, which transports saliva from the intralobular ductal system to the oral cavity. While primarily serving as a conduit, this cell may play a role in the saliva modification, contributing to its hypotonicity. In humans, this cell has a pseudostratified columnar shape.\")\n35228:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:/10.1007/978-3-030-35784-9_2\") oboInOwl:hasExactSynonym obo:CL_4052069 \"salivary excretory duct cell\")\n35229:AnnotationAssertion(rdfs:label obo:CL_4052069 \"excretory duct cell of salivary gland\")\n","exit_code":0,"status":"completed"}}
