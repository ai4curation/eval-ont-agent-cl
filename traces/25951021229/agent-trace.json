{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '25820,25960p' src/ontology/cl-edit.owl\"","aggregated_output":"SubClassOf(obo:CL_0020030 obo:CL_0011025)\n\n# Class: obo:CL_0020031 (CD8-positive exhausted alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31207603\") Annotation(oboInOwl:hasDbXref \"PMID:36907685\") Annotation(oboInOwl:hasDbXref \"PMID:38166256\") obo:IAO_0000115 obo:CL_0020031 \"A CD8-positive alpha-beta T cell that displays impaired function and altered differentiation as a result of chronic antigenic stimulation (e.g., chronic infection, tumours, or persistent inflammation). This state is characterised by sustained expression of PD-1 as a shared feature. Additional exhaustion-associated molecules, including expression of the transcription factor TOX and reduced T-bet, and context- or stage-dependent changes in markers such as LAG-3, TIM-3, CD39, and EOMES, may also be observed; however, the expression levels of these molecules vary depending on exhaustion stage and disease context.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020031 <https://github.com/obophenotype/cell-ontology/issues/3453>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020031 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020031 \"2026-01-13T15:30:05Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"CD8+ exhausted T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"exhausted CD8 T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"exhausted CD8-positive T cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020031 \"CD8-positive exhausted alpha-beta T cell\")\nEquivalentClasses(obo:CL_0020031 ObjectIntersectionOf(obo:CL_0000625 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001919)))\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0020031 obo:CL_0000625)\nSubClassOf(obo:CL_0020031 obo:CL_0011025)\n\n# Class: obo:CL_0020032 (oRGC2)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020032 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together ON parasol RGCs from primate foveal and peripheral retina with their molecularly homologous mouse α RGC subtype (ON-transient α RGC, C41) (Hahn et al., 2023; Tran et al., 2019). Reference to the transcriptomic evidence is found at: GSE237215.\")\nAnnotationAssertion(terms:contributor obo:CL_0020032 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(oboInOwl:id obo:CL_0020032 \"CL:9900000\")\nAnnotationAssertion(rdfs:label obo:CL_0020032 \"oRGC2\")\nAnnotationAssertion(Annotation(rdfs:label \"reference transcriptomic data on GEO\") rdfs:seeAlso obo:CL_0020032 \"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE237215\")\nSubClassOf(obo:CL_0020032 obo:CL_0000740)\n\n# Class: obo:CL_0020033 (stem cell memory CD4-positive, alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19525962\") Annotation(oboInOwl:hasDbXref \"PMID:21926977\") Annotation(oboInOwl:hasDbXref \"PMID:28060797\") obo:IAO_0000115 obo:CL_0020033 \"A CD4-positive memory alpha-beta T cell with stem-like properties that is long-lived, retains a naïve-like phenotype, and exhibits self-renewal and multipotent differentiation capacity. This cell acts as a stem-like reservoir capable of regenerating central and effector memory T cell subsets.\")\nAnnotationAssertion(terms:contributor obo:CL_0020033 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020033 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020033 \"GitHub Copilot\")\nAnnota