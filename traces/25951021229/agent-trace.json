 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020034 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020034 \"2026-01-12T12:14:30Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21926977\") oboInOwl:hasExactSynonym obo:CL_0020034 \"CD8+ T memory stem cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21926977\") oboInOwl:hasExactSynonym obo:CL_0020034 \"CD8+ TSCM cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21926977\") oboInOwl:hasExactSynonym obo:CL_0020034 \"CD8-positive TSCM cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell memory CD8+ T-cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell memory CD8+ T-lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell memory CD8+ alpha-beta T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell memory CD8-positive, alpha-beta T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell–like memory CD8+ T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020034 \"stem cell–like memory CD8-positive, alpha-beta T cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020034 \"stem cell memory CD8-positive, alpha-beta T cell\")\nSubClassOf(obo:CL_0020034 obo:CL_0000909)\n\n# Class: obo:CL_0020035 (intestinal intraepithelial lymphocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29674648\") Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Intraepithelial_lymphocyte\") obo:IAO_0000115 obo:CL_0020035 \"A T cell that is located in the intestinal epithelium and is capable of a mucosal immune response.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020035 \"https://github.com/obophenotype/cell-ontology/issues/3455\")\nAnnotationAssertion(terms:contributor obo:CL_0020035 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020035 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020035 \"2026-01-05T11:44:26Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020035 \"intestinal intraepithelial lymphocyte\")\nEquivalentClasses(obo:CL_0020035 ObjectIntersectionOf(obo:CL_0002419 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001277) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002385)))\nSubClassOf(obo:CL_0020035 obo:CL_0002496)\n\n# Class: obo:CL_0020036 (oRGC1)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020036 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together OFF midget RGCs from primate foveal and peripheral retina with their molecularly homologous mouse alpha RGC subtype (OFF-sustained alpha-RGC, C42) (Hahn et al., 2023; Tran et al., 2019). Reference to the transcriptomic evidence is found at: GSE237215.\")\nAnnotationAssertion(terms:contributor obo:CL_0020036 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:date obo:CL_0020036 \"2025-12-08T11:40:49Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:id obo:CL_0020036 \"CL:9900001\")\nAnnotationAssertion(rdfs:label obo:CL_0020036 \"oRGC1\")\nAnnotationAssertion(Annotation(rdfs:label \"reference transcriptomic data on GEO\") rdfs:seeAlso obo:CL_0020036 \"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE237215\")\nSubClassOf(obo:CL_0020036 obo:CL_0000740)\n\n# Class: obo:CL_0020037 (superficial zone articular chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23015907\") Annotation(oboInOwl:hasDbXref \"PMID:23124445\") Annotation(oboInOwl:hasDbXref \"PMID:41226342\") obo:IAO_0000115 obo:CL_0020037 \"An articular chondrocyte located in the most superficial zone of articular cartilage, characterized by flattened morphology and tangential alignment parallel to the joint surface, and residing within a matrix of fine collagen fibrils and relatively low proteoglycan content. In mice and humans, this cell typically expresses lubricin (PRG4) and contributes to lubrication and resistance to shear and tensile forces at the cartilage surface.\")\nAnnotationAssertion(terms:contributor obo:CL_0020037 <https://orcid.org/0000-0003-0098-4399>)\nAnnotationAssertion(terms:date obo:CL_0020037 \"2026-02-18T11:06:13Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020037 \"superficial zone articular chondrocyte\")\nSubClassOf(obo:CL_0020037 obo:CL_1001607)\nSubClassOf(obo:CL_0020037 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013208))\n\n# Class: obo:CL_0020038 (middle zone articular chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23015907\") Annotation(oboInOwl:hasDbXref \"PMID:23124445\") Annotation(oboInOwl:hasDbXref \"PMID:41226342\") obo:IAO_0000115 obo:CL_0020038 \"An articular chondrocyte located in the middle (transitional) zone of articular cartilage, characterized by round morphology and relatively random spatial organization, and residing in a matrix enriched in proteoglycans and thicker collagen fibrils oriented obliquely to the articular surface. This cell contributes to the largest volume fraction of articular cartilage and functions primarily in distributing and absorbing compressive loads between the superficial and deep zones.\")\nAnnotationAssertion(terms:contributor obo:CL_0020038 <https://orcid.org/0000-0003-0098-4399>)\nAnnotationAssertion(terms:date obo:CL_0020038 \"2026-02-18T11:06:13Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23015907\") oboInOwl:hasRelatedSynonym obo:CL_0020038 \"transitional zone articular chondrocyte\")\nAnnotationAssertion(rdfs:label obo:CL_0020038 \"middle zone articular chondrocyte\")\nSubClassOf(obo:CL_0020038 obo:CL_1001607)\n\n# Class: obo:CL_0020039 (deep zone articular chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23015907\") Annotation(oboInOwl:hasDbXref \"PMID:23124445\") Annotation(oboInOwl:hasDbXref \"PMID:41226342\") obo:IAO_0000115 obo:CL_0020039 \"An articular chondrocyte located in the deep (radial) zone of articular cartilage, characterized by columnar arrangement perpendicular to the joint surface and residence within a matrix containing the highest proteoglycan concentration and large-diameter collagen fibrils oriented radially. In humans, this cell expresses collagen type X (COL10A1) and provides maximal resistance to compressive forces. It is positioned adjacent to the tidemark, where collagen fibrils extend into the calcified cartilage to anchor the articular cartilage to subchondral bone.\")\nAnnotationAssertion(terms:contributor obo:CL_0020039 <https://orcid.org/0000-0003-0098-4399>)\nAnnotationAssertion(terms:date obo:CL_0020039 \"2026-02-18T11:06:13Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23015907\") oboInOwl:hasRelatedSynonym obo:CL_0020039 \"radial zone articular chondrocyte\")\nAnnotationAssertion(rdfs:label obo:CL_0020039 \"deep zone articular chondrocyte\")\nSubClassOf(obo:CL_0020039 obo:CL_1001607)\nSubClassOf(obo:CL_0020039 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005693))\n\n# Class: obo:CL_0020040 (calcified zone articular chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18455690\") Annotation(oboInOwl:hasDbXref \"PMID:23015907\") Annotation(oboInOwl:hasDbXref \"PMID:41226342\") obo:IAO_0000115 obo:CL_0020040 \"An articular chondrocyte located in the calcified cartilage zone below the tidemark at the interface between articular cartilage and subchondral bone, embedded within a mineralized extracellular matrix. In humans, this cell exhibits a hypertrophic-like phenotype and typically expresses collagen type X (COL10A1). Together with the surrounding calcified matrix, it forms a transitional region that mechanically couples the deep articular cartilage to the underlying subchondral bone.\")\nAnnotationAssertion(terms:contributor obo:CL_0020040 <https://orcid.org/0000-0003-0098-4399>)\nAnnotationAssertion(terms:date obo:CL_0020040 \"2026-02-18T11:06:13Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020040 \"calcified zone articular chondrocyte\")\nSubClassOf(obo:CL_0020040 obo:CL_1001607)\nSubClassOf(obo:CL_0020040 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005693))\n\n# Class: obo:CL_0020041 (oRGC4)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020041 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together ON midget RGCs from primate foveal and peripheral retina with their molecularly homologous mouse alpha RGC subtype (ON-sustained α RGC, C43) (Hahn et al., 2023; Tran et al., 2019). Reference to the transcriptomic evidence is found at: GSE237215.\")\nAnnotationAssertion(terms:contributor obo:CL_0020041 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(oboInOwl:id obo:CL_0020041 \"CL:9900001\")\nAnnotationAssertion(rdfs:label obo:CL_0020041 \"oRGC4\")\nAnnotationAssertion(Annotation(rdfs:label \"reference transcriptomic data on GEO\") rdfs:seeAlso obo:CL_0020041 \"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE237215\")\nSubClassOf(obo:CL_0020041 obo:CL_0000740)\n\n# Class: obo:CL_0020042 (oRGC5)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020042 \"A conserved retinal ganglion cell orthotype whose transcriptomic profile groups together OFF parasol RGCs from primate foveal and peripheral retina with their molecularly homologous mouse α RGC subtype (OFF-transient α RGC, C45) (Hahn et al., 2023; Tran et al., 2019). Reference to transcriptomic evidence can be found at: GSE237215.\")\nAnnotationAssertion(terms:contributor obo:CL_0020042 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:date obo:CL_0020042 \"2025-12-08T11:46:13Z\"^^xsd:dateT