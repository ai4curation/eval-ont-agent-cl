"salivary acinar cell\")\n20516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24646566\") oboInOwl:hasExactSynonym obo:CL_0002623 \"salivary gland acinar cell\")\n20517:AnnotationAssertion(rdfs:label obo:CL_0002623 \"acinar cell of salivary gland\")\n20518:EquivalentClasses(obo:CL_0002623 ObjectIntersectionOf(obo:CL_0000622 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004809)))\n20519:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0002623 obo:CL_0000622)\n20520:SubClassOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0030141))\n20521:SubClassOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017156))\n20522:SubClassOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0045087))\n20523:SubClassOf(obo:CL_0002623 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0046541))\n20813:SubClassOf(obo:CL_0002654 obo:CL_0002252)\n20822:SubClassOf(obo:CL_0002655 obo:CL_0002252)\n20843:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0002657 obo:CL_0002252)\n22638:SubClassOf(obo:CL_0007000 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002077))\n23344:# Class: obo:CL_0009005 (salivary gland cell)\n23346:AnnotationAssertion(obo:IAO_0000115 obo:CL_0009005 \"Any cell in a salivary gland.\")\n23347:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0009005 \"GOC:pr\")\n23348:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0009005 \"http://en.wikipedia.org/wiki/Salivary_gland\")\n23349:AnnotationAssertion(rdfs:label obo:CL_0009005 \"salivary gland cell\")\n23350:SubClassOf(obo:CL_0009005 obo:CL_0000000)\n23351:SubClassOf(obo:CL_0009005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001044))\n27345:AnnotationAssertion(obo:IAO_0100001 obo:CL_1000402 obo:CL_0002252)\n29360:# Class: obo:CL_1001596 (salivary gland glandular cell)\n29362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"HPA:HPA\") Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001596 \"Glandular cell of salivary gland. Example: Serous cells, mucous