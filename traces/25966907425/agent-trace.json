{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"sed -n '25500,25570p' src/ontology/cl-edit.owl\"","aggregated_output":"# Class: obo:CL_0020006 (OB-Dopa-GABA)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35322231\") obo:IAO_0000115 obo:CL_0020006 \"A transcriptomically defined GABAergic neuron coexpressing dopamine located in the olfactory bulb and part of the striatum.\")\nAnnotationAssertion(terms:contributor obo:CL_0020006 \"https://orcid.org/0000-0002-5507-2103\")\nAnnotationAssertion(rdfs:label obo:CL_0020006 \"OB-Dopa-GABA\")\nSubClassOf(obo:CL_0020006 obo:CL_0000617)\nSubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\nSubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\nSubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n\n# Class: obo:CL_0020007 (dorso-striatal cholinergic-GABAergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_0020007 \"STRd Cholinergic GABA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:19855026\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37464873\") obo:IAO_0000115 obo:CL_0020007 \"A transcriptomically defined GABAergic neuron in the dorsal striatum. In mice and primates, it is defined by the coexpression of choline acetyltransferase (ChAT) together with the GABAergic markers glutamate decarboxylase 65 (GAD65/Gad2) and vesicular GABA transporter (VGAT/Slc32a1) (Lozovaya et al., 2018).\")\nAnnotationAssertion(terms:contributor obo:CL_0020007 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(terms:date obo:CL_0020007 \"2025-10-23T08:36:33Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020007 \"dorso-striatal cholinergic-GABAergic neuron\")\nSubClassOf(obo:CL_0020007 obo:CL_0000099)\nSubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\nSubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\nSubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n\n# Class: obo:CL_0020008 (striatal cholinergic-GABAergic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_0020008 \"STR Cholinergic GABA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:21925242\") Annotation(oboInOwl:hasDbXref \"PMID:2329464\") Annotation(oboInOwl:hasDbXref \"PMID:25374536\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") obo:IAO_0000115 obo:CL_0020008 \"A large aspiny interneuron of the striatum that serves as the principal intrinsic source of acetylcholine while simultaneously releasing GABA. It is defined by coexpression of cholinergic markers (ChAT and VAChT/Slc18a3) and GABAergic markers (GAD65/Gad2 and VGAT/Slc32a1) (Lozovaya et al., 2018). This MGE-derived neuron maintains Lhx6 expression associated with dual-transmitter identity (Fragkouli et al., 2009; Marin et al., 2000). Morphologically, it possesses a large soma (20–50 μm diameter), 2–4 thick aspiny dendrites extending radially ~1 mm, and locally ramified axons with hundreds of thousands of varicosities (Wilson et al., 1990; Lim et al., 2014).\")\nAnnotationAssertion(terms:contributor obo:CL_0020008 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") terms:description obo:CL_0020008 \"Although they constitute only 1–3% of all striatal neurons, these interneurons form a major modulatory hub, integrating cortical, thalamic, and dopaminergic inputs and shaping striatal output dynamics (Gonzales & Smith, 2015; Wegman et al., 2024). Electrophysiologically, the neuron exhibits tonic autonomous firing at 3–10 Hz, broad action potentials, and a prominent hyperpolarization-activated inward current (Ih) (Bennett & Wilson, 1999; Goldberg & Reynolds, 2011). Functionally, it modulates corticostriatal and thalamostriatal synaptic transmission, dopamine release, and spiny projection neuron excitability through co-transmission of acetylcholine and GABA (Lozovaya et al., 2018; Wegman et al., 2024). This dual inhibitory and modulatory signaling underlies context-dependent control of synaptic plasticity, action selection, and reinforcement learning (Gonzales & Smith, 2015; Lozovaya et al., 2018).\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020008 \"CGIN\")\nAnnotationAssertion(rdfs:label obo:CL_0020008 \"striatal cholinergic-GABAergic neuron\")\nSubClassOf(obo:CL_0020008 obo:CL_0000099)\nSubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\nSubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\nSubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n\n# Class: obo:CL_0020009 (prototypic neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_0020009 \"GPe SOX6-CTXND1 GABA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:27194328\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2022.03.16.484460\") obo:IAO_0000115 obo:CL_0020009 \"A GABAergic neuron located in the external globus pallidus (GPe) that constitutes approximately two-thirds of all GPe neurons (Mallet et al., 2012, Dodson et al., 2015). Derived from the medial ganglionic eminence, this cell selectively expresses Nkx2-1, with roughly two-thirds co-expressing parvalbumin (PV) and one-third lacking it in mice (Mallet et al., 2012; Dodson et al., 2015).\")\nAnnotationAssertion(terms:contributor obo:CL_0020009 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") terms:description obo:CL_0020009 \"The prototypic neuron projects to downstream basal ganglia nuclei, including the subthalamic nucleus (STN), internal globus pallidus, and substantia nigra pars reticulata (SNr), with some neurons also emitting ascending collaterals that modestly innervate the striatum (Mallet et al., 2012, Abdi et al., 2015). It exhibits longer local axon collaterals with more boutons compared to arkypallidal neurons, supporting extensive local interconnectivity within the GPe (Mallet et al., 2012). The prototypic neuron plays a fundamental role in the indirect pathway of the basal ganglia, coordinating activity across basal ganglia nuclei through its widespread projections (Mallet et al., 2012, Courtney et al., 2023). Decreases in firing during movement are consistent with disinhibiting the STN and output nuclei, thereby facilitating the expression of desired motor patterns (Dodson et al., 2015, Courtney et al., 2023).\")\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0020009 \"2025-10-17T09:12:54Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020009 \"prototypic neuron\")\nSubClassOf(obo:CL_0020009 obo:CL_0000617)\nSubClassOf(obo:CL_0020009 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002476))\nSubClassOf(obo:CL_0020009 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004024))\nSubClassOf(obo:CL_0020009 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011241))\n\n# Class: obo:CL_0020010 (arkypallidal neuron)\n\nAnnotationAssertion(obo:IAO_0000028 obo:CL_0020010 \"GPe MEIS2-SOX6 GABA\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:27194328\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") obo:IAO_0000115 obo:CL_0020010 \"A GABAergic projection neuron located in the external segment of the globus pallidus (GPe) and defined by its exclusive projection to the dorsal striatum rather than to the subthalamic nucleus or basal ganglia output nuclei. In rodents and primates, it is characterized molecularly by expression of FOXP2, MEIS2, and NPAS1, and lacks expression of canonical pallidal markers NKX2-1 and LHX6 (Dodson et al., 2015; Abdi et al., 2015; Courtney et al., 2023). This neuron is GABAergic (GAD1/2⁺, SLC32A1/VGAT⁺) and typically PV⁻, forming the transcriptionally and developmentally LGE-derived subclass of GPe neurons (Dodson et al., 2015; Mallet et al., 2012).\")\nAnnotationAssertion(terms:contributor obo:CL_0020010 <https://orcid.org/0000-0002-5507-2103>)\nAnnotationAssertion(oboInOwl:creation_date obo:CL_0020010 \"2025-10-16T10:21:41Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020010 \"arkypallidal neuron\")\nSubClassOf(obo:CL_0020010 obo:CL_0000617)\nSubClassOf(obo:CL_0020010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002476))\nSubClassOf(obo:CL_0020010 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0004025))\nSubClassOf(obo:CL_0020010 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n\n# Class: obo:CL_0020011 (hair follicle associated fibroblast)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20022473\") Annotation(oboInOwl:hasDbXref \"PMID:34297930\") obo:IAO_0000115 obo:CL_0020011 \"A specialized dermal fibroblast within the hair follicle mesenchymal compartment that participates in epithelial-mesenchymal signaling to regulate hair morphogenesis, cycling, and homeostasis through production of inductive signals and extracellular matrix maintenance.\")\nAnnotationAssertion(terms:contributor obo:CL_0020011 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_0020011 \"2025-11-04T15:29:55Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020011 \"hair follicle associated fibroblast\")\nEquivalentClasses(obo:CL_0020011 ObjectIntersectionOf(obo:CL_0002620 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0020011 obo:CL_0002620)\n\n# Class: obo:CL_0020012 (hair follicle isthmus-associated fibroblast)\n\n","exit_code":0,"status":"completed"}}
