{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '25580,25630p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34297930\") oboInOwl:hasRelatedSynonym obo:CL_0020013 \"DS fibroblast\")\nAnnotationAssertion(rdfs:label obo:CL_0020013 \"dermal sheath fibroblast\")\nSubClassOf(obo:CL_0020013 obo:CL_0000057)\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006936))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003675))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005694))\nSubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P16444))\n\n# Class: obo:CL_0020014 (intrinsically photosensitive retinal ganglion cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11834834\") Annotation(oboInOwl:hasDbXref \"PMID:20959623\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Intrinsically_photosensitive_retinal_ganglion_cell\") obo:IAO_0000115 obo:CL_0020014 \"A retinal ganglion cell that is intrinsically photosensitive, functioning as a non-image-forming photoreceptor, distinguished from rod and cone photoreceptors by the expression of the photopigment melanopsin in mice and humans (Hattar et al., 2002; Tri Hoang Do & Yau, 2015). Located primarily in the ganglion cell layer with some displaced somata in the inner nuclear layer, this neuron depolarises directly in response to environmental irradiance (Tri Hoang Do & Yau, 2015). It projects via the retinohypothalamic tract to central targets, including the suprachiasmatic nucleus (SCN) for circadian photoentrainment and the olivary pretectal nucleus (OPN) for the pupillary light reflex.\")\nAnnotationAssertion(dc:creator obo:CL_0020014 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020014 <https://orcid.org/0000-0003-2473-2313>)\nAnnotationAssertion(terms:contributor obo:CL_0020014 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://www.wikidata.org/entity/Q934475\") oboInOwl:hasBroadSynonym obo:CL_0020014 \"photosensitive ganglion cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20959623\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020014 \"ipRGC\")\nAnnotationAssertion(rdfs:label obo:CL_0020014 \"intrinsically photosensitive retinal ganglion cell\")\nSubClassOf(obo:CL_0020014 obo:CL_0000210)\nSubClassOf(obo:CL_0020014 obo:CL_0000740)\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\nSubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n\n# Class: obo:CL_0020015 (transitional principal-intercalated cell of kidney collecting duct)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33893305\") Annotation(oboInOwl:hasDbXref \"PMID:37468583\") obo:IAO_0000115 obo:CL_0020015 \"A transitional cell located in the renal collecting duct that co-expresses markers of both principal cell (PC) and intercalated cell (IC). This hybrid cell is enriched in Chronic Kidney Disease (CKD).\")\nAnnotationAssertion(dc:creator obo:CL_0020015 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0000-0002-2999-0103>)\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") oboInOwl:hasBroadSynonym obo:CL_0020015 \"hybrid principal-intercalated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020015 \"tPC-IC cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020015 \"transitional principal-intercalated cell of kidney collecting duct\")\nSubClassOf(obo:CL_0020015 obo:CL_1000454)\nSubClassOf(obo:CL_0020015 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232))\n\n# Class: obo:CL_0020016 (osteochondral skeletal stem cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")\nAnnotationAssertion(terms:contributor obo:CL_0020016 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020016 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020016 \"2025-11-27T00:00:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020016 \"ocSSC\")\nAnnotationAssertion(rdfs:label obo:CL_0020016 \"osteochondral skeletal stem cell\")\nSubClassOf(obo:CL_0020016 obo:CL_0000034)\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001434))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001649))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051216))\n\n# Class: obo:CL_0020017 (M0 macrophage)\n\n","exit_code":0,"status":"completed"}}
