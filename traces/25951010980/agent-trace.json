{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"rg -n 'PMID:40954253|PMID:37355216|PMID:38292899|PMID:32888429|PMID:34170401' src/ontology/cl-edit.owl\"","aggregated_output":"34222:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-020-0271-2\") Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-021-00561-y\") Annotation(oboInOwl:hasDbXref \"PMID:32152479\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4047038 \"A multipolar neuron in the myenteric plexus of the gastrointestinal tract, characterized by a small to medium-sized cell body and multiple short dendrites.  This neuron exhibits fast excitatory postsynaptic potentials and can be classified into stubby, spiny and hairy subtypes based on dendritic morphology. (Brehmer, 2021)\")\n35754:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900001 \"A sensory neuron of the enteric nervous system whose soma resides in the myenteric plexus and which functions as the afferent limb of intrinsic reflex circuits controlling motility, secretion, and blood flow. This neuron is characterized by Dogiel type II morphology, AH-type electrophysiology, and immunoreactivity for choline acetyltransferase but not neuronal nitric oxide synthase.\")\n35758:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900001 \"IPAN\")\n35759:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900001 \"myenteric sensory neuron\")\n35760:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900001 \"multiaxonal cholinergic myenteric sensory neuron\")\n35769:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32888429\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900002 \"An interneuron of the enteric nervous system whose soma resides in the myenteric plexus. Interneurons of the myenteric plexus integrate sensory input from intrinsic primary afferent neurons and modulate motor output to smooth muscle and secretory epithelia by synapsing onto motor neurons and other interneurons within the plexus.\")\n35773:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900002 \"enteric interneuron of myenteric plexus\")\n35781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32888429\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900003 \"An enteric neuron whose soma resides in the myenteric plexus and which controls mucosal secretion and blood flow by innervating secretory epithelia and submucosal blood vessels. This neuron is characterized by expression of vasoactive intestinal peptide.\")\n35785:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900003 \"PSVN\")\n35786:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32888429\") oboInOwl:hasExactSynonym obo:CL_9900003 \"VIP-positive secretomotor neuron\")\n35793:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:38292899\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900004 \"An enteric neuron whose soma resides in the myenteric plexus of the intestine and whose axon projects outside the gut wall to synapse on neurons in prevertebral sympathetic ganglia, including the celiac, superior mesenteric, and inferior mesenteric ganglia.\")\n35797:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") oboInOwl:hasExactSynonym obo:CL_9900004 \"viscerofugal neuron\")\n35798:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900004 \"VFN\")\n35799:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") oboInOwl:hasExactSynonym obo:CL_9900004 \"cholinergic viscerofugal neuron\")\n35806:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900005 \"An interneuron of the myenteric plexus whose axon projects orally along the gut axis. This neuron is immunopositive for choline acetyltransferase and enkephalin, and forms the excitatory limb of ascending reflex pathways that coordinate peristalsis.\")\n35810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900005 \"cholinergic enkephalinergic myenteric interneuron\")\n35811:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900005 \"ascending myenteric interneuron\")\n35818:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900006 \"An interneuron of the myenteric plexus whose axon projects aborally along the gut axis. This neuron class encompasses chemically diverse subtypes including serotonergic, nitrergic, and other populations, forming the inhibitory limb of descending reflex pathways.\")\n35822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900006 \"descending myenteric interneuron\")\n35828:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_9900007 \"A Dogiel type I neuron of the myenteric plexus characterized by stubby lamellar dendrite morphology with broad, flattened dendritic expansions. This neuron is immunopositive for choline acetyltransferase and immunonegative for neuronal nitric oxide synthase, corresponding to excitatory motor neurons of the enteric nervous system.\")\n35832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900007 \"stubby Dogiel I neuron\")\n35833:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900007 \"lamellar Dogiel type I neuron\")\n35843:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_9900008 \"A Dogiel type I neuron of the myenteric plexus characterized by spiny dendrite morphology with numerous short projections along the dendrites. This neuron is immunopositive for neuronal nitric oxide synthase and immunonegative for choline acetyltransferase, corresponding to inhibitory motor neurons of the enteric nervous system.\")\n35847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900008 \"spiny Dogiel I neuron\")\n35857:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900009 \"An intrinsic primary afferent neuron of the myenteric plexus characterized by Dogiel type II morphology, with a large, smooth, oval soma bearing multiple long axon-like processes that extend without branching until they reach targets in the myenteric and submucosal plexuses and the mucosa. This neuron is immunopositive for choline acetyltransferase and immunonegative for neuronal nitric oxide synthase, and exhibits AH-type electrophysiology.\")\n35861:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900009 \"type II myenteric neuron\")\n35862:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900009 \"multiaxonal myenteric sensory neuron\")\n35863:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900009 \"AH-type myenteric neuron\")\n35870:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900010 \"An intrinsic primary afferent neuron of the myenteric plexus that is immunopositive for calretinin. This neuron shares the Dogiel type II morphology and AH-type electrophysiology of myenteric intrinsic primary afferent neurons, and is immunopositive for choline acetyltransferase and immunonegative for neuronal nitric oxide synthase.\")\n35874:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900010 \"SN1\")\n35875:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900010 \"calretinin-positive myenteric sensory neuron\")\n35881:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_9900011 \"An intrinsic primary afferent neuron of the myenteric plexus that lacks calretinin expression. This neuron shares the Dogiel type II morphology and AH-type electrophysiology of myenteric intrinsic primary afferent neurons, and is immunopositive for choline acetyltransferase and immunonegative for neuronal nitric oxide synthase.\")\n35885:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_9900011 \"SN2\")\n35886:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900011 \"calretinin-negative myenteric sensory neuron\")\n35892:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_9900012 \"An enteric neuron whose soma resides in the myenteric plexus and which is capable of acetylcholine secretion, neurotransmission.\")\n35896:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900012 \"ChAT-positive myenteric neuron\")\n35903:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_9900013 \"An enteric neuron whose soma resides in the myenteric plexus and which is capable of nitric oxide biosynthetic process.\")\n35907:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900013 \"NOS1-positive myenteric neuron\")\n35908:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasExactSynonym obo:CL_9900013 \"nNOS-positive myenteric neuron\")\n35914:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_9900014 \"A neuron characterized by Dogiel type II morphology, with a large, smooth, oval soma bearing multiple long axon-like processes that extend without branching until they reach their targets. The soma lacks the short lamellar or spiny dendrites characteristic of Dogiel type I neurons. In the enteric nervous system, Dogiel type II neurons correspond to intrinsic primary afferent neurons and exhibit AH-type electrophysiology.\")\n35918:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900014 \"type II enteric neuron\")\n35919:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900014 \"multiaxonal enteric neuron\")\n35920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasExactSynonym obo:CL_9900014 \"AH neuron\")\n35921:Annotation