{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'rg -n \"RO_0002292|RO_0002293|lacks\" src/ontology/cl-edit.owl'","aggregated_output":"3537:Declaration(ObjectProperty(obo:RO_0002292))\n3711:# Object Property: obo:CL_4030045 (lacks_part)\n3714:AnnotationAssertion(rdfs:label obo:CL_4030045 \"lacks_part\")\n3716:# Object Property: obo:CL_4030046 (lacks_plasma_membrane_part)\n3719:AnnotationAssertion(rdfs:label obo:CL_4030046 \"lacks_plasma_membrane_part\")\n5949:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000225 \"A cell that lacks a nucleus.\")\n8419:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:1638021\") obo:IAO_0000115 obo:CL_0000547 \"An immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.\")\n8441:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000549 \"A nucleated immature erythrocyte, having cytoplasm generally similar to that of the earlier proerythroblast but sometimes even more basophilic, and usually regular in outline. The nucleus is still relatively large, but the chromatin strands are thicker and more deeply staining, giving a coarser appearance; the nucleoli have disappeared. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\n8454:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000550 \"A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely basophilic, but takes on acidophilic aspects, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\n8488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000553 \"The earliest cytologically identifiable precursor in the thrombocytic series. This cell is capable of endomitosis and lacks expression of hematopoieitic lineage markers (lin-negative).\")\n8623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") obo:IAO_0000115 obo:CL_0000564 \"A promyelocyte committed to the neutrophil lineage. This cell type is GATA-1-positive, C/EBPa-positive, AML-1-positive, MPO-positive, has low expression of PU.1 transcription factor and lacks lactotransferrin expression.\")\n9074:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000613 \"A progenitor cell committed to the basophil lineage. This cell lacks hematopoietic lineage markers (lin-negative) and is CD34-positive, T1/ST2-low, CD117-negative, and FceRIa-high. This cell also expresses Gata-1, Gata-2 and C/EBPa.\")\n9195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") obo:IAO_0000115 obo:CL_0000626 \"A granule cell that has a soma located in an olfactory bulb granule cell layer. An olfactory granule cell is an interneuron that lacks an axon, makes reciprocal dendro-dendritic synapses with mitral cells and tufted cells and is involved in the fine spatio-temporal tuning of the responses of these principal olfactory bulb neurons to odors.\")\n9427:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"ISBN:0815332181\") Annotation(oboInOwl:hasDbXref \"PMID:21860392\") Annotation(oboInOwl:hasDbXref \"PMID:32097634\") Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Spinous_cell\") obo:IAO_0000115 obo:CL_0000649 \"A keratinocyte found within the stratum spinosum (prickle cell layer) of the epidermis, distinguished by numerous intercellular desmosomes, which give it a “prickly” or spiny appearance. Positioned above the mitotically active basal layer and beneath the granular layer, it contributes to the skin’s mechanical strength and barrier function, preventing water loss and pathogen entry. This cell expresses differentiation-specific keratins K1 and K10 in mice, unlike basal cells that express K5 and K14, and lacks the keratohyalin granules found in granular cells, marking its intermediate stage of epidermal differentiation.\")\n10199:SubClassOf(obo:CL_0000743 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005693))\n10299:EquivalentClasses(Annotation(oboInOwl:hasDbXref \"PMID:27565351\") obo:CL_0000754 ObjectIntersectionOf(obo:CL_0000748 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P50481) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8R4I7) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9ER75)))\n10403:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18174176\") obo:IAO_0000115 obo:CL_0000765 \"A nucleated precursor of an erythrocyte that lacks hematopoietic lineage markers.\")\n12414:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:17100874\") obo:IAO_0000115 obo:CL_0000937 \"Cell committed to natural killer cell lineage that has the phenotype CD122-positive, CD34-positive, and CD117-positive. This cell type lacks expression of natural killer receptor proteins.\")\n12596:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:18432934\") Annotation(oboInOwl:hasDbXref \"PMID:20839338\") Annotation(oboInOwl:hasDbXref \"PMID:9785673\") obo:IAO_0000115 obo:CL_0000956 \"A pre-B-I cell is a precursor B cell that expresses CD34 and surrogate immunoglobulin light chain (VpreB , Lambda 5 (mouse)/14.1 (human)) on the cell surface, and TdT, Rag1,and Rag2 intracellularly. Cell type carries a D-JH DNA rearrangement, and lacks expression of immunglobulin heavy chain protein.\")\n13335:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:17922016\") Annotation(oboInOwl:hasDbXref \"PMID:19286519\") obo:IAO_0000115 obo:CL_0001029 \"Common dendritic precursor is a hematopoietic progenitor cell that is CD117-low, CD135-positive, CD115-positive and lacks plasma membrane parts for hematopoietic lineage markers.\")\n13567:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0001053 \"A memory B cell that lacks expression of surface IgD.\")\n13637:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001060 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities. Cell lacks hematopoeitic lineage markers.\")\n13697:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMID:23292121\") Annotation(oboInOwl:hasDbXref \"PMID:23348417\") obo:IAO_0000115 obo:CL_0001065 \"A lymphocyte that lacks characteristic T cell, B cell, myeloid cell, and dendritic cell markers, that functions as part of the innate immune response to produce cytokines and other effector responses.\")\n13705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0001066 \"A progenitor cell committed to the erythroid lineage. This cell is ter119-positive but lacks expression of other hematopoietic lineage markers (lin-negative).\")\n14276:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0002032 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities.\")\n14936:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002087 \"A leukocyte that lacks granules.\")\n15193:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002107 \"An IgD-negative CD38-positive IgG memory B cell is a CD38-positive IgG-positive that has class switched and lacks expression of IgD on the cell surface with the phenotype IgD-negative, CD38-positive, and IgG-positive.\")\n15288:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002117 \"A class switched memory B cell that lacks IgG on the cell surface.\")\n15303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002118 \"A CD38-negative IgG-negative memory B cell is a IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype CD38-negative and IgG-negative.\")\n15310:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002119 \"A CD38-positive IgG-negative memory B cell is an IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype CD38-positive and IgG-negative.\")\n15317:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002120 \"An CD24-positive CD38-negative IgG-negative memory B cell is a CD38-negative IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype CD24-positive, CD38-negative, and IgG-negative.\")\n15324:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002121 \"A CD24-negative CD38-negative IgG-negative memory B cell is a CD38-negative IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype CD24-negative, CD38-negative, and IgG-negative.\")\n15331:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002122 \"A B220-positive CD38-positive IgG-negative memory B cell is a CD38-positive IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype B220-positive, CD38-positive, and IgG-negative.\")\n15338:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:rhs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20123131\") obo:IAO_0000115 obo:CL_0002123 \"A B220-low CD38-positive IgG-negative memory B cell is a CD38-positive IgG-negative class switched memory B cell that lacks IgG on the cell surface with the phenotype B220-low, CD38-positive, and IgG-positive.\")\n15663:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0002153 \"The dead keratin-filled squamous cell of the stratum corneum. This cell type lacks a nucleus.\")\n15737:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:5686391\") obo:IAO_0000115 obo:CL_0002161 \"A cell type found on the superficial layer of the external side of the tympanic membrane. This cell-type lacks a nucleus.\")\n16077:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0323052908\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Myelocyte\") obo:IAO_0000115 obo:CL_0002193 \"A cell type that is the first of the maturation stages of the granulocytic leukocytes normally found in the bone marrow. Granules are seen in the cytoplasm. The nuclear material of the myelocyte is denser than that of the myeloblast but lacks a definable membrane. The cell is flat and contains increasing numbers of granules as maturation progresses.\")\n16440:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002226 \"A secondary lens fiber cell that lacks a nucleus.\")\n16644:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:068340007X\") obo:IAO_0000115 obo:CL_0002245 \"OBSOLETE: A lymphocyte that lacks T or B cell surface markers.\")\n17623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002329 \"An epithelial cell type that lacks the columnar shape typical for other respiratory epithelial cells. This cell type is able to differentiate into other respiratory epithelial cells in response to injury.\")\n17703:AnnotationAssertion(rdfs:comment obo:CL_0002338 \"Human markers; killer cell immunoglobulin-like receptor 2DL1 is used as a representative example (PRO at this time lacks a KIR superfamily).\")\n17729:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2673349\") obo:IAO_0000115 obo:CL_0002341 \"An undifferentiated cell of the prostate epithelium that lacks secretory activity.\")\n17761:AnnotationAssertion(rdfs:comment obo:CL_0002344 \"Human markers; killer cell immunoglobulin-like receptor 2DL1 is used as a representative example (PRO at this time lacks a KIR superfamily).\")\n18079:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15580626\") Annotation(oboInOwl:hasDbXref \"PMID:30971890\") Annotation(oboInOwl:hasDbXref \"PMID:35815410\") obo:IAO_0000115 obo:CL_0002375 \"A multipotent progenitor cell that develops from a migratory neural crest cell. The schwann cell precursor is embedded among axons, with minimal extracellular space separating them from nerve cell membranes. This cell lacks a basal lamina, which distinguishes it from more mature Schwann cells. In rodents, cadherin-19 (Cdh19) serves as a specific marker for this developmental stage.\")\n19025:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002469 \"Gr1-high monocyte that lacks MHC-II receptor complex.\")\n19045:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.immgen.org/index_content.html\") obo:IAO_0000115 obo:CL_0002471 \"Gr1-low non-classical monocyte that lacks expression of a MHC-II complex.\")\n19216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0002407\") obo:IAO_0000115 obo:CL_0002489 \"A thymocyte that lacks expression of CD4 and CD8.\")\n20670:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002643 \"An epithelial cell of stratum corneum of esophageal epithelium that lacks keratin.\")\n20917:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") Annotation(oboInOwl:hasDbXref \"PMID:19277783\") Annotation(oboInOwl:hasDbXref \"PMID:33193034\") obo:IAO_0000115 obo:CL_0002668 \"A spiral ligament fibrocyte that is located in the triangular space inferior to the crista basilaris (basilar crest). This cell is spindle-shaped and expresses NKCC1 but minimal to no Na,K-ATPase (ATP1A1, ATP1B1) in mice and humans, and lacks connexin 26/30 in mice, indicating it does not participate in K⁺ recycling, unlike type II fibrocytes. Type IV fibrocyte is uniquely characterised by strong expression of connective tissue growth factor (CTGF) in mice, suggesting roles in tissue remodelling and paracrine signalling to other cochlear cells.\")\n21032:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20023630\") obo:IAO_0000115 obo:CL_0002679 \"A lymphocyte found in adipose tissue that lacks lineage markers of other lymphocytes but is capable of mediating TH2 cytokine responses. This cell type is found in fat associated lymphoid clusters, proliferates in response to IL2 and produce large amounts of TH2 cytokines such as IL5, IL6 and IL13\")\n21484:SubClassOf(obo:CL_0003035 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n23054:SubClassOf(obo:CL_0008032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005110))\n23055:SubClassOf(obo:CL_0008032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007785))\n23056:SubClassOf(obo:CL_0008032 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011467))\n25164:SubClassOf(obo:CL_0017009 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_O43699))\n25165:SubClassOf(obo:CL_0017009 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P30530))\n25461:SubClassOf(obo:CL_0020003 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n25472:SubClassOf(obo:CL_0020004 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015665))\n25529:SubClassOf(obo:CL_0020009 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000011241))\n25534:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22726837\") Annotation(oboInOwl:hasDbXref \"PMID:25843402\") Annotation(oboInOwl:hasDbXref \"PMID:25926446\") Annotation(oboInOwl:hasDbXref \"PMID:27194328\") Annotation(oboInOwl:hasDbXref \"PMID:37336974\") obo:IAO_0000115 obo:CL_0020010 \"A GABAergic projection neuron located in the external segment of the globus pallidus (GPe) and defined by its exclusive projection to the dorsal striatum rather than to the subthalamic nucleus or basal ganglia output nuclei. In rodents and primates, it is characterized molecularly by expression of FOXP2, MEIS2, and NPAS1, and lacks expression of canonical pallidal markers NKX2-1 and LHX6 (Dodson et al., 2015; Abdi et al., 2015; Courtney et al., 2023). This neuron is GABAergic (GAD1/2⁺, SLC32A1/VGAT⁺) and typically PV⁻, forming the transcriptionally and developmentally LGE-derived subclass of GPe neurons (Dodson et al., 2015; Mallet et al., 2012).\")\n25568:SubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003675))\n25569:SubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005694))\n25570:SubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P16444))\n25584:SubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000001243))\n25600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")\n25633:SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n25634:SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007498))\n25733:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020027 \"An alpha retinal ganglion cell subtype in the mouse retina that responds selectively and transiently to increases in light intensity. It possesses the large soma and expansive dendritic field characteristic of alpha RGCs (Krieger et al., 2017). This cell exhibits a brief, fast-decaying burst of firing at the onset of light increments and contributes to motion detection for luminance increases, forming the ON-branch of the transient magnocellular-like pathway (Krieger et al., 2017; Hahn et al., 2023). Functionally, it corresponds to cluster G19 and aligns transcriptomically with cluster C41 (Krieger et al., 2017; Tran et al., 2019). It is orthologous to the primate ON Parasol RGC (Hahn et al., 2023). Molecularly, it expresses Spp1, Smi32, and Brn3b, but lacks Brn3a, Brn3c, and Calbindin (Krieger et al., 2017).\")\n26204:SubClassOf(obo:CL_1000308 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013031))\n30019:SubClassOf(obo:CL_2000096 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q15063))\n30169:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n30206:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005460))\n30216:EquivalentClasses(obo:CL_4023011 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148)))\n30253:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n30263:EquivalentClasses(obo:CL_4023015 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325)))\n30265:SubClassOf(obo:CL_4023015 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325))\n30283:EquivalentClasses(obo:CL_4023016 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000017299)))\n30287:SubClassOf(obo:CL_4023016 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000017299))\n30300:EquivalentClasses(obo:CL_4023017 ObjectIntersectionOf(obo:CL_4023069 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015665)))\n30317:SubClassOf(obo:CL_4023018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000013502))\n30326:EquivalentClasses(obo:CL_4023019 ObjectIntersectionOf(obo:CL_4023071 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648)))\n30355:SubClassOf(obo:CL