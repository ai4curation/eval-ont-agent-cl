"clusterid\":\"\"},{\"name\":\"Julia V\",\"authtype\":\"Author\",\"clusterid\":\"\"},{\"name\":\"Hacini-Rachinel F\",\"authtype\":\"Author\",\"clusterid\":\"\"},{\"name\":\"Kabashima K\",\"authtype\":\"Author\",\"clusterid\":\"\"},{\"name\":\"Ginhoux F\",\"authtype\":\"Author\",\"clusterid\":\"\"}],\"lastauthor\":\"Ginhoux F\",\"title\":\"Single-cell analysis of human skin identifies CD14+ type 3 dendritic cells co-producing IL1B and IL23A in psoriasis.\",\"sorttitle\":\"single cell analysis of human skin identifies cd14 type 3 dendritic cells co producing il1b and il23a in psoriasis\",\"volume\":\"218\",\"issue\":\"9\",\"pages\":\"\",\"lang\":[\"eng\"],\"nlmuniqueid\":\"2985109R\",\"issn\":\"0022-1007\",\"essn\":\"1540-9538\",\"pubtype\":[\"Journal Article\",\"Research Support, Non-U.S. Gov't\"],\"recordstatus\":\"PubMed - indexed for MEDLINE\",\"pubstatus\":\"256\",\"articleids\":[{\"idtype\":\"pubmed\",\"idtypen\":1,\"value\":\"34279540\"},{\"idtype\":\"pmc\",\"idtypen\":8,\"value\":\"PMC8292131\"},{\"idtype\":\"pmcid\",\"idtypen\":5,\"value\":\"pmc-id: PMC8292131;\"},{\"idtype\":\"doi\",\"idtypen\":3,\"value\":\"10.1084/jem.20202345\"},{\"idtype\":\"pii\",\"idtypen\":4,\"value\":\"212481\"}],\"history\":[{\"pubstatus\":\"received\",\"date\":\"2020/11/04 00:00\"},{\"pubstatus\":\"revised\",\"date\":\"2021/04/03 00:00\"},{\"pubstatus\":\"accepted\",\"date\":\"2021/06/15 00:00\"},{\"pubstatus\":\"entrez\",\"date\":\"2021/07/19 12:54\"},{\"pubstatus\":\"pubmed\",\"date\":\"2021/07/20 06:00\"},{\"pubstatus\":\"medline\",\"date\":\"2021/11/25 06:00\"},{\"pubstatus\":\"pmc-release\",\"date\":\"2022/03/06 00:00\"}],\"references\":[],\"attributes\":[\"Has Abstract\"],\"pmcrefcount\":55,\"fulljournalname\":\"The Journal of experimental medicine\",\"elocationid\":\"doi: 10.1084/jem.20202345\",\"doctype\":\"citation\",\"srccontriblist\":[],\"booktitle\":\"\",\"medium\":\"\",\"edition\":\"\",\"publisherlocation\":\"\",\"publishername\":\"\",\"srcdate\":\"\",\"reportnumber\":