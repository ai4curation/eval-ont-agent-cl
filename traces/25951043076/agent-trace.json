000115 obo:CL_0000784 \"A dendritic cell type of distinct morphology, localization, and surface marker expression (CD123-positive) from other dendritic cell types and associated with early stage immune responses, particularly the release of physiologically abundant amounts of type I interferons in response to infection.\")\n10614:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000784 \"BTO:0004625\")\n10615:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"DC2\")\n10616:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"IPC\")\n10617:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"T-associated plasma cell\")\n10618:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"interferon-producing cell\")\n10619:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"lymphoid dendritic cell\")\n10620:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"pDC\")\n10621:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"plasmacytoid T cell\")\n10622:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"plasmacytoid monocyte\")\n10623:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000784 \"type 2 DC\")\n10631:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000785 \"A B cell that is mature, having left the bone marrow. Initially, these cells are IgM-positive and IgD-positive, and they can be activated by antigen.\")\n10632:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000785 \"mature B lymphocyte\")\n10633:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000785 \"mature B-cell\")\n10634:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000785 \"mature B-lymphocyte\")\n10646:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXr