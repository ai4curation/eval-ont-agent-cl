")\n29642:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31049600\") oboInOwl:hasExactSynonym obo:CL_2000060 \"vCTB\")\n29643:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_2000060 \"villous cytotrophoblast\")\n29647:AnnotationAssertion(rdfs:seeAlso obo:CL_2000060 \"http://www.sciencellonline.com/site/productInformation.php?keyword=7120\")\n29652:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000061 \"Any mesenchymal stem cell that is part of a placenta.\")\n29662:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000062 \"Any capillary endothelial cell that is part of a placenta.\")\n29672:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000063 \"Any fibroblast that is part of a female gonad.\")\n29682:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:12052228\") Annotation(oboInOwl:hasDbXref \"PMID:15749958\") Annotation(oboInOwl:hasDbXref \"PMID:23467088\") Annotation(oboInOwl:hasDbXref \"PMID:31672973\") Annotation(oboInOwl:hasDbXref \"PMID:36205477\") obo:IAO_0000115 obo:CL_2000064 \"A meso-epithelial cell of the ovarian surface epithelium, varying in shape from flat to cuboidal to pseudostratified columnar. This cell plays a crucial role in ovulation by producing proteolytic enzymes in response to gonadotropins, facilitating follicle rupture through tissue breakdown and TNF-alpha signaling. Additionally, this cell contributes to post-ovulatory wound repair (Morris et al., 2022) and exhibits stem cell-like properties (Flesken-Nikitin et al., 2013; Wang et al., 2019).\")\n29691:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000065 \"Any microvascular endothelial cell that is part of a female urethra.\")\n29701:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000066 \"Any fibroblast that is part of a cardiac ventricle.\")\n29711:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000067 \"Any fibroblast that is part of a cardiac atrium.\")\n29721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000068 \"Any fibroblast that is part of a pericardium.\")\n29731:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000069 \"Any fibroblast that is part of a gallbladder.\")\n29741:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000070 \"Any fibroblast that is part of a optic choroid.\")\n29751:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000071 \"Any microvascular endothelial cell that is part of a breast.\")\n29761:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000072 \"Any microvascular endothelial cell that is part of a adipose tissue.\")\n29771:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000073 \"Any migratory neural crest cell that is part of a cardiac neural crest.\")\n29774:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33060096\") oboInOwl:hasExactSynonym obo:CL_2000073 \"cardiac neural crest cell\")\n29781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000074 \"Any leukocyte that is part of a spleen.\")\n29791:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000075 \"Any endodermal cell that is part of a anterior visceral endoderm.\")\n29800:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000076 \"Any vein endothelial cell that is part of a hindlimb stylopod.\")\n29809:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000077 \"Any striated muscle cell that is part of a skeletal muscle tissue of pectoralis major.\")\n29818:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000078 \"Any pericyte cell that is part of a placenta.\")\n29827:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000079 \"Any mesenchymal stem cell of the bone marrow that is part of a femur.\")\n29836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000080 \"Any mesenchymal stem cell of adipose tissue that is part of an abdomen.\")\n29839:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_2000080 \"mesenchymal stem cell of abdominal adipose\")\n29846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000081 \"Any melanocyte of skin that is part of a skin of face.\")\n29855:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000082 \"OBSOLETE. Any melanocyte of skin that is part of a skin of prepuce of penis.\")\n29867:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000083 \"Any hair follicle dermal papilla cell that is part of a scalp.\")\n29876:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:27091323\") Annotation(oboInOwl:hasDbXref \"PMID:28475124\") Annotation(oboInOwl:hasDbXref \"PMID:31734511\") obo:IAO_0000115 obo:CL_2000084 \"A goblet cell that is part of the conjunctival epithelium, characterized by apical accumulation of mucin granules (containing MUC5AC in humans; Muc5ac/Muc5b in mice). These gel-forming mucins support tear film stability, ocular lubrication, and pathogen defence. The conjunctival goblet cell forms tight junctions with neighbouring epithelial cells via species-specific claudins (claudin-10 in humans, claudin-2 in mice) and regulates immune homeostasis by facilitating soluble antigen transport to dendritic cells through goblet cell-associated antigen passages (GAPs) (Barbosa et al., 2017). The transcription factor SPDEF is essential for its differentiation.\")\n29879:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31734511\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_2000084 \"CGC\")\n29885:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000085 \"Any mononuclear cell that is part of a umbilical cord.\")\n29894:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000086 \"Any basket cell that is part of a neocortex.\")\n29903:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000087 \"Any basket cell that is part of a dentate gyrus of hippocampal formation.\")\n29912:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000088 \"Any basket cell that is part of a Ammon's horn.\")\n29921:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:17765709\") obo:IAO_0000115 obo:CL_2000089 \"A granule cell that has soma location in the dentate gyrus cell layer of the hippocampal formation and has an elliptical cell body and characteristic cone-shaped tree of spiny apical dendrites. The branches extend throughout the molecular layer and the distal tips of the dendritic tree end just at the hippocampal fissure or at the ventricular surface. The dentate gyrus granule cell is the principal cell type of the dentate gyrus.\")\n29924:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_2000089 \"dentate gyrus of hippocampal formation granule cell\")\n29926:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17765709\") rdfs:comment obo:CL_2000089 \"As far as can be determined, all dentate granule cells appear to project to CA3 and the axon trajectory is partially correlated with the position of the parent cell body.\")\n29932:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000090 \"Any stellate cell that is part of a dentate gyrus of hippocampal formation.\")\n29941:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000091 \"Any microvascular endothelial cell that is part of a endometrial blood vessel.\")\n29950:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000092 \"Any keratinocyte that is part of a hair follicle.\")\n29959:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000093 \"Any fibroblast of lung that is part of a bronchus.\")\n29968:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000094 \"Any epithelial cell of viscerocranial mucosa that is part of a nasal cavity respiratory epithelium.\")\n29977:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000095 \"Any hematopoietic stem cell that is part of a umbilical cord blood.\")\n29986:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") Annotation(oboInOwl:hasDbXref \"PMID:29266210\") Annotation(oboInOwl:hasDbXref \"PMID:35212000\") Annotation(oboInOwl:hasDbXref \"PMID:36232952\") Annotation(oboInOwl:hasDbXref \"PMID:37646029\") obo:IAO_0000115 obo:CL_2000096 \"A fibroblast of dermis that resides in the deep reticular layer, characterised by robust extracellular matrix production with high type I collagen deposition forming densely packed, organised fibrillar networks (Ghetti et al., 2018). This cell exhibits pro-fibrotic properties during wound healing, entering wounds early where it proliferates and deposits collagen to restore dermal architecture (Knoedler et al., 2023; McAndrews et al., 2022). It is distinguished from papillary dermal fibroblasts by expression of COL11A1, POSTN, and SPP1 in humans (Wu et al., 2022).\")\n29990:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29266210\") oboInOwl:hasRelatedSynonym obo:CL_2000096 \"reticular fibroblast\")\n30000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000097 \"Any dopaminergic neuron that is part of a midbrain.\")\n30009:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:29802404\") obo:IAO_0000115 obo:CL_3000000 \"A ciliated epithelial cell of the esophagus.\")\n30019:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:30498493\") Annotation(oboInOwl:hasDbXref \"PMID:34745147\") Annotation(oboInOwl:hasDbXref \"PMID:35438172\") obo:IAO_0000115 obo:CL_3000001 \"A tissue-resident macrophage that is part of the placenta. A Hofbauer cell expresses high levels of growth factors and metalloproteinases that support vasculogenesis, angiogenesis, branching morphogenesis and tissue remodeling. A Hofbauer cell has a fetal origin, is found in the villous stroma, chorion, and amnion, and is present throughout pregnancy.\")\n30023:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") oboInOwl:hasExactSynonym obo:CL_3000001 \"fetal Hofbauer cell\")\n30024:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:39007150\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_3000001 \"HBC\")\n30026:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30498493\") rdfs:comment obo:CL_3000001 \"Hofbauer cells are a heterogenic group of macrophages that resemble M2-like cells. Initially described in chorionic villi in humans, a Hofbauer cell is now often used to describe any fetal-derived placental macrophage that resides within the placental villous core, amnion, and chorion laeve.\")\n30032:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_3000002 \"Sympathetic noradrenergic neuron.\")\n30041:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_3000003 \"A type of autonomic neuron that releases acetylcholine.\")\n30050:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CellBLAST\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:31554486\") Annotation(oboInOwl:hasDbXref \"PMID:35858549\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Sensory_neuron\") Annotation(oboInOwl:hasDbXref \"https://www.britannica.com/science/sensory-neuron\") Annotation(oboInOwl:hasDbXref \"https://www.ncbi.nlm.nih.gov/books/NBK539846/\") obo:IAO_0000115 obo:CL_3000004 \"A neuron type that is located in a peripheral nervous system and it transmits sensory information from the peripheral (PNS) to the central nervous system (CNS). A sensory neuron converts physical (light, sound, touch) or chemical (such as taste and smell) stimuli into an electrical signal through a process known as sensory transduction. The function of a sensory neuron is to carry informations from the external environment and internal body conditions to the central nervous system for further processing.\")\n30054:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Sensory_neuron\") rdfs:comment obo:CL_3000004 \"Typically, a sensory neuron has a pseudounipolar morphology.\")\n30060:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006000 \"A fibroblast that is part of the breast.\")\n30062:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006000 \"breast fibroblast\")\n30069:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006001 \"A fibroblast that is part of the skin of scalp.\")\n30071:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006001 \"skin of scalp fibroblast\")\n30078:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023000 \"A motor neuron that innervates both intrafusal and extrafusal muscle fibers. Low abundancy. They control both muscle contraction and responsiveness of the sensory feedback from muscle spindles.\")\n30087:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023001 \"A beta motor neuron that innervates nuclear chain fibers.\")\n30094:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25346659\") obo:IAO_0000115 obo:CL_4023002 \"A beta motor neuron that innervates the nuclear bag fibers of muscle spindles.\")\n30101:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023003 \"A type of intrafusal muscle fiber that has nuclei arranged in a linear row. Unlike nuclear bag fibers, the equatorial region of these fibers (in the centre of the spindle) is not expanded. These fibers are responsible for the detection of changes in muscle length. They are innervated by static gamma motor neurons and are principally associated with type II sensory fibers.\")\n30108:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") obo:IAO_0000115 obo:CL_4023004 \"A type of intrafusal muscle fiber that lies in the center of a muscle spindle. Nuclei are clustered centrally and give the equatorial region a swollen appearance. They are associated with associated with dynamic gamma motor neurons, and the stretching of the equatorial region of the nuclear bag fibers results in an increase in the firing rate of type Ia sensory fibers.\")\n30115:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023005 \"A nuclear bag fiber that is sensitive mainly to the rate of change in muscle length.\")\n30117:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"bag1 fiber\")\n30118:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023005 \"nuclear bag1 intrafusal fiber\")\n30124:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-323-39632-5.00024-4\") obo:IAO_0000115 obo:CL_4023006 \"A nuclear bag fiber that is sensitive only changes in muscle length but not the rate of that change.\")\n30126:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"bag2 fiber\")\n30127:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023006 \"nuclear bag2 intrafusal fiber\")\n30133:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023007 \"L2/3 bipolar VIP interneuron (Mus)\")\n30134:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") obo:IAO_0000115 obo:CL_4023007 \"A VIP GABAergic cortical interneuron with bipolar morphology, with a soma found in L2/3. L2/3 bipolar VIP cells have extending axons across all layers (with preferences for layers II/III and Va) and a dendritic tree that is vertically more restricted than deeper layer VIP cells and extend fewer dendrites into the layers outside their home layer (location of soma). L2/3 bipolar VIP cells have great variability in firing patterns, though most are continuous adapting. L2/3 bipolar VIP cells are more depolarized in their resting state, had less fast rectification, and had smaller after hyperpolarization than deeper VIP cells.\")\n30136:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023007 \"L2/3 bipolar Vip (Mus musculus)\")\n30137:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023007 cl:BDS_subset)\n30149:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023008 \"IT neuron\")\n30150:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") obo:IAO_0000115 obo:CL_4023008 \"A glutamatergic neuron located in the cerebral cortex that projects to structures of telencephalic origins.\")\n30152:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023008 \"ILX:0770100\")\n30153:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41467-021-24565-z\") oboInOwl:hasExactSynonym obo:CL_4023008 \"IT neuron\")\n30154:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023008 cl:BDS_subset)\n30160:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023009 \"ET glut\")\n30161:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023009 \"A glutamatergic neuron located in the cerebral cortex that projects to structures not derived from telencephalon.\")\n30163:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023009 \"ILX:0770101\")\n30164:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023009 \"ET projecting neuron\")\n30165:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023009 cl:BDS_subset)\n30171:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023010 \"A7 interneuron\")\n30172:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023010 \"A GABAergic cortical interneuron that is strongly labelled for α7 nAChRs. These cells have soma found in L1 and have multipolar dendrites with vertically descending axonal collaterals that project deep into the column, usually branching and terminating in L5A.\")\n30174:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023010 \"A7 cell (Mus musculus)\")\n30175:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023010 cl:BDS_subset)\n30176:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:30413647\") Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023010 \"Unlike typical Lamp5 electrophysiology, A7 cells have Vip- and Sst-like firing properties, with active depolarizing hump at near-threshold membrane potentials, and  larger hyperpolarization sag, stronger burst, and rebound firing. A7 cells have a transcriptomics signature that looks like Lamp5 GABAergic interneuron.\")\n30186:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023011 \"Lamp5 interneuron\")\n30187:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023011 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Lamp5.\")\n30189:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023011 \"ILX:0770149\")\n30190:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023011 cl:BDS_subset)\n30198:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023012 \"NP glut neuron\")\n30199:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023012 \"A glutamatergic neuron located in the cerebral cortex that projects axons locally rather than distantly.\")\n30201:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023012 \"ILX:0770103\")\n30202:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023012 \"NP neuron\")\n30203:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023012 cl:BDS_subset)\n30209:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023013 \"CT glut\")\n30210:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") obo:IAO_0000115 obo:CL_4023013 \"A glutamatergic neuron located in the cerebral cortex that projects to the thalamus.\")\n30212:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023013 \"CT projecting neuron\")\n30213:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023013 cl:BDS_subset)\n30219:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023014 \"L5 VIP interneuron (Mus)\")\n30220:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:26612957\") obo:IAO_0000115 obo:CL_4023014 \"A VIP GABAergic cortical interneuron with a soma found in L5. L5 VIP cells have mostly local morphology with some deep-projecting axons. They show only moderate resistance, comparable to that of sst subclass and unlike typical VIP subclass cells that tend to show high input resistance. L5 VIP cells show particularly low resting membrane potential.\")\n30222:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023014 \"L5 VIP (Mus musculus)\")\n30223:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023014 cl:BDS_subset)\n30233:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023015 \"sncg interneuron\")\n30234:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023015 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses Gamma-synuclein.\")\n30236:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023015 \"ILX:0770150\")\n30237:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023015 cl:BDS_subset)\n30245:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023016 \"VIP interneuron\")\n30246:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33186530\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/\") obo:IAO_0000115 obo:CL_4023016 \"A transcriptomically distinct GABAergic neuron derived from the CGE and that expresses the vasoactive intestinal polypeptide. Its soma is located in the forebrain.\")\n30248:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP interneuron\")\n30249:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP neuron\")\n30250:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35221922\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP-Expressing GABAergic Neuron\")\n30251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"Vip GABAergic neuron\")\n30252:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023016 \"ILX:0770151\")\n30253:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP neuron\")\n30254:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP type\")\n30255:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP-IN\")\n30256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ILX:0770151\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"Vip\")\n30257:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023016 cl:BDS_subset)\n30267:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023017 \"sst interneuron\")\n30268:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:33742131\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023017 \"A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst) and derived from the MGE.\")\n30270:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023017 \"ILX:0770152\")\n30271:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"SOM+ inhibitory interneuron\")\n30272:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33742131\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"SST+ IN\")\n30273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30001424\") oboInOwl:hasRelatedSynonym obo:CL_4023017 \"somatostatin-expressing inhibitory interneuron\")\n30274:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023017 cl:BDS_subset)\n30282:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023018 \"pvalb interneuron\")\n30283:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/9c63201d-bfd9-41a8-bbbc-18d947556f3d.cxg/\") obo:IAO_0000115 obo:CL_4023018 \"A transcriptomically distinct GABAergic interneuron with a soma located in the pallium. These neurons express Parvalbumin.\")\n30285:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023018 \"ILX:0770154\")\n30286:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023018 cl:BDS_subset)\n30297:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023019 \"A VIP GABAergic cortical interneuron that expresses cck. L5/6 cck cells have soma found mainly in L5 and L6 and have large axonal arborization.\")\n30299:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023019 \"L5/6 CCK Vip (Mus musculus)\")\n30300:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023019 cl:BDS_subset)\n30306:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023020 \"A gamma motor neuron that innervates dynamic nuclear bag fibers (bag1 fibers) and enhances the sensitivities of Ia sensory neurons. They alter muscle spindle sensitivity and increases its discharge in response to velocity of muscle length (rather than just magnitude).\")\n30314:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:13933877\") Annotation(oboInOwl:hasDbXref \"PMID:139469\") Annotation(oboInOwl:hasDbXref \"WikipediaVersion:Gamma_motor_neuron&oldid=906640465\") obo:IAO_0000115 obo:CL_4023021 \"A gamma motor neuron that innervates static nuclear bag fibers (bag2 fibers) and increases their firing, in response to an increase in the magnitude of change in length, and controls the static sensitivity of the stretch reflex.\")\n30322:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023022 \"canopy lamp5 interneuron\")\n30323:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30413647\") obo:IAO_0000115 obo:CL_4023022 \"A Lamp5 GABAergic cortical interneuron that has extended axons in the surface of L1. Canopy Lamp5 cells resemble neurogliaform cells in having elongated horizontal axonal arbors largely confined to L1; but the dendritic arbors are wider and have fewer branches, while the axon is less tortuous and extends further from the soma\")\n30325:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023022 cl:BDS_subset)\n30335:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023023 \"L5,6 NGC Lamp5 interneuron (Mus)\")\n30336:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023023 \"A lamp 5 GABAergic cortical interneuron with neurogliaform morphology with a soma found in L5,6. L5,6 NGC lamp5 have deep afterhyperpolarization (AHP) but narrow action potentials (APs). Unlike other deep neurogliaform cells (which are caudal ganglionic eminence (CGE) derived), L5,6 NGC lamp5 cells are medial ganglionic eminence (MGE)-derived\")\n30338:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023023 \"L5,6 NGC Lamp5 (Mus musculus)\")\n30339:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023023 cl:BDS_subset)\n30350:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023024 \"NGC Lamp5 interneuron (Mus)\")\n30351:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27477017\") obo:IAO_0000115 obo:CL_4023024 \"A lamp5 GABAergic cortical interneuron with layer-adapting morphology. NGC lamp5 cells have a small round soma, short dendrites, and a wide dense axonal arbor that tends to establish a dense axonal mesh with high connection probability both to themselves and L2 pyramidal cells. NGC lamp5 cells have unique synaptic properties that distinguish them from other GABAergic interneurons, including the release of GABA to the extracellular space via volume transmission, and the ability to produce GABA-B responses in connected postsynaptic targets.\")\n30353:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023024 \"NGC Lamp5 (Mus musculus)\")\n30354:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023024 cl:BDS_subset)\n30365:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26727548\") obo:IAO_0000115 obo:CL_4023025 \"A sst GABAergic cortical interneuron that is both an interneuron and a projecting neuron. They are found in all layers from upper L2/3 down to the bottom of L6. They have long-range projections, some with axons fading into white matter. These cells have low rebound potential, low hyperpolarization sag, and high variability in membrane time constant.\")\n30367:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023025 \"LP SST (Mus musculus)\")\n30368:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023025 cl:BDS_subset)\n30378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:2147780\") Annotation(oboInOwl:hasDbXref \"PMID:215920\") Annotation(oboInOwl:hasDbXref \"PMID:23354054\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasDbXref \"PMID:9004351\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023026 \"A GABAergic medium spiny neuron located in the striatum that gives rise to the direct basal ganglia pathway. It projects directly to the GPi and SNr, where it inhibits tonically active GABAergic output neurons to disinhibit thalamic and brainstem motor targets (Gerfen. 2023). In mice and humans, this cell selectively expresses the D1 dopamine receptor (DRD1), which couples to stimulatory G-proteins (Gs/Gαolf) to increase cAMP and activate PKA-dependent signaling cascades (Gerfen et al., 1990; Kebabian & Calne, 1979). Functionally, activation of this cell promotes selected motor actions by disinhibiting thalamic and midbrain motor centers (Mink, 1996; Cui et al., 2013).\")\n30380:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023026 \"dopamine 1 medium spiny neuron\")\n30381:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023026 \"D1-MSN\")\n30382:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023026 \"dSPN\")\n30383:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26018615\") Annotation(oboInOwl:hasDbXref \"PMID:29737578\") rdfs:comment obo:CL_4023026 \"Despite the direct and indirect circuits are often described not only as functionally opposing but also as anatomically segregated there are several anatomical and functional studies that have challenged this notion of pure segregation based on extensive collateral projections between pathways, dual-projection neurons, simultaneous co-activation during behavior.\")\n30390:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023027 \"L5 T Martinotti sst interneuron (Mus)\")\n30391:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023027 \"A sst GABAergic cortical interneuron with a soma found in L5 and possesses 'T-shaped' Martinotti morphologies with local axonal plexus in L5a and translaminar axons restricted to the uppermost part of L1. They show low-threshold spiking patterns with strong rebound firing, and inhibit the L1 apical tuft of nearby pyramidal cells.\")\n30393:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023027 \"L5 T Martinotti SST (Mus musculus)\")\n30394:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023027 cl:BDS_subset)\n30406:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023028 \"L5 non-Martinotti sst interneuron (Mus)\")\n30407:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023028 \"A sst GABAergic cortical interneuron with a soma found in lower L5 with mostly local axonal arborization but with some sparse ascending axons. L5 non-Martinotti sst cells show somatic localization and local axon plexus in L5b and L5b/6 and substantial innervation of L3 and L4, and receive thalamic input from the ventral posteromedial nucleus and specifically target L4 neurons, avoiding L5 pyramidal cells. L5 non-Martinotti sst cells tend to show a higher input resistance and seem to be less stuttering.\")\n30409:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023028 \"L5 non-Martinotti SST (Mus musculus)\")\n30410:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023028 cl:BDS_subset)\n30420:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27453468\") Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasDbXref \"PMID:36741471\") Annotation(oboInOwl:hasDbXref \"PMID:9004351\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Medium_spiny_neuron&oldid=1109726850\") obo:IAO_0000115 obo:CL_4023029 \"A GABAergic medium spiny neuron located in the striatum that gives rise to the indirect basal ganglia pathway. It projects to the GPe, where its axon typically ramifies in two regions but does not extend beyond this nucleus (Gerfen et al., 2022). It selectively expresses the D2 dopamine receptor (DRD2), which couples to inhibitory G-proteins (Gi/o) to decrease cAMP and suppress PKA-mediated signaling (Gerfen et al., 2022). Morphologically, this cell displays fewer and shorter dendrites than the MSN-D1 and receives fewer glutamatergic inputs, yet it exhibits significantly higher intrinsic excitability (Gertler et al., 2022). Functionally, activation of this cell suppresses competing or alternative motor actions by inhibiting GPe neurons, leading through STN and other GPe circuits to increased GPi/SNr output and stronger inhibition of thalamic and brainstem targets (Mink, 1996; Tecuapetla et al., 2016).\")\n30422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34727523\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"D2-MSN\")\n30423:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7258-9596\") oboInOwl:hasExactSynonym obo:CL_4023029 \"dopamine 2 medium spiny neuron\")\n30424:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096299\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:CL_4023029 \"iSPN\")\n30425:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26018615\") Annotation(oboInOwl:hasDbXref \"PMID:29737578\") rdfs:comment obo:CL_4023029 \"Despite the direct and indirect circuits are often described not only as functionally opposing but also as anatomically segregated there are several anatomical and functional studies that have challenged this notion of pure segregation based on extensive collateral projections between pathways, dual-projection neurons, simultaneous co-activation during behavior.\")\n30432:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023030 \"L2/3/5 fan Martinotti sst interneuron (Mus)\")\n30433:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27225074\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:28254942\") Annotation(oboInOwl:hasDbXref \"PMID:29326172\") obo:IAO_0000115 obo:CL_4023030 \"A sst GABAergic cortical interneuron that has \\\"fanning-out' Martinotti morphology that is found in layer 2/3/5 of the cerebral cortex. They have local axon arbor and long ascending axons that spreads horizontally and arborizes significantly in L1.\")\n30435:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023030 \"L2/3/5 fan Martinotti SST (Mus musculus)\")\n30436:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023030 cl:BDS_subset)\n30437:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") rdfs:comment obo:CL_4023030 \"L2/3/5 fan Martionotti SST cells have an adapting firing pattern and non-zero afterdepolarization (ADP).\")\n30448:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023031 \"L4 sst interneuron (Mus)\")\n30449:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023031 \"A sst GABAergic cortical interneuron with a soma found in lower L2/3 and upper 5, L4 Sst cells have Martinotti morphology with ascending axons but denser local axons and sparser ‘fanning-out’ projections to L1. L4 sst cells have smaller membrane time constant to calb2 (L2/3/5 fan Martinotti Cell) and non-zero afterdepolarization (ADP).\")\n30451:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023031 \"L4 SST (Mus musculus)\")\n30452:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023031 cl:BDS_subset)\n30464:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") rdfs:comment obo:CL_4023032 \"A retinal ganglion cell that is depolarized by illumination of its receptive field center.\")\n30470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19602302\") obo:IAO_0000115 obo:CL_4023033 \"A retinal ganglion cell that is depolarized by decreased illumination of their receptive field center.\")\n30477:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023034 \"OBSOLETE A sst GABAergic cortical interneuron transcriptomically between the sst and the pvalb families with a soma found in L2/3. Some L2/3 PV-like sst cells have Martinotti morphology while some have basket cell morphology. L2/3 PV-like sst cells have lower AP width and higher firing rate than typical Sst subclass cells. L2/3 PV-like sst cells have high maximum firing rate variability, with many classified as belonging to the pvalb subclass on the basis of electrophysiology.\")\n30481:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023034 \"L2/3 PV-like SST Mus)\")\n30488:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipediaversioned:Ganglionic_eminence&oldid=1186824360\") obo:IAO_0000115 obo:CL_4023035 \"A neuron that is derived from a precursor cell in the lateral ganglion eminence.\")\n30491:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377350\") oboInOwl:hasExactSynonym obo:CL_4023035 \"LGE-derived neuron\")\n30498:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023036 \"Pvalb Chandelier\")\n30499:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:27477017\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") obo:IAO_0000115 obo:CL_4023036 \"A transcriptomically distinct pvalb GABAergic interneuron located in the pallium. It is recognizable by the straight terminal axonal 'cartridges' of vertically oriented strings of synaptic boutons. Chandelier PV cells' boutons target exclusively the axon initial segment (AIS) of pyramidal cells, with a single cell innervating hundreds of pyramidal cells in a clustered manner.  These cells are fast-spiking.\")\n30501:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27199673\") Annotation(oboInOwl:hasDbXref \"PMID:33862423\") Annotation(oboInOwl:hasDbXref \"PMID:39012795\") oboInOwl:hasBroadSynonym obo:CL_4023036 \"axo-axonic cell\")\n30502:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0107356\")\n30503:AnnotationAssertion(Annotation(obo:IAO_0000116 \"Interlex cross reference refers specifically to Markram 2015 rat chandelier cell.\") oboInOwl:hasDbXref obo:CL_4023036 \"ILX:0777213\")\n30504:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier PV\")\n30505:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023036 \"chandelier cell\")\n30506:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15378039\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023036 \"ChC\")\n30507:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023036 cl:BDS_subset)\n30518:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023038 \"L6b glut\")\n30519:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.34312\") Annotation(oboInOwl:hasDbXref \"PMID:30382198\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023038 \"A glutamatergic neuron with a soma found in cortical layer 6b. They are transcriptomically related to corticothalamic-projecting neurons but have differential projections to the thalamus or anterior cingulate.\")\n30521:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023038 \"ILX:0770163\")\n30522:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023038 cl:BDS_subset)\n30529:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") rdfs:comment obo:CL_4023039 \"An excitatory neuron that is located in the amygdala.\")\n30535:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023040 \"L2/3-6 IT glut\")\n30536:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/c3aa4f95-7a18-4a7d-8dd8-ca324d714363.cxg/\") obo:IAO_0000115 obo:CL_4023040 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layers L2/3-6.\")\n30538:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023040 \"L2/3-6 IT projecting neuron\")\n30539:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023040 cl:BDS_subset)\n30545:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023041 \"L5 ET glut\")\n30546:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023041 \"A transcriptomically distinct glutamatergic neuron, with a soma found in the deeper portion of L5, that has long-range axonal projections including deep subcortical targets outside of the telencephalon and, in some cases, the spinal cord. While the L5 ET neuron projections are not limited to ET targets, they are clearly differentiated from the neuron subclasses whose projections are constrained to intratelencephalic (IT) targets. L5 ET neurons are generally the largest excitatory cortical neurons, typically having a thick apical dendrite with a prominent dendritic tuft in layer 1 and displaying burst-firing physiological characteristics.\")\n30548:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2005.08.030\") oboInOwl:hasBroadSynonym obo:CL_4023041 \"subcerebral projection (SCPN) neuron\")\n30549:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31626774\") Annotation(rdfs:comment \"pyramidal tract-like is used because, unlike pyramidal tract neurons in the motor cortex, neurons in the structures like the auditory cortex do not project to the spinal cord.\") oboInOwl:hasExactSynonym obo:CL_4023041 \"Pyramidal tract-like (PT-l)\")\n30550:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2011.00001\") oboInOwl:hasExactSynonym obo:CL_4023041 \"burst-firing layer 5 neuron\")\n30551:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2015.00233\") oboInOwl:hasExactSynonym obo:CL_4023041 \"thick-tufted layer 5 (TTL5) pyramidal neuron\")\n30552:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/nrn3469\") oboInOwl:hasNarrowSynonym obo:CL_4023041 \"pyramidal tract (PT) neuron\")\n30553:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.neuron.2011.07.029\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4023041 \"L5b neuron\")\n30554:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023041 cl:BDS_subset)\n30561:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023042 \"L6 CT glut\")\n30562:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023042 \"A transcriptomically distinct corticothalamic-projecting neuron with a soma found in cortical layer 6.\")\n30564:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28625486\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023042 \"L6 CT\")\n30565:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023042 cl:BDS_subset)\n30572:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023043 \"L5/6 NP glut MOp\")\n30573:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31209381\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/d01c9dff-abd1-4825-bf30-2eb2ba74597e.cxg/\") obo:IAO_0000115 obo:CL_4023043 \"A transcriptomically distinct near-projecting glutamatergic neuron with a soma found in layer 5/6 of the primary motor cortex. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Deep layer (non-IT) excitatory neurons', Author Categories: 'CrossArea_subclass', cluster L5/6 NP.\")\n30575:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023043 \"ILX:0770161\")\n30576:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP M1\")\n30577:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023043 \"L5/6 NP MOp\")\n30578:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023043 cl:BDS_subset)\n30584:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023044 \"non-MY ET glut MOp\")\n30585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023044 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that does not project to the medulla. Non-MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. Non-MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\n30587:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET M1\")\n30588:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023044 \"non-MY ET MOp (Mus)\")\n30589:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023044 cl:BDS_subset)\n30596:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023045 \"MY ET glut MOp\")\n30597:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.10.19.343129\") Annotation(oboInOwl:hasDbXref \"PMID:24137110\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023045 \"An extratelencephalic-projecting glutamatergic neuron located in layer 5b of the primary motor cortex that projects to the medulla. MY ET cells are large, big-tufted cells with the apical dendrite often bifurcating close to the soma, suggesting they are corticospinal cells. MY ET cells have bigger hyperpolarization sag, lower input resistance, and smaller AP width, compared to L5 IT neurons.\")\n30599:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"MY ET M1\")\n30600:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"MY ET MOp\")\n30601:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023045 \"medulla-projecting extratelencephalic-projecting glutamatergic neuron of the primary motor cortex\")\n30602:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023045 cl:BDS_subset)\n30611:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023046 \"L6b subplate glut\")\n30612:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023046 \"An excitatory glutamatergic neuron transcriptomically related to the CT subclass, with a soma preferentially located in the bottom of L6 of the primary motor cortex.\")\n30614:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023046 \"L6b subplate glutamatergic neuron of the primary motor cortex\")\n30615:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023046 cl:BDS_subset)\n30622:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023047 \"L2/3 IT glut MOp\")\n30623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") obo:IAO_0000115 obo:CL_4023047 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in cortical layer 2/3 of the primary motor cortex.\")\n30625:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023047 \"L2/3 IT M1\")\n30626:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34616075\") oboInOwl:hasExactSynonym obo:CL_4023047 \"L2/3 IT MOp\")\n30627:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023047 cl:BDS_subset)\n30633:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023048 \"L4/5 IT glut MOp\")\n30634:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023048 \"An intratelencephalic-projecting glutamatergic with a soma located in upper L5 of the primary motor cortex. These cells have thin untufted apical dendrites.\")\n30636:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023048 \"ILX:0770174\")\n30637:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023048 \"L4/5 IT M1\")\n30638:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023048 \"L4/5 IT MOp\")\n30639:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023048 cl:BDS_subset)\n30645:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023049 \"L5 IT glut MOp\")\n30646:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") obo:IAO_0000115 obo:CL_4023049 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in L5 of the primary motor cortex.\")\n30648:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023049 \"ILX:0770157\")\n30649:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023049 \"L5 IT M1\")\n30650:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023049 \"L5 IT MOp\")\n30651:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023049 cl:BDS_subset)\n30657:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023050 \"L6 IT glut MOp\")\n30658:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33184512\") Annotation(oboInOwl:hasDbXref \"PMID:34616063\") Annotation(oboInOwl:hasDbXref \"PMID:34616075\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023050 \"An intratelencephalic-projecting glutamatergic neuron with a soma found in L6 of the primary motor cortex. These cells are short untufted pyramidal cells, which could be stellate or inverted.\")\n30660:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023050 \"ILX:0770158\")\n30661:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023050 \"L6 IT M1\")\n30662:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023050 \"L6 IT MOp\")\n30663:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023050 cl:BDS_subset)\n30670:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\n30672:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_4023051 \"ILX:0770143\")\n30673:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023051 \"VLMC\")\n30674:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023051 cl:BDS_subset)\n30682:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") Annotation(oboInOwl:hasDbXref \"PMID:18558853\") Annotation(oboInOwl:hasDbXref \"PMID:28751609\") obo:IAO_0000115 obo:CL_4023052 \"A Betz cell that synapses with lower motor neurons directly.\")\n30691:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2020.03.31.016972\") Annotation(oboInOwl:hasDbXref \"PMID:18558853\") obo:IAO_0000115 obo:CL_4023053 \"A Betz cell that syanpses with spinal interneurons.\")\n30701:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_4023054 \"A mesothelial cell that has undergone mesothelial-to-mesenchymal transition (MMT) to become a fibroblast cell.\")\n30709:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023055 \"CT VAL/VM glut MOp\")\n30710:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20556241\") Annotation(oboInOwl:hasDbXref \"PMID:9236245\") obo:IAO_0000115 obo:CL_4023055 \"A corticothalamic-projecting glutamatergic neuron that is located in L6 and lower L5 of the primary motor cortex, with a pyramidal morphology and mostly untufted apical dendrites terminating in midcortical layers. CT VAL/VM (ventroanterior-ventrolateral complex/ventromedial nucleus) cells have a near tonic firing pattern and are distinguished from L6 IT neurons by a lower inter-spike interval adaptation index.\")\n30712:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023055 \"CT VAL/VM M1\")\n30713:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023055 \"CT VAL/VM MOp\")\n30714:AnnotationAssertion(oboInOwl:inSubset obo:CL_4023055 cl:BDS_subset)\n30723:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surroundin