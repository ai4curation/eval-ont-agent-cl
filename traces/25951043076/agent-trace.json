tSynonym obo:CL_0000192 \"myocytes, smooth muscle\")\n5682:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000192 \"smooth muscle fiber\")\n5690:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D032383\") obo:IAO_0000115 obo:CL_0000193 \"A striated muscle cell of an arthropod heart that participates in heart contraction.\")\n5707:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.2142/biophysics.7.21\") obo:IAO_0000115 obo:CL_0000196 \"A muscle cell that is involved in the mechanism of insect flight. This encompasses both, cells that power flight and cells that control flight.\")\n5716:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000197 \"A cell that is capable of detection of a stimulus involved in sensory perception.\")\n5717:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000197 \"MESH:D011984\")\n5718:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000197 \"receptor cell\")\n5724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009619\") obo:IAO_0000115 obo:CL_0000198 \"The peripheral receptor for pain. Includes receptors which are sensitive to painful mechanical stimuli, extreme heat or cold, and chemical stimuli. All mammalian nociceptors are free nerve endings.\")\n5725:AnnotationAssertion(Annotation(rdfs:seeAlso \"https://meshb.nlm.nih.gov/record/ui?ui=D009619\"^^xsd:anyURI) oboInOwl:hasExactSynonym obo:CL_0000198 \"nociceptor\")\n5726:AnnotationAssertion(Annotation(rdfs:seeAlso \"https://www.thefreedictionary.com/nocireceptor\"^^xsd:anyURI) oboInOwl:hasExactSynonym obo:CL_0000198 \"nocireceptor\")\n5733:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D008465\") obo:IAO_0000115 obo:CL_0000199 \"A cell specialized to transduce mechanical stimuli and relay that information centrally in the nervous system.\")\n5734:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0000972\") oboInOwl:hasRelatedSynonym obo:CL_0000199 \"mechanoreceptor\")\n5751:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006198\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Hair_cell&oldid=1045345915\") obo:IAO_0000115 obo:CL_0000202 \"A mechanoreceptor cell of the auditory or vestibular system that is sensitive to auditory stimuli. The accessory sensory structures are arranged so that appropriate stimuli cause movement of the hair-like projections (stereocilia and kinocilia) which relay the information centrally in the nervous system.\")\n5752:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000202 \"auditory receptor cell\")\n5770:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D013823\") Annotation(oboInOwl:hasDbXref \"MP:0000971\") obo:IAO_0000115 obo:CL_0000205 \"A cellular receptor which mediates the sense of temperature. Thermoreceptor cells in vertebrates are mostly located under the skin. In mammals there are separate types of thermoreceptors for cold and for warmth and pain receptor cells which detect cold or heat extreme enough to cause pain.\")\n5776:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D002628\") obo:IAO_0000115 obo:CL_0000206 \"A cell specialized to detect chemical substances and relay that information centrally in the nervous system. Chemoreceptors may monitor external stimuli, as in taste and olfaction, or internal stimuli, such as the concentrations of oxygen and carbon dioxide in the blood.\")\n5782:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000207 \"BTO:0004185\")\n5783:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000207 \"FMA:67860\")\n5784:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000207 \"MESH:D018034\")\n5785:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000207 \"Wikipedia:Olfactory_receptor_neuron\")\n5786:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000207 \"Schultze's cell\")\n5787:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000207 \"odorant receptor cell\")\n5788:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000207 \"olfactory receptor neuron\")\n5789: