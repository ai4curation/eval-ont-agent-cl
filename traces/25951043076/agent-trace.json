42357\") Annotation(oboInOwl:hasDbXref \"doi:10.1242/dev.108.1.121\") obo:IAO_0000115 obo:CL_0000530 \"A neuron that develops during the early segmentation stages in teleosts, before the neural tube is formed.\")\n8259:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1842357\") obo:IAO_0000115 obo:CL_0000531 \"A primary neuron (sensu Teleostei) that has a sensory function.\")\n8265:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17971221\") Annotation(oboInOwl:hasDbXref \"PMID:35431796\") obo:IAO_0000115 obo:CL_0000532 \"A primary motor neuron with its soma in the caudal region of a spinal cord. The axon of this motoneuron exit the spinal cord from one single point and innervates the lateral surface of ventral axial muscles\")\n8266:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3746410\") oboInOwl:hasExactSynonym obo:CL_0000532 \"CaP motorneuron\")\n8267:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17971221\") oboInOwl:hasRelatedSynonym obo:CL_0000532 \"cap cell\")\n8268:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18077593\") oboInOwl:hasRelatedSynonym obo:CL_0000532 \"caudal primary motor neuron\")\n8274:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1842357\") obo:IAO_0000115 obo:CL_0000533 \"A primary neuron (sensu Teleostei) that has a motor function.\")\n8281:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1842357\") obo:IAO_0000115 obo:CL_0000534 \"A primary neuron (sensu Teleostei) that is neither a sensory neuron or a motor neuron.\")\n8288:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1842357\") Annotation(oboInOwl:hasDbXref \"doi:10.1242/dev.108.1.121\") obo:IAO_0000115 obo:CL_0000535 \"A neuron of teleosts that develops later than a primary neuron, typically during the larval stages.\")\n8297:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:1842357\") obo:IAO_0000115 obo:CL_0000536 \"A secondary neuron (sensu Teleostei) that has a motor function.\")\n8303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:047125208\") obo:IAO_0000115 obo:CL_0000537 \"Obsolete. Use PO:0020093 from Plant Ontology instead. OBSOLETE, use term from plant ontology. A cell located at the chalazal end of the mature embryo sac in angiosperms.\")\n8310:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:lr\") obo:IAO_0000115 obo:CL_0000538 \"Obsolete. Use PO:0000349 from Plant Ontology instead. A relatively unspecialized cell that will give rise to specialized cell types of the epidermis.\")\n8317:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000539 \"OBSOLETE: A cell in a tissue that markedly differs in form, size, or contents from other cells in the same tissue.\")\n8323:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D009474\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Neuron\") obo:IAO_0000115 obo:CL_0000540 \"The basic cellular unit of nervous tissue. Each neuron consists of a body, an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system.\")\n8324:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000540 \"BTO:0000938\")\n8325:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000540 \"CALOHA:TS-0683\")\n8326:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000540 \"FMA:54527\")\n8327:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000540 \"VHOG:0001483\")\n8328:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000540 \"WBbt:0003679\")\n8329:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000540 \"nerve cell\")\n8340:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000541 \"A cell that originates from the neural crest and differentiates into a pigment cell.\")\n8341:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000541 \"BTO:0003217\")\n8342:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000541 \"FMA:83377\")\n8350:AnnotationAssertion(Annot