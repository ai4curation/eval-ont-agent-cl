notationAssertion(oboInOwl:hasDbXref obo:CL_0000545 \"FMA:84382\")\n8381:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9419219\") oboInOwl:hasExactSynonym obo:CL_0000545 \"T helper cells type 1\")\n8382:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"T(H)-1 cell\")\n8383:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22343568\") oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 CD4+ T cell\")\n8384:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 T cell\")\n8385:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 T lymphocyte\")\n8386:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 T-cell\")\n8387:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 T-lymphocyte\")\n8388:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"Th1 cell\")\n8389:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000545 \"helper T cell type 1\")\n8398:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:pam\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:19375293\") Annotation(oboInOwl:hasDbXref \"PMID:20103781\") Annotation(oboInOwl:hasDbXref \"PMID:22343568\") obo:IAO_0000115 obo:CL_0000546 \"A CD4-positive, alpha-beta T cell that has the phenotype GATA-3-positive, CXCR3-negative, CCR6-negative, and is capable of producing interleukin-4.\")\n8399:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000546 \"BTO:0001679\")\n8400:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000546 \"FMA:84385\")\n8401:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000546 \"MESH:D018418\")\n8402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9419219\") oboInOwl:hasExactSynonym obo:CL_0000546 \"T helper cells type 2\")\n8403:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"T(H)-2 cell\")\n8404:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"Th2 T cell\")\n8405:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"Th2 T lymphocyte\")\n8406:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"Th2 T-cell\")\n8407:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"Th2 T-lymphocyte\")\n8408:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"Th2 cell\")\n8409:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000546 \"helper T cell type 2\")\n8418:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:1638021\") obo:IAO_0000115 obo:CL_0000547 \"An immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.\")\n8419:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000547 \"FMA:83518\")\n8420:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000547 \"rubriblast\")\n8421:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000547 \"pronormoblast\")\n8429:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000548 \"OBSOLETE. A native cell that is part of some Metazoa.\")\n8432:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000548 \"metazoan cell\")\n8433:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000548 ubprop:_upper_level)\n8440:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000549 \"A nucleated immature erythrocyte, having cytoplasm generally similar to that of the earlier proerythroblast but sometimes even more basophilic, and usually regular in outline. The nucleus is still relatively large, but the chromatin strands are thicker and more deeply staining, giving a coarser appearance; the nucleoli have disappeared. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\n8441:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000549 \"FMA:83505\")\n8442:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"basophilic normoblast\")\n8443:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"early erythroblast\")\n8444:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"early normoblast\")\n8445:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000549 \"prorubricyte\")\n8453:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000550 \"A nucleated, immature erythrocyte in which the nucleus occupies a relatively smaller part of the cell than in its precursor, the basophilic erythroblast. The cytoplasm is beginning to acquire hemoglobin and thus is no longer a purely basophilic, but takes on acidophilic aspects, which becomes progressively more marked as the cell matures. The chromatin of the nucleus is arranged in coarse, deeply staining clumps. This cell is CD71-positive and lacks hematopoeitic lineage markers.\")\n8454:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000550 \"FMA:83506\")\n8455:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"intermediate erythroblast\")\n8456:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"intermediate normoblast\")\n8457:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatic erythroblast\")\n8458:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatic normoblast\")\n8459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"polychromatophilic normoblast\")\n8460:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000550 \"rubricyte\")\n8473:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000552 \"The final stage of the nucleated, immature erythrocyte, before nuclear loss. Typically the cytoplasm is described as acidophilic, but it still shows a faint polychromatic tint. The nucleus is small and initially may still have coarse, clumped chromatin, as in its precursor, the polychromatophilic erythroblast, but ultimately it becomes pyknotic, and appears as a deeply staining, blue-black, homogeneous structureless mass. The nucleus is often eccentric and sometimes lobulated.\")\n8474:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000552 \"FMA:84646\")\n8475:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"acidophilic erythroblast\")\n8476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"eosinophilic erythroblast\")\n8477:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000552 \"late erythoblast\")\n8478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"orthochromatic normoblast\")\n8479:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") oboInOwl:hasExactSynonym obo:CL_0000552 \"pyknotic eto enrythroblast\")\n8487:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000553 \"The earliest cytologically identifiable precursor in the thrombocytic series. This cell is capable of endomitosis and lacks expression of hematopoieitic lineage markers (lin-negative).\")\n8488:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"BTO:0001164\")\n8489:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"CALOHA:TS-0610\")\n8490:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"FMA:84235\")\n8491:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000553 \"MESH:D055016\")\n8492:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11722431\") Annotation(oboInOwl:hasDbXref \"PMID:12482498\") oboInOwl:hasExactSynonym obo:CL_0000553 \"CFU-Meg\")\n8493:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMCID:PMC1794060\") oboInOwl:hasExactSynonym obo:CL_0000553 \"Meg-CFC\")\n8494:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21116988\") oboInOwl:hasExactSynonym obo:CL_0000553 \"MkP\")\n8495:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000553 \"colony-forming unit-megakaryocyte\")\n8496:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000553 \"megacaryoblast\")\n8497:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000553 \"megacaryocyte progenitor cell\")\n8498:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000553 \"megakaryoblast\")\n8499:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12482498\") oboInOwl:hasExactSynonym obo:CL_0000553 \"megakaryocytic progenitor cell\")\n8500:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000553 \"promegacaryocyte\")\n8501:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000553 \"promegakaryocyte\")\n8510:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000554 \"A peptide hormone secreting cell that secretes gastrin stimulating hormone.\")\n8522:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D008533\") Annotation(oboInOwl:hasDbXref \"PMID:31043076\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Megakaryocyte\") obo:IAO_0000115 obo:CL_0000556 \"A large hematopoietic cell (50 to 100 micron) with a lobated nucleus. Once mature, this cell undergoes multiple rounds of endomitosis and cytoplasmic restructuring to allow platelet formation and release.\")\n8523:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000556 \"BTO:0000843\")\n8524:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000556 \"CALOHA:TS-0611\")\n8525:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000556 \"FMA:83555\")\n8526:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000556 \"megacaryocyte\")\n8527:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000556 \"megalocaryocyte\")\n8528:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000556 \"megalokaryocyte\")\n8538:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D055014\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasDbXref \"PMID:16551251\") Annotation(oboInOwl:hasDbXref \"PMID:16647566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/CFU-GM\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000557 \"A hematopoietic progenitor cell that is committed to the granulocyte and monocyte lineages. These cells are CD123-positive, and do not express Gata1 or Gata2 but do express C/EBPa, and Pu.1.\")\n8539:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") oboInOwl:hasBroadSynonym obo:CL_0000557 \"CFU-C , Colony forming unit in culture\")\n8540:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") oboInOwl:hasExactSynonym obo:CL_0000557 \"colony forming unit granulocyte macrophage\")\n8541:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") oboInOwl:hasExactSynonym obo:CL_0000557 \"granulocyte-macrophage progenitor\")\n8542:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000557 \"granulocyte/monocyte precursor\")\n8543:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000557 \"granulocyte/monocyte progenitor\")\n8544:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000557 \"CFU-GM\")\n8545:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2213186\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC548021\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000557 \"GMP\")\n8554:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15946868\") Annotation(oboInOwl:hasDbXref \"PMID:2037622\") obo:IAO_0000115 obo:CL_0000558 \"An immature erythrocyte that changes the protein composition of its plasma membrane by exosome formation and extrusion. The types of protein removed differ between species though removal of the transferrin receptor is apparent in mammals and birds.\")\n8555:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"BTO:0001173\")\n8556:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"CALOHA:TS-0864\")\n8557:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000558 \"MESH:D012156\")\n8565:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000559 \"A precursor in the monocytic series, being a cell intermediate in development between the monoblast and monocyte. This cell is CD11b-positive and has fine azurophil granules.\")\n8566:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000559 \"BTO:0004657\")\n8567:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000559 \"FMA:83551\")\n8576:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:10618520\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000560 \"A late neutrophilic metamyelocyte in which the nucleus is indented to more than half the distance to the farthest nuclear margin but in no area being condensed to a single filament. The nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature neutrophil. These cells are fMLP receptor-positive, CD11b-positive, CD35-negative, and CD49d-negative.\")\n8577:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000560 \"band\")\n8578:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000560 \"band cell\")\n8579:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000560 \"band form\")\n8580:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000560 \"stab cell\")\n8581:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000560 \"rod neutrophil\")\n8590:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D025042\") Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Amacrine_cell&oldid=1023572246\") obo:IAO_0000115 obo:CL_0000561 \"Interneuron of the vertebrate retina. They integrate, modulate, and interpose a temporal domain in the visual message presented to the retinal ganglion cells, with which they synapse in the inner plexiform layer. They lack large axons.\")\n8591:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000561 \"BTO:0004044\")\n8592:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000561 \"FMA:67766\")\n8593:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000561 \"amacrine neuron\")\n8594:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000561 \"AC\")\n8595:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000561 \"ACs\")\n8604:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOc:tfm\") obo:IAO_0000115 obo:CL_0000562 \"An erythrocyte having a nucleus.\")\n8605:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000562 \"RBC\")\n8606:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000562 \"red blood cell\")\n8614:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0000563 \"A rounded, inactive form that certain bacteria assume under conditions of extreme temperature, dryness, or lack of food. The bacterium develops a waterproof cell wall that protects it from being dried out or damaged.\")\n8615:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000563 \"BTO:0002779\")\n8616:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000563 \"bacterial spore\")\n8622:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") obo:IAO_0000115 obo:CL_0000564 \"A promyelocyte committed to the neutrophil lineage. This cell type is GATA-1-positive, C/EBPa-positive, AML-1-positive, MPO-positive, has low expression of PU.1 transcription factor and lacks lactotransferrin expression.\")\n8623:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000564 \"FMA:84196\")\n8624:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000564 \"neutrophilic premyelocyte\")\n8625:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000564 \"neutrophilic progranulocyte\")\n8634:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000565 \"A cell found in fat bodies whose primary function is intermediary metabolism.\")\n8640:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12768659\") obo:IAO_0000115 obo:CL_0000566 \"A mesenchymal stem cell capable of developing into blood vessel endothelium.\")\n8641:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000566 \"angioblast\")\n8642:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000566 \"chondroplast\")\n8656:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000568 \"A cell that originates in the neural crest, that has certain cytochemical and ultrastructural characteristics and is found scattered throughout the body; types include melanocytes, the cells of the chromaffin system, and cells in the hypothalamus, hypophysis, thyroid, parathyroids, lungs, gastrointestinal tract, and pancreas. This cell type concentrates the amino acid precursors of certain amines and decarboxylate them, forming amines that function as regulators and neurotransmitters. This cell type produces substances such as epinephrine, norepinephrine, dopamine, serotonin, enkephalin, somatostatin, neurotensin, and substance P, the actions of which may affect contiguous cells, nearby groups of cells, or distant cells, thus functioning as local or systemic hormones. The name is an acronym for amine precursor uptake and decarboxylation cell.\")\n8657:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"BTO:0003866\")\n8658:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"FMA:83114\")\n8659:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000568 \"MESH:D001078\")\n8660:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000568 \"APUD cell\")\n8666:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0000569 \"A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.\")\n8673:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000570 \"A neuroepithelial cells that occurs singly or in small groups, close to the outer follicular borders but within the follicular basement membrane of the thyroid. This cell expresses a form of the neural cell adhesion molecule (N-CAM) on its surface and secretes calcitonin and serotonin (5-hydroxytryptamine).\")\n8674:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000570 \"FMA:68653\")\n8675:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000570 \"SCTID:176770005\")\n8676:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000570 \"C cell\")\n8677:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"C cell of thyroid gland\")\n8678:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"clear cell of thyroid gland\")\n8679:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"parafollicular cell of thyroid gland\")\n8680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:68653\") oboInOwl:hasExactSynonym obo:CL_0000570 \"thyroid parafollicular cell\")\n8689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000571 \"A pigment cell derived from the neural crest. Contains uric acid or other purine crystals deposited in stacks called leucosomes. The crystals reflect light and this gives a white appearance under white light.\")\n8702:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017949\") obo:IAO_0000115 obo:CL_0000573 \"One of the two photoreceptor cell types in the vertebrate retina. In cones the photopigment is in invaginations of the cell membrane of the outer segment. Cones are less sensitive to light than rods, but they provide vision with higher spatial and temporal acuity, and the combination of signals from cones with different pigments allows color vision.\")\n8703:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"BTO:0001036\")\n8704:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"CALOHA:TS-0866\")\n8705:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000573 \"FMA:67748\")\n8706:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") oboInOwl:hasRelatedSynonym obo:CL_0000573 \"cone\")\n8713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000574 \"A pigment cell derived from the neural crest. Contains pteridine and/or carotenoid pigments in structures called pterinosomes or erythrosomes. This gives an orange to red appearance.\")\n8720:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000575 \"An epithelial cell of the cornea.\")\n8721:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"BTO:0004298\")\n8722:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"CALOHA:TS-0173\")\n8723:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000575 \"FMA:70551\")\n8724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70551\") oboInOwl:hasExactSynonym obo:CL_0000575 \"epithelial cell of cornea\")\n8731:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"MESH:D009000\") obo:IAO_0000115 obo:CL_0000576 \"Myeloid mononuclear recirculating leukocyte that can act as a precursor of tissue macrophages, osteoclasts and some populations of tissue dendritic cells.\")\n8732:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"BTO:0000876\")\n8733:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"CALOHA:TS-0638\")\n8734:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000576 \"FMA:62864\")\n8744:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9505449\") obo:IAO_0000115 obo:CL_0000577 \"A subtype of enteroendocrine cells found in the gastrointestinal mucosa, particularly in the glands of pyloric antrum; duodenum; and ileum. These cell type secretes serotonin and some neurotransmitters including enkephalins and substance P. Their secretory granules stain readily with silver (argentaffin stain).\")\n8745:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"FMA:62934\")\n8746:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"FMA:83132\")\n8747:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000577 \"MESH:D004759\")\n8748:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"Kulchitsky cell\")\n8749:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"argentaffin cell\")\n8750:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000577 \"enterochromaffin cell\")\n8761:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"ReO:mhb\") obo:IAO_0000115 obo:CL_0000578 \"A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure.\")\n8768:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FBbt:00004905\") obo:IAO_0000115 obo:CL_0000579 \"A follicle cell that migrates from the anterior pole of the insect egg chamber to the anterior of the oocyte where they participate in the formation of the micropyle.\")\n8774:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:10618520\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000580 \"A neutrophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte; in this stage, production of primary granules is complete and neutrophil-specific granules has started. No nucleolus is present. This cell type is CD13-positive, CD16-negative, integrin alpha-M-positive, CD15-positive, CD33-positive, CD24-positive, C/EBP-a-positive, C/EBPe-positive, PU.1-positive, lactotransferrin-positive, myeloperoxidase-positive and NGAL-positive.\")\n8775:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000580 \"BTO:0003455\")\n8776:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000580 \"FMA:83540\")\n8786:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017737\") Annotation(oboInOwl:hasDbXref \"PMID:15771589\") Annotation(oboInOwl:hasDbXref \"PMID:19201820\") obo:IAO_0000115 obo:CL_0000581 \"A macrophage resident in the peritoneum under non-inflammatory conditions. Markers include F4/80-high, CD11b-high, CD68-positive, SIGNR1-positive, CD115-high, MHC-II-negative, and Dectin-1-positive.\")\n8787:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000581 \"BTO:0001034\")\n8788:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000581 \"FMA:83025\")\n8796:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:10618520\") Annotation(oboInOwl:hasDbXref \"PMID:12560239\") Annotation(oboInOwl:hasDbXref \"PMID:15514007\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000582 \"A neutrophil precursor in the granulocytic series, being a cell intermediate in development between a myelocyte and the band form neutrophil. The protein synthesis seen in earlier stages decreases or stops; the nucleus becomes indented where the indentation is smaller than half the distance to the farthest nuclear margin; chromatin becomes coarse and clumped; specific granules predominate while primary granules are rare; and the cytoplasm becomes amphophilic like that of a mature granulocyte. This cell type is integrin alpha-M-positive, CD13-negative, CD15-positive, CD16-positive, CD33-positive, CD24-positive, fMLP receptor-negative and has expression of C/EBP-a, C/EBP-e, PU.1 transcription factor, lactotransferrin, myeloperoxidase and neutrophil gelatinase associated lipocalin.\")\n8797:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000582 \"FMA:84197\")\n8798:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000582 \"juvenile neutrophil\")\n8808:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:ana\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"MESH:D016676\") obo:IAO_0000115 obo:CL_0000583 \"A tissue-resident macrophage found in the alveoli of the lungs. Ingests small inhaled particles resulting in degradation and presentation of the antigen to immunocompetent cells. Markers include F4/80-positive, CD11b-/low, CD11c-positive, CD68-positive, sialoadhesin-positive, dectin-1-positive, MR-positive, CX3CR1-negative.\")\n8809:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"BTO:0000802\")\n8810:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"CALOHA:TS-0030\")\n8811:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000583 \"FMA:83023\")\n8812:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000583 \"dust cell\")\n8813:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000583 \"MF.Lu\")\n8822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000584 \"An epithelial cell that has its apical plasma membrane folded into microvilli to provide ample surface for the absorption of nutrients from the intestinal lumen.\")\n8823:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"BTO:0000398\")\n8824:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"FMA:62122\")\n8825:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000584 \"MESH:D020895\")\n8826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33290721\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-9610-7627\") oboInOwl:hasNarrowSynonym obo:CL_0000584 \"differentiated enterocyte\")\n8827:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33290721\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-9610-7627\") oboInOwl:hasNarrowSynonym obo:CL_0000584 \"mature enterocyte\")\n8835:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000585 \"OBSOLETE: A class of lymphocytes characterized by the lack of surface markers specific for either T or B cells.\")\n8836:AnnotationAssertion(rdfs:comment obo:CL_0000585 \"This term is rather archaic; consider using 'natural killer cell ; CL:0000623', 'pro-B cell ; CL:0000826', 'pro-T cell ; CL:0000827', or other appropriate lymphocyte-related term depending on the context.\")\n8842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D005854\") obo:IAO_0000115 obo:CL_0000586 \"The reproductive cell in multicellular organisms.\")\n8843:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"BTO:0000535\")\n8844:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"NCIT:C12597\")\n8845:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"VHOG:0001534\")\n8846:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000586 \"WBbt:0006796\")\n8853:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000587 \"A thermoreceptor cell that detects reduced temperatures.\")\n8859:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000588 \"A specialized osteoclast associated with the absorption and removal of cementum.\")\n8860:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000588 \"BTO:0002516\")\n8861:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000588 \"FMA:83027\")\n8868:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006199\") obo:IAO_0000115 obo:CL_0000589 \"A bulbous cell that is medially placed in one row in the organ of Corti. In contrast to the outer hair cells, the inner hair cells are fewer in number, have fewer sensory hairs, and are less differentiated.\")\n8869:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000589 \"inner hair cell\")\n8870:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000589 \"BTO:0003667\")\n8871:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000589 \"FMA:62365\")\n8877:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D008184\") obo:IAO_0000115 obo:CL_0000590 \"A progesterone secreting cell in the corpus luteum that develops from theca cells.\")\n8878:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000590 \"BTO:0002850\")\n8879:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000590 \"FMA:18690\")\n8880:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000590 \"small lutein cell\")\n8881:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000590 \"theca lutein cell\")\n8889:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000591 \"A thermoreceptor cell that detects increased temperatures.\")\n8895:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D008184\") obo:IAO_0000115 obo:CL_0000592 \"A large, progesterone secreting cell in the corpus luteum that develops from the granulosa cells.\")\n8896:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000592 \"FMA:18689\")\n8897:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000592 \"granulosa lutein cell\")\n8898:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000592 \"granulosoluteocytus\")\n8906:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000593 \"A steroid hormone secreting cell that secretes androgen.\")\n8912:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D032496\") Annotation(oboInOwl:hasDbXref \"PMID:21849021\") Annotation(oboInOwl:hasDbXref \"PMID:23303905\") obo:IAO_0000115 obo:CL_0000594 \"An elongated, spindle-shaped, cell that is located between the basal lamina and the plasmalemma of a muscle fiber. These cells are mostly quiescent, but upon activation they divide to produce cells that generate new muscle fibers.\")\n8920:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000595 \"An erythrocyte lacking a nucleus.\")\n8921:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000595 \"red blood cell\")\n8922:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000595 \"RBC\")\n8930:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FAO:0000017\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000596 \"A spore formed following meiosis. Sometimes following meiosis, prospores may undergo one or more rounds of mitosis before they are fully mature.\")\n8931:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000596 \"FAO:0000017\")\n8932:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000596 \"meiotically-derived spore\")\n8938:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"PMID:8357339\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000597 \"The smaller of two types of asexual spores formed by some fungi. An ovoid to pear-shaped asexual spore that contains very little cytoplasm and organelles, is uninucleate, and forms in vegetative hypae within a mycelium. Micronidia are extruded from the hyphal cell wall.\")\n8939:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000597 \"FAO:0000028\")\n8945:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D017966\") obo:IAO_0000115 obo:CL_0000598 \"Pyramidal neurons have a pyramid-shaped soma with a single axon, a large apical dendrite and multiple basal dendrites. The apex and an apical dendrite typically point toward the pial surface and other dendrites and an axon emerging from the base. The axons may have local collaterals but also project outside their region. Pyramidal neurons are found in the cerebral cortex, the hippocampus, and the amygdala.\")\n8946:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"BTO:0003102\")\n8947:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"FMA:67310\")\n8948:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"FMA:86775\")\n8949:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000598 \"NIFSTD:sao862606388\")\n8950:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000598 \"projection neuron\")\n8951:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000598 \"pyramidal cell\")\n8952:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000598 cl:BDS_subset)\n8959:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"PMID:2524423\") Annotation(oboInOwl:hasDbXref \"PMID:9529886\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000599 \"An asexual, nonmotile spore formed by higher fungi; conidia are usually made from the side or tip of specialized sporogenous cells and do not form by progressive cleavage of the cytoplasm.\")\n8960:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000599 \"BTO:0000283\")\n8961:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000599 \"FAO:0000024\")\n8967:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000600 \"A fungal cell with two or more genetically distinct nuclei.\")\n8974:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018072\") obo:IAO_0000115 obo:CL_0000601 \"A mechanoreceptor in the organ of Corti. In mammals the outer hair cells are arranged in three rows which are further from the modiolus than the single row of inner hair cells. The motile properties of the outer hair cells may contribute actively to tuning the sensitivity and frequency selectivity of the cochlea.\")\n8975:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000601 \"BTO:0003666\")\n8976:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000601 \"FMA:62366\")\n8983:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D011311\") obo:IAO_0000115 obo:CL_0000602 \"A receptor in the vascular system, particularly the aorta and carotid sinus, which is sensitive to stretch of the vessel walls.\")\n8989:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000603 \"A fungal cell with two genetically distinct haploid nuclei.\")\n8996:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D017948\") obo:IAO_0000115 obo:CL_0000604 \"One of the two photoreceptor cell types of the vertebrate retina. In rods the photopigment is in stacks of membranous disks separate from the outer cell membrane. Rods are more sensitive to light than cones, but rod mediated vision has less spatial and temporal resolution than cone vision.\")\n8997:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"BTO:0001024\")\n8998:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"CALOHA:TS-0870\")\n8999:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000604 \"FMA:67747\")\n9000:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") oboInOwl:hasRelatedSynonym obo:CL_0000604 \"rod\")\n9007:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:2524423\") Annotation(oboInOwl:hasDbXref \"PMID:9529886\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000605 \"A spore formed following mitosis or mitoses.\")\n9008:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000605 \"FAO:0000023\")\n9014:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000606 \"The larger of two types of asexual spores formed by some fungi; usually round or oblong.\")\n9015:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000606 \"FAO:0000038\")\n9021:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000607 \"A thick walled spore that stores and protects one or more nuclei following sexual reproduction in an Ascomycete.\")\n9022:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000607 \"BTO:0000097\")\n9023:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000607 \"FAO:0000020\")\n9029:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") Annotation(oboInOwl:hasDbXref \"SGD:clt\") obo:IAO_0000115 obo:CL_0000608 \"A thick walled, sexual, resting spore formed by Zygomycetes; sometimes refers to the spore and the multi-layered cell wall that encloses the spore, the zygosporangium.\")\n9030:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000608 \"FAO:0000040\")\n9036:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D018069\") obo:IAO_0000115 obo:CL_0000609 \"A mechanoreceptor located in the acoustic maculae and the semicircular canals that mediates the sense of balance, movement, and head position. The vestibular hair cells are connected to accessory structures in such a way that movements of the head displace their stereocilia. This influences the membrane potential of the cells which relay information about movements via the vestibular part of the vestibulocochlear nerve to the brain stem.\")\n9037:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000609 \"FMA:62351\")\n9038:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000609 \"vestibular receptor cell\")\n9044:AnnotationAssertion(oboInOwl:consider obo:CL_0000610 \"PO:0009002\")\n9051:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000611 \"CFU-Eo\")\n9052:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMCID:PMC2212039\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000611 \"EoP\")\n9053:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000611 \"colony forming unit eosinophil\")\n9054:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000611 \"eosinophil stem cell\")\n9063:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:19622087\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000612 \"A eosinophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte;in this stage, production of primary granules is complete and eosinophil-specific granules has started. No nucleolus is present. These cells are integrin alpha-M-positive, CD13-positive, CD15-positive, CD16-negative, CD24-positive, and CD33-positive.\")\n9064:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000612 \"BTO:0003454\")\n9065:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000612 \"FMA:83542\")\n9073:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC1312421\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000613 \"A progenitor cell committed to the basophil lineage. This cell lacks hematopoietic lineage markers (lin-negative) and is CD34-positive, T1/ST2-low, CD117-negative, and FceRIa-high. This cell also expresses Gata-1, Gata-2 and C/EBPa.\")\n9074:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000613 \"BaP\")\n9075:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"CFU-Bas\")\n9076:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"basophilic stem cell\")\n9077:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000613 \"colony forming unit basophil\")\n9086:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18466030\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000614 \"A basophil precursor in the granulocytic series, being a cell intermediate in development between a promyelocyte and a metamyelocyte; in this stage, production of primary granules is complete and basophil-specific granules has started. No nucleolus is present. Markers are being integrin alpha-M-positive, fucosyltransferase FUT4-positive, CD33-positive, CD24-positive, aminopeptidase N-positive.\")\n9087:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000614 \"BTO:0003456\")\n9088:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000614 \"FMA:83543\")\n9096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:clt\") Annotation(oboInOwl:hasDbXref \"ISBN:0471940526\") Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000615 \"A thick walled spore containing one or more haploid nuclei produced by sexual reproduction in an Basidiomycete; formed externally on extrusions of the basidium.\")\n9097:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000615 \"BTO:0002166\")\n9098:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000615 \"FAO:0000021\")\n9104:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000616 \"OBSOLETE: A walled spore produced in a sporangium.\")\n9110:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000617 \"A neuron that uses GABA as a vesicular neurotransmitter\")\n9111:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"FMA:84788\")\n9112:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"MESH:D059330\")\n9113:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000617 \"WBbt:0005190\")\n9114:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000617 \"GABA-ergic neuron\")\n9126:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000619 \"support cell (sensu Nematoda)\")\n9132:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:08199377X\") obo:IAO_0000115 obo:CL_0000620 \"OBSOLETE: A sporangiospore that is motile, having flagella.\")\n9133:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000620 \"FAO:0000039\")\n9139:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22274696\") obo:IAO_0000115 obo:CL_0000621 \"A myoblast that is committed to a myotube-specific program of differentiation but not yet fused. It undergoes very limited additional proliferation. After fusion, it will take on a muscle identity specified by a `muscle founder cell` (CL:0008006).\")\n9146:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0000622 \"A secretory cell that is grouped together with other cells of the same type to form grape shaped clusters known as acini (singular acinus).\")\n9147:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000622 \"FMA:83625\")\n9148:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000622 \"MESH:D061354\")\n9149:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000622 \"acinic cell\")\n9150:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000622 \"acinous cell\")\n9156:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") Annotation(oboInOwl:hasDbXref \"PMID:15771571\") obo:IAO_0000115 obo:CL_0000623 \"A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation via germline encoded activation receptors and also regulate immune responses via cytokine release and direct contact with other cells.\")\n9157:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000623 \"large granular lymphocyte\")\n9158:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000623 \"null cell\")\n9159:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"BTO:0000914\")\n9160:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"BTO:0004716\")\n9161:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"CALOHA:TS-0664\")\n9162:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"FMA:63147\")\n9163:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"FMA:83601\")\n9164:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"MESH:D007694\")\n9165:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000623 \"VHOG:0001697\")\n9166:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000623 \"NK cell\")\n9173:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000624 \"A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor.\")\n9174:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T lymphocyte\")\n9175:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T-cell\")\n9176:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000624 \"CD4-positive, alpha-beta T-lymphocyte\")\n9184:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0781735149\") obo:IAO_0000115 obo:CL_0000625 \"A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor.\")\n9185:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T lymphocyte\")\n9186:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T-cell\")\n9187:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000625 \"CD8-positive, alpha-beta T-lymphocyte\")\n9194:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") obo:IAO_0000115 obo:CL_0000626 \"A granule cell that has a soma located in an olfactory bulb granule cell layer. An olfactory granule cell is an interneuron that lacks an axon, makes reciprocal dendro-dendritic synapses with mitral cells and tufted cells and is involved in the fine spatio-temporal tuning of the responses of these principal olfactory bulb neurons to odors.\")\n9195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") oboInOwl:hasExactSynonym obo:CL_0000626 \"olfactory bulb granule cell\")\n9196:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-018-27692-8\") rdfs:comment obo:CL_0000626 \"Granule cells are the most abundant neuronal population in the olfactory bulb and are continuously renewed throughout life.\")\n9208:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000627 \"OBSOLETE. A cell involved in transporting nutrients, minerals, water, gases and other chemicals between cells for a variety of purposes including conveying nutrition to other tissues, removing waste products from the tissues, conveying gases for respiration, distributing heat and repelling invasion of foreign substances.\")\n9216:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"TAIR:sr\") obo:IAO_0000115 obo:CL_0000628 \"A cell that can perform photosynthesis, in which carbohydrates are synthesized from carbon dioxide and water, using light as the energy source.\")\n9224:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") obo:IAO_0000115 obo:CL_0000629 \"A cell that is specialized to store a particular substance(s), which is(are) later released from the store for a particular purpose.\")\n9230:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FB:ma\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000630 \"A cell whose primary function is to support other cell types.\")\n9231:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000630 \"BTO:0002315\")\n9232:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000630 \"supportive cell\")\n9238:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D007760\") obo:IAO_0000115 obo:CL_0000631 \"Cells forming a framework supporting the organ of Corti. Specific cells are those of Claudius, Deiters and Hensen.\")\n9244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\n9245:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"BTO:0002741\")\n9246:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"CALOHA:TS-0452\")\n9247:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000632 \"FMA:67763\")\n9248:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000632 \"Ito cell\")\n9249:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000632 \"hepatic perisinusoidal cell\")\n9250:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000632 \"perisinusoidal cell\")\n9251:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000632 \"fat-storing cell\")\n9252:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000632 \"lipocyte\")\n9253:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:12808230\") oboInOwl:hasRelatedSynonym obo:CL_0000632 \"vitamin A-storing cells\")\n9263:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000633 \"A tall supporting cell that is arranged in rows adjacent to the last row of outer phalangeal cells. This cell type constitutes the outer border of the organ of Corti.\")\n9264:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000633 \"FMA:79799\")\n9265:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000633 \"Hensen's cell\")\n9266:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000633 \"cell of Hensen\")\n9267:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000633 \"external limiting cell of organ of Corti\")\n9273:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000634 \"A cuboidal cell which along with Boettcher's cells form the floor of the external spiral sulcus, external to the organ of Corti.\")\n9274:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000634 \"FMA:79802\")\n9275:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000634 \"cell of Claudius\")\n9276:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000634 \"external supporting cell of Claudius\")\n9282:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"http://www.britannica.com/EBchecked/topic/156177/Deiters-cell\") obo:IAO_0000115 obo:CL_0000635 \"The outer phalangeal cells of the organ of Corti. This cell holds the base of the hair cell in a cup-shaped depression.\")\n9283:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000635 \"FMA:75725\")\n9284:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000635 \"Deiters cell\")\n9285:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000635 \"outer phalangeal cell\")\n9291:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"PMID:21911394\") obo:IAO_0000115 obo:CL_0000636 \"Astrocyte-like radial glial cell that extends vertically throughout the retina, with the nucleus are usually in the middle of the inner nuclear layer.\")\n9292:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000636 \"BTO:0003064\")\n9293:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.21769/BioProtoc.4179\") Annotation(oboInOwl:hasSynonymType core:MISSPELLING) oboInOwl:hasExactSynonym obo:CL_0000636 \"Muller cell\")\n9294:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000636 \"Muller glia\")\n9295:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000636 \"Müller cell\")\n9303:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0000637 \"A cell that stains readily in the anterior pituitary gland.\")\n9304:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000637 \"FMA:83089\")\n9312:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000638 \"An acidophilic chromophil cell that of the anterior pituitary gland.\")\n9313:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000638 \"FMA:83093\")\n9314:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000638 \"acidophil cell of pars anterior of adenohypophysis\")\n9315:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000638 \"acidophil of pars anterior of adenohypophysis\")\n9316:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000638 \"acidophil of pars distalis of adenohypophysis\")\n9317:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000638 \"pituitary alpha cell\")\n9324:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000639 \"A basophilic chromophil cell that of the anterior pituitary gland.\")\n9325:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000639 \"FMA:83094\")\n9326:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000639 \"basophil cell of anterior lobe of hypophysis\")\n9327:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000639 \"beta cell\")\n9328:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000639 \"pituitary beta cell\")\n9340:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000641 \"A cell that is resistant to stains.\")\n9341:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000641 \"FMA:83626\")\n9342:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000641 \"chromophobic cell\")\n9348:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:10495875\") Annotation(oboInOwl:hasDbXref \"PMID:15961560\") Annotation(oboInOwl:hasDbXref \"doi:10.23937/2572-407X.1510006\") obo:IAO_0000115 obo:CL_0000642 \"An agranular supporting cell of the anterior pituitary (adenohypophysis) that is characterized by a star-like morphology and ability to form follicles. Folliculostellate cells communicate with each other and with endocrine cells via gap junctions.\")\n9349:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.23937/2572-407X.1510006\") oboInOwl:hasExactSynonym obo:CL_0000642 \"folliculo-stellate cell\")\n9350:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34734454\") oboInOwl:hasExactSynonym obo:CL_0000642 \"pituitary folliculostellate cell\")\n9351:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34734454\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000642 \"FS cell\")\n9352:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.23937/2572-407X.1510006\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000642 \"FSC\")\n9353:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34734454\") oboInOwl:hasRelatedSynonym obo:CL_0000642 \"Sox2-positive stem cell\")\n9354:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18287078\") Annotation(oboInOwl:hasDbXref \"PMID:31620083\") Annotation(oboInOwl:hasDbXref \"PMID:34734454\") Annotation(oboInOwl:hasDbXref \"doi:10.23937/2572-407X.1510006\") rdfs:comment obo:CL_0000642 \"Folliculostellate cells are a heterogeneous group of cells rather than a single cell type, with different morphology and gene expression profiles. Due to this heterogeneity, it is unclear if different properties that have been attributed to folliculostellate cells (pluripotent, proliferative, phagocytic) are common in all folliculostellate cells or limited to particular subsets.\")\n9367:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.neurolex.org/wiki/Category:Bergmann_Glial_Cell\") obo:IAO_0000115 obo:CL_0000644 \"Type of radial astrocyte in the cerebellar cortex that have their cell bodies in the Purkinje cell layer and processes that extend into the molecular layer, terminating with bulbous endfeet at the pial surface. Bergmann glia express high densities of glutamate transporters that limit diffusion of the neurotransmitter glutamate during its release from synaptic terminals. Besides their role in early development of the cerebellum, Bergmann glia are also required for the pruning or addition of synapses.\")\n9368:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000644 \"FMA:54559\")\n9369:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000644 \"Bergmann astrocyte\")\n9370:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000644 \"Bergmann glial cell of cerebellum\")\n9372:AnnotationAssertion(Annotation(dc:license <https://creativecommons.org/licenses/by-nc-nd/4.0/>) Annotation(oboInOwl:hasDbXref \"doi:10.3389/fnins.2020.00293\") foaf:depiction obo:CL_0000644 <http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg>)\n9378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31915267\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Pituicyte\") obo:IAO_0000115 obo:CL_0000645 \"A glial cell of astrocytic lineage with long processes running parallel to adjacent axons in the proximal infundibulum of the neurohypophysis. These processes form a three-dimensional network among the axons of the hypothalamic neurosecretory cells and are connected by gap junctions which provide for their metabolic coupling. This cell type constitutes most of the nonexcitable tissue in the neurohypophsis; function may include possibly acting as an intermediate in the modulation of oxytocin and vasopressin release. This cell type is highly variable in size and shape and commonly contain lipid droplets and deposits of lipochrome pigment.\")\n9379:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000645 \"BTO:0003793\")\n9380:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000645 \"FMA:83503\")\n9387:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000646 \"Undifferentiated; mitotic stem cell for other epithelial cell types; rounded or elliptical with little cytoplasm and few organelles; contain cytokeratin intermediate filament.\")\n9388:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000646 \"BTO:0000939\")\n9389:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000646 \"FMA:62516\")\n9395:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") Annotation(oboInOwl:hasDbXref \"PMID:33348900\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Giant_cell\") obo:IAO_0000115 obo:CL_0000647 \"A phagocytic syncytial cell formed by the fusion of macrophages, occurs in chronic inflammatory responses to persistent microorganism such as M.tuberculosis, component of granulomas. Sometimes used to refer to megakaryocytes.\")\n9396:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000647 \"BTO:0003107\")\n9397:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000647 \"FMA:83035\")\n9398:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000647 \"MESH:D015726\")\n9399:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") oboInOwl:hasExactSynonym obo:CL_0000647 \"Langerhans giant cell\")\n9400:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") oboInOwl:hasExactSynonym obo:CL_0000647 \"foreign body giant cell\")\n9401:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") oboInOwl:hasExactSynonym obo:CL_0000647 \"macrophage polykaryon\")\n9402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") oboInOwl:hasExactSynonym obo:CL_0000647 \"multinucleate giant cell\")\n9403:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0702022918\") Annotation(oboInOwl:hasDbXref \"ISBN:0702024783\") oboInOwl:hasExactSynonym obo:CL_0000647 \"syncytial giant cell\")\n9404:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33348900\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000647 \"MGC\")\n9414:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:cvs\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11457727\") obo:IAO_0000115 obo:CL_0000648 \"A smooth muscle cell that synthesizes, stores, and secretes the enzyme renin. This cell type are located in the wall of the afferent arteriole at the entrance to the glomerulus. While having a different origin than other kidney smooth muscle cells, this cell type expresses smooth muscle actin upon maturation.\")\n9415:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000648 \"juxtaglomerular cell\")\n9416:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000648 \"FMA:84138\")\n9417:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000648 \"JG cell\")\n9418:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000648 \"renin secreting cell\")\n9426:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"ISBN:0815332181\") Annotation(oboInOwl:hasDbXref \"PMID:21860392\") Annotation(oboInOwl:hasDbXref \"PMID:32097634\") Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Spinous_cell\") obo:IAO_0000115 obo:CL_0000649 \"A keratinocyte found within the stratum spinosum (prickle cell layer) of the epidermis, distinguished by numerous intercellular desmosomes, which give it a “prickly” or spiny appearance. Positioned above the mitotically active basal layer and beneath the granular layer, it contributes to the skin’s mechanical strength and barrier function, preventing water loss and pathogen entry. This cell expresses differentiation-specific keratins K1 and K10 in mice, unlike basal cells that express K5 and K14, and lacks the keratohyalin granules found in granular cells, marking its intermediate stage of epidermal differentiation.\")\n9427:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000649 \"FMA:69059\")\n9428:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WIKIPEDIA:Spinous_cell\") oboInOwl:hasExactSynonym obo:CL_0000649 \"prickle cell of epidermis\")\n9429:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32843640\") oboInOwl:hasExactSynonym obo:CL_0000649 \"spinous keratinocytes of epidermis\")\n9436:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de/cope.cgi?key=mesangial%20cells\") obo:IAO_0000115 obo:CL_0000650 \"A cell type that encapsulates the capillaries and venules in the kidney. This cell secretes mesangial matrix that provides the structural support for the capillaries.\")\n9437:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000650 \"BTO:0000853\")\n9438:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000650 \"CALOHA:TS-0617\")\n9439:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000650 \"FMA:70972\")\n9440:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000650 \"MESH:D050527\")\n9441:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000650 \"kidney mesangial cell\")\n9450:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000651 \"OBSOLETE. A mucus-secreting cell, with numerous apical secretory vesicles containing mucins; nucleus are basally displaced; numerous at the neck of mucus secreting glands\")\n9452:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000651 \"neck cell\")\n9459:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:16687276\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Pinealocyte\") obo:IAO_0000115 obo:CL_0000652 \"This cell type produces and secretes melatonin and forms the pineal parenchyma. Extending from each cell body, which has a spherical, oval or lobulated mucleus, are one or more tortuous basophilic processes, containing parallel microtubules known as synaptic ribbons. These processes end in expanded terminal buds near capillaries or less, frequently, ependymal cells of the pineal recess. The terminal buds contain granular endoplasmic reticulum, mitochondria and electron-dense cored vesicles, which store monoamines and polypeptide hormones, release of which appears to require sympathetic innervation.\")\n9460:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000652 \"BTO:0001068\")\n9461:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000652 \"FMA:83417\")\n9470:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1101/2021.10.10.463829\") obo:IAO_0000115 obo:CL_0000653 \"A specialized kidney epithelial cell, contained within a glomerulus, that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other podocytes.\")\n9471:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70967\") oboInOwl:hasBroadSynonym obo:CL_0000653 \"epithelial cell of visceral layer of glomerular capsule\")\n9472:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000653 \"BTO:0002295\")\n9473:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000653 \"FMA:70967\")\n9474:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:70967\") oboInOwl:hasExactSynonym obo:CL_0000653 \"glomerular podocyte\")\n9475:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000653 \"glomerular visceral epithelial cell\")\n9476:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000653 \"kidney podocyte\")\n9477:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000653 \"renal podocyte\")\n9479:AnnotationAssertion(rdfs:seeAlso obo:CL_0000653 \"https://github.com/obophenotype/cell-ontology/issues/1460\")\n9485:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000654 \"A primary oocyte is an oocyte that has not completed female meosis I.\")\n9486:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000654 \"BTO:0000512\")\n9487:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000654 \"FMA:18645\")\n9488:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000654 \"primary oogonium\")\n9496:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000655 \"A secondary oocyte is an oocyte that has not completed meiosis II.\")\n9497:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000655 \"BTO:0003094\")\n9498:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000655 \"FMA:18646\")\n9499:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000655 \"primary oogonium\")\n9507:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000656 \"A diploid cell that has derived from a spermatogonium and can subsequently begin meiosis and divide into two haploid secondary spermatocytes.\")\n9508:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000656 \"BTO:0001115\")\n9509:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000656 \"CALOHA:TS-2194\")\n9510:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000656 \"FMA:72292\")\n9516:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000657 \"One of the two haploid cells into which a primary spermatocyte divides, and which in turn gives origin to spermatids.\")\n9517:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000657 \"BTO:0000709\")\n9518:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000657 \"CALOHA:TS-2195\")\n9519:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000657 \"FMA:72293\")\n9526:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000658 \"An epithelial cell that secretes cuticle.\")\n9533:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000659 \"An extracellular matrix secreting cell that secretes eggshell.\")\n9540:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000660 \"An extracellular matrix secreting cell that secretes glycocalyx.\")\n9577:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1007/978-3-211-99390-3_133\") obo:IAO_0000115 obo:CL_0000666 \"An endothelial cell that has small pores, or fenestrations, which allow for the efficient exchange of substances between the blood and surrounding tissues.\")\n9578:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000666 \"window cell\")\n9585:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000667 \"An extracellular matrix secreting cell that secretes collagen.\")\n9591:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000668 \"OBSOLETE: The cell characteristic of an organ, as distinguished from associated connective or supporting tissues.\")\n9592:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000668 \"BTO:0002174\")\n9593:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000668 \"FMA:84638\")\n9600:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n9601:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000669 \"BTO:0002441\")\n9602:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000669 \"FMA:63174\")\n9603:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17986482\") oboInOwl:hasExactSynonym obo:CL_0000669 \"ARC\")\n9604:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000669 \"adventitial reticular cell\")\n9605:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000669 \"cell of Rouget\")\n9606:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000669 \"pericyte cell\")\n9607:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000669 \"pericyte of Rouget\")\n9608:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000669 \"adventitial cell\")\n9618:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:1381289\") obo:IAO_0000115 obo:CL_0000670 \"A primordial germ cell is a diploid germ cell precursors that transiently exist in the embryo before they enter into close association with the somatic cells of the gonad and become irreversibly committed as germ cells.\")\n9619:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000670 \"FMA:70567\")\n9620:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000670 \"gonocyte\")\n9621:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000670 \"primitive germ cell\")\n9629:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36807509\") obo:IAO_0000115 obo:CL_0000671 \"A follicle cell that migrates from the dorso-anterior part of the oocyte associated follicular epithelium, in between the nurse cells and the oocyte, and participates in the formation of the operculum.\")\n9630:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000671 \"centripetal follicle cell\")\n9636:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0471245208\") obo:IAO_0000115 obo:CL_0000672 \"Obsolete. Use PO:0000290 from Plant Ontology instead. A water conducting cell, tracheid or vessel member.\")\n9643:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/S1467-8039(03)00009-4\") obo:IAO_0000115 obo:CL_0000673 \"An intrinsic neuron of the mushroom body of arthropods and annelids. They have tightly packed, cytoplasm-poor cell bodies.\")\n9644:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000673 \"mushroom body intrinsic neuron\")\n9645:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000673 \"globuli cell\")\n9652:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36531940\") obo:IAO_0000115 obo:CL_0000674 \"A follicle cell that is part of the stalk connecting adjacent egg chambers.\")\n9653:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000674 \"stalk cell\")\n9654:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000674 \"stalk follicle cell\")\n9660:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000675 \"A mature sexual reproductive cell of the female germline.\")\n9667:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000676 \"BTO:0001033\")\n9673:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000677 \"Cell of the intestinal epithelium with a brush border made up of many parallel packed microvilli; associated with absorption, particularly of macromolecules.\")\n9680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17560562\") Annotation(oboInOwl:hasDbXref \"PMID:31693445\") obo:IAO_0000115 obo:CL_0000678 \"A neuron with soma location in the central nervous system that project its axon to the contralateral side of a central nervous system. This neuron can have its soma in the spinal cord, in the hemisphere of the brain, in the retina or in the ventral nerve cord of invertebrates.\")\n9681:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25960414\") Annotation(oboInOwl:hasDbXref \"PMID:27532244\") Annotation(oboInOwl:hasDbXref \"PMID:31514748\") Annotation(oboInOwl:hasDbXref \"PMID:33438755\") rdfs:comment obo:CL_0000678 \"Historically, commissural neurons, particularly in the spinal cord, have been used as a model to understand axon guidance during development.\")\n9688:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000679 \"A neuron that is capable of some neurotansmission by glutamate secretion.\")\n9689:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000679 \"WBbt:0006829\")\n9696:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000680 \"A non-terminally differentiated cell that is capable of developing into a muscle cell.\")\n9704:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dph\") obo:IAO_0000115 obo:CL_0000681 \"A cell present in the developing CNS. Functions as both a precursor cell and as a scaffold to support neuronal migration.\")\n9705:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000681 \"forebrain radial glial cell\")\n9714:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:jb\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000682 \"An absorptive cell of the gut epithelium that endocytoses microorganisms and intact macromolecules from the gut lumen and transports them to the subepithelial space where they are presented to antigen-presenting cells and lymphocytes.\")\n9715:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000682 \"M cell\"@en)\n9716:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000682 \"BTO:0003600\")\n9717:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000682 \"FMA:62929\")\n9718:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000682 \"M-cell\")\n9719:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000682 \"microfold cell\")\n9727:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"http://neurolex.org/wiki/Category:Ependymoglial_Cell\") obo:IAO_0000115 obo:CL_0000683 \"A cell that transports hormones from neurosecretory cells. This nerve cell is characterized by bipolar shape and endfeet that contact a basal lamina around blood vessels, and/or the pia mater or vitreous body of the eye and additionally contact the ventricular surface or sub-retinal space.\")\n9728:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000683 \"MESH:D063928\")\n9729:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000683 \"ependymal astrocyte\")\n9741:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PO:0004010\") obo:IAO_0000115 obo:CL_0000685 \"Obsolete. Use PO:0004010 from Plant Ontology instead. A cell synthesizing protoplasm and producing new cells by division and with only a primary cell wall.\")\n9748:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000686 \"A columnar/cuboidal epithelial cell that secretes cerebrospinal fluid.\")\n9757:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000687 \"R1 cell\")\n9764:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\n9771:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000689 \"A cell with both myofibrils and secretory granules.\")\n9777:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000690 \"R2 cell\")\n9784:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000691 cl:BDS_subset)\n9790:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:16136171\") obo:IAO_0000115 obo:CL_0000692 \"A neuroglial cell of the peripheral nervous system inside the basal lamina of the neuromuscular junction providing chemical and physical support to the synapse.\")\n9791:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000692 \"Schwann cell\")\n9792:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18803315\") oboInOwl:hasExactSynonym obo:CL_0000692 \"perisynaptic Schwann cell\")\n9793:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18803315\") oboInOwl:hasExactSynonym obo:CL_0000692 \"teloglia\")\n9794:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18803315\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000692 \"tSC\")\n9801:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:17122314\") obo:IAO_0000115 obo:CL_0000693 \"An interneuron that has spider-like appearance with a small round soma, a large number (7-10) of short, smooth, or slightly beaded primary dendrites that give rise to only a few secondary branches, and a branched axon that establishes a dense axonal mesh with thin shafts.\")\n9802:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18568015\") oboInOwl:hasExactSynonym obo:CL_0000693 \"NGF cell\")\n9803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:3235828\") oboInOwl:hasExactSynonym obo:CL_0000693 \"neuroglioform cell\")\n9804:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000693 \"spiderweb cell\")\n9805:AnnotationAssertion(oboInOwl:inSubset obo:CL_0000693 cl:BDS_subset)\n9811:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000694 \"R3 cell\")\n9818:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10600995\") Annotation(oboInOwl:hasDbXref \"PMID:34047341\") Annotation(oboInOwl:hasDbXref \"PMID:36774666\") Annotation(oboInOwl:hasDbXref \"PMID:37775311\") Annotation(oboInOwl:hasDbXref \"PMID:9728912\") obo:IAO_0000115 obo:CL_0000695 \"A type of transient, early-born glutamatergic neuron located primarily in the marginal zone (future layer I) of the developing cerebral cortex and hippocampus in vertebrates. it is characterized by a bipolar morphology with an elongated soma, a single thick dendrite oriented toward the pial surface, and a long, thin axon that extends tangentially to form horizontal plexuses across the cortical surface. It is important for the multiple developmental processes including migration, dendritogenesis and synaptogenesis. It typically undergoes programmed cell death following cortical maturation with species- and region specific patterns of survival. In mice, it is predominantly observed in the hippocampal formation, particularly in the stratum lacunosum-moleculare and outer molecular layer of the dentate gyrus (van Bruggen et al., 2023). In contrast, in humans, a second morphologically distinct subpopulation emerges mid-gestation and persists postnatally, with surviving cells observed in the cortical sulci and the hippocampus.\")\n9820:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Cajal–Retzius_cell&oldid=1032081753\") oboInOwl:hasExactSynonym obo:CL_0000695 \"CR cells\")\n9821:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"WikipediaVersioned:Cajal–Retzius_cell&oldid=1032081753\") oboInOwl:hasExactSynonym obo:CL_0000695 \"Horizontal cells of Cajal\")\n9822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10600995\") rdfs:comment obo:CL_0000695 \"While previously called 'pioneer neurons' of the marginal zone, Cajal-Retzius cells are differentiated from pioneer neurons (which are Reln-negative) by their Reln-immunoreactivity.\")\n9831:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:15153415\") obo:IAO_0000115 obo:CL_0000696 \"A cell that stores and secretes pancreatic polypeptide hormone.\")\n9832:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000696 \"FMA:62938\")\n9833:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000696 \"FMA:83409\")\n9834:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000696 \"type F enteroendocrine cell\")\n9841:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000697 \"R4 cell\")\n9853:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000699 \"A type of glomus or chief cell, is sensitive to hypoxia and produce catecholamines.\")\n9859:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dhill\") obo:IAO_0000115 obo:CL_0000700 \"A neuron that releases dopamine as a neurotransmitter.\")\n9860:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000700 \"BTO:0004032\")\n9861:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000700 \"FMA:84787\")\n9862:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000700 \"MESH:D059290\")\n9863:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000700 \"WBbt:0006746\")\n9864:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000700 \"dopaminergic cell\")\n9872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000701 \"Supports paraganglial type 1 cell.\")\n9878:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000702 \"R5 cell\")\n9885:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000703 \"Cell that provides some or all mechanical, nutritional and phagocytic support to their neighbors.\")\n9886:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000703 \"BTO:0002315\")\n9892:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15376331\") obo:IAO_0000115 obo:CL_0000704 \"A specialized endothelial cell that senses extracellular signals and guides the directed growth of blood vessels.\")\n9898:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000705 \"R6 cell\")\n9905:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"JB:jb\") Annotation(oboInOwl:hasDbXref \"PMID:15561411\") Annotation(oboInOwl:hasDbXref \"PMID:9550134\") obo:IAO_0000115 obo:CL_0000706 \"A specialized ependymal cell that is part of the choroid plexus epithelium, responsible for producing cerebrospinal fluid (CSF) by selectively filtering and modifying blood plasma components before secreting it into the brain and spinal cord. This cell is characterized by a brush border on its apical surface, which enhances the secretion of CSF.\")\n9907:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1101/2022.10.12.511898\") oboInOwl:hasBroadSynonym obo:CL_0000706 \"choroid plexus cell\")\n9908:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000706 \"FMA:70549\")\n9909:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000706 \"epithelial cell of choroid plexus\")\n9910:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25729351\") rdfs:comment obo:CL_0000706 \"A choroid plexus epithelial cell possesses non-motile 9+0 cilia. While these cilia can exhibit transient motility during development, they generally do not contribute significantly to the directional flow of cerebrospinal fluid (CSF). Instead, they are primarily involved in sensory functions.\")\n9918:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000707 \"R7 cell\")\n9925:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000708 \"Stromal cell that forms the internal covering of the vertebrate brain and produces ECM for this and the choroid plexus.\")\n9926:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000708 \"leptomemingeal cell\")\n9934:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000709 \"R8 cell\")\n9941:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000710 \"Epithelial cells derived from neural plate and neural crest.\")\n9942:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000710 \"neuroepithelial cell\")\n9943:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000710 \"BTO:0004301\")\n9944:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000710 \"FMA:70557\")\n9952:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.org/cope.cgi?key=cumulus%20cells\") obo:IAO_0000115 obo:CL_0000711 \"Cumulus cell is a specialized granulosa cell that surrounds and nourishes the oocyte. This cell-type surrounds the fully-grown oocyte to form a cumulus-oocyte complex (abbr. COC). The terms cumulus oophorus cells, cumulus granulosa cells, cumulus oophorous granulosa cells, granulosa-cumulus cells are used to make a distinction between this cell and the other functionally different subpopulation of granulosa cells at the wall of the Graafian follicle.\")\n9953:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000711 \"BTO:0002236\")\n9954:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000711 \"MESH:D054885\")\n9955:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000711 \"cumulus cell\")\n9981:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000715 \"A crystal cell that derives from the embryonic head mesoderm.\")\n9988:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000716 \"A crystal cell that derives from the larval lymph gland.\")\n9995:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15582775\") obo:IAO_0000115 obo:CL_0000717 \"OBSOLETE. A subset of motor neurons that innervates intrafusal muscle fibers and has small diameter axons.\")\n10004:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34343526\") Annotation(oboInOwl:hasDbXref \"doi:10.1017/CBO9780511818202.023\") obo:IAO_0000115 obo:CL_0000718 \"A cell of an ommatidium that secretes lens materials.\")\n10005:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000718 \"Semper cell\")\n10006:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000718 \"cone cell (sensu Endopterygota)\")\n10007:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1242/jcs.s3-105.71.331\") rdfs:comment obo:CL_0000718 \"Not to be confused with the Semper cells of the Semper organ found in gastropods.\")\n10035:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0048103\") obo:IAO_0000115 obo:CL_0000723 \"A stem cell that can give rise to cell types of the body other than those of the germ-line.\")\n10036:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000723 \"CALOHA:TS-2086\")\n10037:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000723 \"MESH:D053687\")\n10043:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000724 \"A differentiated cell that functions as a site of nitrogen fixation under aerobic conditions.\")\n10044:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000724 \"BTO:0000600\")\n10056:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:085199377X\") obo:IAO_0000115 obo:CL_0000726 \"An asexual 1-celled spore (primarily for perennation, not dissemination). Originates endogenously and singly within part of a pre-existing cell by the contraction of the protoplast. Possesses an inner secondary and often thickened hyaline or brown wall, usually impregnated with hydrophobic material.\")\n10084:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000730 \"A cell at the front of a migrating epithelial sheet.\")\n10090:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MA:ma\") Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41385-022-00565-0\") obo:IAO_0000115 obo:CL_0000731 \"A cell of a layer of transitional epithelium in the wall of the proximal urethra, bladder, ureter or renal pelvis, external to the lamina propria.\")\n10091:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000731 \"FMA:84127\")\n10092:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000731 \"urinary tract transitional epithelial cell\")\n10103:AnnotationAssertion(obo:IAO_0000115 obo:CL_0000733 \"A plasmatocyte that derives from the larval lymph gland.\")\n10117:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1242/dev.00702\") obo:IAO_0000115 obo:CL_0000735 \"A hemocyte that derives from the larval lymph gland.\")\n10130:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000737 \"Muscle cell which has as its direct parts myofilaments organized into sarcomeres.\")\n10131:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000737 \"BTO:0002916\")\n10132:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000737 \"CALOHA:TS-2157\")\n10133:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000737 \"FMA:86936\")\n10141:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:978-0-323-05290-0\") obo:IAO_0000115 obo:CL_0000738 \"An achromatic cell of the myeloid or lymphoid lineages capable of ameboid movement, found in blood or other tissue.\")\n10142:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000738 \"BTO:0000751\")\n10143:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000738 \"CALOHA:TS-0549\")\n10144:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000738 \"FMA:62852\")\n10145:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000738 \"MESH:D007962\")\n10146:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000738 \"NCIT:C12529\")\n10147:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000738 \"leucocyte\")\n10148:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000738 \"white blood cell\")\n10149:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000738 \"immune cell\")\n10165:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dph\") obo:IAO_0000115 obo:CL_0000740 \"The set of neurons that receives neural inputs via bipolar, horizontal and amacrine cells. The axons of these cells make up the optic nerve.\")\n10166:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000740 \"BTO:0001800\")\n10167:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000740 \"FMA:67765\")\n10168:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000740 \"MESH:D012165\")\n10169:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000740 \"gangliocyte\")\n10170:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000740 \"ganglion cell of retina\")\n10171:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000740 \"RGC\")\n10172:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000740 \"RGCs\")\n10179:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16267219\") obo:IAO_0000115 obo:CL_0000741 \"A motor neuron that is located in the cervical region of the spinal cord and selectively innervates the sternocleidmastoid or trapezius muscle. Unlike other motor neurons, they extend axons dorsally along lateral margins of the spinal cord.\")\n10180:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000741 \"SACMN\")\n10186:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15951842\") obo:IAO_0000115 obo:CL_0000742 \"A round chondrocyte that first differentiates in the late embryonic growth plate of bone.\")\n10193:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") Annotation(oboInOwl:hasDbXref \"PMID:15951842\") Annotation(oboInOwl:hasDbXref \"PMID:25321476\") Annotation(oboInOwl:hasDbXref \"PMID:35179487\") obo:IAO_0000115 obo:CL_0000743 \"A chondrocyte that is part of the hypertrophic cartilage zone. This cell is significantly enlarged and characterised by high expression of type X collagen (COL10A1) in both humans and mice. It actively coordinates endochondral ossification by mineralising the extracellular matrix, attracting blood vessels via angiogenic signalling, and mediating the transition from cartilage to bone - often by transdifferentiating into an osteoblast rather than undergoing apoptosis.\")\n10194:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35179487\") rdfs:comment obo:CL_0000743 \"Despite historical descriptions as 'terminally differentiated,' hypertrophic chondrocytes survive and transdifferentiate into osteoblasts. Genetic lineage tracing shows that hypertrophic chondrocytes do not simply undergo apoptosis but cross the cartilage–bone boundary, dedifferentiate into skeletal stem/progenitor cells, and then redifferentiate into osteoblasts and osteocytes. Single-cell RNA-seq further indicates that these chondrocyte-derived SSPCs are a major source of trabecular osteoblasts and marrow adipocytes.\")\n10202:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15951842\") obo:IAO_0000115 obo:CL_0000744 \"A columnar chondrocyte that differentiates in the late embryonic growth plate of bone. Columnar chondrocytes vigorously proliferate and form columns in the growth plate.\")\n10208:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0195088433\") obo:IAO_0000115 obo:CL_0000745 \"A neuron that laterally connects other neurons in the inner nuclear layer of the retina.\")\n10209:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000745 \"BTO:0004120\")\n10210:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000745 \"horizontal cell\")\n10211:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000745 \"HC\")\n10212:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000745 \"HCs\")\n10219:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mtg_cardiacconduct_nov11\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0323052908\") Annotation(oboInOwl:hasDbXref \"PMID:22426062\") Annotation(oboInOwl:hasDbXref \"PMID:4711263\") obo:IAO_0000115 obo:CL_0000746 \"Cardiac muscle cells are striated muscle cells that are responsible for heart contraction. In mammals, the contractile fiber resembles those of skeletal muscle but are only one third as large in diameter, are richer in sarcoplasm, and contain centrally located instead of peripheral nuclei.\")\n10220:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000746 \"cardiocyte\")\n10221:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000746 \"BTO:0001539\")\n10222:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000746 \"CALOHA:TS-0115\")\n10223:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000746 \"FMA:14067\")\n10224:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000746 \"MESH:D032383\")\n10225:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0048739\") oboInOwl:hasExactSynonym obo:CL_0000746 \"cardiac muscle fiber\")\n10226:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000746 \"cardiac myocyte\")\n10227:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000746 \"cardiomyocyte\")\n10228:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000746 \"heart muscle cell\")\n10236:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000747 \"A pigment cell derived from the neural crest. Contains blue pigment of unknown chemical composition in fibrous organelles termed cyanosomes. This gives a blue appearance.\")\n10237:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000747 \"blue chromatophore\")\n10244:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000748 \"A bipolar neuron found in the retina and having connections with photoreceptors cells and neurons in the inner plexiform layer.\")\n10245:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0000748 \"BC\")\n10246:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41598-020-66092-9\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000748 \"BCs\")\n10247:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"geo:GSE137537\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:CL_0000748 \"BPs\")\n10256:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000749 \"A bipolar neuron found in the retina and having connections with photoreceptors cells and neurons in the inner half of the inner plexiform layer. These cells depolarize in response to light stimulation of their corresponding photoreceptors.\")\n10262:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000750 \"A bipolar neuron found in the retina and having connections with photoreceptors cells and neurons in the outer half of the inner plexiform layer. These cells depolarize in response to light to dark transition.\")\n10268:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000751 \"A bipolar neuron found in the retina that is synapsed by rod photoreceptor cells but not by cone photoreceptor cells.  These neurons depolarize in response to light.\")\n10269:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38627529\") obo:RO_0002175 obo:CL_0000751 obo:NCBITaxon_32443)\n10270:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000751 \"FMA:67750\")\n10279:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000752 \"A bipolar neuron found in the retina and having connections with cone photoreceptor cells and neurons in the inner plexiform layer.\")\n10286:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000753 \"An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The cell body of these cells is in the middle of the inner plexiform layer. The dendritic tree is stout and the axon terminates in sublamina 1. The axonal terminal is wide and has only a few varicosities.\")\n10287:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000753 \"DB1 cone bipolar cell\")\n10295:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") Annotation(oboInOwl:hasDbXref \"PMID:27565351\") obo:IAO_0000115 obo:CL_0000754 \"An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The dendritic tree is not well filled and the dendrites are more delicate than in type 1 cells. The axon terminal is bushier and exhibits a dense plexus of varicosities in the inner part of sublamina 1 (Ghosh et al., 2004).  It can be differentiated from other retinal bipolar neurons by its expression of marker genes: Neto1, Lhx3 and Irx-6 (Shekhar, 2016).\")\n10296:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000754 \"FMB cone bipolar cell\")\n10298:EquivalentClasses(Annotation(oboInOwl:hasDbXref \"PMID:27565351\") obo:CL_0000754 ObjectIntersectionOf(obo:CL_0000748 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P50481) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q8R4I7) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9ER75)))\n10305:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000755 \"An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The dendritic tree is delicate and the dendritic tips appear small when compared with type 1 cells. The axon terminal is stratified and restricted to sublamina 2 of the inner plexiform layer.\")\n10306:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000755 \"DB2 cone bipolar cell\")\n10315:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000756 \"An OFF-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the outer half of the inner plexiform layer. The cell has a diffuse axon terminal with varicosities in sublaminae 1 and 2 of the inner plexiform layer.\")\n10316:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000756 \"DB3 cone bipolar cell\")\n10326:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000757 \"An ON-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the inner half of the inner plexiform layer. The axon terminal is restricted to sublamina 3 of the inner plexiform layer. It is narrowly stratified and branched. The dendritic tree has many delicate branches.\")\n10327:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000757 \"DB4 cone bipolar cell\")\n10335:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000758 \"An ON-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the inner half of the inner plexiform layer. The cell has a loose, delicate axon terminal that opens in sublamina 3 of the inner plexiform layer and descends into sublamina 4.\")\n10336:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000758 \"DB5 cone bipolar cell\")\n10344:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000759 \"An ON-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the inner half of the inner plexiform layer. The axon terminal is narrowly stratified and are found just below a calretinin-expressing band in sublamina 4 of the inner plexiform layer.\")\n10345:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000759 \"IMB cone bipolar cell\")\n10353:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000760 \"An ON-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the inner half of the inner plexiform layer. This cell has the widest dendritic field and the widest axon terminal of all retinal bipolar cells. The axon terminal is delicate and stratified through sublaminae 4 and 5 of the inner plexiform layer.\")\n10354:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000760 \"DB6 cone bipolar cell\")\n10363:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14689473\") obo:IAO_0000115 obo:CL_0000761 \"An ON-bipolar neuron found in the retina and having connections with cone photoreceptors cells and neurons in the inner half of the inner plexiform layer. The dendritic tree is wide and the dendritic convergence indicates cone selectivity. The axon terminal is sparsely branched and terminates in sublamina 5 of the inner plexiform layer.\")\n10364:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000761 \"BB cone bipolar cell\")\n10372:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:16360205\") obo:IAO_0000115 obo:CL_0000762 \"A nucleated blood cell involved in coagulation, typically seen in birds and other non-mammalian vertebrates.\")\n10381:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000763 \"A cell of the monocyte, granulocyte, mast cell, megakaryocyte, or erythroid lineage.\")\n10382:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000763 \"BTO:0001441\")\n10383:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000763 \"CALOHA:TS-0647\")\n10384:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000763 \"MESH:D022423\")\n10391:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000764 \"A immature or mature cell in the lineage leading to and including erythrocytes.\")\n10392:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000764 \"CALOHA:TS-0290\")\n10393:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000764 \"FMA:62845\")\n10394:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000764 \"FMA:83516\")\n10395:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000764 \"erythropoietic cell\")\n10402:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18174176\") obo:IAO_0000115 obo:CL_0000765 \"A nucleated precursor of an erythrocyte that lacks hematopoietic lineage markers.\")\n10403:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000765 \"BTO:0001571\")\n10404:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000765 \"CALOHA:TS-0289\")\n10405:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000765 \"FMA:83504\")\n10406:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000765 \"MESH:D004900\")\n10407:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000765 \"normoblast\")\n10415:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000766 \"A cell of the monocyte, granulocyte, or mast cell lineage.\")\n10422:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"MESH:D001491\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") Annotation(oboInOwl:hasDbXref \"PMID:11927641\") Annotation(oboInOwl:hasDbXref \"PMID:19741522\") Annotation(oboInOwl:hasDbXref \"PMID:21236338\") Annotation(oboInOwl:hasDbXref \"PMID:9933081\") obo:IAO_0000115 obo:CL_0000767 \"Any of the immature or mature forms of a granular leukocyte that in its mature form has an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse, bluish-black granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation. A basophil is CD123-positive, CD193-positive, CD203c-positive, and FceRIa-positive.\")\n10423:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000767 \"polymorphonuclear leucocyte\")\n10424:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000767 \"polymorphonuclear leukocyte\")\n10425:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000767 \"BTO:0000129\")\n10426:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000767 \"CALOHA:TS-0073\")\n10427:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000767 \"FMA:62862\")\n10428:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000767 \"basophilic leucocyte\")\n10429:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000767 \"basophilic leukocyte\")\n10437:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000768 \"Any of the immature forms of a basophil, in which basophilic specific granules are present but other phenotypic features of the mature form may be lacking.\")\n10438:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000768 \"immature basophilic leucocyte\")\n10439:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000768 \"immature basophilic leukocyte\")\n10447:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18466030\") obo:IAO_0000115 obo:CL_0000769 \"A basophil precursor in the granulocytic series, being a cell intermediate in development between a basophilic myelocyte and a band form basophil. The nucleus becomes indented where the indentation is smaller than half the distance to the farthest nuclear margin; chromatin becomes coarse and clumped; specific granules predominate while primary granules are rare. Markers are CD11b-positive, CD15-positive, CD16-positive, CD24-positive, CD33-positive, and CD13-positive.\")\n10448:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000769 \"FMA:84198\")\n10457:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:18466030\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000770 \"A late basophilic metamyelocyte in which the nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature basophil.\")\n10465:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2626675\") Annotation(oboInOwl:hasDbXref \"PMID:10914487\") Annotation(oboInOwl:hasDbXref \"PMID:1662676\") obo:IAO_0000115 obo:CL_0000771 \"Any of the immature or mature forms of a granular leukocyte with a nucleus that usually has two lobes connected by one or more slender threads of chromatin, and cytoplasm containing coarse, round granules that are uniform in size and which can be stained by the dye eosin. Eosinophils are CD9-positive, CD191-positive, and CD193-positive.\")\n10466:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000771 \"polymorphonuclear leucocyte\")\n10467:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0000771 \"polymorphonuclear leukocyte\")\n10468:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000771 \"BTO:0000399\")\n10469:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000771 \"CALOHA:TS-0279\")\n10470:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000771 \"FMA:62861\")\n10471:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000771 \"MESH:D004804\")\n10472:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000771 \"eosinocyte\")\n10473:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000771 \"eosinophilic granulocyte\")\n10474:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000771 \"eosinophilic leucocyte\")\n10475:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000771 \"eosinophilic leukocyte\")\n10476:AnnotationAssertion(rdfs:comment obo:CL_0000771 \"Eosinophils are also CD14-negative, CD32-positive, CD44-positive, CD48-positive, CD69-positive, CD192-negative, MBP1-positive, MBP2-positive, TLR2-negative, TLR4-negative, and lineage-negative (B220, CD2, CD14, CD19, CD56, CD71, CD117, CD123, CD235a (glycophorin A), and TER119). The cytokines IL-3, IL-5, and GM-CSF are involved in their development and differentiation. Usually considered CD16-negative, CD16 is observed on eosinophilic metamyelocyte.\")\n10483:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000772 \"Any of the immature forms of an eosinophil, in which eosinophilic specific granules are present but other phenotypic features of the mature form may be lacking.\")\n10484:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000772 \"immature eosinocyte\")\n10485:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000772 \"immature eosinophilic leucocyte\")\n10486:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000772 \"immature eosinophilic leukocyte\")\n10494:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:19622087\") obo:IAO_0000115 obo:CL_0000773 \"A eosinophil precursor in the granulocytic series, being a cell intermediate in development between a eosinophilic myelocyte and a band form eosinophil. The nucleus becomes indented where the indentation is smaller than half the distance to the farthest nuclear margin; chromatin becomes coarse and clumped; specific granules predominate while primary granules are rare. Markers are integrin alpha-M-positive, fucosyltransferase FUT4-positive, low affinity immunoglobulin gamma Fc region receptor III-positive, CD33-positive, CD24-positive and aminopeptidase N-negative.\")\n10503:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") Annotation(oboInOwl:hasDbXref \"PMID:19622087\") Annotation(oboInOwl:hasDbXref \"http://www.cap.org\") obo:IAO_0000115 obo:CL_0000774 \"A late eosinophilic metamyelocyte in which the nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature eosinophil.\")\n10511:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721601464\") obo:IAO_0000115 obo:CL_0000775 \"Any of the immature or mature forms of a granular leukocyte that in its mature form has a nucleus with thre