asExactSynonym obo:CL_1001435 \"olfactory bulb periglomerular cell\")\n28595:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0000977\") obo:IAO_0000115 obo:CL_1001436 \"The subcutaneous mechanoreceptors that innervate tylotrich hair follicles.\")\n28601:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0000979\") obo:IAO_0000115 obo:CL_1001437 \"The subcutaneous mechanoreceptors that innervate vellus hairs.\")\n28607:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004297\") obo:IAO_0000115 obo:CL_1001451 \"A sensory neuron of the dorsal root ganglia that senses body position and sends information about how much the muscle is stretched to the spinal cord.\")\n28608:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004297\") oboInOwl:hasExactSynonym obo:CL_1001451 \"proprioceptive neuron\")\n28616:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0008462\") Annotation(oboInOwl:hasDbXref \"doi:10.1073/pnas.242428599\") obo:IAO_0000115 obo:CL_1001474 \"An inhibitory, GABAergic projection neuron in the striatum that integrates glutamatergic signals arising from the cerebral cortex and thalamus.\")\n28617:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_1001474 \"BTO:0004778\")\n28618:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1073/pnas.242428599\") oboInOwl:hasExactSynonym obo:CL_1001474 \"gamma-aminobutyric acid (GABA)ergic spiny projection neuron\")\n28619:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1073/pnas.242428599\") oboInOwl:hasExactSynonym obo:CL_1001474 \"gamma-aminobutyric acid ergic spiny projection neuron\")\n28620:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0021773\") oboInOwl:hasExactSynonym obo:CL_1001474 \"striatal medium spiny neuron\")\n28621:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"BTO:0004778\") oboInOwl:hasRelatedSynonym obo:CL_1001474 \"medium-sized densely spiny neuron\")\n28622:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1038/s41420-022-01088-0\") Anno