tion(Annotation(oboInOwl:hasDbXref \"ISBN:0878932437\") oboInOwl:hasRelatedSynonym obo:CL_0001059 \"multipotential myeloid stem cell\")\n13627:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0878932437\") oboInOwl:hasRelatedSynonym obo:CL_0001059 \"myeloid stem cell\")\n13628:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0878932437\") oboInOwl:hasRelatedSynonym obo:CL_0001059 \"pluripotent stem cell (bone marrow)\")\n13636:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19022770\") obo:IAO_0000115 obo:CL_0001060 \"A hematopoietic oligopotent progenitor cell that has the ability to differentiate into limited cell types but lacks lineage cell markers and self renewal capabilities. Cell lacks hematopoeitic lineage markers.\")\n13647:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:cg\") Annotation(oboInOwl:hasDbXref \"GOC:wdd\") obo:IAO_0000115 obo:CL_0001061 \"A cell found in an organism or derived from an organism exhibiting a phenotype that deviates from the expected phenotype of any native cell type of that organism. Abnormal cells are typically found in disease states or disease models.\")\n13650:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0001061 \"https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&code=C12913\")\n13658:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:dos\") Annotation(oboInOwl:hasDbXref \"PMID:15032595\") Annotation(oboInOwl:hasDbXref \"PMID:16237082\") Annotation(oboInOwl:hasDbXref \"PMID:26883338\") obo:IAO_0000115 obo:CL_0001062 \"A CD8-positive, alpha beta memory T cell with the phenotype CD45RA-positive, CD45RO-negative, and CCR7-negative.\")\n13659:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15032595\") oboInOwl:hasBroadSynonym obo:CL_0001062 \"TEMRA\")\n13660:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15032595\") oboInOwl:hasExactSynonym obo:CL_0001062 \"CD8+ TEMRA\")\n13661:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15032595\") oboInOwl:hasExactSynonym obo:CL_0001062 \"CD8-positive TEMRA\")\n13671:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:cg\") Annotation(oboInOwl:hasDbXref \"GOC:wdd\") obo:IAO_0000115 obo:CL_0001063 \"An abnormal cell exhibiting dysregulation of cell proliferation or programmed cell death and capable of forming a neoplasm, an aggregate of cells in the form of a tumor mass or an excess number of abnormal cells (liquid tumor) within an organism.\")\n13674:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0001063 \"https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&code=C12922\")\n13675:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0001063 \"tumor cell\")\n13676:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0001063 \"tumour cell\")\n13684:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:cg\") Annotation(oboIts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25707:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020026 \"An alpha retinal ganglion cell subtype found in the mouse retina that responds selectively and transiently to decreases in light intensity. It is characterized by a large soma, a broad dendritic arbor that stratifies within sublamina a of the inner plexiform layer, and rapid OFF-transient firing kinetics that decay even during sustained stimulation (Krieger et al., 2017). Functionally, it corresponds to G8 in the Baden functional classification (Baden et al., 2016; Goetz et al., 2022) and C45 in the Tran transcriptomic atlas (Tran et al., 2019), and it is considered the evolutionary ortholog of the primate OFF Parasol RGC (Hahn et al., 2023). This cell type acts as a detector of rapidly approaching dark objects and contributes to innate defensive responses by encoding looming stimuli (Münch et al., 2009). It exhibits a distinctive molecular signature by its expression of Brn3c (Krieger et al., 2017).\")\n25712:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020026 \"alpha retinal ganglion cell OFF-t\")\n25713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020026 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020027 \"An alpha retinal ganglion cell subtype in the mouse retina that responds selectively and transiently to increases in light intensity. It possesses the large soma and expansive dendritic field characteristic of alpha RGCs (Krieger et al., 2017). This cell exhibits a brief, fast-decaying burst of firing at the onset of light increments and contributes to motion detection for luminance increases, forming the ON-branch of the transient magnocellular-like pathway (Krieger et al., 2017; Hahn et al., 2023). Functionally, it corresponds to cluster G19 and aligns transcriptomically with cluster C41 (Krieger et al., 2017; Tran et al., 2019). It is orthologous to the primate ON Parasol RGC (Hahn et al., 2023). Molecularly, it expresses Spp1, Smi32, and Brn3b, but lacks Brn3a, Brn3c, and Calbindin (Krieger et al., 2017).\")\n25726:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31784286\") oboInOwl:hasExactSynonym obo:CL_0020027 \"C41\")\n25727:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") oboInOwl:hasExactSynonym obo:CL_0020027 \"G19\")\n25728:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28753612\") oboInOwl:hasRelatedSynonym obo:CL_0020027 \"alpha retinal ganglion cell ON-t\")\n25729:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") rdfs:comment obo:CL_0020027 \"The G-type nomenclature used here refers specifically to the functional classification of mouse retinal ganglion cells introduced by Baden and colleagues, and is distinct from earlier G-based schemes used for rabbit or other species. Readers should be aware that the same letter–number labels (e.g., \\\"G1\\\", \\\"G2\\\") have been applied in different historical contexts to different animals and criteria (functional vs. morphological), so cross-species or cross-era comparisons of \\\"G\\\" names should not be assumed equivalent without explicit mapping in the primary literature.\")\n25737:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24051376\") Annotation(oboInOwl:hasDbXref \"PMID:31300091\") Annotation(oboInOwl:hasDbXref \"PMID:32016094\") obo:IAO_0000115 obo:CL_0700009 \"OBSOLETE. A renal beta-intercalated cell that is part of the cortical collecting duct. The medullary collecting duct does not contain the renal beta-intercalated cell type.\")\n25740:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32016094\") oboInOwl:hasExactSynonym obo:CL_0700009 \"B-IC\")\n25741:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31300091\") oboInOwl:hasExactSynonym obo:CL_0700009 \"kidney collecting duct intercalated cell type B\")\n25809:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") obo:IAO_0000115 obo:CL_1000147 \"A cell that is part of a cardiac valve.\")\n25810:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30796046\") oboInOwl:hasExactSynonym obo:CL_1000147 \"heart valve cell\")\n25816:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:0061330\") obo:IAO_0000115 obo:CL_1000155 \"A specialized epithelial secretory cell that moves chloride ions and water across the tubule epithelium.\")\n25817:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FBbt:00005797\") oboInOwl:hasExactSynonym obo:CL_1000155 \"Malpighian tubule Type II cell\")\n25829:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12417662\") obo:IAO_0000115 obo:CL_1000191 \"A rod-like cell in the inner ear, having their heads joined and their bases on the basilar membrane widely separated so as to form a spiral tunnel known as the tunnel of Corti.\")\n25830:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_1000191 \"FMA:75722\")\n25831:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1000191 \"pillar cell of cochlea\")\n25832:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1000191 \"pillar cell of corti\")\n25833:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1000191 \"rod cell of Corti\")\n25834:AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_1000191 \"cochlear pillar cell\")\n25845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15153415\") obo:IAO_0000115 obo:CL_1000222 \"A specialised neuroendocrine cell located in the gastric mucosa that regulates digestive processes including acid secretion and gut motility. This cell stores hormones in large dense core vesicles and synaptic-like microvesicles.\")\n25846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15153415\") oboInOwl:hasBroadSynonym obo:CL_1000222 \"DES cell\")\n25847:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15153415\") oboInOwl:hasBroadSynonym obo:CL_1000222 \"diffuse endocrine system cell\")\n25854:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33355253\") Annotation(oboInOwl:hasDbXref \"doi:10.3109/01902148209069653\") Annotation(oboInOwl:hasDbXref \"doi:10.7554/eLife.78216\") obo:IAO_0000115 obo:CL_1000223 \"A neuroendocrine cell that is part of respiratory epithelium of the lung and is involved in the sensory detection of environmental stimuli, including hypoxia, nicotine and air pressure. Ultrastructurally, this cell type is characterized by the presence of cytoplasmic dense core granules, which are considered the storage sites of amine and peptide hormones. Pulmonary neuroendocrine cells are innervated and appear as solitary cells or as clustered masses, localized at airway bifurcation sites, called neuroepithelial bodies that can release serotonin in response to hypoxia and interact with sensory nerve terminals. Pulmonary neuroendocrine cells also function as reserve stem cells that repair the surrounding epithelium after injury.\")\n25855:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15018448\") oboInOwl:hasExactSynonym obo:CL_1000223 \"lung neuroendocrine cell\")\n25856:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33355253\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_1000223 \"PNEC\")\n25881:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27864314\") obo:IAO_0000115 obo:CL_1000271 \"An epithelial cell that is part of the lung epithelium. This cell is characterised by the presence of cilia on its apical surface.\")\n25882:AnnotationAssertion(oboInOwl:hasExactSynony