ectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n24728:SubClassOf(obo:CL_0011006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002979))\n24729:SubClassOf(obo:CL_0011006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n24730:SubClassOf(obo:CL_0011006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061537))\n24779:EquivalentClasses(obo:CL_0011013 ObjectIntersectionOf(obo:CL_0000019 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0097722)))\n24800:EquivalentClasses(obo:CL_0011016 ObjectIntersectionOf(obo:CL_0011013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030317)))\n24870:EquivalentClasses(obo:CL_0011024 ObjectIntersectionOf(obo:CL_0002489 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0050777)))\n24989:EquivalentClasses(obo:CL_0011105 ObjectIntersectionOf(obo:CL_0011104 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527)))\n24998:EquivalentClasses(obo:CL_0011106 ObjectIntersectionOf(obo:CL_0011104 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534)))\n25022:EquivalentClasses(obo:CL_0011109 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061585)))\n25029:EquivalentClasses(obo:CL_0011110 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061538)))\n25039:SubClassOf(obo:CL_0011111 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001890))\n25054:EquivalentClasses(obo:CL_0011113 ObjectIntersectionOf(obo:CL_2000032 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000395)))\n25071:EquivalentClasses(obo:CL_0011115 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0030154)))\n25088:EquivalentClasses(obo:CL_0012001 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0001890)))\n25476:SubClassOf(obo:CL_0020003 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002477))\n25477:SubClassOf(obo:CL_0020003 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n25488:SubClassOf(obo:CL_0020004 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002477))\n25506:SubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n25507:SubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061527))\n25508:SubClassOf(obo:CL_0020006 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n25513:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:19855026\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37464873\") obo:IAO_0000115 obo:CL_0020007 \"A transcriptomically defined GABAergic neuron in the dorsal striatum. In mice and primates, it is defined by the coexpression of choline acetyltransferase (ChAT) together with the GABAergic markers glutamate decarboxylase 65 (GAD65/Gad2) and vesicular GABA transporter (VGAT/Slc32a1) (Lozovaya et al., 2018).\")\n25518:SubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n25519:SubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\n25520:SubClassOf(obo:CL_0020007 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n25525:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10377365\") Annotation(oboInOwl:hasDbXref \"PMID:10934256\") Annotation(oboInOwl:hasDbXref \"PMID:21925242\") Annotation(oboInOwl:hasDbXref \"PMID:2329464\") Annotation(oboInOwl:hasDbXref \"PMID:25374536\") Annotation(oboInOwl:hasDbXref \"PMID:25876458\") Annotation(oboInOwl:hasDbXref \"PMID:29651049\") Annotation(oboInOwl:hasDbXref \"PMID:37905876\") obo:IAO_0000115 obo:CL_0020008 \"A large aspiny interneuron of the striatum that serves as the principal intrinsic source of acetylcholine while simultaneously releasing GABA. It is defined by coexpression of cholinergic markers (ChAT and VAChT/Slc18a3) and GABAergic markers (GAD65/Gad2 and VGAT/Slc32a1) (Lozovaya et al., 2018). This MGE-derived neuron maintains Lhx6 expression associated with dual-transmitter identity (Fragkouli et al., 2009; Marin et al., 2000). Morphologically, it possesses a large soma (20–50 μm diameter), 2–4 thick aspiny dendrites extending radially ~1 mm, and locally ramified axons with hundreds of thousands of varicosities (Wilson et al., 1990; Lim et al., 2014).\")\n25531:SubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002435))\n25532:SubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\n25533:SubClassOf(obo:CL_0020008 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n25544:SubClassOf(obo:CL_0020009 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002476))\n25556:SubClassOf(obo:CL_0020010 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002476))\n25558:SubClassOf(obo:CL_0020010 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534))\n25584:SubClassOf(obo:CL_0020013 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006936))\n25600:SubClassOf(obo:CL_0020014 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000966))\n25625:SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001649))\n25626:SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145))\n25627:SubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051216))\n25670:SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n25671:SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990079))\n25706:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:37066415\") obo:IAO_0000115 obo:CL_0020024 \"A mouse retinal ganglion cell type defined by a large soma and a wide, monostratified dendritic arbor that stratifies just distal to the outer ChAT band of the inner plexiform layer (Krieger et al., 2017). It corresponds to the G5 physiological type (Baden et al., 2016; Goetz et al., 2022) and the C42 transcriptomic cluster (Tran et al., 2019), and is considered the evolutionary ortholog of the primate OFF midget RGC (Hahn et al., 2023). The cell projects a thick, fast-conducting axon to the dorsal lateral geniculate nucleus and superior colliculus. It shows a sustained increase in firing to light decrements with a slow decay time constant of roughly 250 ms and a large receptive field center with weak surround antagonism (Krieger et al., 2017). Its molecular profile includes expression of Spp1 and Neurofilament (Smi32) together with Brn3a (Pou4f1) and Brn3b (Pou4f2), absence of Brn3c (Pou4f3) and Calbindin (Calb1), and strong enrichment of Fes (Krieger et al., 2017; Tran et al., 2019).\")\n25721:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26735013\") Annotation(oboInOwl:hasDbXref \"PMID:28753612\") Annotation(oboInOwl:hasDbXref \"PMID:31784286\") Annotation(oboInOwl:hasDbXref \"PMID:35830791\") Annotation(oboInOwl:hasDbXref \"PMID:38092908\") obo:IAO_0000115 obo:CL_0020025 \"A retinal ganglion cell type that has a large soma and a wide, monostratified dendritic arbor that stratifies in the inner sublamina of the inner plexiform layer, with dendrites located just proximal to the inner ChAT band (Krieger et al., 2017). It shows a sustained increase in firing rate to ON stimuli (Krieger et al., 2017). It corresponds to the G24 functional type (Baden et al., 2016; Goetz et al., 2022), the C43 transcriptomic cluster (Tran et al., 2019), and is considered the mouse ortholog of the primate ON midget retinal ganglion cell (Hahn et al., 2023). It is molecularly defined by expression of Spp1, Smi32, Brn3b, Calbindin, and Tbr2 (Krieger et al., 2017; Tran et al., 2019).\")\n25873:EquivalentClasses(obo:CL_0020035 ObjectIntersectionOf(obo:CL_0002419 ObjectSomeValuesFrom(obo:RO_0001025 obo:UBERON_0001277) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0002385)))\n25976:EquivalentClasses(obo:CL_1000001 ObjectIntersectionOf(obo:CL_0000540 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0009918)))\n26077:SubClassOf(obo:CL_1000222 ObjectSomeValuesFrom(obo: