62:AnnotationAssertion(oboInOwl:creation_date obo:CL_3000002 \"2019-02-25T19:30:14Z\"^^xsd:dateTime)\n30271:AnnotationAssertion(oboInOwl:creation_date obo:CL_3000003 \"2019-02-25T19:32:20Z\"^^xsd:dateTime)\n30280:AnnotationAssertion(oboInOwl:creation_date obo:CL_3000004 \"2019-02-25T19:34:33Z\"^^xsd:dateTime)\n30706:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023034 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31061:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023067 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31090:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023070 <https://github.com/obophenotype/cell-ontology/pull/2374>)\n31126:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023073 <https://github.com/obophenotype/cell-ontology/issues/2043>)\n31177:AnnotationAssertion(obo:IAO_0000233 obo:CL_4023078 <https://github.com/obophenotype/brain_data_standards_ontologies/issues/231>)\n31767:AnnotationAssertion(oboInOwl:creation_date obo:CL_4028001 \"2021-11-23T02:31:40Z\"^^xsd:dateTime)\n31778:AnnotationAssertion(oboInOwl:creation_date obo:CL_4028002 \"2021-11-23T03:23:53Z\"^^xsd:dateTime)\n31791:AnnotationAssertion(oboInOwl:creation_date obo:CL_4028003 \"2021-11-23T03:23:53Z\"^^xsd:dateTime)\n31809:AnnotationAssertion(oboInOwl:creation_date obo:CL_4028004 \"2021-12-09T15:34:13Z\"^^xsd:dateTime)\n31825:AnnotationAssertion(oboInOwl:creation_date obo:CL_4028006 \"2021-12-09T15:53:21Z\"^^xsd:dateTime)\n31873:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030000 \"2022-01-20T12:59:06Z\"^^xsd:dateTime)\n31890:AnnotationAssertion(oboInOwl:creation_date obo:CL_4030002 \"2022-02-01T13:04:46Z\"^^xsd:dateTime)\n32673:AnnotationAssertion(oboInOwl:creation_date obo:CL_4033013 \"2023-02-02T11:17:04Z\"^^xsd:dateTime)\n35665:AnnotationAssertion(oboInOwl:creation_date obo:CL_4072103 \"2025-11-05T11:49:53Z\"^^xsd:dateTime)\n35690:AnnotationAssertion(obo:IAO_0000233 obo:CL_7770002 \"https://github.com/obophenotype/cell-ontology/issues/3275\")\n35692:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770002 \"2025-01-29T08:52:00Z\"^^xsd:dateTime)\n35703:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770003 \"2025-08-29T08:53:47Z\"^^xsd:dateTime)\n35720:AnnotationAssertion(oboInOwl:creation_date obo:CL_7770005 \"2025-09-12T11:19:45Z\"^^xsd:dateTime)\n","exit_code":0,"status":"completed"}}
