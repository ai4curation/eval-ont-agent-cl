nterneuron (Mmus))\n30361:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023007 \"L2/3 bipolar VIP interneuron (Mus)\")\n30362:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") obo:IAO_0000115 obo:CL_4023007 \"A VIP GABAergic cortical interneuron with bipolar morphology, with a soma found in L2/3. L2/3 bipolar VIP cells have extending axons across all layers (with preferences for layers II/III and Va) and a dendritic tree that is vertically more restricted than deeper layer VIP cells and extend fewer dendrites into the layers outside their home layer (location of soma). L2/3 bipolar VIP cells have great variability in firing patterns, though most are continuous adapting. L2/3 bipolar VIP cells are more depolarized in their resting state, had less fast rectification, and had smaller after hyperpolarization than deeper VIP cells.\")\n30366:AnnotationAssertion(rdfs:label obo:CL_4023007 \"L2/3 bipolar VIP GABAergic interneuron (Mmus)\")\n30373:SubClassOf(obo:CL_4023007 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n30410:SubClassOf(obo:CL_4023010 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000005460))\n30420:EquivalentClasses(obo:CL_4023011 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000032148)))\n30445:# Class: obo:CL_4023014 (L5 VIP GABAergic interneuron (Mmus))\n30447:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023014 \"L5 VIP interneuron (Mus)\")\n30448:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26420784\") Annotation(oboInOwl:hasDbXref \"PMID:26612957\") obo:IAO_0000115 obo:CL_4023014 \"A VIP GABAergic cortical interneuron with a soma found in L5. L5 VIP cells have mostly local morphology with some deep-projecting axons. They show only moderate resistance, comparable to that of sst subclass and unlike typical VIP subclass cells that tend to show high input resistance. L5 VIP cells show particularly low resting membrane potential.\")\n30450:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4023014 \"L5 VIP (Mus musculus)\")\n30452:AnnotationAssertion(rdfs:label obo:CL_4023014 \"L5 VIP GABAergic interneuron (Mmus)\")\n30457:SubClassOf(obo:CL_4023014 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_P32648))\n30467:EquivalentClasses(obo:CL_4023015 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325)))\n30469:SubClassOf(obo:CL_4023015 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000015325))\n30471:# Class: obo:CL_4023016 (VIP GABAergic interneuron)\n30473:AnnotationAssertion(obo:IAO_0000028 obo:CL_4023016 \"VIP interneuron\")\n30476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP interneuron\")\n30477:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33108272\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP neuron\")\n30478:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35221922\") oboInOwl:hasBroadSynonym obo:CL_4023016 \"VIP-Expressing GABAergic Neuron\")\n30481:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36384143\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP neuron\")\n30482:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824655\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP type\")\n30483:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33794534\") oboInOwl:hasRelatedSynonym obo:CL_4023016 \"VIP-IN\")\n30486:AnnotationAssertion(rdfs:label obo:CL_4023016 \"VIP GABAergic interneuron\")\n30487:EquivalentClasses(obo:CL_4023016 ObjectIntersectionOf(obo:CL_0000099 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0000956) ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0061534) ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000017299)))\n30491:SubClassOf(obo:CL_4023016 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR