tor obo:CL_4052027 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052027 \"2024-11-06T10:10:51Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38069168\") rdfs:comment obo:CL_4052027 \"During atresia, theca interna and externa cells undergo distinct morphological and functional changes. Theca interna cells round up, expand in cytoplasmic area, and thicken the internal layer as organization degrades, while showing reduced STAR expression, which lowers androgen production. Theca externa cells display decreased ACTA2 expression, weakening structural integrity.\")\nAnnotationAssertion(rdfs:label obo:CL_4052027 \"atretic theca cell\")\nSubClassOf(obo:CL_4052027 obo:CL_4033089)\nSubClassOf(obo:CL_4052027 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000503))\n\n# Class: obo:CL_4052028 (uterine natural killer cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Uterine_natural_killer_cells\") obo:IAO_0000115 obo:CL_4052028 \"A natural killer cell that is part of the uterus, specifically within the endometrium during the non-pregnant state and in the decidua during pregnancy. This cell exhibits dynamic changes in frequency throughout the menstrual cycle, with lower levels during menstruation and a significant increase during the mid-secretory phase and early pregnancy.\")\nAnnotationAssertion(terms:contributor obo:CL_4052028 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_4052028 \"2024-11-15T10:12:40Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35720413\") oboInOwl:hasNarrowSynonym obo:CL_4052028 \"endometrial natural killer cell\")\n","exit_code":0,"status":"completed"}}
