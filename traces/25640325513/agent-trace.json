{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"sed -n '25572,25648p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0000-0002-2999-0103>)\nAnnotationAssertion(terms:contributor obo:CL_0020015 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") oboInOwl:hasBroadSynonym obo:CL_0020015 \"hybrid principal-intercalated cell\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37468583\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020015 \"tPC-IC cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020015 \"transitional principal-intercalated cell of kidney collecting duct\")\nSubClassOf(obo:CL_0020015 obo:CL_1000454)\nSubClassOf(obo:CL_0020015 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001232))\n\n# Class: obo:CL_0020016 (osteochondral skeletal stem cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasDbXref \"doi:10.1101/2023.12.07.570646\") obo:IAO_0000115 obo:CL_0020016 \"A tissue-specific stem cell with long-term self-renewal capacity that is restricted to generating bone, cartilage, and stromal cell lineages. This cell is primarily located in the growth plate (resting zone), periosteum, and subchondral bone regions, and is marked by high clonogenicity and robust multipotent differentiation potential in both osteogenic and chondrogenic lineages. Distinctively, ocSSC lacks adipogenic capacity, distinguishing it from other mesenchymal stem cell populations.\")\nAnnotationAssertion(terms:contributor obo:CL_0020016 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020016 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020016 \"2025-11-27T00:00:00Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34280086\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020016 \"ocSSC\")\nAnnotationAssertion(rdfs:label obo:CL_0020016 \"osteochondral skeletal stem cell\")\nSubClassOf(obo:CL_0020016 obo:CL_0000034)\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001434))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0001649))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0017145))\nSubClassOf(obo:CL_0020016 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0051216))\n\n# Class: obo:CL_0020017 (M0 macrophage)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") Annotation(oboInOwl:hasDbXref \"PMID:30861466\") obo:IAO_0000115 obo:CL_0020017 \"A macrophage that has not yet undergone polarization into a specific macrophage subtype. These cells are non-activated and have the potential to differentiate into inflammatory (M1) or alternatively activated (M2) macrophage subtypes in response to appropriate stimuli.\")\nAnnotationAssertion(dc:creator obo:CL_0020017 \"GitHub Copilot\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"naive macrophage\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020017 \"non-activated macrophage\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1186/s12885-022-09872-y\") oboInOwl:hasExactSynonym obo:CL_0020017 \"resting-state macrophages\")\nAnnotationAssertion(rdfs:label obo:CL_0020017 \"M0 macrophage\")\nSubClassOf(obo:CL_0020017 obo:CL_0000235)\n\n# Class: obo:CL_0020018 (proliferative fibrochondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:39759119\") obo:IAO_0000115 obo:CL_0020018 \"A fibrochondrocyte located in fibrocartilage that exhibits active proliferation capacity and is in S phase of the cell cycle. It functions as a progenitor cell positioned at the root of developmental trajectories alongside fibrochondrocyte progenitors (FCP), with the capacity to diverge toward one of two developmental fates: (1) fibrochondrocytes and prehypertrophic chondrocytes, or (2) regulatory chondrocytes and prehypertrophic chondrocytes. It is characterised by co-expression of COL1A1, the growth factors FGF7 and CTGF, and the cell-cycle genes STMN1, KIAA0101, and MCM3 in humans. During early progenitor differentiation, FGF7 and COL1A1 expression increases and then declines as the cell commits to terminal fates.\")\nAnnotationAssertion(terms:contributor obo:CL_0020018 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020018 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020018 \"2025-11-27T12:48:39Z\"^^xsd:dateTime)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020018 \"ProFC\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020018 \"Lineage relationships are inferred from single-cell RNA-seq trajectories and validated through experimental approaches, including FACS isolation, functional differentiation assays, and in vivo developmental gene expression analysis.\")\nAnnotationAssertion(rdfs:label obo:CL_0020018 \"proliferative fibrochondrocyte\")\nSubClassOf(obo:CL_0020018 obo:CL_4072104)\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0022402))\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\nSubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007498))\n\n# Class: obo:CL_0020019 (regulatory chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020019 \"A chondrocyte located mainly in the superficial zone of articular cartilage. In healthy human cartilage, regulatory chondrocytes are characterized by expression of EIF5A, PGK1, ANXA1, and TUBA1A. During osteoarthritis, a distinct subpopulation expands, marked by high expression of CHI3L1, CHI3L2, CRTAC1, and AEBP1, with enrichment for signaling pathway regulation (including Toll-like receptor, mTOR, and TGF-beta signaling) and antigen-processing gene expression, with a small proportion expressing MHC class II genes, suggesting potential immune cell-like regulatory functions during osteoarthritis progression.\")\nAnnotationAssertion(dc:creator obo:CL_0020019 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020019 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") oboInOwl:hasRelatedSynonym obo:CL_0020019 \"RegC\")\nAnnotationAssertion(rdfs:label obo:CL_0020019 \"regulatory chondrocyte\")\nSubClassOf(obo:CL_0020019 obo:CL_0000138)\n\n# Class: obo:CL_0020020 (homeostatic chondrocyte)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020020 \"A chondrocyte identified in both healthy and osteoarthritic human articular cartilage, and in intervertebral disc tissue. In healthy articular cartilage, a homeostatic chondrocyte is characterised by the expression of TXNIP, IFITM3, GDF15, and TIMP1 (Wang et al., 2021), among other extracellular matrix and regulatory molecules. This cell maintains cartilage integrity by producing key ECM components and supporting baseline tissue homeostasis. In OA cartilage, this cell is enriched for genes related to cellular homeostasis modulation, including regulation of the cell cycle, development, and RNA metabolism (Ji et al., 2018).\")\nAnnotationAssertion(dc:creator obo:CL_0020020 \"GitHub Copilot\")\nAnnotationAssertion(terms:contributor obo:CL_0020020 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020020 \"HomC\")\nAnnotationAssertion(rdfs:label obo:CL_0020020 \"homeostatic chondrocyte\")\nSubClassOf(obo:CL_0020020 obo:CL_0000138)\nSubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\nSubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990079))\n\n# Class: obo:CL_0020021 (fibrochondrocyte progenitor cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:36338137\") obo:IAO_0000115 obo:CL_0020021 \"A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.\")\nAnnotationAssertion(terms:contributor obo:CL_0020021 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020021 \"GitHub Copilot\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020021 \"FCP\")\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020021 \"A fibrochondrocyte progenitor cell demonstrates colony-forming capacity and multi-lineage differentiation potential toward osteogenic and adipogenic lineages.\")\nAnnotationAssertion(rdfs:label obo:CL_0020021 \"fibrochondrocyte progenitor cell\")\nSubClassOf(obo:CL_0020021 obo:CL_0008019)\nSubClassOf(obo:CL_0020021 obo:CL_0011026)\nSubClassOf(obo:CL_0020021 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001995))\n","exit_code":0,"status":"completed"}}
