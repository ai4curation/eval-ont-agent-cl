sertion(terms:contributor obo:CL_0020018 <https://orcid.org/0009-0000-8480-9277>)\n25602:AnnotationAssertion(terms:creator obo:CL_0020018 \"GitHub Copilot\")\n25603:AnnotationAssertion(terms:date obo:CL_0020018 \"2025-11-27T12:48:39Z\"^^xsd:dateTime)\n25604:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020018 \"ProFC\")\n25605:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") rdfs:comment obo:CL_0020018 \"Lineage relationships are inferred from single-cell RNA-seq trajectories and validated through experimental approaches, including FACS isolation, functional differentiation assays, and in vivo developmental gene expression analysis.\")\n25606:AnnotationAssertion(rdfs:label obo:CL_0020018 \"proliferative fibrochondrocyte\")\n25607:SubClassOf(obo:CL_0020018 obo:CL_4072104)\n25608:SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0000056 obo:GO_0022402))\n25609:SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000003264))\n25610:SubClassOf(obo:CL_0020018 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_000007498))\n25611-\n25612:# Class: obo:CL_0020019 (regulatory chondrocyte)\n25613-\n25614:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020019 \"A chondrocyte located mainly in the superficial zone of articular cartilage. In healthy human cartilage, regulatory chondrocytes are characterized by expression of EIF5A, PGK1, ANXA1, and TUBA1A. During osteoarthritis, a distinct subpopulation expands, marked by high expression of CHI3L1, CHI3L2, CRTAC1, and AEBP1, with enrichment for signaling pathway regulation (including Toll-like receptor, mTOR, and TGF-beta signaling) and antigen-processing gene expression, with a small proportion expressing MHC class II genes, suggesting potential immune cell-like regulatory functions during osteoarthritis progression.\")\n25615:AnnotationAssertion(dc:creator obo:CL_0020019 \"GitHub Copilot\")\n25616:AnnotationAssertion(terms:contributor obo:CL_0020019 <https://orcid.org/0009-0000-8480-9277>)\n25617:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") oboInOwl:hasRelatedSynonym obo:CL_0020019 \"RegC\")\n25618:AnnotationAssertion(rdfs:label obo:CL_0020019 \"regulatory chondrocyte\")\n25619:SubClassOf(obo:CL_0020019 obo:CL_0000138)\n25620-\n25621:# Class: obo:CL_0020020 (homeostatic chondrocyte)\n25622-\n25623:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30026257\") Annotation(oboInOwl:hasDbXref \"PMID:34045450\") Annotation(oboInOwl:hasDbXref \"PMID:34400611\") Annotation(oboInOwl:hasDbXref \"PMID:37660146\") obo:IAO_0000115 obo:CL_0020020 \"A chondrocyte identified in both healthy and osteoarthritic human articular cartilage, and in intervertebral disc tissue. In healthy articular cartilage, a homeostatic chondrocyte is characterised by the expression of TXNIP, IFITM3, GDF15, and TIMP1 (Wang et al., 2021), among other extracellular matrix and regulatory molecules. This cell maintains cartilage integrity by producing key ECM components and supporting baseline tissue homeostasis. In OA cartilage, this cell is enriched for genes related to cellular homeostasis modulation, including regulation of the cell cycle, development, and RNA metabolism (Ji et al., 2018).\")\n25624:AnnotationAssertion(dc:creator obo:CL_0020020 \"GitHub Copilot\")\n25625:AnnotationAssertion(terms:contributor obo:CL_0020020 <https://orcid.org/0009-0000-8480-9277>)\n25626:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37660146\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0020020 \"HomC\")\n25627:AnnotationAssertion(rdfs:label obo:CL_0020020 \"homeostatic chondrocyte\")\n25628:SubClassOf(obo:CL_0020020 obo:CL_0000138)\n25629:SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0070278))\n25630:SubClassOf(obo:CL_0020020 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_1990079))\n25631-\n25632-# Class: obo:CL_0700009 (obsolete kidney collecting duct beta-intercalated cell)\n25633-\n--\n35320-EquivalentClasses(obo:CL_4072103 ObjectIntersectionOf(obo:CL_0000134 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002073)))\n35321-SubClassOf(obo:CL_4072103 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0042634))\n35322-\n35323:# Class: obo:CL_4072104 (fibrochondrocyte)\n35324-\n35325:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasDbXref \"PMID:34608249\") obo:IAO_0000115 obo:CL_4072104 \"A chondrocyte with hybrid fibroblastic-chondrogenic characteristics found in fibrocartilage, particularly in the avascular inner zone and transitional middle zone of the meniscus. In humans, fibrochondrocytes are marked by predominant expression of type I collagen (COL1A1) and fibril-associated collagens (COL3A1, COL6A1), while retaining type II collagen (COL2A1) expression and exhibiting lower SOX9 than hyaline chondrocytes. This molecular profile underlies the synthesis of abundant type I collagen essential for fibrocartilage matrix and reflects an intermediate phenotype between fibroblast and chondrocyte.\")\n35326:AnnotationAssertion(terms:contributor obo:CL_4072104 <https://orcid.org/0009-0000-8480-9277>)\n35327:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34608249\") oboInOwl:hasExactSynonym obo:CL_4072104 \"fibrocartilage chondrocyte\")\n35328:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28939894\") oboInOwl:hasNarrowSynonym obo:CL_4072104 \"meniscus fibrochondrocyte\")\n35329:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31871141\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4072104 \"FC\")\n35330:AnnotationAssertion(rdfs:label obo:CL_4072104 \"fibrochondrocyte\")\n35331