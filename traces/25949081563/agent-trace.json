{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '25780,25815p' src/ontology/cl-edit.owl\"","aggregated_output":"AnnotationAssertion(terms:creator obo:CL_0020029 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020029 \"2025-12-16T15:56:39Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_0020029 \"cuboidal epithelial cell\")\nEquivalentClasses(obo:CL_0020029 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001872)))\nSubClassOf(obo:CL_0020029 obo:CL_0000075)\n\n# Class: obo:CL_0020030 (CD4-positive exhausted alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31207603\") Annotation(oboInOwl:hasDbXref \"PMID:31390978\") Annotation(oboInOwl:hasDbXref \"PMID:36907685\") Annotation(oboInOwl:hasDbXref \"PMID:38166256\") obo:IAO_0000115 obo:CL_0020030 \"A CD4-positive alpha-beta T cell that displays impaired function and altered differentiation as a result of chronic antigenic stimulation (e.g., chronic infection, tumors, or persistent inflammation). This state is characterised by sustained expression of PD-1 as a shared feature. Additional exhaustion-associated molecules, including the transcription factor TOX, and context- or stage-dependent changes in markers such as LAG-3, TIM-3, CD39, and T-bet, may also be observed; however, the expression levels of these molecules vary depending on exhaustion stage and tissue environment.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020030 <https://github.com/obophenotype/cell-ontology/issues/3453>)\nAnnotationAssertion(terms:contributor obo:CL_0020030 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020030 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020030 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020030 \"2026-01-13T15:30:05Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"CD4+ exhausted T lymphocyte\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"exhausted CD4 T cell\")\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020030 \"exhausted CD4-positive T cell\")\nAnnotationAssertion(rdfs:label obo:CL_0020030 \"CD4-positive exhausted alpha-beta T cell\")\nEquivalentClasses(obo:CL_0020030 ObjectIntersectionOf(obo:CL_0000624 ObjectSomeValuesFrom(obo:RO_0002104 obo:PR_000001919)))\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0020030 obo:CL_0000624)\nSubClassOf(obo:CL_0020030 obo:CL_0011025)\n\n# Class: obo:CL_0020031 (CD8-positive exhausted alpha-beta T cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31207603\") Annotation(oboInOwl:hasDbXref \"PMID:36907685\") Annotation(oboInOwl:hasDbXref \"PMID:38166256\") obo:IAO_0000115 obo:CL_0020031 \"A CD8-positive alpha-beta T cell that displays impaired function and altered differentiation as a result of chronic antigenic stimulation (e.g., chronic infection, tumours, or persistent inflammation). This state is characterised by sustained expression of PD-1 as a shared feature. Additional exhaustion-associated molecules, including expression of the transcription factor TOX and reduced T-bet, and context- or stage-dependent changes in markers such as LAG-3, TIM-3, CD39, and EOMES, may also be observed; however, the expression levels of these molecules vary depending on exhaustion stage and disease context.\")\nAnnotationAssertion(obo:IAO_0000233 obo:CL_0020031 <https://github.com/obophenotype/cell-ontology/issues/3453>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0000-0001-5742-4697>)\nAnnotationAssertion(terms:contributor obo:CL_0020031 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:creator obo:CL_0020031 \"GitHub Copilot\")\nAnnotationAssertion(terms:date obo:CL_0020031 \"2026-01-13T15:30:05Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0020031 \"CD8+ exhauste