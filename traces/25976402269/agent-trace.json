000738)\n\n  Line 11783: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:ana\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:16168663\") Annotation(oboInOwl:hasDbXref \"PMID:17016554\") Annotation(oboInOwl:hasDbXref \"PMID:17016559\") obo:IAO_0000115 obo:CL_0000889 \"An immature myeloid leukocyte of heterogeneous phenotype found particularly in cancer and sepsis patients that is capable of suppressing activity of T cells in ex vivo assays. This cell type is CD45-positive, CD11b-positive.\")\n\n  Line 12957: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:15771572\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") Annotation(oboInOwl:hasDbXref \"PMID:19243617\") Annotation(oboInOwl:hasDbXref \"PMID:34603298\") obo:IAO_0000115 obo:CL_0000989 \"CD11c-low plasmacytoid dendritic cell is a leukocyte that is CD11c-low, CD45R-positive, GR1-positive and CD11b-negative.\")\n\n  Line 12981: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:amm\") Annotation(oboInOwl:hasDbXref \"GO_REF:0000031\") Annotation(oboInOwl:hasDbXref \"PMID:15771572\") Annotation(oboInOwl:hasDbXref \"PMID:17850486\") Annotation(oboInOwl:hasDbXref \"PMID:19243617\") Annotation(oboInOwl:hasDbXref \"PMID:29313948\") obo:IAO_0000115 obo:CL_0000991 \"CD11c-negative plasmacytoid dendritic cell is a leukocyte is CD11c-negative, CD45RA-positive, CD85g-positive(ILT7), CD123-positive, CD303-positive.\")\n\n  Line 14934: # Class: obo:CL_0002087 (nongranular leukocyte)\n\n  Line 14936: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002087 \"A leukocyte that lacks granules.\")\n\n  Line 14940: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002087 \"agranular leukocyte\")\n\n  Line 14941: AnnotationAssertion(rdfs:label obo:CL_0002087 \"nongranular leukocyte\")\n\n  Line 14942: EquivalentClasses(obo:CL_0002087 ObjectIntersectionOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:CL_4030045 obo:GO_0030141)))\n\n  Line 14943: SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0002087 obo:CL_0000738)\n\n  Line 16077: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0323052908\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Myelocyte\") obo:IAO_0000115 obo:CL_0002193 \"A cell type that is the first of the maturation stages of the granulocytic leukocytes normally found in the bone marrow. Granules are seen in the cytoplasm. The nuclear material of the myelocyte is denser than that of the myeloblast but lacks a definable membrane. The cell is flat and contains increasing numbers of granules as maturation progresses.\")\n\n  Line 20753: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20726857\") obo:IAO_0000115 obo:CL_0002652 \"A venule endothelial cell that is cubodial, expresses leukocyte-specific receptors, and allows for passage of lymphocytes into bloodstream.\")\n\n  Line 23734: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26551552\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-4183-8865\") obo:IAO_0000115 obo:CL_0009044 \"A lymphocyte that resides in the lamina propria of the small intestine. Lamina propria leukocytes and intraepithelial lymphocytes are the effector compartments of the gut mucosal immune system. Lymphocytes circulate through gut associated lymphoid tissues until recruitment by intestinal antigens. They are involved in the gut immune response.\")\n\n  Line 23736: AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009044 \"gastrointestinal tract small intestine (lamina propria) leukocyte\")\n\n  Line 23737: AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009044 \"small intestine lamina propria leukocyte\")\n\n  Line 23738: AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009044 \"small intestine lamina propria leukocyte (LPL)\")\n\n  Line 29105: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000001 \"A leukocyte with a single non-segmented nucleus in the mature form found in the circulatory pool of blood.\")\n\n  Line 29805: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000074 \"Any leukocyte that is part of a spleen.\")\n\n  Line 29811: EquivalentClasses(obo:CL_2000074 ObjectIntersectionOf(obo:CL_0000738 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002106)))\n\n  Line 34094: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28845904\") Annotation(oboInOwl:hasDbXref \"PMID:33681216\") Annotation(oboInOwl:hasDbXref \"PMID:34302064\") obo:IAO_0000115 obo:CL_4047054 \"A dendritic cell capable of capturing antigens in peripheral tissues and migrating through blood or lymphatic vessels to secondary lymphoid organs, where it presents processed antigens to T cells. It expresses MHC class II molecules and lacks lineage markers associated with other leukocyte populations, distinguishing it as a member of the dendritic cell lineage. This cell plays a pivotal role in initiating and regulating adaptive immune responses by linking peripheral antigen capture with T cell activation in lymphoid tissues.\")\n\n  Line 34677: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30429548\") Annotation(oboInOwl:hasDbXref \"PMID:34512661\") Annotation(oboInOwl:hasDbXref \"PMID:34857954\") Annotation(oboInOwl:hasDbXref \"PMID:35784314\") Annotation(oboInOwl:hasDbXref \"PMID:39198675\") obo:IAO_0000115 obo:CL_4052051 \"​​A uterine natural killer subset that is present in the endometrial lining during the non-pregnant state (Garcia-Alonso et al., 2021) and in the decidua during pregnancy (Vento-Tormo et al., 2018). It expresses the uterine resident marker CD49a and is distinguished from uNK2 and uNK3 by CD39 expression and the absence of CD103 (Whettlock et al., 2022) and CD160 (Marečková et al., 2024). It also expresses higher levels of killer-cell immunoglobulin-like receptors (KIRs) and leukocyte immunoglobulin-like receptor B1 (LILRB1), which facilitate interaction with human leukocyte antigens (HLAs) on extravillous trophoblast cells, promoting immune tolerance and implantation. Enriched in the endometrium post-ovulation (Marečková et al., 2024) and prominent in early pregnancy (Whettlock et al., 2022), uNK1 regulates trophoblast invasion and spiral artery remodeling (Zhang & Wei, 2021).\")\n","metadata":{"matches":85,"truncated":false},"title":"CL_0000738|leukocyte|WBC","time":{"start":1778976243029,"end":1778976243080}},"id":"prt_e333f3d4c001lWbqY1rS8HpGGH","sessionID":"ses_1ccc0fd32ffeht1kgimxSsfJ8L","messageID":"msg_e333f2797001SfMa3S3r1H4bKQ"}}
