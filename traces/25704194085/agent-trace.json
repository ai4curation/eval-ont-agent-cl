ibrary.org/obo/ENVO_*>\" \\\n432: \t\t remove --select \"<http://purl.obolibrary.org/obo/OBI_*>\" \\\n433: \t\t remove --select \"<http://purl.obolibrary.org/obo/NBO_*>\" \\\n434: \t\t remove --select \"<http://purl.obolibrary.org/obo/PO_*>\" \\\n435: \t\t remove --select \"<http://purl.obolibrary.org/obo/SO_*>\" \\\n436: \t\t remove --select \"<http://purl.obolibrary.org/obo/DDANAT_*>\" \\\n437: \t\t remove --select \"<http://purl.obolibrary.org/obo/NCBITaxon_Union_*>\" \\\n438: \t\t remove --select \"<http://purl.obolibrary.org/obo/GOCHE_*>\" \\\n439: \t\t remove --select \"<http://purl.obolibrary.org/obo/CLO_*>\" \\\n440: \t\t remove --select \"<http://www.genenames.org/cgi-bin/gene_symbol_report*>\" \\\n441: \t\t extract $(foreach f, $(ALL_TERMS), --term-file $(f)) $(T_IMPORTSEED) \\\n442: \t\t         --force true --copy-ontology-annotations false \\\n443: \t\t         --individuals exclude \\\n444: \t\t         --method BOT \\\n445: \t\t remove $(foreach p, $(ANNOTATION_PROPERTIES), --term $(p)) \\\n446: \t\t        $(foreach f, $(ALL_TERMS), --term-file $(f)) $(T_IMPORTSEED) \\\n447: \t\t        --select complement --select annotation-properties \\\n448: \t\t odk:normalize --base-iri http://purl.obolibrary.org/obo \\\n449: \t\t               --subset-decls true --synonym-decls true \\\n450: \t\t repair --merge-axiom-annotations true \\\n451: \t\t $(ANNOTATE_CONVERT_FILE)\n452: \n453: endif # IMP=true\n454: \n455: .PHONY: refresh-imports\n456: refresh-imports:\n457: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=true clean all_imports\n458: \n459: .PHONY: no-mirror-refresh-imports\n460: no-mirror-refresh-imports:\n461: \t$(MAKE) --assume-new=$(SRC) \\\n462: \t\t$(foreach imp,$(IMPORTS),--assume-new=$(IMPORTDIR)/$(imp)_terms.txt) \\\n463: \t\tIMP=true MIR=false PAT=false IMP_LARGE=true all_imports\n464: \n465: .PHONY: refresh-imports-excluding-large\n466: refresh-imports-excluding-large:\n467: \t$(MAKE) IMP=true MIR=true PAT=false IMP_LARGE=false clean all_imports\n468: \n469: .PHONY: refresh-%\n470: refresh-%:\n471: \t$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \\\n472: \t\tIMP=true IMP_LARGE=true MIR=true PAT=false $(IMPORTDIR)/$*_import.owl\n473: \n474: .PHONY: no-mirror-refresh-%\n475: no-mirror-refresh-%:\n476: \t$(MAKE) --assume-new=$(SRC) --assume-new=$(IMPORTDIR)/$*_terms.txt \\\n477: \t\tIMP=true IMP_LARGE=true MIR=false PAT=false $(IMPORTDIR)/$*_import.owl\n478: \n479: # ----------------------------------------\n480: # Components\n481: # ----------------------------------------\n482: # Some ontologies contain external and internal components. A component is included in the ontology in its entirety.\n483: \n484: ifeq ($(COMP),true)\n485: .PHONY: all_components\n486: all_components: $(OTHER_SRC)\n487: \n488: .PHONY: recreate-components\n489: recreate-components:\n490: \t$(MAKE) --assume-new=$(TMPDIR)/stamp-component-hra_subset.owl \\\n491: \t\t--assume-new=$(TMPDIR)/stamp-component-mappings.owl \\\n492: \t\t--assume-new=$(TMPDIR)/stamp-component-blood_and_immune_upper_slim.owl \\\n493: \t\t--assume-new=$(TMPDIR)/stamp-component-eye_upper_slim.owl \\\n494: \t\t--assume-new=$(TMPDIR)/stamp-component-general_cell_types_upper_slim.owl \\\n495: \t\t--assume-new=$(TMPDIR)/stamp-component-kidney_upper_slim.owl \\\n496: \t\t--assume-new=$(TMPDIR)/stamp-component-cellxgene_subset.owl \\\n497: \t\t--assume-new=$(TMPDIR)/stamp-component-PNS_neurons.owl \\\n498: \t\t--assume-new=$(TMPDIR)/stamp-component-clm-cl.owl \\\n499: \t\t--assume-new=$(TMPDIR)/stamp-component-2DFTU_HRA_illustrations.owl \\\n\n(Showing lines 400-499 of 1227. Use offset=500 to continue.)\n</content>","metadata":{"preview":"\t$(ROBOT) query -f csv -i $< --query ../sparql/simple-seed.sparql $@.tmp &&\\\n\tcat $@.tmp $(ONTOLOGYTERMS) | sort | uniq >  $@ &&\\\n\techo \"http://www.geneontology.org/formats/oboInOwl#SubsetProperty\" >> $@ &&\\\n\techo \"http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty\" >> $@\n\n# seed.tx