: AnnotationAssertion(rdfs:label obo:CL_1001607 \"articular chondrocyte\")\n29181: EquivalentClasses(obo:CL_1001607 ObjectIntersectionOf(obo:CL_0000138 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0010996)))\n29182: \n29183: # Class: obo:CL_1001608 (foreskin fibroblast)\n29184: \n29185: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001608 \"Fibroblast from foreskin.\")\n29186: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_1001608 \"CALOHA:TS-0384\")\n29187: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_1001608 \"BJ fibroblast\")\n29188: AnnotationAssertion(rdfs:label obo:CL_1001608 \"foreskin fibroblast\")\n29189: EquivalentClasses(obo:CL_1001608 ObjectIntersectionOf(obo:CL_0002620 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001332)))\n29190: \n29191: # Class: obo:CL_1001609 (muscle fibroblast)\n29192: \n29193: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001609 \"Fibroblast from muscle organ.\")\n29194: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_1001609 \"CALOHA:TS-0643\")\n29195: AnnotationAssertion(rdfs:label obo:CL_1001609 \"muscle fibroblast\")\n29196: EquivalentClasses(obo:CL_1001609 ObjectIntersectionOf(obo:CL_0000057 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001630)))\n29197: \n29198: # Class: obo:CL_1001610 (bone marrow hematopoietic cell)\n29199: \n29200: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"NPX:PDR\") obo:IAO_0000115 obo:CL_1001610 \"Hematopoietic cells resident in the bone marrow. Include: hematopoietic stem cells (lymphoid stem cells and myeloid stem cells) and the precursor cells for thrombocytes, erythrocytes, basophils, neutrophils, eosinophils, monocytes and lymphocytes.\")\n29201: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_1001610 \"CALOHA:TS-2109\")\n29202: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CALOHA:TS-2109\") oboInOwl:hasRelatedSynonym obo:CL_1001610 \"bone marrow hematopoietic cells\")\n29203: AnnotationAss