ation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_0000077 \"A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement.\")\n4539: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000077 \"FMA:66773\")\n4540: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000077 \"mesotheliocyte\")\n4541: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") rdfs:comment obo:CL_0000077 \"Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.\")\n4542: AnnotationAssertion(rdfs:label obo:CL_0000077 \"mesothelial cell\")\n4543: SubClassOf(obo:CL_0000077 obo:CL_0000076)\n4544: SubClassOf(obo:CL_0000077 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0001136))\n4545: SubClassOf(obo:CL_0000077 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000222))\n4546: \n4547: # Class: obo:CL_0000078 (peridermal cell)\n4548: \n4549: AnnotationAssertion(rdfs:label obo:CL_0000078 \"peridermal cell\")\n4550: EquivalentClasses(obo:CL_0000078 ObjectIntersectionOf(obo:CL_0000076 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0003055)))\n4551: \n4552: # Class: obo:CL_0000079 (stratified epithelial cell)\n4553: \n4554: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/B978-0-12-410424-2.00003-2\") Annotation(oboInOwl:hasDbXref \"https://www.biologyonline.com/dictionary/stratified-epithelium\") obo:IAO_0000115 obo:CL_0000079 \"An epithelial cell, organized into multiple layers, with only the basal layer being in contact with the basement membrane.\")\n4555: AnnotationAssertion(rdfs:label obo:CL_0000079 \"stratified epithelial cell\")\n4556: EquivalentClasses(obo:CL_0000079 ObjectIntersectionOf(obo:CL_0000066 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000486)))\n4557: SubClassOf(obo:CL_0000079 obo:CL_0000066)\n4558: SubClassOf(obo:CL_0000079 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000357))\n4559: \n4560: # Class: obo:CL_0000080 (circulating cell)\n4561: \n4562: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") obo:IAO_0000115 obo:CL_0000080 \"A cell which moves among different tissues of the body, via blood, lymph, or other medium.\")\n4563: AnnotationAssertion(rdfs:label obo:CL_0000080 \"circulating cell\")\n4564: EquivalentClasses(obo:CL_0000080 ObjectIntersectionOf(obo:CL_0000000 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000179)))\n4565: \n4566: # Class: obo:CL_0000081 (blood cell)\n4567: \n4568: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000081 \"A cell found predominately in the blood.\")\n4569: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000081 \"FMA:62844\")\n4570: AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0000081 \"MESH:D001773\")\n4571: AnnotationAssertion(rdfs:label obo:CL_0000081 \"blood cell\")\n4572: EquivalentClasses(obo:CL_0000081 ObjectIntersectionOf(obo:CL_0000988 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0008015)))\n4573: SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_0000081 obo:CL_0000988)\n4574: \n4575: # Class: obo:CL_0000082 (epithelial cell of lung)\n4576: \n4577: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_00001