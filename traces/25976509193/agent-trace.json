{"type":"tool_use","timestamp":1778976590643,"sessionID":"ses_1ccbc1452ffeszWjsWacrU366B","part":{"type":"tool","tool":"read","callID":"call_SprqtMOgFUSPeXQYY06JFh5N","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":34190,"limit":80},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n34190: \n34191: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11146428\") Annotation(oboInOwl:hasDbXref \"PMID:32424507\") obo:IAO_0000115 obo:CL_4047036 \"A smooth muscle cell located in the middle layer of the muscularis externa of the stomach wall. This cell is arranged concentrically with the stomach's longitudinal axis, forming a continuous sheet of contractile tissue. It is fusiform in shape, containing actin and myosin filaments that enable contraction without striations. This cell contributes to the mechanical digestion and movement of food within the stomach through coordinated contractions, and plays a role in forming the pyloric sphincter in the pyloric region.\")\n34192: AnnotationAssertion(terms:contributor obo:CL_4047036 <https://orcid.org/0009-0005-7919-4905>)\n34193: AnnotationAssertion(terms:date obo:CL_4047036 \"2024-12-09T10:40:58Z\"^^xsd:dateTime)\n34194: AnnotationAssertion(rdfs:label obo:CL_4047036 \"stomach smooth muscle circular layer cell\"@en)\n34195: EquivalentClasses(obo:CL_4047036 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008857)))\n34196: \n34197: # Class: obo:CL_4047037 (stomach smooth muscle inner oblique layer cell)\n34198: \n34199: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29493959\") obo:IAO_0000115 obo:CL_4047037 \"A smooth muscle cell found in the innermost layer of the muscularis externa of the stomach wall. This cell forms a unique layer of smooth muscle fibers oriented obliquely to the stomach's longitudinal axis. It is responsible for aiding in the mixing and churning of gastric contents, contributing to mechanical digestion within the stomach.\")\n34200: AnnotationAssertion(terms:contributor obo:CL_4047037 <https://orcid.org/0009-0005-7919-4905>)\n34201: AnnotationAssertion(terms:date obo:CL_4047037 \"2024-12-09T10:53:19Z\"^^xsd:dateTime)\n34202: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047037 \"stomach smooth muscle oblique layer cell\")\n34203: AnnotationAssertion(rdfs:label obo:CL_4047037 \"stomach smooth muscle inner oblique layer cell\"@en)\n34204: EquivalentClasses(obo:CL_4047037 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008862)))\n34205: \n34206: # Class: obo:CL_4047038 (dogiel type I neuron)\n34207: \n34208: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-020-0271-2\") Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-021-00561-y\") Annotation(oboInOwl:hasDbXref \"PMID:32152479\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4047038 \"A multipolar neuron in the myenteric plexus of the gastrointestinal tract, characterized by a small to medium-sized cell body and multiple short dendrites.  This neuron exhibits fast excitatory postsynaptic potentials and can be classified into stubby, spiny and hairy subtypes based on dendritic morphology. (Brehmer, 2021)\")\n34209: AnnotationAssertion(terms:contributor obo:CL_4047038 <https://orcid.org/0009-0005-7919-4905>)\n34210: AnnotationAssertion(terms:date obo:CL_4047038 \"2024-12-16T13:42:04Z\"^^xsd:dateTime)\n34211: AnnotationAssertion(rdfs:label obo:CL_4047038 \"dogiel type I neuron\")\n34212: SubClassOf(obo:CL_4047038 obo:CL_0000104)\n34213: SubClassOf(obo:CL_4047038 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439))\n34214: \n34215: # Class: obo:CL_4047040 (smooth muscle circular layer cell)\n34216: \n34217: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18221249\") Annotation(oboInOwl:hasDbXref \"PMID:27445346\") obo:IAO_0000115 obo:CL_4047040 \"A smooth muscle cell that is found in the inner muscular layer of hollow organs. It is characterized by its spiral/helical arrangement around organ lumens. This cell is crucial for peristaltic movements in organs.\")\n34218: AnnotationAssertion(terms:contributor obo:CL_4047040 <https://orcid.org/0009-0005-7919-4905>)\n34219: AnnotationAssertion(terms:date obo:CL_4047040 \"2025-01-06T15:40:21Z\"^^xsd:dateTime)\n34220: AnnotationAssertion(rdfs:label obo:CL_4047040 \"smooth muscle circular layer cell\")\n34221: SubClassOf(obo:CL_4047040 obo:CL_0000192)\n34222: SubClassOf(obo:CL_4047040 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0012368))\n34223: \n34224: # Class: obo:CL_4047042 (type 1 myenteric plexus glia)\n34225: \n34226: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:19906678\") Annotation(oboInOwl:hasDbXref \"PMID:21865647\") Annotation(oboInOwl:hasDbXref \"PMID:26964064\") Annotation(oboInOwl:hasDbXref \"PMID:28066889\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047042 \"An enteric glial cell located within the myenteric ganglia of the gastrointestinal tract. This cell has a small somata and has very short, irregularly branched processes that surround neuron cell bodies, giving it a protoplasmic-like appearance. It plays crucial roles in modulating myenteric neuron activity, regulating oxidative stress, and influencing neuroinflammation and neurogenesis.\")\n34227: AnnotationAssertion(terms:contributor obo:CL_4047042 <https://orcid.org/0009-0005-7919-4905>)\n34228: AnnotationAssertion(terms:date obo:CL_4047042 \"2025-02-10T16:49:55Z\"^^xsd:dateTime)\n34229: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047042 \"type 1 MP\")\n34230: AnnotationAssertion(rdfs:label obo:CL_4047042 \"type 1 myenteric plexus glia\")\n34231: SubClassOf(obo:CL_4047042 obo:CL_4040002)\n34232: SubClassOf(obo:CL_4047042 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002439))\n34233: \n34234: # Class: obo:CL_4047043 (type 1 submucosal plexus glia)\n34235: \n34236: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fncel.2023.1170309\") Annotation(oboInOwl:hasDbXref \"PMID:28487635\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") obo:IAO_0000115 obo:CL_4047043 \"An enteric glial cell that is associated with neuron cell bodies within submucosal ganglia of the gastrointestinal tract. This cell is located in the submucosa, a layer of connective tissue beneath the intestinal mucosa. This cell plays a role in modulating secretomotor neuron activity and contributes to the regulation of digestive fluid secretion and absorption.\")\n34237: AnnotationAssertion(terms:contributor obo:CL_4047043 <https://orcid.org/0009-0005-7919-4905>)\n34238: AnnotationAssertion(terms:date obo:CL_4047043 \"2025-02-10T17:02:28Z\"^^xsd:dateTime)\n34239: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4047043 \"type I SMP\")\n34240: AnnotationAssertion(rdfs:label obo:CL_4047043 \"type 1 submucosal plexus glia\")\n34241: SubClassOf(obo:CL_4047043 obo:CL_4040002)\n34242: SubClassOf(obo:CL_4047043 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0009566))\n34243: \n34244: # Class: obo:CL_4047044 (type 2 interganglionic glia)\n34245: \n34246: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1002/glia.22876\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047044 \"An enteric glial cell that has an elongated, fibrous morphology with long processes that run parallel to nerve fibers connecting enteric myenteric ganglia. This cell is located in the interganglionic fiber tracts of the enteric nervous system.\")\n34247: AnnotationAssertion(terms:contributor obo:CL_4047044 <https://orcid.org/0009-0005-7919-4905>)\n34248: AnnotationAssertion(terms:date obo:CL_4047044 \"2025-02-11T12:28:37Z\"^^xsd:dateTime)\n34249: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35111752\") oboInOwl:hasExactSynonym obo:CL_4047044 \"type II enteric glia\")\n34250: AnnotationAssertion(rdfs:label obo:CL_4047044 \"type 2 interganglionic glia\")\n34251: SubClassOf(obo:CL_4047044 obo:CL_4040002)\n34252: SubClassOf(obo:CL_4047044 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000429))\n34253: \n34254: # Class: obo:CL_4047045 (type 3 mucosal glia)\n34255: \n34256: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25161129\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:37153631\") Annotation(oboInOwl:hasDbXref \"PMID:38957473\") obo:IAO_0000115 obo:CL_4047045 \"An enteric glial cell located in the lamina propria of the intestinal mucosa. This cell plays important roles in maintaining gut barrier function, regulating intestinal homeostasis, and mediating interactions between the enteric nervous system and the immune system.\")\n34257: AnnotationAssertion(terms:contributor obo:CL_4047045 <https://orcid.org/0009-0005-7919-4905>)\n34258: AnnotationAssertion(terms:date obo:CL_4047045 \"2025-02-11T12:39:11Z\"^^xsd:dateTime)\n34259: AnnotationAssertion(rdfs:label obo:CL_4047045 \"type 3 mucosal glia\")\n34260: SubClassOf(obo:CL_4047045 obo:CL_4040002)\n34261: SubClassOf(obo:CL_4047045 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0000030))\n34262: \n34263: # Class: obo:CL_4047047 (type I enteric glial cell)\n34264: \n34265: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/j.celrep.2023.112194\") Annotation(oboInOwl:hasDbXref \"PMID:29927320\") Annotation(oboInOwl:hasDbXref \"PMID:33731961\") Annotation(oboInOwl:hasDbXref \"PMID:35111752\") obo:IAO_0000115 obo:CL_4047047 \"An enteric glial cell located within the ganglia of the enteric nervous system. This cell is characterized by it’s small somata and short, irregularly branched processes that surround neuronal cell bodies in the myenteric and submucosal ganglia. This cell plays important roles in modulating neuronal activity and neurogenesis in the gastrointestinal tract.\")\n34266: AnnotationAssertion(terms:contributor obo:CL_4047047 <https://orcid.org/0009-0005-7919-4905>)\n34267: AnnotationAssertion(terms:date obo:CL_4047047 \"2025-02-11T13:35:14Z\"^^xsd:dateTime)\n34268: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33731961\") oboInOwl:hasExactSynonym obo:CL_4047047 \"intraganglionic glia\")\n34269: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047047 \"type 1 enteric glia\")\n\n(Showing lines 34190-34269 of 35817. Use offset=34270 to continue.)\n</content>","metadata":{"preview":"\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11146428\") Annotation(oboInOwl:hasDbXref \"PMID:32424507\") obo:IAO_0000115 obo:CL_4047036 \"A smooth muscle cell located in the middle layer of the muscularis externa of the stomach wall. This cell is arranged concentrically with the stomach's longitudinal axis, forming a continuous sheet of contractile tissue. It is fusiform in shape, containing actin and myosin filaments that enable contraction without striations. This cell contributes to the mechanical digestion and movement of food within the stomach through coordinated contractions, and plays a role in forming the pyloric sphincter in the pyloric region.\")\nAnnotationAssertion(terms:contributor obo:CL_4047036 <https://orcid.org/0009-0005-7919-4905>)\nAnnotationAssertion(terms:date obo:CL_4047036 \"2024-12-09T10:40:58Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_4047036 \"stomach smooth muscle circular layer cell\"@en)\nEquivalentClasses(obo:CL_4047036 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008857)))\n\n# Class: obo:CL_4047037 (stomach smooth muscle inner oblique layer cell)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:29493959\") obo:IAO_0000115 obo:CL_4047037 \"A smooth muscle cell found in the innermost layer of the muscularis externa of the stomach wall. This cell forms a unique layer of smooth muscle fibers oriented obliquely to the stomach's longitudinal axis. It is responsible for aiding in the mixing and churning of gastric contents, contributing to mechanical digestion within the stomach.\")\nAnnotationAssertion(terms:contributor obo:CL_4047037 <https://orcid.org/0009-0005-7919-4905>)\nAnnotationAssertion(terms:date obo:CL_4047037 \"2024-12-09T10:53:19Z\"^^xsd:dateTime)\nAnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4047037 \"stomach smooth muscle oblique layer cell\")\nAnnotationAssertion(rdfs:label obo:CL_4047037 \"stomach smooth muscle inner oblique layer cell\"@en)\nEquivalentClasses(obo:CL_4047037 ObjectIntersectionOf(obo:CL_0000192 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008862)))\n\n# Class: obo:CL_4047038 (dogiel type I neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-020-0271-2\") Annotation(oboInOwl:hasDbXref \"DOI:10.1038/s41575-021-00561-y\") Annotation(oboInOwl:hasDbXref \"PMID:32152479\") Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4047038 \"A multipolar neuron in the myenteric plexus of the gastrointestinal tract, characterized by a small to medium-sized cell body and multiple short dendrites.  This neuron exhibits fast excitatory postsynaptic potentials and can be classified into stubby, spiny and hairy subtypes based on dendritic morphology. (Brehmer, 2021)\")\nAnnotationAssertion(terms:contributor obo:CL_4047038 <https://orcid.org/0009-0005-7919-4905>)","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":1778976590450,"end":1778976590640}},"id":"prt_e33448a6c001KGFCev36WeSNEG","sessionID":"ses_1ccbc1452ffeszWjsWacrU366B","messageID":"msg_e33446ad1001rk1LqaXuKA4Td4"}}
{"type":"tool_use","timestamp":1778976590665,"sessionID":"ses_1ccbc1452ffeszWjsWacrU366B","part":{"type":"tool","tool":"read","callID":"call_oa7WFj3PI0xL6VRdQvKJfco4","state":{"status":"completed","input":{"filePath":"/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl","offset":22580,"limit":170},"output":"<path>/__w/eval-ont-agent-cl/eval-ont-agent-cl/src/ontology/cl-edit.owl</path>\n<type>file</type>\n<content>\n22580: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005023 \"branchi motor neuron\")\n22581: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005023 \"special visceral motor neuron\")\n22582: AnnotationAssertion(rdfs:label obo:CL_0005023 \"branchiomotor neuron\"@en)\n22583: EquivalentClasses(obo:CL_0005023 ObjectIntersectionOf(obo:CL_0015000 ObjectSomeValuesFrom(obo:RO_0002130 obo:UBERON_0004164)))\n22584: \n22585: # Class: obo:CL_0005024 (somatomotor neuron)\n22586: \n22587: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFIN:CVS\") obo:IAO_0000115 obo:CL_0005024 \"A motor neuron that innervates a skeletal muscle.  These motor neurons are all excitatory and cholinergic.\")\n22588: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005024 \"somatic motor neuron\")\n22589: AnnotationAssertion(rdfs:label obo:CL_0005024 \"somatomotor neuron\"@en)\n22590: EquivalentClasses(obo:CL_0005024 ObjectIntersectionOf(obo:CL_0000100 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_0008002)))\n22591: SubClassOf(obo:CL_0005024 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0014055))\n22592: \n22593: # Class: obo:CL_0005025 (visceromotor neuron)\n22594: \n22595: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ZFIN:CVS\") obo:IAO_0000115 obo:CL_0005025 \"A motor neuron that synapses to parasympathetic neurons that innervate tear glands, sweat glands, and the smooth muscles and glands of the pulmonary, cardiovascular, and gastrointestinal systems.\")\n22596: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0005025 \"general visceral motor neuron\")\n22597: AnnotationAssertion(rdfs:comment obo:CL_0005025 \"Note that these neurons do not synapse directly onto muscles\")\n22598: AnnotationAssertion(rdfs:label obo:CL_0005025 \"visceromotor neuron\"@en)\n22599: SubClassOf(obo:CL_0005025 obo:CL_0000100)\n22600: SubClassOf(obo:CL_0005025 ObjectSomeValuesFrom(obo:RO_0002120 obo:CL_0011102))\n22601: \n22602: # Class: obo:CL_0005026 (hepatoblast)\n22603: \n22604: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:CVS\") Annotation(oboInOwl:hasDbXref \"PMID:18356246\") Annotation(oboInOwl:hasDbXref \"PMID:20483998\") Annotation(oboInOwl:hasDbXref \"PMID:26798363\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0003-1940-6740\") obo:IAO_0000115 obo:CL_0005026 \"Multi fate stem cell that gives rise to both hepatocytes and cholangiocytes as descendants. The term often refers to fetal precursors of hepatocytes (differently from 'hepatic stem cell', usually applied to the self-renewing pool of hepatocyte precursors in the adult liver). Hepatoblasts may also be endogenous, as some stem cells found in the liver come from the bone marrow via blood circulation.\")\n22605: AnnotationAssertion(rdfs:label obo:CL_0005026 \"hepatoblast\"@en)\n22606: AnnotationAssertion(rdfs:seeAlso obo:CL_0005026 \"https://github.com/obophenotype/cell-ontology/issues/800\")\n22607: SubClassOf(obo:CL_0005026 obo:CL_0000048)\n22608: \n22609: # Class: obo:CL_0007000 (preameloblast)\n22610: \n22611: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2737325\") obo:IAO_0000115 obo:CL_0007000 \"Skeletogenic cell that has the potential to develop into an ameloblast. Located in the inner enamel epithelium, these cells elongate, their nuclei shift distally (away from the dental papilla), and their cytoplasm becomes filled with organelles needed for synthesis and secretion of enamel proteins.\")\n22612: AnnotationAssertion(terms:contributor obo:CL_0007000 <https://orcid.org/0000-0001-9114-8737>)\n22613: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007000 \"2012-06-15T01:27:01Z\"^^xsd:dateTime)\n22614: AnnotationAssertion(rdfs:comment obo:CL_0007000 \"unsure of neural crest contribution. In VSAO we have develops_from CL:0000008\")\n22615: AnnotationAssertion(rdfs:label obo:CL_0007000 \"preameloblast\")\n22616: SubClassOf(obo:CL_0007000 obo:CL_0011026)\n22617: SubClassOf(obo:CL_0007000 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005176))\n22618: SubClassOf(obo:CL_0007000 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0002077))\n22619: SubClassOf(obo:CL_0007000 ObjectSomeValuesFrom(obo:RO_0002220 obo:UBERON_0001763))\n22620: \n22621: # Class: obo:CL_0007001 (skeletogenic cell)\n22622: \n22623: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007001 \"Cell that has the potential to form a skeletal cell type (e.g. cells in periosteum, cells in marrow) and produce extracellular matrix (often mineralized) and skeletal tissue (often mineralized).\")\n22624: AnnotationAssertion(terms:contributor obo:CL_0007001 <https://orcid.org/0000-0001-9114-8737>)\n22625: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007001 \"2012-06-15T02:51:27Z\"^^xsd:dateTime)\n22626: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") oboInOwl:hasExactSynonym obo:CL_0007001 \"scleroblast\")\n22627: AnnotationAssertion(rdfs:comment obo:CL_0007001 \"Needs logical definition. Should be capable_of skeletal system morphogenesis? or skeletal tissue development? needs to be added to GO. NOTES:a cell type of the early embryo (see also: mesenchymal cells) that will give rise to mineralized connective tissue. Scleroblasts can differentiate into osteoblasts (bone-forming cells), chondroblasts (cartilage-forming cells), odontoblasts (dentin-forming cells), ameloblasts (enamel-forming cells). The mesenchymal cells developing into osteoblasts and chondroblasts are derived from the mesoderm. Those developing into odontoblasts are neural crest cells. Those developing into ameloblasts are derived from the ectoderm. (http://www.copewithcytokines.de/cope.cgi?key=scleroblasts)\")\n22628: AnnotationAssertion(rdfs:label obo:CL_0007001 \"skeletogenic cell\")\n22629: SubClassOf(obo:CL_0007001 obo:CL_0000000)\n22630: \n22631: # Class: obo:CL_0007002 (precementoblast)\n22632: \n22633: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007002 \"Skeletogenic cell that has the potential to develop into a cementoblast.\")\n22634: AnnotationAssertion(terms:contributor obo:CL_0007002 <https://orcid.org/0000-0001-9114-8737>)\n22635: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007002 \"2012-06-15T04:37:13Z\"^^xsd:dateTime)\n22636: AnnotationAssertion(rdfs:label obo:CL_0007002 \"precementoblast\")\n22637: SubClassOf(obo:CL_0007002 obo:CL_0011026)\n22638: SubClassOf(obo:CL_0007002 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005176))\n22639: \n22640: # Class: obo:CL_0007003 (preodontoblast)\n22641: \n22642: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007003 \"Skeletogenic cell that has the potential to form an odontoblast, deposits predentine, and arises from a cranial neural crest cell.\")\n22643: AnnotationAssertion(terms:contributor obo:CL_0007003 <https://orcid.org/0000-0001-9114-8737>)\n22644: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007003 \"2012-06-15T05:15:11Z\"^^xsd:dateTime)\n22645: AnnotationAssertion(rdfs:label obo:CL_0007003 \"preodontoblast\")\n22646: SubClassOf(obo:CL_0007003 obo:CL_0011026)\n22647: SubClassOf(obo:CL_0007003 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005176))\n22648: SubClassOf(obo:CL_0007003 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000008))\n22649: \n22650: # Class: obo:CL_0007004 (premigratory neural crest cell)\n22651: \n22652: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"UBERONREF:0000002\") obo:IAO_0000115 obo:CL_0007004 \"Cell that is part of the neural crest region of the neuroepithelium, prior to migration. Note that not all premigratory neural crest cells may become migratory neural crest cells.\")\n22653: AnnotationAssertion(terms:contributor obo:CL_0007004 <https://orcid.org/0000-0001-9114-8737>)\n22654: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007004 \"2012-06-27T08:27:35Z\"^^xsd:dateTime)\n22655: AnnotationAssertion(rdfs:label obo:CL_0007004 \"premigratory neural crest cell\")\n22656: SubClassOf(obo:CL_0007004 obo:CL_0011012)\n22657: SubClassOf(obo:CL_0007004 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002342))\n22658: SubClassOf(obo:CL_0007004 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000133))\n22659: \n22660: # Class: obo:CL_0007005 (notochordal cell)\n22661: \n22662: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007005 \"Cell that is part of the notochord.\")\n22663: AnnotationAssertion(terms:contributor obo:CL_0007005 <https://orcid.org/0000-0001-9114-8737>)\n22664: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007005 \"2012-06-27T08:47:31Z\"^^xsd:dateTime)\n22665: AnnotationAssertion(rdfs:comment obo:CL_0007005 \"NOTE: TO DO, notochord development still needs work.\")\n22666: AnnotationAssertion(rdfs:label obo:CL_0007005 \"notochordal cell\")\n22667: SubClassOf(obo:CL_0007005 obo:CL_0000000)\n22668: SubClassOf(obo:CL_0007005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002328))\n22669: SubClassOf(obo:CL_0007005 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0007006))\n22670: \n22671: # Class: obo:CL_0007006 (chordamesodermal cell)\n22672: \n22673: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007006 \"Mesodermal cell that is axially located and gives rise to the cells of the notochord.\")\n22674: AnnotationAssertion(terms:contributor obo:CL_0007006 <https://orcid.org/0000-0001-9114-8737>)\n22675: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007006 \"2012-06-27T08:52:41Z\"^^xsd:dateTime)\n22676: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0007006 \"axial mesodermal cell\")\n22677: AnnotationAssertion(rdfs:label obo:CL_0007006 \"chordamesodermal cell\")\n22678: SubClassOf(obo:CL_0007006 obo:CL_0000222)\n22679: SubClassOf(obo:CL_0007006 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0004880))\n22680: \n22681: # Class: obo:CL_0007007 (notochordal sheath cell)\n22682: \n22683: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:MAH\") obo:IAO_0000115 obo:CL_0007007 \"Notochordal cell that is part of the outer epithelium of the notochord and surrounds the vacuolated notochord cells.\")\n22684: AnnotationAssertion(terms:contributor obo:CL_0007007 <https://orcid.org/0000-0001-9114-8737>)\n22685: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007007 \"2012-06-27T09:26:37Z\"^^xsd:dateTime)\n22686: AnnotationAssertion(rdfs:label obo:CL_0007007 \"notochordal sheath cell\")\n22687: SubClassOf(obo:CL_0007007 obo:CL_0007005)\n22688: \n22689: # Class: obo:CL_0007008 (notochordal vacuole cell)\n22690: \n22691: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:MAH\") obo:IAO_0000115 obo:CL_0007008 \"Notochordal cell that is inner portion of the notochord and becomes vacuolated as development proceeds.\")\n22692: AnnotationAssertion(terms:contributor obo:CL_0007008 <https://orcid.org/0000-0001-9114-8737>)\n22693: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007008 \"2012-06-27T09:29:30Z\"^^xsd:dateTime)\n22694: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") oboInOwl:hasExactSynonym obo:CL_0007008 \"chordablast\")\n22695: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:14574572\") oboInOwl:hasExactSynonym obo:CL_0007008 \"chordoblast\")\n22696: AnnotationAssertion(rdfs:label obo:CL_0007008 \"notochordal vacuole cell\")\n22697: SubClassOf(obo:CL_0007008 obo:CL_0007005)\n22698: \n22699: # Class: obo:CL_0007009 (prechondroblast)\n22700: \n22701: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007009 \"Skeletogenic cell that has the potential to develop into a chondroblast; and arises from neural crest, meseosdermal and notochordal and connective tissue cells.\")\n22702: AnnotationAssertion(terms:contributor obo:CL_0007009 <https://orcid.org/0000-0001-9114-8737>)\n22703: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007009 \"2012-06-27T10:44:01Z\"^^xsd:dateTime)\n22704: AnnotationAssertion(rdfs:label obo:CL_0007009 \"prechondroblast\")\n22705: SubClassOf(obo:CL_0007009 obo:CL_0011026)\n22706: \n22707: # Class: obo:CL_0007010 (preosteoblast)\n22708: \n22709: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO_REF:0000034\") obo:IAO_0000115 obo:CL_0007010 \"Skeletogenic cell that has the potential to transform into an osteoblast, and develops from neural crest or mesodermal cells.\")\n22710: AnnotationAssertion(terms:contributor obo:CL_0007010 <https://orcid.org/0000-0001-9114-8737>)\n22711: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007010 \"2012-06-27T10:57:21Z\"^^xsd:dateTime)\n22712: AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0007010 \"osteoprogenitor cell\")\n22713: AnnotationAssertion(rdfs:label obo:CL_0007010 \"preosteoblast\")\n22714: SubClassOf(obo:CL_0007010 obo:CL_0011026)\n22715: SubClassOf(obo:CL_0007010 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0008883))\n22716: SubClassOf(obo:CL_0007010 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000222))\n22717: SubClassOf(obo:CL_0007010 ObjectSomeValuesFrom(obo:RO_0002202 obo:CL_0000333))\n22718: \n22719: # Class: obo:CL_0007011 (enteric neuron)\n22720: \n22721: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"CL:MAH\") obo:IAO_0000115 obo:CL_0007011 \"Neuron that is part of the enteric nervous system.\")\n22722: AnnotationAssertion(terms:contributor obo:CL_0007011 <https://orcid.org/0000-0001-9114-8737>)\n22723: AnnotationAssertion(oboInOwl:creation_date obo:CL_0007011 \"2012-06-28T08:20:31Z\"^^xsd:dateTime)\n22724: Annotati