ion(Annotation(oboInOwl:hasDbXref \"MESH:D013093\") obo:IAO_0000115 obo:CL_0000020 \"An euploid male germ cell of an early stage of spermatogenesis.\")\n\n  Line 3923: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11023867\") Annotation(oboInOwl:hasDbXref \"PMID:20454446\") obo:IAO_0000115 obo:CL_0000021 \"Female germ cell is a germ cell that supports female gamete production.\")\n\n  Line 3933: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1016/j.stem.2012.05.016\") obo:IAO_0000115 obo:CL_0000022 \"A stem cell that is the precursor of female gametes.\")\n\n  Line 3941: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000023 \"A female germ cell that has entered meiosis.\")\n\n  Line 3955: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000024 \"An undifferentiated germ cell that proliferates rapidly and gives rise to oocytes.\")\n\n  Line 3964: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000025 \"A female gamete where meiosis has progressed to metaphase II and is able to participate in fertilization.\")\n\n  Line 3980: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15848391\") obo:IAO_0000115 obo:CL_0000026 \"A germline cell that contributes to the development of the oocyte by transferring cytoplasm directly to oocyte.\")\n\n  Line 3990: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000027 \"A smooth muscle cell derived from the neural crest.\")\n\n  Line 4013: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37824650\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Glioblast\") obo:IAO_0000115 obo:CL_0000