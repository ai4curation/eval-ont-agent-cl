3:# Class: obo:CL_0002066 (Feyrter cell)\n14615:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002066 \"A neuroendocrine cell found in the epithelium of the lungs and respiratory tract. This cell type is rounded or elliptical in shape, situated mainly in the basal part of the epithelium; regulates bronchial secretion, smooth muscle contraction, lobular growth, ciliary activity and chemoreception. Cell has an electron-lucent cytoplasm, contains numerous dense-cored vesicles with a clear halo between the core and the limiting membrane.\")\n14616:AnnotationAssertion(terms:contributor obo:CL_0002066 <https://orcid.org/0000-0003-1980-3228>)\n14617:AnnotationAssertion(oboInOwl:creation_date obo:CL_0002066 \"2010-06-28T08:24:30Z\"^^xsd:dateTime)\n14618:AnnotationAssertion(oboInOwl:hasDbXref obo:CL_0002066 \"FMA:14118\")\n14619:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002066 \"Kultschitzky cell of bronchiole\")\n14620:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002066 \"bronchiolar Kulchitsky cell\")\n14621:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002066 \"respiratory enterochromaffin cell\")\n14622:AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_0002066 \"P cell\")\n14623:AnnotationAssertion(rdfs:label obo:CL_0002066 \"Feyrter cell\")\n14624:SubClassOf(obo:CL_0002066 obo:CL_0000165)\n14626:# Class: obo:CL_0002067 (type A enteroendocrine cell)\n14628:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") obo:IAO_0000115 obo:CL_0002067 \"An enteroendocrine cell that produces glucagon.\")\n14629:AnnotationAssertion(terms:contributor obo:CL_0002067 <https://orcid.org/0000-0003-1980-3228>)\n14630:AnnotationAssertion(oboInOwl:creation_date obo:CL_0002067 \"2010-09-10T10:48:54Z\"^^xsd:dateTime