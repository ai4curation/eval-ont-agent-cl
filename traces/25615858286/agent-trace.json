AO_0000115 obo:CL_0002668 \"An otic fibrocyte that is lateral to the basilar membrane and anchoris it to the lateral wall.\")\n20825:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV otic fibrocyte\")\n20826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004490\") oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV spiral ligament fibrocyte\")\n20827:AnnotationAssertion(rdfs:label obo:CL_0002668 \"type 4 otic fibrocyte\")\n20830:# Class: obo:CL_0002669 (type 3 otic fibrocyte)\n20832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002669 \"An otic fibrocyte that lines the otic capsule.\")\n20835:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002669 \"type III otic fibrocyte\")\n20836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004489\") oboInOwl:hasExactSynonym obo:CL_0002669 \"type III spiral ligament fibrocyte\")\n20837:AnnotationAssertion(rdfs:label obo:CL_0002669 \"type 3 otic fibrocyte\")\n20840:# Class: obo:CL_0002670 (type 1 otic fibrocyte)\n20842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002670 \"An otic fibrocyte that underlies the stria vascularis and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20845:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002670 \"type I otic fibrocyte\")\n20846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004487\") oboInOwl:hasExactSynonym obo:CL_0002670 \"type I spiral ligament fibrocyte\")\n20847:AnnotationAssertion(rdfs:label obo:CL_0002670 \"type 1 otic fibrocyte\")\n26295:EquivalentClasses(obo:CL_1000376 ObjectIntersectionOf(obo:CL_0002068 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0002094)))\n26296:SubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_1000376 obo:CL_0002068)\n26303:EquivalentClasses(obo:CL_1000377 Objec