{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"rg -n -i 'tendon cell|fibroblast|fibrocyte|otic fibrocyte|mesenchymal cell|tendon' src/ontology/cl-edit.owl\"","aggregated_output":"3743:# Class: obo:CL_0000005 (neural crest derived fibroblast)\n3745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-5208-3432\") obo:IAO_0000115 obo:CL_0000005 \"Any fibroblast that is derived from the neural crest.\")\n3746:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000005 \"fibroblast neural crest derived\")\n3747:AnnotationAssertion(rdfs:label obo:CL_0000005 \"neural crest derived fibroblast\")\n4279:# Class: obo:CL_0000057 (fibroblast)\n4281:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D005347\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Fibroblast\") obo:IAO_0000115 obo:CL_0000057 \"A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped.\")\n4288:AnnotationAssertion(rdfs:label obo:CL_0000057 \"fibroblast\")\n5048:AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:CL_0000134 \"colony-forming unit-fibroblast\")\n5059:AnnotationAssertion(rdfs:comment obo:CL_0000134 \"Many but not all mesenchymal cells derive from the mesoderm. MSCs are reportedly CD3-negative, CD4-negative, CD5-negative, CD8-negative, CD11a-negative, CD11b-negative, CD14-negative, CD19-negative, CD29-positive, CD31-negative, CD34-negative, CD38-negative, CD40-negative, CD44-positive, CD45-negative, CD49-positive, CD54-positive, CD66b-negative, CD79a-negative, CD80-negative, CD102-positive, CD106-positive, CD117-positive, CD121a-positive, CD121b-positive, CD123-positive, CD124-positive, CD133-negative, CD146-positive, CD166-positive, CD271-positive, B220-negative, Gr1-negative, MHCI-positive, MHCII-negative, SSEA4-negative, sca1-positive, Ter119-negative, and glycophorin A-negative. Cultured MSCs are capable of producing stem cell factor, IL7, IL8, IL11, TGF-beta, cofilin, galectin-1, laminin-receptor 1, cyclophilin A, and MMP-2.\")\n5065:# Class: obo:CL_0000135 (fibrocyte)\n5067:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:11641248\") Annotation(oboInOwl:hasDbXref \"PMID:15010326\") Annotation(oboInOwl:hasDbXref \"PMID:17607298\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:8790603\") Annotation(oboInOwl:hasDbXref \"PMID:9551999\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Fibrocyte\") obo:IAO_0000115 obo:CL_0000135 \"An inactive fibroblast; cytoplasm is sparse, endoplasmic reticulum is scanty with flattened nucleus. Term used by some histologists; when fibroblasts become relatively inactive in fiber formation. However, this cell has the potential for fibrogenesis in quiescent connective tissue of the adult, as well as during development, other histologists prefer to use the term fibroblast in all circumstances. These cells represent ~0.5% of peripheral blood leukocytes.\")\n5069:AnnotationAssertion(rdfs:comment obo:CL_0000135 \"Cultured human fibrocytes are MHCI-positive, MHCII-positive, CD1a-negative, CD3-negative, CD4-negative, CD8-negative, CD10-negative, CD11b-positive, CD13-positive, CD14-negative, CD16-negative, CD18-positive, CD19-negative, CD25-negative, CD29-positive, CD32-positive, CD33-negative, CD34-positive, CD38-negative, CD40-positive, CD44-negative, CD45RO-positive, CD49a-positive, CD49b-positive, CD49c-negative, CD49d-negative, CD49e-positive, CD49f-negative, CD56-negative, CD58-positive, CD61-positive, CD64-positive, CD70-negative, CD71-positive, CD80-positive, CD83-negative, CD86-positive, CD103-negative, CD105-positive, CD181-positive, CD182-negative, CD183-positive, CD184-positive, CD185-negative, CD186-negative, CD191-positive, CD192-negative, CD193-positive, CD194-positive, CD195-positive, CD196-negative, CD197-positive, CD199-positive, desmin-negative, F4/80-positive, Gr1-positive, LSP-1-positive, MHCI-positive, MHCII-positive, alpha-SMA-negative, TCRab-negative, TCRgd-negative, and vimentin-positive. Fibrocytes are also capable of secreting angiogenin, bFGF, CCL2, CCL3, CCL4, CCL8, CXCL1, type I collagen, type III collagen, CTGF, fibronectin, GM-CSF, IL-1a, IL-6, IL-8, IL-10, M-CSF, MMP-9, PDGF-A, TGF-alpha, TGF-beta1, TNF-alpha, and VEGF-A.\")\n5070:AnnotationAssertion(rdfs:label obo:CL_0000135 \"fibrocyte\")\n5554:# Class: obo:CL_0000186 (myofibroblast cell)\n5556:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MESH:D058628\") Annotation(oboInOwl:hasDbXref \"PMID:19800625\") Annotation(oboInOwl:hasDbXref \"PMID:20630469\") Annotation(oboInOwl:hasDbXref \"PMID:22387320\") obo:IAO_0000115 obo:CL_0000186 \"An animal cell that has characteristics of both a fibroblast cell and a smooth muscle cell.\")\n5558:AnnotationAssertion(rdfs:comment obo:CL_0000186 \"Myofibroblasts are alpha-SMA-positive, CD34-negative, CD45-negative. They are reportedly capable of secreting IL-1beta, IL-6, and TNF-alpha.\")\n5559:AnnotationAssertion(rdfs:label obo:CL_0000186 \"myofibroblast cell\")\n6705:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:5025404\") obo:IAO_0000115 obo:CL_0000335 \"A mesenchymal cell in embryonic development found in a contracting mass and that gives rise to osteoprogenitors.\")\n6781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0000345 \"A mesenchymal cell that is part of a small mass of condensed mesenchyme in the enamel organ; it differentiates into the dentin and dental pulp.\")\n6790:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:9893172\") obo:IAO_0000115 obo:CL_0000346 \"A specialized mesenchymal cell that resides in the dermal papilla located at the bottom of hair follicles. This cell plays a pivotal roles in hair formation, growth, and cycling.\")\n7093:# Class: obo:CL_0000388 (tendon cell)\n7095:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:NV\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:957445\") obo:IAO_0000115 obo:CL_0000388 \"An elongated fibrocyte that is part of a tendon. The cytoplasm is stretched between the collagen fibres of the tendon. They have a central cell nucleus with a prominent nucleolus. Tendon cells have a well-developed rough endoplasmic reticulum and they are responsible for synthesis and turnover of tendon fibres and ground substance.\")\n7098:AnnotationAssertion(rdfs:label obo:CL_0000388 \"tendon cell\")\n7405:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Reticular_cell\") obo:IAO_0000115 obo:CL_0000432 \"A fibroblast that synthesizes collagen and uses it to produce reticular fibers, thus providing structural support. Reticular cells are found in many organs, including the spleen, lymph nodes and kidneys. Subtypes of reticular cells include epithelial, mesenchymal, and fibroblastic reticular cells. Fibroblastic reticular cells are involved in directing B cells and T cells to specific regions within a tissue, whereas epithelial and mesenchymal reticular cells are associated with certain areas of the brain.\")\n8575:# Class: obo:CL_0000566 (angioblastic mesenchymal cell)\n8581:AnnotationAssertion(rdfs:label obo:CL_0000566 \"angioblastic mesenchymal cell\")\n8601:# Class: obo:CL_0000569 (cardiac mesenchymal cell)\n8603:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0000569 \"A mesenchymal cell found in the developing heart and that develops into some part of the heart.  These cells derive from intra- and extra-cardiac sources, including the endocardium, epicardium, neural crest, and second heart field.\")\n8604:AnnotationAssertion(rdfs:label obo:CL_0000569 \"cardiac mesenchymal cell\")\n9181:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"MESH:D055166\") Annotation(oboInOwl:hasDbXref \"PMID:12808230\") Annotation(oboInOwl:hasDbXref \"PMID:17239632\") Annotation(oboInOwl:hasDbXref \"PMID:18222966\") Annotation(oboInOwl:hasDbXref \"PMID:9302568\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Hepatic_stellate_cell\") obo:IAO_0000115 obo:CL_0000632 \"A cell that is found in the perisinusoidal space of the liver that is capable of multiple roles including storage of retinol, presentation of antigen to T cells (including CD1d-restricted NKT cells), and upon activation, production of extracellular matrix components that can contribute to liver fibrosis. This activated state has a myofibroblast-like phenotype, though it's not clear in the literature if this is terminally differentiated. This cell type comprises approximately 8-15% of total cells in the liver.\")\n9536:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:dsd\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"MESH:D020286\") Annotation(oboInOwl:hasDbXref \"PMID:16807374\") Annotation(oboInOwl:hasDbXref \"PMID:17986482\") Annotation(oboInOwl:hasDbXref \"PMID:20024907\") obo:IAO_0000115 obo:CL_0000669 \"An elongated, contractile cell found wrapped about precapillary arterioles outside the basement membrane. Pericytes are present in capillaries where proper adventitia and muscle layer are missing (thus distingushing this cell type from adventitial cells). They are relatively undifferentiated and may become fibroblasts, macrophages, or smooth muscle cells.\")\n9698:# Class: obo:CL_0000688 (perijunctional fibroblast)\n9700:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"JB:jb\") obo:IAO_0000115 obo:CL_0000688 \"A fibroblast-like cell that provides support at neuromuscular junctions in vertebrates and are localized outside the synaptic basal lamina.\")\n9701:AnnotationAssertion(rdfs:label obo:CL_0000688 \"perijunctional fibroblast\")\n14754:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002078 \"epithelial mesenchymal cell\")\n14913:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0618947256\") obo:IAO_0000115 obo:CL_0002092 \"A cell found in the bone marrow. This can include fibroblasts, macrophages, adipocytes, osteoblasts, osteoclasts, endothelial cells and hematopoietic cells.\")\n16502:# Class: obo:CL_0002240 (marrow fibroblast)\n16504:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002240 \"A fibroblast in the bone marrow.\")\n16508:AnnotationAssertion(rdfs:label obo:CL_0002240 \"marrow fibroblast\")\n16512:# Class: obo:CL_0002241 (pulmonary interstitial fibroblast)\n16514:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002241 \"A fibroblasts found in interstitial spaces in the pulmonary tract. Greater numbers of these cells are found in idiopathic pulmonary fibrosis.\")\n16518:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002241 \"pulmonary myofibroblast\")\n16520:AnnotationAssertion(rdfs:label obo:CL_0002241 \"pulmonary interstitial fibroblast\")\n16663:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:30013421\") Annotation(oboInOwl:hasDbXref \"PMID:30309298\") Annotation(oboInOwl:hasDbXref \"PMID:31907034\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Decidualization\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1038/s41591-020-1040-z\") obo:IAO_0000115 obo:CL_0002255 \"A stromal cell of the endometrium, characterized by its fibroblast-like morphology, regenerative capacity, and ability to undergo decidualization. It differentiates into a decidual stromal cell during pregnancy, essential for embryo implantation and maintenance. This cell is involved in tissue proliferation, remodeling, and breakdown, responding to hormonal changes, particularly estrogen and progesterone.\")\n16670:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30309298\") oboInOwl:hasExactSynonym obo:CL_0002255 \"endometrial stromal fibroblast\")\n17094:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n17190:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002301 \"fibroblast-like synoviocyte\")\n17191:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23147896\") oboInOwl:hasExactSynonym obo:CL_0002301 \"synovial fibroblast\")\n17192:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34433485\") Annotation(oboInOwl:hasDbXref \"https://en.wikipedia.org/wiki/Fibroblast-like_synoviocyte\") rdfs:comment obo:CL_0002301 \"Type B synovial cells play a key role in the pathogenesis of chronic inflammatory diseases, such as rheumatoid arthritis, and are essential for the maintenance of normal joint functions. Fibroblast-like synoviocytes from different joints have different properties, which may contribute to the characteristic pattern of joint involvement in different types of arthritis.\")\n17577:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18793119\") obo:IAO_0000115 obo:CL_0002334 \"An undifferentiated fibroblast that can be stimulated to form a fat cell.\")\n17863:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:9780702029585\") obo:IAO_0000115 obo:CL_0002363 \"A keratocyte is a specialized fibroblast residing in the cornea stroma that has a flattened, dendritic morphology; located between the lamellae with a large flattened nucleus, and lengthy processes which communicate with neighboring cells. This corneal layer, representing about 85-90% of corneal thickness, is built up from highly regular collagenous lamellae and extracellular matrix components. Keratocytes play the major role in keeping it transparent, healing its wounds, and synthesizing its components. This cell type secretes collagen I, V, VI, and keratan sulfate.\")\n17866:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002363 \"corneal fibroblast\")\n17998:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35815410\") rdfs:comment obo:CL_0002375 \"Schwann cell precursor are capable of differentiating into Schwann cells and other cell types such as melanocytes, neurons, and mesenchymal cells.\")\n18330:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:mah\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17200706\") obo:IAO_0000115 obo:CL_0002410 \"A cell that is found in the periacinar space of the exocrine pancreas and in perivascular and periductal regions of the pancreas, and has long cytoplasmic processes that encircle the base of the acinus. Expresses several intermediate filament proteins including vimentin and nestin. Shares many of the characteristics of hepatatic stellate cells, but not stellate cells of the central nervous system. Upon activation, this cell type undergoes morphological and gene expression changes that make the cell suggestive of being a type of myofibroblast.\")\n18404:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0813817986\") Annotation(oboInOwl:hasDbXref \"PMID:11495698\") obo:IAO_0000115 obo:CL_0002418 \"A pluripotent cell in the yolk sac that can give rise to mesenchymal cells including erythrocytes and endothelial cells.\")\n19163:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"MP:0004365\") obo:IAO_0000115 obo:CL_0002493 \"A polarized cell that is juxtaposed to fibrocytes in the underlying spiral ligament. This cell type secretes potassium ions derived from fibrocytes through gap junctions.\")\n19678:# Class: obo:CL_0002547 (fibroblast of the aortic adventitia)\n19680:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002547 \"A fibroblast of the aortic adventitia.\")\n19683:AnnotationAssertion(rdfs:label obo:CL_0002547 \"fibroblast of the aortic adventitia\")\n19687:# Class: obo:CL_0002548 (fibroblast of cardiac tissue)\n19689:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002548 \"A fibroblast that is part of the heart.\")\n19692:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002548 \"cardiac fibroblast\")\n19693:AnnotationAssertion(rdfs:label obo:CL_0002548 \"fibroblast of cardiac tissue\")\n19698:# Class: obo:CL_0002549 (fibroblast of choroid plexus)\n19700:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002549 \"A fibroblast that is part of the choroid plexus.\")\n19703:AnnotationAssertion(rdfs:label obo:CL_0002549 \"fibroblast of choroid plexus\")\n19707:# Class: obo:CL_0002550 (fibroblast of the conjunctiva)\n19709:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002550 \"A fibroblast that is part of the conjuctiva of the eye.\")\n19712:AnnotationAssertion(rdfs:label obo:CL_0002550 \"fibroblast of the conjunctiva\")\n19716:# Class: obo:CL_0002551 (fibroblast of dermis)\n19720:AnnotationAssertion(rdfs:label obo:CL_0002551 \"fibroblast of dermis\")\n19724:# Class: obo:CL_0002552 (fibroblast of gingiva)\n19728:AnnotationAssertion(rdfs:label obo:CL_0002552 \"fibroblast of gingiva\")\n19732:# Class: obo:CL_0002553 (fibroblast of lung)\n19734:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002553 \"A fibroblast that is part of lung.\")\n19739:AnnotationAssertion(rdfs:label obo:CL_0002553 \"fibroblast of lung\")\n19743:# Class: obo:CL_0002554 (fibroblast of lymphatic vessel)\n19745:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002554 \"A fibroblast of the lymphatic system.\")\n19748:AnnotationAssertion(rdfs:label obo:CL_0002554 \"fibroblast of lymphatic vessel\")\n19752:# Class: obo:CL_0002555 (fibroblast of mammary gland)\n19754:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002555 \"A fibroblast that is part of the mammary gland.\")\n19757:AnnotationAssertion(rdfs:label obo:CL_0002555 \"fibroblast of mammary gland\")\n19761:# Class: obo:CL_0002556 (fibroblast of periodontium)\n19763:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002556 \"A fibroblast of the periodontium.\")\n19766:AnnotationAssertion(rdfs:label obo:CL_0002556 \"fibroblast of periodontium\")\n19770:# Class: obo:CL_0002557 (fibroblast of pulmonary artery)\n19772:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002557 \"A fibroblast of pulmonary artery.\")\n19775:AnnotationAssertion(rdfs:label obo:CL_0002557 \"fibroblast of pulmonary artery\")\n19779:# Class: obo:CL_0002558 (fibroblast of villous mesenchyme)\n19781:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002558 \"A fibroblast that is part of villous mesenchyme.\")\n19784:AnnotationAssertion(rdfs:label obo:CL_0002558 \"fibroblast of villous mesenchyme\")\n19949:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GO:tfm\") Annotation(oboInOwl:hasDbXref \"NCIT:C41442\") Annotation(oboInOwl:hasDbXref \"PMID:25818566\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Perineurium\") obo:IAO_0000115 obo:CL_0002576 \"A glial cell that is part of the perineurium. This cell type has thin long bipolar cytoplasmic processes, pinocytotic vesicles, fragments of external lamina and/or external lamina-like material, attachment plaques, and desmosome-like junctions. Perineurial cells historically have been referred to as fibroblasts because of shape; however, unlike fibroblasts, a perineurial cell: does not have a compact nucleus and large endoplasmic reticulum; does have a double basement membrane opposed to a single basal lamina; is carefully joined to other perineurial cells by tight junctions into a single sheet as opposed to arranged in a large mass; and finally, can surround a small axon bundle at a nerve terminal whereas a fibroblast cannot.\")\n19954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36244793\") rdfs:comment obo:CL_0002576 \"There are studies that largely accept the idea that the perineurial cell is a modified fibroblast with myofibroblastic features.\")\n20358:# Class: obo:CL_0002620 (skin fibroblast)\n20360:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002620 \"A fibroblast of skin.\")\n20365:AnnotationAssertion(rdfs:label obo:CL_0002620 \"skin fibroblast\")\n20791:# Class: obo:CL_0002665 (otic fibrocyte)\n20793:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002665 \"A fibrocyte of the cochlea that has specialized structural and molecular adaptions.\")\n20796:AnnotationAssertion(rdfs:label obo:CL_0002665 \"otic fibrocyte\")\n20800:# Class: obo:CL_0002666 (type 2 otic fibrocyte)\n20802:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002666 \"An otic fibrocyte that underlies the spiral prominence and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20805:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002666 \"type II otic fibrocyte\")\n20806:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004488\") oboInOwl:hasExactSynonym obo:CL_0002666 \"type II spiral ligament fibrocyte\")\n20807:AnnotationAssertion(rdfs:label obo:CL_0002666 \"type 2 otic fibrocyte\")\n20810:# Class: obo:CL_0002667 (type 5 otic fibrocyte)\n20812:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002667 \"An otic fibrocyte that resides above the stria vasularis and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20815:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002667 \"type V otic fibrocyte\")\n20816:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002667 \"type V spiral ligament fibrocyte\")\n20817:AnnotationAssertion(rdfs:label obo:CL_0002667 \"type 5 otic fibrocyte\")\n20820:# Class: obo:CL_0002668 (type 4 otic fibrocyte)\n20822:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002668 \"An otic fibrocyte that is lateral to the basilar membrane and anchoris it to the lateral wall.\")\n20825:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV otic fibrocyte\")\n20826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004490\") oboInOwl:hasExactSynonym obo:CL_0002668 \"type IV spiral ligament fibrocyte\")\n20827:AnnotationAssertion(rdfs:label obo:CL_0002668 \"type 4 otic fibrocyte\")\n20830:# Class: obo:CL_0002669 (type 3 otic fibrocyte)\n20832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002669 \"An otic fibrocyte that lines the otic capsule.\")\n20835:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002669 \"type III otic fibrocyte\")\n20836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004489\") oboInOwl:hasExactSynonym obo:CL_0002669 \"type III spiral ligament fibrocyte\")\n20837:AnnotationAssertion(rdfs:label obo:CL_0002669 \"type 3 otic fibrocyte\")\n20840:# Class: obo:CL_0002670 (type 1 otic fibrocyte)\n20842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:18353863\") obo:IAO_0000115 obo:CL_0002670 \"An otic fibrocyte that underlies the stria vascularis and is part of a mesenchymal gap junction network that regulates ionic homeostasis of the endolymph.\")\n20845:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0002670 \"type I otic fibrocyte\")\n20846:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MP:0004487\") oboInOwl:hasExactSynonym obo:CL_0002670 \"type I spiral ligament fibrocyte\")\n20847:AnnotationAssertion(rdfs:label obo:CL_0002670 \"type 1 otic fibrocyte\")\n22477:AnnotationAssertion(rdfs:comment obo:CL_0007001 \"Needs logical definition. Should be capable_of skeletal system morphogenesis? or skeletal tissue development? needs to be added to GO. NOTES:a cell type of the early embryo (see also: mesenchymal cells) that will give rise to mineralized connective tissue. Scleroblasts can differentiate into osteoblasts (bone-forming cells), chondroblasts (cartilage-forming cells), odontoblasts (dentin-forming cells), ameloblasts (enamel-forming cells). The mesenchymal cells developing into osteoblasts and chondroblasts are derived from the mesoderm. Those developing into odontoblasts are neural crest cells. Those developing into ameloblasts are derived from the ectoderm. (http://www.copewithcytokines.de/cope.cgi?key=scleroblasts)\")\n22819:# Class: obo:CL_0008019 (mesenchymal cell)\n22823:AnnotationAssertion(rdfs:label obo:CL_0008019 \"mesenchymal cell\")\n22842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:18816864\") obo:IAO_0000115 obo:CL_0008022 \"A mesenchymal cell of the endocardial cushion.   These cells develop via an epithelial to mesenchymal transition when endocardial cells break cell-to-cell contacts and migrate into the cardiac jelly. Cells from this population form the heart septa and valves.\")\n22846:# Class: obo:CL_0008023 (obsolete cardiac fibroblast)\n22850:AnnotationAssertion(rdfs:label obo:CL_0008023 \"obsolete cardiac fibroblast\")\n23043:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.1016/B978-0-443-10321-6.00004-7\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Extrafusal_muscle_fiber&oldid=978415293\") obo:IAO_0000115 obo:CL_0008046 \"A skeletal muscle fiber that is innervated by alpha motor neuron and generates tension by contracting, thereby allowing for skeletal movement. These fibers make up the large mass of skeletal muscle tissue and are attached to bones by tendons.\")\n23938:# Class: obo:CL_0009078 (thymic fibroblast type 1)\n23940:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009078 \"A fibroblast located in the thymic capsule.\")\n23943:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009078 \"thymic capsular fibroblast\")\n23944:AnnotationAssertion(rdfs:label obo:CL_0009078 \"thymic fibroblast type 1\")\n23948:# Class: obo:CL_0009079 (thymic fibroblast type 2)\n23950:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32079746\") obo:IAO_0000115 obo:CL_0009079 \"A fibroblast located between thymic lobules.\")\n23953:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009079 \"thymic interlobular fibroblast\")\n23954:AnnotationAssertion(rdfs:label obo:CL_0009079 \"thymic fibroblast type 2\")\n24165:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20081841\") Annotation(oboInOwl:hasDbXref \"PMID:22045730\") Annotation(oboInOwl:hasDbXref \"PMID:24605102\") obo:IAO_0000115 obo:CL_0009099 \"A progenitor cell that is a tissue-resident mesenchymal cell, important for skeletal muscle regeneration, and able to differentiate into both adipocytes or fibroblasts.\")\n24173:# Class: obo:CL_0009100 (hepatic portal fibroblast)\n24175:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:20209607\") Annotation(oboInOwl:hasDbXref \"PMID:24814904\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009100 \"A fibroblast located in the portal triad. Hepatic portal fibroblast are a non-parenchymal cell population located adjacent to bile duct epithelia in liver and are distinct from stellate cells. They differentiate into fibrogenic myofibroblasts during chronic injury states producing high levels of collagen.\")\n24178:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009100 \"portal fibroblast\")\n24179:AnnotationAssertion(rdfs:label obo:CL_0009100 \"hepatic portal fibroblast\")\n24182:# Class: obo:CL_0009101 (fibroblastic reticular cell)\n24188:AnnotationAssertion(rdfs:label obo:CL_0009101 \"fibroblastic reticular cell\")\n24193:# Class: obo:CL_0009102 (lymph node fibroblastic reticular cell)\n24195:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009102 \"A specialized, fibroblastic reticular cell of mesenchymal origin found in lymph nodes. In human, it expresses several markers common to myofibroblasts (desmin, vimentin, CD73, CD90, α-smooth muscle actin (αSMA)), and can be differentiated from endothelial cells by its lack of CD31 expression. These cells are critical for the overall organization and function of the lymph node. Lymph node fibroblastic reticular cells (FRCs) can be further classified based on their location, function, and unique marker expression.\")\n24199:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_0009102 \"fibroblastic reticular cell\")\n24200:AnnotationAssertion(rdfs:label obo:CL_0009102 \"lymph node fibroblastic reticular cell\")\n24206:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009103 \"A fibroblastic reticular cell found in the lymph node subcapsular sinus.\")\n24218:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009104 \"A fibroblastic reticular cell found in the lymph node germinal center dark zone (B cell zone).\")\n24222:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009104 \"lymph node germinal center dark zone fibroblastic reticular cell\")\n24232:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009105 \"A fibroblastic reticular cell found in the lymph node T cell domain.\")\n24236:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0009105 \"lymph node T cell domain fibroblastic reticular cell\")\n24245:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21435450\") Annotation(oboInOwl:hasDbXref \"PMID:22566825\") Annotation(oboInOwl:hasDbXref \"PMID:25998961\") Annotation(oboInOwl:hasDbXref \"PMID:28262465\") Annotation(oboInOwl:hasDbXref \"PMID:29752062\") Annotation(oboInOwl:hasDbXref \"PMID:33981032\") Annotation(oboInOwl:hasDbXref \"PMID:34256989\") Annotation(oboInOwl:hasDbXref \"https://orcid.org/0000-0001-7655-4833\") obo:IAO_0000115 obo:CL_0009106 \"A specialized fibroblast found in the medulla of lymph node.\")\n24661:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:add\") Annotation(oboInOwl:hasDbXref \"PMID:19029905\") Annotation(oboInOwl:hasDbXref \"PMID:21601793\") Annotation(oboInOwl:hasDbXref \"PMID:27935637\") Annotation(oboInOwl:hasDbXref \"PMID:29454785\") Annotation(oboInOwl:hasDbXref \"PMID:9354470\") obo:IAO_0000115 obo:CL_0011018 \"A group 3 innate lymphoid cell that express ROR gamma t and IL-7R alpha in the absence of lineage markers (e.g. CD3, CD19, B220, CD11c, Gr-1), with the functional ability to interact with mesenchymal cells through lymphotoxin and tumor necrosis factor. Lymphoid tissue-inducer cells are key to the development of lymph nodes and Peyer’s patches.\")\n24685:# Class: obo:CL_0011021 (fibroblast of upper back skin)\n24687:AnnotationAssertion(obo:IAO_0000115 obo:CL_0011021 \"A fibroblast that is part of upper back skin.\")\n24689:AnnotationAssertion(rdfs:label obo:CL_0011021 \"fibroblast of upper back skin\")\n24693:# Class: obo:CL_0011022 (fibroblast of skin of back)\n24695:AnnotationAssertion(obo:IAO_0000115 obo:CL_0011022 \"A fibroblast that is part of skin of back.\")\n24697:AnnotationAssertion(rdfs:label obo:CL_0011022 \"fibroblast of skin of back\")\n24738:# Cla