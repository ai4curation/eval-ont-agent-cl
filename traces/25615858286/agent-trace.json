9247:AnnotationAssertion(rdfs:label obo:CL_2000066 \"cardiac ventricle fibroblast\")\n29250:# Class: obo:CL_2000067 (cardiac atrium fibroblast)\n29252:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000067 \"Any fibroblast that is part of a cardiac atrium.\")\n29257:AnnotationAssertion(rdfs:label obo:CL_2000067 \"cardiac atrium fibroblast\")\n29260:# Class: obo:CL_2000068 (pericardium fibroblast)\n29262:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000068 \"Any fibroblast that is part of a pericardium.\")\n29267:AnnotationAssertion(rdfs:label obo:CL_2000068 \"pericardium fibroblast\")\n29270:# Class: obo:CL_2000069 (gallbladder fibroblast)\n29272:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000069 \"Any fibroblast that is part of a gallbladder.\")\n29277:AnnotationAssertion(rdfs:label obo:CL_2000069 \"gallbladder fibroblast\")\n29280:# Class: obo:CL_2000070 (optic choroid fibroblast)\n29282:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000070 \"Any fibroblast that is part of a optic choroid.\")\n29287:AnnotationAssertion(rdfs:label obo:CL_2000070 \"optic choroid fibroblast\")\n29498:# Class: obo:CL_2000093 (bronchus fibroblast of lung)\n29500:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000093 \"Any fibroblast of lung that is part of a bronchus.\")\n29504:AnnotationAssertion(rdfs:label obo:CL_2000093 \"bronchus fibroblast of lung\")\n29525:# Class: obo:CL_2000096 (fibroblast of the reticular layer of dermis)\n29527:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:TermGenie\") obo:IAO_0000115 obo:CL_2000096 \"Any fibroblast that is part of a reticular layer of dermis.\")\n29531:AnnotationAssertion(rdfs:label obo:CL_2000096 \"fibroblast of the reticular layer of dermis\")\n29594:# Class: obo:CL_4006000 (fibroblast of breast)\n29596:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006000 \"A fibroblast that is part of the breast.\")\n29598:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006000 \"breast fibroblast\")\n29599:AnnotationAssertion(rdfs:label obo:CL_4006000 \"fibroblast of breast\")\n29603:# Class: obo:CL_4006001 (fibroblast of skin of scalp)\n29605:AnnotationAssertion(obo:IAO_0000115 obo:CL_4006001 \"A fibroblast that is part of the skin of scalp.\")\n29607:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4006001 \"skin of scalp fibroblast\")\n29608:AnnotationAssertion(rdfs:label obo:CL_4006001 \"fibroblast of skin of scalp\")\n30193:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27284195\") Annotation(oboInOwl:hasDbXref \"PMID:29443965\") Annotation(oboInOwl:hasDbXref \"PMID:30096314\") Annotation(oboInOwl:hasDbXref \"PMID:37824655\") Annotation(oboInOwl:hasDbXref \"https://cellxgene.cziscience.com/e/5346f9c6-755e-4336-94cc-38706ec00c2f.cxg/\") obo:IAO_0000115 obo:CL_4023051 \"A transcriptomically distinct type of mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: Non-neuronal cells', Author Categories: 'CrossArea_subclass', clusters VLMC.\")\n30222:# Class: obo:CL_4023054 (mesothelial fibroblast)\n30224:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26106328\") obo:IAO_0000115 obo:CL_4023054 \"A mesothelial cell that has undergone mesothelial-to-mesenchymal transition (MMT) to become a fibroblast cell.\")\n30226:AnnotationAssertion(rdfs:label obo:CL_4023054 \"mesothelial fibroblast\")\n30246:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30096314\") obo:IAO_0000115 obo:CL_4023056 \"A type of mouse mesothelial fibroblast that is derived from the neural crest, is localized on blood vessels, and is a key component of the pia and arachnoid membranes surrounding the brain.\")\n30264:# Class: obo:CL_4023058 (mesothelial fibroblast of the leptomeninx)\n30266:AnnotationAssertion(obo:IAO_0000115 obo:CL_4023058 \"A mesothelial fibroblast found in the leptomeninx.\")\n30268:AnnotationAssertion(rdfs:label obo:CL_4023058 \"mesothelial fibroblast of the leptomeninx\")\n30596:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23298861\") obo:IAO_0000115 obo:CL_4023097 \"A mesothelial fibroblast of the arachnoid barrier layer. Arachnoid barrier cells make up the tight-junctioned layer in the leptomeninx that functions as the physiologic barrier between the cerebrospinal fluid in the subarachnoid space and the fenestrated capillaries in the dura.\")\n31100:# Class: obo:CL_4028004 (alveolar type 1 fibroblast cell)\n31102:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22268140\") Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29489752\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") Annotation(oboInOwl:hasDbXref \"PMID:33707239\") Annotation(oboInOwl:hasDbXref \"PMID:9074756\") obo:IAO_0000115 obo:CL_4028004 \"A pulmonary interstitial fibroblast that is part of the alveolus and contains lipid droplets.\")\n31108:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast\")\n31109:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"alveolar fibroblast 1\")\n31111:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"lipofibroblast\")\n31112:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"matrix fibroblast 1\")\n31113:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028004 \"pulmonary lipofibroblast\")\n31115:AnnotationAssertion(rdfs:label obo:CL_4028004 \"alveolar type 1 fibroblast cell\")\n31119:# Class: obo:CL_4028006 (alveolar adventitial fibroblast)\n31121:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:26706109\") Annotation(oboInOwl:hasDbXref \"PMID:28886382\") Annotation(oboInOwl:hasDbXref \"PMID:29752282\") Annotation(oboInOwl:hasDbXref \"PMID:30675802\") Annotation(oboInOwl:hasDbXref \"PMID:33208946\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4028006 \"A pulmonary interstitial fibroblast that is part of the alveolus and localizes to vascular adventitia.\")\n31124:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"adventitial fibroblast\")\n31125:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"alveolar fibroblast\")\n31126:AnnotationAssertion(oboInOwl:hasBroadSynonym obo:CL_4028006 \"matrix fibroblast 2\")\n31129:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4028006 \"alveolar type 2 fibroblast cell\")\n31133:AnnotationAssertion(rdfs:label obo:CL_4028006 \"alveolar adventitial fibroblast\")\n31376:# Class: obo:CL_4030022 (renal medullary fibroblast)\n31378:AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://doi.org/10.1101/2021.07.28.454201>) Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030022 \"A fibroblast that is located in the renal medulla interstitium.\")\n31380:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030022 \"kidney medullary fibroblast\")\n31381:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") rdfs:comment obo:CL_4030022 \"It has been noted that inner medullary fibroblasts are involved in the regulation of water and electrolyte homeostasis.\")\n31382:AnnotationAssertion(rdfs:label obo:CL_4030022 \"renal medullary fibroblast\")\n31401:# Class: obo:CL_4030025 (renal cortical fibroblast)\n31403:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:10559635\") obo:IAO_0000115 obo:CL_4030025 \"A fibroblast that is located in the renal cortical interstitium.\")\n31405:AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_4030025 \"kidney cortical fibroblast\")\n31406:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:16230044\") rdfs:comment obo:CL_4030025 \"Renal cortical fibroblasts have key roles in mediating intercellular communication with neighboring/infiltrating cells and extracellular matrix and maintenance of renal tissue architecture. They additionally have an endocrine function in the production of epoetin.\")\n31407:AnnotationAssertion(rdfs:label obo:CL_4030025 \"renal cortical fibroblast\")\n31465:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030032 \"Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).\")\n31476:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25311230\") rdfs:comment obo:CL_4030033 \"At least in some mammalian species, a valve endothelial cell expresses CD31. Valve endothelial cells can undergo an endothelial to mesenchymal transition to acquire a fibroblast or myofibroblast phenotype that leads to changes in the microenvironmental signals and facilitates tissue regeneration.\")\n31816:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:17133361\") Annotation(oboInOwl:hasDbXref \"PMID:24183650\") Annotation(oboInOwl:hasDbXref \"PMID:9374839\") obo:IAO_0000115 obo:CL_4030066 \"An epithelial cell that is part of a ureteric bud. A ureteric bud cell has the potential to induce metanephric mesenchymal cells to proliferate and convert to epithelia that form renal tubules via: (1) the secretion of multiple diffusible growth factors that rescue renal progenitors from apoptosis and stimulate them to proliferate and (2) contact-dependent mechanisms that induce mesenchymal-epithelial conversion.\")\n31996:# Class: obo:CL_4033016 (secondary crest myofibroblast)\n31998:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") Annotation(oboInOwl:hasDbXref \"PMID:33624948\") obo:IAO_0000115 obo:CL_4033016 \"A myofibroblast that is part of an alveoli during alveolarization. The contractile force of this cell elongates the secondary crest, while producing a framework of elastin and tenascin. During the maturation of the septa, secondary crest myofibroblasts, together with matrix fibroblasts, secrete metalloproteinases and other ECM‐remodeling proteins to thin the septal tip ECM. The secondary crest myofibroblast continues producing elastin, eventually undergoing apoptosis during adulthood.\")\n32002:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasExactSynonym obo:CL_4033016 \"secondary-crest myofibroblast\")\n32005:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31331942\") oboInOwl:hasRelatedSynonym obo:CL_4033016 \"alveolar myofibroblast\")\n32006:AnnotationAssertion(rdfs:label obo:CL_4033016 \"secondary crest myofibroblast\")\n32094:# Class: obo:CL_4033025 (perichondrial fibroblast)\n32096:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"wikipedia:Perichondrium\") obo:IAO_0000115 obo:CL_4033025 \"A fibroblast that is part of the fibrous layer of the perichondrium. This cell is responsible for collagen fiber production.\")\n32100:AnnotationAssertion(rdfs:label obo:CL_4033025 \"perichondrial fibroblast\")\n32103:# Class: obo:CL_4033026 (lung perichondrial fibroblast)\n32105:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") obo:IAO_0000115 obo:CL_4033026 \"A perichondrial fibroblast that is part of the lung.\")\n32110:AnnotationAssertion(rdfs:label obo:CL_4033026 \"lung perichondrial fibroblast\")\n32509:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37630754\") Annotation(oboInOwl:hasDbXref \"doi:10.1007/978-3-030-84725-8\") obo:IAO_0000115 obo:CL_4033062 \"A trophoblast cell that invades the uterine wall to anchor the placenta to the uterus. An interstitial extravillous trophoblast cell differentiates from an extravillous trophoblast cell, becoming hyperchromatic and changing its morphology to a fibroblast-like spindle-shaped cell. In humans, this cell can be distinguished by the expression of placental-specific protein 8, which stimulates migration.\")\n33408:# Class: obo:CL_4047023 (intestinal lamina propria fibroblast)\n33410:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:21252048\") Annotation(oboInOwl:hasDbXref \"PMID:36032088\") obo:IAO_0000115 obo:CL_4047023 \"A fibroblast located in the lamina propria of the intestinal mucosa. This cell expresses PDGFRα and CD81 and is negative for α-smooth muscle actin (α-SMA). This cell is predominantly located in the small intestine adjacent to myofibroblasts surrounding the crypts. It is capable of synthesizing extracellular matrix components and structural proteins such as collagen and elastin.\")\n33413:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") oboInOwl:hasRelatedSynonym obo:CL_4047023 \"S1 fibroblast\")\n33414:AnnotationAssertion(rdfs:label obo:CL_4047023 \"intestinal lamina propria fibroblast\"@en)\n33670:# Class: obo:CL_4052004 (intestinal fibroblastic reticular cell)\n33672:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") obo:IAO_0000115 obo:CL_4052004 \"A specialized fibroblastic reticular cell that is part of gut-associated lymphoid tissue (GALT), responsible for forming a structural network that facilitates immune cell interactions. This cell is found in Peyer's patches, cryptopatches, and isolated lymphoid follicles. It plays crucial roles in maintaining intestinal immunity by controlling innate lymphoid cell homeostasis and function, organizing lymphoid structures, and contributing to intestinal microbiome balance.\")\n33675:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33707780\") Annotation(oboInOwl:hasDbXref \"PMID:35440118\") terms:description obo:CL_4052004 \"Intestinal fibroblastic reticular cells develop from both perivascular and subepithelial progenitors during Peyer's patch formation. Intestinal fibroblastic reticular cells express key markers such as CCL19, CCL21, CXCL13, TNFSF13B (also known as BAFF), and produce IL-7, which are important for their immune regulatory functions and the organization of lymphoid structures.\")\n33676:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"Ccl19-expressing fibroblastic reticular cell\")\n33677:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasNarrowSynonym obo:CL_4052004 \"solitary intestinal lymphoid tissue fibroblastic reticular cell\")\n33678:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:35440118\") oboInOwl:hasRelatedSynonym obo:CL_4052004 \"gut-associated secondary lymphoid organs fibroblastic reticular cell\")\n33679:AnnotationAssertion(rdfs:label obo:CL_4052004 \"intestinal fibroblastic reticular cell\")\n33683:# Class: obo:CL_4052005 (intestinal subserosal fibroblast)\n33685:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:23143399\") Annotation(oboInOwl:hasDbXref \"PMID:26694715\") Annotation(oboInOwl:hasDbXref \"PMID:38877292\") obo:IAO_0000115 obo:CL_4052005 \"A fibroblast that is part of the subserosa of intestine. This cell interacts with immune cells and play roles in inflammation and fibrosis. In certain conditions, such as Crohn's disease, subserosal fibroblast may differentiate into myofibroblasts.\")\n33688:AnnotationAssertion(rdfs:label obo:CL_4052005 \"intestinal subserosal fibroblast\")\n33706:# Class: obo:CL_4052007 (subepithelial intestinal fibroblast)\n33708:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33430285\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37080817\") obo:IAO_0000115 obo:CL_4052007 \"A fibroblast located adjacent to the intestinal epithelium in both the small intestine and colon, specifically around the crypts. This cell is characterized by the expression of  PDGFRα and various collagen isoforms, including COL4A5 and COL4A6. It secretes signalling molecules like TGF-β, Wnt ligands, and BMPs, which are crucial for epithelial homeostasis, intestinal stem cell support, and basement membrane formation.\")\n33711:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 fibroblast\")\n33712:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052007 \"S2 mesenchymal cells\")\n33713:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30270042\") Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052007 \"The S2 fibroblast population has been identified as a subset of intestinal fibroblasts located near the epithelial lining. This population is divided into two subtypes: S2a and S2b. S2a is involved in epithelial differentiation, while S2b, located at the top of the crypt, regulates intestinal stem cell proliferation, niche formation, and wound healing.\")\n33714:AnnotationAssertion(rdfs:label obo:CL_4052007 \"subepithelial intestinal fibroblast\")\n33718:# Class: obo:CL_4052008 (crypt-bottom fibroblast)\n33720:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052008 \"A subepithelial intestinal fibroblast that is located adjacent to the base of the crypt of Lieberkühn, near the intestinal stem cells. Characterized by low PDGFRα expression, this cell is crucial for maintaining the intestinal stem cell niche. Crypt-bottom fibroblast secretes key signaling molecules including canonical Wnt ligands (Wnt2, Wnt2b), Wnt potentiators (Rspo3), and BMP inhibitors (Grem1), which collectively regulate intestinal stem cell function and epithelial homeostasis.\")\n33724:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052008 \"bottom pericryptic-associated fibroblasts\")\n33725:AnnotationAssertion(rdfs:label obo:CL_4052008 \"crypt-bottom fibroblast\")\n33730:# Class: obo:CL_4052009 (crypt-top fibroblast)\n33732:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") Annotation(oboInOwl:hasDbXref \"doi:/10.1371/journal.pbio.3001032\") obo:IAO_0000115 obo:CL_4052009 \"A subepithelial intestinal fibroblast that is located adjacent to the top of the crypt of Lieberkuhn. Characterized by high experession of PDGFRα, this cell secretes a range of signaling factors, including WNTs and BMPs, that drive epithelial differentiation, creating a gradient that regulates the balance between stem cell maintenance and differentiation.\")\n33736:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"S2b fibroblast\")\n33737:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33916891\") oboInOwl:hasRelatedSynonym obo:CL_4052009 \"top pericryptic fibroblast\")\n33738:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37495570\") rdfs:comment obo:CL_4052009 \"S2b fibroblasts are located at the top of the crypt and express NRG1 and NPY.\")\n33739:AnnotationAssertion(rdfs:label obo:CL_4052009 \"crypt-top fibroblast\")\n33782:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:31320652\") Annotation(oboInOwl:hasDbXref \"PMID:32530882\") Annotation(oboInOwl:hasDbXref \"PMID:36758341\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Theca_externa\") obo:IAO_0000115 obo:CL_4052013 \"A specialized theca cell that forms the outer layer of the theca surrounding the ovarian follicle, appearing at the antral follicle. Originating from progenitor theca cells, theca externa cell is characterized by its fibroblast-like appearance and primarily function to provide structural support to the developing follicle. This cell produces collagen fibers and extracellular matrix components such as Col1a1 and Col1a2.\")\n33896:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:33311457\") Annotation(oboInOwl:hasDbXref \"PMID:33311464\") Annotation(oboInOwl:hasDbXref \"PMID:38398025\") obo:IAO_0000115 obo:CL_4052024 \"A specialized muscle nucleus that is part of an extrafusal muscle fiber and overlaps the muscle-tendon junction, where muscle fibers connect to tendons. Characterized by a distinct transcriptional profile with the expression of genes like COL22A1, this myonucleus supports the structural integrity and function of the junction, playing a key role in transmitting the force generated by muscle contraction to the tendon.\")\n33952:# Class: obo:CL_4052029 (subpleural fibroblast)\n33954:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36543915\") Annotation(oboInOwl:hasDbXref \"PMID:36769178\") Annotation(oboInOwl:hasDbXref \"PMID:37291214\") obo:IAO_0000115 obo:CL_4052029 \"A fibroblast that is located beneath the visceral pleura of the lung. This cell contributes to the development of idiopathic pulmonary fibrosis (IPF) by forming fibrotic lesions that originate subpleurally and extend into lung tissue through activation, proliferation, migration, and differentiation into a myofibroblast.\")\n33957:AnnotationAssertion(rdfs:label obo:CL_4052029 \"subpleural fibroblast\")\n33961:# Class: obo:CL_4052030 (adventitial fibroblast)\n33963:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:28705796\") Annotation(oboInOwl:hasDbXref \"PMID:36718802\") obo:IAO_0000115 obo:CL_4052030 \"A fibroblast of the adventitia of a blood vessel. This cell contributes to vascular homeostasis, remodeling, and inflammation by producing extracellular matrix components, cytokines, and growth factors. Adventitial fibroblast can transition into an activated state during injury or disease, marked by increased proliferation, migration, matrix deposition, and contractile protein expression\")\n33966:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:36718802\") rdfs:comment obo:CL_4052030 \"Single-cell transcriptomics of murine aorta identifies two adventitial fibroblast-specific markers, PDGFRA and DPEP1, which were validated at the protein level by immunohistochemistry and flow cytometry across human and murine arteries, highlighting fibroblast heterogeneity in health and cardiovascular disease (CVD) in humans and mice.\")\n33967:AnnotationAssertion(rdfs:label obo:CL_4052030 \"adventitial fibroblast\")\n34249:# Class: obo:CL_4052062 (onychofibroblast)\n34251:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34099859\") Annotation(oboInOwl:hasDbXref \"PMID:35853486\") Annotation(oboInOwl:hasDbXref \"PMID:39044464\") obo:IAO_0000115 obo:CL_4052062 \"A specialized fibroblast located in the onychodermis that play a key role in nail growth and regeneration by interacting with LGR6-positive nail matrix keratinocytes. These interactions mediate essential signaling pathways, particularly WNT signaling, which is critical for epithelial–mesenchymal communication and coordinated nail development. In humans, this cell expresses key markers, including RSPO4, MSX1, WIF1, and BMP5, all involved in nail differentiation.\")\n34254:AnnotationAssertion(rdfs:label obo:CL_4052062 \"onychofibroblast\")\n","exit_code":0,"status":"completed"}}
