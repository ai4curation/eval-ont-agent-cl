//orcid.org/0009-0000-8480-9277>)\n35745: AnnotationAssertion(terms:date obo:CL_7770006 \"2025-09-15T08:48:01Z\"^^xsd:dateTime)\n35746: AnnotationAssertion(rdfs:label obo:CL_7770006 \"beam B cell, human\")\n35747: AnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\n35748: SubClassOf(obo:CL_7770006 obo:CL_0002367)\n35749: SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\n35750: SubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9UIK5))\n35751: \n35752: # Class: obo:CL_4052072 (dogiel type II neuron)\n35753: \n35754: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4052072 \"A neuron characterized by Dogiel type II morphology: a large, smooth, oval soma bearing multiple long axon-like processes that extend without branching until they reach their targets. The soma lacks the short lamellar or spiny dendrites characteristic of Dogiel type I neurons. In the enteric nervous system, Dogiel type II neurons correspond to intrinsic primary afferent neurons and exhibit AH-type electrophysiology, characterized by a prolonged afterhyperpolarization following an action potential.\")\n35755: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052072 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35756: AnnotationAssertion(terms:creator obo:CL_4052072 \"GitHub Copilot\")\n35757: AnnotationAssertion(terms:date obo:CL_4052072 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35758: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052072 \"type II enteric neuron\")\n35759: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052072 \"multiaxonal enteric neuron\")\n35760: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052072 \"AH neuron\")\n35761: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052072 \"Dogiel II neuron\")\n35762: AnnotationAssertion(rdfs:label obo:CL_4052072 \"dogiel type II neuron\")\n35763: SubClassOf(obo:CL_4052072 obo:CL_0000540)\n35764: \n35765: # Class: obo:CL_4052073 (intrinsic primary afferent neuron of myenteric plexus)\n35766: \n35767: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052073 \"A sensory enteric neuron whose soma resides in the myenteric plexus and which functions as the afferent limb of intrinsic reflex circuits controlling motility, secretion, and blood flow. This neuron is characterized by Dogiel type II morphology, AH-type electrophysiology, immunopositivity for choline acetyltransferase, and immunonegativity for neuronal nitric oxide synthase.\")\n35768: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052073 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35769: AnnotationAssertion(terms:creator obo:CL_4052073 \"GitHub Copilot\")\n35770: AnnotationAssertion(terms:date obo:CL_4052073 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35771: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052073 \"IPAN\")\n35772: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052073 \"myenteric sensory neuron\")\n35773: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052073 \"multiaxonal cholinergic myenteric sensory neuron\")\n35774: AnnotationAssertion(rdfs:label obo:CL_4052073 \"intrinsic primary afferent neuron of myenteric plexus\")\n35775: EquivalentClasses(obo:CL_4052073 ObjectIntersectionOf(obo:CL_0000101 obo:CL_0007011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439)))\n35776: SubClassOf(obo:CL_4052073 obo:CL_4052072)\n35777: \n35778: # Class: obo:CL_4052074 (interneuron of myenteric plexus)\n35779: \n35780: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:32888429\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052074 \"An interneuron of the enteric nervous system whose soma resides in the myenteric plexus. This neuron integrates sensory input from intrinsic primary afferent neurons and modulates motor output to smooth muscle and secretory epithelia by synapsing onto motor neurons and other interneurons within the plexus.\")\n35781: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052074 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35782: AnnotationAssertion(terms:creator obo:CL_4052074 \"GitHub Copilot\")\n35783: AnnotationAssertion(terms:date obo:CL_4052074 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35784: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052074 \"enteric interneuron of myenteric plexus\")\n35785: AnnotationAssertion(rdfs:label obo:CL_4052074 \"interneuron of myenteric plexus\")\n35786: EquivalentClasses(obo:CL_4052074 ObjectIntersectionOf(obo:CL_0000099 obo:CL_0007011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439)))\n35787: \n35788: # Class: obo:CL_4052075 (secretomotor/vasodilator neuron of myenteric plexus)\n35789: \n35790: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:32888429\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052075 \"An enteric neuron whose soma resides in the myenteric plexus and which controls mucosal secretion and blood flow by innervating secretory epithelia and submucosal blood vessels. This neuron is characterized by expression of vasoactive intestinal peptide; in mouse, both non-cholinergic and cholinergic subtypes have been identified, whereas in human a VIP-positive non-cholinergic subtype has been detected.\")\n35791: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052075 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35792: AnnotationAssertion(terms:creator obo:CL_4052075 \"GitHub Copilot\")\n35793: AnnotationAssertion(terms:date obo:CL_4052075 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35794: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052075 \"PSVN\")\n35795: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32888429\") oboInOwl:hasRelatedSynonym obo:CL_4052075 \"VIP-positive secretomotor neuron\")\n35796: AnnotationAssertion(rdfs:label obo:CL_4052075 \"secretomotor/vasodilator neuron of myenteric plexus\")\n35797: SubClassOf(obo:CL_4052075 obo:CL_0007011)\n35798: SubClassOf(obo:CL_4052075 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439))\n35799: \n35800: # Class: obo:CL_4052076 (intestinofugal neuron)\n35801: \n35802: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:38292899\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052076 \"An enteric neuron whose soma resides in the myenteric plexus of the intestine and whose axon projects outside the gut wall to synapse on neurons in prevertebral sympathetic ganglia. In humans, most of these neurons are immunopositive for choline acetyltransferase.\")\n35803: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052076 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35804: AnnotationAssertion(terms:creator obo:CL_4052076 \"GitHub Copilot\")\n35805: AnnotationAssertion(terms:date obo:CL_4052076 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35806: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") oboInOwl:hasExactSynonym obo:CL_4052076 \"viscerofugal neuron\")\n35807: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052076 \"VFN\")\n35808: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:38292899\") oboInOwl:hasRelatedSynonym obo:CL_4052076 \"cholinergic viscerofugal neuron\")\n35809: AnnotationAssertion(rdfs:label obo:CL_4052076 \"intestinofugal neuron\")\n35810: SubClassOf(obo:CL_4052076 obo:CL_0007011)\n35811: SubClassOf(obo:CL_4052076 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439))\n35812: \n35813: # Class: obo:CL_4052077 (ascending interneuron of myenteric plexus)\n35814: \n35815: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052077 \"An interneuron of the myenteric plexus whose axon projects orally along the gut axis. This neuron forms the excitatory limb of ascending reflex pathways that coordinate peristalsis.\")\n35816: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052077 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35817: AnnotationAssertion(terms:creator obo:CL_4052077 \"GitHub Copilot\")\n35818: AnnotationAssertion(terms:date obo:CL_4052077 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35819: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052077 \"cholinergic enkephalinergic myenteric interneuron\")\n35820: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052077 \"ascending myenteric interneuron\")\n35821: AnnotationAssertion(rdfs:label obo:CL_4052077 \"ascending interneuron of myenteric plexus\")\n35822: SubClassOf(obo:CL_4052077 obo:CL_4052074)\n35823: \n35824: # Class: obo:CL_4052078 (descending interneuron of myenteric plexus)\n35825: \n35826: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052078 \"An interneuron of the myenteric plexus whose axon projects aborally along the gut axis. This neuron class encompasses multiple chemically diverse subtypes, including serotonergic and nitrergic populations, and forms the inhibitory limb of descending reflex pathways.\")\n35827: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052078 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35828: AnnotationAssertion(terms:creator obo:CL_4052078 \"GitHub Copilot\")\n35829: AnnotationAssertion(terms:date obo:CL_4052078 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35830: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052078 \"descending myenteric interneuron\")\n35831: AnnotationAssertion(rdfs:label obo:CL_4052078 \"descending interneuron of myenteric plexus\")\n35832: SubClassOf(obo:CL_4052078 obo:CL_4052074)\n35833: \n35834: # Class: obo:CL_4052079 (stubby Dogiel type I neuron of myenteric plexus)\n35835: \n35836: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_4052079 \"A Dogiel type I enteric motor neuron of the myenteric plexus characterized by stubby lamellar dendrites with broad, flattened dendritic expansions. This neuron corresponds to an excitatory motor neuron of the enteric nervous system.\")\n35837: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052079 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35838: AnnotationAssertion(terms:creator obo:CL_4052079 \"GitHub Copilot\")\n35839: AnnotationAssertion(terms:date obo:CL_4052079 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35840: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052079 \"stubby Dogiel I neuron\")\n35841: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052079 \"lamellar Dogiel type I neuron\")\n35842: AnnotationAssertion(rdfs:label obo:CL_4052079 \"stubby Dogiel type I neuron of myenteric plexus\")\n35843: EquivalentClasses(obo:CL_4052079 ObjectIntersectionOf(obo:CL_0000100 obo:CL_4047038 obo:CL_0007011))\n35844: \n35845: # Class: obo:CL_4052080 (spiny Dogiel type I neuron of myenteric plexus)\n35846: \n35847: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_4052080 \"A Dogiel type I enteric inhibitory motor neuron of the myenteric plexus characterized by spiny dendrites with numerous short projections along the dendrites.\")\n35848: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052080 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35849: AnnotationAssertion(terms:creator obo:CL_4052080 \"GitHub Copilot\")\n35850: AnnotationAssertion(terms:date obo:CL_4052080 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35851: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052080 \"spiny Dogiel I neuron\")\n35852: AnnotationAssertion(rdfs:label obo:CL_4052080 \"spiny Dogiel type I neuron of myenteric plexus\")\n35853: EquivalentClasses(obo:CL_4052080 ObjectIntersectionOf(obo:CL_0008015 obo:CL_4047038 obo:CL_0007011))\n35854: \n35855: # Class: obo:CL_4052081 (Dogiel type II neuron of myenteric plexus)\n35856: \n35857: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052081 \"An intrinsic primary afferent neuron of the myenteric plexus characterized by Dogiel type II morphology, with a large smooth soma bearing multiple long axon-like processes that extend to targets in the myenteric and submucosal plexuses and the mucosa. This neuron exhibits AH-type electrophysiology, characterized by a prolonged afterhyperpolarization following an action potential.\")\n35858: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052081 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35859: AnnotationAssertion(terms:creator obo:CL_4052081 \"GitHub Copilot\")\n35860: AnnotationAssertion(terms:date obo:CL_4052081 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35861: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052081 \"type II myenteric neuron\")\n35862: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052081 \"multiaxonal myenteric sensory neuron\")\n35863: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") oboInOwl:hasRelatedSynonym obo:CL_4052081 \"AH-type myenteric neuron\")\n35864: AnnotationAssertion(rdfs:label obo:CL_4052081 \"Dogiel type II neuron of myenteric plexus\")\n35865: EquivalentClasses(obo:CL_4052081 ObjectIntersectionOf(obo:CL_4052072 obo:CL_4052073))\n35866: \n35867: # Class: obo:CL_4052082 (calretinin-positive intrinsic primary afferent neuron of myenteric plexus)\n35868: \n35869: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052082 \"An intrinsic primary afferent neuron of the myenteric plexus that is immunopositive for calretinin. This neuron shares the Dogiel type II morphology and AH-type electrophysiology of myenteric intrinsic primary afferent neurons.\")\n35870: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052082 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35871: AnnotationAssertion(terms:creator obo:CL_4052082 \"GitHub Copilot\")\n35872: AnnotationAssertion(terms:date obo:CL_4052082 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35873: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052082 \"SN1\")\n35874: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052082 \"calretinin-positive myenteric sensory neuron\")\n35875: AnnotationAssertion(rdfs:label obo:CL_4052082 \"calretinin-positive intrinsic primary afferent neuron of myenteric plexus\")\n35876: SubClassOf(obo:CL_4052082 obo:CL_4052073)\n35877: \n35878: # Class: obo:CL_4052083 (calretinin-negative intrinsic primary afferent neuron of myenteric plexus)\n35879: \n35880: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasDbXref \"PMID:40954253\") obo:IAO_0000115 obo:CL_4052083 \"An intrinsic primary afferent neuron of the myenteric plexus that lacks calretinin expression. This neuron shares the Dogiel type II morphology and AH-type electrophysiology of myenteric intrinsic primary afferent neurons.\")\n35881: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052083 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35882: AnnotationAssertion(terms:creator obo:CL_4052083 \"GitHub Copilot\")\n35883: AnnotationAssertion(terms:date obo:CL_4052083 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35884: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4052083 \"SN2\")\n35885: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052083 \"calretinin-negative myenteric sensory neuron\")\n35886: AnnotationAssertion(rdfs:label obo:CL_4052083 \"calretinin-negative intrinsic primary afferent neuron of myenteric plexus\")\n35887: SubClassOf(obo:CL_4052083 obo:CL_4052073)\n35888: \n35889: # Class: obo:CL_4052084 (cholinergic neuron of myenteric plexus)\n35890: \n35891: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_4052084 \"An enteric neuron whose soma resides in the myenteric plexus and that is capable of acetylcholine secretion, neurotransmission.\")\n35892: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052084 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35893: AnnotationAssertion(terms:creator obo:CL_4052084 \"GitHub Copilot\")\n35894: AnnotationAssertion(terms:date obo:CL_4052084 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35895: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052084 \"ChAT-positive myenteric neuron\")\n35896: AnnotationAssertion(rdfs:label obo:CL_4052084 \"cholinergic neuron of myenteric plexus\")\n35897: EquivalentClasses(obo:CL_4052084 ObjectIntersectionOf(obo:CL_0000108 obo:CL_0007011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439)))\n35898: \n35899: # Class: obo:CL_4052085 (nitrergic neuron of myenteric plexus)\n35900: \n35901: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") Annotation(oboInOwl:hasDbXref \"PMID:37355216\") obo:IAO_0000115 obo:CL_4052085 \"An enteric neuron whose soma resides in the myenteric plexus and that is capable of nitric oxide biosynthetic process.\")\n35902: AnnotationAssertion(obo:IAO_0000233 obo:CL_4052085 <https://github.com/obophenotype/cell-ontology/issues/3584>)\n35903: AnnotationAssertion(terms:creator obo:CL_4052085 \"GitHub Copilot\")\n35904: AnnotationAssertion(terms:date obo:CL_4052085 \"2026-05-17T00:00:00Z\"^^xsd:dateTime)\n35905: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052085 \"NOS1-positive myenteric neuron\")\n35906: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:37355216\") oboInOwl:hasRelatedSynonym obo:CL_4052085 \"nNOS-positive myenteric neuron\")\n35907: AnnotationAssertion(rdfs:label obo:CL_4052085 \"nitrergic neuron of myenteric plexus\")\n35908: EquivalentClasses(obo:CL_4052085 ObjectIntersectionOf(obo:CL_0000528 obo:CL_0007011 ObjectSomeValuesFrom(obo:RO_0002100 obo:UBERON_0002439)))\n35909: \n35910: # Class: obo:CP_0000000 (obsolete CP:0000000)\n35911: \n35912: AnnotationAssertion(obo:IAO_0100001 obo:CP_0000000 obo:CL_0017500)\n35913: AnnotationAssertion(rdfs:comment obo:CP_0000000 \"ID was moved to the CL namespace. Use CL:0017500.\")\n35914: AnnotationAssertion(rdfs:label obo:CP_0000000 \"obsolete CP:0000000\")\n\n(Showing lines 35735-35914 of 35989. Use offset=35915 to continue.)\n</content>","metadata":{"preview":"AnnotationAssertion(rdfs:label obo:CL_7770005 \"beam cell\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770005 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\nSubClassOf(Annotation(oboInOwl:is_inferred \"true\") obo:CL_7770005 obo:CL_0002367)\nSubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:BFO_0000050 obo:UBERON_0005969))\nSubClassOf(obo:CL_7770005 ObjectSomeValuesFrom(obo:RO_0002215 obo:GO_0006909))\n\n# Class: obo:CL_7770006 (beam B cell, human)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25356439\") Annotation(oboInOwl:hasDbXref \"PMID:32341164\") Annotation(oboInOwl:hasDbXref \"PMID:39829808\") obo:IAO_0000115 obo:CL_7770006 \"A trabecular meshwork cell within the eye's trabecular meshwork. This cell is molecularly distinguished by TMEFF2 expression in humans. A beam B cell is spatially intermingled with beam A cells throughout the uveal and corneoscleral meshwork regions, but demonstrates a tendency to localise closer to the juxtacanalicular tissue.\")\nAnnotationAssertion(terms:contributor obo:CL_7770006 <https://orcid.org/0009-0000-8480-9277>)\nAnnotationAssertion(terms:date obo:CL_7770006 \"2025-09-15T08:48:01Z\"^^xsd:dateTime)\nAnnotationAssertion(rdfs:label obo:CL_7770006 \"beam B cell, human\")\nAnnotationAssertion(Annotation(dc:license <http://creativecommons.org/licenses/by/4.0/>) Annotation(oboInOwl:hasDbXref \"PMID:35836364\") Annotation(rdfs:comment \"Trabecular meshwork (TM) structure. The TM consists of uveal (blue), corneoscleral (red), and juxtacanalicular (green) regions. TM beam cells (blue/red) line the uveal and corneoscleral regions, while JCT cells (green) occupy the juxtacanalicular region.\") foaf:depiction obo:CL_7770006 \"http://purl.obolibrary.org/obo/cl/images/Trabecular_meshowk_cells_PMID35836364.jpg\")\nSubClassOf(obo:CL_7770006 obo:CL_0002367)\nSubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002162 obo:NCBITaxon_9606))\nSubClassOf(obo:CL_7770006 ObjectSomeValuesFrom(obo:RO_0002292 obo:PR_Q9UIK5))\n\n# Class: obo:CL_4052072 (dogiel type II neuron)\n\nAnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:34170401\") obo:IAO_0000115 obo:CL_4052072 \"A neuron characterized by Dogiel type II morphology: a large, smooth, oval soma bearing multiple long axon-like processes that extend without branching until they reach their targets. The soma lacks the short lamellar or spiny dendrites characteristic of Dogiel type I neurons. In the enteric nervous system, Dogiel type II neurons correspond to intrinsic primary afferent neurons and exhibit AH-type electrophysiology, characterized by a prolonged afterhyperpolarization following an action potential.\")","truncated":true,"loaded":[]},"title":"src/ontology/cl-edit.owl","time":{"start":17789803