ion(oboInOwl:hasDbXref \"PMID:22006647\") oboInOwl:hasExactSynonym obo:CL_4033027 \"Diffuse Bipolar Cell Type DB1\")\n32802:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 bipolar\")\n32803:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 bipolar cell\")\n32804:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033027 \"DB1 cell\")\n32805:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:22006647\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033027 \"In primates, a diffuse bipolar 1 cell on average makes 81 ribbon (output) synapses, 13 contacts are with OFF parasol cells and 47 contacts are with OFF midget cells. This cell might make flat contacts at both triad-associated and non-triad-associated positions on the cone pedicle.\")\n32806:AnnotationAssertion(rdfs:label obo:CL_4033027 \"diffuse bipolar 1 cell\")\n32807:SubClassOf(obo:CL_4033027 obo:CL_0000750)\n32809:# Class: obo:CL_4033028 (diffuse bipolar 2 cell)\n32811:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:25309346\") Annotation(oboInOwl:hasDbXref \"PMID:26500507\") Annotation(oboInOwl:hasDbXref \"PMID:27833534\") obo:IAO_0000115 obo:CL_4033028 \"An OFF diffuse bipolar cell that predominantly connects to ON parasol cells and lateral amacrine cells. This cell contains a large number of synaptic ribbons and a small axon arbor area.\")\n32812:AnnotationAssertion(terms:contributor obo:CL_4033028 <https://orcid.org/0000-0001-6677-8489>)\n32813:AnnotationAssertion(terms:date obo:CL_4033028 \"2023-04-04T10:49:07Z\"^^xsd:dateTime)\n32814:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033028 \"DB2 cell\")\n32815:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033028 \"In primates, a diffuse bipolar 2 cell makes an average of 133 ribbon synapses, 47 contacts are with OFF parasol cells and 4 contacts are with OFF midget cells.\")\n32816:AnnotationAssertion(rdfs:label obo:CL_4033028 \"diffuse bipolar 2 cell\")\n32817:SubClassOf(obo:CL_4033028 obo:CL_0000750)\n32819:# Class: obo:CL_4033029 (diffuse bipolar 3a cell)\n32821:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") Annotation(oboInOwl:hasDbXref \"PMID:33009001\") obo:IAO_0000115 obo:CL_4033029 \"An OFF calbindin-positive bipolar cell that has a large dendritic field and stratifies narrowly close to the middle of the inner plexiform layer. Its axon terminal is characterized by regularly branching and varicose processes resembling beads on a string. Most of DB3a contacts with cones are triad-associated.\")\n32822:AnnotationAssertion(terms:contributor obo:CL_4033029 <https://orcid.org/0000-0001-6677-8489>)\n32823:AnnotationAssertion(terms:date obo:CL_4033029 \"2023-04-04T10:53:33Z\"^^xsd:dateTime)\n32824:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fnana.2015.00122\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033029 \"DB3 cell\")\n32825:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033029 \"DB3a cell\")\n32826:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"DOI:10.3389/fnana.2015.00122\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033029 \"Originally, DB3a cells were termed diffuse bipolar 3 (DB3) cells. When an additional bipolar type which stratifies slightly more vitread and is calbindin negative was detected, this cell was renamed diffuse bipolar 3a cell. The axons of neighboring DB3a cells make homologous gap junctions. The DB3a cells provide the majority of their output to OFF parasol cells.\")\n32827:AnnotationAssertion(rdfs:label obo:CL_4033029 \"diffuse bipolar 3a cell\")\n32828:SubClassOf(obo:CL_4033029 obo:CL_0000750)\n32830:# Class: obo:CL_4033030 (diffuse bipolar 3b cell)\n32832:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033030 \"An OFF calbindin-negative bipolar cell that has a large dendritic field and stratifies narrowly close to the middle of the inner plexiform layer. Its axon terminal is characterized by regularly branching and varicose processes resembling beads on a string. Most of DB3b contacts with cones are non-triad-associated.\")\n32833:AnnotationAssertion(terms:contributor obo:CL_4033030 <https://orcid.org/0000-0001-6677-8489>)\n32834:AnnotationAssertion(terms:date obo:CL_4033030 \"2023-04-04T10:53:42Z\"^^xsd:dateTime)\n32835:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033030 \"DB3b cell\")\n32836:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:24107939\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:33009001\") rdfs:comment obo:CL_4033030 \"In humans, a DB3b cell is CD15 positive. A DB3b cell might make sparse contacts to rod photoreceptors.\")\n32837:AnnotationAssertion(rdfs:label obo:CL_4033030 \"diffuse bipolar 3b cell\")\n32838:SubClassOf(obo:CL_4033030 obo:CL_0000750)\n32840:# Class: obo:CL_4033031 (diffuse bipolar 4 cell)\n32842:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:27833534\") Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033031 \"An ON diffuse bipolar cell that predominantly connects to ON parasol cells and lateral amacrine cells.\")\n32843:AnnotationAssertion(terms:contributor obo:CL_4033031 <https://orcid.org/0000-0001-6677-8489>)\n32844:AnnotationAssertion(terms:date obo:CL_4033031 \"2023-04-04T09:51:10Z\"^^xsd:dateTime)\n32845:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033031 \"DB4 cell\")\n32846:AnnotationAssertion(rdfs:label obo:CL_4033031 \"diffuse bipolar 4 cell\")\n32847:SubClassOf(obo:CL_4033031 obo:CL_0000749)\n32849:# Class: obo:CL_4033032 (diffuse bipolar 6 cell)\n32851:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033032 \"An ON diffuse bipolar cell that has a large dendritic field and large axon terminals, which show little or no overlap. This cell predominantly connects to narrow thorny ganglion cells.\")\n32852:AnnotationAssertion(terms:contributor obo:CL_4033032 <https://orcid.org/0000-0001-6677-8489>)\n32853:AnnotationAssertion(terms:date obo:CL_4033032 \"2023-04-04T09:51:22Z\"^^xsd:dateTime)\n32854:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033032 \"DB6 cell\")\n32855:AnnotationAssertion(rdfs:label obo:CL_4033032 \"diffuse bipolar 6 cell\")\n32856:SubClassOf(obo:CL_4033032 obo:CL_0000749)\n32858:# Class: obo:CL_4033033 (flat midget bipolar cell)\n32860:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033033 \"An OFF bipolar cell with a small dendritic tree that provides most of the triad-associated basal (flat) contacts at cone pedicles.\")\n32861:AnnotationAssertion(terms:contributor obo:CL_4033033 <https://orcid.org/0000-0001-6677-8489>)\n32862:AnnotationAssertion(terms:date obo:CL_4033033 \"2023-04-04T10:54:00Z\"^^xsd:dateTime)\n32863:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033033 \"FMB cell\")\n32864:AnnotationAssertion(rdfs:label obo:CL_4033033 \"flat midget bipolar cell\")\n32865:SubClassOf(obo:CL_4033033 obo:CL_0000750)\n32867:# Class: obo:CL_4033034 (invaginating midget bipolar cell)\n32869:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033034 \"An ON bipolar cell with a small dendritic tree that forms most of the central (invaginating) elements opposite the synaptic ribbon at the cone triad.\")\n32870:AnnotationAssertion(terms:contributor obo:CL_4033034 <https://orcid.org/0000-0001-6677-8489>)\n32871:AnnotationAssertion(terms:date obo:CL_4033034 \"2023-04-04T09:51:44Z\"^^xsd:dateTime)\n32872:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033034 \"IMB cell\")\n32873:AnnotationAssertion(rdfs:label obo:CL_4033034 \"invaginating midget bipolar cell\")\n32874:SubClassOf(obo:CL_4033034 obo:CL_0000749)\n32876:# Class: obo:CL_4033035 (giant bipolar cell)\n32878:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasDbXref \"PMID:32555229\") obo:IAO_0000115 obo:CL_4033035 \"An ON bipolar cell that has large dendritic and axonal fields.\")\n32879:AnnotationAssertion(terms:contributor obo:CL_4033035 <https://orcid.org/0000-0001-6677-8489>)\n32880:AnnotationAssertion(terms:date obo:CL_4033035 \"2023-04-04T09:54:15Z\"^^xsd:dateTime)\n32881:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym obo:CL_4033035 \"GB cell\")\n32882:AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:32032773\") rdfs:comment obo:CL_4033035 \"A giant bipolar cell is usually monostr