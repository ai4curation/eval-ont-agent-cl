e 5356: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D020397\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Goblet_cell\") obo:IAO_0000115 obo:CL_0000160 \"A specialized, columnar, mucus secreting epithelial cell shaped like a flask or goblet. A narrow basal end contains the nucleus while the apical end is swollen by the accumulation of mucus laden secretory granules.  Short microvilli project from the apical plasma membrane.\")\n\n  Line 5377: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31613538\") Annotation(oboInOwl:hasDbXref \"PMID:31670611\") obo:IAO_0000115 obo:CL_0000162 \"An epithelial cell of the stomach that is part of the fundic gastric gland. This cell is characterized by its pyramidal shape, abundant mitochondria, and a complex network of secretory canaliculi lined with microvilli. It secretes hydrochloric acid into the stomach lumen and produces intrinsic factor, essential for vitamin B12 absorption.\")\n\n  Line 6085: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000239 \"An epithelial cell characterized by the presence of a brush border on its apical surface, which increases the surface area for absorption.\")\n\n  Line 6095: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Epithelium\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_squamous_epithelium\") obo:IAO_0000115 obo:CL_0000240 \"A stratified epithelial cell that is part of squamous epithelium, characterized by multiple layers of cells. The basal layer is directly attached to the basement membrane and the apical layer consists of flattened squamous cells. This provides a protective barrier, commonly found in areas subject to abrasion, such as the skin, oral cavity, and esophagus.\")\n\n  Line 6102: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:30422572\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Stratified_cuboidal_epithelium\") obo:IAO_0000115 obo:CL_0000241 \"A stratified epithelial cell that is part of cuboidal epithelium, characterized by multiple layers of cuboidal cells forming the apical layer. This provides a protective lining for ducts in large glands, such as sweat glands.\")\n\n  Line 6109: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D018862\") Annotation(oboInOwl:hasDbXref \"PMID:19834574\") Annotation(oboInOwl:hasDbXref \"PMID:2274847\") Annotation(oboInOwl:hasDbXref \"PMID:24862916\") Annotation(oboInOwl:hasDbXref \"PMID:30415995\") Annotation(oboInOwl:hasDbXref \"Wikipedia:Merkel_cell\") obo:IAO_0000115 obo:CL_0000242 \"A specialized epithelial cell located in the skin epidermis and certain mucosal epithelia. It functions as a mechanoreceptor for light touch by forming synapse-like contacts with somatosensory afferent nerve endings, contributing to slowly adapting type I (SAI) tactile responses. Characterized by dense-core neuroendocrine granules, the Merkel cell exhibits both sensory and neuroendocrine properties, including regulated neurotransmitter release via SNARE complex-dependent mechanisms. Its development in mice depends on the transcription factor Atoh1.\")\n\n  Line 6557: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000307 \"An epithelial cell found in the trachea.\")\n\n  Line 6589: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15749908\") Annotation(oboInOwl:hasDbXref \"PMID:19256306\") Annotation(oboInOwl:hasDbXref \"PMID:19727116\") Annotation(oboInOwl:hasDbXref \"PMID:29713660\") Annotation(oboInOwl:hasDbXref \"PMID:37873034\") obo:IAO_0000115 obo:CL_0000312 \"An epithelial cell of stratified squamous tissues, including skin, oral mucosa (Hiroshima et al., 2011), and esophagus (Whelan et al., 2018), that produces keratin proteins and secretes antimicrobial peptides to form a resilient barrier against environmental damage, dehydration, pathogens, and microbial invasion. It undergoes successive stages of differentiation marked by changes in keratin expression, supporting tissue integrity, wound repair, and contributing to immune defense.\")\n\n  Line 6630: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D012629\") Annotation(oboInOwl:hasDbXref \"PMID:19944183\") obo:IAO_0000115 obo:CL_0000317 \"An epithelial cell that is part of a sebaceous gland. This cell produces and secretes sebum, an oily, lipid-rich substance, through holocrine secretion where the entire cell ruptures to release its contents.\")\n\n  Line 6670: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") obo:IAO_0000115 obo:CL_0000322 \"An epithelial cell that lines the peripheral gas exchange region of the lungs of air-breathing vertebrates.\")\n\n  Line 6969: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"Flybase:dsj\") Annotation(oboInOwl:hasDbXref \"MA:ma\") obo:IAO_0000115 obo:CL_0000362 \"An epithelial cell of the integument (the outer layer of an organism).\")\n\n  Line 7317: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/hermaphrodite/hypodermis/mainframe.htm\") obo:IAO_0000115 obo:CL_0000411 \"An epithelial cell of the hypodermis of Caenorhabditis.\")\n\n  Line 7368: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"http://www.wormatlas.org/ver1/handbook/hypodermis/hypsupportother.htm#arcadecells\") obo:IAO_0000115 obo:CL_0000418 \"An epithelial cell found in C. elegans that firmly hold the outer body wall and the lips to the inner cylinder of the pharynx in a manner that keeps these organs from breaking apart, while still giving each organ freedom of movement during feeding.\")\n\n  Line 7383: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000420 \"An epithelial cell that forms a syncytium, which is a multinucleated cell resulting from the fusion of multiple cells.\")\n\n  Line 7444: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"doi:10.1007/s00412-016-0595-4\") obo:IAO_0000115 obo:CL_0000429 \"A columnar epithelial cell that is part of an insect imaginal disc.\")\n\n  Line 7575: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69078\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000446 \"An epithelial cell of the parathyroid gland that is arranged in wide, irregular interconnecting columns; responsible for the synthesis and secretion of parathyroid hormone.\")\n\n  Line 7775: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000469 \"A neural progenitor cell that is the daughter of a neuroblast (sensu arthopoda).  The progeny of ganglion mother cells develop into neurons, glia and (occasionally) epithelial cells.\")\n\n  Line 7835: AnnotationAssertion(obo:IAO_0000115 obo:CL_0000477 \"A somatic epithelial cell of the insect egg chamber.\")\n\n  Line 8015: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"MESH:D006107\") obo:IAO_0000115 obo:CL_0000501 \"A supporting cell for the developing female gamete in the ovary of mammals. They develop from the coelomic epithelial cells of the gonadal ridge. Granulosa cells form a single layer around the mammalian oocyte in the primordial ovarian follicle and advance to form a multilayered cumulus oophorus surrounding the ovum in the Graafian follicle. The major functions of granulosa cells include the production of steroids and LH receptors.\")\n\n  Line 8091: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"MESH:D019879\") Annotation(oboInOwl:hasDbXref \"PMID:29184701\") Annotation(oboInOwl:hasDbXref \"PMID:32308658\") Annotation(oboInOwl:hasDbXref \"PMID:33484640\") obo:IAO_0000115 obo:CL_0000510 \"An epithelial cell found in the basal part of the intestinal glands (crypts of Lieberkuhn) including the appendix. Paneth cells synthesize and secrete lysozyme and cryptdins. Numerous in the deeper parts of the intestinal crypts, particularly in the duodenum, rich in zinc, contain large acidophilic granules, with irregular apical microvilli and prominent membrane-bound vacuoles containing matrix.\")\n\n  Line 8674: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0000570 \"A neuroepithelial cells that occurs singly or in small groups, close to the outer follicular borders but within the follicular basement membrane of the thyroid. This cell expresses a form of the neural cell adhesion molecule (N-CAM) on its surface and secretes calcitonin and serotonin (5-hydroxytryptamine).\")\n\n  Line 8721: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000575 \"An epithelial cell of the cornea.\")\n\n  Line 8823: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"SANBI:mhl\") obo:IAO_0000115 obo:CL_0000584 \"An epithelial cell that has its apical plasma membrane folded into microvilli to provide ample surface for the absorption of nutrients from the intestinal lumen.\")\n\n  Line 9471: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"https://doi.org/10.1101/2021.10.10.463829\") obo:IAO_0000115 obo:CL_0000653 \"A specialized kidney epithelial cell, contained within a glomerulus, that contains \\\"feet\\\" that interdigitate with the \\\"feet\\\" of other podocytes.\")\n\n  Line 9527: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000658 \"An epithelial cell that secretes cuticle.\")\n\n  Line 9749: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0000686 \"A columnar/cuboidal epithelial cell that secretes cerebrospinal fluid.\")\n\n  Line 11429: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:11223304\") obo:IAO_0000115 obo:CL_0000846 \"An epithelial cell of the vestibular sensory organ that is characterized by intense enzymatic activities and numerous basal membrane infoldings.\")\n\n  Line 14627: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:20054144\") Annotation(oboInOwl:hasDbXref \"PMID:29463737\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0002062 \"A squamous pulmonary alveolar epithelial cell that is flattened and branched. A pulmonary alveolar type 1 cell covers more than 98% of the alveolar surface. This large cell has thin (50-100 nm) cytoplasmic extensions to form the air-blood barrier essential for normal gas exchange.\")\n\n  Line 14651: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:36138472\") Annotation(oboInOwl:hasDbXref \"PMID:8540632\") Annotation(oboInOwl:hasDbXref \"http://www.copewithcytokines.de\") obo:IAO_0000115 obo:CL_0002063 \"A pulmonary alveolar epithelial cell that modulates the fluid surrounding the alveolar epithelium by secreting and recycling surfactants via specialized organelles called alveolar lamellar bodies. This cell type also contributes to tissue repair and can differentiate after injury into a pulmonary alveolar type 1 cell. This cuboidal cell is thicker than squamous alveolar cells, has a rounded apical surface that projects above the level of the surrounding epithelium, and its free surface is covered by short microvilli.\")\n\n  Line 14759: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:22288583\") Annotation(oboInOwl:hasDbXref \"PMID:35626748\") Annotation(oboInOwl:hasDbXref \"PMID:38872928\") obo:IAO_0000115 obo:CL_0002071 \"A columnar absorptive epithelial cell found in the epithelium of large intestine, specialized for water and electrolyte absorption. Unlike small intestinal enterocytes, those in the large intestine have fewer apical microvilli.\")\n\n  Line 14807: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15817800\") Annotation(oboInOwl:hasDbXref \"PMID:30291131\") Annotation(oboInOwl:hasDbXref \"PMID:37925434\") obo:IAO_0000115 obo:CL_0002075 \"A rare type of columnar epithelial cell that is part of the tracheobronchial epithelium. This cell is characterized by a distinctive tuft of apical microvilli, which extends into the cytoplasm, and a pear-shaped morphology, broad at the base and tapering to a narrow apex. It plays vital roles in chemosensation, producing cytokines like IL-25, and enhancing mucociliary clearance through acetylcholine release to support mucus movement and airway defense.\")\n\n  Line 14817: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69075\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002076 \"An epithelial cell derived from endoderm.\")\n\n  Line 14826: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:69074\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002077 \"An epithelial cell derived from ectoderm.\")\n\n  Line 14856: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:12142741\") Annotation(oboInOwl:hasDbXref \"PMID:20018761\") Annotation(oboInOwl:hasDbXref \"PMID:8185160\") obo:IAO_0000115 obo:CL_0002080 \"A cubodial epithelial cell that is continuous with the lining of intercalated ducts that drain the acinus. This cell type secretes a high pH solution to aid in activation of zymogens, and can differentiate into endocrine and exocrine pancreatic cell types.\")\n\n  Line 15580: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:28400610\") obo:IAO_0000115 obo:CL_0002145 \"A multi-ciliated epithelial cell located in the trachea and bronchi, characterized by a columnar shape and motile cilia on its apical surface. These cilia facilitate mucociliary clearance by moving mucus and trapped particles toward the pharynx.\")\n\n  Line 15623: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11331626\") Annotation(oboInOwl:hasDbXref \"PMID:16960017\") Annotation(oboInOwl:hasDbXref \"PMID:21698266\") obo:IAO_0000115 obo:CL_0002149 \"An epithelial cell of the uterus. This cell has a mesodermal origin.\")\n\n  Line 15655: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/j.autneu.2015.04.008\") obo:IAO_0000115 obo:CL_0002152 \"A simple columnar epithelial cell located in the endocervix.\")\n\n  Line 15783: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"ISBN:0815129521\") obo:IAO_0000115 obo:CL_0002166 \"An epithelial cell that remains from the disintegration of the epithelial root sheath involved in the development of teeth.\")\n\n  Line 15816: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:7143026\") obo:IAO_0000115 obo:CL_0002169 \"An epithelial cell located on the basal lamina of the olfactory epithelium.\")\n\n  Line 15838: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:17468753\") obo:IAO_0000115 obo:CL_0002171 \"A rounded or elliptical epithelial cell, with pale-staining open face nucleus and pale cytoplasm rich in free ribosomes and clusters of centrioles; form a distinct basal zone spaced slightly from the basal surface of the epithelium.\")\n\n  Line 15916: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002178 \"An epithelial cell found in the lining of the stomach.\")\n\n  Line 15939: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002180 \"An epithelial cell of the stomach. This cell produces mucous.\")\n\n  Line 15975: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002183 \"A stomach epithelial cell that is olumnar in form with a few short apical microvilli; relatively undifferentiated mitotic cell from which other types of gland are derived; few in number, situated in the isthmus region of the gland and base of the gastric pit.\")\n\n  Line 15987: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:11891623\") obo:IAO_0000115 obo:CL_0002184 \"A flat or angular epithelial cell with condensed nuclei and darkly staining cytoplasm containing numerous intermediate filaments inserted into desmosomes contacting surrounding supporting cells; lie in contact with the basal lamina of olfactory epithelium.\")\n\n  Line 16134: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"PMID:20013317\") obo:IAO_0000115 obo:CL_0002198 \"A large epithelial cell with an extremely acidophilic and granular cytoplasm, containing vast numbers of mitochondria; such cells may undergo neoplastic transformation. From the Greek word onkos meaning swelling, this cell type is found in parathyroid, salivary and thyroid glands.\")\n\n  Line 16176: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002202 \"An epithelial cell of the tracheobronchial tree.\")\n\n  Line 16198: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:15817800\") Annotation(oboInOwl:hasDbXref \"PMID:30379593\") Annotation(oboInOwl:hasDbXref \"PMID:36704202\") obo:IAO_0000115 obo:CL_0002204 \"An epithelial cell found in various organs, including the gastrointestinal and respiratory tracts, characterized by a tuft of 120-140 blunt microvilli on its apical surface. This cell exhibits diverse functions depending on its location, which includes chemosensation, initiation of immune responses, contribution to mucociliary clearance, and defense against parasites.\")\n\n  Line 16250: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002209 \"An epithelial cell present in the trachea and bronchi; columnar in shape; generally lack cilia; immature forms of ciliated or secretory cells which have been formed from stem cells.\")\n\n  Line 16420: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"http://en.wikipedia.org/wiki/Lens_%28anatomy%29#Lens_epithelium\") obo:IAO_0000115 obo:CL_0002224 \"A cell of the cuboidal epithelium that covers the lens. The cells of the lens epithelium regulate most of the homeostatic functions of the lens. As ions, nutrients, and liquid enter the lens from the aqueous humor, Na+/K+ ATPase pumps in the lens epithelial cells pump ions out of the lens to maintain appropriate lens osmolarity and volume, with equatorially positioned lens epithelium cells contributing most to this current. The activity of the Na+/K+ ATPases keeps water and current flowing through the lens from the poles and exiting through the equatorial regions. The cells of the lens epithelium also serve as the progenitors for new lens fibers. It constantly lays down fibers in the embryo, fetus, infant, and adult, and continues to lay down fibers for lifelong growth.\")\n\n  Line 16488: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002231 \"An epithelial cell of the prostate.\")\n\n  Line 16500: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002232 \"An epithelial cell of prostatic duct.\")\n\n  Line 16512: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMCID:PMC2673349\") obo:IAO_0000115 obo:CL_0002233 \"An epithelial cell of the prostatic acinus.\")\n\n  Line 16622: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") Annotation(oboInOwl:hasDbXref \"ISBN:0721694128\") obo:IAO_0000115 obo:CL_0002243 \"A circular smooth muscle cell of the iris, innervated by the ciliary nerves (parasympathetic), and acting to contract the pupil. This muscle cell derives from neuroectoderm. This smooth muscle cell results from transformation of epithelial cells to smooth muscle cells.\")\n\n  Line 16635: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:32644501\") Annotation(oboInOwl:hasDbXref \"doi:/10.1016/j.autneu.2015.04.008\") Annotation(oboInOwl:hasDbXref \"http://www.bu.edu/histology/p/19404loa.htm\") obo:IAO_0000115 obo:CL_0002244 \"A stratified squamous epithelial cell located in the ectocervix.\")\n\n  Line 16708: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0721662544\") obo:IAO_0000115 obo:CL_0002251 \"An epithelial cell of the musculomembranous digestive tube extending from the mouth to the anus.\")\n\n  Line 16717: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002252 \"An epithelial cell of the lining of the esophagus.\")\n\n  Line 16727: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002253 \"An epithelial cell of the lining of the large intestine.\")\n\n  Line 16740: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002254 \"An epithelial cell of the lining of the small intestine.\")\n\n  Line 16776: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002257 \"An epithelial cell of thyroid gland.\")\n\n  Line 16788: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") Annotation(oboInOwl:hasDbXref \"PMID:31869123\") obo:IAO_0000115 obo:CL_0002258 \"An epithelial cell that is part of the thyroid follicle epithelium, with a shape that ranges from squamous when inactive to cuboidal or columnar when active, reflecting its hormonal activity. Its apical surface is lined with microvilli projecting into the colloid-filled lumen, where it synthesizes, stores, and secretes the thyroid hormones thyroxine (T4) and triiodothyronine (T3), releasing them into the bloodstream in response to thyroid-stimulating hormone (TSH).\")\n\n  Line 16815: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002260 \"An epithelial cell of the parathyroid gland.\")\n\n  Line 17071: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0323052908\") obo:IAO_0000115 obo:CL_0002283 \"An epithelial cell of the mucosa associated with facial skeleton.\")\n\n  Line 17171: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002292 \"A round or oval neuroepithelial cell that contacts other type I cells or capillaries. They occur in clusters that are surrounded by sheath cells (type-II cells) in the carotid body. This cell type is capable of secreting a number of neurotransmitters.\")\n\n  Line 17181: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:72208\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002293 \"An epithelial cell of the thymus. Epithelial reticular cells are pleomorphic, stellate, non-phagocytic cells which seem to be supportive in function and are held together by desmosomes. They replace the fibroblastoid reticular cells found in other lymphoid organs. Other epithelial cells in the medulla have the ultrastructure of secretory cells. Although different epithelial cells throughout the thymus appear alike by light microscopy their ultrastructure and function varies.\")\n\n  Line 17196: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002294 \"An epithelial cell with a well defined Golgi apparatus that makes up the continuous layer of cells bordering the thymic tissue beneath the capsule.\")\n\n  Line 17206: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002295 \"A thymic epithelial cell that has an eccentric, round, or irregularly shaped hetero or euchromatic nucleus. The hallmark of this cell type is the presence of vacuoles, which are clustered in one area of the cytoplasm in the vicinity of the nucleus. The vacuoles are small and acquire a grape-like form, occasionally showing delicate internal microvillous projections.\")\n\n  Line 17218: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"FMA:0412046911\") Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002296 \"An epithelial cell with high nuclear and cytoplasmic electron-density. This cell type is found in the deeper portions of the cortex but is more abundant in the medulla of the thymus.\")\n\n  Line 17229: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002297 \"A thymic epithelial cell with moderate nuclear and cytoplasmic electron-density. Scattered in the cortex, this cell type is predominant in the mid and deep cortex.\")\n\n  Line 17239: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002298 \"A thymic epithelial cell type with low nuclear and cytoplasmic electrondensity; has a round, euchromatic nucleus and occurs in small groups at the corticomedullary junction or scattered singly in the medulla.\")\n\n  Line 17251: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0412046911\") Annotation(oboInOwl:hasDbXref \"PMID:9264335\") obo:IAO_0000115 obo:CL_0002299 \"An epithelial cell scattered in the cortex, predominant in the outer cortex with a large pale nucleus and a prominent nucleolus.\")\n\n  Line 17261: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:19721455\") obo:IAO_0000115 obo:CL_0002300 \"A small medullary thymic epithelial cell with a spindle shape, often arranged in groups and connected to each other by large desmosomes and interdigitations. The cytoplasm is sparse, with scanty organelles and thick bundles of cytokeratin.\")\n\n  Line 17303: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"PMID:15106942\") obo:IAO_0000115 obo:CL_0002303 \"A cell that is part of pigmented ciliary epithelium. This cell type uptakes sodium and chloride ions from stromal interstitium and passes the ions to non-pigmented ciliary epithelial cells via gap junctions.\")\n\n  Line 17315: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:15106942\") obo:IAO_0000115 obo:CL_0002304 \"A cell that is part of non-pigmented ciliary epithelium. This cell type participates in aqueous humor formation by releasing solute, principally sodium and chloride ions received from pigmented epithelial cells via gap junctions, into the aqueous humor of the eye.\")\n\n  Line 17328: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:0517223651\") obo:IAO_0000115 obo:CL_0002305 \"An epithelial cell of the distal convoluted tubule of the kidney that helps regulate systemic levels of potassium, sodium, calcium, and pH.\")\n\n  Line 17341: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:1-4160-2328-3\") obo:IAO_0000115 obo:CL_0002306 \"An epithelial cell of the proximal tubule of the kidney.\")\n\n  Line 17354: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"ISBN:1-4160-2328-3\") Annotation(oboInOwl:hasDbXref \"PMID:23799132\") obo:IAO_0000115 obo:CL_0002307 \"A brush border epithelial cell located in the proximal tubule of the kidney, essential for reabsorbing substances like glucose and amino acids from the glomerular filtrate. These cells also secrete organic ions, playing a crucial role in maintaining kidney homeostasis, including electrolyte and acid-base balance, and excreting metabolic waste.\")\n\n  Line 17364: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002308 \"An epithelial cell of a skin gland.\")\n\n  Line 17429: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") obo:IAO_0000115 obo:CL_0002313 \"An ecto-epithelial cell of the prostate gland that secretes hormones.\")\n\n  Line 17546: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation(oboInOwl:hasDbXref \"PMID:11250738\") Annotation(oboInOwl:hasDbXref \"PMID:19022771\") Annotation(oboInOwl:hasDbXref \"PMID:38059556\") obo:IAO_0000115 obo:CL_0002324 \"A myoepithelial cell that is part of a mammary gland and is located in the basal layer. During lactation, a basal-myoepithelial cell of mammary gland contracts under the stimulation of oxytocin. In humans, a basal-myoepithelial cell of mammary gland can be identified by high levels of CD49f and low levels of EpCAM.\")\n\n  Line 17568: AnnotationAssertion(Annotation(oboInOwl:hasDbXref \"GOC:tfm\") Annotation